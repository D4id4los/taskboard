---
source: crates/taskboard-app/src/web/render.rs
expression: page.body
---
<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Renovation</title>
<meta http-equiv="refresh" content="30">
<link rel="stylesheet" href="../style-v1.css">
<script>
// taskboard web kiosk dashboard — reconnect.js (design §6.4)
// The single allowed script: an ES5-only enhancement over the
// meta-refresh baseline. While the server is unreachable it holds the
// page in place (no navigation away to a browser error page), shows a
// reconnecting banner, and keeps retrying; the first successful probe
// reloads, which restores fresh content. With scripting disabled the
// page still works — the meta refresh in the head is untouched markup.
(function () {
  'use strict';
  var delay = 30;
  var metas = document.getElementsByTagName('meta');
  for (var i = 0; i < metas.length; i++) {
    var equiv = metas[i].getAttribute('http-equiv');
    if (equiv && equiv.toLowerCase() === 'refresh') {
      var content = parseInt(metas[i].getAttribute('content'), 10);
      if (content > 0) {
        delay = content;
      }
      metas[i].parentNode.removeChild(metas[i]);
    }
  }
  var banner = document.createElement('div');
  banner.id = 'reconnect-banner';
  banner.style.display = 'none';
  banner.appendChild(document.createTextNode('reconnecting\u2026'));
  function mount() {
    if (document.body) {
      document.body.appendChild(banner);
    } else {
      setTimeout(mount, 50);
    }
  }
  mount();
  var down = false;
  function poll() {
    var xhr = new XMLHttpRequest();
    xhr.open('GET', location.href, true);
    xhr.onreadystatechange = function () {
      if (xhr.readyState !== 4) {
        return;
      }
      if (xhr.status >= 200 && xhr.status < 500) {
        if (down) {
          location.reload();
        }
        down = false;
        banner.style.display = 'none';
      } else {
        down = true;
        banner.style.display = 'block';
      }
    };
    xhr.send();
  }
  setInterval(poll, delay * 1000);
}());
</script>
</head>
<body>
<h1>Renovation</h1>
<p class="sub">phase: offline · pending ops: 0 · last success: —</p>
<div class="board">
<div class="stack"><h2>To do</h2>
<div class="card overdue"><p class="title">sand the door</p><p class="due">due 2027-01-13 08:00</p></div>
<div class="card done"><p class="title">order paint</p></div>
</div>
</div>
</body>
</html>
