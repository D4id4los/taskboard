// SPDX-License-Identifier: AGPL-3.0-only
// The window-max-width probe (the task-view twin, J4 US-3 AC-2): the
// real `PlanNextDayView` mounted with an empty model — the regression
// host for the window-max-width collapse (the empty `EmptyState`
// conditional mount bounded the view root's layout max, and Slint's
// winit backend then applied it as the OS window's max size). The
// assertion reads the root layout info from Rust
// (`plan_next_day_window_max_probe_tests.rs`); the probe only carries the
// mount.

import { PlanNextDayView, PlanModel } from "../ui/views/plan-next-day-view.slint";

export component WindowMaxProbe inherits Window {
    // No explicit `width:`/`height:` bindings — an explicit width
    // would replace the root's own layout info (the probe would read
    // back its canvas, not the constraint merge under test).

    in property <PlanModel> plan;

    PlanNextDayView {
        width: 100%;
        height: 100%;
        plan: root.plan;
    }
}
