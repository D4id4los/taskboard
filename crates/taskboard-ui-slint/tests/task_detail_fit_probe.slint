// SPDX-License-Identifier: AGPL-3.0-only
// The task-detail fit probe (#1504): the real `TaskView` mounted at
// the tight-fit cell (the 1.5x/900 px golden's logical size) — the
// regression host for the description viewport's floor clip. The
// assertions read the description section's realized bottom edge and
// the page scroll's extents from Rust
// (`probes/task_detail_fit_probe_tests.rs`); the probe only carries
// the mount and the theme-scale export.

import { Theme } from "../ui/theme.slint";
import { TaskView, TaskDetailModel } from "../ui/views/task-view.slint";

export { Theme }

export component TaskDetailFitProbe inherits Window {
    in property <TaskDetailModel> task;

    detail := TaskView {
        width: 100%;
        height: 100%;
        task: root.task;
    }

    // The typed observation seams (the view's out properties,
    // re-exposed window-side for the Rust reads).
    out property <length> page-height: detail.detail-page-height;
    out property <length> page-content-height: detail.detail-page-content-height;
    out property <length> description-bottom: detail.description-rect-y + detail.description-rect-height;
}
