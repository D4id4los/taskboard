---
source: crates/taskboard-ui-slint/tests/keymap_snapshots.rs
expression: rows
---
- preset: standard
  contexts:
    - context: global
      bindings:
        - sequence:
            - Escape
          action: task.move.cancel
        - sequence:
            - "Ctrl+,"
          action: app.settings
        - sequence:
            - Alt+1
          action: nav.focus-board
        - sequence:
            - Ctrl+F
          action: palette.search
        - sequence:
            - Ctrl+K
          action: capture.quick
        - sequence:
            - Ctrl+Shift+M
          action: app.menu
        - sequence:
            - Ctrl+Q
          action: app.exit
        - sequence:
            - Ctrl+T
          action: view.today
        - sequence:
            - Ctrl+Z
          action: app.undo
        - sequence:
            - Ctrl+Shift+Z
          action: app.redo
        - sequence:
            - F1
          action: app.help
        - sequence:
            - Ctrl+PageUp
          action: nav.prev-view
        - sequence:
            - Ctrl+PageDown
          action: nav.next-view
    - context: board
      bindings:
        - sequence:
            - Return
          action: task.edit
        - sequence:
            - Space
          action: task.complete
        - sequence:
            - Ctrl+Space
          action: task.reopen
        - sequence:
            - B
          action: board.previous
        - sequence:
            - M
          action: task.move
        - sequence:
            - Ctrl+Alt+M
          action: stack.move
        - sequence:
            - N
          action: task.create
        - sequence:
            - Ctrl+Shift+N
          action: board.create
        - sequence:
            - S
          action: stack.create
        - sequence:
            - b
          action: board.next
        - sequence:
            - Delete
          action: task.delete
        - sequence:
            - Ctrl+Delete
          action: stack.delete
        - sequence:
            - Ctrl+Shift+Delete
          action: board.delete
        - sequence:
            - Up
          action: nav.prev-item
        - sequence:
            - Down
          action: nav.next-item
        - sequence:
            - Ctrl+Left
          action: stack.narrower
        - sequence:
            - Ctrl+Shift+Left
          action: stack.prev
        - sequence:
            - Ctrl+Right
          action: stack.wider
        - sequence:
            - Ctrl+Shift+Right
          action: stack.next
        - sequence:
            - F2
          action: stack.rename
        - sequence:
            - Ctrl+F2
          action: board.rename
        - sequence:
            - Ctrl+Home
          action: nav.first-item
        - sequence:
            - Ctrl+End
          action: nav.last-item
    - context: stack-detail
      bindings:
        - sequence:
            - N
          action: task.create
        - sequence:
            - Up
          action: nav.prev-item
        - sequence:
            - Down
          action: nav.next-item
        - sequence:
            - Ctrl+Home
          action: nav.first-item
        - sequence:
            - Ctrl+End
          action: nav.last-item
    - context: task-detail
      bindings:
        - sequence:
            - Up
          action: nav.prev-item
        - sequence:
            - Down
          action: nav.next-item
        - sequence:
            - Ctrl+Home
          action: nav.first-item
        - sequence:
            - Ctrl+End
          action: nav.last-item
    - context: settings
      bindings:
        - sequence:
            - Escape
          action: app.settings
    - context: menu
      bindings:
        - sequence:
            - Return
          action: menu.invoke
        - sequence:
            - Escape
          action: menu.dismiss
        - sequence:
            - Up
          action: menu.previous
        - sequence:
            - Down
          action: menu.next
    - context: palette
      bindings:
        - sequence:
            - Return
          action: menu.invoke
        - sequence:
            - Escape
          action: menu.dismiss
        - sequence:
            - Up
          action: menu.previous
        - sequence:
            - Down
          action: menu.next
    - context: vi-insert
      bindings:
        - sequence:
            - Escape
          action: mode.normal
