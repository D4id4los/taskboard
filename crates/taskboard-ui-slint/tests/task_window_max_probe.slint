// SPDX-License-Identifier: AGPL-3.0-only
// The window-max-width probe: the real `TaskView` mounted with a
// rule-less open subject (the add-repeat affordance's row live) — the
// regression host for the window-max-width collapse (the view's root
// merge bounded the OS window's max size to a row's content width).
// The assertion reads the root layout info from Rust
// (`task_window_max_probe_tests.rs`); the probe only carries the mount.

import { TaskView, TaskDetailModel } from "../ui/views/task-view.slint";

export component WindowMaxProbe inherits Window {
    // No explicit `width:`/`height:` bindings — an explicit width
    // would replace the root's own layout info (the probe would read
    // back its canvas, not the constraint merge under test).

    in property <TaskDetailModel> task;

    TaskView {
        width: 100%;
        height: 100%;
        task: root.task;
    }
}
