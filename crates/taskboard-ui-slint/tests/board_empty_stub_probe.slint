// SPDX-License-Identifier: AGPL-3.0-only
// The empty-board stub probe (round 8 L1, the B-empty C1 class): the
// real `BoardLayout` mounted with zero stacks — the regression host
// for the empty-board CTAs' full-bleed fill (the "New stack" /
// "Create Default Kanban Setup" buttons previously filled the window
// width and painted their borders flush to both canvas edges). The
// assertion reads the CTAs' element geometry from Rust
// (`probes/board_empty_stub_probe_tests.rs`); the probe only carries
// the mount.

import { BoardLayout } from "../ui/compositions/board-layout.slint";

export component BoardEmptyStubProbe inherits Window {
    BoardLayout {
        width: 100%;
        height: 100%;
    }
}
