// SPDX-License-Identifier: AGPL-3.0-only
// The small-widget probe (round-9 W5, plan §4): the five new
// primitives (StatusNotice, ConfirmStrip, ActionChip, SectionHeader,
// GhostOpener) plus the theme's tone-ladder functions mounted with
// controlled fixtures. The probe catalogue's assertions read the
// typed root seams from Rust (`small_widget_probe_tests.rs`); every
// intent lands in a counter. No text assertions, no clocks.

import { Theme, Semantic, Tone, Typography } from "../ui/theme.slint";
import { IconButton, IconKind } from "../ui/widgets/icon-button.slint";
import { ToggleStrip } from "../ui/widgets/toggle-strip.slint";
import { StatusNotice, NoticeShape } from "../ui/widgets/status-notice.slint";
import { ConfirmStrip } from "../ui/widgets/confirm-strip.slint";
import { ActionChip } from "../ui/widgets/action-chip.slint";
import { SectionHeader } from "../ui/widgets/section-header.slint";
import { GhostOpener, GhostOrientation } from "../ui/widgets/ghost-opener.slint";

export { GhostOrientation }

export { NoticeShape }

// ---- T1: the tone ladder (F-3, #952) -----------------------------
// Pure-function equality against the Semantic constants: each arm
// mirrors `Semantic.tone-color`/`tone-fill`'s own expression so the
// probe asserts identity, not a pinned literal.
export component SmallWidgetProbe inherits Window {
    width: Theme.space-15 * 8;
    height: Theme.space-15 * 6;
    background: Theme.background;

    // Tone-color arms (typed colour equality against the constants).
    out property <color> tone-neutral: Semantic.tone-color(Tone.neutral);
    out property <color> tone-info: Semantic.tone-color(Tone.info);
    out property <color> tone-success: Semantic.tone-color(Tone.success);
    out property <color> tone-warning: Semantic.tone-color(Tone.warning);
    out property <color> tone-danger: Semantic.tone-color(Tone.danger);
    out property <color> tone-overdue: Semantic.tone-color(Tone.overdue);
    out property <color> tone-sync-active: Semantic.tone-color(Tone.sync-active);
    out property <color> tone-offline: Semantic.tone-color(Tone.offline);
    // The named constants the arms must equal.
    out property <color> semantic-success: Semantic.success;
    out property <color> semantic-warning: Semantic.warning;
    out property <color> semantic-danger: Semantic.danger;
    out property <color> semantic-overdue: Semantic.overdue;
    out property <color> semantic-sync-active: Semantic.sync-active;
    out property <color> semantic-offline: Semantic.offline;
    // Tone-fill arms (the derived translucent fill) beside the
    // literal 0.2-alpha derivations of the same constants.
    out property <color> fill-success: Semantic.tone-fill(Tone.success);
    out property <color> fill-danger: Semantic.tone-fill(Tone.danger);
    out property <color> literal-success-fill: Semantic.success.with-alpha(0.2);
    out property <color> literal-danger-fill: Semantic.danger.with-alpha(0.2);
    // The theme mirror (the colour-forwarding evidence reads equality
    // against the token, not a pin of the token's value).
    out property <color> theme-text-secondary: Theme.text-secondary;
    out property <IconKind> mode-icon-nudge: mode-strip.slot-icon(0);
    out property <IconKind> mode-icon-period: mode-strip.slot-icon(1);
    out property <IconKind> fallback-icon: plain-strip.slot-icon(2);
    out property <color> theme-text-primary: Theme.text-primary;
    out property <color> theme-surface-raised: Theme.surface-raised;
    out property <length> theme-focus-ring-width: Theme.focus-ring-width;
    out property <length> theme-space-1: Theme.space-1;
    out property <length> theme-space-2: Theme.space-2;
    out property <length> theme-space-15: Theme.space-15;
    out property <length> theme-space-3: Theme.space-3;
    out property <length> theme-space-5: Theme.space-5;
    out property <length> theme-space-6: Theme.space-6;

    // ---- T2: StatusNotice --------------------------------------------
    // The boxed shape (the ErrorLine grammar): raised box, border,
    // danger caption, stretch. The fixed sibling pins the stretch
    // evidence (the boxed notice absorbs the leftover width).
    out property <length> boxed-notice-x: boxed-host.notice-x;
    out property <length> boxed-notice-width: boxed-host.notice-width;
    out property <length> boxed-notice-height: boxed-host.notice-height;
    out property <color> boxed-notice-background: boxed-notice.background;
    out property <length> boxed-notice-border-width: boxed-notice.border-width;
    out property <length> boxed-notice-text-y: boxed-notice.text-y-out;
    out property <length> boxed-notice-text-x: boxed-notice.text-x-out;
    out property <color> boxed-notice-text-color: boxed-notice.text-color-out;
    out property <bool> boxed-notice-wrapping: boxed-notice.wrapping-out;
    // The inline shape (the bare caption grammar): the tone ladder's
    // colour, no box paint, elide/wrap law.
    out property <color> inline-notice-text-color: inline-notice.text-color-out;
    out property <color> inline-notice-background: inline-notice.background;
    out property <length> inline-notice-border-width: inline-notice.border-width;
    out property <bool> inline-notice-eliding: inline-notice.eliding-out;
    out property <bool> wrapped-notice-wrapping: wrapped-notice.wrapping-out;
    out property <color> wrapped-notice-text-color: wrapped-notice.text-color-out;

    // ---- T3: ConfirmStrip --------------------------------------------
    // The two grammars' tones + the confirm/cancel seams (the intents
    // land in counters, never in text).
    in-out property <int> destructive-confirm-count: 0;
    in-out property <int> destructive-cancel-count: 0;
    in-out property <int> convert-confirm-count: 0;
    in-out property <int> convert-cancel-count: 0;
    out property <color> destructive-message-color: destructive-strip.message-color-out;
    out property <color> destructive-confirm-color: destructive-strip.confirm-color-out;
    out property <color> convert-message-color: convert-strip.message-color-out;
    out property <color> convert-confirm-color: convert-strip.confirm-color-out;

    // ---- T4: ActionChip ----------------------------------------------
    in-out property <int> chip-invoked-count: 0;
    in-out property <int> chip-removed-count: 0;
    in-out property <int> passive-chip-clicked-count: 0;
    in-out property <int> plain-scope-chip-count: 0;
    // The swatch chip's echo square geometry (the label-chip rect).
    out property <length> chip-swatch-x: swatch-chip.swatch-x-out;
    out property <length> chip-swatch-width: swatch-chip.swatch-width-out;
    out property <color> chip-text-color: swatch-chip.text-color-out;
    // The preset chip's min pin + geometry seams (the first-click
    // probe aims at the chip's realized rect).
    out property <length> preset-chip-x: preset-chip.absolute-position.x;
    out property <length> preset-chip-y: preset-chip.absolute-position.y;
    out property <length> preset-chip-width: preset-chip.width;
    out property <length> preset-chip-height: preset-chip.height;
    out property <length> plain-chip-x: plain-chip.absolute-position.x;
    out property <length> plain-chip-y: plain-chip.absolute-position.y;
    out property <length> plain-chip-width: plain-chip.width;
    out property <length> plain-chip-height: plain-chip.height;
    out property <length> passive-chip-x: passive-chip.absolute-position.x;
    out property <length> passive-chip-y: passive-chip.absolute-position.y;
    out property <length> passive-chip-width: passive-chip.width;
    out property <length> passive-chip-height: passive-chip.height;

    // ---- T5: SectionHeader -------------------------------------------
    // The anatomy-order evidence reads the children's realized x
    // offsets (title < count < badge < actions).
    out property <length> header-title-x: probe-header.title-x-out;
    out property <length> header-count-x: probe-header.count-x-out;
    out property <length> header-badge-x: probe-header.badge-x-out;
    out property <length> header-actions-x: header-action.absolute-position.x;
    // The bare fixture (empty count/badge): the Rust side reads the
    // absence through the driver's label queries.
    out property <length> bare-header-y: bare-header.absolute-position.y;
    out property <bool> full-count-shown: probe-header.count-shown-out;
    out property <bool> full-badge-shown: probe-header.badge-shown-out;
    out property <bool> bare-count-shown: bare-header.count-shown-out;
    out property <bool> bare-badge-shown: bare-header.badge-shown-out;

    // ---- T6: GhostOpener ---------------------------------------------
    in-out property <int> row-ghost-count: 0;
    in-out property <int> column-ghost-count: 0;
    out property <bool> row-ghost-hovered: row-ghost.hovered;
    out property <length> row-ghost-height: row-ghost.height;
    out property <length> row-ghost-x: row-ghost.absolute-position.x;
    out property <length> row-ghost-y: row-ghost.absolute-position.y;
    out property <length> row-ghost-width: row-ghost.width;
    out property <length> column-ghost-width: column-ghost.width;
    out property <length> column-ghost-height: column-ghost.height;
    out property <length> column-ghost-x: column-ghost.absolute-position.x;
    out property <length> column-ghost-y: column-ghost.absolute-position.y;

    VerticalLayout {
        // The boxed fixture (the settings form's grammar): fixed
        // sibling + the stretched notice.
        boxed-host := HorizontalLayout {
            height: Theme.space-15;
            property <length> notice-x: boxed-notice.x;
            property <length> notice-width: boxed-notice.width;
            property <length> notice-height: boxed-notice.height;
            Rectangle {
                width: Theme.space-15;
            }
            boxed-notice := StatusNotice {
                text: "Connect failed: the server refused the credentials.";
                shape: NoticeShape.boxed;
            }
        }
        // The inline fixtures (the echo/hint grammar): danger eliding,
        // neutral wrapping.
        inline-notice := StatusNotice {
            text: "The typed time is not a valid HH:MM time.";
            height: Theme.space-5;
        }
        wrapped-notice := StatusNotice {
            text: "Alarms ring on the interactive desktop surface — timers and break rules here stay display-only.";
            tone: Tone.neutral;
            wrap: true;
            height: Theme.space-15;
        }
        // The destructive fixture (the board/timers remove grammar).
        destructive-strip := ConfirmStrip {
            message: "Deletes this stack and every task in it.";
            confirm-label: "Confirm delete stack";
            cancel-label: "Cancel delete stack";
            confirmed() => { root.destructive-confirm-count += 1; }
            cancelled() => { root.destructive-cancel-count += 1; }
        }
        // The non-destructive fixture (the recur convert grammar).
        convert-strip := ConfirmStrip {
            destructive: false;
            message: "Creates a habit on this board with a 1-per-period quota preset; the series stops repeating.";
            confirm-label: "Confirm conversion";
            cancel-label: "Cancel conversion";
            confirmed() => { root.convert-confirm-count += 1; }
            cancelled() => { root.convert-cancel-count += 1; }
        }

        // The swatch chip (the label-chip fixture): passive body,
        // swatch echo, trailing remove affordance.
        swatch-chip := ActionChip {
            interactive: false;
            tone: Tone.info;
            chip-background: Theme.surface;
            has-swatch: true;
            swatch: Semantic.sync-active;
            removable: true;
            remove-label: "Remove label probe";
            removed => { root.chip-removed-count += 1; }
        }
        // The preset chip (the ActivationStop fixture): bordered,
        // mono, the token floor pin.
        preset-chip := ActionChip {
            text: "5m";
            tone: Tone.neutral;
            value-role: Typography.mono;
            text-halign: center;
            bordered: true;
            chip-min-height: Theme.space-5;
            chip-min-width: Theme.space-6;
            pad-left: Theme.space-2;
            pad-right: Theme.space-2;
            use-stop: true;
            stop-id: 90;
            stop-description: "Adds this reminder offset.";
            description: "Adds this reminder offset.";
            invoked => { root.chip-invoked-count += 1; }
        }
        // The plain-scope chip (the timers-chip fixture): the raw
        // filtered Return/Space scope, no facts publish.
        plain-chip := ActionChip {
            tone: Tone.info;
            a11y-label: "Nearest timer";
            value-role: Typography.badge;
            use-stop: false;
            chip-background: Theme.surface-raised;
            pad-left: Theme.space-1;
            pad-right: Theme.space-1;
            invoked => { root.plain-scope-chip-count += 1; }
        }
        // The passive chip (the paused-chip fixture): invoked()
        // unreachable — the click counter must stay at zero.
        passive-chip := ActionChip {
            interactive: false;
            tone: Tone.info;
            chip-background: Theme.surface;
            pad-right: Theme.space-2;
            text: "paused";
        }

        // The header fixture (the timers grammar): title + count +
        // mid-row badge + stretch + trailing action.
        probe-header := SectionHeader {
            title: "Timers";
            count: "2";
            status-badge-text: "1 awaiting";
            status-badge-tone: Tone.info;
            header-action := IconButton {
                icon: IconKind.plus;
                label: "probe header action";
            }
        }
        // The bare header (the habits grammar): count/badge empty.
        bare-header := SectionHeader {
            title: "Habits";
        }

        // The ghost fixtures: the row band and the column sliver.
        row-host := HorizontalLayout {
            height: Theme.space-15;
            row-ghost := GhostOpener {
                orientation: GhostOrientation.row;
                label: "Add task";
                description: "Creates a task in this stack.";
                invoked => { root.row-ghost-count += 1; }
            }
        }
        column-host := HorizontalLayout {
            height: Theme.space-15;
            column-ghost := GhostOpener {
                orientation: GhostOrientation.column;
                label: "New stack";
                description: "Adds a new stack to this board.";
                invoked => { root.column-ghost-count += 1; }
            }
        }

        // The mode-strip fixture (#1430, US-12/S3): the habit editor's
        // Nudge day / Period start grammar pushed with its icons —
        // the typed icon-kind oracle reads the strip's own
        // `slot-icon` function (enum equality, never pixels).
        mode-strip := ToggleStrip {
            options: ["Nudge day", "Period start"];
            icons: [IconKind.calendar-days, IconKind.alarm-clock];
            checked-mask: [true, false];
        }
        plain-strip := ToggleStrip {
            options: ["Mon", "Tue", "Wed"];
            checked-mask: [false, false, false];
        }
    }
}
