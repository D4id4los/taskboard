// SPDX-License-Identifier: AGPL-3.0-only
// The small-widget probe (round-9 W5, plan §4): the five new
// primitives (StatusNotice, ConfirmStrip, ActionChip, SectionHeader,
// GhostOpener) plus the theme's tone-ladder functions mounted with
// controlled fixtures. The probe catalogue's assertions read the
// typed root seams from Rust (`small_widget_probe_tests.rs`); every
// intent lands in a counter. No text assertions, no clocks.

import { Theme, Semantic, Tone } from "../ui/theme.slint";
import { StatusNotice, NoticeShape } from "../ui/widgets/status-notice.slint";
import { ConfirmStrip } from "../ui/widgets/confirm-strip.slint";

export { NoticeShape }

// ---- T1: the tone ladder (F-3, #952) -----------------------------
// Pure-function equality against the Semantic constants: each arm
// mirrors `Semantic.tone-color`/`tone-fill`'s own expression so the
// probe asserts identity, not a pinned literal.
export component SmallWidgetProbe inherits Window {
    width: Theme.space-15 * 8;
    height: Theme.space-15 * 6;
    background: Theme.background;

    // Tone-color arms (typed colour equality against the constants).
    out property <color> tone-neutral: Semantic.tone-color(Tone.neutral);
    out property <color> tone-info: Semantic.tone-color(Tone.info);
    out property <color> tone-success: Semantic.tone-color(Tone.success);
    out property <color> tone-warning: Semantic.tone-color(Tone.warning);
    out property <color> tone-danger: Semantic.tone-color(Tone.danger);
    out property <color> tone-overdue: Semantic.tone-color(Tone.overdue);
    out property <color> tone-sync-active: Semantic.tone-color(Tone.sync-active);
    out property <color> tone-offline: Semantic.tone-color(Tone.offline);
    // The named constants the arms must equal.
    out property <color> semantic-success: Semantic.success;
    out property <color> semantic-warning: Semantic.warning;
    out property <color> semantic-danger: Semantic.danger;
    out property <color> semantic-overdue: Semantic.overdue;
    out property <color> semantic-sync-active: Semantic.sync-active;
    out property <color> semantic-offline: Semantic.offline;
    // Tone-fill arms (the derived translucent fill) beside the
    // literal 0.2-alpha derivations of the same constants.
    out property <color> fill-success: Semantic.tone-fill(Tone.success);
    out property <color> fill-danger: Semantic.tone-fill(Tone.danger);
    out property <color> literal-success-fill: Semantic.success.with-alpha(0.2);
    out property <color> literal-danger-fill: Semantic.danger.with-alpha(0.2);
    // The theme mirror (the colour-forwarding evidence reads equality
    // against the token, not a pin of the token's value).
    out property <color> theme-text-secondary: Theme.text-secondary;
    out property <color> theme-text-primary: Theme.text-primary;
    out property <color> theme-surface-raised: Theme.surface-raised;
    out property <length> theme-focus-ring-width: Theme.focus-ring-width;
    out property <length> theme-space-1: Theme.space-1;
    out property <length> theme-space-2: Theme.space-2;
    out property <length> theme-space-15: Theme.space-15;

    // ---- T2: StatusNotice --------------------------------------------
    // The boxed shape (the ErrorLine grammar): raised box, border,
    // danger caption, stretch. The fixed sibling pins the stretch
    // evidence (the boxed notice absorbs the leftover width).
    out property <length> boxed-notice-x: boxed-host.notice-x;
    out property <length> boxed-notice-width: boxed-host.notice-width;
    out property <length> boxed-notice-height: boxed-host.notice-height;
    out property <color> boxed-notice-background: boxed-notice.background;
    out property <length> boxed-notice-border-width: boxed-notice.border-width;
    out property <length> boxed-notice-text-y: boxed-notice.text-y-out;
    out property <length> boxed-notice-text-x: boxed-notice.text-x-out;
    out property <color> boxed-notice-text-color: boxed-notice.text-color-out;
    out property <bool> boxed-notice-wrapping: boxed-notice.wrapping-out;
    // The inline shape (the bare caption grammar): the tone ladder's
    // colour, no box paint, elide/wrap law.
    out property <color> inline-notice-text-color: inline-notice.text-color-out;
    out property <color> inline-notice-background: inline-notice.background;
    out property <length> inline-notice-border-width: inline-notice.border-width;
    out property <bool> inline-notice-eliding: inline-notice.eliding-out;
    out property <bool> wrapped-notice-wrapping: wrapped-notice.wrapping-out;
    out property <color> wrapped-notice-text-color: wrapped-notice.text-color-out;

    // ---- T3: ConfirmStrip --------------------------------------------
    // The two grammars' tones + the confirm/cancel seams (the intents
    // land in counters, never in text).
    in-out property <int> destructive-confirm-count: 0;
    in-out property <int> destructive-cancel-count: 0;
    in-out property <int> convert-confirm-count: 0;
    in-out property <int> convert-cancel-count: 0;
    out property <color> destructive-message-color: destructive-strip.message-color-out;
    out property <color> destructive-confirm-color: destructive-strip.confirm-color-out;
    out property <color> convert-message-color: convert-strip.message-color-out;
    out property <color> convert-confirm-color: convert-strip.confirm-color-out;

    VerticalLayout {
        // The boxed fixture (the settings form's grammar): fixed
        // sibling + the stretched notice.
        boxed-host := HorizontalLayout {
            height: Theme.space-15;
            property <length> notice-x: boxed-notice.x;
            property <length> notice-width: boxed-notice.width;
            property <length> notice-height: boxed-notice.height;
            Rectangle {
                width: Theme.space-15;
            }
            boxed-notice := StatusNotice {
                text: "Connect failed: the server refused the credentials.";
                shape: NoticeShape.boxed;
            }
        }
        // The inline fixtures (the echo/hint grammar): danger eliding,
        // neutral wrapping.
        inline-notice := StatusNotice {
            text: "The typed time is not a valid HH:MM time.";
            height: Theme.space-5;
        }
        wrapped-notice := StatusNotice {
            text: "Alarms ring on the interactive desktop surface — timers and break rules here stay display-only.";
            tone: Tone.neutral;
            wrap: true;
            height: Theme.space-15;
        }
        // The destructive fixture (the board/timers remove grammar).
        destructive-strip := ConfirmStrip {
            message: "Deletes this stack and every task in it.";
            confirm-label: "Confirm delete stack";
            cancel-label: "Cancel delete stack";
            confirmed() => { root.destructive-confirm-count += 1; }
            cancelled() => { root.destructive-cancel-count += 1; }
        }
        // The non-destructive fixture (the recur convert grammar).
        convert-strip := ConfirmStrip {
            destructive: false;
            message: "Creates a habit on this board with a 1-per-period quota preset; the series stops repeating.";
            confirm-label: "Confirm conversion";
            cancel-label: "Cancel conversion";
            confirmed() => { root.convert-confirm-count += 1; }
            cancelled() => { root.convert-cancel-count += 1; }
        }
    }
}
