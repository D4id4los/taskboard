// SPDX-License-Identifier: AGPL-3.0-only
// The dropdown probe (r4 D39, tier 2): the real `Dropdown` widget
// mounted with the four-row fixture (varied indicators, one busy, one
// selected) plus a nine-row mount for the six-row cap. The global
// counts the widget's callback fires; the window-root properties are
// the typed observation seams (open state, highlight, focus
// hand-over, flyout geometry).
//
// Geometry rides Theme tokens; the dropdown sits at (space-2, space-2)
// with width space-8 * 3, so the field's centre is computable from the
// exposed `field-h` and the before-stop sits above the dropdown in the
// declaration order (the Tab walk reaches it first).

import { Theme } from "../ui/theme.slint";
import { Dropdown, DropdownConsumer, DropdownFacts, DropdownRow, DropdownIndicator, DropdownTone } from "../ui/widgets/dropdown.slint";
// The facts global re-exported for the Rust-side `global::<>` seam
// (the overlay-migration probe's idiom).
export { DropdownFacts }
import { DropdownFlyout } from "../ui/widgets/dropdown-flyout.slint";
import { AnchoredOverlayHost, OverlayMenuWidth } from "../ui/widgets/anchored-overlay.slint";
import { IconKind } from "../ui/widgets/icon.slint";

export global DropdownProbe {
    in-out property <int> activated: 0;
    in-out property <int> activated-index: -1;
    in-out property <int> contexts: 0;
    in-out property <int> context-index: -1;
    in-out property <int> hovered: 0;
    in-out property <int> hovered-index: -1;
    in-out property <int> unhovered: 0;
    // The T-0 spike's counters (round-9 chunk 15): the de-sited
    // mount's identity evidence — each probe consumer kind routes to
    // its own counter through the ONE generic mount's dispatch (the
    // recorded D-fallback: consumer-kind forwarding; the primary
    // self-registration path is unparsable on Slint 1.18.1).
    in-out property <int> reg-activated-a: 0;
    in-out property <int> reg-activated-b: 0;
    in-out property <int> reg-index: -1;
}

component FourRows inherits Dropdown {
    width: Theme.space-8 * 3;
    x: Theme.space-2;
    y: Theme.space-2;
    // The probe's stand-in consumer kinds (the fixture consumes the
    // class's enum; the dispatch below reads them).
    consumer: DropdownConsumer.task-importance;
    field-label: "Probe field";
    field-description: "Opens the probe list.";
    rows: [
        { label: "alpha", indicator: DropdownIndicator.none, tone: DropdownTone.neutral, selected: false, busy: false },
        { label: "beta", indicator: DropdownIndicator.link-off, tone: DropdownTone.neutral, selected: false, busy: false },
        { label: "gamma", indicator: DropdownIndicator.link, tone: DropdownTone.danger, selected: true, busy: false },
        { label: "delta", indicator: DropdownIndicator.none, tone: DropdownTone.neutral, selected: false, busy: true },
    ];
    selected-index: 2;
    field-text: "gamma";
}

component NineRows inherits Dropdown {
    width: Theme.space-8 * 3;
    x: Theme.space-2;
    y: Theme.space-2 + Theme.space-8;
    consumer: DropdownConsumer.task-urgency;
    rows: [
        { label: "r0", indicator: DropdownIndicator.none, tone: DropdownTone.neutral, selected: false, busy: false },
        { label: "r1", indicator: DropdownIndicator.none, tone: DropdownTone.neutral, selected: false, busy: false },
        { label: "r2", indicator: DropdownIndicator.none, tone: DropdownTone.neutral, selected: false, busy: false },
        { label: "r3", indicator: DropdownIndicator.none, tone: DropdownTone.neutral, selected: false, busy: false },
        { label: "r4", indicator: DropdownIndicator.none, tone: DropdownTone.neutral, selected: false, busy: false },
        { label: "r5", indicator: DropdownIndicator.none, tone: DropdownTone.neutral, selected: false, busy: false },
        { label: "r6", indicator: DropdownIndicator.none, tone: DropdownTone.neutral, selected: false, busy: false },
        { label: "r7", indicator: DropdownIndicator.none, tone: DropdownTone.neutral, selected: false, busy: false },
        { label: "r8", indicator: DropdownIndicator.none, tone: DropdownTone.neutral, selected: false, busy: false },
    ];
    selected-index: 0;
    field-text: "r0";
}

// The T-0 spike instances (round-9 chunk 15): two `Dropdown` mounts
// with distinct consumer kinds — the de-sited identity evidence. The
// ONE generic mount below dispatches the flyout's activation on the
// consumer kind (the recorded D-fallback), and the counter each kind
// routes to is the identity proof: no per-site mount arms, no int
// sites, two instances, two seams.
component SpikeA inherits Dropdown {
    width: Theme.space-8 * 3;
    x: Theme.space-2;
    y: Theme.space-2 + Theme.space-8 * 2;
    consumer: DropdownConsumer.settings-remote;
    // The consumer wiring (the instantiation-site law — the priority
    // adoption's shape): the widget's own select intents route to the
    // kind's counter (the mount dispatches the flyout's clicks).
    row-activated(index) => {
        DropdownProbe.reg-activated-a += 1;
        DropdownProbe.reg-index = index;
    }
    rows: [
        { label: "sa0", indicator: DropdownIndicator.none, tone: DropdownTone.neutral, selected: true, busy: false },
        { label: "sa1", indicator: DropdownIndicator.none, tone: DropdownTone.neutral, selected: false, busy: false },
    ];
    selected-index: 0;
    field-text: "sa0";

}

component SpikeB inherits Dropdown {
    width: Theme.space-8 * 3;
    x: Theme.space-2;
    y: Theme.space-2 + Theme.space-8 * 3;
    consumer: DropdownConsumer.settings-publish;
    row-activated(index) => {
        DropdownProbe.reg-activated-b += 1;
        DropdownProbe.reg-index = index + 100;
    }
    rows: [
        { label: "sb0", indicator: DropdownIndicator.none, tone: DropdownTone.neutral, selected: true, busy: false },
        { label: "sb1", indicator: DropdownIndicator.none, tone: DropdownTone.neutral, selected: false, busy: false },
    ];
    selected-index: 0;
    field-text: "sb0";

}

export component DropdownProbeWindow inherits Window {
    width: Theme.space-8 * 5;
    height: Theme.space-7 * 6;

    // The observation seams (readable from Rust as root properties).
    in-out property <bool> open: dd.open;
    in-out property <bool> field-focused: dd.field-focused;
    in-out property <int> highlight: dd.highlight;
    in-out property <int> seek-row: dd.seek-row;
    in-out property <int> seek-nonce: dd.seek-nonce-out;
    in-out property <length> flyout-h: dd.flyout-height;
    in-out property <length> field-h: dd.height;
    in-out property <length> field-y: dd.y;
    in-out property <length> field-x: dd.x;
    in-out property <bool> nine-open: dd9.open;
    in-out property <bool> nine-field-focused: dd9.field-focused;
    in-out property <length> nine-flyout-h: dd9.flyout-height;
    // The realized flyout panel width (the #978 floor leg's seam).
    in-out property <length> flyout-panel-w: DropdownFacts.panel-width;
    // The Tab walk's continuation stop (declared after the dropdown).
    in-out property <bool> after-focus: after.has-focus;

    dd := FourRows {
        row-activated(i) => {
            DropdownProbe.activated += 1;
            DropdownProbe.activated-index = i;
        }
        row-context(i, x, y) => {
            DropdownProbe.contexts += 1;
            DropdownProbe.context-index = i;
        }
        row-hovered(i, x, y, w, h) => {
            DropdownProbe.hovered += 1;
            DropdownProbe.hovered-index = i;
        }
        row-unhovered() => {
            DropdownProbe.unhovered += 1;
        }
    }
    // The walk's continuation target (the dropdown hands off here on
    // Tab-reject) — declared immediately after the first dropdown, so
    // the walk order is field -> after -> nine-row mount.
    after := FocusScope {
        y: Theme.space-7 * 5;
        x: Theme.space-2;
        width: Theme.space-8 * 3;
        height: Theme.space-5;
        focus-on-tab-navigation: true;
    }

    dd9 := NineRows {}

    // The T-0 spike's observation seams + its own generic mount (the
    // identity test reads the field boxes to click each spike field).
    in-out property <length> spike-a-y: spike-a.y;
    in-out property <length> spike-b-y: spike-b.y;
    in-out property <length> spike-h: spike-a.height;
    spike-a := SpikeA {}
    spike-b := SpikeB {}
    // The class's overlay grammar, de-sited (round-9 chunk 15): the
    // ONE generic mount on the `AnchoredOverlayHost` — the app
    // window's mount shape verbatim (the probe has no status bar; the
    // window bottom is the floor). The consumer dispatch routes each
    // open instance's rows to its own counters.
    if (DropdownFacts.open): AnchoredOverlayHost {
        open: true;
        anchor-x: DropdownFacts.anchor-x;
        anchor-y: DropdownFacts.anchor-y;
        anchor-width: DropdownFacts.anchor-width;
        anchor-height: DropdownFacts.anchor-height;
        viewport-width: root.width;
        viewport-floor: root.height;
        panel-preferred-width: OverlayMenuWidth.menu-width(DropdownFacts.anchor-width, root.width);
        walk-stops: 1;
        // The probe's consumers have no dismissal seam: the underlay
        // closes through the fact write (the widget's external-close
        // hook lands as the field-refocusing close).
        dismissed => {
            DropdownFacts.open = false;
        }
        changed panel-x => { DropdownFacts.panel-x = self.panel-x; }
        changed panel-y => { DropdownFacts.panel-y = self.panel-y; }
        changed panel-width => { DropdownFacts.panel-width = self.panel-width; }
        init => {
            // The mount-time seed (a `changed` hook alone misses the
            // initial placement — the app window's idiom, moved to
            // the mount with the host).
            DropdownFacts.panel-x = self.panel-x;
            DropdownFacts.panel-y = self.panel-y;
            DropdownFacts.panel-width = self.panel-width;
        }
        DropdownFlyout {
            rows: DropdownFacts.rows;
            width: OverlayMenuWidth.menu-width(DropdownFacts.anchor-width, root.width);
            row-activated(index) => {
                if (DropdownFacts.consumer == DropdownConsumer.settings-remote) {
                    DropdownProbe.reg-activated-a += 1;
                    DropdownProbe.reg-index = index;
                } else if (DropdownFacts.consumer == DropdownConsumer.settings-publish) {
                    DropdownProbe.reg-activated-b += 1;
                    DropdownProbe.reg-index = index + 100;
                } else {
                    DropdownProbe.activated += 1;
                    DropdownProbe.activated-index = index;
                }
            }
            row-context(index, x, y) => {
                if (DropdownFacts.consumer == DropdownConsumer.task-importance) {
                    DropdownProbe.contexts += 1;
                    DropdownProbe.context-index = index;
                }
            }
            row-hovered(index, x, y, w, h) => {
                DropdownProbe.hovered += 1;
                DropdownProbe.hovered-index = index;
            }
            row-unhovered() => {
                DropdownProbe.unhovered += 1;
            }
        }
    }

    // The mapping facts: root property bindings over the widget's
    // public mappings — the tests read the totals from Rust.
    in-out property <IconKind> mapped-none: dd.indicator-kind(DropdownIndicator.none);
    in-out property <IconKind> mapped-link: dd.indicator-kind(DropdownIndicator.link);
    in-out property <IconKind> mapped-link-off: dd.indicator-kind(DropdownIndicator.link-off);
    in-out property <color> tone-neutral: dd.tone-color(DropdownTone.neutral);
    in-out property <color> tone-success: dd.tone-color(DropdownTone.success);
    in-out property <color> tone-accent: dd.tone-color(DropdownTone.accent);
    in-out property <color> tone-warning: dd.tone-color(DropdownTone.warning);
    in-out property <color> tone-danger: dd.tone-color(DropdownTone.danger);
}
