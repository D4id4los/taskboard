// SPDX-License-Identifier: AGPL-3.0-only
// The board columns' focus-into-view seek probe (#1365, the
// plan-seek-probe pattern): the real `BoardLayout` mounted with
// column models whose resolved widths overflow (or fit) the probe
// window — the regression host for the overflow regime's clipped
// columns (a focused card in a clipped column must scroll the
// columns row so the column is inside the viewport). The assertion
// reads the layout's `columns-x` root seam from Rust
// (`probes/columns_seek_probe_tests.rs`); the probe only carries the
// mount and the models.

import { BoardLayout, StackColumnModel } from "../ui/compositions/board-layout.slint";
// The root imports the hint global so the probe's Rust side reads and
// writes the SAME instance the mounted columns consume (globals are
// single-instance per component tree). The re-export makes the
// generated Rust type public on the probe's module.
import { FocusScrollHint } from "../ui/focus-scroll.slint";
export { FocusScrollHint }

export component ColumnsSeekProbe inherits Window {
    in property <[StackColumnModel]> stacks;

    BoardLayout {
        width: 100%;
        height: 100%;
        stacks: root.stacks;
    }
}
