// SPDX-License-Identifier: AGPL-3.0-only
// The viewport-growth probe (round-5 chunk 2, plan §5): the REAL
// MultiLineEditor mounted in an edit-mode fixture — the widget mounts
// inside this fixture and the P-arms stay verbatim from the slice-1
// prototype round. The facts global binds the widget's public
// geometry mirrors; the slice-1 verdict record (commit
// `test(ui-slint): the multi-line viewport probe …`) carries the
// fence decision and its build-log half.

import { Theme } from "../ui/theme.slint";
import { MultiLineEditor } from "../ui/widgets/multi-line-editor.slint";

export component EditorViewportProbeWindow inherits Window {
    // The probe's fact surface (plan §5.1): every mechanism the
    // P-arms asserts, bound from the widget's public mirrors (the
    // counts ride the widget's callbacks — wired below).
    out property <length> input-preferred-height: probe.content-preferred;
    out property <length> viewport-height: probe.content-extent;
    out property <length> viewport-y: probe.scroll-y;
    out property <length> inner-height: probe.viewport-inner;
    out property <length> line-height: probe.line-height;
    out property <length> box-height: probe.height;
    out property <string> buffer: probe.buffer;
    in-out property <int> accepted-count;
    in-out property <int> focus-lost-count;
    out property <bool> cursor-ok: probe.cursor-in-view;
    out property <bool> thumb-visible: probe.overflow;
    out property <length> thumb-height: probe.thumb-height;
    out property <length> thumb-y: probe.thumb-y;
    // Preferred, not bound width/height (the app-window rule: a
    // Window's own width/height binding swallows the Resized event).
    preferred-width: Theme.space-15 * 4;
    preferred-height: Theme.space-15 * 3;
    // The programmatic re-grab seam (the P3 arm) and the click
    // targets' centres (the P4 seam arm).
    public function focus-probe() {
        probe.grab-focus();
    }
    out property <length> sibling-cx: sibling.x + sibling.width / 2;
    out property <length> sibling-cy: sibling.y + sibling.height / 2;
    out property <length> dead-cx: dead.x + dead.width / 2;
    out property <length> dead-cy: dead.y + dead.height / 2;

    probe := MultiLineEditor {
        editing: true;
        label: "probe";
        placeholder: "Describe";
        x: Theme.space-2;
        y: Theme.space-2;
        width: parent.width - 2 * Theme.space-2;
        // An explicit token-sized box (the window would stretch its
        // child otherwise); the box stays fixed across every P-arm —
        // exactly what P1 pins constant against the growing extent.
        height: Theme.space-8;
        accepted(_text) => {
            root.accepted-count += 1;
        }
        edited(text) => {}
        focus-lost() => {
            root.focus-lost-count += 1;
        }
    }
    // The focus-steal sibling (the P4 seam arm): a real FocusScope.
    sibling := FocusScope {
        x: parent.width - Theme.space-6;
        y: parent.height - Theme.space-6;
        width: Theme.space-6;
        height: Theme.space-6;
    }
    dead := Rectangle {
        x: parent.width - Theme.space-6;
        y: 0px * Theme.base-scale;
        width: Theme.space-6;
        height: Theme.space-6;
        dead-touch := TouchArea { clicked => {} }
    }
}
