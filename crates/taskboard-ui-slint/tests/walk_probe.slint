// SPDX-License-Identifier: AGPL-3.0-only
// The control-walk probe (round-3 D25, plan §12 P1/P2): the real
// tab-traversal mechanism against sibling FocusScopes — the
// focus-seam probe's include shape. P1: a synthetic `KeyPressed
// { "\t" }` moves focus between two `focus-on-tab-navigation` stops
// and the Shift-wrapped variant moves it back. P2: `changed
// has-focus` fires on a FocusScope exactly once per focus change —
// the date-picker grid's context seam (mechanism A on a different
// element class than the proven TextField).

import { Theme } from "../ui/theme.slint";
import { ListView } from "../ui/widgets/listview.slint";

export global WalkProbeFacts {
    in-out property <int> first-gained: 0;
    in-out property <int> first-lost: 0;
    in-out property <int> second-gained: 0;
    in-out property <int> second-lost: 0;
    // The nested-descent probe (r4 chunk-10 review): a focused
    // CONTAINER FocusScope — does the synthetic Tab descend into its
    // child stop?
    in-out property <int> container-gained: 0;
    in-out property <int> inner-gained: 0;
    // P5: the same nesting inside a SEPARATE COMPONENT mounted under
    // a conditional — the app overlay's exact shape.
    in-out property <int> p5-container-gained: 0;
    in-out property <int> p5-inner-gained: 0;
}

// The P5 component: the panel's shape — a conditional component
// instantiation whose root wraps a focused container over an inner
// stop.
component ProbePanel inherits Rectangle {
    out property <bool> container-has-focus: p5-container.has-focus;
    out property <bool> inner-has-focus: WalkProbeFacts.p5-inner-gained > 0;
    // The P6 pad: flipping it post-mount transitions the container's
    // height — the changed-height grab's trigger.
    in property <length> pad: 0px;
    in property <[int]> rows-model;
    public function focus-container() {
        p5-container.focus();
    }
    p5-container := FocusScope {
        height: Theme.space-5 + root.pad;
        width: 100%;
        focus-on-tab-navigation: true;
        changed height => { self.focus(); }
        property <bool> focused: self.has-focus;
        changed focused => {
            if (self.focused) {
                WalkProbeFacts.p5-container-gained += 1;
            }
        }
        init => { self.focus(); }
        VerticalLayout {
            // The app's shape: a closed conditional first, the open
            // surface next, the row a REPEATER child inside nested
            // layouts.
            if (false): Rectangle {
                dead := FocusScope {
                    focus-on-tab-navigation: true;
                }
            }
            if (true): VerticalLayout {
                VerticalLayout {
                    Rectangle {
                        height: Theme.space-3;
                    }
                    for item in root.rows-model: Rectangle {
                        height: Theme.space-5;
                        row-scope := FocusScope {
                            width: 100%;
                            height: 100%;
                            focus-on-tab-navigation: true;
                            property <bool> focused: self.has-focus;
                            changed focused => {
                                if (self.focused) {
                                    WalkProbeFacts.p5-inner-gained += 1;
                                }
                            }
                        }
                    }
                    footer := FocusScope {
                        width: 100%;
                        height: Theme.space-5;
                        focus-on-tab-navigation: true;
                        property <bool> focused: self.has-focus;
                        changed focused => {
                            if (self.focused) {
                                WalkProbeFacts.p5-inner-gained += 10;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component WalkProbeWindow inherits Window {
    width: Theme.space-15 * 2;
    height: Theme.space-15;

    out property <bool> first-focused: stop-a.has-focus;
    out property <bool> second-focused: stop-b.has-focus;

    public function focus-a() {
        stop-a.focus();
    }
    public function focus-b() {
        stop-b.focus();
    }

    stop-a := FocusScope {
        x: 0;
        y: 0;
        width: Theme.space-6;
        height: Theme.space-15;
        focus-on-tab-navigation: true;
        property <bool> focused: self.has-focus;
        changed focused => {
            if (self.focused) {
                WalkProbeFacts.first-gained += 1;
            } else {
                WalkProbeFacts.first-lost += 1;
            }
        }
    }
    // The nested-descent probe: the container grabs focus at init
    // (the panel's posture); Tab should descend into the inner stop.
    page-list := ListView {
        x: Theme.space-15;
        y: 0;
        width: Theme.space-15;
        height: Theme.space-15;
        visible-height: parent.height;
    }

    in-out property <length> page-y <=> page-list.content-y;
    in-out property <length> page-visible-height <=> page-list.visible-height;
    in-out property <length> page-content-height <=> page-list.content-height;
    in-out property <int> page-total-rows <=> page-list.total-rows;
    public function page-by(page: int) {
        page-list.page(page);
    }

    stop-b := FocusScope {
        x: Theme.space-6;
        y: 0;
        width: Theme.space-6;
        height: Theme.space-15;
        focus-on-tab-navigation: true;
        property <bool> focused: self.has-focus;
        changed focused => {
            if (self.focused) {
                WalkProbeFacts.second-gained += 1;
            } else {
                WalkProbeFacts.second-lost += 1;
            }
        }
    }
    container := FocusScope {
        x: 0;
        y: Theme.space-15;
        width: Theme.space-15;
        height: Theme.space-15;
        focus-on-tab-navigation: true;
        property <bool> focused: self.has-focus;
        changed focused => {
            if (self.focused) {
                WalkProbeFacts.container-gained += 1;
            }
        }
        init => { self.focus(); }
        VerticalLayout {
            inner := FocusScope {
                width: 100%;
                height: Theme.space-5;
                focus-on-tab-navigation: true;
                property <bool> focused: self.has-focus;
                changed focused => {
                    if (self.focused) {
                        WalkProbeFacts.inner-gained += 1;
                    }
                }
            }
        }
    }
    in-out property <length> p5-pad: 0px;
    panel := ProbePanel {
        x: 0;
        y: Theme.space-15 * 2;
        width: Theme.space-15;
        height: Theme.space-15;
        pad: root.p5-pad;
        rows-model: [1];
    }
    out property <bool> container-has-focus: panel.container-has-focus;
    out property <bool> inner-has-focus: panel.inner-has-focus;
    // The ListView page-arithmetic probe (P3, plan §12): the page()
    // function's clamp and one-row-context overlap, driven directly
    // from the test.
}
