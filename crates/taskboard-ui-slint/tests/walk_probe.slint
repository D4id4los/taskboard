// SPDX-License-Identifier: AGPL-3.0-only
// The control-walk probe (round-3 D25, plan §12 P1/P2): the real
// tab-traversal mechanism against sibling FocusScopes — the
// focus-seam probe's include shape. P1: a synthetic `KeyPressed
// { "\t" }` moves focus between two `focus-on-tab-navigation` stops
// and the Shift-wrapped variant moves it back. P2: `changed
// has-focus` fires on a FocusScope exactly once per focus change —
// the date-picker grid's context seam (mechanism A on a different
// element class than the proven TextField).

import { Theme } from "../ui/theme.slint";
import { ListView } from "../ui/widgets/listview.slint";
// The B-1 probe's mount (round-9 W3): the walk overlay's real verb
// button — the only F-1 copy without a keyboard, under migration to
// the TextButton primitive (the sanctioned behavior change B-1).
import { ReviewWalkOverlay, ReviewWalkModel } from "../ui/views/review-walk-overlay.slint";
import { TextButton, TextButtonSize } from "../ui/widgets/text-button.slint";
// The #1053/#1036 probe mounts: the walk host arm's shape — the
// ModalDialogHost carrying the ReviewWalkOverlay body — and the
// standalone planner surface (the #1036 focus gate's guard).
import { ModalDialogHost, DialogKind, DialogButtonModel, DialogButtonRole } from "../ui/widgets/modal-dialog-host.slint";
import { PlanNextDayView } from "../ui/views/plan-next-day-view.slint";

export global WalkProbeFacts {
    in-out property <int> first-gained: 0;
    in-out property <int> first-lost: 0;
    in-out property <int> second-gained: 0;
    in-out property <int> second-lost: 0;
    // The nested-descent probe (r4 chunk-10 review): a focused
    // CONTAINER FocusScope — does the synthetic Tab descend into its
    // child stop?
    in-out property <int> container-gained: 0;
    in-out property <int> inner-gained: 0;
    // P5: the same nesting inside a SEPARATE COMPONENT mounted under
    // a conditional — the app overlay's exact shape.
    in-out property <int> p5-container-gained: 0;
    in-out property <int> p5-inner-gained: 0;
    // The #1036 standalone-planner facts: the count of focus gains and
    // the live has-focus mirror (the init edge can precede the
    // changed-handler attach, so both edges report).
    in-out property <int> standalone-focus-gained: 0;
    in-out property <bool> standalone-focus-live: false;
}

// The P5 component: the panel's shape — a conditional component
// instantiation whose root wraps a focused container over an inner
// stop.
component ProbePanel inherits Rectangle {
    out property <bool> container-has-focus: p5-container.has-focus;
    out property <bool> inner-has-focus: WalkProbeFacts.p5-inner-gained > 0;
    // The P6 pad: flipping it post-mount transitions the container's
    // height — the changed-height grab's trigger.
    in property <length> pad: 0px;
    in property <[int]> rows-model;
    public function focus-container() {
        p5-container.focus();
    }
    p5-container := FocusScope {
        height: Theme.space-5 + root.pad;
        width: 100%;
        focus-on-tab-navigation: true;
        changed height => { self.focus(); }
        property <bool> focused: self.has-focus;
        changed focused => {
            if (self.focused) {
                WalkProbeFacts.p5-container-gained += 1;
            }
        }
        init => { self.focus(); }
        VerticalLayout {
            // The app's shape: a closed conditional first, the open
            // surface next, the row a REPEATER child inside nested
            // layouts.
            if (false): Rectangle {
                dead := FocusScope {
                    focus-on-tab-navigation: true;
                }
            }
            if (true): VerticalLayout {
                VerticalLayout {
                    Rectangle {
                        height: Theme.space-3;
                    }
                    for item in root.rows-model: Rectangle {
                        height: Theme.space-5;
                        row-scope := FocusScope {
                            width: 100%;
                            height: 100%;
                            focus-on-tab-navigation: true;
                            property <bool> focused: self.has-focus;
                            changed focused => {
                                if (self.focused) {
                                    WalkProbeFacts.p5-inner-gained += 1;
                                }
                            }
                        }
                    }
                    footer := FocusScope {
                        width: 100%;
                        height: Theme.space-5;
                        focus-on-tab-navigation: true;
                        property <bool> focused: self.has-focus;
                        changed focused => {
                            if (self.focused) {
                                WalkProbeFacts.p5-inner-gained += 10;
                            }
                        }
                    }
                }
            }
        }
    }
}

// The #1036 standalone-planner wrapper: the planner mounted under a
// conditional (armed post-mount, like the app's view switch); the
// focus gains land in the facts global.
component StandalonePlanner inherits Rectangle {
    in property <bool> take-focus: true;
    width: Theme.space-15;
    height: Theme.space-15;
    planner := PlanNextDayView {
        take-focus-on-init: root.take-focus;
        init => {
            WalkProbeFacts.standalone-focus-live = self.has-focus;
        }
        changed has-focus => {
            WalkProbeFacts.standalone-focus-live = self.has-focus;
            if (self.has-focus) {
                WalkProbeFacts.standalone-focus-gained += 1;
            }
        }
    }
}

export component WalkProbeWindow inherits Window {
    width: Theme.space-15 * 2;
    height: Theme.space-15;

    out property <bool> first-focused: stop-a.has-focus;
    out property <bool> second-focused: stop-b.has-focus;

    public function focus-a() {
        stop-a.focus();
    }
    public function focus-b() {
        stop-b.focus();
    }

    stop-a := FocusScope {
        x: 0;
        y: 0;
        width: Theme.space-6;
        height: Theme.space-15;
        focus-on-tab-navigation: true;
        property <bool> focused: self.has-focus;
        changed focused => {
            if (self.focused) {
                WalkProbeFacts.first-gained += 1;
            } else {
                WalkProbeFacts.first-lost += 1;
            }
        }
    }
    // The nested-descent probe: the container grabs focus at init
    // (the panel's posture); Tab should descend into the inner stop.
    page-list := ListView {
        x: Theme.space-15;
        y: 0;
        width: Theme.space-15;
        height: Theme.space-15;
        visible-height: parent.height;
    }

    in-out property <length> page-y <=> page-list.content-y;
    in-out property <length> page-visible-height <=> page-list.visible-height;
    in-out property <length> page-content-height <=> page-list.content-height;
    in-out property <int> page-total-rows <=> page-list.total-rows;
    public function page-by(page: int) {
        page-list.page(page);
    }

    stop-b := FocusScope {
        x: Theme.space-6;
        y: 0;
        width: Theme.space-6;
        height: Theme.space-15;
        focus-on-tab-navigation: true;
        property <bool> focused: self.has-focus;
        changed focused => {
            if (self.focused) {
                WalkProbeFacts.second-gained += 1;
            } else {
                WalkProbeFacts.second-lost += 1;
            }
        }
    }
    container := FocusScope {
        x: 0;
        y: Theme.space-15;
        width: Theme.space-15;
        height: Theme.space-15;
        focus-on-tab-navigation: true;
        property <bool> focused: self.has-focus;
        changed focused => {
            if (self.focused) {
                WalkProbeFacts.container-gained += 1;
            }
        }
        init => { self.focus(); }
        VerticalLayout {
            inner := FocusScope {
                width: 100%;
                height: Theme.space-5;
                focus-on-tab-navigation: true;
                property <bool> focused: self.has-focus;
                changed focused => {
                    if (self.focused) {
                        WalkProbeFacts.inner-gained += 1;
                    }
                }
            }
        }
    }
    in-out property <length> p5-pad: 0px;
    panel := ProbePanel {
        x: 0;
        y: Theme.space-15 * 2;
        width: Theme.space-15;
        height: Theme.space-15;
        pad: root.p5-pad;
        rows-model: [1];
    }
    out property <bool> container-has-focus: panel.container-has-focus;
    out property <bool> inner-has-focus: panel.inner-has-focus;
    // The ListView page-arithmetic probe (P3, plan §12): the page()
    // function's clamp and one-row-context overlap, driven directly
    // from the test.

    // ---- The B-1 mount (round-9 W3, plan §5): the walk's verb row ---
    // Declared last so the synthetic tab from the first stop walks
    // straight into the verb row (the walk's tab order under test).
    // Pre-migration the verb button has no tab stop — the probe is
    // the B-1 gate and starts red.
    in-out property <int> b1-verb-clicked: 0;
    b1-first := FocusScope {
        x: Theme.space-6 * 2;
        y: 0;
        width: Theme.space-6;
        height: Theme.space-5;
        focus-on-tab-navigation: true;
    }
    // The retired VerbButton wrapper's TextButton-compact mount
    // (#1350): the B-1 tab-stop/Return gate rides the primitive.
    b1-verb := TextButton {
        x: Theme.space-8;
        y: 0;
        size: TextButtonSize.compact;
        label: "File it";
        clicked => { root.b1-verb-clicked += 1; }
    }
    public function focus-b1-first() {
        b1-first.focus();
    }

    // ---- The #1053 mount: the walk host arm's shape ------------------
    // ModalDialogHost + ReviewWalkOverlay mounted with the app-window
    // walk arm's composed walk-stops expression (the body's own stop
    // + every row + the D-5 button row). The Rust test pushes a
    // ReviewWalkModel and reads the armed mask extent through the
    // host's seam — the mount-side pin for the arithmetic.
    in-out property <bool> walk-open: false;
    // The default model carries the entry stage's row and the D-5
    // button row, so the host's open transition (the proven mount-grab
    // edge) lands the initial focus on the button.
    in-out property <ReviewWalkModel> walk-model: {
        open: false,
        header: "",
        strip: [],
        rows: [{ title: "row one", emphasis: false }],
        stage-kind: 4,
        stage-position: "",
        stage-intro: "",
        tally-filed: 0,
        tally-moved: 0,
        tally-left: 0,
        tally-recorded: false,
        abort-confirm: false,
        buttons: [
            { label: "Next", role: DialogButtonRole.accept, enabled: true, autofocus: true },
        ],
        button-codes: [0],
        filing: false,
        candidates: [],
        candidate-index: 0,
        file-label: "",
        keep-label: "",
        picking: false,
        date-text: "",
        tomorrow-label: "",
        pick-label: "",
        leave-label: "",
        plan-label: "",
        record-label: "",
        finish-label: "",
    };
    walk-host := ModalDialogHost {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        open: root.walk-open;
        title: "";
        kind: DialogKind.confirm;
        viewport-floor: self.height;
        // The app-window walk arm's composed expression (#1053): the
        // body's own stop, every row, and the button row (the host
        // mounts the buttons as `TextButton` tab stops).
        walk-stops: 1 + root.walk-model.rows.length
            + root.walk-model.buttons.length;
        buttons: root.walk-model.buttons;
        // The walk's initial focus lands on the first button (the
        // derived button row's mount grab, #996's renamed host
        // property) — gated on open so the closed host never competes
        // for the window's init focus.
        initial-focus-index: root.walk-open ? 0 : -1;
        walk-body := ReviewWalkOverlay {
            model: root.walk-model;
        }
    }
    out property <int> walk-mask-extent: walk-host.mask-extent;
    // The #1036 seams: the host's focused button and the overlay's
    // embedded-planner focus fact.
    out property <int> walk-focused-button: walk-host.focused-button;
    out property <bool> embedded-planner-focused: walk-body.planner-has-focus;

    // ---- The #1036 standalone planner mount --------------------------
    // The standalone surface's shape: the planner mounted on an
    // attached window (armed from the test post-mount, like the app's
    // view switch). The gate pin flips `standalone-take-focus`.
    in-out property <bool> standalone-arm: false;
    in-out property <bool> standalone-take-focus: true;
    if (root.standalone-arm): StandalonePlanner {
        x: 0;
        y: Theme.space-15 * 3;
        take-focus: root.standalone-take-focus;
    }
}
