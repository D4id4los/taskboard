// SPDX-License-Identifier: AGPL-3.0-only
// The stack-detail view (L3, D22): one stack's task list plus its
// inline create row. The scope focuses itself on mount (D15).

import { Theme, Semantic, RoleText, Typography } from "../theme.slint";
import { TaskCard, TaskCardModel } from "../widgets/task-card.slint";
import { EmptyState } from "../widgets/empty-state.slint";
import { TextField } from "../widgets/text-field.slint";
import { FocusScrollHint } from "../focus-scroll.slint";
import { ListView } from "../widgets/listview.slint";

// The stack-detail model (D22).
export struct StackDetailModel {
    title: string,
    tasks: [TaskCardModel],
    create-open: bool,
}

export component StackView inherits FocusScope {
    in property <StackDetailModel> stack;
    callback task-activated(int);
    callback task-clicked(int);
    callback task-context(int, float, float);
    callback create-committed(string);
    callback create-edited(string);

    focus-on-tab-navigation: true;
    accessible-role: AccessibleRole.region;
    accessible-label: "Stack: \{root.stack.title}";
    init => self.focus();

    // The D15 ring: rendered whenever the scope holds focus.
    ring := Rectangle {
        width: 100%;
        height: 100%;
        border-width: root.has-focus ? Theme.focus-ring-width : 0;
        border-color: Semantic.focus-ring;
        border-radius: Theme.radius-medium;

        VerticalLayout {
            // The ring is a plain Rectangle (no layout): without an
            // explicit fill this layout solves to its preferred — and
            // the viewport's Flickable preferred is 0, collapsing it.
            width: 100%;
            height: 100%;
            spacing: Theme.space-2;

            RoleText {
                role: Typography.heading;
                text: root.stack.title;
                // A D15 enabler: a long title wraps instead of forcing
                // the layout min above the window floors.
                wrap: word-wrap;
            }

            if (root.stack.tasks.length == 0 && !root.stack.create-open): EmptyState {
                text: "No tasks in this stack";
                hint: "Create one to get started";
            }

            // The stack's task viewport (#373 M3): the unchanged card
            // loop inside the in-house ListView — viewport-scale
            // instantiation at any N. The seams keep the global model
            // index. The viewport absorbs the pane's surplus (the only
            // stretchable child between the heading and the create
            // field), so the create field stays visible where a deep
            // list used to push it off-window.
            task-viewport := ListView {
                vertical-stretch: 1;
                min-height: 0;
                // The stack-detail surface reads the hint's row alone
                // (target-a is −1 there — focus-scroll.slint).
                request-row: FocusScrollHint.target-a == -1
                    ? FocusScrollHint.target-b
                    : -1;
                request-nonce: FocusScrollHint.target-a == -1
                    ? FocusScrollHint.nonce
                    : 0;
                total-rows: root.stack.tasks.length;
                for task[task-index] in root.stack.tasks: detail-task := TaskCard {
                    model: task;
                    activated => root.task-activated(task-index);
                    clicked => root.task-clicked(task-index);
                    context-requested(x, y) => root.task-context(task-index, x, y);
                }
            }

            if (root.stack.create-open): TextField {
                placeholder: "New task title";
                label: "New task title";
                commit-affordance: true;
                accepted(text) => root.create-committed(text);
                edited(text) => root.create-edited(text);
            }
        }
    }
}
