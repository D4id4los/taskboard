// SPDX-License-Identifier: AGPL-3.0-only
// The settings view (round-1 D24b/D7; round-2 D26-D31 per
// .artifacts/plans/2026-10-23-ui-r2-settings-form-plan.md): the
// connections form (write-only secret field), the connector list with
// live status, the keymap preset picker (one SegmentedControl, D26),
// the scale slider + field (D29), the status line (D28), the InfoTip
// help affordances (D31), and the whole content column scrolling
// under the pinned header (D30). All labels/tone decisions are
// markup-owned; the model carries typed data only (D18). Text entry
// rides the D18 insert-mask contract: a focused field engages insert
// mode via the adapter's edited seams; commit returns to Normal.

import { Theme, Typography, RoleText, Semantic } from "../theme.slint";
import { TextField } from "../widgets/text-field.slint";
import { SegmentedControl } from "../widgets/segmented-control.slint";
import { Slider } from "../widgets/slider.slint";
import { SettingsScrollFacts } from "../settings-facts.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
export enum SettingsRowStatus {
    idle,
    syncing,
    offline,
    failed,
    down,
}

export enum SettingsOutcome {
    none,
    ok,
    busy,
    rejected,
    unavailable,
    failed,
}


export struct ConnectionRow {
    name: string,
    server: string,
    username: string,
    status: SettingsRowStatus,
    // The legacy `[nextcloud]` singleton world's row (D4): displayed,
    // but Test/Remove are dead controls.
    read-only: bool,
}


export global SettingsModel {
    in-out property <[ConnectionRow]> rows: [];
    in-out property <string> draft-name: "";
    in-out property <string> draft-server: "";
    in-out property <string> draft-username: "";
    in-out property <int> preset-index: 0;
    in-out property <bool> save-enabled: false;
    in-out property <SettingsOutcome> last-outcome: SettingsOutcome.none;
    // The mapped status sentence (r2 D28): presentation policy lives
    // in src/settings_status.rs; the push lands the string here.
    in-out property <string> status-text: "";
}


// The tone of the row-status dot (D18: markup owns colour mapping).
component RowDot inherits Rectangle {
    in property <SettingsRowStatus> status: SettingsRowStatus.idle;
    width: Theme.space-2;
    height: self.width;
    border-radius: self.width / 2;
    background: root.status == SettingsRowStatus.down ? Semantic.danger
        : root.status == SettingsRowStatus.failed ? Semantic.danger
        : root.status == SettingsRowStatus.offline ? Semantic.warning
        : root.status == SettingsRowStatus.syncing ? Semantic.focus-ring
        : Semantic.success;
}

// The status line's tone dot (r2 D28): the RowDot shape over the
// outcome. One deliberate fix against the old marker: busy renders
// `Semantic.sync-active` — the old `surface-raised` was invisible on
// the surface.
component StatusDot inherits Rectangle {
    in property <SettingsOutcome> outcome: SettingsOutcome.none;
    width: Theme.space-2;
    height: self.width;
    border-radius: self.width / 2;
    background: root.outcome == SettingsOutcome.ok ? Semantic.success
        : root.outcome == SettingsOutcome.busy ? Semantic.sync-active
        : root.outcome == SettingsOutcome.failed ? Semantic.danger
        : Semantic.warning;
}

component SettingsButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    border-radius: Theme.radius-small;
    background: enabled ? Theme.surface-raised : Theme.surface;
    border-width: touch.has-hover ? Theme.focus-ring-width : 0;
    border-color: Semantic.focus-ring;
    min-width: Theme.space-6;
    min-height: label.preferred-height + 2 * Theme.space-2;
    accessible-role: AccessibleRole.button;
    accessible-label: root.text;
    touch := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
    label := RoleText {
        role: Typography.body;
        text: root.text;
        text-color: root.enabled ? Theme.text-primary : Theme.text-secondary;
        horizontal-alignment: center;
    }
}

component LabeledField inherits HorizontalLayout {
    spacing: Theme.space-2;
    in property <string> label;
    in property <string> placeholder;
    in property <bool> secret: false;
    in property <int> field-index;
    in-out property <string> text;
    callback edited(int, string);
    callback committed();
    RoleText {
        role: Typography.body;
        text: root.label;
        min-width: Theme.space-8;
        vertical-alignment: center;
    }
    TextField {
        placeholder: root.placeholder;
        label: root.label;
        commit-affordance: true;
        secret: root.secret;
        text <=> root.text;
        edited(t) => {
            root.edited(root.field-index, t);
        }
        accepted(t) => {
            root.edited(root.field-index, t);
            root.committed();
        }
    }
}

export component SettingsView inherits FocusScope {
    // D6.6: the back affordance routes the same close path as Escape
    // (the adapter's dedicated `settings-back-clicked` seam).
    callback back-clicked();
    callback field-edited(int, string);
    callback field-committed();
    callback save-clicked(string, string, string, string);
    callback test-clicked(int);
    callback remove-clicked(int);
    callback preset-picked(int);
    callback scale-committed(string);
    // The slider gesture (r2 D29): press / preview / release — the
    // width-drag trio's seams.
    callback scale-pressed();
    callback scale-preview(float);
    callback scale-released(float);

    VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-3;

        // The pinned header (r2 D30): the only content outside the
        // scroll — the back affordance never scrolls away.
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-2;
            back := IconButton {
                icon: IconKind.chevron-left;
                label: "Back";
                clicked => {
                    root.back-clicked();
                }
            }
            RoleText {
                role: Typography.title;
                text: "Settings";
                vertical-alignment: center;
            }
        }

        // The scroll host (r2 D30): a layout cell (never an overlay
        // child — max-height is not honoured on a Flickable-hosted
        // panel, the action-menu's recorded Slint fact), hosting the
        // one content column. The header above stays pinned.
        flick := Flickable {
            vertical-stretch: 1;
            // The journeys' scroll seam (r2 D30): two-way to the
            // global — journeys drive the scroll, gestures write
            // back (the two-way-to-built-in probe passed).
            viewport-y <=> SettingsScrollFacts.viewport-y;
            // The viewport drives the journeys' facts (the
            // mirror-facts pattern).
            changed height => {
                self.mirror-facts();
            }
            changed viewport-height => {
                self.mirror-facts();
            }
            init => {
                self.mirror-facts();
            }
            public function mirror-facts() {
                SettingsScrollFacts.content-height = self.viewport-height;
                SettingsScrollFacts.viewport-height = self.height;
            }
            content := VerticalLayout {
                spacing: Theme.space-3;

        // -- connections ------------------------------------------------
        RoleText {
            role: Typography.title;
            text: "Connections";
        }

        for row[index] in SettingsModel.rows: Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-small;
            min-height: row-layout.min-height + 2 * Theme.space-2;
            row-layout := HorizontalLayout {
                padding: Theme.space-2;
                spacing: Theme.space-2;
                VerticalLayout {
                    RowDot {
                        status: row.status;
                    }
                }
                VerticalLayout {
                    spacing: 0;
                    RoleText {
                        role: Typography.body;
                        text: row.name;
                    }
                    RoleText {
                        role: Typography.body;
                        text: row.username + " @ " + row.server;
                        text-color: Theme.text-secondary;
                    }
                }
                SettingsButton {
                    text: "Test";
                    enabled: !row.read-only;
                    clicked => {
                        root.test-clicked(index);
                    }
                }
                SettingsButton {
                    text: "Remove";
                    enabled: !row.read-only;
                    clicked => {
                        root.remove-clicked(index);
                    }
                }
            }
        }

        // -- the add/edit form ------------------------------------------
        // The four field texts are the fields' own state (write-only
        // for the password, D26b); the edited seams mirror into the
        // adapter's draft.
        LabeledField {
            label: "Name";
            placeholder: "work";
            field-index: 0;
            text <=> SettingsModel.draft-name;
            edited(i, t) => {
                root.field-edited(i, t);
            }
            committed() => {
                root.field-committed();
            }
        }
        LabeledField {
            label: "Server";
            placeholder: "https://cloud.example.com";
            field-index: 1;
            text <=> SettingsModel.draft-server;
            edited(i, t) => {
                root.field-edited(i, t);
            }
            committed() => {
                root.field-committed();
            }
        }
        LabeledField {
            label: "Username";
            placeholder: "alice";
            field-index: 2;
            text <=> SettingsModel.draft-username;
            edited(i, t) => {
                root.field-edited(i, t);
            }
            committed() => {
                root.field-committed();
            }
        }
        password-field := LabeledField {
            label: "App password";
            placeholder: "write-only; never shown";
            secret: true;
            field-index: 3;
            edited(i, t) => {
                root.field-edited(i, t);
            }
            committed() => {
                root.field-committed();
            }
        }
        SettingsButton {
            text: "Save";
            enabled: SettingsModel.save-enabled;
            clicked => {
                // The password rides the callback args only — it never
                // lands on any pushed model property (D26b).
                root.save-clicked(
                    SettingsModel.draft-name,
                    SettingsModel.draft-server,
                    SettingsModel.draft-username,
                    password-field.text,
                );
            }
        }

        // -- keymap preset (D27b: live-apply + persist) -----------------
        RoleText {
            role: Typography.title;
            text: "Keymap";
        }
        // The keymap picker (r2 D26): one SegmentedControl replaces
        // the three inverted-`enabled` buttons — the selection renders
        // `SettingsModel.preset-index`, the click emits `picked`; the
        // echo rides the reply (r2 D27). Index order is the contract:
        // [Standard, Emacs, Vi] (the adapter's request seam).
        SegmentedControl {
            options: ["Standard", "Emacs", "Vi"];
            selected-index: SettingsModel.preset-index;
            group-label: "Keymap preset";
            picked(i) => {
                root.preset-picked(i);
            }
        }

        // -- UI scale (D27b: live-apply at commit, persist over the
        //    lane, revert on a typed Err reply) --------------------------
        RoleText {
            role: Typography.title;
            text: "Interface scale";
        }
        HorizontalLayout {
            spacing: Theme.space-2;
            RoleText {
                role: Typography.body;
                text: "Scale (0.5–3.0)";
                min-width: Theme.space-8;
                vertical-alignment: center;
            }
            // The slider (r2 D29): live preview while dragging, one
            // commit per release. `value` reads `Theme.base-scale` —
            // one source of truth; live-applied commits, reply
            // reverts, and the preview all move the thumb.
            Slider {
                minimum: 0.5;
                maximum: 3.0;
                step: 0.1;
                value: Theme.base-scale;
                pressed() => {
                    root.scale-pressed();
                }
                preview(v) => {
                    root.scale-preview(v);
                }
                committed(v) => {
                    root.scale-released(v);
                }
            }
            TextField {
                placeholder: "1.0";
                label: "Scale";
                commit-affordance: true;
                // Commit on Return only (D9): a per-keystroke commit
                // would live-apply half-typed values and spam the lane.
                // The field stays authoritative (r2 D29).
                accepted(t) => {
                    root.scale-committed(t);
                }
            }
        }

        // The status line (r2 D28 — reverses round-1 R5's
        // tones-only rule by user direction): tone dot + mapped
        // text. The row's extent is pinned (min == max == one
        // control row, vertical-stretch 0), so it is structurally
        // unable to absorb layout height — the F-C3 mechanism, dead.
        HorizontalLayout {
            visible: SettingsModel.last-outcome != SettingsOutcome.none;
            spacing: Theme.space-2;
            vertical-stretch: 0;
            min-height: status-text.preferred-height + 2 * Theme.space-2;
            max-height: status-text.preferred-height + 2 * Theme.space-2;
            StatusDot {
                outcome: SettingsModel.last-outcome;
            }
            status-text := RoleText {
                role: Typography.body;
                text: SettingsModel.status-text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
            }
        }

    }

    // The scroll indicator (r2 D30): the action-menu's conditional
    // indicator, consciously inline-copied (a shared ScrollBar
    // widget needs element-reference plumbing Slint 1.18 does not
    // offer; revisit at the third consumer). Only while the
    // content actually overflows.
    if (flick.viewport-height > flick.height): Rectangle {
        x: root.width - Theme.space-3;
        y: flick.y + Theme.space-2;
        width: Theme.space-1;
        height: flick.height - 2 * Theme.space-2;
        background: Theme.surface;
        border-radius: self.width / 2;

        Rectangle {
            width: 100%;
            background: Theme.border;
            border-radius: parent.width / 2;
            height: max(Theme.space-4, parent.height * parent.height
                / max(Theme.focus-ring-width / 4, flick.viewport-height));
            y: (parent.height - self.height)
                * (-flick.viewport-y
                    / max(Theme.focus-ring-width / 4, flick.viewport-height - flick.height));
        }
    }
}
