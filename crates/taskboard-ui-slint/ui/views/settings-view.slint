// SPDX-License-Identifier: AGPL-3.0-only
// The settings view (round-1 D24b/D7; round-2 D26-D31 per
// .artifacts/plans/2026-10-23-ui-r2-settings-form-plan.md): the
// connections form (write-only secret field), the connector list with
// live status, the keymap preset picker (one SegmentedControl, D26),
// the scale slider + field (D29), the status line (D28), the InfoTip
// help affordances (D31), and the whole content column scrolling
// under the pinned header (D30). All labels/tone decisions are
// markup-owned; the model carries typed data only (D18). Text entry
// rides the D18 insert-mask contract: a focused field engages insert
// mode via the adapter's edited seams; commit returns to Normal.

import { Theme, Typography, RoleText, Semantic } from "../theme.slint";
import { TextField, FieldValidity } from "../widgets/text-field.slint";
// The validity flavour's single declaration lives beside the widget
// (text-field.slint); the view re-exports the import for the
// generated Rust module.
export { FieldValidity }
import { SegmentedControl } from "../widgets/segmented-control.slint";
import { Slider } from "../widgets/slider.slint";
import { SettingsScrollFacts } from "../settings-facts.slint";
import { InfoTip } from "../widgets/info-tip.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
export enum SettingsRowStatus {
    idle,
    syncing,
    offline,
    failed,
    down,
}

export enum SettingsOutcome {
    none,
    ok,
    busy,
    rejected,
    unavailable,
    failed,
}


export struct ConnectionRow {
    name: string,
    server: string,
    username: string,
    status: SettingsRowStatus,
    // The legacy `[nextcloud]` singleton world's row (D4): displayed,
    // but Test/Remove are dead controls.
    read-only: bool,
    // The row-level busy marker (r2 D34): this connector's ceremony
    // is in flight — the dot slot renders the busy state.
    busy: bool,
}

// One local board of the settings board selector (r2 D32): a
// *binding* surface — selection (radio semantics), the binding badge,
// and Detach. Board lifecycle lives on the board surface, not here.
export struct SettingsBoardRow {
    // The board's uuid (the hand-over form; the adapter converts).
    id: string,
    name: string,
    bound-connector: string,
    bound: bool,
    selected: bool,
    busy: bool,
}


export global SettingsModel {
    in-out property <[ConnectionRow]> rows: [];
    // The board selector's rows (r2 D32) and the current selection
    // (a board uuid string; empty = none — Bind stays disabled).
    in-out property <[SettingsBoardRow]> boards: [];
    in-out property <string> selected-board: "";
    // The busy machine (r2 D34): any op in flight disables every
    // settings op; busy-target names the connector/board the spinner
    // markers render on.
    in-out property <bool> busy: false;
    in-out property <string> busy-target: "";
    in-out property <string> draft-name: "";
    in-out property <string> draft-server: "";
    in-out property <string> draft-username: "";
    // The per-field validity flavour + error copy (round-3 D19):
    // recomputed from the form ladder on every push — the same
    // source of truth the Save gate reads, so the flavour and the
    // gate cannot diverge. The error strings are presentation copy
    // (settings_status::invalid_text); never asserted by tests.
    in-out property <FieldValidity> validity-name: FieldValidity.neutral;
    in-out property <FieldValidity> validity-server: FieldValidity.neutral;
    in-out property <FieldValidity> validity-username: FieldValidity.neutral;
    in-out property <FieldValidity> validity-password: FieldValidity.neutral;
    in-out property <FieldValidity> validity-scale: FieldValidity.neutral;
    in-out property <string> error-name: "";
    in-out property <string> error-server: "";
    in-out property <string> error-username: "";
    in-out property <string> error-password: "";
    in-out property <string> error-scale: "";
    // The scale field's echo (round-3 D20a): draft-when-present,
    // live-scale-otherwise — written by the adapter's push pass (and
    // by the slider preview while no draft exists). The field binds
    // its text here, closing the finding-23 sync hole.
    in-out property <string> scale-echo: "";
    in-out property <int> preset-index: 0;
    in-out property <bool> save-enabled: false;
    in-out property <SettingsOutcome> last-outcome: SettingsOutcome.none;
    // The mapped status sentence (r2 D28): presentation policy lives
    // in src/settings_status.rs; the push lands the string here.
    in-out property <string> status-text: "";
    // The D31 help-text constants (the same module): presentation
    // constants pushed once at mount; content never asserted.
    in-out property <string> help-name: "";
    in-out property <string> help-server: "";
    in-out property <string> help-username: "";
    in-out property <string> help-app-password: "";
    in-out property <string> help-scale: "";
    in-out property <string> help-keymap: "";
    in-out property <string> help-rows: "";
}


// The tone of the row-status dot (D18: markup owns colour mapping).
component RowDot inherits Rectangle {
    in property <SettingsRowStatus> status: SettingsRowStatus.idle;
    width: Theme.space-2;
    height: self.width;
    border-radius: self.width / 2;
    background: root.status == SettingsRowStatus.down ? Semantic.danger
        : root.status == SettingsRowStatus.failed ? Semantic.danger
        : root.status == SettingsRowStatus.offline ? Semantic.warning
        : root.status == SettingsRowStatus.syncing ? Semantic.focus-ring
        : Semantic.success;
}

// The status line's tone dot (r2 D28): the RowDot shape over the
// outcome. One deliberate fix against the old marker: busy renders
// `Semantic.sync-active` — the old `surface-raised` was invisible on
// the surface.
component StatusDot inherits Rectangle {
    in property <SettingsOutcome> outcome: SettingsOutcome.none;
    width: Theme.space-2;
    height: self.width;
    border-radius: self.width / 2;
    background: root.outcome == SettingsOutcome.ok ? Semantic.success
        : root.outcome == SettingsOutcome.busy ? Semantic.sync-active
        : root.outcome == SettingsOutcome.failed ? Semantic.danger
        : Semantic.warning;
}

// The ceremony's busy dot (r2 D34): the status line's busy token in
// the row's dot slot — structure is the model flag; the pulse is
// purely decorative and never asserted (the mock-clock tests assert
// the flag timeline, not pixels).
component BusyDot inherits Rectangle {
    width: Theme.space-2;
    height: self.width;
    border-radius: self.width / 2;
    background: Semantic.sync-active;
    opacity: 1.0;
    states [
        pulse when true: {
            opacity: 0.45;
            in { animate opacity { duration: 600ms; iteration-count: -1; } }
        }
    ]
}

component SettingsButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    // The visible-ceremony variant (r2 D34, F21): when true, the click
    // fires *regardless of enablement* — the adapter renders the
    // refusal. Default false: every other consumer keeps the gate.
    in property <bool> click-through: false;
    callback clicked();
    border-radius: Theme.radius-small;
    background: enabled ? Theme.surface-raised : Theme.surface;
    border-width: touch.has-hover ? Theme.focus-ring-width : 0;
    border-color: Semantic.focus-ring;
    min-width: Theme.space-6;
    min-height: label.preferred-height + 2 * Theme.space-2;
    accessible-role: AccessibleRole.button;
    accessible-label: root.text;
    touch := TouchArea {
        clicked => {
            if (root.enabled || root.click-through) {
                root.clicked();
            }
        }
    }
    label := RoleText {
        role: Typography.body;
        text: root.text;
        text-color: root.enabled ? Theme.text-primary : Theme.text-secondary;
        horizontal-alignment: center;
    }
}

// The inline error line (round-3 D19): hover-box styling under a
// field, carrying the field's reason sentence. The text is
// presentation copy pushed by the adapter (settings_status constants)
// — never asserted by tests; tests pin validity + presence.
component ErrorLine inherits Rectangle {
    in property <string> text;
    background: Theme.surface-raised;
    border-width: Theme.focus-ring-width;
    border-color: Theme.border;
    border-radius: Theme.radius-small;
    min-height: error-text.preferred-height + 2 * Theme.space-1;
    horizontal-stretch: 1;
    error-text := RoleText {
        role: Typography.caption;
        text: root.text;
        text-color: Semantic.danger;
        wrap: word-wrap;
        x: Theme.space-2;
        width: parent.width - 2 * Theme.space-2;
        y: (parent.height - self.preferred-height) / 2;
    }
}

component LabeledField inherits VerticalLayout {
    spacing: Theme.space-1;
    in property <string> label;
    in property <string> placeholder;
    in property <bool> secret: false;
    in property <int> field-index;
    in-out property <string> text;
    // The help fact (r2 D31): rides the InfoTip AND the field's
    // accessible-description — one source per help fact.
    in property <string> help;
    // The validity flavour (round-3 D19): forwarded to the field's
    // border and the error line's presence.
    in property <FieldValidity> validity: FieldValidity.neutral;
    in property <string> error-text: "";
    callback edited(int, string);
    callback committed();
    // The row wrapper restructured from a bare HorizontalLayout
    // (round-3 D19, plan §1.3): the error line spans label + InfoTip
    // + field — mounting it inside the primitive would grow the
    // field's pinned height contract per keystroke.
    HorizontalLayout {
        spacing: Theme.space-2;
        RoleText {
            role: Typography.body;
            text: root.label;
            min-width: Theme.space-8;
            vertical-alignment: center;
        }
        help-tip := InfoTip {
            about: root.label;
            help: root.help;
        }
        TextField {
            placeholder: root.placeholder;
            label: root.label;
            description: root.help;
            commit-affordance: true;
            secret: root.secret;
            validity: root.validity;
            text <=> root.text;
            edited(t) => {
                root.edited(root.field-index, t);
            }
            accepted(t) => {
                root.edited(root.field-index, t);
                root.committed();
            }
        }
    }
    if root.error-text != "": error-line := ErrorLine {
        text: root.error-text;
    }
}

export component SettingsView inherits FocusScope {
    // D6.6: the back affordance routes the same close path as Escape
    // (the adapter's dedicated `settings-back-clicked` seam).
    callback back-clicked();
    callback field-edited(int, string);
    callback field-committed();
    callback save-clicked(string, string, string, string);
    callback test-clicked(int);
    callback remove-clicked(int);
    // The board-scoped binding surface (r2 D32/D33): selecting a board
    // (radio), binding the selected board to a connector row, and
    // detaching a bound board row.
    callback board-selected(string);
    callback bind-clicked(int);
    callback detach-clicked(int);
    callback preset-picked(int);
    callback scale-committed(string);
    // The slider gesture (r2 D29): press / preview / release — the
    // width-drag trio's seams.
    callback scale-pressed();
    callback scale-preview(float);
    callback scale-released(float);

    VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-3;

        // The pinned header (r2 D30): the only content outside the
        // scroll — the back affordance never scrolls away.
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-2;
            back := IconButton {
                icon: IconKind.chevron-left;
                label: "Back";
                clicked => {
                    root.back-clicked();
                }
            }
            RoleText {
                role: Typography.title;
                text: "Settings";
                vertical-alignment: center;
            }
        }

        // The scroll host (r2 D30): a layout cell (never an overlay
        // child — max-height is not honoured on a Flickable-hosted
        // panel, the action-menu's recorded Slint fact), hosting the
        // one content column. The header above stays pinned.
        flick := Flickable {
            vertical-stretch: 1;
            // The journeys' scroll seam (r2 D30): two-way to the
            // global — journeys drive the scroll, gestures write
            // back (the two-way-to-built-in probe passed).
            // The Flickable-side property is the Slint-sanctioned
            // rename (same property, new name); the *global's* property
            // keeps its name — zero Rust churn (chunk 4's scroll
            // anchoring reads the global).
            content-y <=> SettingsScrollFacts.viewport-y;
            // The viewport drives the journeys' facts (the
            // mirror-facts pattern).
            changed height => {
                self.mirror-facts();
            }
            changed content-height => {
                self.mirror-facts();
            }
            init => {
                self.mirror-facts();
            }
            public function mirror-facts() {
                SettingsScrollFacts.content-height = self.content-height;
                SettingsScrollFacts.viewport-height = self.height;
            }
            content := VerticalLayout {
                spacing: Theme.space-3;

        // -- connections ------------------------------------------------
        RoleText {
            role: Typography.title;
            text: "Connections";
        }

        // The board selector (r2 D32): one row per live board, radio
        // selection, the binding badge, and Detach on bound rows. A
        // *binding* surface — board lifecycle is the board surface's
        // job (chunk 3).
        for board[index] in SettingsModel.boards: Rectangle {
            background: board.selected ? Theme.surface-raised : Theme.surface;
            border-radius: Theme.radius-small;
            min-height: board-layout.min-height + 2 * Theme.space-2;
            border-width: board.selected ? Theme.focus-ring-width : 0;
            border-color: Semantic.focus-ring;
            board-layout := HorizontalLayout {
                padding: Theme.space-2;
                spacing: Theme.space-2;
                // The binding badge: the RowDot-family status element
                // (bound → the syncing token; unbound → nothing) plus
                // the connector name text.
                VerticalLayout {
                    if board.bound: RowDot {
                        status: SettingsRowStatus.syncing;
                    }
                }
                VerticalLayout {
                    spacing: 0;
                    board-touch := TouchArea {
                        clicked => {
                            root.board-selected(board.id);
                        }
                    }
                    RoleText {
                        role: Typography.body;
                        text: board.name;
                    }
                    if board.bound: RoleText {
                        role: Typography.body;
                        text: board.bound-connector;
                        text-color: Theme.text-secondary;
                    }
                }
                if board.bound: SettingsButton {
                    text: "Detach";
                    enabled: !board.busy && !SettingsModel.busy;
                    clicked => {
                        root.detach-clicked(index);
                    }
                }
            }
        }

        for row[index] in SettingsModel.rows: Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-small;
            min-height: row-layout.min-height + 2 * Theme.space-2;
            row-layout := HorizontalLayout {
                padding: Theme.space-2;
                spacing: Theme.space-2;
                VerticalLayout {
                    // The busy ceremony renders the pulse in the dot
                    // slot (r2 D34); otherwise the live status dot.
                    if row.busy: BusyDot {}
                    if !row.busy: RowDot {
                        status: row.status;
                    }
                }
                VerticalLayout {
                    spacing: 0;
                    RoleText {
                        role: Typography.body;
                        text: row.name;
                    }
                    RoleText {
                        role: Typography.body;
                        text: row.username + " @ " + row.server;
                        text-color: Theme.text-secondary;
                    }
                }
                SettingsButton {
                    text: "Test";
                    enabled: !row.read-only && !SettingsModel.busy;
                    clicked => {
                        root.test-clicked(index);
                    }
                }
                // Bind-to-this-board (r2 D33): binds the selected
                // board to this connector. Re-issuing on the same
                // connector is defined (idempotent); bound elsewhere
                // refuses typed. No selection → disabled (only Save
                // carries click-through — the recorded decision).
                SettingsButton {
                    text: "Bind";
                    enabled: !row.read-only && !SettingsModel.busy
                        && SettingsModel.selected-board != "";
                    clicked => {
                        root.bind-clicked(index);
                    }
                }
                SettingsButton {
                    text: "Remove";
                    enabled: !row.read-only && !SettingsModel.busy;
                    clicked => {
                        root.remove-clicked(index);
                    }
                }
                help-rows := InfoTip {
                    about: row.name;
                    help: SettingsModel.help-rows;
                }
            }
        }

        // -- the add/edit form ------------------------------------------
        // The backend picker (r2 D32): presentational truth only — no
        // lane payload carries a backend (the Save ceremony is
        // Nextcloud-hardcoded by the config's world, F10). Standalone
        // renders as the disabled "coming soon" segment; a pick from a
        // disabled segment is swallowed by the widget.
        SegmentedControl {
            options: ["Nextcloud", "Standalone"];
            segment-enabled: [true, false];
            selected-index: 0;
            group-label: "Backend";
        }
        // The four field texts are the fields' own state (write-only
        // for the password, D26b); the edited seams mirror into the
        // adapter's draft.
        LabeledField {
            label: "Name";
            placeholder: "work";
            help: SettingsModel.help-name;
            field-index: 0;
            text <=> SettingsModel.draft-name;
            validity: SettingsModel.validity-name;
            error-text: SettingsModel.error-name;
            edited(i, t) => {
                root.field-edited(i, t);
            }
            committed() => {
                root.field-committed();
            }
        }
        LabeledField {
            label: "Server";
            placeholder: "https://cloud.example.com";
            help: SettingsModel.help-server;
            field-index: 1;
            text <=> SettingsModel.draft-server;
            validity: SettingsModel.validity-server;
            error-text: SettingsModel.error-server;
            edited(i, t) => {
                root.field-edited(i, t);
            }
            committed() => {
                root.field-committed();
            }
        }
        LabeledField {
            label: "Username";
            placeholder: "alice";
            help: SettingsModel.help-username;
            field-index: 2;
            text <=> SettingsModel.draft-username;
            validity: SettingsModel.validity-username;
            error-text: SettingsModel.error-username;
            edited(i, t) => {
                root.field-edited(i, t);
            }
            committed() => {
                root.field-committed();
            }
        }
        password-field := LabeledField {
            label: "App password";
            // The eye can reveal the buffer now (r3 D16): the old
            // "never shown" placeholder is false advertising.
            placeholder: "paste the app password";
            help: SettingsModel.help-app-password;
            secret: true;
            field-index: 3;
            validity: SettingsModel.validity-password;
            error-text: SettingsModel.error-password;
            edited(i, t) => {
                root.field-edited(i, t);
            }
            committed() => {
                root.field-committed();
            }
        }
        // Save carries click-through (r2 D34, F21): every click
        // produces a visible reaction — the disabled/invalid paths
        // render the refusal through the status line instead of
        // absorbing silently. The password rides the callback args
        // only — it never lands on any pushed model property (D26b).
        SettingsButton {
            text: "Save";
            enabled: SettingsModel.save-enabled;
            click-through: true;
            clicked => {
                root.save-clicked(
                    SettingsModel.draft-name,
                    SettingsModel.draft-server,
                    SettingsModel.draft-username,
                    password-field.text,
                );
            }
        }

        // -- keymap preset (D27b: live-apply + persist) -----------------
        HorizontalLayout {
            spacing: Theme.space-2;
            RoleText {
                role: Typography.title;
                text: "Keymap";
            }
            help-keymap := InfoTip {
                about: "Keymap";
                help: SettingsModel.help-keymap;
            }
        }
        // The keymap picker (r2 D26): one SegmentedControl replaces
        // the three inverted-`enabled` buttons — the selection renders
        // `SettingsModel.preset-index`, the click emits `picked`; the
        // echo rides the reply (r2 D27). Index order is the contract:
        // [Standard, Emacs, Vi] (the adapter's request seam).
        SegmentedControl {
            options: ["Standard", "Emacs", "Vi"];
            selected-index: SettingsModel.preset-index;
            group-label: "Keymap preset";
            picked(i) => {
                root.preset-picked(i);
            }
        }

        // -- UI scale (D27b: live-apply at commit, persist over the
        //    lane, revert on a typed Err reply) --------------------------
        RoleText {
            role: Typography.title;
            text: "Interface scale";
        }
        HorizontalLayout {
            spacing: Theme.space-2;
            RoleText {
                role: Typography.body;
                text: "Scale (0.5–3.0)";
                min-width: Theme.space-8;
                vertical-alignment: center;
            }
            help-scale := InfoTip {
                about: "Interface scale";
                help: SettingsModel.help-scale;
            }
            // The slider (r2 D29): live preview while dragging, one
            // commit per release. `value` reads `Theme.base-scale` —
            // one source of truth; live-applied commits, reply
            // reverts, and the preview all move the thumb.
            Slider {
                minimum: 0.5;
                maximum: 3.0;
                step: 0.1;
                value: Theme.base-scale;
                pressed() => {
                    root.scale-pressed();
                }
                preview(v) => {
                    root.scale-preview(v);
                }
                committed(v) => {
                    root.scale-released(v);
                }
            }
            // The scale field (round-3 D19/D20a): the flavour + error
            // line ride the same contract as the LabeledFields (a
            // VerticalLayout wrapper hosts the line — the primitive's
            // height contract stays pinned); the commit grammar is
            // Return-only.
            VerticalLayout {
                spacing: Theme.space-1;
                TextField {
                    placeholder: "1.0";
                    label: "Scale";
                    commit-affordance: true;
                    validity: SettingsModel.validity-scale;
                    // Commit on Return only (D9): a per-keystroke commit
                    // would live-apply half-typed values and spam the lane.
                    // The field stays authoritative (r2 D29).
                    accepted(t) => {
                        root.scale-committed(t);
                    }
                }
                if SettingsModel.error-scale != "": ErrorLine {
                    text: SettingsModel.error-scale;
                }
            }
        }

        // The status line (r2 D28 — reverses round-1 R5's
        // tones-only rule by user direction): tone dot + mapped
        // text. The row's extent is pinned (min == max == one
        // control row, vertical-stretch 0), so it is structurally
        // unable to absorb layout height — the F-C3 mechanism, dead.
        HorizontalLayout {
            visible: SettingsModel.last-outcome != SettingsOutcome.none;
            spacing: Theme.space-2;
            vertical-stretch: 0;
            min-height: status-text.preferred-height + 2 * Theme.space-2;
            max-height: status-text.preferred-height + 2 * Theme.space-2;
            StatusDot {
                outcome: SettingsModel.last-outcome;
            }
            status-text := RoleText {
                role: Typography.body;
                text: SettingsModel.status-text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
            }
        }

    }

    // The scroll indicator (r2 D30): the action-menu's conditional
    // indicator, consciously inline-copied (a shared ScrollBar
    // widget needs element-reference plumbing Slint 1.18 does not
    // offer; revisit at the third consumer). Only while the
    // content actually overflows.
    if (flick.content-height > flick.height): Rectangle {
        x: root.width - Theme.space-3;
        y: flick.y + Theme.space-2;
        width: Theme.space-1;
        height: flick.height - 2 * Theme.space-2;
        background: Theme.surface;
        border-radius: self.width / 2;

        Rectangle {
            width: 100%;
            background: Theme.border;
            border-radius: parent.width / 2;
            height: max(Theme.space-4, parent.height * parent.height
                / max(Theme.focus-ring-width / 4, flick.content-height));
            y: (parent.height - self.height)
                * (-flick.content-y
                    / max(Theme.focus-ring-width / 4, flick.content-height - flick.height));
        }
    }
}
