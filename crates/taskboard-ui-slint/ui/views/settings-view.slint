// SPDX-License-Identifier: AGPL-3.0-only
// The settings view (round-1 D24b/D7; round-2 D26-D31 per
// .artifacts/plans/2026-10-23-ui-r2-settings-form-plan.md): the
// connections form (write-only secret field), the connector list with
// live status, the keymap preset picker (one SegmentedControl, D26),
// the scale slider + field (D29), the status line (D28), the InfoTip
// help affordances (D31), and the whole content column scrolling
// under the pinned header (D30). All labels/tone decisions are
// markup-owned; the model carries typed data only (D18). Text entry
// rides the D18 insert-mask contract: a focused field engages insert
// mode via the adapter's edited seams; commit returns to Normal.

import { Theme, Typography, RoleText, Semantic, Tone } from "../theme.slint";
import { Badge } from "../widgets/badge.slint";
import { TextField, FieldValidity } from "../widgets/text-field.slint";
// The validity flavour's single declaration lives beside the widget
// (text-field.slint); the view re-exports the import for the
// generated Rust module.
export { FieldValidity }
import { SegmentedControl } from "../widgets/segmented-control.slint";
import { Slider } from "../widgets/slider.slint";
import { SettingsScrollFacts, SettingsBoardFacts } from "../settings-facts.slint";
import { Dropdown, DropdownRow, DropdownIndicator, DropdownTone } from "../widgets/dropdown.slint";
import { TooltipState } from "../widgets/tooltip.slint";
import { InfoTip } from "../widgets/info-tip.slint";
import { Responsive, Breakpoint } from "../responsive.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
export enum SettingsRowStatus {
    idle,
    syncing,
    offline,
    failed,
    down,
}

export enum SettingsOutcome {
    none,
    ok,
    busy,
    rejected,
    unavailable,
    failed,
}


/// One read-only deployment fact row (the editor's "Deployment"
/// group): the dotted config key is the address; `value` is the
/// secret-free display string; the badges are the app-stated apply
/// and env-override facts (never markup-hardcoded).
export struct SettingsFactRow {
    key: string,
    value: string,
    on-restart: bool,
    env-locked: bool,
}

export struct ConnectionRow {
    name: string,
    server: string,
    username: string,
    status: SettingsRowStatus,
    // The row-level busy marker (r2 D34): this connector's ceremony
    // is in flight — the dot slot renders the busy state.
    busy: bool,
}



// The account card's walk-ordered item kinds (round-5 chunk 8, D-8.1):
// the card header, its Files toggle, one Deck row per connector, and
// the remote-board mapping rows under it.
export enum ConnectionItemKind {
    account,
    files,
    // A files-bound live board's visibility row (round-6 D-6.8
    // phase 2, #722): binding truth, no actions.
    files-board,
    deck,
    remote,
}

// The files-roster badge's tone vocabulary (round-7 D-7.3, W-2/D2):
// computed Rust-side, mapped onto the existing `Badge`'s `Tone` by a
// pure three-arm function in the row — no new `Tone` variants (the
// theme ruling stands).
export enum SettingsBadgeTone {
    success,
    neutral,
    info,
}

// One rendered connections item (the flat, positional projection of
// the account cards — the adapter resolves every callback's item
// index through its own address table; no id enters the model).
export struct ConnectionItem {
    kind: ConnectionItemKind,
    // account: the identity line; deck: the connector name; remote:
    // the remote board's title.
    title: string,
    // remote: the bound local board's name ("" = unbound).
    detail: string,
    // deck: label the connector (the card carries several).
    show-title: bool,
    status: SettingsRowStatus,
    busy: bool,
    // remote: bound through this connector (Disconnect vs pick/create).
    bound: bool,
    // deck: a listing has landed (else the Refresh hint renders).
    listed: bool,
    // deck: the backend word the app supplies (round 6, D-6.8):
    // "Deck" for Nextcloud connectors, "" for standalone — the row
    // composes its label from it and stays a dumb client.
    backend-word: string,
    // files: the toggle's value and its app-stated facts.
    files-on: bool,
    files-locked: bool,
    files-restart: bool,
    // files-board (round-7 D-7.3, W-3/D2): the roster row's badge and
    // action, composed Rust-side — the UI stays a dumb client. Empty
    // badge text = no badge; empty action label = no action button.
    badge-text: string,
    badge-tone: SettingsBadgeTone,
    action-label: string,
    action-enabled: bool,
    archived: bool,
}

export global SettingsModel {
    // The configured connectors, secret-free (the per-connector truth
    // the account cards fold from).
    in-out property <[ConnectionRow]> rows: [];
    // The account cards' rendered projection (round-5 chunk 8).
    in-out property <[ConnectionItem]> connection-items: [];
    // The remote rows' local-board choices (the unbound live boards —
    // one list for every remote row's picker; the flyout's rows).
    in-out property <[DropdownRow]> board-options: [];
    // The busy machine (r2 D34): any op in flight disables every
    // settings op; busy-target names the connector/board the spinner
    // markers render on.
    in-out property <bool> busy: false;
    in-out property <string> busy-target: "";
    in-out property <string> draft-server: "";
    in-out property <string> draft-username: "";
    // The per-field validity flavour + error copy (round-3 D19):
    // recomputed from the form ladder on every push — the same
    // source of truth the Save gate reads, so the flavour and the
    // gate cannot diverge. The error strings are presentation copy
    // (settings_status::invalid_text); never asserted by tests.
    in-out property <FieldValidity> validity-server: FieldValidity.neutral;
    in-out property <FieldValidity> validity-username: FieldValidity.neutral;
    in-out property <FieldValidity> validity-password: FieldValidity.neutral;
    in-out property <FieldValidity> validity-scale: FieldValidity.neutral;
    in-out property <string> error-server: "";
    in-out property <string> error-username: "";
    in-out property <string> error-password: "";
    in-out property <string> error-scale: "";
    // The scale field's echo (round-3 D20a, r4 D38): draft-when-
    // present, committed-scale-otherwise — written by the adapter's
    // push pass only; it never tracks the thumb mid-gesture. The
    // field binds its text here, closing the finding-23 sync hole.
    in-out property <string> scale-echo: "";
    in-out property <int> preset-index: 0;
    in-out property <bool> save-enabled: false;
    in-out property <SettingsOutcome> last-outcome: SettingsOutcome.none;
    // The mapped status sentence (r2 D28): presentation policy lives
    // in src/settings_status.rs; the push lands the string here.
    in-out property <string> status-text: "";
    // The D31 help-text constants (the same module): presentation
    // constants pushed once at mount; content never asserted.
    in-out property <string> help-server: "";
    in-out property <string> help-username: "";
    in-out property <string> help-app-password: "";
    in-out property <string> help-scale: "";
    in-out property <string> help-keymap: "";
    in-out property <string> help-rows: "";
    // -- the settings editor's general fields (the GUI settings
    //    editor chunk): echo/validity/error per text field (the
    //    scale field's grammar), the app-stated env-lock and apply
    //    facts, the choice indices, and the read-only facts list.
    in-out property <[SettingsFactRow]> facts: [];
    in-out property <string> day-start-echo: "";
    in-out property <FieldValidity> validity-day-start: FieldValidity.neutral;
    in-out property <string> error-day-start: "";
    in-out property <bool> day-start-env-locked: false;
    in-out property <bool> day-start-on-restart: false;
    in-out property <string> help-day-start: "";
    in-out property <string> tick-echo: "";
    in-out property <FieldValidity> validity-tick: FieldValidity.neutral;
    in-out property <string> error-tick: "";
    in-out property <bool> tick-env-locked: false;
    in-out property <bool> tick-on-restart: false;
    in-out property <string> help-tick: "";
    in-out property <string> before-echo: "";
    in-out property <FieldValidity> validity-before: FieldValidity.neutral;
    in-out property <string> error-before: "";
    in-out property <bool> before-env-locked: false;
    in-out property <bool> before-on-restart: false;
    in-out property <string> help-before: "";
    in-out property <string> poll-echo: "";
    in-out property <FieldValidity> validity-poll: FieldValidity.neutral;
    in-out property <string> error-poll: "";
    in-out property <bool> poll-env-locked: false;
    in-out property <bool> poll-on-restart: false;
    in-out property <string> help-poll: "";
    in-out property <string> backoff-initial-echo: "";
    in-out property <FieldValidity> validity-backoff-initial: FieldValidity.neutral;
    in-out property <string> error-backoff-initial: "";
    in-out property <bool> backoff-initial-env-locked: false;
    in-out property <bool> backoff-initial-on-restart: false;
    in-out property <string> help-backoff: "";
    in-out property <string> backoff-max-echo: "";
    in-out property <FieldValidity> validity-backoff-max: FieldValidity.neutral;
    in-out property <string> error-backoff-max: "";
    in-out property <bool> backoff-max-env-locked: false;
    in-out property <bool> backoff-max-on-restart: false;
    in-out property <string> due-soon-echo: "";
    in-out property <FieldValidity> validity-due-soon: FieldValidity.neutral;
    in-out property <string> error-due-soon: "";
    in-out property <bool> due-soon-env-locked: false;
    in-out property <bool> due-soon-on-restart: false;
    in-out property <string> help-due-soon: "";
    // The choice echoes (commit-on-pick, the keymap preset grammar)
    // and their app-stated facts.
    in-out property <int> reminders-enabled-index: 0;
    in-out property <bool> reminders-enabled-env-locked: false;
    in-out property <bool> reminders-enabled-on-restart: false;
    in-out property <string> help-reminders: "";
    in-out property <int> sink-index: 0;
    in-out property <bool> sink-env-locked: false;
    in-out property <bool> sink-on-restart: false;
    in-out property <string> help-sink: "";
    // -- the [focus] section's rows (the focus settings editor, #625):
    //    the minutes ride the general text-field grammar (indices
    //    12–15 of the field-edited contract), the bools the segmented
    //    On/Off grammar (commit on pick).
    in-out property <int> focus-enabled-index: 0;
    in-out property <bool> focus-enabled-env-locked: false;
    in-out property <bool> focus-enabled-on-restart: false;
    in-out property <string> help-focus-enabled: "";
    in-out property <string> focus-work-echo: "";
    in-out property <FieldValidity> validity-focus-work: FieldValidity.neutral;
    in-out property <string> error-focus-work: "";
    in-out property <bool> focus-work-env-locked: false;
    in-out property <bool> focus-work-on-restart: false;
    in-out property <string> help-focus-work: "";
    in-out property <string> focus-break-echo: "";
    in-out property <FieldValidity> validity-focus-break: FieldValidity.neutral;
    in-out property <string> error-focus-break: "";
    in-out property <bool> focus-break-env-locked: false;
    in-out property <bool> focus-break-on-restart: false;
    in-out property <string> help-focus-break: "";
    in-out property <int> focus-chain-index: 0;
    in-out property <bool> focus-chain-env-locked: false;
    in-out property <bool> focus-chain-on-restart: false;
    in-out property <string> help-focus-chain: "";
    in-out property <string> focus-long-break-echo: "";
    in-out property <FieldValidity> validity-focus-long-break: FieldValidity.neutral;
    in-out property <string> error-focus-long-break: "";
    in-out property <bool> focus-long-break-env-locked: false;
    in-out property <bool> focus-long-break-on-restart: false;
    in-out property <string> help-focus-long-break: "";
    in-out property <string> focus-every-echo: "";
    in-out property <FieldValidity> validity-focus-every: FieldValidity.neutral;
    in-out property <string> error-focus-every: "";
    in-out property <bool> focus-every-env-locked: false;
    in-out property <bool> focus-every-on-restart: false;
    in-out property <string> help-focus-every: "";
    in-out property <int> focus-notify-index: 0;
    in-out property <bool> focus-notify-env-locked: false;
    in-out property <bool> focus-notify-on-restart: false;
    in-out property <string> help-focus-notify: "";
}


// The tone of the row-status dot (D18: markup owns colour mapping).
component RowDot inherits Rectangle {
    in property <SettingsRowStatus> status: SettingsRowStatus.idle;
    width: Theme.space-2;
    height: self.width;
    border-radius: self.width / 2;
    background: root.status == SettingsRowStatus.down ? Semantic.danger
        : root.status == SettingsRowStatus.failed ? Semantic.danger
        : root.status == SettingsRowStatus.offline ? Semantic.warning
        : root.status == SettingsRowStatus.syncing ? Semantic.focus-ring
        : Semantic.success;
}

// The status line's tone dot (r2 D28): the RowDot shape over the
// outcome. One deliberate fix against the old marker: busy renders
// `Semantic.sync-active` — the old `surface-raised` was invisible on
// the surface.
component StatusDot inherits Rectangle {
    in property <SettingsOutcome> outcome: SettingsOutcome.none;
    width: Theme.space-2;
    height: self.width;
    border-radius: self.width / 2;
    background: root.outcome == SettingsOutcome.ok ? Semantic.success
        : root.outcome == SettingsOutcome.busy ? Semantic.sync-active
        : root.outcome == SettingsOutcome.failed ? Semantic.danger
        : Semantic.warning;
}

// The ceremony's busy dot (r2 D34): the status line's busy token in
// the row's dot slot — structure is the model flag; the pulse is
// purely decorative and never asserted (the mock-clock tests assert
// the flag timeline, not pixels).
component BusyDot inherits Rectangle {
    width: Theme.space-2;
    height: self.width;
    border-radius: self.width / 2;
    background: Semantic.sync-active;
    opacity: 1.0;
    states [
        pulse when true: {
            opacity: 0.45;
            in { animate opacity { duration: 600ms; iteration-count: -1; } }
        }
    ]
}

component SettingsButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    // The visible-ceremony variant (r2 D34, F21): when true, the click
    // fires *regardless of enablement* — the adapter renders the
    // refusal. Default false: every other consumer keeps the gate.
    in property <bool> click-through: false;
    callback clicked();
    border-radius: Theme.radius-small;
    background: enabled ? Theme.surface-raised : Theme.surface;
    border-width: touch.has-hover || focus-surface.has-focus ? Theme.focus-ring-width : 0;
    border-color: Semantic.focus-ring;
    min-width: Theme.space-6;
    min-height: label.preferred-height + 2 * Theme.space-2;
    // The tab stop (round-5 F13, the IconButton grammar — deliberately
    // not ActivationStop: its reservation count would make bare Return
    // yield to a cell handler that does not exist here, and steal vi
    // Normal's Return). Pointer, raw keys and the AT action share one
    // gate.
    focus-surface := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-tab-navigation: true;
        accessible-role: AccessibleRole.button;
        accessible-label: root.text;
        accessible-enabled: root.enabled;
        accessible-action-default => {
            if (root.enabled || root.click-through) {
                root.clicked();
            }
        }
        key-pressed(event) => {
            if ((event.text == Key.Return || event.text == " ")
                    && !event.modifiers.control && !event.modifiers.alt
                    && !event.modifiers.shift && !event.modifiers.meta) {
                if (root.enabled || root.click-through) {
                    root.clicked();
                }
                accept
            } else {
                reject
            }
        }
    }
    touch := TouchArea {
        clicked => {
            focus-surface.focus();
            if (root.enabled || root.click-through) {
                root.clicked();
            }
        }
    }
    label := RoleText {
        role: Typography.body;
        text: root.text;
        text-color: root.enabled ? Theme.text-primary : Theme.text-secondary;
        horizontal-alignment: center;
    }
}

// The inline error line (round-3 D19): hover-box styling under a
// field, carrying the field's reason sentence. The text is
// presentation copy pushed by the adapter (settings_status constants)
// — never asserted by tests; tests pin validity + presence.
component ErrorLine inherits Rectangle {
    in property <string> text;
    background: Theme.surface-raised;
    border-width: Theme.focus-ring-width;
    border-color: Theme.border;
    border-radius: Theme.radius-small;
    min-height: error-text.preferred-height + 2 * Theme.space-1;
    horizontal-stretch: 1;
    error-text := RoleText {
        role: Typography.caption;
        text: root.text;
        text-color: Semantic.danger;
        wrap: word-wrap;
        x: Theme.space-2;
        width: parent.width - 2 * Theme.space-2;
        y: (parent.height - self.preferred-height) / 2;
    }
}

component LabeledField inherits VerticalLayout {
    spacing: Theme.space-1;
    in property <string> label;
    in property <string> placeholder;
    in property <bool> secret: false;
    in property <int> field-index;
    in-out property <string> text;
    // The help fact (r2 D31): rides the InfoTip AND the field's
    // accessible-description — one source per help fact.
    in property <string> help;
    // The validity flavour (round-3 D19): forwarded to the field's
    // border and the error line's presence.
    in property <FieldValidity> validity: FieldValidity.neutral;
    in property <string> error-text: "";
    // The read-only rendering (the editor's env-locked rows): the
    // edit seam is not wired — a plain value replaces the field.
    // A dead control would be an acceptance failure; the value row
    // wires nothing at all.
    in property <bool> editable: true;
    callback edited(int, string);
    callback committed();
    // The focus-loss seam (the scale field's discard grammar),
    // forwarded for the general fields' staged buffers.
    callback focus-lost();
    // The row wrapper restructured from a bare HorizontalLayout
    // (round-3 D19, plan §1.3): the error line spans label + InfoTip
    // + field — mounting it inside the primitive would grow the
    // field's pinned height contract per keystroke.
    HorizontalLayout {
        spacing: Theme.space-2;
        RoleText {
            role: Typography.body;
            text: root.label;
            min-width: Theme.space-8;
            vertical-alignment: center;
        }
        help-tip := InfoTip {
            about: root.label;
            help: root.help;
        }
        TextField {
            placeholder: root.placeholder;
            label: root.label;
            description: root.help;
            commit-affordance: true;
            secret: root.secret;
            validity: root.validity;
            autofocus: false;
            read-only: !root.editable;
            text <=> root.text;
            edited(t) => {
                root.edited(root.field-index, t);
            }
            accepted(t) => {
                root.edited(root.field-index, t);
                root.committed();
            }
            focus-lost() => {
                root.focus-lost();
            }
        }
    }
    if root.error-text != "": error-line := ErrorLine {
        text: root.error-text;
    }
}

// The account cards' copy constants (round-5 chunk 8, replacing the
// r4 D39 selector copy): presentation copy, never asserted.
export global SettingsBoardCopy {
    in-out property <string> label: "Local board";
    in-out property <string> description:
        "Picks the local board to bind to this remote board.";
    in-out property <string> row-description:
        "Binds this local board to the remote board.";
    in-out property <string> placeholder: "Pick a local board";
    in-out property <string> empty-hint: "No unbound local boards";
    in-out property <string> refresh-hint: "Refresh to list the boards on this server.";
}

// The publish picker's copy constants (round-6 D-6.9): presentation
// copy, never asserted.
export global SettingsPublishCopy {
    in-out property <string> label: "Publish a local board";
    in-out property <string> description:
        "Picks the local board to publish onto this server.";
    in-out property <string> row-description:
        "Publishes this local board onto the server and binds it.";
    in-out property <string> placeholder: "Publish a local board…";
    in-out property <string> empty-hint: "No unbound local boards";
}

// One remote row's local-board picker (the shared Dropdown, chunk-3
// overlay grammar): every remote row's picker mounts on flyout site 0
// and names its item in `SettingsBoardFacts.active-item` when it
// opens, so the window-level flyout's pick resolves to this row.
component RemotePicker inherits Dropdown {
    in property <int> item-index;
    callback picked(int, int);
    rows: SettingsModel.board-options;
    selected-index: 0;
    field-text: SettingsBoardCopy.placeholder;
    field-label: SettingsBoardCopy.label;
    field-description: SettingsBoardCopy.description;
    flyout-site: 0;
    empty-hint: SettingsBoardCopy.empty-hint;
    row-activated(i) => {
        root.picked(root.item-index, i);
    }
    row-hovered(i, x, y, w, h) => {
        TooltipState.hover(
            SettingsModel.board-options[i].label,
            SettingsBoardCopy.row-description,
            [],
            x, y, w, h);
    }
    row-unhovered() => {
        TooltipState.unhover();
    }
    // The journeys' observation seam (the SettingsBoardFacts mirrors):
    // the opening picker owns the facts.
    changed open => {
        if (self.open) {
            SettingsBoardFacts.active-item = root.item-index;
            SettingsBoardFacts.field-x = self.absolute-position.x;
            SettingsBoardFacts.field-y = self.absolute-position.y;
            SettingsBoardFacts.field-w = self.width;
            SettingsBoardFacts.field-h = self.height;
        }
        SettingsBoardFacts.open = self.open;
    }
    changed highlight => {
        SettingsBoardFacts.highlight = self.highlight;
    }
}

// The account cards' publish picker (round-6 D-6.9, #699): one Deck
// card's "publish a local board" affordance — the same Dropdown
// grammar as the remote rows' pickers, mounted on flyout site 2 (0 is
// the remote rows' pickers, 1 the board bar) and mirroring the same
// `SettingsBoardFacts`, so the window-level flyout's pick resolves to
// this card. The options are the model's unbound-board list — the
// unbound-only filter IS the publish precondition, the app re-derives
// it every pass.
component DeckPublishPicker inherits Dropdown {
    in property <int> item-index;
    callback publish-picked(int, int);
    rows: SettingsModel.board-options;
    selected-index: 0;
    field-text: SettingsPublishCopy.placeholder;
    field-label: SettingsPublishCopy.label;
    field-description: SettingsPublishCopy.description;
    flyout-site: 2;
    empty-hint: SettingsPublishCopy.empty-hint;
    row-activated(i) => {
        root.publish-picked(root.item-index, i);
    }
    row-hovered(i, x, y, w, h) => {
        TooltipState.hover(
            SettingsModel.board-options[i].label,
            SettingsPublishCopy.row-description,
            [],
            x, y, w, h);
    }
    row-unhovered() => {
        TooltipState.unhover();
    }
    // The journeys' observation seam (the SettingsBoardFacts mirrors):
    // the opening picker owns the facts.
    changed open => {
        if (self.open) {
            SettingsBoardFacts.active-item = root.item-index;
            SettingsBoardFacts.field-x = self.absolute-position.x;
            SettingsBoardFacts.field-y = self.absolute-position.y;
            SettingsBoardFacts.field-w = self.width;
            SettingsBoardFacts.field-h = self.height;
        }
        SettingsBoardFacts.open = self.open;
    }
    changed highlight => {
        SettingsBoardFacts.highlight = self.highlight;
    }
}

// One general editor row (the GUI settings editor): the LabeledField
// grammar plus the app-stated badges — the env lock renders the row
// read-only with its source named; the apply fact renders the
// restart sentence (plan D5/D12: the facts travel typed, the markup
// renders them).
component GeneralField inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <string> help;
    in property <int> field-index;
    in-out property <string> text;
    in property <FieldValidity> validity;
    in property <string> error-text;
    in property <bool> env-locked: false;
    in property <bool> on-restart: false;
    callback edited(int, string);
    callback committed(int, string);
    callback focus-lost(int);
    spacing: Theme.space-1;
    LabeledField {
        label: root.label;
        placeholder: root.placeholder;
        help: root.help;
        field-index: root.field-index;
        text <=> root.text;
        validity: root.validity;
        error-text: root.error-text;
        editable: !root.env-locked;
        edited(i, t) => {
            root.edited(i, t);
        }
        committed() => {
            // The two-way text binding is current at commit: the
            // field's own value rides the property.
            root.committed(root.field-index, root.text);
        }
        focus-lost() => {
            root.focus-lost(root.field-index);
        }
    }
    if root.env-locked: RoleText {
        role: Typography.caption;
        text: "Overridden by an environment variable; edit the file or the env.";
        text-color: Semantic.warning;
    }
    if root.on-restart && !root.env-locked: RoleText {
        role: Typography.caption;
        text: "Takes effect at the next restart.";
        text-color: Theme.text-secondary;
    }
}

export component SettingsView inherits FocusScope {
    // D6.6: the back affordance routes the same close path as Escape
    // (the adapter's dedicated `settings-back-clicked` seam).
    callback back-clicked();
    // The mount seam (r3 D20a): the fields' two-way text bindings
    // clobber the model's echo/draft strings at instantiation (the
    // TextField init writes its empty initial-text through the
    // binding), so the adapter re-pushes the VM AFTER the children
    // initialised — the mount pass is the fresh echo/validity pass.
    callback view-mounted();
    callback field-edited(int, string);
    // Sign in (round-5 chunk 8): server, username, app password — the
    // connector name is derived app-side.
    callback save-clicked(string, string, string);
    // The account cards' seams (round-5 chunk 8): every int is a
    // `connection-items` index (the adapter's address table resolves
    // it); `remote-bind-picked` adds the local-board option index.
    callback remove-clicked(int);
    callback refresh-clicked(int);
    callback remote-bind-picked(int, int);
    callback create-clicked(int);
    callback disconnect-clicked(int);
    callback files-picked(int, int);
    // The Deck card's publish seam (round-6 D-6.9, #699): the item is
    // the card's `connection-items` index, the option the unbound
    // board's index in `board-options`.
    callback publish-picked(int, int);
    // The Files roster's per-row action seam (round-7 D-7.3, W-3/D1):
    // the item is the roster row's `connection-items` index; the
    // adapter resolves the board and re-derives the action kind at
    // the trust boundary.
    callback files-board-action-clicked(int);
    callback preset-picked(int);
    callback scale-committed(string);
    // The scale field's focus-loss seam (r3 D20a writer 7): a
    // Return-less edit is discarded and the echo re-syncs to live.
    callback scale-focus-lost();
    // The slider gesture (r2 D29, r4 D38): press / release — the drag
    // itself is the widget's own (the thumb follows the pointer
    // widget-internally; the theme moves once on release).
    callback scale-pressed();
    callback scale-released(float);
    // The settings editor's general seams: the text fields commit on
    // Return (the scale field's grammar) and discard on focus loss;
    // the choice controls commit on pick (the keymap preset
    // grammar). Field indices ride the `field-edited` contract
    // (5..11 = the general text fields, 12..15 = the focus minutes).
    callback general-committed(int, string);
    callback general-focus-lost(int);
    callback reminders-picked(int);
    callback sink-picked(int);
    // The [focus] section's pick seams (#625): the segmented On/Off
    // toggles, commit on pick. The minute rows ride the general
    // seams above (field indices 12..15).
    callback focus-enabled-picked(int);
    callback focus-chain-picked(int);
    callback focus-notify-picked(int);

    // The D15 mount-focus parity (round-5 F13): the view is the
    // holding scope at mount, ringed while it holds focus — the
    // sibling views' grammar.
    focus-on-tab-navigation: true;
    accessible-role: AccessibleRole.region;
    accessible-label: "Settings";
    init => {
        root.view-mounted();
        self.focus();
    }

    ring := Rectangle {
        width: 100%;
        height: 100%;
        border-width: root.has-focus ? Theme.focus-ring-width : 0;
        border-color: Semantic.focus-ring;
        border-radius: Theme.radius-medium;
    }

    VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-3;

        // The pinned header (r2 D30): the only content outside the
        // scroll — the back affordance never scrolls away.
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-2;
            back := IconButton {
                icon: IconKind.chevron-left;
                label: "Back";
                clicked => {
                    root.back-clicked();
                }
            }
            RoleText {
                role: Typography.title;
                text: "Settings";
                vertical-alignment: center;
            }
        }

        // The status line (r2 D28 contract, r3 D18 placement): tone
        // dot + mapped text, PINNED between the header and the scroll
        // viewport — a visible outcome is readable without scrolling
        // (finding 20). The row's extent is pinned (min == max == one
        // control row, vertical-stretch 0), so it is structurally
        // unable to absorb layout height — the F-C3 mechanism, dead.
        // Layouts skip invisible children, so a hidden status leaves
        // the viewport identical; a visible one shrinks it — the fix.
        // Recorded deviation from the plan's "visible: contract kept
        // verbatim": on the pinned Slint 1.18.1 a `visible: false`
        // child of a VerticalLayout still reserves its pinned height
        // AND the inter-child spacing (measured: 45 px at scale 1.0 —
        // the plan's "layouts skip invisible children" assumption is
        // falsified for pinned-height elements), which would tax the
        // viewport permanently. A conditional element is truly absent
        // (the true-skip fact), so the hidden status leaves the
        // viewport identical; a visible one shrinks it — the fix.
        if SettingsModel.last-outcome != SettingsOutcome.none: status-line := HorizontalLayout {
            spacing: Theme.space-2;
            vertical-stretch: 0;
            min-height: status-text.preferred-height + 2 * Theme.space-2;
            max-height: status-text.preferred-height + 2 * Theme.space-2;
            StatusDot {
                outcome: SettingsModel.last-outcome;
            }
            status-text := RoleText {
                role: Typography.body;
                text: SettingsModel.status-text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        // The scroll host (r2 D30): a layout cell (never an overlay
        // child — max-height is not honoured on a Flickable-hosted
        // panel, the action-menu's recorded Slint fact), hosting the
        // one content column. The header above stays pinned.
        flick := Flickable {
            vertical-stretch: 1;
            // The slider-grab fix (r3 D20b, probe P3 verdict): the
            // mouse-drag pan gesture steals a wobbling slider drag
            // (>= 8 px vertical inside 500 ms is intercepted; the
            // probe reproduced it and exonerated the preview
            // re-layout). Killing the mouse-drag pan restores the
            // full gesture while touch panning (kiosk) and wheel
            // scrolling stay alive — both ignore this property by
            // construction. Kept after the preview's removal (r4
            // D38): the steal does not need the re-layout (probe P2).
            mouse-drag-pan-enabled: false;
            // The journeys' scroll seam (r2 D30): two-way to the
            // global — journeys drive the scroll, gestures write
            // back (the two-way-to-built-in probe passed).
            // The Flickable-side property is the Slint-sanctioned
            // rename (same property, new name); the *global's* property
            // keeps its name — zero Rust churn (chunk 4's scroll
            // anchoring reads the global).
            content-y <=> SettingsScrollFacts.viewport-y;
            // The write-back mirror (r3 D20c): the flickable's
            // pan/wheel paths call `remove_binding()` on `content-y`
            // on their first write (the pinned source, probe
            // finding), severing the two-way alias above — the mirror
            // keeps the facts fresh through the severance so the
            // journeys' geometry reads stay honest.
            changed content-y => {
                SettingsScrollFacts.viewport-y = self.content-y;
            }
            // The viewport drives the journeys' facts (the
            // mirror-facts pattern).
            changed height => {
                self.mirror-facts();
            }
            changed content-height => {
                self.mirror-facts();
                // The scale commit's one-shot scroll anchor (r3
                // D20c): the new row offset is MEASURED, not
                // predicted — exact for the uniformly scaled content.
                // The clamp replaces the built-in in-bounds guard,
                // which a bound content-y disables (the downward
                // blank screen, finding 25); it holds for both
                // directions. One commit, one consume — manual
                // scrolling afterwards is never fought.
                if (SettingsScrollFacts.anchor-requested) {
                    // The restore writes `content-y` DIRECTLY: the
                    // global write rides the two-way alias, which the
                    // flickable's wheel/pan paths have severed by the
                    // time a user-triggered commit lands (probe
                    // finding) — only a direct write reaches the
                    // scroll.
                    self.content-y = clamp(
                        SettingsScrollFacts.anchor-offset
                            - SettingsScrollFacts.scale-row-y,
                        // The viewport height is the Flickable's own
                        // height (the deprecated alias is not used).
                        min(0px, self.height - self.content-height),
                        0px,
                    );
                    SettingsScrollFacts.anchor-requested = false;
                }
            }
            init => {
                self.mirror-facts();
            }
            public function mirror-facts() {
                SettingsScrollFacts.content-height = self.content-height;
                SettingsScrollFacts.viewport-height = self.height;
            }
            content := VerticalLayout {
                spacing: Theme.space-3;

        // -- connections ------------------------------------------------
        RoleText {
            role: Typography.title;
            text: "Connections";
        }

        // -- sign in (round-5 chunk 8, D-8.1) ----------------------------
        // The backend picker (r2 D32): presentational truth only — no
        // lane payload carries a backend (the sign-in ceremony is
        // Nextcloud-hardcoded by the config's world, F10). Standalone
        // renders as the disabled "coming soon" segment; a pick from a
        // disabled segment is swallowed by the widget.
        SegmentedControl {
            options: ["Nextcloud", "Standalone"];
            segment-enabled: [true, false];
            selected-index: 0;
            group-label: "Backend";
        }
        // The three field texts are the fields' own state (write-only
        // for the password, D26b); the edited seams mirror into the
        // adapter's draft (indices 1–3 of the field-edited contract).
        LabeledField {
            label: "Server";
            placeholder: "https://cloud.example.com";
            help: SettingsModel.help-server;
            field-index: 1;
            text <=> SettingsModel.draft-server;
            validity: SettingsModel.validity-server;
            error-text: SettingsModel.error-server;
            edited(i, t) => {
                root.field-edited(i, t);
            }
        }
        LabeledField {
            label: "Username";
            placeholder: "alice";
            help: SettingsModel.help-username;
            field-index: 2;
            text <=> SettingsModel.draft-username;
            validity: SettingsModel.validity-username;
            error-text: SettingsModel.error-username;
            edited(i, t) => {
                root.field-edited(i, t);
            }
        }
        password-field := LabeledField {
            label: "App password";
            // The eye can reveal the buffer now (r3 D16): the old
            // "never shown" placeholder is false advertising.
            placeholder: "paste the app password";
            help: SettingsModel.help-app-password;
            secret: true;
            field-index: 3;
            validity: SettingsModel.validity-password;
            error-text: SettingsModel.error-password;
            edited(i, t) => {
                root.field-edited(i, t);
            }
        }
        // Sign in carries click-through (r2 D34, F21): every click
        // produces a visible reaction — the disabled/invalid paths
        // render the refusal through the status line instead of
        // absorbing silently. The password rides the callback args
        // only — it never lands on any pushed model property (D26b).
        SettingsButton {
            text: "Sign in";
            enabled: SettingsModel.save-enabled;
            click-through: true;
            clicked => {
                root.save-clicked(
                    SettingsModel.draft-server,
                    SettingsModel.draft-username,
                    password-field.text,
                );
            }
        }

        // -- the account cards (round-5 chunk 8, D-8.1/D-8.8) ------------
        // One flat, positional item list in walk order: the card
        // header (Remove), its Files toggle, a Deck row per connector
        // (Refresh), and the remote-board rows (picker + Create, or
        // Disconnect). Every enabled control is a tab stop; the
        // identity line, dots, and busy markers are not.
        for item[index] in SettingsModel.connection-items: Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-small;
            min-height: item-layout.min-height + 2 * Theme.space-1;
            item-layout := VerticalLayout {
                padding-left: item.kind == ConnectionItemKind.account ? Theme.space-2 : Theme.space-6;
                padding-right: Theme.space-2;
                padding-top: Theme.space-1;
                padding-bottom: Theme.space-1;
                if item.kind == ConnectionItemKind.account: HorizontalLayout {
                    spacing: Theme.space-2;
                    VerticalLayout {
                        alignment: center;
                        // The busy ceremony renders the pulse in the
                        // dot slot (r2 D34); otherwise the folded
                        // status dot.
                        if item.busy: BusyDot {}
                        if !item.busy: RowDot {
                            status: item.status;
                        }
                    }
                    RoleText {
                        role: Typography.body;
                        text: item.title;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    SettingsButton {
                        text: "Remove";
                        enabled: !SettingsModel.busy;
                        clicked => {
                            root.remove-clicked(index);
                        }
                    }
                    help-rows := InfoTip {
                        about: item.title;
                        help: SettingsModel.help-rows;
                    }
                }
                if item.kind == ConnectionItemKind.files: HorizontalLayout {
                    spacing: Theme.space-2;
                    RoleText {
                        role: Typography.body;
                        text: "Files";
                        min-width: Theme.space-8;
                        vertical-alignment: center;
                    }
                    // The move ceremony's in-flight marker (round-6
                    // D-6.8 phase 2, D-9): one dot, no fake progress.
                    if item.busy: VerticalLayout {
                        alignment: center;
                        BusyDot {}
                    }
                    SegmentedControl {
                        options: ["On", "Off"];
                        segment-enabled: [
                            !item.files-locked && !SettingsModel.busy,
                            !item.files-locked && !SettingsModel.busy,
                        ];
                        selected-index: item.files-on ? 0 : 1;
                        group-label: "Files sync";
                        picked(i) => {
                            root.files-picked(index, i);
                        }
                    }
                    if item.files-locked: RoleText {
                        role: Typography.caption;
                        text: "Overridden by an environment variable; edit the file or the env.";
                        text-color: Semantic.warning;
                        vertical-alignment: center;
                    }
                    if item.files-restart && !item.files-locked: RoleText {
                        role: Typography.caption;
                        text: "Files sync mirrors this account's Files — takes effect at the next restart.";
                        text-color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }
                // Roster rows (round-7 D-7.3): per-board badge + one
                // action button. Overturns round-6 D-6's "adoption is
                // automatic, disconnect is a non-goal" ruling —
                // authority:
                // .artifacts/plans/2026-11-13-gui-review-round7-plan.md
                // §2 D-7.3 (that plan authored the overturn; the UX
                // origin 2026-11-13-r7-files-roster-ux-plan.md §1
                // carries the authority note). The #755 subtree
                // leftover is recorded, not hidden.
                if item.kind == ConnectionItemKind.files-board: HorizontalLayout {
                    spacing: Theme.space-2;
                    VerticalLayout {
                        alignment: center;
                        if item.busy: BusyDot {}
                    }
                    RoleText {
                        role: Typography.body;
                        text: "Files";
                        text-color: Theme.text-secondary;
                        min-width: Theme.space-8;
                        vertical-alignment: center;
                    }
                    RoleText {
                        role: Typography.body;
                        text: item.title;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if item.archived: RoleText {
                        role: Typography.caption;
                        text: "Archived";
                        text-color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                    if item.badge-text != "": Badge {
                        text: item.badge-text;
                        // The Rust-side tone mapped onto the existing
                        // Badge vocabulary — no new `Tone` variants
                        // (the theme ruling).
                        tone: item.badge-tone == SettingsBadgeTone.success ? Tone.success
                            : item.badge-tone == SettingsBadgeTone.info ? Tone.info
                            : Tone.neutral;
                    }
                    if item.action-label != "": SettingsButton {
                        text: item.action-label;
                        enabled: item.action-enabled && !SettingsModel.busy;
                        clicked => {
                            root.files-board-action-clicked(index);
                        }
                    }
                }
                if item.kind == ConnectionItemKind.deck: VerticalLayout {
                    spacing: Theme.space-1;
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        RoleText {
                            role: Typography.body;
                            text: item.backend-word == "" ? item.title
                                : (item.show-title ? item.backend-word + " · " + item.title
                                                   : item.backend-word);
                            min-width: Theme.space-8;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            if item.busy: BusyDot {}
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        SettingsButton {
                            text: "Refresh";
                            enabled: !SettingsModel.busy;
                            clicked => {
                                root.refresh-clicked(index);
                            }
                        }
                        // The publish affordance (round-6 D-6.9): the
                        // picker's closed field IS the button — the
                        // remote rows' picker grammar (one affordance,
                        // the flyout renders window-level from site 2).
                        DeckPublishPicker {
                            item-index: index;
                            publish-picked(item-index, option) => {
                                root.publish-picked(item-index, option);
                            }
                        }
                    }
                    if !item.listed: RoleText {
                        role: Typography.caption;
                        text: SettingsBoardCopy.refresh-hint;
                        text-color: Theme.text-secondary;
                    }
                }
                if item.kind == ConnectionItemKind.remote: HorizontalLayout {
                    spacing: Theme.space-2;
                    VerticalLayout {
                        alignment: center;
                        if item.busy: BusyDot {}
                    }
                    RoleText {
                        role: Typography.body;
                        text: item.title;
                        vertical-alignment: center;
                        overflow: elide;
                        min-width: Theme.space-8;
                    }
                    if item.bound: RoleText {
                        role: Typography.body;
                        text: item.detail;
                        text-color: Theme.text-secondary;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if item.bound: SettingsButton {
                        text: "Disconnect";
                        enabled: !SettingsModel.busy;
                        clicked => {
                            root.disconnect-clicked(index);
                        }
                    }
                    if !item.bound: remote-picker := RemotePicker {
                        horizontal-stretch: 1;
                        item-index: index;
                        field-busy: item.busy;
                        picked(item-index, option) => {
                            root.remote-bind-picked(item-index, option);
                        }
                    }
                    if !item.bound: SettingsButton {
                        text: "Create local board";
                        enabled: !SettingsModel.busy;
                        clicked => {
                            root.create-clicked(index);
                        }
                    }
                }
            }
        }

        // -- keymap preset (D27b: live-apply + persist) -----------------
        HorizontalLayout {
            spacing: Theme.space-2;
            RoleText {
                role: Typography.title;
                text: "Keymap";
            }
            help-keymap := InfoTip {
                about: "Keymap";
                help: SettingsModel.help-keymap;
            }
        }
        // The keymap picker (r2 D26): one SegmentedControl replaces
        // the three inverted-`enabled` buttons — the selection renders
        // `SettingsModel.preset-index`, the click emits `picked`; the
        // echo rides the reply (r2 D27). Index order is the contract:
        // [Standard, Emacs, Vi] (the adapter's request seam).
        SegmentedControl {
            options: ["Standard", "Emacs", "Vi"];
            selected-index: SettingsModel.preset-index;
            group-label: "Keymap preset";
            picked(i) => {
                root.preset-picked(i);
            }
        }

        // -- UI scale (D27b: live-apply at commit, persist over the
        //    lane, revert on a typed Err reply) --------------------------
        RoleText {
            role: Typography.title;
            text: "Interface scale";
        }
        scale-row := HorizontalLayout {
            // The anchor's measured term (r3 D20c): the row's offset
            // within the content — scroll-independent layout space.
            changed y => {
                SettingsScrollFacts.scale-row-y = self.y;
            }
            spacing: Theme.space-2;
            RoleText {
                role: Typography.body;
                text: "Scale (0.5–3.0)";
                min-width: Theme.space-8;
                vertical-alignment: center;
            }
            help-scale := InfoTip {
                about: "Interface scale";
                help: SettingsModel.help-scale;
            }
            // The slider (r2 D29, r4 D38): the thumb follows the
            // pointer widget-internally mid-drag (no re-layout), one
            // commit per release. `value` reads `Theme.base-scale` —
            // one source of truth; commits and reply reverts move the
            // thumb.
            Slider {
                label: "Scale slider";
                minimum: 0.5;
                maximum: 3.0;
                step: 0.1;
                value: Theme.base-scale;
                pressed() => {
                    root.scale-pressed();
                }
                committed(v) => {
                    root.scale-released(v);
                }
            }
            // The scale field (round-3 D19/D20a): the flavour + error
            // line ride the same contract as the LabeledFields (a
            // VerticalLayout wrapper hosts the line — the primitive's
            // height contract stays pinned); the commit grammar is
            // Return-only.
            VerticalLayout {
                spacing: Theme.space-1;
                TextField {
                    placeholder: "1.0";
                    label: "Scale";
                    commit-affordance: true;
                    validity: SettingsModel.validity-scale;
                    // The echo renders text at mount — a focused,
                    // non-empty field would swallow the key chain
                    // (the D18 insert-mask contract). The timers-form
                    // rule applies: a field that always carries text
                    // must never grab the window's initial focus.
                    autofocus: false;
                    // The echo (r3 D20a): the field renders the
                    // model's draft-when-present, live-scale-
                    // otherwise string — the finding-23 sync hole.
                    text <=> SettingsModel.scale-echo;
                    focus-lost() => {
                        root.scale-focus-lost();
                    }
                    // Commit on Return only (D9): a per-keystroke commit
                    // would live-apply half-typed values and spam the lane.
                    // The field stays authoritative (r2 D29).
                    accepted(t) => {
                        root.scale-committed(t);
                    }
                }
                if SettingsModel.error-scale != "": ErrorLine {
                    text: SettingsModel.error-scale;
                }
            }
        }

        // -- general (the GUI settings editor) --------------------------
        RoleText {
            role: Typography.title;
            text: "General";
        }
        GeneralField {
            label: "Day starts at";
            placeholder: "00:00";
            help: SettingsModel.help-day-start;
            field-index: 5;
            text <=> SettingsModel.day-start-echo;
            validity: SettingsModel.validity-day-start;
            error-text: SettingsModel.error-day-start;
            env-locked: SettingsModel.day-start-env-locked;
            on-restart: SettingsModel.day-start-on-restart;
            edited(i, t) => {
                root.field-edited(i, t);
            }
            committed(i, t) => {
                root.general-committed(i, t);
            }
            focus-lost(i) => {
                root.general-focus-lost(i);
            }
        }

        // -- focus (the focus settings editor, #625) ------------------------
        HorizontalLayout {
            spacing: Theme.space-2;
            RoleText {
                role: Typography.title;
                text: "Focus";
            }
            InfoTip {
                about: "Focus";
                help: SettingsModel.help-focus-enabled;
            }
        }
        VerticalLayout {
            spacing: Theme.space-1;
            RoleText {
                role: Typography.body;
                text: "Focus mode";
                min-width: Theme.space-8;
                vertical-alignment: center;
            }
            SegmentedControl {
                options: ["On", "Off"];
                segment-enabled: [
                    !SettingsModel.focus-enabled-env-locked,
                    !SettingsModel.focus-enabled-env-locked,
                ];
                selected-index: SettingsModel.focus-enabled-index;
                group-label: "Focus mode";
                picked(i) => {
                    root.focus-enabled-picked(i);
                }
            }
            if SettingsModel.focus-enabled-env-locked: RoleText {
                role: Typography.caption;
                text: "Overridden by an environment variable; edit the file or the env.";
                text-color: Semantic.warning;
            }
            if SettingsModel.focus-enabled-on-restart
                && !SettingsModel.focus-enabled-env-locked: RoleText {
                role: Typography.caption;
                text: "Takes effect at the next restart.";
                text-color: Theme.text-secondary;
            }
        }
        GeneralField {
            label: "Focus block (minutes)";
            placeholder: "25";
            help: SettingsModel.help-focus-work;
            field-index: 12;
            text <=> SettingsModel.focus-work-echo;
            validity: SettingsModel.validity-focus-work;
            error-text: SettingsModel.error-focus-work;
            env-locked: SettingsModel.focus-work-env-locked;
            on-restart: SettingsModel.focus-work-on-restart;
            edited(i, t) => {
                root.field-edited(i, t);
            }
            committed(i, t) => {
                root.general-committed(i, t);
            }
            focus-lost(i) => {
                root.general-focus-lost(i);
            }
        }
        GeneralField {
            label: "Break (minutes)";
            placeholder: "5";
            help: SettingsModel.help-focus-break;
            field-index: 13;
            text <=> SettingsModel.focus-break-echo;
            validity: SettingsModel.validity-focus-break;
            error-text: SettingsModel.error-focus-break;
            env-locked: SettingsModel.focus-break-env-locked;
            on-restart: SettingsModel.focus-break-on-restart;
            edited(i, t) => {
                root.field-edited(i, t);
            }
            committed(i, t) => {
                root.general-committed(i, t);
            }
            focus-lost(i) => {
                root.general-focus-lost(i);
            }
        }
        VerticalLayout {
            spacing: Theme.space-1;
            RoleText {
                role: Typography.body;
                text: "Auto-chain blocks";
                min-width: Theme.space-8;
                vertical-alignment: center;
            }
            SegmentedControl {
                options: ["On", "Off"];
                segment-enabled: [
                    !SettingsModel.focus-chain-env-locked,
                    !SettingsModel.focus-chain-env-locked,
                ];
                selected-index: SettingsModel.focus-chain-index;
                group-label: "Auto-chain blocks";
                picked(i) => {
                    root.focus-chain-picked(i);
                }
            }
            if SettingsModel.focus-chain-env-locked: RoleText {
                role: Typography.caption;
                text: "Overridden by an environment variable; edit the file or the env.";
                text-color: Semantic.warning;
            }
            if SettingsModel.focus-chain-on-restart
                && !SettingsModel.focus-chain-env-locked: RoleText {
                role: Typography.caption;
                text: "Takes effect at the next restart.";
                text-color: Theme.text-secondary;
            }
        }
        GeneralField {
            label: "Long break (minutes)";
            placeholder: "15";
            help: SettingsModel.help-focus-long-break;
            field-index: 14;
            text <=> SettingsModel.focus-long-break-echo;
            validity: SettingsModel.validity-focus-long-break;
            error-text: SettingsModel.error-focus-long-break;
            env-locked: SettingsModel.focus-long-break-env-locked;
            on-restart: SettingsModel.focus-long-break-on-restart;
            edited(i, t) => {
                root.field-edited(i, t);
            }
            committed(i, t) => {
                root.general-committed(i, t);
            }
            focus-lost(i) => {
                root.general-focus-lost(i);
            }
        }
        GeneralField {
            label: "Long break every (blocks)";
            placeholder: "4";
            help: SettingsModel.help-focus-every;
            field-index: 15;
            text <=> SettingsModel.focus-every-echo;
            validity: SettingsModel.validity-focus-every;
            error-text: SettingsModel.error-focus-every;
            env-locked: SettingsModel.focus-every-env-locked;
            on-restart: SettingsModel.focus-every-on-restart;
            edited(i, t) => {
                root.field-edited(i, t);
            }
            committed(i, t) => {
                root.general-committed(i, t);
            }
            focus-lost(i) => {
                root.general-focus-lost(i);
            }
        }
        VerticalLayout {
            spacing: Theme.space-1;
            RoleText {
                role: Typography.body;
                text: "Boundary notifications";
                min-width: Theme.space-8;
                vertical-alignment: center;
            }
            SegmentedControl {
                options: ["On", "Off"];
                segment-enabled: [
                    !SettingsModel.focus-notify-env-locked,
                    !SettingsModel.focus-notify-env-locked,
                ];
                selected-index: SettingsModel.focus-notify-index;
                group-label: "Boundary notifications";
                picked(i) => {
                    root.focus-notify-picked(i);
                }
            }
            if SettingsModel.focus-notify-env-locked: RoleText {
                role: Typography.caption;
                text: "Overridden by an environment variable; edit the file or the env.";
                text-color: Semantic.warning;
            }
            if SettingsModel.focus-notify-on-restart
                && !SettingsModel.focus-notify-env-locked: RoleText {
                role: Typography.caption;
                text: "Takes effect at the next restart.";
                text-color: Theme.text-secondary;
            }
        }

        // -- reminders ----------------------------------------------------
        HorizontalLayout {
            spacing: Theme.space-2;
            RoleText {
                role: Typography.title;
                text: "Reminders";
            }
            InfoTip {
                about: "Reminders";
                help: SettingsModel.help-reminders;
            }
        }
        VerticalLayout {
            spacing: Theme.space-1;
            RoleText {
                role: Typography.body;
                text: "Reminders";
                min-width: Theme.space-8;
                vertical-alignment: center;
            }
            SegmentedControl {
                options: ["On", "Off"];
                segment-enabled: [
                    !SettingsModel.reminders-enabled-env-locked,
                    !SettingsModel.reminders-enabled-env-locked,
                ];
                selected-index: SettingsModel.reminders-enabled-index;
                group-label: "Reminders";
                picked(i) => {
                    root.reminders-picked(i);
                }
            }
            if SettingsModel.reminders-enabled-env-locked: RoleText {
                role: Typography.caption;
                text: "Overridden by an environment variable; edit the file or the env.";
                text-color: Semantic.warning;
            }
            if SettingsModel.reminders-enabled-on-restart
                && !SettingsModel.reminders-enabled-env-locked: RoleText {
                role: Typography.caption;
                text: "Takes effect at the next restart.";
                text-color: Theme.text-secondary;
            }
        }
        GeneralField {
            label: "Tick (seconds)";
            placeholder: "30";
            help: SettingsModel.help-tick;
            field-index: 6;
            text <=> SettingsModel.tick-echo;
            validity: SettingsModel.validity-tick;
            error-text: SettingsModel.error-tick;
            env-locked: SettingsModel.tick-env-locked;
            on-restart: SettingsModel.tick-on-restart;
            edited(i, t) => {
                root.field-edited(i, t);
            }
            committed(i, t) => {
                root.general-committed(i, t);
            }
            focus-lost(i) => {
                root.general-focus-lost(i);
            }
        }
        GeneralField {
            label: "Reminder before";
            placeholder: "5m";
            help: SettingsModel.help-before;
            field-index: 7;
            text <=> SettingsModel.before-echo;
            validity: SettingsModel.validity-before;
            error-text: SettingsModel.error-before;
            env-locked: SettingsModel.before-env-locked;
            on-restart: SettingsModel.before-on-restart;
            edited(i, t) => {
                root.field-edited(i, t);
            }
            committed(i, t) => {
                root.general-committed(i, t);
            }
            focus-lost(i) => {
                root.general-focus-lost(i);
            }
        }
        VerticalLayout {
            spacing: Theme.space-1;
            RoleText {
                role: Typography.body;
                text: "Notifier";
                min-width: Theme.space-8;
                vertical-alignment: center;
            }
            SegmentedControl {
                options: ["Auto", "Log", "Desktop"];
                segment-enabled: [
                    !SettingsModel.sink-env-locked,
                    !SettingsModel.sink-env-locked,
                    !SettingsModel.sink-env-locked,
                ];
                selected-index: SettingsModel.sink-index;
                group-label: "Notifier";
                picked(i) => {
                    root.sink-picked(i);
                }
            }
            if SettingsModel.sink-env-locked: RoleText {
                role: Typography.caption;
                text: "Overridden by an environment variable; edit the file or the env.";
                text-color: Semantic.warning;
            }
            if SettingsModel.sink-on-restart && !SettingsModel.sink-env-locked: RoleText {
                role: Typography.caption;
                text: "Takes effect at the next restart.";
                text-color: Theme.text-secondary;
            }
        }

        // -- sync timing ---------------------------------------------------
        RoleText {
            role: Typography.title;
            text: "Sync timing";
        }
        GeneralField {
            label: "Poll (seconds)";
            placeholder: "30";
            help: SettingsModel.help-poll;
            field-index: 8;
            text <=> SettingsModel.poll-echo;
            validity: SettingsModel.validity-poll;
            error-text: SettingsModel.error-poll;
            env-locked: SettingsModel.poll-env-locked;
            on-restart: SettingsModel.poll-on-restart;
            edited(i, t) => {
                root.field-edited(i, t);
            }
            committed(i, t) => {
                root.general-committed(i, t);
            }
            focus-lost(i) => {
                root.general-focus-lost(i);
            }
        }
        GeneralField {
            label: "Backoff first (seconds)";
            placeholder: "5";
            help: SettingsModel.help-backoff;
            field-index: 9;
            text <=> SettingsModel.backoff-initial-echo;
            validity: SettingsModel.validity-backoff-initial;
            error-text: SettingsModel.error-backoff-initial;
            env-locked: SettingsModel.backoff-initial-env-locked;
            on-restart: SettingsModel.backoff-initial-on-restart;
            edited(i, t) => {
                root.field-edited(i, t);
            }
            committed(i, t) => {
                root.general-committed(i, t);
            }
            focus-lost(i) => {
                root.general-focus-lost(i);
            }
        }
        GeneralField {
            label: "Backoff max (seconds)";
            placeholder: "300";
            help: SettingsModel.help-backoff;
            field-index: 10;
            text <=> SettingsModel.backoff-max-echo;
            validity: SettingsModel.validity-backoff-max;
            error-text: SettingsModel.error-backoff-max;
            env-locked: SettingsModel.backoff-max-env-locked;
            on-restart: SettingsModel.backoff-max-on-restart;
            edited(i, t) => {
                root.field-edited(i, t);
            }
            committed(i, t) => {
                root.general-committed(i, t);
            }
            focus-lost(i) => {
                root.general-focus-lost(i);
            }
        }

        // -- display --------------------------------------------------------
        RoleText {
            role: Typography.title;
            text: "Display";
        }
        GeneralField {
            label: "Due soon (days)";
            placeholder: "1";
            help: SettingsModel.help-due-soon;
            field-index: 11;
            text <=> SettingsModel.due-soon-echo;
            validity: SettingsModel.validity-due-soon;
            error-text: SettingsModel.error-due-soon;
            env-locked: SettingsModel.due-soon-env-locked;
            on-restart: SettingsModel.due-soon-on-restart;
            edited(i, t) => {
                root.field-edited(i, t);
            }
            committed(i, t) => {
                root.general-committed(i, t);
            }
            focus-lost(i) => {
                root.general-focus-lost(i);
            }
        }

        // -- deployment (read-only facts) -----------------------------------
        RoleText {
            role: Typography.title;
            text: "Deployment";
        }
        for fact[index] in SettingsModel.facts: Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-small;
            min-height: fact-layout.min-height + 2 * Theme.space-1;
            fact-layout := HorizontalLayout {
                padding: Theme.space-1;
                spacing: Theme.space-2;
                RoleText {
                    role: Typography.caption;
                    text: fact.key;
                    text-color: Theme.text-secondary;
                    vertical-alignment: center;
                    min-width: Theme.space-8;
                }
                RoleText {
                    role: Typography.body;
                    text: fact.value;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if fact.env-locked: RoleText {
                    role: Typography.caption;
                    text: "env";
                    text-color: Semantic.warning;
                    vertical-alignment: center;
                }
                if fact.on-restart: RoleText {
                    role: Typography.caption;
                    text: "restart";
                    text-color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
        }
            }
        }

    }

    // The scroll indicator (r2 D30): the action-menu's conditional
    // indicator, consciously inline-copied (a shared ScrollBar
    // widget needs element-reference plumbing Slint 1.18 does not
    // offer; revisit at the third consumer). Only while the
    // content actually overflows.
    if (flick.content-height > flick.height): Rectangle {
        x: root.width - Theme.space-3;
        y: flick.y + Theme.space-2;
        width: Theme.space-1;
        height: flick.height - 2 * Theme.space-2;
        background: Theme.surface;
        border-radius: self.width / 2;

        Rectangle {
            width: 100%;
            background: Theme.border;
            border-radius: parent.width / 2;
            height: max(Theme.space-4, parent.height * parent.height
                / max(Theme.focus-ring-width / 4, flick.content-height));
            y: (parent.height - self.height)
                * (-flick.content-y
                    / max(Theme.focus-ring-width / 4, flick.content-height - flick.height));
        }
    }
}
