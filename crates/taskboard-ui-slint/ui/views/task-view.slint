// SPDX-License-Identifier: AGPL-3.0-only
// The task-detail view (L3, D14/D22): the title-editing surface plus
// read-only metadata display. The scope focuses itself on mount; the
// title field mounts when the edit flow opens and focuses/selects
// itself (D14). Escape's discard rides the action layer (D5) — no key
// handlers here.

import { Theme, Typography, Semantic, RoleText, Tone, DueKind } from "../theme.slint";
import { TextField } from "../widgets/text-field.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
import { RuleList, RuleRowModel } from "../compositions/rule-list.slint";
import { DueEditor, DueDayModel } from "../compositions/due-editor.slint";

// The task-detail model (D22).
export struct TaskDetailModel {
    title: string,
    stack-title: string,
    due-phrase: string,
    due-kind: DueKind,
    done: bool,
    description: string,
    edit-open: bool,
    initial-text: string,
    // The subject task's reminder rules (chunk 6, D12): display rows
    // plus the derived-fact hint; ids stay in the adapter's tables.
    rules: [RuleRowModel],
    rule-presets: [string],
    rules-hint: string,
    // The due-date editor (r2 D25): the open flag plus the pushed
    // picker state (buffer, echo, caption, grid) — the adapter owns
    // it all across refreshes (R-d), this model only carries.
    due-open: bool,
    due-text: string,
    due-echo: string,
    due-picker-open: bool,
    due-caption: string,
    due-grid: [[DueDayModel]],
}

export component TaskView inherits FocusScope {
    in property <TaskDetailModel> task;
    // The nav.focus-board binding as display strings (round-1 D12; a
    // keymap projection pushed per refresh — never hand-written).
    in property <[string]> nav-back-hint;
    callback title-committed(string);
    callback title-edited(string);
    callback back-clicked();
    // The rule-list composition's seams (chunk 6, D12): forwarded to
    // the window, resolved against the id tables there.
    callback rule-remove-clicked(int);
    callback rule-add-preset-clicked(int);
    callback rule-add-custom-accepted(string) -> bool;
    // The due editor's seams (r2 D25), forwarded to the window.
    callback due-edit-opened();
    callback due-edited(string);
    callback due-accepted(string);
    callback due-picker-toggled();
    callback due-picker-key(int);
    callback due-day-clicked(int);

    focus-on-tab-navigation: true;
    accessible-role: AccessibleRole.region;
    accessible-label: "Task: \{root.task.title}";
    init => self.focus();

    pure function due-color() -> color {
        root.task.due-kind == DueKind.overdue ? Semantic.overdue
        : root.task.due-kind == DueKind.soon ? Semantic.warning
        : root.task.due-kind == DueKind.done ? Semantic.success
        : Theme.text-secondary
    }

    // The D15 ring: rendered whenever the scope holds focus (the
    // title field's own ring supersedes it while editing).
    ring := Rectangle {
        width: 100%;
        height: 100%;
        border-width: root.has-focus ? Theme.focus-ring-width : 0;
        border-color: Semantic.focus-ring;
        border-radius: Theme.radius-medium;

        VerticalLayout {
            spacing: Theme.space-3;

            // The header (round-1 D12): the back button left of the
            // title block — the click equivalent of nav.focus-board
            // (§7.1), described and hinted by the generalized trigger.
            HorizontalLayout {
                spacing: Theme.space-3;
                alignment: start;
                IconButton {
                    icon: IconKind.chevron-left;
                    label: "Back to board";
                    description: "Returns to the board view.";
                    hint-keys: root.nav-back-hint;
                    clicked => root.back-clicked();
                }
                VerticalLayout {
                    alignment: center;
                    // The title: the edit flow's field when open, the
                    // display title otherwise (cycle-entry shows the
                    // detail, D14).
                    if (root.task.edit-open): title-field := TextField {
                        placeholder: "Task title";
                        label: "Task title";
                        commit-affordance: true;
                        initial-text: root.task.initial-text;
                        selected-on-focus: true;
                        accepted(text) => root.title-committed(text);
                        edited(text) => root.title-edited(text);
                    }
                    if (!root.task.edit-open): RoleText {
                        role: Typography.title;
                        text: root.task.title;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
            }

            // The metadata row (tertiary per D17's demotion table).
            HorizontalLayout {
                spacing: Theme.space-3;
                VerticalLayout {
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "Stack";
                    }
                    RoleText {
                        role: Typography.body;
                        text: root.task.stack-title;
                    }
                }
                VerticalLayout {
                    // The due-date region (D16). Editing is r2 D25
                    // (W2 closed; #227): the collapsed cell is the
                    // display RoleText, clickable into the DueEditor
                    // — typed entry and the calendar picker, one
                    // commit seam.
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "Due date";
                    }
                    if (!root.task.due-open): due-cell := Rectangle {
                        border-radius: Theme.radius-small;
                        accessible-role: AccessibleRole.button;
                        accessible-label: "Edit due date";
                        accessible-description: "Opens the due-date editor.";
                        accessible-action-default => { root.due-edit-opened(); }
                        touch := TouchArea {
                            clicked => { root.due-edit-opened(); }
                        }
                        RoleText {
                            role: Typography.mono;
                            text-color: root.due-color();
                            text: root.task.due-phrase == "" ? "—" : root.task.due-phrase;
                        }
                    }
                    if (root.task.due-open): DueEditor {
                        initial-text: root.task.due-text;
                        echo: root.task.due-echo;
                        picker-open: root.task.due-picker-open;
                        caption: root.task.due-caption;
                        grid: root.task.due-grid;
                        edited(text) => root.due-edited(text);
                        accepted(text) => root.due-accepted(text);
                        picker-toggled() => root.due-picker-toggled();
                        picker-key(key) => root.due-picker-key(key);
                        day-clicked(cell) => root.due-day-clicked(cell);
                    }
                }
                VerticalLayout {
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "State";
                    }
                    RoleText {
                        role: Typography.body;
                        text-color: root.task.done ? Semantic.success : Theme.text-primary;
                        text: root.task.done ? "Completed" : "Open";
                    }
                }
            }

            // The rule list (chunk 6, D12): mounted inside the editor
            // after the metadata row — extends the editor surface, no
            // new view family (D-R4).
            RuleList {
                rules: root.task.rules;
                presets: root.task.rule-presets;
                hint: root.task.rules-hint;
                remove-clicked(i) => root.rule-remove-clicked(i);
                add-preset-clicked(i) => root.rule-add-preset-clicked(i);
                add-custom-accepted(text) => root.rule-add-custom-accepted(text);
            }

            // The description (read-only body text — markup rendering
            // is POST-1.0/R10; editing is a recorded scope cut, D13).
            VerticalLayout {
                RoleText {
                    role: Typography.caption;
                    text-color: Theme.text-secondary;
                    text: "Description";
                }
                RoleText {
                    role: Typography.body;
                    text: root.task.description == "" ? "—" : root.task.description;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }

            Rectangle { vertical-stretch: 1; }
        }
    }
}
