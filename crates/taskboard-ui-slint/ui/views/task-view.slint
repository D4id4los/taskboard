// SPDX-License-Identifier: AGPL-3.0-only
// The task-detail view (L3, D14/D22): the title-editing surface plus
// read-only metadata display. The scope focuses itself on mount; the
// title field mounts when the edit flow opens and focuses/selects
// itself (D14). Escape's discard rides the action layer (D5) — no key
// handlers here.

import { Theme, Typography, Semantic, RoleText, Tone, DueKind } from "../theme.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
import { TextField } from "../widgets/text-field.slint";
import { TippedField } from "../widgets/tipped-field.slint";
import { MultiLineEditor } from "../widgets/multi-line-editor.slint";
import { InfoTip } from "../widgets/info-tip.slint";
import { RuleList, RuleRowModel } from "../compositions/rule-list.slint";
import { DueDayModel } from "../compositions/date-picker.slint";
import { TimeSlotRow } from "../widgets/time-field.slint";
import { FieldValidity } from "../widgets/text-field.slint";
import { DatePickerFacts } from "../menu-facts.slint";
import { TooltipState } from "../widgets/tooltip.slint";
import { ActivationStop } from "../widgets/activation-stop.slint";
import { EditingFacts } from "../editing-facts.slint";
import { TaskViewWalkFacts } from "../walk-facts.slint";
import { TrackPanelFacts } from "../track-panel-facts.slint";
import { FocusFacts } from "../focus-facts.slint";
import { TrackEntryRowModel } from "../compositions/track-entries.slint";

// One priority-picker slot row (UX R-3 D-1, #788): the level's
// canonical text form plus the current-value pre-mark. Display parts
// only — the slot's level resolves Rust-side through the row index
// into the closed six-value vocabulary (`unset` + the five domain
// levels, in declaration order).
export struct PrioritySlotRow {
    label: string,
    selected: bool,
}

// One label chip (UX R-3 D-2, #789): the live label's title and its
// lenient color's swatch echo (a typed color — the adapter mints it
// from the lenient domain string; unparsable renders transparent).
// Display parts only — the chip's id resolves Rust-side through the
// `IdTables::label_ids`-adjacent chip table.
export struct LabelChipModel {
    title: string,
    color: color,
}

// The task-detail model (D22).
export struct TaskDetailModel {
    title: string,
    stack-title: string,
    due-phrase: string,
    due-kind: DueKind,
    scheduled-phrase: string,
    // The subject's tracked-time total at second precision (r4 D17):
    // the pushed phrase — the box renders the model only, the tick
    // cadence is the adapter's seam.
    tracked-total: string,
    // The time-entries overlay (r4 chunk 10, D-TS8): the visible gate
    // is model-side (`!kiosk && subject present` — the display-stays,
    // action-empties posture: the total keeps showing, the affordance
    // hides), the open flag is the overlay's window-level mount
    // condition, the rows/total are the pushed halves (the total is
    // the summary row's own phrase verbatim).
    track-entries-visible: bool,
    track-entries-open: bool,
    track-entries-total: string,
    track-entries: [TrackEntryRowModel],
    done: bool,
    // The done affordance's visibility flag (issue #492): a tracker
    // subject hides the header checkbox entirely.
    can-done: bool,
    // The tracking verbs (DR-5/4, D-TU6): exactly one true while a
    // subject exists, both false without — the buttons at the header
    // row's right end (r4 D16c).
    can-track-start: bool,
    can-track-stop: bool,
    description: string,
    edit-open: bool,
    // The focus flags (US-5/W-5, D-F5): the arm path's pushed half —
    // the title/description editor flows open over the subject — the
    // closed cell's ring reads them beside the stop's own has-focus
    // and the walk-stop fact (the armed field carries the house
    // indicator with the same Theme tokens; no theme work, R-3).
    title-armed: bool,
    description-armed: bool,
    initial-text: string,
    // The subject task's reminder rules (chunk 6, D12): display rows
    // plus the derived-fact hint; ids stay in the adapter's tables.
    rules: [RuleRowModel],
    rule-presets: [string],
    rules-hint: string,
    // The task's mute state (r4 D31a): drives the muted indicator and
    // the un-mute affordance next to the hint.
    rules-muted: bool,
    // The date editors (r2 D25, round-3 D8): due and scheduled, one
    // open at a time (the flow's exclusivity) over the shared
    // picker state — the adapter owns it all across refreshes
    // (R-d), this model only carries.
    due-open: bool,
    due-text: string,
    due-echo: string,
    scheduled-open: bool,
    scheduled-text: string,
    scheduled-echo: string,
    description-edit-open: bool,
    description-initial: string,
    date-picker-open: bool,
    date-caption: string,
    date-grid: [[DueDayModel]],
    date-grid-focus: bool,
    // The one-shot field-focus hand-over (r4 D25): the grid's Enter
    // hands focus back to the armed editor's field.
    date-field-focus: bool,
    // The date field's validity flavour + the syntax hint (r4 D27).
    date-validity: FieldValidity,
    date-syntax-hint: string,
    time-syntax-hint: string,
    // The custom-offset field's validity + hint (r4 D27).
    offset-validity: FieldValidity,
    offset-error-hint: string,
    // The recur row (issue #506, plan D-8): the series head's
    // pattern echo + paused chip + pause/convert affordances.
    recur-visible: bool,
    recur-pattern: string,
    recur-paused-chip: string,
    // The inline pause editor's open flag and the armed confirm's
    // flag (the adapter owns both across refreshes).
    recur-pause-open: bool,
    recur-confirm-open: bool,
    // The repeat affordances' mount flag (round-7 D-7.1, remediated
    // 2026-11-15 per UX R-1 D-2, #790): the add row for a rule-less
    // task and the recur row's edit button mount for an OPEN subject
    // on every platform; a done subject hides them (the assembly
    // precondition made visible). Kiosk renders the row with its
    // actions DISABLED (the greyed affordance posture).
    series-edit-visible: bool,
    // The repeat affordances' enablement: false on kiosk — the recur
    // row's pause/edit/convert buttons render the disabled tone.
    series-edit-enabled: bool,
    date-time-text: string,
    // The time combobox's pushed half (r4 D26): the visible text
    // mirror, the validity flavour, the filtered quick-list rows, and
    // the scroll-to-nearest index.
    date-time-field-text: string,
    date-time-validity: FieldValidity,
    date-time-slots: [TimeSlotRow],
    date-time-nearest-row: int,
    // The priority rows' pushed halves (UX R-3 D-1, #788): the two
    // echoes (the domain text forms — the card chips' own labels;
    // empty where the field is unset) and the picker's open flags
    // (the flow's, one picker at a time — the editor exclusivity's
    // shape). The slot rows are the pushed quick-list: the six-value
    // vocabulary in order, the current value pre-marked.
    importance-echo: string,
    urgency-echo: string,
    importance-open: bool,
    urgency-open: bool,
    priority-slots: [PrioritySlotRow],
    // The effort row's pushed halves (task-detail-editor UX plan
    // US-3/D-8, #838): the chip echo (the domain text form — the
    // walk placement's twin), the inline editor's open flag (the
    // adapter-owned one-editor-at-a-time state), and the editor's
    // buffer mirror.
    effort-echo: string,
    effort-open: bool,
    effort-text: string,
    // The labels section's pushed halves (UX R-3 D-2, #789): the
    // mount flag (desktop + subject present — the detail view's own
    // platform posture), the subject's live chips in canonical
    // order, and the overlay's open flag (the flow's; the window's
    // mount condition reads it).
    labels-visible: bool,
    labels: [LabelChipModel],
    labels-open: bool,
}

export component TaskView inherits FocusScope {
    // The layout-constraint severing cap (the R6-4 idiom): the view's
    // root merge must never bound the WINDOW's max width. A row with a
    // content-bounded max width (the add-repeat affordance's icon
    // square is the live case) collapses the whole view's horizontal
    // layout max to it once the refresh settles; Slint's winit backend
    // then clamps the OS window to that width (the min-width floor is
    // all that survives), so the task view rendered in a window that
    // could not be widened past its minimum. Stating the max at the
    // component root severs the merge — the window's constraints stay
    // unbounded on every view, at every scale.
    max-width: Theme.layout-severing-max-width;
    in property <TaskDetailModel> task;
    // The nav.focus-board binding as display strings (round-1 D12; a
    // keymap projection pushed per refresh — never hand-written).
    in property <[string]> nav-back-hint;
    callback title-committed(string);
    callback title-edited(string);
    // The focus-loss settle (round-3 L1): the title flow's field
    // commits non-empty / discards empty on a focus steal.
    callback text-flow-focus-lost();
    // The closed title's click (round-3 W-SM-d, F26): routes the
    // `task.title-edit` action — click ≡ key (§7.1).
    callback title-edit-opened();
    callback back-clicked();
    // The tracking verbs (DR-5/4, D-T16): route the matching action
    // over the focused task (the subject IS the focused task).
    callback task-track-start-clicked();
    callback task-track-stop-clicked();
    // The entries overlay's open affordance (r4 chunk 10, D-TS8):
    // routes the `task.track-entries` action over the subject (click
    // ≡ key, §7.1).
    callback task-track-entries-clicked();
    // The priority pickers' seams (UX R-3 D-1, #788): a slot click
    // commits the picked level immediately (the rule-preset posture),
    // the outside click / Escape cancels — nothing dispatches.
    callback priority-slot-clicked(int);
    callback priority-dismiss-requested();
    // The echo rows' edit affordances (UX R-3 D-1): route the
    // `task.importance-edit` / `task.urgency-edit` actions over the
    // viewed task (click ≡ key, §7.1).
    callback importance-edit-asked();
    callback urgency-edit-asked();
    // The effort row's seams (task-detail-editor UX plan US-3/D-8,
    // #838), forwarded to the window: the edit affordance opens the
    // inline editor (the date-editor buffer pattern), the buffer
    // mirrors, the commit parses and dispatches the sparse
    // UpdateTask effort mask, the clear affordance commits the clear
    // twin, the cancel discards.
    // slint: task-effort-edit-opened
    callback effort-edit-opened();
    // slint: task-effort-edited
    callback effort-edited(string);
    // slint: task-effort-committed
    callback effort-committed();
    // slint: task-effort-cleared
    callback effort-cleared();
    // slint: task-effort-cancelled
    callback effort-cancelled();
    // slint: task-effort-focus-lost
    callback effort-focus-lost();
    // The labels section's seams (UX R-3 D-2, #789): the chip ×
    // unassigns over the VIEW'S SUBJECT (the section always names
    // its subject), the add affordance routes the `label.manage`
    // action (click ≡ key, §7.1). Index seams resolve through the
    // adapter's chip table.
    callback chip-unassign-clicked(int);
    callback labels-manage-asked();
    // The done checkbox (r4 D16b): raw-sends the toggled SetTaskDone
    // over the VIEW'S SUBJECT — the adapter seam resolves it (the
    // subject is not guaranteed focused; the cycle's fallback).
    callback task-done-toggled();
    // slint: task-track-toggled (UX-R8 chunk-5 D-6): the detail card's
    // control.
    callback task-track-toggled();
    // The header row's hint projections (r4 D16b/D16c): keymap
    // projections pushed per refresh — never hand-written.
    in property <[string]> task-done-hint;
    in property <[string]> task-track-hint;
    // The closed title's walk/activation binding (r4 D21): the
    // projection the title cell's tip arms with — empty where the
    // action is unbound (vi).
    in property <[string]> task-title-edit-hint;
    // The rule-list composition's seams (chunk 6, D12): forwarded to
    // the window, resolved against the id tables there.
    callback rule-remove-clicked(int);
    callback rule-add-preset-clicked(int);
    callback rule-add-custom-accepted(string) -> bool;
    // The custom offset's per-keystroke validity (r4 D27).
    callback rule-offset-edited(string);
    // D31a: the un-mute affordance routes the mute-clearing command
    // over the VIEW'S SUBJECT (the section always names its subject).
    callback rule-unmute-clicked();
    // D30: an unarmed rule row's jump affordance opens the due editor
    // for the subject task — the existing due-edit seam.
    callback rule-jump-to-due-clicked();
    // The recur row's seams (issue #506, plan D-8): pause opens the
    // inline editor (a view intent), the editor's commit carries the
    // typed date, resume clears the field, and the conversion arms
    // its confirm strip before the verb dispatches.
    // The repeat affordances' convergence (round-7 D-7.1): the add
    // row (rule-less tasks) and the recur row's edit button both
    // route the same action over the viewed subject (click ≡ key).
    callback series-edit-asked();
    callback recur-pause-asked();
    callback recur-pause-accepted(string);
    callback recur-pause-cancelled();
    callback recur-resume-clicked();
    callback recur-convert-asked();
    callback recur-convert-confirmed();
    callback recur-convert-cancelled();
    // The date editors' seams (r2 D25, round-3 D8), forwarded to the
    // window: one open seam per field, one shared interaction set.
    callback due-edit-opened();
    callback scheduled-edit-opened();
    // The description editor's seams (round-3 D15), forwarded to the
    // window; focus loss rides the shared text-flow settle.
    callback description-edit-opened();
    callback description-edited(string);
    callback description-committed(string);
    callback date-edited(string);
    callback date-accepted(string);
    callback date-picker-toggled();
    // The focus-loss settle (r4 D24): the armed editor's field losing
    // focus settles it per the commit/discard rule.
    callback date-editor-focus-lost();
    // The picker's key/day seams live on the window-level overlay
    // (round-3 D10) — bound there directly, not forwarded here.

    // The overlay's anchor (round-3 D10, re-homed by the overlay
    // migration): the armed field's closed cell, window-space — the
    // cells stay mounted unconditionally now (the in-flow swap is
    // dead), so the reads are unconditional too. The click-time push
    // (D-2, the timers idiom) lands the realized geometry into the
    // facts global in the same handler that opens; the `changed`
    // mirrors below are the keep-alives that keep the facts live
    // across host scrolls (the values are stale while the view is
    // unmounted; the overlay's mount condition is the model's own
    // open flags).
    out property <bool> date-picker-visible: root.task.date-picker-open;
    // The overlay-migration geometry seams (round-9 chunk 5, om probe):
    // the metadata block's realized rects, window-space — the om
    // geometry tests read them across the due/scheduled editor's
    // open/close (the R-7 zero-layout-shift law codified).
    out property <length> stack-rect-x: stack-column.absolute-position.x;
    out property <length> stack-rect-y: stack-column.absolute-position.y;
    out property <length> stack-rect-width: stack-column.width;
    out property <length> stack-rect-height: stack-column.height;
    out property <length> state-rect-x: state-column.absolute-position.x;
    out property <length> state-rect-y: state-column.absolute-position.y;
    out property <length> state-rect-width: state-column.width;
    out property <length> state-rect-height: state-column.height;
    out property <length> effort-rect-x: effort-row.absolute-position.x;
    out property <length> effort-rect-y: effort-row.absolute-position.y;
    out property <length> effort-rect-height: effort-row.height;
    out property <length> description-rect-y: description-section.absolute-position.y;
    out property <length> description-rect-height: description-section.height;

    private property <length> date-anchor-x: root.task.due-open
        ? due-cell.absolute-position.x
        : scheduled-cell.absolute-position.x;
    private property <length> date-anchor-y: root.task.due-open
        ? due-cell.absolute-position.y
        : scheduled-cell.absolute-position.y;
    private property <length> date-anchor-width: root.task.due-open
        ? due-cell.width
        : scheduled-cell.width;
    private property <length> date-anchor-height: root.task.due-open
        ? due-cell.height
        : scheduled-cell.height;
    // The mirrors (changed handlers — the row-selection mirror
    // precedent; they fire when the layout resolves the positions
    // after mount).
    changed date-anchor-x => { DatePickerFacts.anchor-x = root.date-anchor-x; }
    changed date-anchor-y => { DatePickerFacts.anchor-y = root.date-anchor-y; }
    changed date-anchor-width => { DatePickerFacts.anchor-width = root.date-anchor-width; }
    changed date-anchor-height => { DatePickerFacts.anchor-height = root.date-anchor-height; }
    // The click-time anchor pushes (D-2): the opener's realized
    // geometry into the facts global in the same handler that opens —
    // the pre-swap-height flip-misbranch is dead because nothing in
    // the view's layout changes on open.
    function push-due-anchor() {
        DatePickerFacts.anchor-x = due-cell.absolute-position.x;
        DatePickerFacts.anchor-y = due-cell.absolute-position.y;
        DatePickerFacts.anchor-width = due-cell.width;
        DatePickerFacts.anchor-height = due-cell.height;
    }
    function push-scheduled-anchor() {
        DatePickerFacts.anchor-x = scheduled-cell.absolute-position.x;
        DatePickerFacts.anchor-y = scheduled-cell.absolute-position.y;
        DatePickerFacts.anchor-width = scheduled-cell.width;
        DatePickerFacts.anchor-height = scheduled-cell.height;
    }

    focus-on-tab-navigation: true;
    accessible-role: AccessibleRole.region;
    accessible-label: "Task: \{root.task.title}";
    init => self.focus();

    pure function scheduled-color() -> color {
        // The scheduled start carries no overdue semantics: one
        // neutral tone (the tint language is the due field's).
        Theme.text-secondary
    }

    pure function due-color() -> color {
        root.task.due-kind == DueKind.overdue ? Semantic.overdue
        : root.task.due-kind == DueKind.soon ? Semantic.warning
        : root.task.due-kind == DueKind.done ? Semantic.success
        : Theme.text-secondary
    }

    // The D15 ring: rendered whenever the scope holds focus (the
    // title field's own ring supersedes it while editing).
    ring := Rectangle {
        width: 100%;
        height: 100%;
        border-width: root.has-focus ? Theme.focus-ring-width : 0;
        border-color: Semantic.focus-ring;
        border-radius: Theme.radius-medium;

        // The priority pickers' outside-click dismissal (UX R-3 D-1):
        // an invisible full-view underlay armed exactly while a
        // picker holds — the earlier sibling is hit-tested last, so
        // the layout's own controls absorb their clicks and every
        // non-control region cancels the picker (the track-entries
        // backdrop's view-local twin).
        if (root.task.importance-open || root.task.urgency-open): priority-catch := TouchArea {
            width: 100%;
            height: 100%;
            clicked => root.priority-dismiss-requested();
        }

        VerticalLayout {
            spacing: Theme.space-3;

            // The header row (r4 D16a): one content-height row — back
            // inline with the title (F9), the done checkbox left of
            // it (F15/D16b), tracking at the right end (F11/D16c). No
            // stretch anywhere: the phantom rows of the old back-row +
            // trailing-spacer shape are gone by construction (the
            // description is THE flexible element, D16d).
            HorizontalLayout {
                spacing: Theme.space-3;
                IconButton {
                    icon: IconKind.chevron-left;
                    label: "Back to board";
                    description: "Returns to the board view.";
                    hint-keys: root.nav-back-hint;
                    clicked => root.back-clicked();
                }
                // The done checkbox (r4 D16b, F15): the card
                // checkbox's state-less anatomy — it renders the
                // model's done flag only, no local checked state
                // anywhere, so it cannot desync (the refresh push is
                // the single writer) — with the view's closed-cell
                // grammar: the FocusScope overlay makes it a real tab
                // stop with Return/Space activation, the hover surface
                // and the tooltip arm ride the TouchArea. It stays
                // mounted while the title flow is open: doneness is
                // independent of the title buffer.
                done-box := Rectangle {
                    visible: root.task.can-done;
                    width: Theme.space-4;
                    height: Theme.space-4;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-small;
                    border-width: Theme.focus-ring-width;
                    border-color: done-focus.has-focus
                        ? Semantic.focus-ring
                        : root.task.done ? Semantic.success : Theme.text-secondary;
                    // The hover surface first (z-under the box fill):
                    // the closed cells' hover grammar.
                    if (done-touch.has-hover): Rectangle {
                        background: Theme.surface-hover;
                        border-radius: Theme.radius-small;
                    }
                    // The activation stop (r4 §2): the done box cannot
                    // be the shared ActivationStop — `accessible-role`
                    // is constant-only, and this stop is a checkbox —
                    // so the publish/latch grammar is re-stated here
                    // verbatim (the discipline lives in
                    // widgets/activation-stop.slint; keep the copies
                    // in sync).
                    done-focus := FocusScope {
                        width: 100%;
                        height: 100%;
                        focus-on-tab-navigation: true;
                        property <bool> focused: self.has-focus;
                        property <bool> activation-counted: false;
                        property <int> counted-generation: -1;
                        changed focused => {
                            if (self.focused) {
                                TaskViewWalkFacts.stop-id = 2;
                            }
                            if (self.counted-generation != EditingFacts.generation) {
                                self.counted-generation = EditingFacts.generation;
                                self.activation-counted = self.focused;
                                if (self.focused) {
                                    EditingFacts.activation-focus-count += 1;
                                }
                            } else if (self.focused != self.activation-counted) {
                                EditingFacts.activation-focus-count += self.focused ? 1 : -1;
                                self.activation-counted = self.focused;
                            }
                        }
                        accessible-role: AccessibleRole.checkbox;
                        // The done/undone verb pair (the card's
                        // presentation literals, reused verbatim so
                        // the a11y tree and click_by_label agree
                        // across surfaces).
                        accessible-label: root.task.done ? "Mark task not done" : "Mark task done";
                        accessible-action-default => { root.task-done-toggled(); }
                        key-pressed(event) => {
                            if ((event.text == Key.Return || event.text == " ")
                                && !event.modifiers.control
                                && !event.modifiers.alt
                                && !event.modifiers.shift
                                && !event.modifiers.meta) {
                                root.task-done-toggled();
                                accept
                            } else {
                                reject
                            }
                        }
                    }
                    if (root.task.done): Path {
                        width: Theme.space-4 - 2 * Theme.space-1;
                        height: Theme.space-4 - 2 * Theme.space-1;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        commands: "M 2 6 L 5 9 L 10 3";
                        stroke: Semantic.success;
                        stroke-width: Theme.focus-ring-width;
                        fill: transparent;
                        viewbox-width: 12;
                        viewbox-height: 12;
                    }
                    done-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        // The tooltip arm (blanket rule a): the same
                        // verb pair the a11y layer reads.
                        changed has-hover => {
                            if (self.has-hover) {
                                TooltipState.hover(
                                    root.task.done ? "Mark task not done" : "Mark task done",
                                    "Toggles the task's done state.",
                                    root.task-done-hint,
                                    self.absolute-position.x,
                                    self.absolute-position.y,
                                    self.width,
                                    self.height,
                                );
                            } else {
                                TooltipState.unhover();
                            }
                        }
                        clicked => {
                            TooltipState.unhover();
                            root.task-done-toggled();
                        }
                    }
                }
                // The title cell (r4 D16a): the display/field pair
                // mounts in one cell, the field stretches to the row's
                // leftover width (the display's own horizontal-stretch,
                // shared). The checkbox and tracking button stay
                // mounted around it while editing.
                if (root.task.edit-open): title-field := TippedField {
                    placeholder: "Task title";
                    label: "Task title";
                    help: "The task's name as it appears on the board and lists.";
                    commit-affordance: true;
                    initial-text: root.task.initial-text;
                    selected-on-focus: true;
                    horizontal-stretch: 1;
                    accepted(text) => root.title-committed(text);
                    edited(text) => root.title-edited(text);
                    focus-lost() => root.text-flow-focus-lost();
                }
                if (!root.task.edit-open): title-display := Rectangle {
                    border-radius: Theme.radius-small;
                    horizontal-stretch: 1;
                    // The D18 ring: the focused closed cell visibly
                    // indicates the active element (the ring width 0
                    // keeps the hover surface the rest-state
                    // differentiator).
                    border-width: title-stop.has-focus
                        || TaskViewWalkFacts.stop-id == 3
                        || root.task.title-armed
                        ? Theme.focus-ring-width
                        : 0;
                    border-color: Semantic.focus-ring;
                    // The activation stop first (z-under the text):
                    // the closed-cell grammar's walk stop; the a11y
                    // triple rides the scope (the click ≡ key seam).
                    title-stop := ActivationStop {
                        width: 100%;
                        height: 100%;
                        stop-label: "Edit title";
                        stop-description: "Arms the title editor for the viewed task.";
                        stop-id: 3;
                        activated => { root.title-edit-opened(); }
                        // The focus-origin restore (US-1/W-1): an
                        // overlay opened from the detail restores into
                        // the title cell — kind 4 in `FocusFacts`. The
                        // init leg covers the mount-after-push order
                        // (the editor unmounts and the display
                        // remounts in the same pass). The wrapper
                        // property is the `changed`-on-global idiom
                        // (the walk probe's recorded watch shape).
                        property <int> watch-restore-nonce: FocusFacts.nonce;
                        init => {
                            if (FocusFacts.anchor-kind == 4) { self.focus(); }
                        }
                        changed watch-restore-nonce => {
                            if (FocusFacts.anchor-kind == 4) { self.focus(); }
                        }
                    }
                    // The hover surface (z-over the stop, z-under the
                    // text): the due-cell grammar's hover affordance.
                    if (title-touch.has-hover): Rectangle {
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-small;
                    }
                    RoleText {
                        role: Typography.title;
                        text: root.task.title;
                        overflow: elide;
                        width: parent.width - 2 * Theme.space-2;
                        x: Theme.space-2;
                    }
                    title-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        // The tooltip arm (blanket rule a): the cell's
                        // a11y strings verbatim, the activation
                        // binding projected per refresh.
                        changed has-hover => {
                            if (self.has-hover) {
                                TooltipState.hover(
                                    "Edit title",
                                    "Arms the title editor for the viewed task.",
                                    root.task-title-edit-hint,
                                    self.absolute-position.x,
                                    self.absolute-position.y,
                                    self.width,
                                    self.height,
                                );
                            } else {
                                TooltipState.unhover();
                            }
                        }
                        clicked => {
                            TooltipState.unhover();
                            root.title-edit-opened();
                        }
                    }
                }
                // The tracking verbs (r4 D16c, F11): moved here from
                // the metadata row's State column — exactly one verb
                // while a subject exists, at the header row's right
                // end. The card badge stays fenced (#489); the summary
                // row below carries D17's total.
                if (root.task.can-track-start): IconButton {
                    icon: IconKind.play;
                    tone: Tone.info;
                    label: "Start tracking";
                    description: "Starts the timer for this task.";
                    hint-keys: root.task-track-hint;
                    clicked => root.task-track-start-clicked();
                }
                if (root.task.can-track-stop): IconButton {
                    icon: IconKind.stop;
                    tone: Tone.info;
                    label: "Stop tracking";
                    description: "Stops the timer running on this task.";
                    hint-keys: root.task-track-hint;
                    clicked => root.task-track-stop-clicked();
                }
            }

            // The metadata row (tertiary per D17's demotion table).
            HorizontalLayout {
                spacing: Theme.space-3;
                stack-column := VerticalLayout {
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "Stack";
                    }
                    RoleText {
                        role: Typography.body;
                        text: root.task.stack-title;
                    }
                }
                due-column := VerticalLayout {
                    // The due-date region (D16). Editing is r2 D25
                    // (W2 closed; #227): the collapsed cell is the
                    // display RoleText, clickable into the DueEditor
                    // — typed entry and the calendar picker, one
                    // commit seam.
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "Due date";
                    }
                    // The closed cell reads interactive (round-3
                    // D7/F13): hover surface + pointer, the title
                    // cell's grammar. Always mounted — the in-flow
                    // editor swap is dead (the overlay migration, M1):
                    // the editor opens as a window-level overlay off
                    // this cell's anchor, shifting no sibling.
                    due-cell := Rectangle {
                        border-radius: Theme.radius-small;
                        border-width: due-stop.has-focus ? Theme.focus-ring-width : 0;
                        border-color: Semantic.focus-ring;
                        due-stop := ActivationStop {
                            width: 100%;
                            height: 100%;
                            stop-label: "Edit due date";
                            stop-description: "Opens the due-date editor.";
                            stop-id: 5;
                            activated => {
                                root.push-due-anchor();
                                root.due-edit-opened();
                            }
                        }
                        if (due-touch.has-hover): Rectangle {
                            background: Theme.surface-hover;
                            border-radius: Theme.radius-small;
                        }
                        due-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            changed has-hover => {
                                if (self.has-hover) {
                                    TooltipState.hover(
                                        "Edit due date",
                                        "Opens the due-date editor.",
                                        [],
                                        self.absolute-position.x,
                                        self.absolute-position.y,
                                        self.width,
                                        self.height,
                                    );
                                } else {
                                    TooltipState.unhover();
                                }
                            }
                            clicked => {
                                TooltipState.unhover();
                                root.push-due-anchor();
                                root.due-edit-opened();
                            }
                        }
                        RoleText {
                            role: Typography.mono;
                            text-color: root.due-color();
                            text: root.task.due-phrase == "" ? "—" : root.task.due-phrase;
                        }
                    }
                }
                // The start-date column (round-3 D8/F14): the due
                // column's grammar, one look — same closed cell, the
                // same editor composition.
                scheduled-column := VerticalLayout {
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "Start date";
                    }
                    // The due cell's grammar (always mounted — the
                    // overlay migration, M1: no in-flow swap).
                    scheduled-cell := Rectangle {
                        border-radius: Theme.radius-small;
                        border-width: scheduled-stop.has-focus ? Theme.focus-ring-width : 0;
                        border-color: Semantic.focus-ring;
                        scheduled-stop := ActivationStop {
                            width: 100%;
                            height: 100%;
                            stop-label: "Edit start date";
                            stop-description: "Opens the start-date editor.";
                            stop-id: 6;
                            activated => {
                                root.push-scheduled-anchor();
                                root.scheduled-edit-opened();
                            }
                        }
                        if (scheduled-touch.has-hover): Rectangle {
                            background: Theme.surface-hover;
                            border-radius: Theme.radius-small;
                        }
                        scheduled-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            changed has-hover => {
                                if (self.has-hover) {
                                    TooltipState.hover(
                                        "Edit start date",
                                        "Opens the start-date editor.",
                                        [],
                                        self.absolute-position.x,
                                        self.absolute-position.y,
                                        self.width,
                                        self.height,
                                    );
                                } else {
                                    TooltipState.unhover();
                                }
                            }
                            clicked => {
                                TooltipState.unhover();
                                root.push-scheduled-anchor();
                                root.scheduled-edit-opened();
                            }
                        }
                        RoleText {
                            role: Typography.mono;
                            text-color: root.scheduled-color();
                            text: root.task.scheduled-phrase == "" ? "—" : root.task.scheduled-phrase;
                        }
                    }
                }
                state-column := VerticalLayout {
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "State";
                    }
                    RoleText {
                        role: Typography.body;
                        text-color: root.task.done ? Semantic.success : Theme.text-primary;
                        text: root.task.done ? "Completed" : "Open";
                    }
                }
            }

            // The priority rows (UX R-3 D-1, #788): the two echoes of
            // the card decorations' own labels (reconciliation by
            // construction — the same domain text forms), mounted in
            // the metadata block below the date columns. The picker
            // block expands under the open row: the pushed six-slot
            // quick-list, the current value pre-marked.
            if (root.task.importance-open || root.task.urgency-open): VerticalLayout {
                spacing: Theme.space-1;
                RoleText {
                    role: Typography.caption;
                    text-color: Theme.text-secondary;
                    text: root.task.importance-open ? "Importance" : "Urgency";
                }
                for slot[index] in root.task.priority-slots: Rectangle {
                    height: Theme.space-5;
                    border-radius: Theme.radius-small;
                    background: slot-touch.has-hover ? Theme.surface-hover : transparent;
                    border-width: slot.selected ? Theme.focus-ring-width : 0;
                    border-color: Semantic.focus-ring;
                    HorizontalLayout {
                        padding-left: Theme.space-2;
                        padding-right: Theme.space-2;
                        RoleText {
                            role: Typography.body;
                            text: slot.label;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        if (slot.selected): Path {
                            width: Theme.space-3;
                            height: Theme.space-3;
                            commands: "M 2 6 L 5 9 L 10 3";
                            stroke: Semantic.success;
                            stroke-width: Theme.focus-ring-width;
                            fill: transparent;
                            viewbox-width: 12;
                            viewbox-height: 12;
                        }
                    }
                    slot-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            TooltipState.unhover();
                            root.priority-slot-clicked(index);
                        }
                    }
                }
            }
            if (!root.task.importance-open && !root.task.urgency-open): HorizontalLayout {
                spacing: Theme.space-3;
                VerticalLayout {
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "Importance";
                    }
                    HorizontalLayout {
                        spacing: Theme.space-1;
                        RoleText {
                            role: Typography.mono;
                            text-color: Theme.text-secondary;
                            text: root.task.importance-echo == "" ? "—" : root.task.importance-echo;
                            vertical-alignment: center;
                        }
                        IconButton {
                            icon: IconKind.pencil;
                            tone: Tone.neutral;
                            label: "Edit importance";
                            description: "Opens the importance picker: six levels, commit on pick.";
                            clicked => root.importance-edit-asked();
                        }
                    }
                }
                VerticalLayout {
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "Urgency";
                    }
                    HorizontalLayout {
                        spacing: Theme.space-1;
                        RoleText {
                            role: Typography.mono;
                            text-color: Theme.text-secondary;
                            text: root.task.urgency-echo == "" ? "—" : root.task.urgency-echo;
                            vertical-alignment: center;
                        }
                        IconButton {
                            icon: IconKind.pencil;
                            tone: Tone.neutral;
                            label: "Edit urgency";
                            description: "Opens the urgency picker: six levels, commit on pick.";
                            clicked => root.urgency-edit-asked();
                        }
                    }
                }
            }

            // The effort row (task-detail-editor UX plan US-3/D-8,
            // #838): the chip beside the priority rows (the r3 D-1
            // metadata-block grammar; the detail view is the owning
            // surface, R-2), the edit affordance opening the inline
            // editor, and the x-clear mirroring the date fields'
            // clear (empty commit = Some(None) — the walk placement's
            // posture).
            effort-row := VerticalLayout {
                RoleText {
                    role: Typography.caption;
                    text-color: Theme.text-secondary;
                    text: "Effort";
                }
                if (!root.task.effort-open): HorizontalLayout {
                    spacing: Theme.space-1;
                    RoleText {
                        role: Typography.mono;
                        text-color: Theme.text-secondary;
                        text: root.task.effort-echo == "" ? "—" : root.task.effort-echo;
                        vertical-alignment: center;
                    }
                    IconButton {
                        icon: IconKind.pencil;
                        tone: Tone.neutral;
                        label: "Edit effort";
                        description: "Opens the effort editor: minutes, or s/m/h components.";
                        clicked => root.effort-edit-opened();
                    }
                    if (root.task.effort-echo != ""): IconButton {
                        icon: IconKind.remove;
                        tone: Tone.neutral;
                        label: "Clear effort";
                        description: "Clears the task's effort estimate.";
                        clicked => root.effort-cleared();
                    }
                }
                if (root.task.effort-open): TextField {
                    label: "Effort";
                    placeholder: "30 or 1h30m";
                    description: "The effort estimate: bare digits are minutes, s/m/h components compose.";
                    initial-text: root.task.effort-text;
                    autofocus: true;
                    edited(t) => root.effort-edited(t);
                    accepted(t) => root.effort-committed();
                    focus-lost() => root.effort-focus-lost();
                }
            }

            // The labels section (UX R-3 D-2, #789): the subject's
            // live labels as swatch chips with their unassign
            // affordances, plus the add affordance that opens the
            // labels overlay (click ≡ key — the affordance routes the
            // same `label.manage` action the keyboard binding does).
            if (root.task.labels-visible): HorizontalLayout {
                spacing: Theme.space-2;
                RoleText {
                    role: Typography.caption;
                    text-color: Theme.text-secondary;
                    text: "Labels";
                    vertical-alignment: center;
                }
                for chip[index] in root.task.labels: Rectangle {
                    border-radius: Theme.radius-small;
                    background: Theme.surface;
                    HorizontalLayout {
                        padding-left: Theme.space-2;
                        padding-right: Theme.space-1;
                        spacing: Theme.space-1;
                        Rectangle {
                            width: Theme.space-3;
                            height: Theme.space-3;
                            y: (parent.height - self.height) / 2;
                            border-radius: Theme.radius-small;
                            background: chip.color;
                            border-width: Theme.hairline-width;
                            border-color: Theme.border;
                        }
                        RoleText {
                            role: Typography.caption;
                            text: chip.title;
                            vertical-alignment: center;
                        }
                        IconButton {
                            icon: IconKind.remove;
                            tone: Tone.neutral;
                            label: "Remove label " + chip.title;
                            description: "Detaches this label from the task.";
                            clicked => root.chip-unassign-clicked(index);
                        }
                    }
                }
                IconButton {
                    icon: IconKind.plus;
                    tone: Tone.neutral;
                    label: "Add label";
                    description: "Opens the labels overlay: assign, create, edit, delete.";
                    clicked => root.labels-manage-asked();
                }
            }

            // The add-repeat affordance (round-7 D-7.1): rule-less
            // open tasks only — the recur row owns the edit side. The
            // timer icon keeps the recur family's identity; the label
            // is the hover tip.
            if (!root.task.recur-visible && root.task.series-edit-visible): IconButton {
                icon: IconKind.timer;
                tone: Tone.neutral;
                label: "Add repeat: the task joins a recurring series";
                enabled: root.task.series-edit-enabled;
                clicked => root.series-edit-asked();
            }

            // The tracked-time summary row (r4 D17): the subject's
            // total at second precision, its own full-width row under
            // the facts. Refresh-static while no entry is open — the
            // per-second tick is the adapter's seam (decision 5). The
            // value carries a hover tip (blanket rule a); the row is
            // not itself clickable.
            HorizontalLayout {
                spacing: Theme.space-3;
                RoleText {
                    role: Typography.caption;
                    text-color: Theme.text-secondary;
                    text: "Tracked";
                }
                Rectangle {
                    horizontal-stretch: 1;
                    // The a11y presence (the value is data, not a
                    // control): the addressable label the screen
                    // reader and the element lookup read.
                    accessible-role: AccessibleRole.text;
                    accessible-label: "Tracked time total";
                    RoleText {
                        role: Typography.mono;
                        text: root.task.tracked-total;
                    }
                    total-touch := TouchArea {
                        changed has-hover => {
                            if (self.has-hover) {
                                TooltipState.hover(
                                    root.task.tracked-total,
                                    "Total tracked time on this task, including any running entry.",
                                    [],
                                    self.absolute-position.x,
                                    self.absolute-position.y,
                                    self.width,
                                    self.height,
                                );
                            } else {
                                TooltipState.unhover();
                            }
                        }
                    }
                }
                // The entries affordance (r4 chunk 10, D-TS8): a
                // history icon — deliberately NOT the snooze clock
                // (F1's shared-icon class). Model-side kiosk gate;
                // the anchor geometry mirrors into the panel's facts
                // singleton (the TimerSetterFacts idiom).
                if (root.task.track-entries-visible): entries-anchor := Rectangle {
                    entries-button := IconButton {
                        icon: IconKind.history;
                        label: "Time entries";
                        description: "Opens the task's time-entries overlay: tracked history, add, edit, delete.";
                        clicked => {
                            TooltipState.unhover();
                            root.task-track-entries-clicked();
                        }
                    }
                    property <length> anchor-x: entries-button.absolute-position.x;
                    property <length> anchor-y: entries-button.absolute-position.y;
                    property <length> anchor-height: entries-button.height;
                    changed anchor-x => { TrackPanelFacts.anchor-x = self.anchor-x; }
                    changed anchor-y => { TrackPanelFacts.anchor-y = self.anchor-y; }
                    changed anchor-height => { TrackPanelFacts.anchor-height = self.anchor-height; }
                }
            }

            // The rule list (chunk 6, D12): mounted inside the editor
            // after the metadata row — extends the editor surface, no
            // new view family (D-R4).
            RuleList {
                rules: root.task.rules;
                presets: root.task.rule-presets;
                hint: root.task.rules-hint;
                muted: root.task.rules-muted;
                offset-help: "Adds a reminder the given time before the due date.";
                remove-clicked(i) => root.rule-remove-clicked(i);
                add-preset-clicked(i) => root.rule-add-preset-clicked(i);
                add-custom-accepted(text) => root.rule-add-custom-accepted(text);
                offset-validity: root.task.offset-validity;
                offset-error-hint: root.task.offset-error-hint;
                offset-edited(t) => root.rule-offset-edited(t);
                unmute-clicked() => root.rule-unmute-clicked();
                jump-to-due-clicked() => root.rule-jump-to-due-clicked();
            }

            // The recur row (issue #506, plan D-8): pattern echo +
            // paused chip + the pause/convert affordances — mounted
            // only for a recurring subject. Every control carries a
            // hover tip (label), joins the walk, and dispatches
            // through the action layer.
            if (root.task.recur-visible): VerticalLayout {
                spacing: Theme.space-1;
                HorizontalLayout {
                    spacing: Theme.space-2;
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: root.task.recur-pattern;
                        vertical-alignment: center;
                    }
                    if (root.task.recur-paused-chip != ""): Rectangle {
                        border-radius: Theme.radius-small;
                        background: Theme.surface;
                        HorizontalLayout {
                            padding-left: Theme.space-2;
                            padding-right: Theme.space-2;
                            RoleText {
                                role: Typography.caption;
                                text: root.task.recur-paused-chip;
                                vertical-alignment: center;
                            }
                        }
                    }
                    // The edit-repeat affordance (round-7 D-7.1):
                    // beside the pattern echo, the same action as the
                    // add row and the Ctrl+R binding (click ≡ key).
                    if (root.task.series-edit-visible): IconButton {
                        icon: IconKind.timer;
                        tone: Tone.neutral;
                        label: "Edit repeat: change the pattern or bound";
                        enabled: root.task.series-edit-enabled;
                        clicked => root.series-edit-asked();
                    }
                }
                if (root.task.recur-pause-open): HorizontalLayout {
                    spacing: Theme.space-2;
                    pause-field := TippedField {
                        placeholder: "YYYY-MM-DD";
                        label: "Pause through date";
                        help: "The inclusive pause-through date; the covered members do not exist.";
                        vertical-stretch: 0;
                        accepted(text) => {
                            root.recur-pause-accepted(text);
                            pause-field.text = "";
                        }
                    }
                    IconButton {
                        icon: IconKind.check;
                        tone: Tone.success;
                        label: "Pause through the typed date";
                        clicked => {
                            root.recur-pause-accepted(pause-field.text);
                            pause-field.text = "";
                        }
                    }
                    IconButton {
                        icon: IconKind.remove;
                        tone: Tone.neutral;
                        label: "Cancel pause";
                        clicked => root.recur-pause-cancelled();
                    }
                }
                if (!root.task.recur-pause-open): HorizontalLayout {
                    spacing: Theme.space-2;
                    IconButton {
                        icon: IconKind.timer;
                        tone: Tone.neutral;
                        // Vacation pause (issue #506, D-C10): the
                        // covered members do not exist — no miss, no
                        // credit.
                        label: "Pause series through a date: the covered members do not exist";
                        enabled: root.task.series-edit-enabled;
                        clicked => root.recur-pause-asked();
                    }
                    IconButton {
                        icon: IconKind.play;
                        tone: Tone.neutral;
                        label: "Resume series: clears the pause";
                        enabled: root.task.series-edit-enabled;
                        clicked => root.recur-resume-clicked();
                    }
                    IconButton {
                        icon: IconKind.check;
                        tone: Tone.neutral;
                        label: "Convert to habit: the series stops repeating, the habit continues its history";
                        enabled: root.task.series-edit-enabled;
                        clicked => root.recur-convert-asked();
                    }
                }
                // The armed confirm strip (issue #506, plan D-8): the
                // consequence names the mapping before anything
                // dispatches.
                if (root.task.recur-confirm-open): HorizontalLayout {
                    spacing: Theme.space-2;
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "Creates a habit on this board with a 1-per-period quota preset; the series stops repeating.";
                        vertical-alignment: center;
                    }
                    IconButton {
                        icon: IconKind.check;
                        tone: Tone.success;
                        label: "Confirm conversion";
                        clicked => root.recur-convert-confirmed();
                    }
                    IconButton {
                        icon: IconKind.remove;
                        tone: Tone.neutral;
                        label: "Cancel conversion";
                        clicked => root.recur-convert-cancelled();
                    }
                }
            }

            // The description (round-3 D15/#228, round-5 chunk 2):
            // the read-only body reads interactive (the closed
            // cells' grammar) and click-opens the MultiLineEditor —
            // commit on Shift+Return and on the checkmark; plain
            // Return inserts a newline; Escape's discard rides the
            // action layer; focus loss settles per the text-flow
            // rule. Markup rendering stays POST-1.0/R10.
            //
            // r4 D16d (F10): THE flexible element — the section (and
            // both branches inside it) absorbs the view's leftover
            // height; the old trailing spacer is gone. Every other
            // row stays content-height. No max-line cap: growth is
            // the layout stretch, not the content (the editor's
            // viewport rides its Flickable — the r3 cycle trap stays
            // fenced by the widget's own geometry contract).
            description-section := VerticalLayout {
                vertical-stretch: 1;
                RoleText {
                    role: Typography.caption;
                    text-color: Theme.text-secondary;
                    text: "Description";
                }
                if (!root.task.description-edit-open): description-display := Rectangle {
                    border-radius: Theme.radius-small;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    border-width: description-stop.has-focus
                        || TaskViewWalkFacts.stop-id == 11
                        || root.task.description-armed
                        ? Theme.focus-ring-width
                        : 0;
                    border-color: Semantic.focus-ring;
                    description-stop := ActivationStop {
                        width: 100%;
                        height: 100%;
                        stop-label: "Edit description";
                        stop-description: "Opens the description editor.";
                        stop-id: 11;
                        activated => { root.description-edit-opened(); }
                        // The focus-origin restore's description twin
                        // (US-1/W-1, kind 5): same grammar as the
                        // title cell.
                        property <int> watch-restore-nonce: FocusFacts.nonce;
                        init => {
                            if (FocusFacts.anchor-kind == 5) { self.focus(); }
                        }
                        changed watch-restore-nonce => {
                            if (FocusFacts.anchor-kind == 5) { self.focus(); }
                        }
                    }
                    if (description-touch.has-hover): Rectangle {
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-small;
                    }
                    // The view mount (F2/F5/F6): the inset and the
                    // pinned width live in the widget; the em-dash
                    // rides the placeholder slot (the empty-display
                    // convention, unchanged).
                    MultiLineEditor {
                        editing: false;
                        text: root.task.description;
                        placeholder: "—";
                        label: "Description";
                        autofocus: false;
                        width: 100%;
                        height: 100%;
                    }
                    description-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        changed has-hover => {
                            if (self.has-hover) {
                                TooltipState.hover(
                                    "Edit description",
                                    "Opens the description editor.",
                                    [],
                                    self.absolute-position.x,
                                    self.absolute-position.y,
                                    self.width,
                                    self.height,
                                );
                            } else {
                                TooltipState.unhover();
                            }
                        }
                        clicked => {
                            TooltipState.unhover();
                            root.description-edit-opened();
                        }
                    }
                }
                // The edit mount (D-MLE-8): the TippedField visual
                // grammar composed manually — the multiline flavour
                // this pair carried is retired with the adoption.
                if (root.task.description-edit-open): HorizontalLayout {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    // The M8 stretch fix: the editor absorbs the
                    // section's leftover height (the display mount's
                    // geometry law — the edit mount keeps its size).
                    MultiLineEditor {
                        editing: true;
                        height: 100%;
                        label: "Description";
                        placeholder: "Describe the task";
                        commit-affordance: true;
                        initial-text: root.task.description-initial;
                        horizontal-stretch: 1;
                        accepted(text) => root.description-committed(text);
                        edited(text) => root.description-edited(text);
                        focus-lost() => root.text-flow-focus-lost();
                    }
                    description-help-tip := InfoTip {
                        about: "Description";
                        help: "The task's longer body text; rendered as plain text.";
                    }
                }
            }
        }
    }
}
