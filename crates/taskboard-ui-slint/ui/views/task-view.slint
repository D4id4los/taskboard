// SPDX-License-Identifier: AGPL-3.0-only
// The task-detail view (L3, D14/D22): the title-editing surface plus
// read-only metadata display. The scope focuses itself on mount; the
// title field mounts when the edit flow opens and focuses/selects
// itself (D14). Escape's discard rides the action layer (D5) — no key
// handlers here.

import { Theme, Typography, Semantic, RoleText, Tone, DueKind } from "../theme.slint";
import { TextField } from "../widgets/text-field.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
import { RuleList, RuleRowModel } from "../compositions/rule-list.slint";
import { DueEditor } from "../compositions/due-editor.slint";
import { DueDayModel } from "../compositions/date-picker.slint";
import { DatePickerFacts } from "../menu-facts.slint";

// The task-detail model (D22).
export struct TaskDetailModel {
    title: string,
    stack-title: string,
    due-phrase: string,
    due-kind: DueKind,
    scheduled-phrase: string,
    done: bool,
    description: string,
    edit-open: bool,
    initial-text: string,
    // The subject task's reminder rules (chunk 6, D12): display rows
    // plus the derived-fact hint; ids stay in the adapter's tables.
    rules: [RuleRowModel],
    rule-presets: [string],
    rules-hint: string,
    // The date editors (r2 D25, round-3 D8): due and scheduled, one
    // open at a time (the flow's exclusivity) over the shared
    // picker state — the adapter owns it all across refreshes
    // (R-d), this model only carries.
    due-open: bool,
    due-text: string,
    due-echo: string,
    scheduled-open: bool,
    scheduled-text: string,
    scheduled-echo: string,
    date-picker-open: bool,
    date-caption: string,
    date-grid: [[DueDayModel]],
    date-grid-focus: bool,
    date-time-text: string,
}

export component TaskView inherits FocusScope {
    in property <TaskDetailModel> task;
    // The nav.focus-board binding as display strings (round-1 D12; a
    // keymap projection pushed per refresh — never hand-written).
    in property <[string]> nav-back-hint;
    callback title-committed(string);
    callback title-edited(string);
    // The focus-loss settle (round-3 L1): the title flow's field
    // commits non-empty / discards empty on a focus steal.
    callback text-flow-focus-lost();
    // The closed title's click (round-3 W-SM-d, F26): routes the
    // `task.title-edit` action — click ≡ key (§7.1).
    callback title-edit-opened();
    callback back-clicked();
    // The rule-list composition's seams (chunk 6, D12): forwarded to
    // the window, resolved against the id tables there.
    callback rule-remove-clicked(int);
    callback rule-add-preset-clicked(int);
    callback rule-add-custom-accepted(string) -> bool;
    // The date editors' seams (r2 D25, round-3 D8), forwarded to the
    // window: one open seam per field, one shared interaction set.
    callback due-edit-opened();
    callback scheduled-edit-opened();
    callback date-edited(string);
    callback date-accepted(string);
    callback date-picker-toggled();
    // The picker's key/day seams live on the window-level overlay
    // (round-3 D10) — bound there directly, not forwarded here.

    // The overlay's anchor (round-3 D10): the armed field's metadata
    // column, window-space — read from the *unconditional* column
    // elements (a conditional element's id is not reachable across
    // scopes; the columns are) and mirrored into the window-level
    // facts global the overlay reads (the MenuPanelFacts precedent;
    // values are stale while the view is unmounted, and the
    // overlay's mount condition is the model's date-picker-open).
    out property <bool> date-picker-visible: root.task.date-picker-open;
    private property <length> date-anchor-x: root.task.due-open
        ? due-column.absolute-position.x
        : scheduled-column.absolute-position.x;
    private property <length> date-anchor-y: root.task.due-open
        ? due-column.absolute-position.y
        : scheduled-column.absolute-position.y;
    private property <length> date-anchor-width: root.task.due-open
        ? due-column.width
        : scheduled-column.width;
    private property <length> date-anchor-height: root.task.due-open
        ? due-column.height - due-caption.preferred-height
        : scheduled-column.height - scheduled-caption.preferred-height;
    // The mirrors (changed handlers — the row-selection mirror
    // precedent; they fire when the layout resolves the positions
    // after mount).
    changed date-anchor-x => { DatePickerFacts.anchor-x = root.date-anchor-x; }
    changed date-anchor-y => { DatePickerFacts.anchor-y = root.date-anchor-y; }
    changed date-anchor-width => { DatePickerFacts.anchor-width = root.date-anchor-width; }
    changed date-anchor-height => { DatePickerFacts.anchor-height = root.date-anchor-height; }

    focus-on-tab-navigation: true;
    accessible-role: AccessibleRole.region;
    accessible-label: "Task: \{root.task.title}";
    init => self.focus();

    pure function scheduled-color() -> color {
        // The scheduled start carries no overdue semantics: one
        // neutral tone (the tint language is the due field's).
        Theme.text-secondary
    }

    pure function due-color() -> color {
        root.task.due-kind == DueKind.overdue ? Semantic.overdue
        : root.task.due-kind == DueKind.soon ? Semantic.warning
        : root.task.due-kind == DueKind.done ? Semantic.success
        : Theme.text-secondary
    }

    // The D15 ring: rendered whenever the scope holds focus (the
    // title field's own ring supersedes it while editing).
    ring := Rectangle {
        width: 100%;
        height: 100%;
        border-width: root.has-focus ? Theme.focus-ring-width : 0;
        border-color: Semantic.focus-ring;
        border-radius: Theme.radius-medium;

        VerticalLayout {
            spacing: Theme.space-3;

            // The header (round-1 D12): the back button left of the
            // title block — the click equivalent of nav.focus-board
            // (§7.1), described and hinted by the generalized trigger.
            HorizontalLayout {
                spacing: Theme.space-3;
                alignment: start;
                IconButton {
                    icon: IconKind.chevron-left;
                    label: "Back to board";
                    description: "Returns to the board view.";
                    hint-keys: root.nav-back-hint;
                    clicked => root.back-clicked();
                }
            }
            // The title row (round-3 W-SM-d, F26): the field leaves
            // the back-button row's centered column and stretches to
            // the detail body's full width — the display RoleText
            // already elides full-width, and the field must match
            // (the geometry pin: field width ≈ body width).
            if (root.task.edit-open): title-field := TextField {
                placeholder: "Task title";
                label: "Task title";
                commit-affordance: true;
                initial-text: root.task.initial-text;
                selected-on-focus: true;
                accepted(text) => root.title-committed(text);
                edited(text) => root.title-edited(text);
                focus-lost() => root.text-flow-focus-lost();
            }
            if (!root.task.edit-open): title-display := Rectangle {
                border-radius: Theme.radius-small;
                horizontal-stretch: 1;
                accessible-role: AccessibleRole.button;
                accessible-label: "Edit title";
                accessible-description: "Arms the title editor for the viewed task.";
                accessible-action-default => { root.title-edit-opened(); }
                // The hover surface first (z-under the text): the
                // due-cell grammar's hover affordance.
                if (title-touch.has-hover): Rectangle {
                    background: Theme.surface-raised;
                    border-radius: Theme.radius-small;
                }
                RoleText {
                    role: Typography.title;
                    text: root.task.title;
                    overflow: elide;
                    width: parent.width - 2 * Theme.space-2;
                    x: Theme.space-2;
                }
                title-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.title-edit-opened(); }
                }
            }

            // The metadata row (tertiary per D17's demotion table).
            HorizontalLayout {
                spacing: Theme.space-3;
                VerticalLayout {
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "Stack";
                    }
                    RoleText {
                        role: Typography.body;
                        text: root.task.stack-title;
                    }
                }
                due-column := VerticalLayout {
                    // The due-date region (D16). Editing is r2 D25
                    // (W2 closed; #227): the collapsed cell is the
                    // display RoleText, clickable into the DueEditor
                    // — typed entry and the calendar picker, one
                    // commit seam.
                    due-caption := RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "Due date";
                    }
                    // The closed cell reads interactive (round-3
                    // D7/F13): hover surface + pointer, the title
                    // cell's grammar.
                    if (!root.task.due-open): due-cell := Rectangle {
                        border-radius: Theme.radius-small;
                        accessible-role: AccessibleRole.button;
                        accessible-label: "Edit due date";
                        accessible-description: "Opens the due-date editor.";
                        accessible-action-default => { root.due-edit-opened(); }
                        // The hover surface first (z-under the text):
                        // the title-cell grammar's hover affordance.
                        if (due-touch.has-hover): Rectangle {
                            background: Theme.surface-hover;
                            border-radius: Theme.radius-small;
                        }
                        due-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.due-edit-opened(); }
                        }
                        RoleText {
                            role: Typography.mono;
                            text-color: root.due-color();
                            text: root.task.due-phrase == "" ? "—" : root.task.due-phrase;
                        }
                    }
                    if (root.task.due-open): due-editor := DueEditor {
                        initial-text: root.task.due-text;
                        echo: root.task.due-echo;
                        clear-affordance: true;
                        edited(text) => root.date-edited(text);
                        accepted(text) => root.date-accepted(text);
                        picker-toggled() => root.date-picker-toggled();
                    }
                }
                // The start-date column (round-3 D8/F14): the due
                // column's grammar, one look — same closed cell, the
                // same editor composition.
                scheduled-column := VerticalLayout {
                    scheduled-caption := RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "Start date";
                    }
                    if (!root.task.scheduled-open): scheduled-cell := Rectangle {
                        border-radius: Theme.radius-small;
                        accessible-role: AccessibleRole.button;
                        accessible-label: "Edit start date";
                        accessible-description: "Opens the start-date editor.";
                        accessible-action-default => { root.scheduled-edit-opened(); }
                        if (scheduled-touch.has-hover): Rectangle {
                            background: Theme.surface-hover;
                            border-radius: Theme.radius-small;
                        }
                        scheduled-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.scheduled-edit-opened(); }
                        }
                        RoleText {
                            role: Typography.mono;
                            text-color: root.scheduled-color();
                            text: root.task.scheduled-phrase == "" ? "—" : root.task.scheduled-phrase;
                        }
                    }
                    if (root.task.scheduled-open): scheduled-editor := DueEditor {
                        field-label: "Start date entry";
                        entry-placeholder: "YYYY-MM-DD or +2d";
                        initial-text: root.task.scheduled-text;
                        echo: root.task.scheduled-echo;
                        clear-affordance: true;
                        edited(text) => root.date-edited(text);
                        accepted(text) => root.date-accepted(text);
                        picker-toggled() => root.date-picker-toggled();
                    }
                }
                VerticalLayout {
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "State";
                    }
                    RoleText {
                        role: Typography.body;
                        text-color: root.task.done ? Semantic.success : Theme.text-primary;
                        text: root.task.done ? "Completed" : "Open";
                    }
                }
            }

            // The rule list (chunk 6, D12): mounted inside the editor
            // after the metadata row — extends the editor surface, no
            // new view family (D-R4).
            RuleList {
                rules: root.task.rules;
                presets: root.task.rule-presets;
                hint: root.task.rules-hint;
                remove-clicked(i) => root.rule-remove-clicked(i);
                add-preset-clicked(i) => root.rule-add-preset-clicked(i);
                add-custom-accepted(text) => root.rule-add-custom-accepted(text);
            }

            // The description (read-only body text — markup rendering
            // is POST-1.0/R10; editing is a recorded scope cut, D13).
            VerticalLayout {
                RoleText {
                    role: Typography.caption;
                    text-color: Theme.text-secondary;
                    text: "Description";
                }
                RoleText {
                    role: Typography.body;
                    text: root.task.description == "" ? "—" : root.task.description;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }

            Rectangle { vertical-stretch: 1; }
        }
    }
}
