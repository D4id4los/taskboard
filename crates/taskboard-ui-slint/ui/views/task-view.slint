// SPDX-License-Identifier: AGPL-3.0-only
// The task-detail view (L3, D14/D22): the title-editing surface plus
// read-only metadata display. The scope focuses itself on mount; the
// title field mounts when the edit flow opens and focuses/selects
// itself (D14). Escape's discard rides the action layer (D5) — no key
// handlers here.

import { CheckBox } from "../widgets/check-box.slint";
import { Dropdown, DropdownConsumer, DropdownRow } from "../widgets/dropdown.slint";
import { AnchorMirror } from "../widgets/anchored-overlay.slint";
import { Theme, Typography, Semantic, RoleText, Tone, DueKind } from "../theme.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
import { TextButton } from "../widgets/text-button.slint";
import { TextField } from "../widgets/text-field.slint";
import { TippedField } from "../widgets/tipped-field.slint";
import { MultiLineEditor } from "../widgets/multi-line-editor.slint";
import { SegmentedControl } from "../widgets/segmented-control.slint";
import { InfoTip } from "../widgets/info-tip.slint";
import { RuleList, RuleRowModel } from "../compositions/rule-list.slint";
import { ConfirmStrip } from "../widgets/confirm-strip.slint";
import { ActionChip } from "../widgets/action-chip.slint";
import { DueDayModel } from "../compositions/date-picker.slint";
import { TimeSlotRow } from "../widgets/time-field.slint";
import { FieldValidity } from "../widgets/text-field.slint";
import { DatePickerFacts } from "../menu-facts.slint";
import { TooltipState } from "../widgets/tooltip.slint";
import { LabeledValueRow, RowMode } from "../widgets/labeled-value-row.slint";
import { ToggleStrip } from "../widgets/toggle-strip.slint";
import { EditingFacts } from "../editing-facts.slint";
import { TaskViewWalkFacts } from "../walk-facts.slint";
import { FocusFacts } from "../focus-facts.slint";
import { TrackPanelFacts } from "../track-panel-facts.slint";
import { TrackEntryRowModel } from "../compositions/track-entries.slint";

// The priority pickers' slot rows retired (round-9 chunk 15 D-4):
// the six-value vocabulary rides the shared `DropdownRow` (the
// widget class's model) — the row's level still resolves Rust-side
// through the index into the closed vocabulary (`unset` + the five
// domain levels, in declaration order).

// One label chip (UX R-3 D-2, #789): the live label's title and its
// lenient color's swatch echo (a typed color — the adapter mints it
// from the lenient domain string; unparsable renders transparent).
// Display parts only — the chip's id resolves Rust-side through the
// `IdTables::label_ids`-adjacent chip table.
export struct LabelChipModel {
    title: string,
    color: color,
}

// The task-detail model (D22).
export struct TaskDetailModel {
    title: string,
    stack-title: string,
    due-phrase: string,
    due-kind: DueKind,
    scheduled-phrase: string,
    // The subject's tracked-time total at second precision (r4 D17):
    // the pushed phrase — the box renders the model only, the tick
    // cadence is the adapter's seam.
    tracked-total: string,
    // The time-entries overlay (r4 chunk 10, D-TS8): the visible gate
    // is model-side (`!kiosk && subject present` — the display-stays,
    // action-empties posture: the total keeps showing, the affordance
    // hides), the open flag is the overlay's window-level mount
    // condition, the rows/total are the pushed halves (the total is
    // the summary row's own phrase verbatim).
    track-entries-visible: bool,
    track-entries-open: bool,
    track-entries-total: string,
    track-entries: [TrackEntryRowModel],
    done: bool,
    // The done affordance's visibility flag (issue #492): a tracker
    // subject hides the header checkbox entirely.
    can-done: bool,
    // The tracking verbs (DR-5/4, D-TU6): exactly one true while a
    // subject exists, both false without — the buttons at the header
    // row's right end (r4 D16c).
    can-track-start: bool,
    can-track-stop: bool,
    description: string,
    edit-open: bool,
    // The focus flags (US-5/W-5, D-F5): the arm path's pushed half —
    // the title/description editor flows open over the subject — the
    // closed cell's ring reads them beside the stop's own has-focus
    // and the walk-stop fact (the armed field carries the house
    // indicator with the same Theme tokens; no theme work, R-3).
    title-armed: bool,
    description-armed: bool,
    initial-text: string,
    // The subject task's reminder rules (chunk 6, D12): display rows
    // plus the derived-fact hint; ids stay in the adapter's tables.
    rules: [RuleRowModel],
    rule-presets: [string],
    rules-hint: string,
    // The task's mute state (r4 D31a): drives the muted indicator and
    // the un-mute affordance next to the hint.
    rules-muted: bool,
    // The date editors (r2 D25, round-3 D8): due and scheduled, one
    // open at a time (the flow's exclusivity) over the shared
    // picker state — the adapter owns it all across refreshes
    // (R-d), this model only carries.
    due-open: bool,
    due-text: string,
    due-echo: string,
    scheduled-open: bool,
    scheduled-text: string,
    scheduled-echo: string,
    description-edit-open: bool,
    description-initial: string,
    date-picker-open: bool,
    date-caption: string,
    date-grid: [[DueDayModel]],
    date-grid-focus: bool,
    // The one-shot field-focus hand-over (r4 D25): the grid's Enter
    // hands focus back to the armed editor's field.
    date-field-focus: bool,
    // The date field's validity flavour + the syntax hint (r4 D27).
    date-validity: FieldValidity,
    date-syntax-hint: string,
    time-syntax-hint: string,
    // The custom-offset field's validity + hint (r4 D27).
    offset-validity: FieldValidity,
    offset-error-hint: string,
    // The recur row (issue #506, plan D-8): the series head's
    // pattern echo + paused chip + pause/convert affordances.
    recur-visible: bool,
    recur-pattern: string,
    recur-paused-chip: string,
    // The inline pause editor's open flag and the armed confirm's
    // flag (the adapter owns both across refreshes).
    recur-pause-open: bool,
    recur-confirm-open: bool,
    // The repeat affordances' mount flag (round-7 D-7.1, remediated
    // 2026-11-15 per UX R-1 D-2, #790): the add row for a rule-less
    // task and the recur row's edit button mount for an OPEN subject
    // on every platform; a done subject hides them (the assembly
    // precondition made visible). Kiosk renders the row with its
    // actions DISABLED (the greyed affordance posture).
    series-edit-visible: bool,
    // The repeat affordances' enablement: false on kiosk — the recur
    // row's pause/edit/convert buttons render the disabled tone.
    series-edit-enabled: bool,
    date-time-text: string,
    // The time combobox's pushed half (r4 D26): the visible text
    // mirror, the validity flavour, the filtered quick-list rows, and
    // the scroll-to-nearest index.
    date-time-field-text: string,
    date-time-validity: FieldValidity,
    date-time-slots: [TimeSlotRow],
    date-time-nearest-row: int,
    // The priority rows' pushed halves (UX R-3 D-1, #788; round-9
    // chunk 15 D-4): the two echoes (the domain text forms — the card
    // chips' own labels; empty where the field is unset), the open
    // flags (the flow's, one picker at a time — the editor
    // exclusivity's shape), and each field's pushed DropdownRow
    // vocabulary (the six-value list, that field's current value
    // pre-marked) with its selected index (the open-time anchor).
    importance-echo: string,
    urgency-echo: string,
    importance-open: bool,
    urgency-open: bool,
    importance-rows: [DropdownRow],
    urgency-rows: [DropdownRow],
    importance-selected-index: int,
    urgency-selected-index: int,
    // The effort row's pushed half (the overlay migration, M9): the
    // always-on field's seed — the armed buffer when the user typed,
    // the stored value's text form otherwise.
    effort-text: string,
    // The labels section's pushed halves (UX R-3 D-2, #789): the
    // mount flag (desktop + subject present — the detail view's own
    // platform posture), the subject's live chips in canonical
    // order, and the overlay's open flag (the flow's; the window's
    // mount condition reads it).
    labels-visible: bool,
    labels: [LabelChipModel],
    labels-open: bool,
    // The habit variant's mount discriminator (H4 D1): task-only
    // sections hide behind it (never dead-rendered); the habit
    // editor block mounts instead, over the sibling `HabitDetailModel`
    // window property (the draft-backed fields).
    is-habit: bool,
}

// The habit editor's pushed half (H4 D5): the draft-backed fields
// the variant rows read. Title/description ride the draft's mirrors
// (the task flows are task-typed — the recorded deviation); the
// validity flavours and the save gate are the adapter's parses.
export struct HabitDetailModel {
    title: string,
    description: string,
    // The quota row (the habit create form's exact grammar):
    // SegmentedControl index (0 day / 1 week / 2 month) + the count
    // field's text and validity.
    quota-kind: int,
    quota-count: string,
    quota-valid: bool,
    // The anchor time row (the reminder nudge's arm clock): the
    // HH:MM text, the set bit (the clear affordance mounts armed),
    // the parse validity.
    time-text: string,
    time-set: bool,
    time-valid: bool,
    // The kind (mirrors quota-kind) gates the day row: 1 mounts the
    // 7-slot weekday picker, 2 the 1..=31 day field, 0 none (the
    // UI-side trust boundary — the UI never mints a kind-mismatched
    // day).
    kind: int,
    weekday: int,
    month-day: string,
    month-valid: bool,
    // HF4 (W-6): the kind-gated schedule picker (US-5 AC-4 — visible
    // for week/month habits only) + the checked slots (Monday-first)
    // + the gate's validity (an edited-but-empty selection blocks).
    schedule-visible: bool,
    schedule-days: [bool],
    schedule-valid: bool,
    // HF4 (W-7): the reminder override's field mirrors (base
    // 0 nudge-day / 1 period-start, R-8) + the section's parse
    // validity.
    reminder-base: int,
    reminder-offset: string,
    reminder-time: string,
    reminder-snooze: string,
    reminder-valid: bool,
    // The empty-dispatch law (D5): the save affordance greys while
    // the changeset is empty (no actual edit) or any parse is off.
    can-save: bool,
}

export component TaskView inherits FocusScope {
    // The layout-constraint severing cap (the R6-4 idiom): the view's
    // root merge must never bound the WINDOW's max width. A row with a
    // content-bounded max width (the add-repeat affordance's icon
    // square is the live case) collapses the whole view's horizontal
    // layout max to it once the refresh settles; Slint's winit backend
    // then clamps the OS window to that width (the min-width floor is
    // all that survives), so the task view rendered in a window that
    // could not be widened past its minimum. Stating the max at the
    // component root severs the merge — the window's constraints stay
    // unbounded on every view, at every scale.
    max-width: Theme.layout-severing-max-width;
    in property <TaskDetailModel> task;
    // The habit editor's pushed half (H4 D5) — reads only while the
    // mount discriminator names the variant.
    in property <HabitDetailModel> habit;
    // The nav.focus-board binding as display strings (round-1 D12; a
    // keymap projection pushed per refresh — never hand-written).
    in property <[string]> nav-back-hint;
    callback title-committed(string);
    callback title-edited(string);
    // The focus-loss settle (round-3 L1): the title flow's field
    // commits non-empty / discards empty on a focus steal.
    callback text-flow-focus-lost();
    // The closed title's click (round-3 W-SM-d, F26): routes the
    // `task.title-edit` action — click ≡ key (§7.1).
    callback title-edit-opened();
    callback back-clicked();
    // The habit editor's seams (H4 D5): the draft mirrors, the
    // per-kind day row, and the save/cancel pair (the commit
    // computes the sparse changeset adapter-side).
    callback habit-title-edited(string);
    callback habit-description-edited(string);
    callback habit-quota-kind-picked(int);
    callback habit-quota-count-edited(string);
    callback habit-time-edited(string);
    callback habit-time-cleared();
    callback habit-weekday-picked(int);
    callback habit-month-day-edited(string);
    // slint: habit_schedule_day_toggled (W-6) — the schedule picker's
    // per-slot toggle (slot index Monday-first, the checked bit).
    callback habit_schedule_day_toggled(int, bool);
    // slint: habit_reminder_base_picked (W-7) — the override's base
    // row (0 nudge-day / 1 period-start).
    callback habit_reminder_base_picked(int);
    // slint: habit_reminder_offset_edited (W-7) — the offset days field.
    callback habit_reminder_offset_edited(string);
    // slint: habit_reminder_time_edited (W-7) — the fallback
    // time-of-day field.
    callback habit_reminder_time_edited(string);
    // slint: habit_reminder_snooze_edited (W-7) — the hours/days
    // snooze field.
    callback habit_reminder_snooze_edited(string);
    // slint: habit_reminder_clear_clicked (W-7) — the clear leg.
    callback habit_reminder_clear_clicked();
    callback habit_save_clicked();
    callback habit-editor-cancelled();
    // slint: habit-history-clicked (the HF3 W-8 editor History row
    // seam, US-7/S1 — opens the read-role history dialog over the
    // editor's subject).
    callback habit-history-clicked();
    // The tracking verbs (DR-5/4, D-T16): route the matching action
    // over the focused task (the subject IS the focused task).
    callback task-track-start-clicked();
    callback task-track-stop-clicked();
    // The entries overlay's open affordance (r4 chunk 10, D-TS8):
    // routes the `task.track-entries` action over the subject (click
    // ≡ key, §7.1).
    callback task-track-entries-clicked();
    // The priority pickers' seams (UX R-3 D-1, #788): a slot click
    // commits the picked level immediately (the rule-preset posture),
    // the outside click / Escape cancels — nothing dispatches.
    callback priority-slot-clicked(int);
    callback priority-dismiss-requested();
    // The echo rows' edit affordances (UX R-3 D-1): route the
    // `task.importance-edit` / `task.urgency-edit` actions over the
    // viewed task (click ≡ key, §7.1).
    callback importance-edit-asked();
    callback urgency-edit-asked();
    // The effort row's seams (the overlay migration, M9): the
    // always-on field's mirror, and the commit (Return + focus loss —
    // the D-5 guard makes unchanged values dispatch nothing).
    // slint: task-effort-edited
    callback effort-edited(string);
    // slint: task-effort-committed
    callback effort-committed();
    // slint: task-effort-focus-lost
    callback effort-focus-lost();
    // The labels section's seams (UX R-3 D-2, #789): the chip ×
    // unassigns over the VIEW'S SUBJECT (the section always names
    // its subject), the add affordance routes the `label.manage`
    // action (click ≡ key, §7.1). Index seams resolve through the
    // adapter's chip table.
    callback chip-unassign-clicked(int);
    callback labels-manage-asked();
    // The done checkbox (r4 D16b): raw-sends the toggled SetTaskDone
    // over the VIEW'S SUBJECT — the adapter seam resolves it (the
    // subject is not guaranteed focused; the cycle's fallback).
    callback task-done-toggled();
    // slint: task-track-toggled (UX-R8 chunk-5 D-6): the detail card's
    // control.
    callback task-track-toggled();
    // The header row's hint projections (r4 D16b/D16c): keymap
    // projections pushed per refresh — never hand-written.
    in property <[string]> task-done-hint;
    in property <[string]> task-track-hint;
    // The closed title's walk/activation binding (r4 D21): the
    // projection the title cell's tip arms with — empty where the
    // action is unbound (vi).
    in property <[string]> task-title-edit-hint;
    // The entries opener's + effort row's projections (J3 US-4, W-4
    // tail — round 9 chunk 11): keymap projections pushed per
    // refresh, never hand-written (the D19 rule).
    in property <[string]> task-entries-hint;
    in property <[string]> task-effort-hint;
    // The rule-list composition's seams (chunk 6, D12): forwarded to
    // the window, resolved against the id tables there.
    callback rule-remove-clicked(int);
    // The rule cursor's pointer coherence (J3 US-6 D-4, round 9
    // chunk 12): a row-body click moves the selected-rule cursor.
    callback rule-row-clicked(int);
    callback rule-add-preset-clicked(int);
    callback rule-add-custom-accepted(string) -> bool;
    // The custom offset's per-keystroke validity (r4 D27).
    callback rule-offset-edited(string);
    // D31a: the un-mute affordance routes the mute-clearing command
    // over the VIEW'S SUBJECT (the section always names its subject).
    callback rule-unmute-clicked();
    // D30: an unarmed rule row's jump affordance opens the due editor
    // for the subject task — the existing due-edit seam.
    callback rule-jump-to-due-clicked();
    // The recur row's seams (issue #506, plan D-8): pause opens the
    // inline editor (a view intent), the editor's commit carries the
    // typed date, resume clears the field, and the conversion arms
    // its confirm strip before the verb dispatches.
    // The repeat affordances' convergence (round-7 D-7.1): the add
    // row (rule-less tasks) and the recur row's edit button both
    // route the same action over the viewed subject (click ≡ key).
    callback series-edit-asked();
    callback recur-pause-asked();
    callback recur-pause-accepted(string);
    callback recur-pause-cancelled();
    callback recur-resume-clicked();
    callback recur-convert-asked();
    callback recur-convert-confirmed();
    callback recur-convert-cancelled();
    // The date editors' seams (r2 D25, round-3 D8), forwarded to the
    // window: one open seam per field, one shared interaction set.
    callback due-edit-opened();
    callback scheduled-edit-opened();
    // The description editor's seams (round-3 D15), forwarded to the
    // window; focus loss rides the shared text-flow settle.
    callback description-edit-opened();
    callback description-edited(string);
    callback description-committed(string);
    callback date-edited(string);
    callback date-accepted(string);
    callback date-picker-toggled();
    // The focus-loss settle (r4 D24): the armed editor's field losing
    // focus settles it per the commit/discard rule.
    callback date-editor-focus-lost();
    // The picker's key/day seams live on the window-level overlay
    // (round-3 D10) — bound there directly, not forwarded here.

    // The overlay's anchor (round-3 D10, re-homed by the overlay
    // migration): the armed field's closed cell, window-space — the
    // cells stay mounted unconditionally now (the in-flow swap is
    // dead), so the reads are unconditional too. The click-time push
    // (D-2, the timers idiom) lands the realized geometry into the
    // facts global in the same handler that opens; the AnchorMirror
    // below is the keep-alive that keeps the facts live across host
    // scrolls (the values are stale while the view is unmounted; the
    // overlay's mount condition is the model's own open flags).
    // The overlay-migration geometry seams (round-9 chunk 5, om probe):
    // the metadata block's realized rects, window-space — the om
    // geometry tests read them across the due/scheduled editor's
    // open/close (the R-7 zero-layout-shift law codified).
    out property <length> stack-rect-x: stack-column.absolute-position.x;
    out property <length> stack-rect-y: stack-column.absolute-position.y;
    out property <length> stack-rect-width: stack-column.width;
    out property <length> stack-rect-height: stack-column.height;
    out property <length> state-rect-x: state-column.absolute-position.x;
    out property <length> state-rect-y: state-column.absolute-position.y;
    out property <length> state-rect-width: state-column.width;
    out property <length> state-rect-height: state-column.height;
    out property <length> effort-rect-x: effort-row.absolute-position.x;
    out property <length> effort-rect-y: effort-row.absolute-position.y;
    out property <length> effort-rect-height: effort-row.height;
    out property <length> description-rect-y: description-section.absolute-position.y;
    out property <length> description-rect-height: description-section.height;

    // The keep-alive mirror (the #954 AnchorMirror idiom written
    // once: the init + changed edges are its lore — they fire when
    // the layout resolves the positions after mount; the click-time
    // push functions below stay the deterministic open edge).
    AnchorMirror {
        source-x: root.task.due-open ? due-column.value-x : scheduled-column.value-x;
        source-y: root.task.due-open ? due-column.value-y : scheduled-column.value-y;
        source-width: root.task.due-open ? due-column.value-width : scheduled-column.value-width;
        source-height: root.task.due-open ? due-column.value-height : scheduled-column.value-height;
        published(x, y, w, h) => {
            DatePickerFacts.anchor-x = x;
            DatePickerFacts.anchor-y = y;
            DatePickerFacts.anchor-width = w;
            DatePickerFacts.anchor-height = h;
        }
    }
    // The click-time anchor pushes (D-2): the opener's realized
    // geometry into the facts global in the same handler that opens —
    // the pre-swap-height flip-misbranch is dead because nothing in
    // the view's layout changes on open.
    function push-due-anchor() {
        DatePickerFacts.anchor-x = due-column.value-x;
        DatePickerFacts.anchor-y = due-column.value-y;
        DatePickerFacts.anchor-width = due-column.value-width;
        DatePickerFacts.anchor-height = due-column.value-height;
    }
    function push-scheduled-anchor() {
        DatePickerFacts.anchor-x = scheduled-column.value-x;
        DatePickerFacts.anchor-y = scheduled-column.value-y;
        DatePickerFacts.anchor-width = scheduled-column.value-width;
        DatePickerFacts.anchor-height = scheduled-column.value-height;
    }

    focus-on-tab-navigation: true;
    accessible-role: AccessibleRole.region;
    accessible-label: "Task: \{root.task.title}";
    init => self.focus();

    pure function scheduled-color() -> color {
        // The scheduled start carries no overdue semantics: one
        // neutral tone (the tint language is the due field's).
        Theme.text-secondary
    }

    pure function due-color() -> color {
        root.task.due-kind == DueKind.overdue ? Semantic.overdue
        : root.task.due-kind == DueKind.soon ? Semantic.warning
        : root.task.due-kind == DueKind.done ? Semantic.success
        : Theme.text-secondary
    }

    // The D15 ring: rendered whenever the scope holds focus (the
    // title field's own ring supersedes it while editing).
    ring := Rectangle {
        width: 100%;
        height: 100%;
        border-width: root.has-focus ? Theme.focus-ring-width : 0;
        border-color: Semantic.focus-ring;
        border-radius: Theme.radius-medium;

        // The priority pickers' outside-click dismissal (UX R-3 D-1,
        // de-sited round-9 chunk 15 D-4): the in-layout expanding
        // picker and its catch underlay are gone — the pickers ride
        // the window-level `AnchoredOverlayHost`, whose dismissal
        // layer routes `priority-dismiss-requested` (D-6).

        VerticalLayout {
            spacing: Theme.space-3;

            // The habit editor (H4 D1/D5/D6): the shared surface's
            // habit variant — the task-only body hides behind the
            // mount discriminator below; this block mounts the D5
            // rows in the existing hand-rolled row grammar (the
            // create form's exact TextField/SegmentedControl
            // vocabulary, D6 — no new row widget, W4 absorbs later).
            if (root.task.is-habit): VerticalLayout {
                spacing: Theme.space-2;
                HorizontalLayout {
                    spacing: Theme.space-2;
                    IconButton {
                        icon: IconKind.chevron-left;
                        tone: Tone.neutral;
                        label: "Back";
                        hint-keys: root.nav-back-hint;
                        clicked => root.habit-editor-cancelled();
                    }
                    TextField {
                        horizontal-stretch: 1;
                        label: "Title";
                        text: root.habit.title;
                        edited(text) => { root.habit-title-edited(text); }
                    }
                    TextButton {
                        label: "History";
                        clicked => { root.habit-history-clicked(); }
                    }
                }
                TextField {
                    label: "Description";
                    text: root.habit.description;
                    edited(text) => { root.habit-description-edited(text); }
                }
                HorizontalLayout {
                    spacing: Theme.space-3;
                    SegmentedControl {
                        options: ["Per day", "Per week", "Per month"];
                        selected-index: root.habit.quota-kind;
                        group-label: "Quota period";
                        picked(index) => { root.habit-quota-kind-picked(index); }
                    }
                    TextField {
                        horizontal-stretch: 1;
                        placeholder: "1";
                        label: "Quota (completions per period)";
                        text: root.habit.quota-count;
                        validity: root.habit.quota-valid ? FieldValidity.valid : FieldValidity.invalid;
                        edited(text) => { root.habit-quota-count-edited(text); }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    TextField {
                        horizontal-stretch: 1;
                        placeholder: "HH:MM";
                        label: "Anchor time (arms the reminder nudge)";
                        text: root.habit.time-text;
                        validity: root.habit.time-valid ? FieldValidity.valid : FieldValidity.invalid;
                        edited(text) => { root.habit-time-edited(text); }
                    }
                    if (root.habit.time-set): IconButton {
                        icon: IconKind.remove;
                        tone: Tone.neutral;
                        label: "Clear anchor time";
                        clicked => { root.habit-time-cleared(); }
                    }
                }
                // The anchor-day row (D5's variant gating): PerWeek
                // mounts the 7-slot picker, PerMonth the 1..=31 field,
                // PerDay none — the UI never mints a mismatched day.
                if (root.habit.kind == 1): ToggleStrip {
                    // The anchor-day strip (D5's variant gating; the
                    // W4 D-4 ruling): the recur editor's retired
                    // pre-W3 grammar re-expressed over the ToggleStrip
                    // primitive — single-select-over-multi is the same
                    // mask mechanism (one true slot).
                    options: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
                    checked-mask: [
                        root.habit.weekday == 0,
                        root.habit.weekday == 1,
                        root.habit.weekday == 2,
                        root.habit.weekday == 3,
                        root.habit.weekday == 4,
                        root.habit.weekday == 5,
                        root.habit.weekday == 6,
                    ];
                    picked(index) => { root.habit-weekday-picked(index); }
                }
                if (root.habit.kind == 2): TextField {
                    placeholder: "1-31";
                    label: "Anchor day of month";
                    text: root.habit.month-day;
                    validity: root.habit.month-valid ? FieldValidity.valid : FieldValidity.invalid;
                    edited(text) => { root.habit-month-day-edited(text); }
                }
                // HF4 (W-6, US-5/S1–S3): the scheduled-day picker —
                // gated by the target kind (week/month only, R-6: a
                // daily habit happens every day). Multi-select over
                // the CheckBox primitives; the commit mints the set at
                // the adapter (an edited-but-empty selection greys the
                // save — the typed invalid draft).
                if (root.habit.schedule-visible): HorizontalLayout {
                    spacing: Theme.space-2;
                    RoleText {
                        role: Typography.caption;
                        text: "Scheduled days";
                    }
                    for slot in [0, 1, 2, 3, 4, 5, 6]: CheckBox {
                        checked: root.habit.schedule_days[slot];
                        // The add/remove verb pair (the widget's label
                        // grammar: the label announces the *toggle*
                        // action, so both states name THIS slot's day).
                        checked-label: ["Remove Mon", "Remove Tue", "Remove Wed", "Remove Thu", "Remove Fri", "Remove Sat", "Remove Sun"][slot];
                        unchecked-label: ["Add Mon", "Add Tue", "Add Wed", "Add Thu", "Add Fri", "Add Sat", "Add Sun"][slot];
                        toggled => { root.habit_schedule_day_toggled(slot, !root.habit.schedule_days[slot]); }
                    }
                }
                // HF4 (W-7, US-6/S1–S3): the reminder override
                // section — base (R-8: nudge-day default, period-start
                // explicit), offset days, fallback time-of-day
                // (US-6 AC-4), snooze in hours/days (O-1), and the
                // clear leg back to the plain O-1 default.
                RoleText {
                    role: Typography.caption;
                    text: "Reminder override";
                }
                ToggleStrip {
                    options: ["Nudge day", "Period start"];
                    checked-mask: [
                        root.habit.reminder-base == 0,
                        root.habit.reminder-base == 1,
                    ];
                    picked(index) => { root.habit_reminder_base_picked(index); }
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    TextField {
                        horizontal-stretch: 1;
                        placeholder: "0";
                        label: "Offset days";
                        text: root.habit.reminder-offset;
                        edited(text) => { root.habit_reminder_offset_edited(text); }
                    }
                    TextField {
                        horizontal-stretch: 1;
                        // The blank field's actual fallback is the
                        // mint's 09:00 default (the adapter's
                        // override mint) — the placeholder names the
                        // real default, never a different example.
                        placeholder: "09:00";
                        label: "Time (no chip: used)";
                        text: root.habit.reminder-time;
                        edited(text) => { root.habit_reminder_time_edited(text); }
                    }
                    TextField {
                        horizontal-stretch: 1;
                        placeholder: "2h / 1d";
                        label: "Snooze";
                        text: root.habit.reminder-snooze;
                        validity: root.habit.reminder-valid ? FieldValidity.valid : FieldValidity.invalid;
                        edited(text) => { root.habit_reminder_snooze_edited(text); }
                    }
                    IconButton {
                        icon: IconKind.remove;
                        tone: Tone.neutral;
                        label: "Clear override";
                        clicked => { root.habit_reminder_clear_clicked(); }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    IconButton {
                        icon: IconKind.check;
                        tone: Tone.success;
                        label: "Save habit";
                        enabled: root.habit.can-save;
                        clicked => { root.habit_save_clicked(); }
                    }
                    IconButton {
                        icon: IconKind.remove;
                        tone: Tone.neutral;
                        label: "Cancel";
                        clicked => { root.habit-editor-cancelled(); }
                    }
                }
            }

            // inline with the title (F9), the done checkbox left of
            // it (F15/D16b), tracking at the right end (F11/D16c). No
            // stretch anywhere: the phantom rows of the old back-row +
            // trailing-spacer shape are gone by construction (the
            // description is THE flexible element, D16d).
            HorizontalLayout {
                visible: !root.task.is-habit;
                spacing: Theme.space-3;
                IconButton {
                    icon: IconKind.chevron-left;
                    label: "Back to board";
                    description: "Returns to the board view.";
                    hint-keys: root.nav-back-hint;
                    clicked => root.back-clicked();
                }
                // The done checkbox (r4 D16b, F15): the CheckBox
                // primitive (W3, #953) carries the whole anatomy now —
                // the state-less model-bit render, the FocusScope tab
                // stop with Return/Space, the hover surface, the
                // tooltip arm and the checkbox a11y role (the verbatim
                // ActivationStop re-statement's reason is dead). It
                // stays mounted while the title flow is open: doneness
                // is independent of the title buffer.
                done-box := CheckBox {
                    visible: root.task.can-done;
                    y: (parent.height - self.height) / 2;
                    checked: root.task.done;
                    // The done/undone verb pair (the card's
                    // presentation literals, reused verbatim so the
                    // a11y tree and click_by_label agree across
                    // surfaces).
                    checked-label: "Mark task not done";
                    unchecked-label: "Mark task done";
                    description: "Toggles the task's done state.";
                    hint-keys: root.task-done-hint;
                    toggled => { root.task-done-toggled(); }
                    // The publish/latch mirroring stays view-side,
                    // driven by the primitive's focused seam (the
                    // stop-id push + the activation-focus census).
                    changed focused => {
                        if (self.focused) {
                            TaskViewWalkFacts.stop-id = 2;
                        }
                        if (self.counted-generation != EditingFacts.generation) {
                            self.counted-generation = EditingFacts.generation;
                            self.activation-counted = self.focused;
                            if (self.focused) {
                                EditingFacts.activation-focus-count += 1;
                            }
                        } else if (self.focused != self.activation-counted) {
                            EditingFacts.activation-focus-count += self.focused ? 1 : -1;
                            self.activation-counted = self.focused;
                        }
                    }
                    property <bool> activation-counted: false;
                    property <int> counted-generation: -1;
                }
                // The title cell (r4 D16a): the display/field pair
                // mounts in one cell, the field stretches to the row's
                // leftover width (the display's own horizontal-stretch,
                // shared). The checkbox and tracking button stay
                // mounted around it while editing.
                if (root.task.edit-open): title-field := TippedField {
                    placeholder: "Task title";
                    label: "Task title";
                    help: "The task's name as it appears on the board and lists.";
                    commit-affordance: true;
                    initial-text: root.task.initial-text;
                    selected-on-focus: true;
                    horizontal-stretch: 1;
                    accepted(text) => root.title-committed(text);
                    edited(text) => root.title-edited(text);
                    focus-lost() => root.text-flow-focus-lost();
                }
                if (!root.task.edit-open): title-display := LabeledValueRow {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    // The closed title cell (the grammar's origin, r4
                    // D16a): the widget carries the stop (stop-id 3),
                    // the ring (armed/walk latch view-side), the
                    // restore law (kind 4) and the tooltip arm — the
                    // hand-rolled cell anatomy is the widget's.
                    mode: RowMode.cell;
                    value: root.task.title;
                    value-role: Typography.title;
                    value-elide: true;
                    value-fill: true;
                    value-inset: Theme.space-2;
                    placeholder-em-dash: false;
                    hover-surface: Theme.surface-raised;
                    ring-latched: TaskViewWalkFacts.stop-id == 3
                        || root.task.title-armed;
                    stop-label: "Edit title";
                    stop-description: "Arms the title editor for the viewed task.";
                    stop-id: 3;
                    hint-keys: root.task-title-edit-hint;
                    edit-asked() => { root.title-edit-opened(); }
                    // The focus-origin restore (US-1/W-1): an overlay
                    // opened from the detail restores into the title
                    // cell — kind 4 in `FocusFacts`. The init leg
                    // covers the mount-after-push order (the editor
                    // unmounts and the display remounts in the same
                    // pass); the wrapper property is the
                    // `changed`-on-global idiom (the walk probe's
                    // recorded watch shape).
                    property <int> watch-restore-nonce: FocusFacts.nonce;
                    init => {
                        if (FocusFacts.anchor-kind == 4) {
                            title-display.request-value-focus();
                        }
                    }
                    changed watch-restore-nonce => {
                        if (FocusFacts.anchor-kind == 4) {
                            title-display.request-value-focus();
                        }
                    }
                }
                // The tracking verbs (r4 D16c, F11): moved here from
                // the metadata row's State column — exactly one verb
                // while a subject exists, at the header row's right
                // end. The card badge stays fenced (#489); the summary
                // row below carries D17's total.
                if (root.task.can-track-start): IconButton {
                    icon: IconKind.play;
                    tone: Tone.info;
                    label: "Start tracking";
                    description: "Starts the timer for this task.";
                    hint-keys: root.task-track-hint;
                    clicked => root.task-track-start-clicked();
                }
                if (root.task.can-track-stop): IconButton {
                    icon: IconKind.stop;
                    tone: Tone.info;
                    label: "Stop tracking";
                    description: "Stops the timer running on this task.";
                    hint-keys: root.task-track-hint;
                    clicked => root.task-track-stop-clicked();
                }
            }

            // The metadata row (tertiary per D17's demotion table).
            HorizontalLayout {
                visible: !root.task.is-habit;
                spacing: Theme.space-3;
                // The metadata columns (the W4 absorption, R1–R4):
                // the display rows and the two clickable closed date
                // cells are the widget's modes now — the caption/value
                // grammar, the em-dash placeholder, the stop identity
                // (5/6 preserved), the tooltip arms and the hover
                // surfaces ride `LabeledValueRow`.
                stack-column := LabeledValueRow {
                    vertical-stretch: 0;
                    mode: RowMode.display;
                    label: "Stack";
                    value: root.task.stack-title;
                    value-fill: true;
                    placeholder-em-dash: false;
                }
                due-column := LabeledValueRow {
                    vertical-stretch: 0;
                    mode: RowMode.cell;
                    label: "Due date";
                    value: root.task.due-phrase;
                    value-role: Typography.mono;
                    value-color: root.due-color();
                    stop-label: "Edit due date";
                    stop-description: "Opens the due-date editor.";
                    stop-id: 5;
                    edit-asked() => {
                        root.push-due-anchor();
                        root.due-edit-opened();
                    }
                    // The per-seam restore claimant (round 5 A2, #1205):
                    // the due editor's kind 7 — the opener's own cell,
                    // never the title collapse. The nonce-wrap idiom is
                    // the title cell's recorded watch shape.
                    property <int> watch-restore-nonce: FocusFacts.nonce;
                    init => {
                        if (FocusFacts.anchor-kind == 7) {
                            due-column.request-value-focus();
                        }
                    }
                    changed watch-restore-nonce => {
                        if (FocusFacts.anchor-kind == 7) {
                            due-column.request-value-focus();
                        }
                    }
                }
                // The start-date column (round-3 D8/F14): the due
                // column's twin, one look.
                scheduled-column := LabeledValueRow {
                    vertical-stretch: 0;
                    mode: RowMode.cell;
                    label: "Start date";
                    value: root.task.scheduled-phrase;
                    value-role: Typography.mono;
                    value-color: root.scheduled-color();
                    stop-label: "Edit start date";
                    stop-description: "Opens the start-date editor.";
                    stop-id: 6;
                    edit-asked() => {
                        root.push-scheduled-anchor();
                        root.scheduled-edit-opened();
                    }
                    // The scheduled editor's kind-8 claimant (the due
                    // cell's twin, round 5 A2).
                    property <int> watch-restore-nonce: FocusFacts.nonce;
                    init => {
                        if (FocusFacts.anchor-kind == 8) {
                            scheduled-column.request-value-focus();
                        }
                    }
                    changed watch-restore-nonce => {
                        if (FocusFacts.anchor-kind == 8) {
                            scheduled-column.request-value-focus();
                        }
                    }
                }
                state-column := LabeledValueRow {
                    vertical-stretch: 0;
                    mode: RowMode.display;
                    label: "State";
                    value: root.task.done ? "Completed" : "Open";
                    value-color: root.task.done ? Semantic.success : Theme.text-primary;
                    value-fill: true;
                    placeholder-em-dash: false;
                }
            }

            // The priority rows (UX R-3 D-1, #788; round-9 chunk 15
            // D-4): the two echoes of the card decorations' own
            // labels (reconciliation by construction — the same
            // domain text forms), now each a closed `Dropdown` field
            // hosted in the `LabeledValueRow`'s content slot (the
            // effort-row hosting precedent): the echo is the field's
            // text, the retired pencil's intent is the field's own
            // click/Return (routed external — the adapter owns the
            // exclusivity/gates), and the flyout is the window-level
            // generic mount. The in-layout expanding picker block is
            // gone (D-11c: no layout shift — the overlay law's gain).
            HorizontalLayout {
                visible: !root.task.is-habit;
                spacing: Theme.space-3;
                LabeledValueRow {
                    vertical-stretch: 0;
                    mode: RowMode.editor;
                    label: "Importance";
                    value-role: Typography.mono;
                    importance-dd := Dropdown {
                        horizontal-stretch: 1;
                        consumer: DropdownConsumer.task-importance;
                        open-routes-external: true;
                        has-dismiss-seam: true;
                        rows: root.task.importance-rows;
                        selected-index: root.task.importance-selected-index;
                        // The em-dash placeholder (the LVR's unset-value
                        // convention, carried over from the retired echo).
                        field-text: root.task.importance-echo != ""
                            ? root.task.importance-echo
                            : "—";
                        field-label: "Importance";
                        field-description: "Opens the importance picker: six levels, commit on pick.";
                        external-open-requested() => root.importance-edit-asked();
                        dismiss-asked() => root.priority-dismiss-requested();
                        row-activated(index) => root.priority-slot-clicked(index);
                        // The importance picker's kind-9 restore claimant
                        // (round 5 A2, #1205): the picker's opener cell.
                        property <int> watch-restore-nonce: FocusFacts.nonce;
                        changed watch-restore-nonce => {
                            if (FocusFacts.anchor-kind == 9) {
                                importance-dd.grab-field();
                            }
                        }
                    }
                }
                LabeledValueRow {
                    vertical-stretch: 0;
                    mode: RowMode.editor;
                    label: "Urgency";
                    value-role: Typography.mono;
                    urgency-dd := Dropdown {
                        horizontal-stretch: 1;
                        consumer: DropdownConsumer.task-urgency;
                        open-routes-external: true;
                        has-dismiss-seam: true;
                        rows: root.task.urgency-rows;
                        selected-index: root.task.urgency-selected-index;
                        field-text: root.task.urgency-echo != ""
                            ? root.task.urgency-echo
                            : "—";
                        field-label: "Urgency";
                        field-description: "Opens the urgency picker: six levels, commit on pick.";
                        external-open-requested() => root.urgency-edit-asked();
                        dismiss-asked() => root.priority-dismiss-requested();
                        row-activated(index) => root.priority-slot-clicked(index);
                        // The urgency picker's kind-10 restore claimant.
                        property <int> watch-restore-nonce: FocusFacts.nonce;
                        changed watch-restore-nonce => {
                            if (FocusFacts.anchor-kind == 10) {
                                urgency-dd.grab-field();
                            }
                        }
                    }
                }
                // The adapter-driven open edge (the #794 request-mirror
                // idiom): the pushed flag's false->true invokes the
                // field's open arms; the false edge closes a still-open
                // field (the commit's model flip; the flyout's own
                // close paths land first, so this is the safety net).
                property <bool> imp-open-mirror: root.task.importance-open;
                changed imp-open-mirror => {
                    if (self.imp-open-mirror) {
                        importance-dd.open-requested();
                    } else if (importance-dd.open) {
                        importance-dd.close-settling();
                    }
                }
                property <bool> urg-open-mirror: root.task.urgency-open;
                changed urg-open-mirror => {
                    if (self.urg-open-mirror) {
                        urgency-dd.open-requested();
                    } else if (urgency-dd.open) {
                        urgency-dd.close-settling();
                    }
                }
            }

            // The effort row (the overlay migration, M9; US-3/S2's
            // always-on one-line row): the caption and the field on
            // one line — the widget's editor mode with the field at
            // the mount (Rule E: the commit-on-Return-and-focus-loss
            // semantics (R-9), the D-5 guard and the re-seed idiom
            // stay view-side verbatim). The caption's tooltip
            // affordance (J3 US-4, chunk 11) rides the widget's
            // caption knobs — the keyboard opener's + clear twin's
            // projection (one tooltip, both verbs).
            effort-row := LabeledValueRow {
                visible: !root.task.is-habit;
                vertical-stretch: 0;
                mode: RowMode.editor;
                caption-beside: true;
                content-gap: Theme.space-2;
                label: "Effort Estimate";
                caption-tooltip-text: "The effort estimate: bare digits are minutes, s/m/h components compose.";
                caption-hint-keys: root.task-effort-hint;
                effort-field := TextField {
                    horizontal-stretch: 1;
                    // Focusable: the keyboard opener's anchor (J3
                    // US-4, chunk 11) — the BeginEffortEdit fact
                    // writes the anchor-family kind 6; the watcher
                    // below focuses this field on it.
                    placeholder: "30 or 1h30m";
                    label: "Effort Estimate";
                    description: "The effort estimate: bare digits are minutes, s/m/h components compose.";
                    initial-text: root.task.effort-text;
                    edited(t) => root.effort-edited(t);
                    accepted(t) => root.effort-committed();
                    focus-lost() => root.effort-focus-lost();
                }
                // The focus-origin fact for the keyboard opener (J3
                // US-4, chunk 11): `BeginEffortEdit` writes the
                // anchor family's kind 6; the nonce watcher focuses
                // the always-on field (the title-stop's recorded
                // watch shape).
                property <int> effort-focus-nonce: FocusFacts.nonce;
                init => {
                    if (FocusFacts.anchor-kind == 6) { effort-field.grab-focus(); }
                }
                changed effort-focus-nonce => {
                    if (FocusFacts.anchor-kind == 6) { effort-field.grab-focus(); }
                }
                // The push re-seed (the DueEditor idiom): the
                // adapter's seed wins whenever it differs from the
                // field's own text — a subject switch or an external
                // effort change rewrites the field; the typed echo is
                // a no-op.
                property <string> effort-seed: root.task.effort-text;
                changed effort-seed => {
                    if (effort-field.text != root.task.effort-text) {
                        effort-field.text = root.task.effort-text;
                    }
                }
            }

            // The labels section (UX R-3 D-2, #789): the subject's
            // live labels as swatch chips with their unassign
            // affordances, plus the add affordance that opens the
            // labels overlay (click ≡ key — the affordance routes the
            // same `label.manage` action the keyboard binding does).
            if (root.task.labels-visible): HorizontalLayout {
                spacing: Theme.space-2;
                RoleText {
                    role: Typography.caption;
                    text-color: Theme.text-secondary;
                    text: "Labels";
                    vertical-alignment: center;
                }
                for chip[index] in root.task.labels: ActionChip {
                    // The label chip's identity (UX R-3 D-2, #789):
                    // the swatch echo, the surface posture, and the
                    // trailing remove affordance; the body carries no
                    // activation (passive posture), the index closes
                    // over in the delegate (R-2).
                    interactive: false;
                    tone: Tone.info;
                    chip-background: Theme.surface;
                    has-swatch: true;
                    swatch: chip.color;
                    removable: true;
                    remove-label: "Remove label " + chip.title;
                    remove-description: "Detaches this label from the task.";
                    removed => { root.chip-unassign-clicked(index); }
                }
                add-label-button := IconButton {
                    icon: IconKind.plus;
                    tone: Tone.neutral;
                    label: "Add label";
                    description: "Opens the labels overlay: assign, create, edit, delete.";
                    clicked => root.labels-manage-asked();
                    // The labels overlay's kind-11 restore claimant
                    // (round 5 A2, #1205): the overlay's opener.
                    property <int> watch-restore-nonce: FocusFacts.nonce;
                    changed watch-restore-nonce => {
                        if (FocusFacts.anchor-kind == 11) {
                            add-label-button.grab();
                        }
                    }
                }
            }

            // The add-repeat affordance (round-7 D-7.1): rule-less
            // open tasks only — the recur row owns the edit side. The
            // timer icon keeps the recur family's identity; the label
            // is the hover tip.
            if (!root.task.recur-visible && root.task.series-edit-visible): add-repeat-button := IconButton {
                icon: IconKind.timer;
                tone: Tone.neutral;
                label: "Add repeat: the task joins a recurring series";
                enabled: root.task.series-edit-enabled;
                clicked => root.series-edit-asked();
                // The recur editor's kind-12 restore claimant (round 5
                // A2, #1205): the rule-less open's opener button.
                property <int> watch-restore-nonce: FocusFacts.nonce;
                changed watch-restore-nonce => {
                    if (FocusFacts.anchor-kind == 12) {
                        add-repeat-button.grab();
                    }
                }
            }

            // The tracked-time summary row (r4 D17): the subject's
            // (hidden behind the habit variant's mount discriminator)
            // total at second precision, its own full-width row under
            // the facts. Refresh-static while no entry is open — the
            // per-second tick is the adapter's seam (decision 5). The
            // value carries a hover tip (blanket rule a); the row is
            // not itself clickable.
            // The tracked-time summary row (r4 D17): display mode with
            // the tooltip arm (the value is the tip's label — blanket
            // rule a) and the value's a11y data-presence; the row is
            // not itself clickable. Refresh-static while no entry is
            // open — the per-second tick is the adapter's seam.
            LabeledValueRow {
                visible: !root.task.is-habit;
                vertical-stretch: 0;
                mode: RowMode.display;
                caption-beside: true;
                content-gap: Theme.space-3;
                trailing-gap: Theme.space-3;
                label: "Tracked";
                value: root.task.tracked-total;
                value-role: Typography.mono;
                placeholder-em-dash: false;
                trailing-right: true;
                trailing-width: Theme.space-6;
                value-hint-label: root.task.tracked-total;
                value-hint-description: "Total tracked time on this task, including any running entry.";
                value-a11y-label: "Tracked time total";
                // The entries affordance (r4 chunk 10, D-TS8): a
                // history icon — deliberately NOT the snooze clock
                // (F1's shared-icon class). Model-side kiosk gate;
                // the anchor geometry mirrors into the panel's facts
                // singleton (the TimerSetterFacts idiom).
                if (root.task.track-entries-visible): entries-anchor := Rectangle {
                    entries-button := IconButton {
                        icon: IconKind.history;
                        label: "Time entries";
                        description: "Opens the task's time-entries overlay: tracked history, add, edit, delete.";
                        // The keyboard opener's projection (J3 US-4,
                        // chunk 11): the tooltip shows the real
                        // preset stroke (the D19 projection).
                        hint-keys: root.task-entries-hint;
                        clicked => {
                            TooltipState.unhover();
                            root.task-track-entries-clicked();
                        }
                        // The entries overlay's kind-13 restore claimant
                        // (round 5 A2, #1205): the overlay's opener.
                        property <int> watch-restore-nonce: FocusFacts.nonce;
                        changed watch-restore-nonce => {
                            if (FocusFacts.anchor-kind == 13) {
                                entries-button.grab();
                            }
                        }
                    }
                    // The keep-alive mirror (the #954 AnchorMirror
                    // idiom written once).
                    AnchorMirror {
                        source-x: entries-button.absolute-position.x;
                        source-y: entries-button.absolute-position.y;
                        source-width: entries-button.width;
                        source-height: entries-button.height;
                        published(x, y, w, h) => {
                            TrackPanelFacts.anchor-x = x;
                            TrackPanelFacts.anchor-y = y;
                            // No anchor-width fact: the panel's own
                            // width law never reads it (the roster
                            // singleton carries the three arms only).
                            TrackPanelFacts.anchor-height = h;
                        }
                    }
                }
            }

            // The rule list (chunk 6, D12): mounted inside the editor
            // after the metadata row — extends the editor surface, no
            // new view family (D-R4).
            RuleList {
                visible: !root.task.is-habit;
                rules: root.task.rules;
                presets: root.task.rule-presets;
                hint: root.task.rules-hint;
                muted: root.task.rules-muted;
                offset-help: "Adds a reminder the given time before the due date.";
                remove-clicked(i) => root.rule-remove-clicked(i);
                row-clicked(i) => root.rule-row-clicked(i);
                add-preset-clicked(i) => root.rule-add-preset-clicked(i);
                add-custom-accepted(text) => root.rule-add-custom-accepted(text);
                offset-validity: root.task.offset-validity;
                offset-error-hint: root.task.offset-error-hint;
                offset-edited(t) => root.rule-offset-edited(t);
                unmute-clicked() => root.rule-unmute-clicked();
                jump-to-due-clicked() => root.rule-jump-to-due-clicked();
            }

            // The recur row (issue #506, plan D-8): pattern echo +
            // paused chip + the pause/convert affordances — mounted
            // only for a recurring subject. Every control carries a
            // hover tip (label), joins the walk, and dispatches
            // through the action layer.
            if (root.task.recur-visible): VerticalLayout {
                spacing: Theme.space-1;
                HorizontalLayout {
                    spacing: Theme.space-2;
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: root.task.recur-pattern;
                        vertical-alignment: center;
                    }
                    if (root.task.recur-paused-chip != ""): ActionChip {
                        // The paused chip's passive posture: no
                        // affordance, the plain surface rect.
                        interactive: false;
                        tone: Tone.info;
                        chip-background: Theme.surface;
                        pad-right: Theme.space-2;
                        text: root.task.recur-paused-chip;
                    }
                    // The edit-repeat affordance (round-7 D-7.1):
                    // beside the pattern echo, the same action as the
                    // add row and the Ctrl+R binding (click ≡ key).
                    if (root.task.series-edit-visible): edit-repeat-button := IconButton {
                        icon: IconKind.timer;
                        tone: Tone.neutral;
                        label: "Edit repeat: change the pattern or bound";
                        enabled: root.task.series-edit-enabled;
                        clicked => root.series-edit-asked();
                        // The recurring subject's kind-12 claimant (the
                        // add-repeat twin, round 5 A2).
                        property <int> watch-restore-nonce: FocusFacts.nonce;
                        changed watch-restore-nonce => {
                            if (FocusFacts.anchor-kind == 12) {
                                edit-repeat-button.grab();
                            }
                        }
                    }
                }
                if (root.task.recur-pause-open): HorizontalLayout {
                    spacing: Theme.space-2;
                    pause-field := TippedField {
                        placeholder: "YYYY-MM-DD";
                        label: "Pause through date";
                        help: "The inclusive pause-through date; the covered members do not exist.";
                        vertical-stretch: 0;
                        accepted(text) => {
                            root.recur-pause-accepted(text);
                            pause-field.text = "";
                        }
                    }
                    IconButton {
                        icon: IconKind.check;
                        tone: Tone.success;
                        label: "Pause through the typed date";
                        clicked => {
                            root.recur-pause-accepted(pause-field.text);
                            pause-field.text = "";
                        }
                    }
                    IconButton {
                        icon: IconKind.remove;
                        tone: Tone.neutral;
                        label: "Cancel pause";
                        clicked => root.recur-pause-cancelled();
                    }
                }
                if (!root.task.recur-pause-open): HorizontalLayout {
                    spacing: Theme.space-2;
                    IconButton {
                        icon: IconKind.timer;
                        tone: Tone.neutral;
                        // Vacation pause (issue #506, D-C10): the
                        // covered members do not exist — no miss, no
                        // credit.
                        label: "Pause series through a date: the covered members do not exist";
                        enabled: root.task.series-edit-enabled;
                        clicked => root.recur-pause-asked();
                    }
                    IconButton {
                        icon: IconKind.play;
                        tone: Tone.neutral;
                        label: "Resume series: clears the pause";
                        enabled: root.task.series-edit-enabled;
                        clicked => root.recur-resume-clicked();
                    }
                    IconButton {
                        icon: IconKind.check;
                        tone: Tone.neutral;
                        label: "Convert to habit: the series stops repeating, the habit continues its history";
                        enabled: root.task.series-edit-enabled;
                        clicked => root.recur-convert-asked();
                    }
                }
                // The armed confirm strip (issue #506, plan D-8): the
                // consequence names the mapping before anything
                // dispatches.
                if (root.task.recur-confirm-open): ConfirmStrip {
                    destructive: false;
                    message: "Creates a habit on this board with a 1-per-period quota preset; the series stops repeating.";
                    confirm-label: "Confirm conversion";
                    cancel-label: "Cancel conversion";
                    confirmed => root.recur-convert-confirmed();
                    cancelled => root.recur-convert-cancelled();
                }
            }

            // The description (round-3 D15/#228, round-5 chunk 2):
            // the read-only body reads interactive (the closed
            // cells' grammar) and click-opens the MultiLineEditor —
            // commit on Shift+Return and on the checkmark; plain
            // Return inserts a newline; Escape's discard rides the
            // action layer; focus loss settles per the text-flow
            // rule. Markup rendering stays POST-1.0/R10.
            //
            // r4 D16d (F10): THE flexible element — the section (and
            // both branches inside it) absorbs the view's leftover
            // height; the old trailing spacer is gone. Every other
            // row stays content-height. No max-line cap: growth is
            // the layout stretch, not the content (the editor's
            // viewport rides its Flickable — the r3 cycle trap stays
            // fenced by the widget's own geometry contract).
            description-section := VerticalLayout {
                visible: !root.task.is-habit;
                vertical-stretch: 1;
                // The display branch: the widget's cell mode hosting
                // the read-only MultiLineEditor (the wrap/height law
                // the built-in value cannot carry — `value-hosted`).
                // The stop identity (11), the ring's armed/walk latch,
                // the restore law (kind 5) and the tooltip arm are the
                // widget's; the em-dash rides the editor's placeholder
                // slot (the empty-display convention, unchanged).
                if (!root.task.description-edit-open): description-display := LabeledValueRow {
                    vertical-stretch: 1;
                    mode: RowMode.cell;
                    value-hosted: true;
                    label: "Description";
                    hover-surface: Theme.surface-raised;
                    ring-latched: TaskViewWalkFacts.stop-id == 11
                        || root.task.description-armed;
                    stop-label: "Edit description";
                    stop-description: "Opens the description editor.";
                    stop-id: 11;
                    edit-asked() => { root.description-edit-opened(); }
                    // The focus-origin restore's description twin
                    // (US-1/W-1, kind 5): same grammar as the title
                    // cell.
                    property <int> watch-restore-nonce: FocusFacts.nonce;
                    init => {
                        if (FocusFacts.anchor-kind == 5) {
                            description-display.request-value-focus();
                        }
                    }
                    changed watch-restore-nonce => {
                        if (FocusFacts.anchor-kind == 5) {
                            description-display.request-value-focus();
                        }
                    }
                    MultiLineEditor {
                        editing: false;
                        text: root.task.description;
                        placeholder: "—";
                        label: "Description";
                        autofocus: false;
                        width: 100%;
                        height: 100%;
                    }
                }
                // The edit mount (D-MLE-8): the widget's editor mode —
                // the pair stays at the mount (Rule E). The M8 stretch
                // fix: the editor absorbs the section's leftover
                // height (the display mount's geometry law — the edit
                // mount keeps its size).
                if (root.task.description-edit-open): LabeledValueRow {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    mode: RowMode.editor;
                    label: "Description";
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        MultiLineEditor {
                            editing: true;
                            height: 100%;
                            label: "Description";
                            placeholder: "Describe the task";
                            commit-affordance: true;
                            initial-text: root.task.description-initial;
                            horizontal-stretch: 1;
                            accepted(text) => root.description-committed(text);
                            edited(text) => root.description-edited(text);
                            focus-lost() => root.text-flow-focus-lost();
                        }
                        description-help-tip := InfoTip {
                            about: "Description";
                            help: "The task's longer body text; rendered as plain text.";
                        }
                    }
                }
            }
        }
    }
}
