// SPDX-License-Identifier: AGPL-3.0-only
// The task-detail view (L3, D14/D22): the title-editing surface plus
// read-only metadata display. The scope focuses itself on mount; the
// title field mounts when the edit flow opens and focuses/selects
// itself (D14). Escape's discard rides the action layer (D5) — no key
// handlers here.

import { Theme, Typography, Semantic, RoleText, Tone, DueKind } from "../theme.slint";
import { TextField } from "../widgets/text-field.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
import { RuleList, RuleRowModel } from "../compositions/rule-list.slint";
import { DueEditor } from "../compositions/due-editor.slint";
import { DueDayModel } from "../compositions/date-picker.slint";
import { DatePickerFacts } from "../menu-facts.slint";
import { TooltipState } from "../widgets/tooltip.slint";
import { EditingFacts } from "../editing-facts.slint";
import { TaskViewWalkFacts } from "../walk-facts.slint";

// The task view's closed-cell activation stop (r4 D18): the done-box
// grammar verbatim — a full-size FocusScope tab stop with the cell's
// a11y triple, bare Return/Space activating the same seam the cell's
// TouchArea clicks, and the ring visual the parent cell's border
// renders from `has-focus`. The focus gains publish into
// EditingFacts' activation count (the §2 reservation arm's input)
// with the same latch/generation discipline as the text-field
// publish, and stamp the walk-stop fact (the plan §6.A probe).
component ActivationStop inherits FocusScope {
    in property <string> stop-label;
    in property <string> stop-description;
    in property <int> stop-id;
    callback activated();
    focus-on-tab-navigation: true;
    accessible-role: AccessibleRole.button;
    accessible-label: root.stop-label;
    accessible-description: root.stop-description;
    accessible-action-default => { root.activated(); }
    key-pressed(event) => {
        if ((event.text == Key.Return || event.text == " ")
            && !event.modifiers.control
            && !event.modifiers.alt
            && !event.modifiers.shift
            && !event.modifiers.meta) {
            root.activated();
            accept
        } else {
            reject
        }
    }
    // The derived-property wrap is the walk probe's recorded idiom
    // (P2): `changed` delivers on the wrapper, not on the built-in
    // has-focus binding directly.
    property <bool> focused: self.has-focus;
    property <bool> activation-counted: false;
    property <int> counted-generation: -1;
    changed focused => {
        if (self.focused) {
            TaskViewWalkFacts.stop-id = root.stop-id;
        }
        if (self.counted-generation != EditingFacts.generation) {
            // A reset seam re-baselined the counts: re-sync, never a
            // stale decrement into them.
            self.counted-generation = EditingFacts.generation;
            self.activation-counted = self.focused;
            if (self.focused) {
                EditingFacts.activation-focus-count += 1;
            }
        } else if (self.focused != self.activation-counted) {
            EditingFacts.activation-focus-count += self.focused ? 1 : -1;
            self.activation-counted = self.focused;
        }
    }
}

// The task-detail model (D22).
export struct TaskDetailModel {
    title: string,
    stack-title: string,
    due-phrase: string,
    due-kind: DueKind,
    scheduled-phrase: string,
    // The subject's tracked-time total at second precision (r4 D17):
    // the pushed phrase — the box renders the model only, the tick
    // cadence is the adapter's seam.
    tracked-total: string,
    done: bool,
    // The tracking verbs (DR-5/4, D-TU6): exactly one true while a
    // subject exists, both false without — the buttons at the header
    // row's right end (r4 D16c).
    can-track-start: bool,
    can-track-stop: bool,
    description: string,
    edit-open: bool,
    initial-text: string,
    // The subject task's reminder rules (chunk 6, D12): display rows
    // plus the derived-fact hint; ids stay in the adapter's tables.
    rules: [RuleRowModel],
    rule-presets: [string],
    rules-hint: string,
    // The date editors (r2 D25, round-3 D8): due and scheduled, one
    // open at a time (the flow's exclusivity) over the shared
    // picker state — the adapter owns it all across refreshes
    // (R-d), this model only carries.
    due-open: bool,
    due-text: string,
    due-echo: string,
    scheduled-open: bool,
    scheduled-text: string,
    scheduled-echo: string,
    description-edit-open: bool,
    description-initial: string,
    date-picker-open: bool,
    date-caption: string,
    date-grid: [[DueDayModel]],
    date-grid-focus: bool,
    date-time-text: string,
}

export component TaskView inherits FocusScope {
    in property <TaskDetailModel> task;
    // The nav.focus-board binding as display strings (round-1 D12; a
    // keymap projection pushed per refresh — never hand-written).
    in property <[string]> nav-back-hint;
    callback title-committed(string);
    callback title-edited(string);
    // The focus-loss settle (round-3 L1): the title flow's field
    // commits non-empty / discards empty on a focus steal.
    callback text-flow-focus-lost();
    // The closed title's click (round-3 W-SM-d, F26): routes the
    // `task.title-edit` action — click ≡ key (§7.1).
    callback title-edit-opened();
    callback back-clicked();
    // The tracking verbs (DR-5/4, D-T16): route the matching action
    // over the focused task (the subject IS the focused task).
    callback task-track-start-clicked();
    callback task-track-stop-clicked();
    // The done checkbox (r4 D16b): raw-sends the toggled SetTaskDone
    // over the VIEW'S SUBJECT — the adapter seam resolves it (the
    // subject is not guaranteed focused; the cycle's fallback).
    callback task-done-toggled();
    // The header row's hint projections (r4 D16b/D16c): keymap
    // projections pushed per refresh — never hand-written.
    in property <[string]> task-done-hint;
    in property <[string]> task-track-hint;
    // The rule-list composition's seams (chunk 6, D12): forwarded to
    // the window, resolved against the id tables there.
    callback rule-remove-clicked(int);
    callback rule-add-preset-clicked(int);
    callback rule-add-custom-accepted(string) -> bool;
    // The date editors' seams (r2 D25, round-3 D8), forwarded to the
    // window: one open seam per field, one shared interaction set.
    callback due-edit-opened();
    callback scheduled-edit-opened();
    // The description editor's seams (round-3 D15), forwarded to the
    // window; focus loss rides the shared text-flow settle.
    callback description-edit-opened();
    callback description-edited(string);
    callback description-committed(string);
    callback date-edited(string);
    callback date-accepted(string);
    callback date-picker-toggled();
    // The picker's key/day seams live on the window-level overlay
    // (round-3 D10) — bound there directly, not forwarded here.

    // The overlay's anchor (round-3 D10): the armed field's metadata
    // column, window-space — read from the *unconditional* column
    // elements (a conditional element's id is not reachable across
    // scopes; the columns are) and mirrored into the window-level
    // facts global the overlay reads (the MenuPanelFacts precedent;
    // values are stale while the view is unmounted, and the
    // overlay's mount condition is the model's date-picker-open).
    out property <bool> date-picker-visible: root.task.date-picker-open;
    private property <length> date-anchor-x: root.task.due-open
        ? due-column.absolute-position.x
        : scheduled-column.absolute-position.x;
    private property <length> date-anchor-y: root.task.due-open
        ? due-column.absolute-position.y
        : scheduled-column.absolute-position.y;
    private property <length> date-anchor-width: root.task.due-open
        ? due-column.width
        : scheduled-column.width;
    private property <length> date-anchor-height: root.task.due-open
        ? due-column.height - due-caption.preferred-height
        : scheduled-column.height - scheduled-caption.preferred-height;
    // The mirrors (changed handlers — the row-selection mirror
    // precedent; they fire when the layout resolves the positions
    // after mount).
    changed date-anchor-x => { DatePickerFacts.anchor-x = root.date-anchor-x; }
    changed date-anchor-y => { DatePickerFacts.anchor-y = root.date-anchor-y; }
    changed date-anchor-width => { DatePickerFacts.anchor-width = root.date-anchor-width; }
    changed date-anchor-height => { DatePickerFacts.anchor-height = root.date-anchor-height; }

    focus-on-tab-navigation: true;
    accessible-role: AccessibleRole.region;
    accessible-label: "Task: \{root.task.title}";
    init => self.focus();

    pure function scheduled-color() -> color {
        // The scheduled start carries no overdue semantics: one
        // neutral tone (the tint language is the due field's).
        Theme.text-secondary
    }

    pure function due-color() -> color {
        root.task.due-kind == DueKind.overdue ? Semantic.overdue
        : root.task.due-kind == DueKind.soon ? Semantic.warning
        : root.task.due-kind == DueKind.done ? Semantic.success
        : Theme.text-secondary
    }

    // The D15 ring: rendered whenever the scope holds focus (the
    // title field's own ring supersedes it while editing).
    ring := Rectangle {
        width: 100%;
        height: 100%;
        border-width: root.has-focus ? Theme.focus-ring-width : 0;
        border-color: Semantic.focus-ring;
        border-radius: Theme.radius-medium;

        VerticalLayout {
            spacing: Theme.space-3;

            // The header row (r4 D16a): one content-height row — back
            // inline with the title (F9), the done checkbox left of
            // it (F15/D16b), tracking at the right end (F11/D16c). No
            // stretch anywhere: the phantom rows of the old back-row +
            // trailing-spacer shape are gone by construction (the
            // description is THE flexible element, D16d).
            HorizontalLayout {
                spacing: Theme.space-3;
                IconButton {
                    icon: IconKind.chevron-left;
                    label: "Back to board";
                    description: "Returns to the board view.";
                    hint-keys: root.nav-back-hint;
                    clicked => root.back-clicked();
                }
                // The done checkbox (r4 D16b, F15): the card
                // checkbox's state-less anatomy — it renders the
                // model's done flag only, no local checked state
                // anywhere, so it cannot desync (the refresh push is
                // the single writer) — with the view's closed-cell
                // grammar: the FocusScope overlay makes it a real tab
                // stop with Return/Space activation, the hover surface
                // and the tooltip arm ride the TouchArea. It stays
                // mounted while the title flow is open: doneness is
                // independent of the title buffer.
                done-box := Rectangle {
                    width: Theme.space-4;
                    height: Theme.space-4;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-small;
                    border-width: Theme.focus-ring-width;
                    border-color: done-focus.has-focus
                        ? Semantic.focus-ring
                        : root.task.done ? Semantic.success : Theme.text-secondary;
                    // The hover surface first (z-under the box fill):
                    // the closed cells' hover grammar.
                    if (done-touch.has-hover): Rectangle {
                        background: Theme.surface-hover;
                        border-radius: Theme.radius-small;
                    }
                    done-focus := FocusScope {
                        width: 100%;
                        height: 100%;
                        focus-on-tab-navigation: true;
                        // The activation publish (r4 §2): the done-box
                        // joins the reservation so its Space path is
                        // uniform under vi (the walk-stop fact rides;
                        // the derived-property wrap is the walk
                        // probe's recorded idiom).
                        property <bool> focused: self.has-focus;
                        property <bool> activation-counted: false;
                        property <int> counted-generation: -1;
                        changed focused => {
                            if (self.focused) {
                                TaskViewWalkFacts.stop-id = 2;
                            }
                            if (self.counted-generation != EditingFacts.generation) {
                                self.counted-generation = EditingFacts.generation;
                                self.activation-counted = self.focused;
                                if (self.focused) {
                                    EditingFacts.activation-focus-count += 1;
                                }
                            } else if (self.focused != self.activation-counted) {
                                EditingFacts.activation-focus-count += self.focused ? 1 : -1;
                                self.activation-counted = self.focused;
                            }
                        }
                        accessible-role: AccessibleRole.checkbox;
                        // The done/undone verb pair (the card's
                        // presentation literals, reused verbatim so
                        // the a11y tree and click_by_label agree
                        // across surfaces).
                        accessible-label: root.task.done ? "Mark task not done" : "Mark task done";
                        accessible-action-default => { root.task-done-toggled(); }
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == " ") {
                                root.task-done-toggled();
                                accept
                            } else {
                                reject
                            }
                        }
                    }
                    if (root.task.done): Path {
                        width: Theme.space-4 - 2 * Theme.space-1;
                        height: Theme.space-4 - 2 * Theme.space-1;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        commands: "M 2 6 L 5 9 L 10 3";
                        stroke: Semantic.success;
                        stroke-width: Theme.focus-ring-width;
                        fill: transparent;
                        viewbox-width: 12;
                        viewbox-height: 12;
                    }
                    done-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        // The tooltip arm (blanket rule a): the same
                        // verb pair the a11y layer reads.
                        changed has-hover => {
                            if (self.has-hover) {
                                TooltipState.hover(
                                    root.task.done ? "Mark task not done" : "Mark task done",
                                    "Toggles the task's done state.",
                                    root.task-done-hint,
                                    self.absolute-position.x,
                                    self.absolute-position.y,
                                    self.width,
                                    self.height,
                                );
                            } else {
                                TooltipState.unhover();
                            }
                        }
                        clicked => {
                            TooltipState.unhover();
                            root.task-done-toggled();
                        }
                    }
                }
                // The title cell (r4 D16a): the display/field pair
                // mounts in one cell, the field stretches to the row's
                // leftover width (the display's own horizontal-stretch,
                // shared). The checkbox and tracking button stay
                // mounted around it while editing.
                if (root.task.edit-open): title-field := TextField {
                    placeholder: "Task title";
                    label: "Task title";
                    commit-affordance: true;
                    initial-text: root.task.initial-text;
                    selected-on-focus: true;
                    horizontal-stretch: 1;
                    accepted(text) => root.title-committed(text);
                    edited(text) => root.title-edited(text);
                    focus-lost() => root.text-flow-focus-lost();
                }
                if (!root.task.edit-open): title-display := Rectangle {
                    border-radius: Theme.radius-small;
                    horizontal-stretch: 1;
                    // The D18 ring: the focused closed cell visibly
                    // indicates the active element (the ring width 0
                    // keeps the hover surface the rest-state
                    // differentiator).
                    border-width: title-stop.has-focus ? Theme.focus-ring-width : 0;
                    border-color: Semantic.focus-ring;
                    // The activation stop first (z-under the text):
                    // the closed-cell grammar's walk stop; the a11y
                    // triple rides the scope (the click ≡ key seam).
                    title-stop := ActivationStop {
                        width: 100%;
                        height: 100%;
                        stop-label: "Edit title";
                        stop-description: "Arms the title editor for the viewed task.";
                        stop-id: 3;
                        activated => { root.title-edit-opened(); }
                    }
                    // The hover surface (z-over the stop, z-under the
                    // text): the due-cell grammar's hover affordance.
                    if (title-touch.has-hover): Rectangle {
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-small;
                    }
                    RoleText {
                        role: Typography.title;
                        text: root.task.title;
                        overflow: elide;
                        width: parent.width - 2 * Theme.space-2;
                        x: Theme.space-2;
                    }
                    title-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.title-edit-opened(); }
                    }
                }
                // The tracking verbs (r4 D16c, F11): moved here from
                // the metadata row's State column — exactly one verb
                // while a subject exists, at the header row's right
                // end. The card badge stays fenced (#489); the summary
                // row below carries D17's total.
                if (root.task.can-track-start): IconButton {
                    icon: IconKind.play;
                    tone: Tone.info;
                    label: "Start tracking";
                    description: "Starts the timer for this task.";
                    hint-keys: root.task-track-hint;
                    clicked => root.task-track-start-clicked();
                }
                if (root.task.can-track-stop): IconButton {
                    icon: IconKind.stop;
                    tone: Tone.info;
                    label: "Stop tracking";
                    description: "Stops the timer running on this task.";
                    hint-keys: root.task-track-hint;
                    clicked => root.task-track-stop-clicked();
                }
            }

            // The metadata row (tertiary per D17's demotion table).
            HorizontalLayout {
                spacing: Theme.space-3;
                VerticalLayout {
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "Stack";
                    }
                    RoleText {
                        role: Typography.body;
                        text: root.task.stack-title;
                    }
                }
                due-column := VerticalLayout {
                    // The due-date region (D16). Editing is r2 D25
                    // (W2 closed; #227): the collapsed cell is the
                    // display RoleText, clickable into the DueEditor
                    // — typed entry and the calendar picker, one
                    // commit seam.
                    due-caption := RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "Due date";
                    }
                    // The closed cell reads interactive (round-3
                    // D7/F13): hover surface + pointer, the title
                    // cell's grammar.
                    if (!root.task.due-open): due-cell := Rectangle {
                        border-radius: Theme.radius-small;
                        border-width: due-stop.has-focus ? Theme.focus-ring-width : 0;
                        border-color: Semantic.focus-ring;
                        due-stop := ActivationStop {
                            width: 100%;
                            height: 100%;
                            stop-label: "Edit due date";
                            stop-description: "Opens the due-date editor.";
                            stop-id: 5;
                            activated => { root.due-edit-opened(); }
                        }
                        if (due-touch.has-hover): Rectangle {
                            background: Theme.surface-hover;
                            border-radius: Theme.radius-small;
                        }
                        due-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.due-edit-opened(); }
                        }
                        RoleText {
                            role: Typography.mono;
                            text-color: root.due-color();
                            text: root.task.due-phrase == "" ? "—" : root.task.due-phrase;
                        }
                    }
                    if (root.task.due-open): DueEditor {
                        initial-text: root.task.due-text;
                        echo: root.task.due-echo;
                        clear-affordance: true;
                        edited(text) => root.date-edited(text);
                        accepted(text) => root.date-accepted(text);
                        picker-toggled() => root.date-picker-toggled();
                    }
                }
                // The start-date column (round-3 D8/F14): the due
                // column's grammar, one look — same closed cell, the
                // same editor composition.
                scheduled-column := VerticalLayout {
                    scheduled-caption := RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "Start date";
                    }
                    if (!root.task.scheduled-open): scheduled-cell := Rectangle {
                        border-radius: Theme.radius-small;
                        border-width: scheduled-stop.has-focus ? Theme.focus-ring-width : 0;
                        border-color: Semantic.focus-ring;
                        scheduled-stop := ActivationStop {
                            width: 100%;
                            height: 100%;
                            stop-label: "Edit start date";
                            stop-description: "Opens the start-date editor.";
                            stop-id: 6;
                            activated => { root.scheduled-edit-opened(); }
                        }
                        if (scheduled-touch.has-hover): Rectangle {
                            background: Theme.surface-hover;
                            border-radius: Theme.radius-small;
                        }
                        scheduled-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.scheduled-edit-opened(); }
                        }
                        RoleText {
                            role: Typography.mono;
                            text-color: root.scheduled-color();
                            text: root.task.scheduled-phrase == "" ? "—" : root.task.scheduled-phrase;
                        }
                    }
                    if (root.task.scheduled-open): DueEditor {
                        field-label: "Start date entry";
                        entry-placeholder: "YYYY-MM-DD or +2d";
                        initial-text: root.task.scheduled-text;
                        echo: root.task.scheduled-echo;
                        clear-affordance: true;
                        edited(text) => root.date-edited(text);
                        accepted(text) => root.date-accepted(text);
                        picker-toggled() => root.date-picker-toggled();
                    }
                }
                VerticalLayout {
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "State";
                    }
                    RoleText {
                        role: Typography.body;
                        text-color: root.task.done ? Semantic.success : Theme.text-primary;
                        text: root.task.done ? "Completed" : "Open";
                    }
                }
            }

            // The tracked-time summary row (r4 D17): the subject's
            // total at second precision, its own full-width row under
            // the facts. Refresh-static while no entry is open — the
            // per-second tick is the adapter's seam (decision 5). The
            // value carries a hover tip (blanket rule a); the row is
            // not itself clickable.
            HorizontalLayout {
                spacing: Theme.space-3;
                RoleText {
                    role: Typography.caption;
                    text-color: Theme.text-secondary;
                    text: "Tracked";
                }
                Rectangle {
                    horizontal-stretch: 1;
                    // The a11y presence (the value is data, not a
                    // control): the addressable label the screen
                    // reader and the element lookup read.
                    accessible-role: AccessibleRole.text;
                    accessible-label: "Tracked time total";
                    RoleText {
                        role: Typography.mono;
                        text: root.task.tracked-total;
                    }
                    total-touch := TouchArea {
                        changed has-hover => {
                            if (self.has-hover) {
                                TooltipState.hover(
                                    root.task.tracked-total,
                                    "Total tracked time on this task, including any running entry.",
                                    [],
                                    self.absolute-position.x,
                                    self.absolute-position.y,
                                    self.width,
                                    self.height,
                                );
                            } else {
                                TooltipState.unhover();
                            }
                        }
                    }
                }
            }

            // The rule list (chunk 6, D12): mounted inside the editor
            // after the metadata row — extends the editor surface, no
            // new view family (D-R4).
            RuleList {
                rules: root.task.rules;
                presets: root.task.rule-presets;
                hint: root.task.rules-hint;
                remove-clicked(i) => root.rule-remove-clicked(i);
                add-preset-clicked(i) => root.rule-add-preset-clicked(i);
                add-custom-accepted(text) => root.rule-add-custom-accepted(text);
            }

            // The description (round-3 D15/#228): the read-only body
            // reads interactive (the closed cells' grammar) and
            // click-opens the multiline editor — commit on Return and
            // on the checkmark; Escape's discard rides the action
            // layer; focus loss settles per the text-flow rule.
            // Markup rendering stays POST-1.0/R10.
            //
            // r4 D16d (F10): THE flexible element — the section (and
            // both branches inside it) absorbs the view's leftover
            // height; the old trailing spacer is gone. Every other
            // row stays content-height. No max-line cap: growth is
            // the layout stretch, not the content (the
            // input.preferred-height binding stays fenced — the
            // width-dependent cycle trap).
            VerticalLayout {
                vertical-stretch: 1;
                RoleText {
                    role: Typography.caption;
                    text-color: Theme.text-secondary;
                    text: "Description";
                }
                if (!root.task.description-edit-open): description-display := Rectangle {
                    border-radius: Theme.radius-small;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    border-width: description-stop.has-focus ? Theme.focus-ring-width : 0;
                    border-color: Semantic.focus-ring;
                    description-stop := ActivationStop {
                        width: 100%;
                        height: 100%;
                        stop-label: "Edit description";
                        stop-description: "Opens the description editor.";
                        stop-id: 11;
                        activated => { root.description-edit-opened(); }
                    }
                    if (description-touch.has-hover): Rectangle {
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-small;
                    }
                    RoleText {
                        role: Typography.body;
                        text: root.task.description == "" ? "—" : root.task.description;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                    description-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.description-edit-opened(); }
                    }
                }
                if (root.task.description-edit-open): TextField {
                    label: "Description";
                    placeholder: "Describe the task";
                    multiline: true;
                    commit-affordance: true;
                    initial-text: root.task.description-initial;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    accepted(text) => root.description-committed(text);
                    edited(text) => root.description-edited(text);
                    focus-lost() => root.text-flow-focus-lost();
                }
            }
        }
    }
}
