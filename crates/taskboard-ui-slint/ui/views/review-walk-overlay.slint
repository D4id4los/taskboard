// SPDX-License-Identifier: AGPL-3.0-only
// The review walk overlay (DR-7 chunk 3, #638; J4 D-5 remount): the
// ModalDialogHost's BODY — the progress strip (the guided journey's
// stage headers with their empty b-lines), the current stage's rows,
// the cursor row's verb strip, and the equal-prominence commit exits.
// The host owns the scrim, the absorbing panel root, the sizing law,
// and the walk-mask arming; the dialog button row (Next/Prev/Finish/
// the completion exit) rides the host's button model. Presentation
// only (the dumb client): the header, the strip, the row titles, the
// emphasis, and every button label arrive derived from the Rust pass;
// the tree computes nothing. The File-to picker and the date field
// render only while armed (the pushed booleans); the prompts stage
// renders one multi-line editor per prompt (the seeds ride the mount
// transition — a re-push never clobbers typing). The Planner stage
// (3) embeds the PlanNextDayView mount (J4 US-3: the planner is a
// step in the same dialog — #716's integration); Escape is the action
// layer's (the walk context binds it), never a widget handler.

import { Theme, Typography, RoleText } from "../theme.slint";
import { TextButton, TextButtonSize, TextButtonEmphasis } from "../widgets/text-button.slint";
import { MultiLineEditor } from "../widgets/multi-line-editor.slint";
import { TextField } from "../widgets/text-field.slint";
import { ListView } from "../widgets/listview.slint";
import { DialogButtonModel } from "../widgets/modal-dialog-host.slint";
import { PlanNextDayView, PlanModel } from "plan-next-day-view.slint";

export struct WalkStageStripRow {
    // The stage header (C5/C7/C10).
    label: string,
    // The skipped stage's b-line (C5b/C7b); empty = nothing renders.
    note: string,
}

export struct WalkRowModel {
    // The row's title (the task's title, or the prompt's text).
    title: string,
    // The cursor ring (`index == the pushed cursor`).
    emphasis: bool,
}

export struct ReviewWalkModel {
    // The overlay's visibility mirrors the `Flow::ReviewWalk` flow.
    open: bool,
    // The walk header (C4).
    header: string,
    // The progress strip: the guided journey's stages, in walk order.
    strip: [WalkStageStripRow],
    // The current stage's rows.
    rows: [WalkRowModel],
    // The stage discriminator: 0 inbox, 1 carry forward, 2 prompts,
    // 3 planner (embedded), 4 entry, 5 completion summary.
    stage-kind: int,
    // The stage position phrase ("Step 2 of 5"; D-9).
    stage-position: string,
    // The Entry stage's intro sentence (D-1).
    stage-intro: string,
    // The completion summary's tally (D-8).
    tally-filed: int,
    tally-moved: int,
    tally-left: int,
    tally-recorded: bool,
    // The abort confirm's arm (D-6): the nested confirm host mounts
    // while set.
    abort-confirm: bool,
    // The dialog button row's model and its parallel intent codes
    // (D-5): code i dispatches the walk intent the site maps i to.
    buttons: [DialogButtonModel],
    button-codes: [int],
    // The button row's authoritative initial-focus index (#996):
    // derived in Rust from the same buttons vec (the first enabled
    // autofocus row, -1 when none) — the host site binds it, never a
    // hand-declared index (Slint functions have no model reduce).
    initial-focus-index: int,
    // -- the inbox stage --
    // `true` = the File-to picker is armed on the cursor row.
    filing: bool,
    // The candidate stacks' titles, in offer order.
    candidates: [string],
    candidate-index: int,
    file-label: string,
    keep-label: string,
    // -- the carry stage --
    // `true` = the Pick-a-date field is armed on the cursor row.
    picking: bool,
    date-text: string,
    tomorrow-label: string,
    pick-label: string,
    leave-label: string,
    // The embedded planner choice (J4 US-3/S1).
    plan-label: string,
    // -- the prompts stage --
    record-label: string,
    finish-label: string,
}

component StripRow inherits VerticalLayout {
    in property <string> label;
    in property <string> note;
    VerticalLayout {
        vertical-stretch: 0;
        spacing: Theme.space-1;
        RoleText {
            vertical-stretch: 0;
            role: Typography.caption;
            text: root.label;
        }
        RoleText {
            vertical-stretch: 0;
            role: Typography.caption;
            text-color: Theme.text-secondary;
            text: root.note;
            visible: root.note != "";
        }
    }
}

// The walk's verb row (W3, #950): the compact TextButton variant — the
// primitive absorbed the wrapper (#1350); the sites mount TextButton
// (compact) directly.
export component ReviewWalkOverlay inherits Rectangle {
    in property <ReviewWalkModel> model;
    // The prompts' one-shot answer seeds (the mount-transition push).
    in property <[string]> answer-seeds;
    // The embedded planner's mirrors (J4 US-3: the same plan model
    // and text buffers the standalone surface reads; D-2).
    in property <PlanModel> plan;
    in property <string> plan-time-text;
    in property <string> plan-effort-text;
    callback plan-box-activated(int);
    callback plan-pool-activated(int);
    callback plan-box-earlier(int);
    callback plan-box-later(int);
    callback plan-box-remove(int);
    callback plan-time-edited(string);
    callback plan-effort-edited(string);
    callback plan-place-commit();
    callback plan-place-cancel();
    callback file-clicked();
    callback keep-clicked();
    callback file-prev-clicked();
    callback file-next-clicked();
    callback candidate_activated(int);
    callback file-commit-clicked();
    callback tomorrow-clicked();
    callback pick-clicked();
    callback leave-clicked();
    callback plan-clicked();
    callback date-edited(string);
    callback date-commit-clicked();
    callback answer-edited(int, string);
    callback record-clicked();
    callback finish-clicked();

    // slint: property — the embedded planner's focus seam (#1036
    // probe): true only while the stage-3 planner root holds focus.
    // The planner never grabs focus at mount (the D-7 binding below);
    // the walk's initial focus stays on the host's derived button row.
    out property <bool> planner-has-focus: false;

    // No chrome of its own: the host panel is the surface (D-5).
    VerticalLayout {
        padding: Theme.space-2;
        spacing: Theme.space-2;

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-3;
            RoleText {
                vertical-stretch: 0;
                role: Typography.display;
                text: root.model.header;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            RoleText {
                vertical-stretch: 0;
                role: Typography.caption;
                text-color: Theme.text-secondary;
                text: root.model.stage-position;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-3;
            for stage[index] in root.model.strip: StripRow {
                vertical-stretch: 0;
                label: stage.label;
                note: stage.note;
            }
        }

        // The rows: content-sized, capped above the page bound (the
        // today sections' viewport discipline; D-5 kills the stretch).
        rows-clip := Rectangle {
            clip: true;
            max-height: Theme.space-6 * 10;
            vertical-stretch: 0;
            rows := ListView {
                height: 100%;
                for row[index] in root.model.rows: VerticalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.space-1;
                    RoleText {
                        vertical-stretch: 0;
                        role: root.model.stage-kind == 4 || root.model.stage-kind == 5
                            ? Typography.caption : Typography.body;
                        text: row.title;
                        overflow: elide;
                        text-color: row.emphasis || root.model.stage-kind >= 4
                            ? Theme.text-primary : Theme.text-secondary;
                    }
                    // The prompts stage: one editor per prompt row (the
                    // seed is one-shot; edits mirror adapter-side).
                    if (root.model.stage-kind == 2): MultiLineEditor {
                        vertical-stretch: 0;
                        // The prompts' edit mount: a fixed three-line
                        // box (the task-view's edit mount fills a
                        // layout; here the rows live in a ListView —
                        // a content-derived height would bind a loop,
                        // the widget doc's whole geometry design).
                        height: Theme.space-6 * 3;
                        editing: true;
                        text: root.answer-seeds[index];
                        initial-text: root.answer-seeds[index];
                        label: row.title;
                        edited(text) => root.answer-edited(index, text);
                    }
                }
            }
        }

        // The embedded planner step (J4 US-3, D-2): the same view the
        // standalone surface mounts, clipped and height-bounded inside
        // the dialog (the severing token keeps the window max honest).
        if (root.model.stage-kind == 3): Rectangle {
            clip: true;
            max-height: Theme.space-6 * 14;
            vertical-stretch: 0;
            PlanNextDayView {
                width: 100%;
                height: 100%;
                // D-7: the walk owns the initial focus — the embedded
                // planner never grabs it at mount (#1036); the user's
                // Tab walks into the planner body deliberately.
                take-focus-on-init: false;
                changed has-focus => {
                    root.planner-has-focus = self.has-focus;
                }
                plan: root.plan;
                time-text: root.plan-time-text;
                effort-text: root.plan-effort-text;
                box-activated(i) => root.plan-box-activated(i);
                pool-activated(i) => root.plan-pool-activated(i);
                box-earlier(i) => root.plan-box-earlier(i);
                box-later(i) => root.plan-box-later(i);
                box-remove(i) => root.plan-box-remove(i);
                time-edited(t) => root.plan-time-edited(t);
                effort-edited(t) => root.plan-effort-edited(t);
                place-commit() => root.plan-place-commit();
                place-cancel() => root.plan-place-cancel();
            }
        }

        // -- the cursor row's verb strips (one per stage kind) --
        if (root.model.stage-kind == 0 && !root.model.filing): HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-2;
            TextButton {
                size: TextButtonSize.compact;
                vertical-stretch: 0;
                label: root.model.file-label;
                clicked => root.file-clicked();
            }
            TextButton {
                size: TextButtonSize.compact;
                vertical-stretch: 0;
                label: root.model.keep-label;
                clicked => root.keep-clicked();
            }
        }
        // The armed File-to picker: the candidate list + the commit.
        if (root.model.stage-kind == 0 && root.model.filing): VerticalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-1;
            // US-13 (#1030): the candidates are accessible buttons —
            // the W3 TextButton primitive carries the role, the tab
            // stop and the Return/Space activation, so click ≡ key on
            // the same `candidate_activated` seam (the armed prev/next
            // walk is unchanged, US-13/S2). The armed candidate's
            // former text-primary lift reads as the cta emphasis
            // (raised bg) — the same "this row is the picked one"
            // affordance, typed on the primitive's axis.
            for candidate[index] in root.model.candidates: HorizontalLayout {
                vertical-stretch: 0;
                // slint: candidate_activated — the candidate commit
                // seam; click, Return/Space and the AT default action
                // all route it.
                TextButton {
                    vertical-stretch: 0;
                    size: TextButtonSize.compact;
                    label: candidate;
                    emphasis: index == root.model.candidate-index
                        ? TextButtonEmphasis.cta
                        : TextButtonEmphasis.normal;
                    clicked => root.candidate_activated(index);
                }
            }
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: Theme.space-2;
                TextButton {
                size: TextButtonSize.compact;
                vertical-stretch: 0;
                    label: "<";
                    clicked => root.file-prev-clicked();
                }
                TextButton {
                size: TextButtonSize.compact;
                vertical-stretch: 0;
                    label: ">";
                    clicked => root.file-next-clicked();
                }
                TextButton {
                size: TextButtonSize.compact;
                vertical-stretch: 0;
                    label: root.model.file-label;
                    clicked => root.file-commit-clicked();
                }
            }
        }
        // The count gate (D-3's defensive law): the carry verbs —
        // including the planner choice — render only over rows, so
        // "Move to tomorrow" is never clickable over zero rows.
        if (root.model.stage-kind == 1 && !root.model.picking
            && root.model.rows.length > 0): HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-2;
            TextButton {
                size: TextButtonSize.compact;
                vertical-stretch: 0;
                label: root.model.tomorrow-label;
                clicked => root.tomorrow-clicked();
            }
            TextButton {
                size: TextButtonSize.compact;
                vertical-stretch: 0;
                label: root.model.pick-label;
                clicked => root.pick-clicked();
            }
            TextButton {
                size: TextButtonSize.compact;
                vertical-stretch: 0;
                label: root.model.leave-label;
                clicked => root.leave-clicked();
            }
            TextButton {
                size: TextButtonSize.compact;
                vertical-stretch: 0;
                label: root.model.plan-label;
                clicked => root.plan-clicked();
            }
        }
        if (root.model.stage-kind == 1 && root.model.picking): VerticalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-1;
            TextField {
                height: Theme.space-5;
                vertical-stretch: 0;
                label: root.model.pick-label;
                text: root.model.date-text;
                edited(text) => root.date-edited(text);
                accepted() => root.date-commit-clicked();
            }
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: Theme.space-2;
                TextButton {
                size: TextButtonSize.compact;
                vertical-stretch: 0;
                    label: root.model.pick-label;
                    clicked => root.date-commit-clicked();
                }
            }
        }
        // The prompts' equal-prominence exits (C11; P12: no guilt
        // path — both land on the completion summary, D-1).
        if (root.model.stage-kind == 2): HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-2;
            TextButton {
                size: TextButtonSize.compact;
                vertical-stretch: 0;
                label: root.model.record-label;
                clicked => root.record-clicked();
            }
            TextButton {
                size: TextButtonSize.compact;
                vertical-stretch: 0;
                label: root.model.finish-label;
                clicked => root.finish-clicked();
            }
        }
    }
}
