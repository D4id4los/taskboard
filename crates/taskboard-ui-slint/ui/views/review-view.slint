// SPDX-License-Identifier: AGPL-3.0-only
// The review view (#214, D-8): the effort-calibration reading — two
// aggregate stat sections (7-day, 30-day) over ONE per-task ledger of
// the 30-day window. Read-only: rows carry no activation, no context
// actions, no walk targets — a ledger, not a task list; the view
// participates in the page-level scroll only (the ListView pages as
// ScrollPageHint family 4, no focus containers). Everything arrives
// from the Rust push pass (the dumb-client line); the view owns
// composition only. Empty-state collapse per D-9: the whole view
// folds to the EmptyState; a window without comparable tasks collapses
// its values to dashes while the two-section skeleton stays stable.

import { Theme, RoleText, Typography, Semantic } from "../theme.slint";
import { FocusScrollHint } from "../focus-scroll.slint";
import { ListView } from "../widgets/listview.slint";
import { ScrollPageHint } from "../scroll-page.slint";
import { EmptyState } from "../widgets/empty-state.slint";
import { StatBars, StatBarModel } from "../widgets/stat-bars.slint";

export struct ReviewWindowModel {
    estimated: string,
    actual: string,
    gap: string,
    compared: string,
    // True when the window has no comparable tasks: the values
    // collapse (the section stays for the stable two-section skeleton,
    // D-9 tier 2).
    empty: bool,
}

export struct ReviewRowModel {
    title: string,
    // The completion day phrase.
    completed: string,
    // Empty = unestimated (the dash renders structurally, never a
    // zero phrase).
    estimate: string,
    // Empty = untracked.
    actual: string,
    // Empty when the row is not compared.
    gap: string,
}

// One reflection section's pushed values (#623 slice B): the three
// stat cells' phrases, the per-flag counts line, and the per-day
// mood/energy strip (fixed five-point scale, not strip-max). `bars`
// always carries the window's day count — unrated days are baseline
// ticks. A collapsed section (no live entries in the window) phrases
// empty strings and keeps the full-length all-zero strip.
export struct ReflectionSectionModel {
    // Collapsed or unrated → "" — the dash renders structurally.
    mood: string,
    energy: string,
    // The window's total flag occurrences ("N", phrased even at 0
    // once any entry exists).
    flags: string,
    // The joined per-flag counts line; "" = no flags occurred.
    per-flag: string,
    bars: [StatBarModel],
    // No live entries in the window (D-9 tier 2).
    empty: bool,
}

// One journal-entry ledger row (#623 slice B): the stored row read
// verbatim — no excerpting, no inference. "" = unrated / no flags.
export struct ReflectionRowModel {
    day: string,
    cadence: string,
    text: string,
    mood: string,
    energy: string,
    flags: string,
}

// One tracking section's pushed values (#623 slice A): the three stat
// cells' phrases plus the per-day bar strip. `bars` always carries the
// window's day count (7 / 30) — zero days are baseline ticks, never
// missing bars. A collapsed section phrases empty strings and keeps
// the full-length all-zero strip.
export struct TrackingSectionModel {
    // Collapsed (no tracked time of either kind) → "" — the dash
    // renders structurally.
    work: string,
    respite: string,
    // The Work-block reading (count + duration in one phrase).
    blocks: string,
    bars: [StatBarModel],
    // No tracked time of either kind in the window (D-9 tier 2).
    empty: bool,
}

export struct ReviewModel {
    week: ReviewWindowModel,
    month: ReviewWindowModel,
    // The tracking sections (#623 slice A, D-S1): appended after the
    // calibration pair, before the ledger — the skeleton's visual
    // signature stays intact.
    tracking-week: TrackingSectionModel,
    tracking-month: TrackingSectionModel,
    // The reflection pair (#623 slice B, D-B1): appended after the
    // tracking pair — appending keeps the skeleton's visual signature
    // intact.
    reflection-week: ReflectionSectionModel,
    reflection-month: ReflectionSectionModel,
    rows: [ReviewRowModel],
    // The journal-entries ledger (#623 slice B, D-B5): every live
    // stored entry, newest first — not windowed ("one place to look
    // back"); rows-diffed like the calibration ledger.
    reflection-rows: [ReflectionRowModel],
    // Whole-view collapse (D-9 tier 1): nothing comparable, nothing
    // tracked, no reflection entries in the windows, and no stored
    // journal entries anywhere — any content keeps the view standing.
    empty: bool,
}

// One aggregate stat cell: the label over the value; a collapsed
// window renders the dash for every value (D-9 tier 2).
component StatCell inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> collapsed;
    VerticalLayout {
        spacing: Theme.space-1;
        vertical-stretch: 0;
        RoleText {
            role: Typography.caption;
            text-color: Theme.text-secondary;
            text: root.label;
        }
        RoleText {
            role: Typography.body;
            text: root.collapsed ? "—" : root.value;
            wrap: no-wrap;
            overflow: elide;
        }
    }
}

// One window's aggregate section: the caption row over the four stat
// cells. The skeleton is fixed — only the values collapse.
component AggregateSection inherits VerticalLayout {
    in property <string> caption;
    in property <ReviewWindowModel> model;
    VerticalLayout {
        spacing: Theme.space-1;
        vertical-stretch: 0;
        RoleText {
            role: Typography.heading;
            text: root.caption;
        }
        HorizontalLayout {
            spacing: Theme.space-4;
            StatCell {
                label: "Estimated";
                value: root.model.estimated;
                collapsed: root.model.empty;
            }
            StatCell {
                label: "Actual";
                value: root.model.actual;
                collapsed: root.model.empty;
            }
            StatCell {
                label: "Gap";
                value: root.model.gap;
                collapsed: root.model.empty;
            }
            StatCell {
                label: "Compared";
                value: root.model.compared;
                collapsed: root.model.empty;
            }
        }
    }
}

// One tracking window's section (#623 slice A, D-S1): the caption row,
// three stat cells (Work total, Respite total, Work blocks), and the
// per-day bar strip (D-S4). Read-only like everything here: the strip
// carries no activation. The skeleton is fixed — only the values
// collapse (D-9 tier 2: an empty window renders dashes and baseline
// ticks, never a vanished section).
component TrackingSection inherits VerticalLayout {
    in property <string> caption;
    in property <TrackingSectionModel> model;
    VerticalLayout {
        spacing: Theme.space-1;
        vertical-stretch: 0;
        RoleText {
            role: Typography.heading;
            text: root.caption;
        }
        HorizontalLayout {
            spacing: Theme.space-4;
            StatCell {
                label: "Work";
                value: root.model.work;
                collapsed: root.model.empty;
            }
            StatCell {
                label: "Respite";
                value: root.model.respite;
                collapsed: root.model.empty;
            }
            StatCell {
                label: "Work blocks";
                value: root.model.blocks;
                collapsed: root.model.empty;
            }
        }
        StatBars {
            bars: root.model.bars;
        }
    }
}

// One reflection window's section (#623 slice B, D-B1): the caption
// row, three stat cells (Mood, Energy, Flags), the per-flag counts
// line, and the per-day mood/energy strip. Read-only like everything
// here. The skeleton is fixed — only the values collapse (D-9 tier 2:
// an empty window renders dashes and baseline ticks, never a vanished
// section).
component ReflectionSection inherits VerticalLayout {
    in property <string> caption;
    in property <ReflectionSectionModel> model;
    VerticalLayout {
        spacing: Theme.space-1;
        vertical-stretch: 0;
        RoleText {
            role: Typography.heading;
            text: root.caption;
        }
        HorizontalLayout {
            spacing: Theme.space-4;
            StatCell {
                label: "Mood";
                value: root.model.mood;
                collapsed: root.model.empty;
            }
            StatCell {
                label: "Energy";
                value: root.model.energy;
                collapsed: root.model.empty;
            }
            StatCell {
                label: "Flags";
                value: root.model.flags;
                collapsed: root.model.empty;
            }
        }
        if (!root.model.empty && root.model.per-flag != ""): RoleText {
            role: Typography.caption;
            text-color: Theme.text-secondary;
            text: root.model.per-flag;
            wrap: no-wrap;
            overflow: elide;
            vertical-stretch: 0;
        }
        StatBars {
            bars: root.model.bars;
            base-color: Semantic.sync-active;
            stack-color: Semantic.success;
        }
    }
}

export component ReviewView inherits FocusScope {
    in property <ReviewModel> review;
    // The window's logical height, pushed from the app window (the
    // today view's precedent — never a content-derived height).
    in property <length> viewport-height;

    accessible-role: AccessibleRole.region;
    accessible-label: "Review";
    focus-on-tab-navigation: true;
    init => self.focus();

    ring := Rectangle {
        width: 100%;
        height: 100%;
        border-width: root.has-focus ? Theme.focus-ring-width : 0;
        border-color: Semantic.focus-ring;
        border-radius: Theme.radius-medium;

        page := Flickable {
            content := VerticalLayout {
                padding: Theme.space-3;
                spacing: Theme.space-3;
                // D-9 tier 1: the whole-view collapse.
                if (root.review.empty): EmptyState {
                    text: "Nothing to calibrate";
                    hint: "Completed tasks with an estimate or tracked time land here.";
                }
                if (!root.review.empty): VerticalLayout {
                    spacing: Theme.space-3;
                    vertical-stretch: 0;

                    // The two aggregate sections: 7-day, then
                    // 30-day — the stable skeleton (D-9 tier 2
                    // collapses values, never structure).
                    AggregateSection {
                        caption: "Last 7 days";
                        model: root.review.week;
                    }
                    AggregateSection {
                        caption: "Last 30 days";
                        model: root.review.month;
                    }

                    // The tracking pair (#623 slice A, D-S1): appended
                    // after the calibration sections, each captioned
                    // with its window — appending keeps the landed
                    // skeleton's visual signature intact.
                    TrackingSection {
                        caption: "Tracking · last 7 days";
                        model: root.review.tracking-week;
                    }
                    TrackingSection {
                        caption: "Tracking · last 30 days";
                        model: root.review.tracking-month;
                    }

                    // The reflection pair (#623 slice B, D-B1):
                    // appended after the tracking pair, each captioned
                    // with its window.
                    ReflectionSection {
                        caption: "Reflection · last 7 days";
                        model: root.review.reflection-week;
                    }
                    ReflectionSection {
                        caption: "Reflection · last 30 days";
                        model: root.review.reflection-month;
                    }

                    // The journal-entries ledger (#623 slice B, D-B5):
                    // every live stored entry, newest first, read
                    // verbatim — read-only (D-B10): no activation, no
                    // walk targets; editing rides the walk/CLI verbs.
                    // The landed ledger-row pattern inline (family 4
                    // paging, the #373 viewport bound, the explicit
                    // row height) — not extracted: the row bodies
                    // differ per ledger and the pattern is short.
                    RoleText {
                        role: Typography.heading;
                        text: "Journal entries";
                        vertical-stretch: 0;
                    }
                    entries-clip := Rectangle {
                        clip: true;
                        entries := ListView {
                            height: 100%;
                            visible-height: Math.max(root.viewport-height - 2 * Theme.space-3, 0);
                            changed content-height => {
                                parent.height = Math.min(
                                    self.content-height,
                                    Math.max(root.viewport-height - 2 * Theme.space-3, 0),
                                );
                            }
                            request-row: -1;
                            request-nonce: 0;
                            page-request: ScrollPageHint.family == 4 ? ScrollPageHint.page : 0;
                            page-nonce: ScrollPageHint.family == 4 ? ScrollPageHint.nonce : -1;
                            total-rows: root.review.reflection-rows.length;
                            for row[rindex] in root.review.reflection-rows: entry-row := HorizontalLayout {
                                spacing: Theme.space-3;
                                vertical-stretch: 0;
                                height: entry-text.preferred-height;
                                RoleText {
                                    role: Typography.caption;
                                    text-color: Theme.text-secondary;
                                    width: 100px * Theme.base-scale;
                                    text: row.day;
                                    vertical-alignment: center;
                                }
                                RoleText {
                                    role: Typography.caption;
                                    text-color: Theme.text-secondary;
                                    width: 70px * Theme.base-scale;
                                    text: row.cadence;
                                    vertical-alignment: center;
                                }
                                entry-text := RoleText {
                                    role: Typography.body;
                                    text: row.text;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    wrap: no-wrap;
                                    vertical-alignment: center;
                                }
                                RoleText {
                                    role: Typography.caption;
                                    text-color: Theme.text-secondary;
                                    width: 80px * Theme.base-scale;
                                    text: "mood " + (row.mood == "" ? "—" : row.mood);
                                    vertical-alignment: center;
                                }
                                RoleText {
                                    role: Typography.caption;
                                    text-color: Theme.text-secondary;
                                    width: 90px * Theme.base-scale;
                                    text: "energy " + (row.energy == "" ? "—" : row.energy);
                                    vertical-alignment: center;
                                }
                                RoleText {
                                    role: Typography.caption;
                                    text-color: Theme.text-secondary;
                                    width: 160px * Theme.base-scale;
                                    text: row.flags;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // The ledger (D-8): ONE per-task list over the
                    // 30-day window, newest completion first. The
                    // #373 viewport pattern (the today sections'
                    // shape): the repeater fills the window-derived
                    // bound, the clip host owns the content-sized min.
                    RoleText {
                        role: Typography.heading;
                        text: "Completed tasks";
                        vertical-stretch: 0;
                    }
                    ledger-clip := Rectangle {
                        clip: true;
                        ledger := ListView {
                            height: 100%;
                            visible-height: Math.max(root.viewport-height - 2 * Theme.space-3, 0);
                            changed content-height => {
                                parent.height = Math.min(
                                    self.content-height,
                                    Math.max(root.viewport-height - 2 * Theme.space-3, 0),
                                );
                            }
                            request-row: -1;
                            request-nonce: 0;
                            // The review page pages as family 4 (D-8:
                            // page-level scroll only, no focus
                            // containers).
                            page-request: ScrollPageHint.family == 4 ? ScrollPageHint.page : 0;
                            page-nonce: ScrollPageHint.family == 4 ? ScrollPageHint.nonce : -1;
                            total-rows: root.review.rows.length;
                            for row[rindex] in root.review.rows: ledger-row := HorizontalLayout {
                                spacing: Theme.space-3;
                                vertical-stretch: 0;
                                // The explicit height (the today rows'
                                // rule): the repeater's implicit
                                // preferred-height under-solves.
                                height: title-text.preferred-height;
                                title-text := RoleText {
                                    role: Typography.body;
                                    text: row.title;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    wrap: no-wrap;
                                    vertical-alignment: center;
                                }
                                RoleText {
                                    role: Typography.caption;
                                    text-color: Theme.text-secondary;
                                    width: 120px * Theme.base-scale;
                                    text: row.completed;
                                    vertical-alignment: center;
                                }
                                RoleText {
                                    role: Typography.caption;
                                    text-color: Theme.text-secondary;
                                    width: 140px * Theme.base-scale;
                                    text: "est " + (row.estimate == "" ? "—" : row.estimate);
                                    vertical-alignment: center;
                                }
                                RoleText {
                                    role: Typography.caption;
                                    text-color: Theme.text-secondary;
                                    width: 140px * Theme.base-scale;
                                    text: "act " + (row.actual == "" ? "—" : row.actual);
                                    vertical-alignment: center;
                                }
                                RoleText {
                                    role: Typography.caption;
                                    text-color: row.gap == "" ? Theme.text-secondary : Semantic.danger;
                                    width: 160px * Theme.base-scale;
                                    text: row.gap == "" ? "no comparison" : row.gap;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    property <length> watch-viewport-height: root.viewport-height;
                    changed watch-viewport-height => {
                        ledger-clip.height = Math.min(
                            ledger.content-height,
                            Math.max(root.viewport-height - 2 * Theme.space-3, 0),
                        );
                        entries-clip.height = Math.min(
                            entries.content-height,
                            Math.max(root.viewport-height - 2 * Theme.space-3, 0),
                        );
                    }
                }
            }
        }
    }
}
