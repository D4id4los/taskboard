// SPDX-License-Identifier: AGPL-3.0-only
// The today view (L3, chunk 10 D7, #346): the four sections of the
// day window in display order — overdue, scheduled, due today, done —
// each a header (label + count) over task-card rows. Empty sections
// collapse; an all-empty day renders the empty state. Rows carry a
// context line (the stack title, or "board › stack" when more than
// one board is live — a state-derived presentation decision).
//
// The section body is deliberately inlined into the section loop's
// delegate (#373): a `ListView` whose model flows through a child
// component's `in property` does not instantiate on the pinned slint
// (isolated in tests/virtualisation_probe.slint's InnerList shape) —
// reading the model from the delegate's own row data is the board
// legs' proven shape.
//
// The two-column wide arm (#1436, journey plan 2026-11-25 D-1..D-5,
// as amended 2026-11-25): at/above `Theme.layout-today-two-column-min-
// width` the page reflows into a grid — the full-width band (timers,
// tracked-day summary) above, the task sections in the left column,
// habits + the day-review card in the right. Placement only: every
// section keeps its A1-aggregated row set, its collapse law, and its
// seek/extent wiring; the walk's successor order (tasks → habits →
// roster) already reads column-major left→right, so no walk
// re-derivation is needed (the 2026-11-25 dispatch ruling on the
// journey plan). The same width test rules every mount — no kiosk
// branch (the 2026-11-25 operator amendment, issue #1436).

import { Theme, Semantic, RoleText, Typography } from "../theme.slint";
import { FocusScrollHint } from "../focus-scroll.slint";
import { ListView } from "../widgets/listview.slint";
import { ScrollPageHint } from "../scroll-page.slint";
import { TaskCard, TaskCardModel } from "../widgets/task-card.slint";
import { EmptyState } from "../widgets/empty-state.slint";
import { TimersSection, TimerRowModel, BreakRuleRowModel } from "../compositions/timers.slint";
import { FieldValidity } from "../widgets/text-field.slint";
import { HabitsSection, HabitCardModel } from "../compositions/habits.slint";
import { TrackedTodaySection, TrackedTodayRowModel } from "../compositions/tracked-today.slint";
import { TodayAnchorFacts } from "../today-anchor.slint";

// The today page's window-height push (#1310/#1304, 2026-11-24): an
// ASSIGNED global, not a binding chain. The section clip's
// declarative height reads the window cap AND feeds the window's
// layout info, and the window height flows back through
// `window-height` — a binding-coupled cap closes that loop (the
// compiler traces clip.height -> section-block.layoutinfo-v -> ...
// -> window-height -> viewport-height -> page-cap -> clip.height,
// and *rejects every declarative spelling* of the content-derived
// min). The assignment severs the last edge imperatively — the
// round-6 A1 plan D-1b's recorded fallback, applied to the cap's
// INPUT so every height inside the section stays a binding (D-1a).
// The app window re-assigns on init and on every height change; the
// section's bindings re-evaluate from the assignment like from any
// property write, first frame included.
export global TodayViewport {
    // The default only covers a first frame ahead of the app
    // window's init assignment; never read as a semantic value.
    in-out property <length> height: Theme.window-default-height;
}

// The section viewports' realized geometry, reported per delegate
// (#1310/#1304, 2026-11-24; the #1023 law: element-query geometry on
// freshly materialized repeater subtrees is unreliable, so the mount
// pushes its realized geometry through a root seam and the tests
// read that — the TodayAnchorFacts pattern). Display state only.
// The report rides a declarative callback binding (the witness
// property below), not `changed` handlers: Slint suppresses
// first-layout changes (the value present at instantiation never
// fires), which is exactly the failure mode this chunk fixes — the
// report must see the first real geometry. The callback is
// re-evaluated whenever its inputs (section index, y, height)
// change, first evaluation included.
// slint: today-clip-facts
export global TodayClipFacts {
    // The section viewports' geometry channel (#1310/#1304,
    // 2026-11-24). INPUTS: the per-section measured content extents,
    // written by the adapter's push pass (a model-row update does not
    // propagate into a repeater delegate's bindings reliably, so the
    // extents ride global properties — writes here invalidate the
    // height bindings like any property write). OUTPUTS: the
    // realized heights, mirrored by the callback below — the tests'
    // #1023 root seam (element-query geometry on freshly materialized
    // repeater subtrees is unreliable; the mount pushes its realized
    // geometry out). "Pure" is the compiler's alias for
    // re-evaluable-and-idempotent: the write is display state, never
    // a command.
    // slint: today-clip-facts-height
    pure callback section-height(int, length, length) -> length;
    in-out property <length> e0;
    in-out property <length> e1;
    in-out property <length> e2;
    in-out property <length> e3;
    in-out property <length> h0;
    in-out property <length> h1;
    in-out property <length> h2;
    in-out property <length> h3;
}

// The layout arm's #1023 root seam (#1436, the TodayClipFacts
// pattern): the grid-arm predicate is a pure width expression at the
// TodayView root — no state mutation, no command — and the callback
// witness mirrors it out for the tests (Slint suppresses
// first-layout `changed` fires, so a declarative callback binding is
// the report's driver; the Rust handler idempotently mirrors the
// returned bool into `grid-arm`). Display state only.
// slint: today-layout-facts
export global TodayLayoutFacts {
    // slint: today-layout-facts-grid-arm
    pure callback grid-arm-witness(bool) -> bool;
    in-out property <bool> grid-arm: false;
}

export struct TodayRowModel {
    // The row's stable task key (#592): the extent cache and the
    // anchor facts address rows by task id, never by position (the
    // diff's rebind cascade shifts positions under every membership
    // change).
    id: string,
    card: TaskCardModel,
    // The stack title, or "<board> › <stack>" on a multi-board
    // desktop (D-V3); suppressed on kiosk (no badges).
    context: string,
}

export struct TodaySectionModel {
    label: string,
    count: int,
    rows: [TodayRowModel],
}

export struct TodayModel {
    sections: [TodaySectionModel],
    // True when every section is empty — the capture-hint empty state.
    empty: bool,
    // The "Tracked" day summary (#490, r4 chunk 10 D-TS7): per-task
    // Work-only totals over the day window plus the day total over
    // the pushed rows. Empty collapses (no rows → the section never
    // renders).
    tracked-today: [TrackedTodayRowModel],
    tracked-day-total: string,
}

// One task section of the today page (#1436): the #373 inlined
// delegate body, extracted verbatim so the single-column arm and the
// wide arm's left column mount the SAME block. Placement-only
// refactor: the inner structure (header, page cap, clip height
// binding, ListView, row delegates) is byte-identical to the
// pre-extraction delegate; only the parent layout differs per arm.
// Mount law per arm: the wide arm's left column MOUNTS its blocks
// fresh; the narrow arm's section delegates stay MOUNTED but
// layout-collapsed under the wide arm (`visible: false` — the
// delegate cannot carry a bare conditional, and the pass-through
// wrapper's own `visible` is the collapse law's mechanism), so their
// layout contribution is exactly one arm's while the twin
// virtualizers remain instantiated (the #1464 class; filed as
// backlog for the sweep).
component TodaySectionBlock inherits VerticalLayout {
    vertical-stretch: 0;
    // Empty sections collapse (D7): the header and rows render only
    // when the group has rows.
    visible: sec.count > 0;
    spacing: Theme.space-1;
    in property <TodaySectionModel> sec;
    in property <int> sindex;
    // The window's logical height, pushed through the view root
    // (the #373 D-7 section bound's base — never a content-derived
    // height; see TodayView.viewport-height).
    in property <length> viewport-height;
    callback row-activated(int, int);
    callback row-extent(string, length);
    callback row-clicked(int, int);
    callback row-context(int, int, float, float);
    callback row-done-toggled(int, int);
    callback row-track-toggled(int, int);
    // slint: today-page-seek (A5a D-3): the outer page's
    // focus-into-view seek, evaluated by the view root where the
    // page viewport lives — the block reports its window-absolute
    // top edge and height (structural geometry, never a hard-coded
    // offset).
    callback seek-from-window(length, length);

    // slint: today-page-seek-sections (A5a D-3, #1302): the task
    // sections' page seek — the outer half of the composition with
    // the section's own ListView consumption below (the
    // walk-past-the-fold fix).
    property <int> seek-nonce: FocusScrollHint.target-a == sindex ? FocusScrollHint.nonce : -1;
    changed seek-nonce => {
        if (self.seek-nonce >= 0) {
            root.seek-from-window(self.absolute-position.y, self.height);
        }
    }

    HorizontalLayout {
        spacing: Theme.space-2;
        RoleText {
            role: Typography.caption;
            text: sec.label;
            vertical-alignment: center;
        }
        RoleText {
            role: Typography.caption;
            text-color: Theme.text-secondary;
            text: sec.count;
            vertical-alignment: center;
        }
    }

    // The window cap (#373 D-7, #1310/#1304): the section viewport's
    // ceiling — window height minus the page's side padding. One
    // property so the reads below cannot drift.
    property <length> page-cap: Math.max(viewport-height - 2 * Theme.space-3, 0);
    // The section's row viewport: content-sized below the page cap,
    // capped above it. Declarative from the first frame
    // (#1310/#1304, 2026-11-24): the height BINDS to the section's
    // measured content extent (the model's `content-extent`, summed
    // adapter-side from the #592 row-extent reports) — never to the
    // ListView's content-height. The direct min(content-height, cap)
    // spelling is a binding loop the compiler traces through the
    // layout-info chain
    // (clip.height -> section-block.layoutinfo-v -> ... ->
    // window-height -> viewport-height -> cap -> row-viewport.height
    // -> content-height), and the former `changed`-assigned escape
    // missed the first frame and could stop re-firing (the
    // convergence trap). The extent channel is the recorded
    // decoupling (round-6 A1 plan D-1b): the data leaves the layout
    // graph entirely, so the binding always re-evaluates when a
    // report lands — first materialization included — and a fitting
    // section is content-sized while an overflowing one caps and
    // scrolls internally.
    row-viewport-clip := Rectangle {
        clip: true;
        // The content-derived min, computed by (and reported
        // through) the TodayClipFacts seam's callback — the height
        // binding's eager evaluation is the report's driver, and its
        // extent argument is a global-property dependency the
        // adapter's pass invalidates.
        height: TodayClipFacts.section-height(
            sindex,
            sindex == 0 ? TodayClipFacts.e0
            : sindex == 1 ? TodayClipFacts.e1
            : sindex == 2 ? TodayClipFacts.e2
            : TodayClipFacts.e3,
            page-cap,
        );
        row-viewport := ListView {
            // `height: 100%` (the clip) is safe again: the height
            // binding above reads the facts channel, never the
            // ListView's content-height, so the old
            // height -> content-height cycle does not exist. The
            // virtualizer's live-row window stays `visible-height`
            // (the cap — the pre-fix semantics): in the capped
            // regime cap IS the painted viewport, and in the fitting
            // regime the surplus window is clipped away by
            // `clip: true`.
            height: 100%;
            visible-height: page-cap;
            request-row: FocusScrollHint.target-a == sindex
            ? FocusScrollHint.target-b
            : -1;
        request-nonce: FocusScrollHint.target-a == sindex
            ? FocusScrollHint.nonce
            : 0;
        // Family 2 (round-3 D26): the focused task's section pages,
        // independently.
        page-request: ScrollPageHint.family == 2
            && ScrollPageHint.index == sindex
            ? ScrollPageHint.page
            : 0;
        page-nonce: ScrollPageHint.family == 2
            && ScrollPageHint.index == sindex
            ? ScrollPageHint.nonce
            : -1;
        total-rows: sec.rows.length;
        // #592: the today sections opt into the row-anchored mode;
        // the facts are this section's payload only (the
        // FocusScrollHint filter pattern).
        row-anchored: true;
        anchor-first-change: TodayAnchorFacts.section == sindex
            ? TodayAnchorFacts.first-change
            : -1;
        anchor-row-delta: TodayAnchorFacts.section == sindex
            ? TodayAnchorFacts.row-delta
            : 0;
        anchor-extent: TodayAnchorFacts.section == sindex
            ? TodayAnchorFacts.extent
            : 0px;
        anchor-nonce: TodayAnchorFacts.section == sindex
            ? TodayAnchorFacts.nonce
            : -1;
        for row[rindex] in sec.rows: today-row := VerticalLayout {
            // The extent report rides `changed height`, gated to a
            // real change: an ungated report crosses into Rust on
            // every layout pass, while the last-report gate makes
            // the steady-state body a no-op comparison and a fresh
            // height (a rebind under the rebind cascade, a
            // context-line flip) reports exactly once. The paired
            // A/B bench (stage-3 re-measurement, recorded in the
            // #592 stage-2 report §5) shows no draw-lane delta
            // against the report's before runs.
            property <length> last-extent: -1px;
            changed height => {
                if (Math.abs(self.height - self.last-extent) > 0.5px) {
                    self.last-extent = self.height;
                    root.row-extent(row.id, self.height);
                }
            }
            spacing: Theme.space-1;
            vertical-stretch: 0;
            // The explicit height carries the card's preferred plus
            // the conditional context line (the board delegate's
            // pattern): the repeater's implicit preferred-height
            // binding under-solves the wrapped card.
            height: row-card.preferred-height
                + (context-line.visible
                    ? Theme.space-1 + context-line.preferred-height
                    : 0);
            row-card := TaskCard {
                model: row.card;
                hint-keys: [];
                activated => {
                    root.row-activated(sindex, rindex);
                }
                clicked => {
                    root.row-clicked(sindex, rindex);
                }
                context-requested(x, y) => {
                    root.row-context(sindex, rindex, x, y);
                }
                done-toggled => {
                    root.row-done-toggled(sindex, rindex);
                }
                // slint: track-toggled
                track-toggled => {
                    root.row-track-toggled(sindex, rindex);
                }
            }
            // The context line (D-V3): the stack, or "board › stack"
            // on a multi-board desktop.
            context-line := RoleText {
                role: Typography.caption;
                text-color: Theme.text-secondary;
                text: row.context;
                visible: row.context != "";
            }
        }
        }
    }
}

// The timers block (#1436 extraction): the TimersSection composition
// plus its page-seek wiring (slot 5), shared verbatim by both arms.
component TimersBlock inherits TimersSection {
    vertical-stretch: 0;
    callback seek-from-window(length, length);
    // slint: today-page-seek-timers (A5a D-3/D-2): the break-rules
    // roster's page slot (5) — the roster lives in this block, which
    // is content-sized (no inner scroll), so the page seek is the
    // whole fix.
    property <int> seek-nonce: FocusScrollHint.target-a == 5 ? FocusScrollHint.nonce : -1;
    changed seek-nonce => {
        if (self.seek-nonce >= 0) {
            root.seek-from-window(self.absolute-position.y, self.height);
        }
    }
}

// The habits block (#1436 extraction): the HabitsSection composition
// plus its page-seek wiring (slot 4), shared verbatim by both arms.
component HabitsBlock inherits HabitsSection {
    vertical-stretch: 0;
    callback seek-from-window(length, length);
    // slint: today-page-seek-habits (A5a D-3/D-2): the habits
    // section's page slot (4) — content-sized, no inner scroll; the
    // page seek is the whole fix.
    property <int> seek-nonce: FocusScrollHint.target-a == 4 ? FocusScrollHint.nonce : -1;
    changed seek-nonce => {
        if (self.seek-nonce >= 0) {
            root.seek-from-window(self.absolute-position.y, self.height);
        }
    }
}

// The surfacing card (DR-7 D-J10, #1436 extraction): the header
// slot's card, shared verbatim by both arms.
component ReviewCardBlock inherits Rectangle {
    vertical-stretch: 0;
    in property <string> card-title-text;
    in property <string> card-body-text;
    in property <string> card-action-text;
    callback card-clicked();

    background: Theme.surface;
    border-radius: Theme.radius-medium;
    border-width: Theme.focus-ring-width;
    border-color: Semantic.focus-ring;
    min-height: card-title.preferred-height + card-body.preferred-height
        + 2 * Theme.space-2;
    VerticalLayout {
        padding: Theme.space-2;
        spacing: Theme.space-1;
        card-title := RoleText {
            vertical-stretch: 0;
            role: Typography.caption;
            text: root.card-title-text;
        }
        card-body := RoleText {
            vertical-stretch: 0;
            role: Typography.caption;
            text-color: Theme.text-secondary;
            text: root.card-body-text;
        }
    }
    TouchArea {
        clicked => root.card-clicked();
    }
    accessible-role: AccessibleRole.button;
    accessible-label: root.card-action-text;
    accessible-action-default => { root.card-clicked(); }
}

export component TodayView inherits FocusScope {
    // The severing cap (J4 US-3 AC-2; the task-view precedent): the
    // root's layout merge must never bound the OS window's max width.
    // The #1436 grid arm composes INSIDE this cap (journey plan D-5):
    // the grid activates between the shared breakpoint and the cap;
    // above the cap the centred capped width carries the same grid —
    // the E1 severing census covers the grid arm through this root.
    max-width: Theme.layout-severing-max-width;
    in property <TodayModel> today;
    // The window's logical height, pushed from the app window (the
    // #373 D-7 section bound's base): deliberately NOT a
    // content-derived height — reading any content height here
    // re-enters the page's own layout info and binds in a loop.
    in property <length> viewport-height;
    callback row-activated(int, int);
    // #592: a live row reports its rendered extent (the C-2 height
    // cache's source — exact extents for ever-live rows; deduped
    // adapter-side, so repeated no-op reports cost one map insert).
    callback row-extent(string, length);
    callback row-clicked(int, int);
    callback row-context(int, int, float, float);
    // The done checkbox's toggle (r3 D6): (section, row) — the adapter
    // resolves the today table and flips the model bit.
    callback row-done-toggled(int, int);
    // slint: row-track-toggled (UX-R8 chunk-5 D-6): the row's control.
    callback row-track-toggled(int, int);
    // The timers section (DR-3/3, D-I6): top-of-page, above the empty
    // state and the task sections (D-P18). The desktop controls are
    // enforced model-side — `timers-visible` is false on kiosk, but
    // the section's display host mounts there under the absence hint
    // (UX R-1 D-2, #790: the fenced surface's honest absence signal).
    in property <bool> timers-visible;
    // The kiosk absence hint (UX R-1 D-2, #790): the muted caption's
    // display flag — display state only, never a command.
    in property <bool> timers-absence-hint;
    in property <[TimerRowModel]> timers;
    in property <int> timers-awaiting;
    callback timers-cancel-clicked(int);
    // `false` keeps the form's text (an absorbed parse miss). The
    // bool is the insistence rung's alarm bit (r4 D-T7).
    callback timers-create-accepted(string, string, bool) -> bool;
    // The `when` field's per-keystroke validity (r4 D27).
    callback timers-when-edited(string);
    // The mouse setter's open request (r4 D33) — the popover mounts
    // at window level.
    callback timers-setter-opened();
    in property <FieldValidity> timer-when-validity;
    in property <string> timer-when-error-hint;
    // The break-rule subsection (T-14, #797): roster rows, the
    // create form's state, and the staged remove's forwards.
    in property <[BreakRuleRowModel]> break-rules;
    in property <bool> break-create-open;
    callback timers-break-create-toggled();
    // `false` keeps the form's text (an absorbed parse miss). The
    // bool is the insistence rung's alarm bit.
    callback timers-break-create-accepted(string, string, bool) -> bool;
    callback timers-break-threshold-edited(string);
    callback timers_break_remove_clicked(int);
    callback timers_break_remove_confirmed(int);
    callback timers_break_remove_cancelled();
    in property <FieldValidity> break-threshold-validity;
    in property <string> break-threshold-error-hint;
    // The habits section (DR-6/6, §4.6): after the timers block,
    // above the task sections (D-P18). Renders whenever the active
    // board has live habits — on kiosk too (passive progress
    // visibility IS the point; only the actions gate).
    in property <[HabitCardModel]> habits;
    in property <bool> habits-editing-enabled;
    // The create flow's forwarding (round-7 D-7.2): the mount gate's
    // widening (`habits-create-mountable` — desktop, board active,
    // model-side gated) and the form's seams, verbatim.
    in property <bool> habits-create-mountable: false;
    in property <bool> habits-create-open: false;
    // The pause editor's forwarding (HF1, W-3): the mount flag, the
    // editor's seams, and the row affordances — verbatim.
    in property <bool> habits-pause-open: false;
    in property <bool> habits-pause-mountable: false;
    // The deleted-habits restore section's forwarding (#1290/#1245,
    // the undo-family amendment): the roster rows and armed mirrors,
    // verbatim (the labels-overlay forwarding's shape).
    in property <[string]> habits-deleted-rows;
    in property <bool> habits-has-deleted: false;
    in property <int> habits-restore-armed-index: -1;
    in property <bool> habits-restore-all-armed: false;
    callback habits-habit-restore-requested(int);
    callback habits-habit-restore-cancelled();
    callback habits-habit-restore-all-requested();
    callback habits-habit-restore-all-cancelled();
    in property <FieldValidity> habits-quota-validity;
    in property <string> habits-quota-error-hint;
    // The habit row's play control (journey plan 2026-11-24 W-1,
    // #1305): routes `habit.track-toggle` over the row.
    callback habits-track-asked(int);
    callback habits-skip-asked(int);
    callback habits-pause-asked(int);
    callback habits-resume-asked(int);
    callback habits-pause-until-picked(string);
    callback habits-pause-cancelled();
    callback habits-create-asked();
    callback habits-create-confirmed(string, string, int) -> bool;
    callback habits-create-cancelled();
    callback habits-create-quota-edited(string);
    callback habits-log-clicked(int);
    // The row's −1 recovery (UX R-2 D-3, #786).
    callback habits-undo-log-clicked(int);
    // The inline quota edit's opener (W-5, #961): the phrase click
    // (the row index rides to the window like every row seam).
    callback habits-quota-edit-asked(int);
    callback habits-repair-clicked(int);
    // The row's focus fact (cross-surface friction plan D-2, #832).
    callback habits-row-activated(int);
    // The row's double-click editor opener (D3a W-4, #1201).
    callback habits-edit-asked(int);
    // The right-click context request (H2 D4): the habit menu's
    // opener (index, window x, window y).
    callback habits-context-requested(int, float, float);
    // The habit list's gap drop (chunk 8 D5): the delegate-resolved
    // (row, gap) pair from the section's DropAreas.
    callback habits-drop-asked(int, int);
    // The Tracked section's activation seam (#490): the adapter
    // resolves the row against the tracked-today table and opens the
    // task (the today-row-activated precedent).
    callback tracked-activated(int);
    // The review walk's surfacing card (DR-7 D-J10, #638): the whole
    // copy arrives pushed (the phrase fns' output); visibility is the
    // model-side gate (kiosk never receives a card). The card sits
    // in the header slot — above and OUTSIDE the sections'
    // `ListView`s, so the row-anchored compensation (#592) never
    // sees it.
    in property <bool> review-card-visible;
    in property <string> review-card-title;
    in property <string> review-card-body;
    in property <string> review-card-action;
    callback review-card-clicked();

    focus-on-tab-navigation: true;
    accessible-role: AccessibleRole.region;
    accessible-label: "Today";
    init => self.focus();

    // The wide arm's predicate (#1436, journey plan D-2): the view's
    // own width (the view host fills the window's logical width —
    // the toolbar spans above, there is no side chrome) against the
    // shared breakpoint token. The same width test rules every mount
    // — no kiosk branch (the 2026-11-25 operator amendment). The
    // #1023 witness mirror (the TodayClipFacts pattern) rides a
    // declarative callback binding so the report sees the first
    // real geometry.
    property <bool> grid-arm: self.width >= Theme.layout-today-two-column-min-width;
    property <bool> grid-arm-report: TodayLayoutFacts.grid-arm-witness(root.grid-arm);
    // The habits block's mount gate (round-7 D-7.2), hoisted so both
    // arms read one expression (the fold law: exactly one arm).
    property <bool> habits-block-mounted: root.habits.length > 0
        || root.habits-has-deleted
        || root.habits-create-mountable
        || root.habits-pause-mountable;

    // slint: today-page-seek (A5a D-3, #1302): the outer page's
    // focus-into-view seek. `top` is the target block's live top edge
    // within the page viewport (absolute-position arithmetic —
    // structural geometry, never a hard-coded offset) and
    // `block-height` its realized height; the seek writes the minimal
    // content-y shift that puts the block inside the visible window,
    // clamped to the content. Fires on a hint edge only (a focus
    // landing) — a content mutation never seeks (the
    // no-scroll-on-insert contract holds); the inner ListViews keep
    // their own consumption, so outer and inner seek compose (D-3).
    public function seek-page(top: length, block-height: length) {
        let view = page.height;
        let max-shift = view - content.height;
        if (top < 0) {
            page.content-y = Math.clamp(page.content-y - top, max-shift, 0);
        } else if (top + block-height > view) {
            page.content-y = Math.clamp(
                page.content-y - (top + block-height - view),
                max-shift,
                0,
            );
        }
    }

    ring := Rectangle {
        width: 100%;
        height: 100%;
        border-width: root.has-focus ? Theme.focus-ring-width : 0;
        border-color: Semantic.focus-ring;
        border-radius: Theme.radius-medium;

        page := Flickable {
            // The sections scroll: a long day never pushes the chrome
            // around (the action-menu pattern — the viewport
            // auto-tracks the content's preferred size).
            content := VerticalLayout {
                padding: Theme.space-3;
                spacing: Theme.space-3;
                // The section viewports' convergence transients can
                // temporarily overflow this content; the Flickable only
                // re-clamps its scroll position on interaction, so a
                // shrink here re-clamps explicitly (the padding must
                // stay visible at rest).
                changed height => {
                    page.content-y = Math.min(0, Math.max(
                        page.content-y,
                        page.height - self.height,
                    ));
                }

                // ---- the wide arm (#1436, journey plan D-1/D-4):
                // the full-width band above the grid, then the
                // two-column grid. One scroll container (the page
                // Flickable) scrolls both columns together; the
                // columns top-align and unequal heights leave the
                // shorter column's space below empty (no nested
                // scroll region — the #1310 convergence-transient
                // class is not reopened).
                if (root.grid-arm): HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.space-3;
                    // The left column (D-1): the task sections,
                    // urgency first — the model's display order.
                    VerticalLayout {
                        spacing: Theme.space-3;
                        if (root.today.empty): EmptyState {
                            text: "Nothing due today";
                            hint: "Capture a thought from anywhere — it lands in the inbox.";
                        }
                        for section[sindex] in root.today.sections: TodaySectionBlock {
                            sec: section;
                            sindex: sindex;
                            viewport-height: root.viewport-height;
                            row-activated(s, r) => root.row-activated(s, r);
                            row-extent(id, h) => root.row-extent(id, h);
                            row-clicked(s, r) => root.row-clicked(s, r);
                            row-context(s, r, x, y) => root.row-context(s, r, x, y);
                            row-done-toggled(s, r) => root.row-done-toggled(s, r);
                            row-track-toggled(s, r) => root.row-track-toggled(s, r);
                            seek-from-window(y, h) => root.seek-page(y - page.absolute-position.y, h);
                        }
                        // The column's layout sink (the #1334 law):
                        // each arm carries its own designated surplus
                        // absorber so the constraint solver never
                        // spills the slack into the visible children.
                        Rectangle {
                            vertical-stretch: 1;
                            min-height: 0;
                        }
                    }
                    // The right column (D-1): the meta sections.
                    VerticalLayout {
                        spacing: Theme.space-3;
                        if (root.habits-block-mounted): HabitsBlock {
                            habits: root.habits;
                            editing-enabled: root.habits-editing-enabled;
                            row-activated(r) => root.habits-row-activated(r);
                            edit-asked(r) => root.habits-edit-asked(r);
                            log-clicked(r) => root.habits-log-clicked(r);
                            undo-log-clicked(r) => root.habits-undo-log-clicked(r);
                            quota-edit-asked(r) => root.habits-quota-edit-asked(r);
                            repair-clicked(r) => root.habits-repair-clicked(r);
                            context-requested(r, x, y) => root.habits-context-requested(r, x, y);
                            drop-asked(r, g) => root.habits-drop-asked(r, g);
                            track-asked(r) => root.habits-track-asked(r);
                            skip-asked(r) => root.habits-skip-asked(r);
                            pause-asked(r) => root.habits-pause-asked(r);
                            resume-asked(r) => root.habits-resume-asked(r);
                            pause-until-picked(s) => root.habits-pause-until-picked(s);
                            pause-cancelled() => root.habits-pause-cancelled();
                            pause-open: root.habits-pause-open;
                            pause-mountable: root.habits-pause-mountable;
                            create-open: root.habits-create-open;
                            quota-validity: root.habits-quota-validity;
                            quota-error-hint: root.habits-quota-error-hint;
                            create-asked() => root.habits-create-asked();
                            create-confirmed(t, q, i) => root.habits-create-confirmed(t, q, i);
                            create-cancelled() => root.habits-create-cancelled();
                            create-quota-edited(s) => root.habits-create-quota-edited(s);
                            deleted-rows: root.habits-deleted-rows;
                            has-deleted: root.habits-has-deleted;
                            restore-armed-index: root.habits-restore-armed-index;
                            restore-all-armed: root.habits-restore-all-armed;
                            habit-restore-requested(r) => root.habits-habit-restore-requested(r);
                            habit-restore-cancelled() => root.habits-habit-restore-cancelled();
                            habit-restore-all-requested() => root.habits-habit-restore-all-requested();
                            habit-restore-all-cancelled() => root.habits-habit-restore-all-cancelled();
                            seek-from-window(y, h) => root.seek-page(y - page.absolute-position.y, h);
                        }
                        if (root.review-card-visible): ReviewCardBlock {
                            card-title-text: root.review-card-title;
                            card-body-text: root.review-card-body;
                            card-action-text: root.review-card-action;
                            card-clicked() => root.review-card-clicked();
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            min-height: 0;
                        }
                    }
                }

                // The full-width band (D-1): timers first on the page
                // (D-P18) — the wide arm renders it above the grid,
                // the narrow arm in the existing slot; both below.
                if (root.grid-arm
                    && (root.timers-visible || root.timers-absence-hint)): TimersBlock {
                    timers: root.timers;
                    timers-awaiting: root.timers-awaiting;
                    absence-hint: root.timers-absence-hint;
                    cancel-clicked(r) => root.timers-cancel-clicked(r);
                    create-accepted(label, when, alarm) => {
                        root.timers-create-accepted(label, when, alarm)
                    }
                    // The validity half (r4 D27, chunk 9's mount fix):
                    // the form's per-keystroke grammar probe rides the
                    // same forwards the task-view twin wires.
                    when-edited(t) => root.timers-when-edited(t);
                    setter-opened() => root.timers-setter-opened();
                    when-validity: root.timer-when-validity;
                    when-error-hint: root.timer-when-error-hint;
                    // The break-rule subsection (T-14, #797): the
                    // roster, the staged remove, and the create form.
                    break-rules: root.break-rules;
                    break-create-open: root.break-create-open;
                    break-create-toggled() => root.timers-break-create-toggled();
                    break-create-accepted(label, threshold, alarm) => {
                        root.timers-break-create-accepted(label, threshold, alarm)
                    }
                    break-threshold-edited(t) => root.timers-break-threshold-edited(t);
                    break_remove_clicked(r) => root.timers_break_remove_clicked(r);
                    break_remove_confirmed(r) => root.timers_break_remove_confirmed(r);
                    break_remove_cancelled() => root.timers_break_remove_cancelled();
                    break-threshold-validity: root.break-threshold-validity;
                    break-threshold-error-hint: root.break-threshold-error-hint;
                    seek-from-window(y, h) => root.seek-page(y - page.absolute-position.y, h);
                }
                // The "Tracked" day summary (#490): the D-1 band's
                // second half — full-width above the grid in the wide
                // arm (a separate composition, not a fifth section
                // model; the row shape differs). Empty collapses.
                if (root.grid-arm
                    && root.today.tracked-today.length > 0): TrackedTodaySection {
                    vertical-stretch: 0;
                    rows: root.today.tracked-today;
                    day-total: root.today.tracked-day-total;
                    row-activated(i) => root.tracked-activated(i);
                }

                // ---- the narrow arm: the single column, the exact
                // pre-#1436 order (timers → habits → review card →
                // empty state → tracked → sections → sink). Below the
                // breakpoint this arm is byte-identical to the
                // pre-grid page (US-17 AC-2).
                if (!root.grid-arm
                    && (root.timers-visible || root.timers-absence-hint)): TimersBlock {
                    timers: root.timers;
                    timers-awaiting: root.timers-awaiting;
                    absence-hint: root.timers-absence-hint;
                    cancel-clicked(r) => root.timers-cancel-clicked(r);
                    create-accepted(label, when, alarm) => {
                        root.timers-create-accepted(label, when, alarm)
                    }
                    when-edited(t) => root.timers-when-edited(t);
                    setter-opened() => root.timers-setter-opened();
                    when-validity: root.timer-when-validity;
                    when-error-hint: root.timer-when-error-hint;
                    break-rules: root.break-rules;
                    break-create-open: root.break-create-open;
                    break-create-toggled() => root.timers-break-create-toggled();
                    break-create-accepted(label, threshold, alarm) => {
                        root.timers-break-create-accepted(label, threshold, alarm)
                    }
                    break-threshold-edited(t) => root.timers-break-threshold-edited(t);
                    break_remove_clicked(r) => root.timers_break_remove_clicked(r);
                    break_remove_confirmed(r) => root.timers_break_remove_confirmed(r);
                    break_remove_cancelled() => root.timers_break_remove_cancelled();
                    break-threshold-validity: root.break-threshold-validity;
                    break-threshold-error-hint: root.break-threshold-error-hint;
                    seek-from-window(y, h) => root.seek-page(y - page.absolute-position.y, h);
                }
                // The habits section (D-P18): timers, then habits,
                // then the task sections. Mounts with rows OR while a
                // create can happen (round-7 D-7.2: desktop + active
                // board — the header-only section is how the first
                // habit gets made; kiosk and board-less days keep the
                // old rows-only gate model-side).
                if (!root.grid-arm && root.habits-block-mounted): HabitsBlock {
                    habits: root.habits;
                    editing-enabled: root.habits-editing-enabled;
                    row-activated(r) => root.habits-row-activated(r);
                    edit-asked(r) => root.habits-edit-asked(r);
                    log-clicked(r) => root.habits-log-clicked(r);
                    undo-log-clicked(r) => root.habits-undo-log-clicked(r);
                    quota-edit-asked(r) => root.habits-quota-edit-asked(r);
                    repair-clicked(r) => root.habits-repair-clicked(r);
                    context-requested(r, x, y) => root.habits-context-requested(r, x, y);
                    drop-asked(r, g) => root.habits-drop-asked(r, g);
                    track-asked(r) => root.habits-track-asked(r);
                    skip-asked(r) => root.habits-skip-asked(r);
                    pause-asked(r) => root.habits-pause-asked(r);
                    resume-asked(r) => root.habits-resume-asked(r);
                    pause-until-picked(s) => root.habits-pause-until-picked(s);
                    pause-cancelled() => root.habits-pause-cancelled();
                    pause-open: root.habits-pause-open;
                    pause-mountable: root.habits-pause-mountable;
                    create-open: root.habits-create-open;
                    quota-validity: root.habits-quota-validity;
                    quota-error-hint: root.habits-quota-error-hint;
                    create-asked() => root.habits-create-asked();
                    create-confirmed(t, q, i) => root.habits-create-confirmed(t, q, i);
                    create-cancelled() => root.habits-create-cancelled();
                    create-quota-edited(s) => root.habits-create-quota-edited(s);
                    deleted-rows: root.habits-deleted-rows;
                    has-deleted: root.habits-has-deleted;
                    restore-armed-index: root.habits-restore-armed-index;
                    restore-all-armed: root.habits-restore-all-armed;
                    habit-restore-requested(r) => root.habits-habit-restore-requested(r);
                    habit-restore-cancelled() => root.habits-habit-restore-cancelled();
                    habit-restore-all-requested() => root.habits-habit-restore-all-requested();
                    habit-restore-all-cancelled() => root.habits-habit-restore-all-cancelled();
                    seek-from-window(y, h) => root.seek-page(y - page.absolute-position.y, h);
                }
                // The surfacing card (DR-7 D-J10): the header slot,
                // above the sections — outside every `ListView` (the
                // #592 anchor keys on list rows; the card is not one).
                if (!root.grid-arm && root.review-card-visible): ReviewCardBlock {
                    card-title-text: root.review-card-title;
                    card-body-text: root.review-card-body;
                    card-action-text: root.review-card-action;
                    card-clicked() => root.review-card-clicked();
                }
                if (!root.grid-arm && root.today.empty): EmptyState {
                    text: "Nothing due today";
                    hint: "Capture a thought from anywhere — it lands in the inbox.";
                }
                // The "Tracked" day summary (#490): the day-summary
                // footer after the four task sections — a separate
                // composition, not a fifth section model (the row
                // shape differs; the timers/habits precedent). Empty
                // collapses.
                if (!root.grid-arm
                    && root.today.tracked-today.length > 0): TrackedTodaySection {
                    vertical-stretch: 0;
                    rows: root.today.tracked-today;
                    day-total: root.today.tracked-day-total;
                    row-activated(i) => root.tracked-activated(i);
                }
                for section[sindex] in root.today.sections: narrow-section := VerticalLayout {
                    // The conditional arm element (a repeater
                    // delegate cannot carry a bare `if`): the
                    // pass-through wrapper contributes the block's
                    // own layout info unchanged (one child, no
                    // spacing). `visible: false` removes the wrapper
                    // from the layout entirely (no space, no spacing
                    // slot) but keeps the delegate mounted — the
                    // recorded trade-off is in TodaySectionBlock's
                    // header comment.
                    visible: !root.grid-arm;
                    vertical-stretch: 0;
                    TodaySectionBlock {
                        sec: section;
                        sindex: sindex;
                        viewport-height: root.viewport-height;
                        row-activated(s, r) => root.row-activated(s, r);
                        row-extent(id, h) => root.row-extent(id, h);
                        row-clicked(s, r) => root.row-clicked(s, r);
                        row-context(s, r, x, y) => root.row-context(s, r, x, y);
                        row-done-toggled(s, r) => root.row-done-toggled(s, r);
                        row-track-toggled(s, r) => root.row-track-toggled(s, r);
                        seek-from-window(y, h) => root.seek-page(y - page.absolute-position.y, h);
                    }
                }
                // The layout sink (#1334): the Flickable viewport
                // requires the content to fill the page when the day is
                // short, so the constraint solver MUST place the
                // surplus somewhere. Before the declarative clip
                // heights (#1310/#1304) the empty sections' unassigned
                // clip heights were free variables that absorbed it
                // invisibly; once every clip height became a bound
                // min(extent, cap), the solver spilled the surplus into
                // the visible stretch-0 children instead — the section
                // headers and the tracked summary each grew by a share
                // of the slack (the kiosk-today golden's ~one-row
                // spacing offset, at every scale). This zero-preferred
                // flexible element is the designated sink: the day's
                // rows stay at their intrinsic spacing and the leftover
                // stays empty at the page's end, the pre-fix shape.
                // (The wide arm's columns carry their own sinks above.)
                if (!root.grid-arm): Rectangle {
                    vertical-stretch: 1;
                    min-height: 0;
                }
            }
        }
    }
}
