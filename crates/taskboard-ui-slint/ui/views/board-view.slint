// SPDX-License-Identifier: AGPL-3.0-only
// The board view (L3, D22): the board state slice plus the action
// dispatchers — a thin owner of a BoardLayout. The scope focuses
// itself on mount (D15's programmatic-focus seam; conditional
// mounting creates the element, `init` grabs focus).

import { Theme, Semantic } from "../theme.slint";
import { BoardLayout, StackColumnModel } from "../compositions/board-layout.slint";
import { BoardBarModel } from "../compositions/board-bar.slint";

// The board model (D22): the kanban geometry. The board title renders
// in the toolbar (the window's `toolbar-title`), not in this model.
export struct BoardModel {
    stacks: [StackColumnModel],
    // The true selection (r2 D4): a stack index, or −1 when no stack
    // is explicitly selected (the move-target convention) — the
    // regular header paints only a real selection; the compact leg
    // clamps through its `effective-selected()`.
    selected-stack: int,
    move-target: int, // stack index, −1 = no move flow
    // The stack-create flow's visible field (usability D7), open or
    // closed — board-level, not per column.
    stack-create-open: bool,
}

export component BoardView inherits FocusScope {
    in property <BoardModel> board;
    // The board bar's model + activation (design §3.8), threaded
    // window → view → layout.
    in property <BoardBarModel> board-bar;
    in property <[string]> board-segment-hint;
    in property <[string]> task-card-hint;
    // The stack.wider binding hint for the header tooltips (D18).
    in property <[string]> stack-header-hint;
    // The stack.create binding hint for the add-column tooltip (r2 D6).
    in property <[string]> stack-create-hint;
    // The task.create binding hint for the add-task ghost tooltips
    // (r3 D3).
    in property <[string]> task-create-hint;
    // The drag seams (round-1 D17), threaded window → view → layout.
    callback stack-width-press(int);
    callback stack-width-drag(int, float);
    callback stack-width-release(int);
    callback board-bar-activated(int);
    // The board-bar segment right-click (r2 D21).
    callback segment-context(int, float, float);
    callback task-activated(int, int);
    callback task-clicked(int, int);
    // The focus-loss settle (round-3 L1), threaded to the layout.
    callback text-flow-focus-lost();
    callback task-context(int, int, float, float);
    callback header-activated(int);
    callback switcher-activated(int);
    // The stack-header right-click (r2 D21), threaded window → view →
    // layout; the compact switcher reuses the same seam.
    callback header-context(int, float, float);
    // The stack card's bare-surface right-click (r3 D4).
    callback body-context(int, float, float);
    // The bare body's left-click select (r4 D3).
    callback body-activated(int);
    // The done checkbox's toggle (r3 D6).
    callback task-done-toggled(int, int);
    // The stack-rename field of one column (r2 D21).
    callback rename-committed(int, string);
    callback rename-edited(int, string);
    callback create-committed(int, string);
    callback create-edited(int, string);
    // The per-column Add Task ghost (r2 D8).
    callback add-task-activated(int);
    // The stack-create flow (usability D7): the on-board button and
    // the field's mirror/commit seams.
    callback new-stack-activated();
    // The empty-board preset CTA (r3 D5).
    callback board-default-preset-clicked();
    // The pointer drag-to-move seams (r2 chunk-8), threaded window →
    // view → layout; index-only, the D2 convention.
    callback card-drag-armed(int, int);
    callback drag-hovered(int);
    callback card-dropped(int);
    callback card-drag-finished(int, int, bool);
    // Any flow holds: the DragAreas refuse to arm (the XOR belt).
    in property <bool> flow-open: false;
    callback stack-create-committed(string);
    callback stack-create-edited(string);

    focus-on-tab-navigation: true;
    accessible-role: AccessibleRole.region;
    accessible-label: "Board";
    init => self.focus();

    // The D15 ring: every FocusScope renders its ring while it holds
    // focus — no keyboard-detection heuristics.
    ring := Rectangle {
        width: 100%;
        height: 100%;
        border-width: root.has-focus ? Theme.focus-ring-width : 0;
        border-color: Semantic.focus-ring;
        border-radius: Theme.radius-medium;

        VerticalLayout {
            spacing: Theme.space-2;

            BoardLayout {
                text-flow-focus-lost() => root.text-flow-focus-lost();
                stacks: root.board.stacks;
                selected-stack: root.board.selected-stack;
                flow-open: root.flow-open;
                board-card-drag-armed(c, r) => root.card-drag-armed(c, r);
                board-drag-hovered(c) => root.drag-hovered(c);
                board-card-dropped(c) => root.card-dropped(c);
                board-card-drag-finished(c, r, ok) => root.card-drag-finished(c, r, ok);
                move-target: root.board.move-target;
                stack-create-open: root.board.stack-create-open;
                board-bar: root.board-bar;
                board-segment-hint: root.board-segment-hint;
                task-card-hint: root.task-card-hint;
                stack-header-hint: root.stack-header-hint;
                stack-create-hint: root.stack-create-hint;
                task-create-hint: root.task-create-hint;
                stack-width-press(c) => root.stack-width-press(c);
                stack-width-drag(c, d) => root.stack-width-drag(c, d);
                stack-width-release(c) => root.stack-width-release(c);
                board-bar-activated(i) => root.board-bar-activated(i);
                segment-context(i, x, y) => root.segment-context(i, x, y);
                task-activated(c, r) => root.task-activated(c, r);
                task-clicked(c, r) => root.task-clicked(c, r);
                task-context(c, r, x, y) => root.task-context(c, r, x, y);
                header-activated(c) => root.header-activated(c);
                switcher-activated(c) => root.switcher-activated(c);
                header-context(c, x, y) => root.header-context(c, x, y);
                body-context(c, x, y) => root.body-context(c, x, y);
                body-activated(c) => root.body-activated(c);
                task-done-toggled(c, r) => root.task-done-toggled(c, r);
                rename-committed(c, t) => root.rename-committed(c, t);
                rename-edited(c, t) => root.rename-edited(c, t);
                create-committed(c, t) => root.create-committed(c, t);
                create-edited(c, t) => root.create-edited(c, t);
                add-task-activated(c) => root.add-task-activated(c);
                new-stack-activated() => root.new-stack-activated();
                board-default-preset-clicked() => root.board-default-preset-clicked();
                stack-create-committed(t) => root.stack-create-committed(t);
                stack-create-edited(t) => root.stack-create-edited(t);
            }
        }
    }
}
