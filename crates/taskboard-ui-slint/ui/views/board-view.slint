// SPDX-License-Identifier: AGPL-3.0-only
// The board view (L3, D22): the board state slice plus the action
// dispatchers — a thin owner of a BoardLayout. The scope focuses
// itself on mount (D15's programmatic-focus seam; conditional
// mounting creates the element, `init` grabs focus).

import { Theme, Semantic, Typography, RoleText, Tone } from "../theme.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
import { BoardLayout, StackColumnModel } from "../compositions/board-layout.slint";
import { BoardBarModel } from "../compositions/board-bar.slint";
// The board ceremony letter (O-5 parity chunk OP1, W-2/W-4/W-7): the
// informed-consent letters the armed ceremony strips mount.
import { BoardCeremonyLetter, CeremonyLetterModel, CeremonyLetterMode } from "../compositions/board-ceremony-letter.slint";

// The board model (D22): the kanban geometry. The board title renders
// in the toolbar (the window's `toolbar-title`), not in this model.
export struct BoardModel {
    stacks: [StackColumnModel],
    // The true selection (r2 D4): a stack index, or −1 when no stack
    // is explicitly selected (the move-target convention) — the
    // regular header paints only a real selection; the compact leg
    // clamps through its `effective-selected()`.
    selected-stack: int,
    move-target: int, // stack index, −1 = no move flow
    // The stack-create flow's visible field (usability D7), open or
    // closed — board-level, not per column.
    stack-create-open: bool,
    // The armed-delete strip's typed fact (UX R-2 D-2, #784): the
    // armed `Flow::ConfirmDelete` stack indexed into this pass's
    // columns, or −1 (the move-target convention) when nothing is
    // armed. Drives the per-column strip flag; read by the seam
    // tests.
    delete-armed-stack: int,
}

export component BoardView inherits FocusScope {
    // The severing cap (J4 US-3 AC-2; the task-view precedent): the
    // root's layout merge must never bound the OS window's max width.
    max-width: Theme.layout-severing-max-width;
    in property <BoardModel> board;
    // The board bar's model + activation (design §3.8), threaded
    // window → view → layout.
    in property <BoardBarModel> board-bar;
    in property <[string]> board-segment-hint;
    in property <[string]> task-card-hint;
    // The stack.wider binding hint for the header tooltips (D18).
    in property <[string]> stack-header-hint;
    // The stack.create binding hint for the add-column tooltip (r2 D6).
    in property <[string]> stack-create-hint;
    // The task.create binding hint for the add-task ghost tooltips
    // (r3 D3).
    in property <[string]> task-create-hint;
    // The drag seams (round-1 D17), threaded window → view → layout.
    callback stack-width-press(int);
    callback stack-width-drag(int, float);
    callback stack-width-release(int);
    callback board-bar-activated(int);
    // The archived-boards roster's row activation (UX R-1 D-1, #785),
    // threaded through to the window's unarchive seam.
    callback board-bar-archived-activated(int);
    // The board-bar segment right-click (r2 D21).
    callback segment-context(int, float, float);
    callback task-activated(int, int);
    callback task-clicked(int, int);
    // The focus-loss settle (round-3 L1), threaded to the layout.
    callback text-flow-focus-lost();
    // The dead-zone click-out (#1543), threaded layout → window —
    // the layout's layers fire it; the window's seam settles.
    callback board-dead-zone-clicked();
    callback task-context(int, int, float, float);
    callback header-activated(int);
    callback switcher-activated(int);
    // The stack-header right-click (r2 D21), threaded window → view →
    // layout; the compact switcher reuses the same seam.
    callback header-context(int, float, float);
    // The stack card's bare-surface right-click (r3 D4).
    callback body-context(int, float, float);
    // The bare body's left-click select (r4 D3).
    callback body-activated(int);
    // The done checkbox's toggle (r3 D6).
    callback task-done-toggled(int, int);
    // slint: task-track-toggled (UX-R8 chunk-5 D-6): the card
    // control's forward.
    callback task-track-toggled(int, int);
    // The armed multi-delete strip's fact + pair (UX-R8 chunk-5 D-9,
    // #882): the count caption (−1 disarmed), the #784 grammar's
    // third instance.
    in property <int> task-multi-delete-armed;
    callback task-multi-delete-confirmed();
    callback task-multi-delete-cancelled();
    // The stack-rename field of one column (r2 D21).
    callback rename-committed(int, string);
    callback rename-edited(int, string);
    callback create-committed(int, string);
    callback create-edited(int, string);
    // The per-column Add Task ghost (r2 D8).
    callback add-task-activated(int);
    // The stack-create flow (usability D7): the on-board button and
    // the field's mirror/commit seams.
    callback new-stack-activated();
    // The empty-board preset CTA (r3 D5).
    callback board-default-preset-clicked();
    // The armed-delete strip's facts + pair (UX R-2 D-2, #784): the
    // board strip mounts in the board-bar region when the view
    // state's `Flow::ConfirmDelete` arms the board; Confirm routes
    // the exact verb, Cancel disarms. The stack strip threads
    // per-column through the layout (the recur stop-strip grammar).
    in property <bool> board-delete-armed;
    callback board-delete-confirmed();
    callback board-delete-cancelled();
    callback stack-delete-confirmed(int);
    callback stack-delete-cancelled(int);
    // The armed ceremony letter's fact + pair (OP1, W-2/W-4/W-7): the
    // letter's mode gates the mount (archive caption / reset counts /
    // reconcile preview / pending); Confirm routes the armed verb,
    // Cancel disarms — the board-delete strip's grammar, one pair for
    // the three ceremonies (the armed subject is surface-wide).
    in property <CeremonyLetterModel> ceremony-letter;
    // slint: board-ceremony-confirmed (OP1 W-1/W-3/W-6): the strip's
    // confirm seam — routes the armed verb (click ≡ key).
    callback board-ceremony-confirmed();
    // slint: board-ceremony-cancelled (OP1 W-1/W-3/W-6): the strip's
    // disarm — nothing dispatched.
    callback board-ceremony-cancelled();
    // The pointer drag-to-move seams (r2 chunk-8), threaded window →
    // view → layout; index-only, the D2 convention.
    callback card-drag-armed(int, int);
    callback drag-hovered(int);
    callback card-dropped(int);
    // The gap drop grammar (UX-R8 D-2, US-2): the gap-zone reports,
    // threaded to the window's seams (the drag family's pattern).
    callback gap-hovered(int, int);
    callback gap-dropped(int, int);
    // The modifier-click grammar (UX-R8 D-5): threaded to the
    // window's seam (the click family's pattern).
    callback task-clicked-modifiers(int, int, bool, bool);
    // The compact segment drop grammar (UX-R8 D-3, US-3): threaded
    // to the window's seams (the drag family's pattern).
    callback switcher-drop-hovered(int);
    callback switcher-card-dropped(int);
    callback card-drag-finished(int, int, bool);
    // Any flow holds: the DragAreas refuse to arm (the XOR belt).
    in property <bool> flow-open: false;
    callback stack-create-committed(string);
    callback stack-create-edited(string);

    focus-on-tab-navigation: true;
    accessible-role: AccessibleRole.region;
    accessible-label: "Board";
    init => self.focus();

    // The D15 ring: every FocusScope renders its ring while it holds
    // focus — no keyboard-detection heuristics.
    ring := Rectangle {
        width: 100%;
        height: 100%;
        border-width: root.has-focus ? Theme.focus-ring-width : 0;
        border-color: Semantic.focus-ring;
        border-radius: Theme.radius-medium;

        VerticalLayout {
            spacing: Theme.space-2;

            // The armed board-delete strip (UX R-2 D-2): the
            // board-bar region's consequence strip — board delete
            // cascades, and the strip names it. Compact keeps the
            // strip (the keyboard twin is reachable there too).
            if (root.board-delete-armed): HorizontalLayout {
                spacing: Theme.space-2;
                RoleText {
                    role: Typography.caption;
                    text-color: Semantic.danger;
                    text: "Deletes this board and all its stacks and tasks.";
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                IconButton {
                    icon: IconKind.check;
                    tone: Tone.danger;
                    label: "Confirm delete board";
                    clicked => root.board-delete-confirmed();
                }
                IconButton {
                    icon: IconKind.remove;
                    tone: Tone.neutral;
                    label: "Cancel delete board";
                    clicked => root.board-delete-cancelled();
                }
            }

            // The armed ceremony letter (OP1, W-2/W-4/W-7): the
            // board-bar region's informed-consent strip — the letter's
            // mode gates the mount; the Confirm/Cancel pair routes
            // through the window seams (the board-delete strip's
            // grammar, one pair for the three ceremonies).
            if (root.ceremony-letter.mode != CeremonyLetterMode.none): BoardCeremonyLetter {
                letter: root.ceremony-letter;
                confirmed => root.board-ceremony-confirmed();
                cancelled => root.board-ceremony-cancelled();
            }

            // The armed multi-delete strip (UX-R8 chunk-5 D-9, #882):
            // the board-bar region's consequence strip — the member
            // count names what the confirm deletes (the #784 grammar's
            // third instance beside the stack/board strips).
            if (root.task-multi-delete-armed >= 0): HorizontalLayout {
                spacing: Theme.space-2;
                RoleText {
                    role: Typography.caption;
                    text-color: Semantic.danger;
                    text: "Deletes " + root.task-multi-delete-armed + " selected tasks.";
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                IconButton {
                    icon: IconKind.check;
                    tone: Tone.danger;
                    label: "Confirm delete tasks";
                    clicked => root.task-multi-delete-confirmed();
                }
                IconButton {
                    icon: IconKind.remove;
                    tone: Tone.neutral;
                    label: "Cancel delete tasks";
                    clicked => root.task-multi-delete-cancelled();
                }
            }

            BoardLayout {
                text-flow-focus-lost() => root.text-flow-focus-lost();
                board-dead-zone-clicked() => root.board-dead-zone-clicked();
                stacks: root.board.stacks;
                selected-stack: root.board.selected-stack;
                flow-open: root.flow-open;
                board-card-drag-armed(c, r) => root.card-drag-armed(c, r);
                board-drag-hovered(c) => root.drag-hovered(c);
                board-card-dropped(c) => root.card-dropped(c);
                board-gap-hovered(c, g) => root.gap-hovered(c, g);
                board-gap-dropped(c, g) => root.gap-dropped(c, g);
                switcher-drop-hovered(c) => root.switcher-drop-hovered(c);
                switcher-card-dropped(c) => root.switcher-card-dropped(c);
                board-card-drag-finished(c, r, ok) => root.card-drag-finished(c, r, ok);
                move-target: root.board.move-target;
                stack-create-open: root.board.stack-create-open;
                board-bar: root.board-bar;
                board-segment-hint: root.board-segment-hint;
                task-card-hint: root.task-card-hint;
                stack-header-hint: root.stack-header-hint;
                stack-create-hint: root.stack-create-hint;
                task-create-hint: root.task-create-hint;
                stack-width-press(c) => root.stack-width-press(c);
                stack-width-drag(c, d) => root.stack-width-drag(c, d);
                stack-width-release(c) => root.stack-width-release(c);
                board-bar-activated(i) => root.board-bar-activated(i);
                board-bar-archived-activated(i) => root.board-bar-archived-activated(i);
                segment-context(i, x, y) => root.segment-context(i, x, y);
                task-activated(c, r) => root.task-activated(c, r);
                task-clicked(c, r) => root.task-clicked(c, r);
                task-clicked-modifiers(c, r, sh, ct) => root.task-clicked-modifiers(c, r, sh, ct);
                task-context(c, r, x, y) => root.task-context(c, r, x, y);
                header-activated(c) => root.header-activated(c);
                switcher-activated(c) => root.switcher-activated(c);
                header-context(c, x, y) => root.header-context(c, x, y);
                body-context(c, x, y) => root.body-context(c, x, y);
                body-activated(c) => root.body-activated(c);
                task-done-toggled(c, r) => root.task-done-toggled(c, r);
                task-track-toggled(c, r) => root.task-track-toggled(c, r);
                rename-committed(c, t) => root.rename-committed(c, t);
                rename-edited(c, t) => root.rename-edited(c, t);
                create-committed(c, t) => root.create-committed(c, t);
                create-edited(c, t) => root.create-edited(c, t);
                add-task-activated(c) => root.add-task-activated(c);
                new-stack-activated() => root.new-stack-activated();
                board-default-preset-clicked() => root.board-default-preset-clicked();
                stack-create-committed(t) => root.stack-create-committed(t);
                stack-create-edited(t) => root.stack-create-edited(t);
                stack-delete-confirmed(c) => root.stack-delete-confirmed(c);
                stack-delete-cancelled(c) => root.stack-delete-cancelled(c);
            }
        }
    }
}
