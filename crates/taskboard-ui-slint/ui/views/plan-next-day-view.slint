// SPDX-License-Identifier: AGPL-3.0-only
// The plan-next-day surface (#622, D-1/D-3): the wave's only
// interactive editing workspace — two panes, tomorrow's placed boxes
// first (the day shape), then the candidate pool (carried misses
// included, marked by their own overdue tint). Placement is
// pick → place: activating a pool row arms the inline form (time of
// day + optional effort — no arithmetic, R-6); a placement routes one
// scheduled/effort edit through the adapter's commit funnel. Reorder
// swaps a box's start instant with the temporal neighbor's; the
// instant set is invariant, so ties render honestly in the pushed
// order. Slint computes nothing (the dumb-client line): every phrase
// arrives derived in the row model.
import { Theme, Semantic, RoleText, Typography } from "../theme.slint";
import { TaskCard, TaskCardModel } from "../widgets/task-card.slint";
import { EmptyState } from "../widgets/empty-state.slint";
import { TextField } from "../widgets/text-field.slint";
import { PressableRow } from "../widgets/pressable-row.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";

export struct PlanRowModel {
    card: TaskCardModel,
    // The placed pane's time-of-day phrase ("09:30"); empty on pool
    // rows.
    time: string,
    // The effort phrase, empty when absent.
    effort: string,
    // The carried misses' overdue tint (the card's own decoration
    // communicates the miss).
    overdue: bool,
    // The K4 walk cursor's armed bit (US-15, #1041): exactly one row
    // of the focused pane carries it while armed (the armed styling).
    cursor: bool,
}

export struct PlanModel {
    boxes: [PlanRowModel],
    pool: [PlanRowModel],
    // The placement form is armed (the `Flow::PlanPlace` mirror).
    placing: bool,
    // The focused pane (J3 R-5, round 9 chunk 9): 0 = placed boxes,
    // 1 = candidate pool — the directional pane switch's mirror; the
    // focused pane's heading renders in the primary tone.
    focus-pane: int,
}

export component PlanNextDayView inherits FocusScope {
    in property <PlanModel> plan;
    // The placement form's two text mirrors (adapter-held; D9 rule
    // 1): separate one-way slots the pass never touches — a refresh
    // must never clobber a field the user is typing into.
    in property <string> time-text;
    in property <string> effort-text;
    // slint: property — the mount-focus gate (#1036): the standalone
    // surface keeps the default `true` (byte-identical init grab);
    // the walk embed (#716's stage-3 mount) sets `false` so the
    // planner never steals the walk dialog's initial focus at mount —
    // it still receives focus deliberately (Tab into the body keeps
    // `focus-on-tab-navigation`), it just never grabs it on init.
    in property <bool> take-focus-on-init: true;
    callback box-activated(int);
    callback pool-activated(int);
    callback box-earlier(int);
    callback box-later(int);
    callback box-remove(int);
    callback time-edited(string);
    callback effort-edited(string);
    callback place-commit();
    callback place-cancel();

    focus-on-tab-navigation: true;
    accessible-role: AccessibleRole.region;
    accessible-label: "Plan next day";
    init => {
        if (root.take-focus-on-init) {
            self.focus();
        }
    }
    // The severing cap (J4 US-3 AC-2; the task-view precedent): the
    // root's layout merge must never bound the OS window's max width
    // — the empty EmptyState mount would otherwise collapse it.
    max-width: Theme.layout-severing-max-width;

    ring := Rectangle {
        width: 100%;
        height: 100%;
        border-width: root.has-focus ? Theme.focus-ring-width : 0;
        border-color: Semantic.focus-ring;
        border-radius: Theme.radius-medium;

        Flickable {
            content := VerticalLayout {
                padding: Theme.space-3;
                spacing: Theme.space-3;

                // The placed boxes first (P4: the day is blocks with
                // starts). Empty collapses.
                if (root.plan.boxes.length > 0): pane := VerticalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.space-1;

                    RoleText {
                        role: Typography.caption;
                        text: "Placed";
                        vertical-alignment: center;
                        // The focused pane's heading tone (J3 R-5).
                        text-color: root.plan.focus-pane == 0
                            ? Theme.text-primary
                            : Theme.text-secondary;
                    }
                    for box[bindex] in root.plan.boxes: box-row := HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: Theme.space-2;

                        // The centralized pressable-row grammar
                        // (#1350): the a11y triple + the guarded
                        // Return/Space + the focus ring ride the
                        // widget; the K4 armed cursor tint stays the
                        // wrapper's background (`tint`).
                        box-activate := PressableRow {
                            label: "Box " + box.card.title;
                            tint: box.cursor ? Theme.surface-hover : transparent;
                            hover-tint: false;
                            pointer-cursor: false;
                            activated => { root.box-activated(bindex); }
                            box-row-card := TaskCard {
                                model: box.card;
                            }
                        }
                        VerticalLayout {
                            vertical-stretch: 0;
                            alignment: center;
                            spacing: 0;

                            RoleText {
                                role: Typography.caption;
                                text: box.time;
                                vertical-alignment: center;
                            }
                            RoleText {
                                role: Typography.caption;
                                text-color: Theme.text-secondary;
                                text: box.effort;
                                vertical-alignment: center;
                            }
                        }
                        // The row verbs (D-6): no preset bindings, the
                        // affordance is the invocation (the tracked-row
                        // activation shape — the AT default action is
                        // the click equivalence). Tab stops since #665:
                        // a box's walk is activate → earlier → later →
                        // remove, then the next box.
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: Theme.space-1;
                            alignment: end;

                            // The shared icon-button grammar
                            // (#1350): the canonical square, the
                            // drawn glyph, the guarded key half, the
                            // hover lift — the hand-rolled twin dies.
                            earlier-hit := IconButton {
                                icon: IconKind.chevron-up;
                                label: "Move box earlier";
                                clicked => { root.box-earlier(bindex); }
                            }
                            later-hit := IconButton {
                                icon: IconKind.chevron-down;
                                label: "Move box later";
                                clicked => { root.box-later(bindex); }
                            }
                            remove-hit := IconButton {
                                icon: IconKind.remove;
                                label: "Remove box";
                                clicked => { root.box-remove(bindex); }
                            }
                        }
                    }
                }

                // The candidate pool: the pickable pool (carried
                // misses included, overdue-tinted). Empty collapses.
                if (root.plan.pool.length > 0): pool-pane := VerticalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.space-1;

                    RoleText {
                        role: Typography.caption;
                        text: "Candidates";
                        vertical-alignment: center;
                        // The focused pane's heading tone (J3 R-5).
                        text-color: root.plan.focus-pane == 1
                            ? Theme.text-primary
                            : Theme.text-secondary;
                    }
                    for pool-row[pindex] in root.plan.pool: pool-item := HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: Theme.space-1;
                        // The carried misses' accent (the card's own
                        // overdue decoration communicates the miss;
                        // this is the pane-level echo).
                        Rectangle {
                            width: Theme.focus-ring-width;
                            height: pool-card.preferred-height;
                            background: pool-row.overdue ? Semantic.overdue : transparent;
                            border-radius: Theme.radius-small;
                        }
                        // The K4 walk cursor's armed styling (US-15,
                        // #1041): the walked row's hover tint — the
                        // same affordance class the rule cursor
                        // renders (the overdue accent above stays
                        // independent).
                        Rectangle {
                            width: Theme.focus-ring-width;
                            height: pool-card.preferred-height;
                            background: pool-row.cursor ? Semantic.focus-ring : transparent;
                            border-radius: Theme.radius-small;
                        }
                        // The centralized pressable-row grammar
                        // (#1350) over the pool card.
                        pool-hit := PressableRow {
                            label: "Place " + pool-row.card.title;
                            hover-tint: false;
                            activated => { root.pool-activated(pindex); }
                            pool-card := TaskCard {
                                model: pool-row.card;
                            }
                        }
                    }
                }

                // The placement form (the TrackEntryForm tenant): a
                // time of day plus an optional effort — the date is
                // pinned to tomorrow (no horizon beyond the next
                // day, §5.2).
                if (root.plan.placing): form := VerticalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.space-2;

                    RoleText {
                        role: Typography.caption;
                        text: "Place tomorrow — time of day, optional effort";
                        vertical-alignment: center;
                    }
                    TextField {
                        placeholder: "09:30";
                        label: "Time";
                        initial-text: root.time-text;
                        accepted(_) => { root.place-commit(); }
                        edited(t) => { root.time-edited(t); }
                    }
                    TextField {
                        placeholder: "30, 1h30m…";
                        label: "Effort (optional)";
                        initial-text: root.effort-text;
                        accepted(_) => { root.place-commit(); }
                        edited(t) => { root.effort-edited(t); }
                    }
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "Enter places · Escape steps back";
                        vertical-alignment: center;
                    }
                }

                if (root.plan.boxes.length == 0 && root.plan.pool.length == 0
                    && !root.plan.placing): EmptyState {
                    text: "Tomorrow is empty";
                    hint: "Pick from the pool once tomorrow has candidates.";
                }
            }
        }
    }
}
