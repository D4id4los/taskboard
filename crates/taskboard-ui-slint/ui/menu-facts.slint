// The menu panel's rendering facts (round-1 D4): the journeys'
// containment seam. A separate global because the panel lives in a
// conditional element the window cannot name — the panel mirrors its
// realized geometry here through `changed` handlers (the row-selection
// mirror precedent); values are stale while the menu is closed.

export global MenuPanelFacts {
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> width;
    in-out property <length> height;
    // The fly-out's facts (round-1 D6): written by the instance
    // mounted as the fly-out only (`is-flyout`), defaults while closed.
    in-out property <length> flyout-x;
    in-out property <length> flyout-y;
    in-out property <length> flyout-width;
    in-out property <length> flyout-height;
}

// The date-picker overlay's facts (round-3 D10): the same seam as the
// menu panel above — the TaskView lives in a conditional element the
// window cannot name, so the mounted editor mirrors its field row's
// realized window-space geometry here through `changed` handlers;
// values are stale while no editor is open (the overlay's mount
// condition — the model's `date-picker-open` — is the window's own
// read, so staleness never renders).
export global DatePickerFacts {
    in-out property <length> anchor-x;
    in-out property <length> anchor-y;
    in-out property <length> anchor-width;
    in-out property <length> anchor-height;
    // The picker overlay's anchor (the M2 mount's read, #1206): the
    // editor overlay host's realized window-space panel rect, mirrored
    // by the AnchorMirror at the M1 mount site (the #954 idiom on the
    // host's `panel-*` out seams). The two-stage flow's re-anchor law:
    // the picker must anchor to the *editor panel*, never the closed
    // cell — with the host's G-2 law the field stays visible by
    // construction. Stale while the editor is closed (the mirror only
    // exists on the M1 mount) — harmless, the picker cannot open
    // before the editor is realized.
    in-out property <length> picker-anchor-x;
    in-out property <length> picker-anchor-y;
    in-out property <length> picker-anchor-width;
    in-out property <length> picker-anchor-height;
}

// The timers setter popover's facts (r4 D33): the DatePickerFacts
// twin — the header button lives inside the today view's conditional
// section the window cannot name, so the button mirrors its realized
// window-space geometry here through `changed` handlers; values are
// stale while the section is unmounted, and the popover's mount
// condition is the window's own `timer-setter-open`.
export global TimerSetterFacts {
    in-out property <length> anchor-x;
    in-out property <length> anchor-y;
    in-out property <length> anchor-width;
    in-out property <length> anchor-height;
}

// The habit quota popover's facts (W-5, #961): the TimerSetterFacts
// twin — the row's progress-phrase button lives inside the habits
// section's delegates the window cannot name, so the clicked row's
// button mirrors its realized window-space geometry here through the
// AnchorMirror (the #954 idiom); values are stale while the popover
// is closed, and the popover's mount condition is the window's own
// `habits-quota-open`.
export global HabitQuotaFacts {
    in-out property <length> anchor-x;
    in-out property <length> anchor-y;
    in-out property <length> anchor-width;
    in-out property <length> anchor-height;
}

// The habit pause editor's facts (D3a W-7, #1208): the
// HabitQuotaFacts twin — the section-level inline editor lives in
// the habits section's conditional the window cannot name, so the
// editor mirrors its realized window-space rect here through the
// AnchorMirror (the #954 idiom); values are stale while the editor
// is closed, and the light-dismiss strips' mount condition is the
// window's own `habits-pause-open`.
export global HabitPauseFacts {
    in-out property <length> anchor-x;
    in-out property <length> anchor-y;
    in-out property <length> anchor-width;
    in-out property <length> anchor-height;
}
