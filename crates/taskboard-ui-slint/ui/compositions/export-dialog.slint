// SPDX-License-Identifier: AGPL-3.0-only
// The export dialog (the J2 export plan W-1–W-5): the settings/menu-
// anchored front over the CLI `export` verb's grammar — family,
// format, the since/until/task/board filters, the pdf leg's typed
// layout + destination + open-after-export, and the typed outcome
// area. A dumb client: every field's text/validity and the outcome
// ride the pushed model (the recur-editor contract — the widget never
// holds state); every edit mirrors up the moment it happens.
//
// D-4: without the pdf-export feature the pdf leg's controls render
// DISABLED with an honest caption — the flag (`model.pdf-available`)
// is the only oracle; the caption is never asserted.
//
// D-2/D-3 destination semantics: the field pre-fills EMPTY; the
// placeholder carries the config default home; an empty field mints
// `out: None` and the engine resolves the config default (the dated
// file name is engine-derived at run time — the module doc's
// rationale).

import { Theme, Typography, RoleText, Semantic } from "../theme.slint";
import { TextButton } from "../widgets/text-button.slint";
import { TippedField } from "../widgets/tipped-field.slint";
import { TextField, FieldValidity } from "../widgets/text-field.slint";
import { SegmentedControl } from "../widgets/segmented-control.slint";
import { CheckBox } from "../widgets/check-box.slint";

// The refusal labels (#1190): one static table, indexed by the
// model's typed refusal index (the canonical REFUSAL_KINDS order the
// adapter docs — recognition over recall). The structural pin in the
// journey corpus keeps this table's length equal to the canonical
// table's; the label text itself is presentation and never asserted.
export global ExportRefusalLabels {
    in property <[string]> kinds: [
        "this build cannot write pdf (the pdf-export feature is off)",
        "the filters do not apply to this export family",
        "the chosen options do not apply to this export family",
        "the task filter matched nothing",
        "the board filter matched nothing",
        "the pdf layout name is not one this build knows",
        "the destination path could not be opened for writing",
        "the pdf renderer failed while writing the sheet",
        "the destination refused the write",
        "a lane fell outside the presentation cap and was dropped",
        "the export engine refused the run",
        "the clipboard is not available in this environment",
    ];
}

// The dialog's pushed model (the recur-editor shape): the pickers'
// typed indices, the fields' verbatim text, the enabled/busy/outcome
// folds. Index contracts (documented once, mapped at the adapter):
// family 0/1 = Tracking/Pdf; format 0/1 = Csv/Json; layout 0..4 =
// Fold/A4/A5/A6; outcome-kind 0/1/2 = none/written/refused;
// refusal -1 = none, else the canonical kind order the adapter docs.
export struct ExportDialogModel {
    family: int,
    format: int,
    layout: int,
    since: string,
    since-validity: FieldValidity,
    until: string,
    until-validity: FieldValidity,
    task: string,
    board: string,
    destination: string,
    destination-placeholder: string,
    open-after: bool,
    pdf-available: bool,
    busy: bool,
    run-enabled: bool,
    outcome-kind: int,
    outcome-path: string,
    refusal: int,
    // -- the preview/clipboard lane (the D2 preview plan W-1..W-4) --
    // The D-5 family-gating fold: the preview/copy controls and the
    // pane render on the csv/json family pick only (a fold flag,
    // never hidden lanes; the verbs are undefined for pdf, so the
    // gated posture is absence, not disabled).
    preview-enabled: bool,
    // The per-affordance busy flags (D-4: the preview button, the
    // copy button and the Run button each hold their own).
    preview-busy: bool,
    copy-busy: bool,
    // The pane's settled facts (W-3): shown = a payload landed;
    // truncated = the typed presentation-cap fact (D-2); refusal -1 =
    // none, else the canonical ExportRefusal index.
    preview-settled: bool,
    preview-shown: bool,
    preview-text: string,
    preview-truncated: bool,
    preview-refusal: int,
    // The clipboard outcome's fold (W-3's twin): settled = a Copied
    // fact or refusal landed; it folds its own caption pair below the
    // run outcome area, never the run outcome's kind/path fields.
    copy-settled: bool,
    copy-bytes: int,
    copy-refusal: int,
}

export component ExportDialog inherits Rectangle {
    in property <ExportDialogModel> model;

    // The edit mirrors (W-3/W-4): every pick/edit rides up the moment
    // it happens; the adapter owns the buffer (one truth).
    // slint: export-spec-picked
    callback spec-picked(int, int);
    // slint: export-field-edited
    callback field-edited(int, string);
    // slint: export-open-after-toggled
    callback open-after-toggled();
    // slint: export-run-clicked
    callback run-clicked();
    // slint: export-preview-clicked — the W-1 Preview dispatch.
    callback export-preview-requested();
    // slint: export-copy-clicked — the W-2 Copy dispatch.
    callback export-copy-requested();
    // slint: export-dialog-close
    callback close-clicked();

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-2;

        // -- The family picker (W-3) --
        SegmentedControl {
            options: ["Tracking", "Pdf today sheet"];
            selected-index: root.model.family;
            group-label: "Data family";
            picked(index) => root.spec-picked(0, index);
        }

        // -- The tracking leg: format + filters + destination (D-3) --
        if (root.model.family == 0): VerticalLayout {
            spacing: Theme.space-2;
            SegmentedControl {
                options: ["CSV", "JSON"];
                selected-index: root.model.format;
                group-label: "Format";
                picked(index) => root.spec-picked(1, index);
            }
            TippedField {
                label: "Since (UTC date)";
                help: "Only entries starting on/after this day; empty = no filter.";
                placeholder: "2026-11-01";
                initial-text: root.model.since;
                validity: root.model.since-validity;
                selected-on-focus: true;
                edited(text) => root.field-edited(0, text);
                accepted(text) => root.field-edited(0, text);
            }
            TippedField {
                label: "Until (UTC date)";
                help: "Only entries starting on/before this day; empty = no filter.";
                placeholder: "2026-11-21";
                initial-text: root.model.until;
                validity: root.model.until-validity;
                selected-on-focus: true;
                edited(text) => root.field-edited(1, text);
                accepted(text) => root.field-edited(1, text);
            }
            TippedField {
                label: "Task filter";
                help: "A task uuid, a unique 8+ character prefix, or an exact live title; empty = all tasks.";
                initial-text: root.model.task;
                selected-on-focus: true;
                edited(text) => root.field-edited(2, text);
                accepted(text) => root.field-edited(2, text);
            }
            TippedField {
                label: "Board filter";
                help: "A board uuid or an exact live board title; empty = all boards.";
                initial-text: root.model.board;
                selected-on-focus: true;
                edited(text) => root.field-edited(3, text);
                accepted(text) => root.field-edited(3, text);
            }
            TippedField {
                label: "Destination file";
                help: "Where the file is written; empty = the export dir's default (dated file name).";
                placeholder: root.model.destination-placeholder;
                initial-text: root.model.destination;
                selected-on-focus: true;
                edited(text) => root.field-edited(4, text);
                accepted(text) => root.field-edited(4, text);
            }
            // -- The preview/clipboard controls (W-1/W-2): D-5's
            //    family gating renders them on the csv/json leg only;
            //    the busy flags are per-affordance (D-4). --
            HorizontalLayout {
                spacing: Theme.space-3;
                TextButton {
                    label: "Preview";
                    enabled: !root.model.preview-busy && !root.model.busy;
                    clicked => root.export-preview-requested();
                }
                TextButton {
                    label: "Copy";
                    enabled: !root.model.copy-busy && !root.model.busy;
                    clicked => root.export-copy-requested();
                }
            }
            // The read-only pane (W-3): the engine's payload verbatim
            // (the one-generator-two-sinks law); over-cap payloads
            // carry the typed `truncated` fact (D-2).
            if (root.model.preview-shown): VerticalLayout {
                spacing: Theme.space-1;
                RoleText {
                    role: Typography.caption;
                    text-color: Theme.text-secondary;
                    text: root.model.preview-truncated
                        ? "The preview is capped; the file and the clipboard carry the full payload."
                        : "The full payload.";
                    wrap: word-wrap;
                }
                RoleText {
                    role: Typography.caption;
                    text: root.model.preview-text;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }
        }

        // -- The pdf leg: layout + destination + open-after (D-2) --
        if (root.model.family == 1): VerticalLayout {
            spacing: Theme.space-2;
            // D-4: the pdf controls' enabled gate is the model flag —
            // a build without the feature renders them disabled with
            // the honest caption below.
            SegmentedControl {
                options: ["Fold (A4 → A6 booklet)", "A4", "A5", "A6"];
                selected-index: root.model.layout;
                group-label: "Print layout";
                segment-enabled: [
                    root.model.pdf-available, root.model.pdf-available,
                    root.model.pdf-available, root.model.pdf-available,
                ];
                picked(index) => root.spec-picked(2, index);
            }
            // The bare TextField (not the TippedField pair): the
            // D-4 disabled arm needs the read-only gate, which the
            // tipped wrapper does not forward.
            TextField {
                label: "Destination file";
                description: "Where the pdf is written; empty = the configured pdf dir's default (dated file name).";
                placeholder: root.model.destination-placeholder;
                initial-text: root.model.destination;
                read-only: !root.model.pdf-available;
                selected-on-focus: true;
                edited(text) => root.field-edited(4, text);
                accepted(text) => root.field-edited(4, text);
            }
            CheckBox {
                checked: root.model.open-after && root.model.pdf-available;
                focusable: root.model.pdf-available;
                checked-label: "Open in the system viewer after export";
                unchecked-label: "Open in the system viewer after export";
                toggled => {
                    if (root.model.pdf-available) {
                        root.open-after-toggled();
                    }
                }
            }
            if (!root.model.pdf-available): RoleText {
                role: Typography.caption;
                text-color: Theme.text-secondary;
                text: "The pdf today sheet is not part of this build (the pdf-export feature is off); the tracking exports below its family are unaffected.";
            }
        }

        // -- The busy posture (D-5): display only; the Run gate's
        //    disable rides the host's button model --
        if (root.model.busy): RoleText {
            role: Typography.caption;
            text-color: Theme.text-secondary;
            text: "Running the export…";
        }

        // -- The outcome area (W-5): the typed outcome's fold — the
        //    written file fact or the refusal kind. Display only; the
        //    refusal stays mounted with the filter state intact. --
        if (root.model.outcome-kind == 1): RoleText {
            role: Typography.caption;
            text-color: Semantic.success;
            text: "Written: " + root.model.outcome-path;
            overflow: elide;
        }
        if (root.model.outcome-kind == 2): RoleText {
            role: Typography.caption;
            text-color: Semantic.danger;
            text: "The export refused: " + ExportRefusalLabels.kinds[root.model.refusal] + "; the filters are intact — correct the failing field and run again.";
            overflow: elide;
        }
        // The clipboard outcome's fold (the preview plan W-3's twin):
        // the copied-byte fact or the typed refusal; the dialog stays
        // mounted with its filter state intact on any refusal (D-3).
        if (root.model.copy-settled && root.model.copy-refusal < 0): RoleText {
            role: Typography.caption;
            text-color: Semantic.success;
            text: "Copied to the clipboard.";
            overflow: elide;
        }
        if (root.model.copy-settled && root.model.copy-refusal >= 0): RoleText {
            role: Typography.caption;
            text-color: Semantic.danger;
            text: "The copy refused: " + ExportRefusalLabels.kinds[root.model.copy-refusal] + "; the filters are intact.";
            overflow: elide;
        }
        // The preview's typed refusal fold (US-1/S4): filter state
        // intact; re-Preview after correcting the failing field.
        if (root.model.preview-refusal >= 0): RoleText {
            role: Typography.caption;
            text-color: Semantic.danger;
            text: "The preview refused: " + ExportRefusalLabels.kinds[root.model.preview-refusal] + "; the filters are intact.";
            overflow: elide;
        }
    }
}
