// SPDX-License-Identifier: AGPL-3.0-only
// The task-editor rule-list composition (chunk 6, D12): one row per
// reminder rule (the offset in the canonical text form, the created
// stamp, a remove affordance), the derived-fact hint, and the add
// affordance (preset chips plus a custom offset entry). Indices
// resolve against the refresh pass's id tables — no ids cross the
// seam (D2). A parse-missed custom entry dispatches nothing: the
// adapter absorbs it (the CLI owns typed failures, D12).

import { Theme, Typography, Semantic, RoleText } from "../theme.slint";
import { FieldValidity } from "../widgets/text-field.slint";
import { TippedField } from "../widgets/tipped-field.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
import { ActivationStop } from "../widgets/activation-stop.slint";
import { TooltipState } from "../widgets/tooltip.slint";

// One rule row: the offset text form and the created stamp — display
// strings only (D12: ids stay in the adapter's tables).
export struct RuleRowModel {
    // The kind-specific primary line (r4 D30): the authored offset, the
    // live countdown, or the needs-a-due-date copy.
    before: string,
    created: string,
    // The secondary line: the effective fire instant / the fixed local
    // fire time; empty where the state has none.
    detail: string,
    // The armed bit (derived in the projection, never stored): false
    // shows the jump-to-due affordance.
    armed: bool,
}

// One preset chip (r4 D18): the chip body's activation stop is a
// real tab stop with Return/Space activation onto the same
// `add-preset-clicked` seam the TouchArea clicks, the focus ring on
// the chip border, and the activation publish — the shared
// ActivationStop grammar (the chip keeps its own token floor pin).
component PresetChip inherits Rectangle {
    in property <string> label;
    in property <int> chip-index;
    callback chip-clicked(int);
    border-radius: Theme.radius-small;
    border-width: Theme.focus-ring-width;
    border-color: chip-focus.has-focus || touch.has-hover
        ? Semantic.focus-ring
        : Theme.text-secondary;
    min-height: Theme.space-5;
    min-width: Theme.space-6;
    chip-focus := ActivationStop {
        width: 100%;
        height: 100%;
        stop-label: root.label;
        stop-description: "Adds this reminder offset.";
        stop-id: 90 + root.chip-index;
        activated => { root.chip-clicked(root.chip-index); }
    }
    touch := TouchArea {
        // The tooltip arm (blanket rule a): the chip's label is the
        // a11y label verbatim.
        changed has-hover => {
            if (self.has-hover) {
                TooltipState.hover(
                    root.label,
                    "Adds this reminder offset.",
                    [],
                    self.absolute-position.x,
                    self.absolute-position.y,
                    self.width,
                    self.height,
                );
            } else {
                TooltipState.unhover();
            }
        }
        clicked => {
            TooltipState.unhover();
            root.chip-clicked(root.chip-index);
        }
    }
    HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        RoleText {
            role: Typography.mono;
            text-color: touch.has-hover ? Theme.text-primary : Theme.text-secondary;
            text: root.label;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

export component RuleList inherits VerticalLayout {
    in property <[RuleRowModel]> rules;
    // The preset offsets' canonical labels (`"5m"`, `"30m"`, …) —
    // derived in the projection, never hand-written (D12).
    in property <[string]> presets;
    // The derived-fact hint; empty means no rules (nothing to present).
    in property <string> hint;
    // The task's mute state (r4 D31a): the indicator + un-mute
    // affordance render from it.
    in property <bool> muted;
    callback remove-clicked(int);
    callback add-preset-clicked(int);
    // The parse outcome rides the seam's return (r2 D24): `false` is
    // the D12 absorb (nothing dispatched) plus this composition's
    // buffer reset — the field is remounted only on view switch, never
    // per refresh, so the handler below is the buffer's only clearer.
    callback add-custom-accepted(string) -> bool;
    // The per-keystroke validity (r4 D27): the adapter parses with
    // the domain grammar and pushes the flavour; the error line
    // renders the pushed copy constant on invalid text only.
    callback offset-edited(string);
    // D31a: the un-mute affordance next to the muted indicator.
    callback unmute-clicked();
    // D30: an unarmed row's jump affordance opens the due editor.
    callback jump-to-due-clicked();
    in property <FieldValidity> offset-validity: FieldValidity.neutral;
    in property <string> offset-error-hint;
    // The custom-offset field's help sentence (r3-3.1): the
    // `TippedField` pair single-sources it into the tip and the
    // field's a11y description; markup-literal at the instantiation.
    in property <string> offset-help: "";

    RoleText {
        role: Typography.caption;
        text-color: Theme.text-secondary;
        text: "Reminders";
    }

    if (root.hint != ""): RoleText {
        role: Typography.caption;
        text-color: root.muted ? Semantic.warning : Theme.text-secondary;
        text: root.hint;
        wrap: word-wrap;
    }

    // The muted indicator + un-mute affordance (r4 D31a, F25's ranked
    // cause made visible and reversible — the CLI's --off lane as the
    // affordance precedent).
    if (root.muted): HorizontalLayout {
        spacing: Theme.space-2;
        RoleText {
            role: Typography.caption;
            text-color: Semantic.warning;
            text: "muted";
            vertical-alignment: center;
        }
        IconButton {
            icon: IconKind.remove;
            label: "Un-mute reminders";
            description: "Restores reminders on this task.";
            clicked => { root.unmute-clicked(); }
        }
    }

    for row[i] in root.rules: HorizontalLayout {
        spacing: Theme.space-3;
        alignment: start;
        VerticalLayout {
            spacing: Theme.space-1;
            RoleText {
                role: Typography.mono;
                text: row.before;
                vertical-alignment: center;
            }
            if (row.detail != ""): RoleText {
                role: Typography.caption;
                text-color: Theme.text-secondary;
                text: row.detail;
                vertical-alignment: center;
            }
        }
        RoleText {
            role: Typography.caption;
            text-color: Theme.text-secondary;
            text: row.created;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        // The jump affordance (r4 D30): an unarmed row's due-date
        // repair — opens the due editor for the subject task.
        if (!row.armed): IconButton {
            icon: IconKind.calendar;
            label: "Set a due date to arm this reminder";
            description: "Opens the due editor for this task.";
            clicked => { root.jump-to-due-clicked(); }
        }
        IconButton {
            icon: IconKind.remove;
            label: "Remove reminder";
            description: "Removes this reminder rule.";
            clicked => root.remove-clicked(i);
        }
    }

    // The presets row (r2 D24): the chips plus the custom-offset
    // entry read as one controls row. Alignment stays the stretch
    // default — chips are pinned at stretch 0 so they keep their
    // content size while the field's stretch 1 takes the leftover
    // (an `alignment: start` row would size every cell to its
    // preferred width and defeat the stretch).
    HorizontalLayout {
        spacing: Theme.space-2;
        for label[i] in root.presets: preset-chip := PresetChip {
            label: label;
            chip-index: i;
            horizontal-stretch: 0;
            chip-clicked(index) => { root.add-preset-clicked(index); }
        }
        custom-field := TippedField {
            placeholder: "Custom offset, e.g. 45m";
            label: "Custom reminder offset";
            help: root.offset-help;
            commit-affordance: true;
            validity: root.offset-validity;
            horizontal-stretch: 1;
            accepted(text) => {
                // A miss (`false`) is the D12 absorb: nothing
                // dispatched, this buffer resets.
                if (!root.add-custom-accepted(text)) {
                    custom-field.text = "";
                }
            }
            edited(text) => { root.offset-edited(text); }
        }
    }
    if (root.offset-validity == FieldValidity.invalid && custom-field.text != ""): RoleText {
        role: Typography.caption;
        text-color: Semantic.danger;
        text: root.offset-error-hint;
    }
}
