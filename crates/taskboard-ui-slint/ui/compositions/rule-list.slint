// SPDX-License-Identifier: AGPL-3.0-only
// The task-editor rule-list composition (chunk 6, D12): one row per
// reminder rule (the offset in the canonical text form, the created
// stamp, a remove affordance), the derived-fact hint, and the add
// affordance (preset chips plus a custom offset entry). Indices
// resolve against the refresh pass's id tables — no ids cross the
// seam (D2). A parse-missed custom entry dispatches nothing: the
// adapter absorbs it (the CLI owns typed failures, D12).

import { Theme, Typography, Semantic, RoleText } from "../theme.slint";
import { TextField } from "../widgets/text-field.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
import { EditingFacts } from "../editing-facts.slint";
import { TaskViewWalkFacts } from "../walk-facts.slint";
import { TooltipState } from "../widgets/tooltip.slint";

// One rule row: the offset text form and the created stamp — display
// strings only (D12: ids stay in the adapter's tables).
export struct RuleRowModel {
    before: string,
    created: string,
}

// One preset chip (r4 D18): the chip body's FocusScope overlay is a
// real tab stop with Return/Space activation onto the same
// `add-preset-clicked` seam the TouchArea clicks, the focus ring on
// the chip border, and the activation publish (the task view's
// ActivationStop grammar, local because the chip keeps its own token
// floor pin).
component PresetChip inherits Rectangle {
    in property <string> label;
    in property <int> chip-index;
    callback chip-clicked(int);
    border-radius: Theme.radius-small;
    border-width: Theme.focus-ring-width;
    border-color: chip-focus.has-focus || touch.has-hover
        ? Semantic.focus-ring
        : Theme.text-secondary;
    min-height: Theme.space-5;
    min-width: Theme.space-6;
    property <bool> activation-counted: false;
    property <int> counted-generation: -1;
    chip-focus := FocusScope {
        width: 100%;
        height: 100%;
        // The derived-property wrap (the walk probe's recorded
        // idiom): `changed` delivers on the wrapper.
        property <bool> focused: self.has-focus;
        focus-on-tab-navigation: true;
        accessible-role: AccessibleRole.button;
        accessible-label: root.label;
        accessible-description: "Adds this reminder offset.";
        accessible-action-default => { root.chip-clicked(root.chip-index); }
        key-pressed(event) => {
            if ((event.text == Key.Return || event.text == " ")
                && !event.modifiers.control
                && !event.modifiers.alt
                && !event.modifiers.shift
                && !event.modifiers.meta) {
                root.chip-clicked(root.chip-index);
                accept
            } else {
                reject
            }
        }
        changed focused => {
            if (self.focused) {
                TaskViewWalkFacts.stop-id = 90 + root.chip-index;
            }
            if (root.counted-generation != EditingFacts.generation) {
                root.counted-generation = EditingFacts.generation;
                root.activation-counted = self.focused;
                if (self.focused) {
                    EditingFacts.activation-focus-count += 1;
                }
            } else if (self.focused != root.activation-counted) {
                EditingFacts.activation-focus-count += self.focused ? 1 : -1;
                root.activation-counted = self.focused;
            }
        }
    }
    touch := TouchArea {
        // The tooltip arm (blanket rule a): the chip's label is the
        // a11y label verbatim.
        changed has-hover => {
            if (self.has-hover) {
                TooltipState.hover(
                    root.label,
                    "Adds this reminder offset.",
                    [],
                    self.absolute-position.x,
                    self.absolute-position.y,
                    self.width,
                    self.height,
                );
            } else {
                TooltipState.unhover();
            }
        }
        clicked => {
            TooltipState.unhover();
            root.chip-clicked(root.chip-index);
        }
    }
    HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        RoleText {
            role: Typography.mono;
            text-color: touch.has-hover ? Theme.text-primary : Theme.text-secondary;
            text: root.label;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

export component RuleList inherits VerticalLayout {
    in property <[RuleRowModel]> rules;
    // The preset offsets' canonical labels (`"5m"`, `"30m"`, …) —
    // derived in the projection, never hand-written (D12).
    in property <[string]> presets;
    // The derived-fact hint; empty means no rules (nothing to present).
    in property <string> hint;
    callback remove-clicked(int);
    callback add-preset-clicked(int);
    // The parse outcome rides the seam's return (r2 D24): `false` is
    // the D12 absorb (nothing dispatched) plus this composition's
    // buffer reset — the field is remounted only on view switch, never
    // per refresh, so the handler below is the buffer's only clearer.
    callback add-custom-accepted(string) -> bool;

    RoleText {
        role: Typography.caption;
        text-color: Theme.text-secondary;
        text: "Reminders";
    }

    if (root.hint != ""): RoleText {
        role: Typography.caption;
        text-color: Theme.text-secondary;
        text: root.hint;
        wrap: word-wrap;
    }

    for row[i] in root.rules: HorizontalLayout {
        spacing: Theme.space-3;
        alignment: start;
        RoleText {
            role: Typography.mono;
            text: row.before;
            vertical-alignment: center;
        }
        RoleText {
            role: Typography.caption;
            text-color: Theme.text-secondary;
            text: row.created;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        IconButton {
            icon: IconKind.remove;
            label: "Remove reminder";
            description: "Removes this reminder rule.";
            clicked => root.remove-clicked(i);
        }
    }

    // The presets row (r2 D24): the chips plus the custom-offset
    // entry read as one controls row. Alignment stays the stretch
    // default — chips are pinned at stretch 0 so they keep their
    // content size while the field's stretch 1 takes the leftover
    // (an `alignment: start` row would size every cell to its
    // preferred width and defeat the stretch).
    HorizontalLayout {
        spacing: Theme.space-2;
        for label[i] in root.presets: preset-chip := PresetChip {
            label: label;
            chip-index: i;
            horizontal-stretch: 0;
            chip-clicked(index) => { root.add-preset-clicked(index); }
        }
        custom-field := TextField {
            placeholder: "Custom offset, e.g. 45m";
            label: "Custom reminder offset";
            commit-affordance: true;
            horizontal-stretch: 1;
            accepted(text) => {
                // A miss (`false`) is the D12 absorb: nothing
                // dispatched, this buffer resets.
                if (!root.add-custom-accepted(text)) {
                    custom-field.text = "";
                }
            }
        }
    }
}
