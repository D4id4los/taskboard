// SPDX-License-Identifier: AGPL-3.0-only
// The generated action menu (L2 composition, §5.9): renders the
// menu::entries projection. No key handlers (menu cursor movement is
// actions, D3); a click invokes the same Rust path the `menu.invoke`
// action reaches (every click affordance has an action equivalent,
// §7.1). Layout only — no domain knowledge (Rule E).

import { Theme, Semantic, Typography, RoleText } from "../theme.slint";
import { Responsive, Breakpoint } from "../responsive.slint";
import { TooltipState } from "../widgets/tooltip.slint";
import { KbdHint } from "../widgets/kbd-hint.slint";
import { MenuPanelFacts } from "../menu-facts.slint";

export struct MenuEntryModel {
    // The registry id — `""` for a submenu-parent row (the tests'
    // address; a parent never dispatches).
    action: string,
    label: string,
    // The row's tooltip / a11y description (round-1 D7).
    description: string,
    enabled: bool,
    hint: [string],
    // True for a submenu-parent row (round-1 D6): activating it opens
    // the group's page. Rows are never hand-written (§5.9).
    submenu: bool,
}

export component ActionMenu inherits Rectangle {
    // The root page (round-1 D6); `entries` is the page this panel
    // renders at the root level and, in compact replace mode, is
    // superseded by `submenu-entries` while a group is open.
    in property <[MenuEntryModel]> entries;
    in property <[MenuEntryModel]> submenu-entries;
    in property <int> selected-index;
    in property <int> root-selected-index: 0;
    // The open group as its parent row's root-page index (−1 = root).
    in property <int> active-group: -1;
    // Compact replace mode (round-1 D6): the panel shows the active
    // page with a back row instead of hosting the fly-out.
    in property <bool> compact: Responsive.current-breakpoint == Breakpoint.compact;
    // True for the fly-out instance: its facts mirror into the
    // global's flyout-* slots (round-1 D6).
    in property <bool> is-flyout: false;
    callback invoke-entry(int);
    callback invoke-submenu-entry(int);
    callback level-back();

    // The visible page and its cursor (round-1 D6): replace mode
    // renders the submenu page; the fly-out host passes active-group
    // −1 and renders `entries` directly.
    in property <[MenuEntryModel]> page:
        root.compact && root.active-group >= 0 ? root.submenu-entries : root.entries;
    in property <int> page-cursor:
        root.compact && root.active-group >= 0 ? root.selected-index
        : root.active-group >= 0 ? root.root-selected-index
        : root.selected-index;
    // Usability D6: the space between toolbar and status bar, pushed
    // by the host — the cap the panel fills up to (max-height on the
    // instantiation is not honoured for a Flickable-hosted panel, so
    // the component binds its own height).
    in property <length> available-height;

    // The index-space rule (r2 D12): a row's click seam names the page
    // the row was rendered from, and the Rust resolver resolves against
    // that same page vector. In compact replace mode the panel shows
    // the submenu page (the `page` property's condition above), so the
    // rows must emit the submenu seam; the root page's rows (and the
    // fly-out instance, which never satisfies the condition) emit the
    // root seam.
    public function invoke-row(index: int) {
        if (root.compact && root.active-group >= 0) {
            root.invoke-submenu-entry(index);
        } else {
            root.invoke-entry(index);
        }
    }

    height: min(self.preferred-height, self.available-height);
    // The facts mirror (round-1 D4): the realized geometry lands in
    // the global the journeys read — change handlers, delivered by
    // the mock clock's handler pass.
    init => {
        self.mirror-facts();
    }
    changed x => { self.mirror-facts(); }
    changed y => { self.mirror-facts(); }
    changed width => { self.mirror-facts(); }
    changed height => { self.mirror-facts(); }

    // One mirror for both instances: the fly-out writes the flyout-*
    // slots, the root panel the plain ones.
    public function mirror-facts() {
        if (root.is-flyout) {
            MenuPanelFacts.flyout-x = self.x;
            MenuPanelFacts.flyout-y = self.y;
            MenuPanelFacts.flyout-width = self.width;
            MenuPanelFacts.flyout-height = self.height;
        } else {
            MenuPanelFacts.x = self.x;
            MenuPanelFacts.y = self.y;
            MenuPanelFacts.width = self.width;
            MenuPanelFacts.height = self.height;
        }
    }
    background: Theme.surface-raised;
    border-width: Theme.focus-ring-width;
    border-color: Theme.focus-ring;
    border-radius: Theme.radius-medium;

    flick := Flickable {
        // The viewport auto-tracks the content's preferred size; the
        // Flickable scrolls when the capped panel is shorter.
        content := VerticalLayout {
            padding: Theme.space-2;
            spacing: Theme.space-1;

            // The replace mode's back row (round-1 D6): chrome above
            // the list — the cursor only ever addresses entries; the
            // label is the element's address.
            if (root.compact && root.active-group >= 0): Rectangle {
                border-radius: Theme.radius-small;
                background: back-hit.has-hover ? Theme.surface-hover : transparent;
                back-row := FocusScope {
                    width: 100%;
                    height: 100%;
                    accessible-role: AccessibleRole.button;
                    accessible-label: "Back";
                    accessible-action-default => root.level-back();
                    back-hit := TouchArea {
                        clicked => root.level-back();
                    }
                }
                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-2;
                    RoleText {
                        role: Typography.body-emphasized;
                        text-color: Theme.text-secondary;
                        text: "Back";
                        vertical-alignment: center;
                    }
                }
            }

            for entry[entry-index] in root.page: Rectangle {
                border-width: root.page-cursor == entry-index ? Theme.focus-ring-width : 0;
                border-color: Semantic.focus-ring;
                border-radius: Theme.radius-small;
                // Hover lightens over the raised panel; the selection
                // keeps its inset + ring (usability D2). Disabled rows
                // never hover: their TouchArea is disabled, so
                // has-hover cannot engage.
                // The row's label is the registry label — the
                // element's address (§7.1). The FocusScope overlay
                // carries the a11y role and its default action (the
                // icon-button precedent); the TouchArea owns the
                // mouse click — both land on the same callback.
                row-focus := FocusScope {
                    width: 100%;
                    height: 100%;
                    accessible-role: AccessibleRole.button;
                    accessible-label: entry.label;
                    // The D7 description: the AT text and the row
                    // tooltip's middle part are the same data.
                    accessible-description: entry.description;
                    accessible-action-default => {
                        // A tooltip never outlives the row that spawned
                        // it (r2 D13) — the icon-button pattern.
                        TooltipState.unhover();
                        root.invoke-row(entry-index);
                    }
                    row-hit := TouchArea {
                        enabled: entry.enabled;
                        // The D8 row tooltip (round 1): hover arms the
                        // generalized trigger with the entry's own
                        // description and binding hint.
                        changed has-hover => {
                            if (self.has-hover) {
                                TooltipState.hover(entry.label, entry.description, entry.hint,
                                    self.absolute-position.x, self.absolute-position.y,
                                    self.width, self.height);
                            } else {
                                TooltipState.unhover();
                            }
                        }
                        clicked => {
                            TooltipState.unhover();
                            root.invoke-row(entry-index);
                        }
                    }
                }
                background: row-hit.has-hover ? Theme.surface-hover
                    : root.page-cursor == entry-index ? Theme.surface
                    : transparent;
                // The changed-callback mirror: `changed` only takes a
                // same-element identifier, so each row mirrors the
                // root's selection through its own bound property.
                in property <int> watch: root.page-cursor;
                // The keyboard path stays complete at any size
                // (§7.3): the selection scrolling into view moves the
                // viewport so this row is fully inside it.
                changed watch => {
                    if (root.page-cursor == entry-index) {
                        if (self.y < -flick.content-y) {
                            flick.content-y = -self.y;
                        } else if (self.y + self.height > -flick.content-y + flick.height) {
                            flick.content-y = flick.height - self.y - self.height;
                        }
                    }
                }
                VerticalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-2;
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        RoleText {
                            role: Typography.body-emphasized;
                            text-color: entry.enabled ? Theme.text-primary : Theme.text-secondary;
                            text: entry.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        VerticalLayout {
                            KbdHint {
                                keys: entry.hint;
                            }
                        }
                    }
                }
            }
        }
    }

    // The scroll indicator (usability D6): an affordance, only while
    // the content actually overflows — track on the panel's surface,
    // thumb in the border colour at the inner edge.
    if (flick.content-height > flick.height): Rectangle {
        x: root.width - Theme.space-3;
        y: Theme.space-2;
        width: Theme.space-1;
        height: root.height - 2 * Theme.space-2;
        background: Theme.surface;
        border-radius: self.width / 2;

        Rectangle {
            width: 100%;
            background: Theme.border;
            border-radius: parent.width / 2;
            // The token-derived epsilon guards the zero-overflow
            // division; the indicator only renders while overflowing.
            height: max(Theme.space-4, parent.height * parent.height
                / max(Theme.focus-ring-width / 4, flick.content-height));
            y: (parent.height - self.height)
                * (-flick.content-y
                    / max(Theme.focus-ring-width / 4, flick.content-height - flick.height));
        }
    }
}
