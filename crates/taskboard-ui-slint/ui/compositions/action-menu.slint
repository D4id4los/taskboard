// SPDX-License-Identifier: AGPL-3.0-only
// The generated action menu (L2 composition, §5.9): renders the
// menu::entries projection. No key handlers (menu cursor movement is
// actions, D3); a click invokes the same Rust path the `menu.invoke`
// action reaches (every click affordance has an action equivalent,
// §7.1). Layout only — no domain knowledge (Rule E).

import { Theme, Semantic, Typography, RoleText } from "../theme.slint";
import { KbdHint } from "../widgets/kbd-hint.slint";

export struct MenuEntryModel {
    // The registry id — `""` for a submenu-parent row (the tests'
    // address; a parent never dispatches).
    action: string,
    label: string,
    // The row's tooltip / a11y description (round-1 D7).
    description: string,
    enabled: bool,
    hint: [string],
    // True for a submenu-parent row (round-1 D6): activating it opens
    // the group's page. Rows are never hand-written (§5.9).
    submenu: bool,
}

export component ActionMenu inherits Rectangle {
    in property <[MenuEntryModel]> entries;
    in property <int> selected-index;
    callback invoke-entry(int);
    // Usability D6: the space between toolbar and status bar, pushed
    // by the host — the cap the panel fills up to (max-height on the
    // instantiation is not honoured for a Flickable-hosted panel, so
    // the component binds its own height).
    in property <length> available-height;

    height: min(self.preferred-height, self.available-height);
    background: Theme.surface-raised;
    border-width: Theme.focus-ring-width;
    border-color: Theme.focus-ring;
    border-radius: Theme.radius-medium;
    // Usability D6: no min-height — a short menu shrinks to its
    // content, a long one caps at the host's max-height binding and
    // the Flickable scrolls the overflow.
    min-width: 320px * Theme.base-scale;

    flick := Flickable {
        // The viewport auto-tracks the content's preferred size; the
        // Flickable scrolls when the capped panel is shorter.
        content := VerticalLayout {
            padding: Theme.space-2;
            spacing: Theme.space-1;

            for entry[entry-index] in entries: Rectangle {
                border-width: root.selected-index == entry-index ? Theme.focus-ring-width : 0;
                border-color: Semantic.focus-ring;
                border-radius: Theme.radius-small;
                // Hover lightens over the raised panel; the selection
                // keeps its inset + ring (usability D2). Disabled rows
                // never hover: their TouchArea is disabled, so
                // has-hover cannot engage.
                // The row's label is the registry label — the
                // element's address (§7.1). The FocusScope overlay
                // carries the a11y role and its default action (the
                // icon-button precedent); the TouchArea owns the
                // mouse click — both land on the same callback.
                row-focus := FocusScope {
                    width: 100%;
                    height: 100%;
                    accessible-role: AccessibleRole.button;
                    accessible-label: entry.label;
                    accessible-action-default => root.invoke-entry(entry-index);
                    row-hit := TouchArea {
                        enabled: entry.enabled;
                        clicked => root.invoke-entry(entry-index);
                    }
                }
                background: row-hit.has-hover ? Theme.surface-hover
                    : root.selected-index == entry-index ? Theme.surface
                    : transparent;
                // The changed-callback mirror: `changed` only takes a
                // same-element identifier, so each row mirrors the
                // root's selection through its own bound property.
                in property <int> watch: root.selected-index;
                // The keyboard path stays complete at any size
                // (§7.3): the selection scrolling into view moves the
                // viewport so this row is fully inside it.
                changed watch => {
                    if (root.selected-index == entry-index) {
                        if (self.y < -flick.viewport-y) {
                            flick.viewport-y = -self.y;
                        } else if (self.y + self.height > -flick.viewport-y + flick.height) {
                            flick.viewport-y = flick.height - self.y - self.height;
                        }
                    }
                }
                VerticalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-2;
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        RoleText {
                            role: Typography.body-emphasized;
                            text-color: entry.enabled ? Theme.text-primary : Theme.text-secondary;
                            text: entry.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        VerticalLayout {
                            KbdHint {
                                keys: entry.hint;
                            }
                        }
                    }
                }
            }
        }
    }

    // The scroll indicator (usability D6): an affordance, only while
    // the content actually overflows — track on the panel's surface,
    // thumb in the border colour at the inner edge.
    if (flick.viewport-height > flick.height): Rectangle {
        x: root.width - Theme.space-3;
        y: Theme.space-2;
        width: Theme.space-1;
        height: root.height - 2 * Theme.space-2;
        background: Theme.surface;
        border-radius: self.width / 2;

        Rectangle {
            width: 100%;
            background: Theme.border;
            border-radius: parent.width / 2;
            // The token-derived epsilon guards the zero-overflow
            // division; the indicator only renders while overflowing.
            height: max(Theme.space-4, parent.height * parent.height
                / max(Theme.focus-ring-width / 4, flick.viewport-height));
            y: (parent.height - self.height)
                * (-flick.viewport-y
                    / max(Theme.focus-ring-width / 4, flick.viewport-height - flick.height));
        }
    }
}
