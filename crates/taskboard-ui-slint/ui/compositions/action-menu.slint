// SPDX-License-Identifier: AGPL-3.0-only
// The generated action menu (L2 composition, §5.9): renders the
// menu::entries projection. No key handlers (menu cursor movement is
// actions, D3); a click invokes the same Rust path the `menu.invoke`
// action reaches (every click affordance has an action equivalent,
// §7.1). Layout only — no domain knowledge (Rule E).

import { Theme, Semantic, Typography, RoleText } from "../theme.slint";
import { Responsive, Breakpoint } from "../responsive.slint";
import { TooltipState } from "../widgets/tooltip.slint";
import { MenuPanelFacts } from "../menu-facts.slint";
import { IconKind } from "../widgets/icon.slint";
import { IconButton } from "../widgets/icon-button.slint";
import { MenuRow } from "../widgets/menu-row.slint";
import { MenuShell } from "../widgets/menu-shell.slint";

// The quick-bar row (UX-R8 chunk-5 D-2, US-1): the routing id (the
// Rust vec is the resolver), the icon, and the shown/withheld verdict.
// `visible: false` is the C-4 withheld rule — the model carries the
// row; the bar renders only the shown half. The action string is
// informational; the Rust side resolves by index.
export struct QuickBarEntryModel {
    action: string,
    // The registry label — the element's address / a11y label (D16).
    label: string,
    icon: IconKind,
    enabled: bool,
    visible: bool,
    // The routed action's first preset binding (J5 US-4 AC-1) — the
    // same projection the menu rows carry in `hint`. Empty when
    // unbound (the bar's pointer-first posture; no invented hints).
    hint-keys: [string],
}

export struct MenuEntryModel {
    // The registry id — `""` for a submenu-parent row (the tests'
    // address; a parent never dispatches).
    action: string,
    label: string,
    // The row's tooltip / a11y description (round-1 D7).
    description: string,
    enabled: bool,
    hint: [string],
    // True for a submenu-parent row (round-1 D6): activating it opens
    // the group's page. Rows are never hand-written (§5.9).
    submenu: bool,
}

export component ActionMenu inherits Rectangle {
    // The root page (round-1 D6); `entries` is the page this panel
    // renders at the root level and, in compact replace mode, is
    // superseded by `submenu-entries` while a group is open.
    in property <[MenuEntryModel]> entries;
    in property <[MenuEntryModel]> submenu-entries;
    // The quick actions bar (UX-R8 chunk-5 D-2, US-1): a leading
    // icon-button row above the Flickable. An empty model renders
    // nothing — every other menu consumer passes [] and is
    // bit-identical. The bar is pointer/click + the preset keys,
    // deliberately not a cursor stop (the r4 D7 prominence posture).
    in property <[QuickBarEntryModel]> quick-bar;
    // slint: menu-quick-bar-invoked — a bar button routes its
    // ActionId through the Rust vec (click ≡ key).
    callback invoke-quick-bar(int);
    in property <int> selected-index;
    in property <int> root-selected-index: 0;
    // The open group as its parent row's root-page index (−1 = root).
    in property <int> active-group: -1;
    // Compact replace mode (round-1 D6): the panel shows the active
    // page with a back row instead of hosting the fly-out.
    in property <bool> compact: Responsive.current-breakpoint == Breakpoint.compact;
    // True for the fly-out instance: its facts mirror into the
    // global's flyout-* slots (round-1 D6).
    in property <bool> is-flyout: false;
    callback invoke-entry(int);
    callback invoke-submenu-entry(int);
    callback level-back();

    // The visible page and its cursor (round-1 D6): replace mode
    // renders the submenu page; the fly-out host passes active-group
    // −1 and renders `entries` directly.
    in property <[MenuEntryModel]> page:
        root.compact && root.active-group >= 0 ? root.submenu-entries : root.entries;
    in property <int> page-cursor:
        root.compact && root.active-group >= 0 ? root.selected-index
        : root.active-group >= 0 ? root.root-selected-index
        : root.selected-index;
    // Usability D6: the space between toolbar and status bar, pushed
    // by the host — the cap the panel fills up to (max-height on the
    // instantiation is not honoured for a Flickable-hosted panel, so
    // the component binds its own height).
    in property <length> available-height;

    // The index-space rule (r2 D12): a row's click seam names the page
    // the row was rendered from, and the Rust resolver resolves against
    // that same page vector. In compact replace mode the panel shows
    // the submenu page (the `page` property's condition above), so the
    // rows must emit the submenu seam; the root page's rows (and the
    // fly-out instance, which never satisfies the condition) emit the
    // root seam.
    public function invoke-row(index: int) {
        if (root.compact && root.active-group >= 0) {
            root.invoke-submenu-entry(index);
        } else {
            root.invoke-entry(index);
        }
    }

    height: min(self.preferred-height, self.available-height);
    // The facts mirror (round-1 D4): the realized geometry lands in
    // the global the journeys read — change handlers, delivered by
    // the mock clock's handler pass.
    init => {
        self.mirror-facts();
    }
    changed x => { self.mirror-facts(); }
    changed y => { self.mirror-facts(); }
    changed width => { self.mirror-facts(); }
    changed height => { self.mirror-facts(); }

    // One mirror for both instances: the fly-out writes the flyout-*
    // slots, the root panel the plain ones.
    public function mirror-facts() {
        if (root.is-flyout) {
            MenuPanelFacts.flyout-x = self.x;
            MenuPanelFacts.flyout-y = self.y;
            MenuPanelFacts.flyout-width = self.width;
            MenuPanelFacts.flyout-height = self.height;
        } else {
            MenuPanelFacts.x = self.x;
            MenuPanelFacts.y = self.y;
            MenuPanelFacts.width = self.width;
            MenuPanelFacts.height = self.height;
        }
    }
    background: Theme.surface-raised;
    border-width: Theme.focus-ring-width;
    border-color: Theme.focus-ring;
    border-radius: Theme.radius-medium;

    // The quick actions bar (UX-R8 chunk-5 D-2): a leading
    // icon-button HorizontalLayout above the Flickable — only while
    // the model carries a shown row (empty renders nothing).
    if (root.quick-bar.length > 0): quick-bar-row := HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        padding-top: Theme.space-2;
        spacing: Theme.space-1;
        for bar-entry[bar-index] in root.quick-bar: Rectangle {
            visible: bar-entry.visible;
            quick-bar-button := IconButton {
                icon: bar-entry.icon;
                enabled: bar-entry.enabled;
                label: bar-entry.label;
                hint-keys: bar-entry.hint-keys;
                // slint: menu-quick-bar-invoked
                clicked => { root.invoke-quick-bar(bar-index); }
            }
        }
    }

    flick := Flickable {
        // The viewport auto-tracks the content's preferred size; the
        // Flickable scrolls when the capped panel is shorter.
        content := VerticalLayout {
            padding: Theme.space-2;
            spacing: Theme.space-1;

            // The replace mode's back row (round-1 D6): chrome above
            // the list — the cursor only ever addresses entries; the
            // label is the element's address.
            if (root.compact && root.active-group >= 0): Rectangle {
                border-radius: Theme.radius-small;
                background: back-hit.has-hover ? Theme.surface-hover : transparent;
                back-row := FocusScope {
                    width: 100%;
                    height: 100%;
                    accessible-role: AccessibleRole.button;
                    accessible-label: "Back";
                    accessible-action-default => root.level-back();
                    back-hit := TouchArea {
                        clicked => root.level-back();
                    }
                }
                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-2;
                    RoleText {
                        role: Typography.body-emphasized;
                        text-color: Theme.text-secondary;
                        text: "Back";
                        vertical-alignment: center;
                    }
                }
            }

            for entry[entry-index] in root.page: Rectangle {
                border-width: root.page-cursor == entry-index ? Theme.focus-ring-width : 0;
                border-color: Semantic.focus-ring;
                border-radius: Theme.radius-small;
                // D-3's split: the composition owns the selection's
                // ring + inset fill (the cursor's two arms — hover
                // lightens over the raised panel, the selection keeps
                // its inset), the row primitive owns the anatomy. The
                // hover fill rides the MenuRow's `highlighted` (the
                // row's own hover arm below); the cursor fill yields
                // to it while hovered — the old three-state
                // expression's exact truth table.
                background: root.page-cursor == entry-index && !menu-row.hover-now
                    ? Theme.surface : transparent;
                menu-row := MenuRow {
                    label: entry.label;
                    description: entry.description;
                    enabled: entry.enabled;
                    highlighted: self.hover-now;
                    hint-keys: entry.hint;
                    submenu: entry.submenu;
                    // The a11y posture is the instantiation's
                    // (MenuRow's recorded contract): the button role
                    // with the registry label (the element's address,
                    // §7.1) and the D7 description.
                    accessible-role: AccessibleRole.button;
                    accessible-label: entry.label;
                    accessible-description: entry.description;
                    accessible-action-default => {
                        // A tooltip never outlives the row that spawned
                        // it (r2 D13) — the icon-button pattern.
                        TooltipState.unhover();
                        root.invoke-row(entry-index);
                    }
                    // The D8 row tooltip (round 1): hover arms the
                    // generalized trigger with the entry's own
                    // description and binding hint.
                    hovered(x, y, w, h) => {
                        TooltipState.hover(entry.label, entry.description, entry.hint,
                            x, y, w, h);
                    }
                    unhovered() => {
                        TooltipState.unhover();
                    }
                    invoked => {
                        TooltipState.unhover();
                        root.invoke-row(entry-index);
                    }
                }
                // The changed-callback mirror: `changed` only takes a
                // same-element identifier, so each row mirrors the
                // root's selection through its own bound property.
                in property <int> watch: root.page-cursor;
                // The keyboard path stays complete at any size
                // (§7.3): the selection scrolling into view moves the
                // viewport so this row is fully inside it.
                changed watch => {
                    if (root.page-cursor == entry-index) {
                        if (self.y < -flick.content-y) {
                            flick.content-y = -self.y;
                        } else if (self.y + self.height > -flick.content-y + flick.height) {
                            flick.content-y = flick.height - self.y - self.height;
                        }
                    }
                }
            }
        }
    }

    // The scroll indicator (usability D6): an affordance, only while
    // the content actually overflows — track on the panel's surface,
    // thumb in the border colour at the inner edge.
    if (flick.content-height > flick.height): Rectangle {
        x: root.width - Theme.space-3;
        y: Theme.space-2;
        width: Theme.space-1;
        height: root.height - 2 * Theme.space-2;
        background: Theme.surface;
        border-radius: self.width / 2;

        Rectangle {
            width: 100%;
            background: Theme.border;
            border-radius: parent.width / 2;
            // The token-derived epsilon guards the zero-overflow
            // division; the indicator only renders while overflowing.
            height: max(Theme.space-4, parent.height * parent.height
                / max(Theme.focus-ring-width / 4, flick.content-height));
            y: (parent.height - self.height)
                * (-flick.content-y
                    / max(Theme.focus-ring-width / 4, flick.content-height - flick.height));
        }
    }

    // #1188: the border box closes over the clipped scroll edge. The
    // Flickable's viewport clips its last visible row at the panel
    // cap and the row's fragments (hint keycaps included) paint above
    // the panel's own border stroke — children render after the
    // parent's background, and the viewport bottom is not inset from
    // the border. This overlay redraws the border as the panel's
    // topmost chrome so the box closes at every geometry; a bare
    // Rectangle intercepts no pointer events (the rows below stay
    // clickable).
    Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        border-width: Theme.focus-ring-width;
        border-color: Theme.focus-ring;
        border-radius: Theme.radius-medium;
    }
}

// The undo branch picker (UF2, #353): the v2 extension's selection
// menu, mounted from the undo affordance (W-1). The plain undo/redo
// rows stay first (the BF-W-N2 doctrine — the reflex rows first), the
// undo-step rows (the `recent` ancestors) and the sibling-branch rows
// (the head's `branch_children`) follow as sections. Rows are
// engine-derived typed projections (`UndoView`), never synthesized
// here (trap c); a row's payload id IS its addressing (W-2/W-3 —
// the UI is id-less over elements, not over journal nodes).
export struct UndoPickerRowModel {
    // The journal entry id (string form across the seam; the adapter
    // re-types it at the trust boundary).
    id: string,
    // The engine-derived command label (`command_label`).
    label: string,
    // The engine-derived payload context (#1226, D-3): the command's
    // own subject (a title, a name). Empty string ↔ `None` across the
    // seam — the row renders label-only then, never a blank dash.
    payload: string,
}

export component UndoBranchPicker inherits Rectangle {
    // The sibling branches (the head's `branch_children`, newest
    // first) and the undo-step rows (the `recent` ancestors).
    in property <[UndoPickerRowModel]> branch-rows;
    in property <[UndoPickerRowModel]> target-rows;
    // The keyboard cursor (#1227, D-1): an index into the selectable
    // rows only — 0 Undo, 1 Redo, 2+i the i-th undo-step row, then
    // the branch rows — never the section headers (the family law:
    // rows never hold focus; the cursor is paint + invoke routing).
    in property <int> cursor: 0;
    // slint: undo_branches_open — the mount ack (W-1); the adapter
    // syncs the models, nothing dispatches on open.
    callback undo_branches_open();
    // slint: undo_line_undo / undo_line_redo — the plain reflex rows
    // (US-3: the v1 composes; click ≡ key, the same AppUndo/AppRedo
    // route the keyboard uses).
    callback undo_line_undo();
    callback undo_line_redo();
    // slint: undo_target_picked / undo_branch_picked — the row seams
    // (W-3: UndoTo / W-2: RedoTo); the payload id is the addressing.
    callback undo_target_picked(string);
    callback undo_branch_picked(string);
    // slint: undo_picker_dismissed — the outside click (AC-4: closes
    // with nothing dispatched).
    callback undo_picker_dismissed();

    // The D-3 presentation fold (one projection, the adapter mints
    // the models): a payload-carrying row renders `label — payload`,
    // a subjectless row stays label-only — never a blank dash.
    pure function row-text(row: UndoPickerRowModel) -> string {
        return row.payload == "" ? row.label : row.label + " — " + row.payload;
    }

    background: transparent;
    init => { root.undo_branches_open(); }

    width: 360px * Theme.base-scale;

    MenuShell {
        row-count: root.target-rows.length + root.branch-rows.length + 4;
        VerticalLayout {
            padding: Theme.space-2;
            spacing: Theme.space-1;

            // The plain reflex rows first (BF-W-N2).
            MenuRow {
                label: "Undo";
                description: "Undoes the last change — the unchanged v1 reflex (US-3).";
                hint-keys: [];
                highlighted: self.hover-now || root.cursor == 0;
                accessible-role: AccessibleRole.button;
                accessible-label: "Undo";
                invoked => { root.undo_line_undo(); }
            }
            MenuRow {
                label: "Redo";
                description: "Re-applies the last undone change — the unchanged v1 reflex (US-3).";
                hint-keys: [];
                highlighted: self.hover-now || root.cursor == 1;
                accessible-role: AccessibleRole.button;
                accessible-label: "Redo";
                invoked => { root.undo_line_redo(); }
            }

            // The undo-step rows (US-2: jump several steps back).
            if (root.target-rows.length > 0): RoleText {
                role: Typography.body-emphasized;
                text-color: Theme.text-secondary;
                text: "Undo steps";
            }
            for row[tidx] in root.target-rows: MenuRow {
                label: root.row-text(row);
                description: "Jumps the undo line back to this point (US-2/S1).";
                hint-keys: [];
                highlighted: self.hover-now || root.cursor == 2 + tidx;
                accessible-role: AccessibleRole.button;
                accessible-label: root.row-text(row);
                invoked => { root.undo_target_picked(row.id); }
            }

            // The sibling branches (US-1: switch back to an abandoned
            // branch).
            if (root.branch-rows.length > 0): RoleText {
                role: Typography.body-emphasized;
                text-color: Theme.text-secondary;
                text: "Branches";
            }
            for row[bidx] in root.branch-rows: MenuRow {
                label: root.row-text(row);
                description: "Redoes down this abandoned branch (US-1/S2).";
                hint-keys: [];
                highlighted: self.hover-now || root.cursor == 2 + root.target-rows.length + bidx;
                accessible-role: AccessibleRole.button;
                accessible-label: root.row-text(row);
                invoked => { root.undo_branch_picked(row.id); }
            }

            // AC-3: no abandoned branch — the section renders absent
            // (the `if` above), the undo-step rows still mount.
        }
    }
}
