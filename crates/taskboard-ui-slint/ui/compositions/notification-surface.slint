// SPDX-License-Identifier: AGPL-3.0-only
// The in-app notification surface (R3 chunk C, design D-10): the
// universal dismissal surface — one row per fired, undismissed
// occurrence, derived at read. Desktop-only: the kiosk's model-side
// gate (R3.5.3) empties it, leaving the banner as the appliance's only
// reminder surface. Layout only; the commands live in the adapter.

import { Theme, Typography, Semantic, RoleText, Tone } from "../theme.slint";
import { Badge } from "../widgets/badge.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
import { ListRow } from "../widgets/list-row.slint";

// One notification row: the title snapshot plus the elapsed phrase.
// The command targets are Rust-side (the IdTables index convention —
// the banner rows' precedent); the row carries only its index.
export struct NotificationRowModel {
    title: string,
    fired-phrase: string,
    // The anchor-aware affordance table (DR-3/3, D-P11): task rows
    // keep Done + Mute; alarm rows swap them for Cancel. Dismiss and
    // Snooze are unconditional (always rendered).
    can-done: bool,
    can-mute: bool,
    can-cancel: bool,
    // DR-5/4 (D-T16): Start Task on task-anchored rows only — the
    // planner dismisses implicitly in the same batch, so this
    // dispatches exactly one command.
    can-track-start: bool,
    // D-6.1 (round 6): the double-click open is advertised on
    // task-anchored rows only (an alarm has no task view to open).
    can-open: bool,
}

export component NotificationSurface inherits Rectangle {
    in property <[NotificationRowModel]> notifications;
    in property <int> notification-overflow;
    // The walk's selected row (US-6/W-6, D-N1): the highlight is the
    // row's focused look (the board card's emphasis twin); -1 = no
    // selection (disengaged).
    in property <int> selected-index: -1;
    // The open snooze-choice row (H4 D3): -1 = closed. Purely
    // presentation state — the pick is the only dispatch.
    property <int> snooze-open-row: -1;
    // The O-1 span set (H4 D3): hours first, days after, ascending.
    property <[string]> snooze-spans: [
        "Snooze 1 hour",
        "Snooze 4 hours",
        "Snooze 1 day",
        "Snooze 3 days",
    ];
    callback dismiss-clicked(int);
    callback done-clicked(int);
    // The snooze choice flyout (H4 D3, US-6/S2): the snooze control
    // opens a span choice (hours AND days, spans ascending); the
    // pick routes `SnoozeReminder` with the chosen delta. The fixed
    // 1-hour hop stays the keyboard verb's span (the key grammar
    // gains no chord — the walk reaches the flyout's buttons).
    callback snooze-span-picked(int, int);
    callback mute-clicked(int);
    callback cancel-clicked(int);
    callback track-start-clicked(int);
    // D-6.1 (round 6): the double-click open — task-anchored rows
    // only (the TouchArea is disabled otherwise); a single click has
    // no semantics on this surface.
    callback row-open-requested(int);

    background: Theme.background;
    accessible-role: AccessibleRole.region;
    accessible-label: "Reminder notifications";

    VerticalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        padding-top: Theme.space-1;
        padding-bottom: Theme.space-1;
        spacing: Theme.space-1;

        for row[row-index] in root.notifications: VerticalLayout {
            spacing: Theme.space-1;
            HorizontalLayout {
                spacing: Theme.space-2;

                // D-6.1 (round 6): the interactive carrier — the ListRow
                // keeps its layout slot (the carrier inherits the
                // horizontal stretch); the TouchArea advertises (hover)
                // and accepts the double-click only on task-anchored rows.
                row-box := Rectangle {
                    horizontal-stretch: 1;
                    background: row-touch.has-hover && row.can-open
                        ? Theme.surface-hover
                        : transparent;
                    // The walk highlight (US-6/W-6): the selected row's
                    // ring — the house focus token, the card's emphasis
                    // twin (no theme work).
                    border-width: root.selected-index == row-index
                        ? Theme.focus-ring-width : 0;
                    border-color: Semantic.focus-ring;
                    border-radius: Theme.radius-small;
                    row-info := ListRow {
                        text: row.title;
                        meta: row.fired-phrase;
                        tone: Tone.info;
                    }
                    row-touch := TouchArea {
                        enabled: row.can-open;
                        double-clicked => {
                            root.row-open-requested(row-index);
                        }
                    }
                }
                VerticalLayout {
                    IconButton {
                        // r4 D11 (F1): the dismiss affordance is the
                        // circled x — no longer done's check glyph.
                        icon: IconKind.dismiss;
                        tone: Tone.info;
                        label: "Dismiss notification";
                        clicked => root.dismiss-clicked(row-index);
                    }
                }
                if (row.can-done): VerticalLayout {
                    IconButton {
                        icon: IconKind.check;
                        tone: Tone.info;
                        label: "Mark task done";
                        clicked => root.done-clicked(row-index);
                    }
                }
                if (row.can-track-start): VerticalLayout {
                    IconButton {
                        icon: IconKind.play;
                        tone: Tone.info;
                        label: "Start task";
                        clicked => root.track-start-clicked(row-index);
                    }
                }
                VerticalLayout {
                    IconButton {
                        icon: IconKind.snooze;
                        tone: Tone.info;
                        label: "Snooze reminder";
                        clicked => {
                            root.snooze-open-row = root.snooze-open-row == row-index
                                ? -1 : row-index;
                        }
                    }
                }
                if (row.can-mute): VerticalLayout {
                    IconButton {
                        icon: IconKind.mute;
                        tone: Tone.info;
                        label: "Mute reminders";
                        clicked => root.mute-clicked(row-index);
                    }
                }
                if (row.can-cancel): VerticalLayout {
                    IconButton {
                        icon: IconKind.remove;
                        tone: Tone.info;
                        label: "Cancel timer";
                        clicked => root.cancel-clicked(row-index);
                    }
                }
            }
            // The snooze choice flyout (H4 D3): opens under the
            // picked row; every choice routes the typed span.
            if (root.snooze-open-row == row-index): HorizontalLayout {
                padding-left: Theme.space-6;
                spacing: Theme.space-2;
                for span[span-index] in root.snooze-spans: IconButton {
                    icon: IconKind.snooze;
                    tone: Tone.info;
                    label: span;
                    clicked => {
                        root.snooze-open-row = -1;
                        root.snooze-span-picked(row-index, span-index);
                    }
                }
            }
        }

        if (root.notification-overflow > 0): HorizontalLayout {
            Badge {
                text: "\{root.notification-overflow} more notifications";
                tone: Tone.info;
            }
        }
    }
}
