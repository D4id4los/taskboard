// SPDX-License-Identifier: AGPL-3.0-only
// The habits section (DR-6/6, §4.6): the today view's trackers — one
// progress row per live habit ("water 3/8"), a +1 affordance, and the
// row's reorder pair (the keyboard/affordance fallback of the drag
// plan: both dispatch the same `MoveHabit` midpoint law; the drop
// slot's free interval is computed Rust-side from the row source).
// Renders on kiosk too (D-P13: passive progress visibility IS the
// section's point) — only the actions are gated (D-T16: the gate
// empties the ACTION, never the model; `habits-editing-visible` is
// false on kiosk and the buttons never mount).

import { Theme, Typography, RoleText, Tone, Semantic } from "../theme.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
import { ListRow } from "../widgets/list-row.slint";
import { SegmentedControl } from "../widgets/segmented-control.slint";
import { FieldValidity, TextField } from "../widgets/text-field.slint";

// One tracker row: the progress phrase is a presentation-side
// derivation from `count`/`quota`; `met` restyles only — the +1
// never disables at/after quota (surplus logs are first-class).
export struct HabitRowModel {
    title: string,
    progress: string,
    streak: int,
    chip: string,
    met: bool,
    // The make-up affordance's mount flag (issue #506): the previous
    // window is under quota and inside its overflow grace.
    repair: bool,
}

export component HabitsSection inherits Rectangle {
    in property <[HabitRowModel]> habits;
    // The edit affordances' mount gate (D-P13/D-T16): false on kiosk —
    // the rows render, the actions do not.
    in property <bool> editing-visible;
    callback plus-clicked(int);
    // The reorder's drop slot (row, slot): Rust computes the floor
    // midpoint of the slot's free interval and dispatches MoveHabit.
    callback reorder-asked(int, int);
    // The make-up +1 (issue #506): Rust resolves the exact
    // `(window, count)` from the same row source and dispatches
    // AdjustHabitLog — what you click is what increments.
    callback repair-clicked(int);
    // The conversion flow (issue #506): the first click arms the
    // row's confirm strip (consequence first); Confirm routes the
    // domain verb, Cancel disarms. One row armed at a time
    // (`convert-armed-row`, -1 = none).
    callback convert-armed(int);
    callback convert-confirmed(int);
    callback convert-cancelled();
    in property <int> convert-armed-row: -1;

    // The create flow (round-7 D-7.2): the header affordance asks,
    // the adapter arms (`create-open` — adapter-owned, pushed), the
    // inline form mounts below the header while armed AND editing is
    // visible (the convert strip's gate: a kiosk flip mid-flow
    // unmounts the form, the adapter keeps the flag, the form
    // remounts if editing returns). The commit seam returns `false`
    // on an absorbed miss — the field text is kept (the timers form's
    // convention); `true` clears the fields (dispatched).
    callback create-asked();
    callback create-confirmed(string, string, int) -> bool;
    callback create-cancelled();
    // The quota field's per-keystroke validity (the timers
    // `when-edited` twin): the adapter parses through the mint and
    // pushes the flavour.
    callback create-quota-edited(string);
    in property <bool> create-open: false;
    in property <FieldValidity> quota-validity: FieldValidity.neutral;
    in property <string> quota-error-hint;
    // The target picker's selection: UI-held until the commit seam
    // mints it (the timers insistence-index precedent — it is not
    // business data until the seam converts it). Index order
    // `[PerDay, PerWeek, PerMonth]`.
    in-out property <int> target-index: 0;

    background: transparent;
    accessible-role: AccessibleRole.region;
    accessible-label: "Habits";

    min-height: section-layout.preferred-height;
    max-height: section-layout.preferred-height;

    section-layout := VerticalLayout {
        vertical-stretch: 0;
        spacing: Theme.space-1;

        HorizontalLayout {
            spacing: Theme.space-2;
            RoleText {
                role: Typography.caption;
                text: "Habits";
                vertical-alignment: center;
            }
            RoleText {
                role: Typography.caption;
                text-color: Theme.text-secondary;
                text: root.habits.length;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            // The create affordance (round-7 D-7.2): editing-gated
            // exactly like the row actions (D-T16 — kiosk renders
            // rows, never actions). The label ≡ hover tip ≡ walk name.
            if (root.editing-visible): IconButton {
                icon: IconKind.plus;
                tone: Tone.success;
                label: "Add habit…";
                clicked => { root.create-asked(); }
            }
        }

        // The inline create form (round-7 D-7.2): title + the target
        // grammar. Commit fires on the title field's Return (the
        // create-row precedent); an absorbed miss keeps the text (the
        // rule-add seam's return convention). Empty quota text
        // commits as the default 1 — the placeholder states it.
        if (root.editing-visible && root.create-open): VerticalLayout {
            spacing: Theme.space-1;
            HorizontalLayout {
                spacing: Theme.space-2;
                title-field := TextField {
                    horizontal-stretch: 1;
                    placeholder: "Habit title";
                    label: "Habit title";
                    autofocus: false;
                    accepted(text) => {
                        if (root.create-confirmed(text, quota-field.text, root.target-index)) {
                            self.text = "";
                            quota-field.text = "";
                            // The picker re-seats on its default — a
                            // stale pick must not shape the next
                            // create (the fields' own reset
                            // convention).
                            root.target-index = 0;
                        }
                    }
                }
                quota-field := TextField {
                    horizontal-stretch: 1;
                    placeholder: "1";
                    label: "Quota (completions per period)";
                    validity: root.quota-validity;
                    autofocus: false;
                    edited(text) => { root.create-quota-edited(text); }
                    accepted(text) => {
                        if (root.create-confirmed(title-field.text, text, root.target-index)) {
                            self.text = "";
                            title-field.text = "";
                            root.target-index = 0;
                        }
                    }
                }
                SegmentedControl {
                    options: ["Per day", "Per week", "Per month"];
                    selected-index: root.target-index;
                    group-label: "Target";
                    picked(index) => { root.target-index = index; }
                }
                IconButton {
                    icon: IconKind.check;
                    tone: Tone.success;
                    label: "Create habit";
                    clicked => {
                        if (root.create-confirmed(title-field.text, quota-field.text, root.target-index)) {
                            title-field.text = "";
                            quota-field.text = "";
                            root.target-index = 0;
                        }
                    }
                }
                IconButton {
                    icon: IconKind.remove;
                    tone: Tone.neutral;
                    label: "Cancel create";
                    clicked => {
                        title-field.text = "";
                        quota-field.text = "";
                        root.target-index = 0;
                        root.create-cancelled();
                    }
                }
            }
            if (root.quota-validity == FieldValidity.invalid && quota-field.text != ""): RoleText {
                role: Typography.caption;
                text-color: Semantic.danger;
                text: root.quota-error-hint;
            }
        }

        for row[row-index] in root.habits: HorizontalLayout {
            spacing: Theme.space-2;

            list := ListRow {
                horizontal-stretch: 1;
                text: row.title;
                meta: row.progress
                    + (row.chip != "" ? "  @" + row.chip : "")
                    + (row.streak > 0 ? "  🔥" + row.streak : "");
                tone: row.met ? Tone.success : Tone.neutral;
            }
            if (root.editing-visible): VerticalLayout {
                IconButton {
                    icon: IconKind.chevron-left;
                    tone: Tone.neutral;
                    label: "Move habit up";
                    clicked => root.reorder-asked(row-index, row-index - 1);
                }
                IconButton {
                    icon: IconKind.chevron-right;
                    tone: Tone.neutral;
                    label: "Move habit down";
                    clicked => root.reorder-asked(row-index, row-index + 1);
                }
                IconButton {
                    icon: IconKind.plus;
                    tone: Tone.success;
                    label: "Log habit";
                    // Surplus logs are first-class: the button never
                    // disables at/after quota (D-P14); `met` restyled
                    // the row instead.
                    clicked => root.plus-clicked(row-index);
                }
                if (row.repair): IconButton {
                    icon: IconKind.plus;
                    tone: Tone.success;
                    // The make-up valve (issue #506, plan D-7): the
                    // click dispatches the exact (window, count) the
                    // row source resolved — the previous window's
                    // increment, no re-derivation.
                    label: "Add make-up +1 to yesterday";
                    clicked => root.repair-clicked(row-index);
                }
                if (root.convert-armed-row != row-index): IconButton {
                    icon: IconKind.calendar;
                    tone: Tone.neutral;
                    label: "Convert to repeating task: the habit retires, its history links to the new series";
                    clicked => root.convert-armed(row-index);
                }
            }
            // The armed confirm strip (issue #506, plan D-8): the
            // consequence names the mapping before anything dispatches.
            // Under the editing gate with its arm button: a kiosk flip
            // mid-flow unmounts the strip (actions never mount in
            // kiosk, D-P13) — the adapter keeps the armed flag, the
            // strip remounts if editing returns.
            if (root.editing-visible && root.convert-armed-row == row-index): HorizontalLayout {
                spacing: Theme.space-2;
                RoleText {
                    role: Typography.caption;
                    text-color: Theme.text-secondary;
                    text: "Converts to a daily repeating task; the quota has no series analog — each member is one completion.";
                    vertical-alignment: center;
                }
                IconButton {
                    icon: IconKind.check;
                    tone: Tone.success;
                    label: "Confirm conversion";
                    clicked => root.convert-confirmed(row-index);
                }
                IconButton {
                    icon: IconKind.remove;
                    tone: Tone.neutral;
                    label: "Cancel conversion";
                    clicked => root.convert-cancelled();
                }
            }
        }
    }
}
