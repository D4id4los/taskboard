// SPDX-License-Identifier: AGPL-3.0-only
// The habits section (DR-6/6, §4.6; H2 reworked): the today view's
// trackers render on the task-card substrate (US-1 — one set of
// instincts covers both; the card's done slot IS the +1 log control,
// surplus logs are first-class D-P14) with a horizontal action strip
// under each card at a task row's entry height (US-1/AC-1: +1, −1,
// the conditional make-up valve). Reorder and conversion moved to the
// row's context menu (H2 D3/D4 — the vertical stack and the armed
// strip retire; the menu keeps the consequence-first armed confirm,
// O-7 Q3).
// Renders on kiosk too (D-P13: passive progress visibility IS the
// section's point) — the actions are gated by enablement, not mount
// (the T-7 visible-gating grammar, #790: `editing-enabled` is false
// on kiosk and the log/strip affordances render the DISABLED tone,
// never unmounted — a greyed control reads "exists, not for this
// device"; the create editor flow stays unmountable from a disabled
// trigger).

import { Theme, Typography, RoleText, Tone, Semantic } from "../theme.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
import { TaskCard, TaskCardModel } from "../widgets/task-card.slint";
import { SegmentedControl } from "../widgets/segmented-control.slint";
import { FieldValidity, TextField } from "../widgets/text-field.slint";
import { DragState } from "../drag-state.slint";

// One tracker row on the card substrate (H2 D2): the card slots are
// the model derivation's (models::habit_card); the strip facts ride
// beside it — the make-up affordance's mount flag (issue #506) and
// its typed undo side (T-23, #806), plus the met restyle.
export struct HabitCardModel {
    card: TaskCardModel,
    // The make-up affordance's mount flag (issue #506): the previous
    // window is under quota and inside its overflow grace.
    repair: bool,
    // The repair's undo side (T-23, #806): true when the target
    // window already holds a log row (the adjustment inverts
    // exactly); false when the make-up CREATES the window's row. The
    // caption splits on it.
    repair-undoable: bool,
    met: bool,
}

export component HabitsSection inherits Rectangle {
    in property <[HabitCardModel]> habits;
    // The edit affordances' enablement (D-P13 remediated per UX R-1
    // D-2, #790): false on kiosk — the rows render AND so do the
    // actions, disabled (the greyed affordance posture).
    in property <bool> editing-enabled;
    // The row's focus fact (cross-surface friction plan D-2, #832):
    // activating the card mints the adapter's `focused_habit` — the
    // menu verbs' subject (click ≡ key composes both directions).
    // slint: habit-row-activated
    callback row-activated(int);
    // The done slot's log dispatch (US-1/S2): the card's done control
    // routes `habit.log` — clicking complete logs the habit.
    // slint: habits-log-clicked
    callback log-clicked(int);
    // The row's "−1" recovery affordance (UX R-2 D-3, #786): the
    // mis-click class recovers through the audited AdjustHabitLog
    // valve — the row's current window, count n−1. No quota floor,
    // never quota-enforced (D-P14 symmetrically); count 0 dispatches
    // nothing (NoTarget). Same editing-enabled gating as the +.
    callback undo-log-clicked(int);
    // The make-up +1 (issue #506): Rust resolves the exact
    // `(window, count)` from the same row source and dispatches
    // AdjustHabitLog — what you click is what increments.
    callback repair-clicked(int);
    // The right-click context request (H2 D4): pointer coords in
    // window coordinates — the same seam the task cards speak.
    // slint: habits-context-requested
    callback context-requested(int, float, float);
    // The pointer drag's gap-drop grammar (chunk 8 D5, US-4/AC-1 —
    // the #918 board pattern over the flat list): each card carries a
    // full-size child DropArea that resolves the gap edge from the
    // pointer geometry inside the delegate (indexes only cross to
    // Rust; the r2 D-E invariant). The aim-gap highlight is
    // section-local presentation state — the board delegate's
    // hairline reused, no new hint family; kiosk never arms (the
    // editing verb's gate, HAB-14).
    // slint: habits-drop-asked
    callback drop-asked(int, int);
    in-out property <int> aim-gap: -1;

    // The create flow (round-7 D-7.2): the header affordance asks,
    // the adapter arms (`create-open` — adapter-owned, pushed), the
    // inline form mounts below the header while armed AND editing is
    // visible (the convert strip's gate: a kiosk flip mid-flow
    // unmounts the form, the adapter keeps the flag, the form
    // remounts if editing returns). The commit seam returns `false`
    // on an absorbed miss — the field text is kept (the timers form's
    // convention); `true` clears the fields (dispatched).
    callback create-asked();
    callback create-confirmed(string, string, int) -> bool;
    callback create-cancelled();
    // The quota field's per-keystroke validity (the timers
    // `when-edited` twin): the adapter parses through the mint and
    // pushes the flavour.
    callback create-quota-edited(string);
    in property <bool> create-open: false;
    in property <FieldValidity> quota-validity: FieldValidity.neutral;
    in property <string> quota-error-hint;
    // The target picker's selection: UI-held until the commit seam
    // mints it (the timers insistence-index precedent — it is not
    // business data until the seam converts it). Index order
    // `[PerDay, PerWeek, PerMonth]`.
    in-out property <int> target-index: 0;

    background: transparent;
    accessible-role: AccessibleRole.region;
    accessible-label: "Habits";

    min-height: section-layout.preferred-height;
    max-height: section-layout.preferred-height;

    section-layout := VerticalLayout {
        vertical-stretch: 0;
        spacing: Theme.space-1;

        HorizontalLayout {
            spacing: Theme.space-2;
            RoleText {
                role: Typography.caption;
                text: "Habits";
                vertical-alignment: center;
            }
            RoleText {
                role: Typography.caption;
                text-color: Theme.text-secondary;
                text: root.habits.length;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            // The create affordance (round-7 D-7.2): editing-gated
            // exactly like the row actions (D-T16 — kiosk renders
            // rows, never actions). The label ≡ hover tip ≡ walk name.
            IconButton {
                icon: IconKind.plus;
                tone: Tone.success;
                label: "Add habit…";
                enabled: root.editing-enabled;
                clicked => { root.create-asked(); }
            }
        }

        // The inline create form (round-7 D-7.2): title + the target
        // grammar. Commit fires on the title field's Return (the
        // create-row precedent); an absorbed miss keeps the text (the
        // rule-add seam's return convention). Empty quota text
        // commits as the default 1 — the placeholder states it.
        if (root.editing-enabled && root.create-open): VerticalLayout {
            spacing: Theme.space-1;
            HorizontalLayout {
                spacing: Theme.space-2;
                title-field := TextField {
                    horizontal-stretch: 1;
                    placeholder: "Habit title";
                    label: "Habit title";
                    autofocus: false;
                    accepted(text) => {
                        if (root.create-confirmed(text, quota-field.text, root.target-index)) {
                            self.text = "";
                            quota-field.text = "";
                            // The picker re-seats on its default — a
                            // stale pick must not shape the next
                            // create (the fields' own reset
                            // convention).
                            root.target-index = 0;
                        }
                    }
                }
                quota-field := TextField {
                    horizontal-stretch: 1;
                    placeholder: "1";
                    label: "Quota (completions per period)";
                    validity: root.quota-validity;
                    autofocus: false;
                    edited(text) => { root.create-quota-edited(text); }
                    accepted(text) => {
                        if (root.create-confirmed(title-field.text, text, root.target-index)) {
                            self.text = "";
                            title-field.text = "";
                            root.target-index = 0;
                        }
                    }
                }
                SegmentedControl {
                    options: ["Per day", "Per week", "Per month"];
                    selected-index: root.target-index;
                    group-label: "Target";
                    picked(index) => { root.target-index = index; }
                }
                IconButton {
                    icon: IconKind.check;
                    tone: Tone.success;
                    label: "Create habit";
                    clicked => {
                        if (root.create-confirmed(title-field.text, quota-field.text, root.target-index)) {
                            title-field.text = "";
                            quota-field.text = "";
                            root.target-index = 0;
                        }
                    }
                }
                IconButton {
                    icon: IconKind.remove;
                    tone: Tone.neutral;
                    label: "Cancel create";
                    clicked => {
                        title-field.text = "";
                        quota-field.text = "";
                        root.target-index = 0;
                        root.create-cancelled();
                    }
                }
            }
            if (root.quota-validity == FieldValidity.invalid && quota-field.text != ""): RoleText {
                role: Typography.caption;
                text-color: Semantic.danger;
                text: root.quota-error-hint;
            }
        }

        // One habit = one card + its horizontal action strip (H2 D3):
        // the strip keeps the row's entry height (a task row's — no
        // fixed px, the card's own min-height governs) and the +1
        // stays an explicit affordance beside the done slot.
        for row[row-index] in root.habits: VerticalLayout {
            spacing: Theme.space-1;

            // The card's drag shell (chunk 8 D5): the board's DragArea
            // + child DropArea pattern — the arm fires on `dragging`
            // (not accept, so the card's own gestures stay), the gap
            // edge resolves from the pointer half inside the delegate,
            // and the release reports the aimed gap to the adapter
            // (which mints the floor-midpoint order and dispatches
            // `MoveHabit`). Kiosk never arms (HAB-14).
            drag-zone := DragArea {
                width: 100%;
                height: habit-card.preferred-height;
                allow-move: root.editing-enabled;
                data: DragState.payload;
                drag-finished(_) => {
                    root.aim-gap = -1;
                }
                habit-card := TaskCard {
                    model: row.card;
                    hint-keys: [];
                    activated => {
                        root.row-activated(row-index);
                    }
                    clicked => {
                        root.row-activated(row-index);
                    }
                    // The done slot IS the +1 log control (H2 D2): the
                    // card's done toggle routes the habit log — surplus
                    // logs are first-class, so `done` never flips.
                    done-toggled => {
                        root.log-clicked(row-index);
                    }
                    context-requested(x, y) => {
                        root.context-requested(row-index, x, y);
                    }
                }
                // The insertion indicator (the board delegate's
                // hairline, reused): a paint-only Rectangle at the
                // aimed gap's leading edge — the TouchAreas beneath
                // keep every click.
                if (root.aim-gap == row-index): Rectangle {
                    width: 100%;
                    height: 2px * Theme.base-scale;
                    y: 0;
                    background: Semantic.sync-active;
                    border-radius: Theme.radius-small;
                }
                gap-zone := DropArea {
                    width: 100%;
                    height: 100%;
                    can-drop(event) => {
                        root.aim-gap = event.position.y < habit-card.height / 2
                            ? row-index : row-index + 1;
                        root.editing-enabled ? DragAction.move : DragAction.none
                    }
                    dropped(event) => {
                        root.drop-asked(row-index,
                            event.position.y < habit-card.height / 2
                                ? row-index : row-index + 1);
                        root.aim-gap = -1;
                        return event.proposed-action;
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.space-2;
                IconButton {
                    icon: IconKind.plus;
                    tone: Tone.success;
                    label: "Log habit";
                    enabled: root.editing-enabled;
                    // Surplus logs are first-class: the button never
                    // disables at/after quota (D-P14); `met` restyled
                    // the card's progress chip instead.
                    clicked => root.log-clicked(row-index);
                }
                // The −1 recovery (UX R-2 D-3): symmetric with the
                // +1's risk profile — one click, no armed strip (the
                // frequency argument); itself reversible by +.
                IconButton {
                    icon: IconKind.remove;
                    tone: Tone.neutral;
                    label: "Take one habit log back";
                    enabled: root.editing-enabled;
                    clicked => root.undo-log-clicked(row-index);
                }
                if (row.repair): IconButton {
                    icon: IconKind.plus;
                    tone: Tone.success;
                    // The make-up valve (issue #506, plan D-7): the
                    // click dispatches the exact (window, count) the
                    // row source resolved — the previous window's
                    // increment, no re-derivation. The caption splits
                    // on the typed undo side (T-23, #806): the
                    // undoable side reads as the adjustment it is;
                    // the creating side names the consequence BEFORE
                    // the stroke (the recognized-positive bar — the
                    // feedback is never only after the fact).
                    label: row.repair-undoable
                        ? "Add make-up +1 to yesterday (adjusts the window's count; undoable)"
                        : "Add make-up +1 to yesterday (creates the window's first log row; cannot be undone)";
                    enabled: root.editing-enabled;
                    clicked => root.repair-clicked(row-index);
                }
            }
        }

        // The after-last insertion marker (the board's append twin):
        // the last card's drop zone aims gap `length` — the hairline
        // paints below the final strip, slint-local like the rest.
        if (root.aim-gap >= 0 && root.aim-gap >= root.habits.length): Rectangle {
            width: 100%;
            height: 2px * Theme.base-scale;
            background: Semantic.sync-active;
            border-radius: Theme.radius-small;
        }
    }
}
