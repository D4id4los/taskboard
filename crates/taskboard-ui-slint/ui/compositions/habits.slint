// SPDX-License-Identifier: AGPL-3.0-only
// The habits section (DR-6/6, §4.6; H2 reworked): the today view's
// trackers render on the task-card substrate (US-1 — one set of
// instincts covers both; the card's done slot IS the +1 log control,
// surplus logs are first-class D-P14) with a horizontal action strip
// under each card at a task row's entry height (US-1/AC-1: +1, −1,
// the conditional make-up valve). Reorder and conversion moved to the
// row's context menu (H2 D3/D4 — the vertical stack and the armed
// strip retire; the menu keeps the consequence-first armed confirm,
// O-7 Q3).
// Renders on kiosk too (D-P13: passive progress visibility IS the
// section's point) — the actions are gated by enablement, not mount
// (the T-7 visible-gating grammar, #790: `editing-enabled` is false
// on kiosk and the log/strip affordances render the DISABLED tone,
// never unmounted — a greyed control reads "exists, not for this
// device"; the create editor flow stays unmountable from a disabled
// trigger).

import { Theme, Typography, RoleText, Tone, Semantic } from "../theme.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
import { TaskCard, TaskCardModel } from "../widgets/task-card.slint";
import { SegmentedControl } from "../widgets/segmented-control.slint";
import { FieldValidity, TextField } from "../widgets/text-field.slint";
import { TippedField } from "../widgets/tipped-field.slint";
import { DragState } from "../drag-state.slint";
import { StatusNotice } from "../widgets/status-notice.slint";
import { SectionHeader } from "../widgets/section-header.slint";
import { TextButton, TextButtonEmphasis } from "../widgets/text-button.slint";
import { AnchorMirror } from "../widgets/anchored-overlay.slint";
import { HabitPauseFacts, HabitQuotaFacts } from "../menu-facts.slint";
import { TooltipState } from "../widgets/tooltip.slint";

// One tracker row on the card substrate (H2 D2): the card slots are
// the model derivation's (models::habit_card); the strip facts ride
// beside it — the make-up affordance's mount flag (issue #506) and
// its typed undo side (T-23, #806), plus the met restyle.
export struct HabitCardModel {
    card: TaskCardModel,
    // The make-up affordance's mount flag (issue #506): the previous
    // window is under quota and inside its overflow grace.
    repair: bool,
    // The repair's undo side (T-23, #806): true when the target
    // window already holds a log row (the adjustment inverts
    // exactly); false when the make-up CREATES the window's row. The
    // caption splits on it.
    repair-undoable: bool,
    // The typed target-met bit (W-2, #1199): the current window's
    // quota is met — the card's done slot renders the filled visual
    // until the window resets (window-aware by construction: the bit
    // folds the same period vocabulary the count does).
    met: bool,
    // The typed planned-skip bit (HF1, W-2): the current window is
    // marked skipped — the chip renders the skip state (display only).
    skip: bool,
    // The paused bit (HF1, W-4): a standing pause renders the badge
    // (display only).
    paused: bool,
    // The inclusive pause-through date (the badge's meta text; empty
    // while unpaused).
    paused-until: string,
    // The row's progress phrase ("3/8", W-5 #961): the strip's
    // clickable quota-edit affordance carries it (the same derivation
    // the card's decoration chip renders — one phrase, two mounts).
    progress-phrase: string,
    // #1315: the row card's tooltip hint-keys — the task-card
    // grammar's keymap projection (the row's edit verb's first
    // binding over the visible chain; shown only when a binding
    // exists).
    hint-keys: [string],
}

export component HabitsSection inherits Rectangle {
    in property <[HabitCardModel]> habits;
    // The edit affordances' enablement (D-P13 remediated per UX R-1
    // D-2, #790): false on kiosk — the rows render AND so do the
    // actions, disabled (the greyed affordance posture).
    in property <bool> editing-enabled;
    // The row's focus fact (cross-surface friction plan D-2, #832):
    // activating the card mints the adapter's `focused_habit` — the
    // menu verbs' subject (click ≡ key composes both directions).
    // slint: habit-row-activated
    callback row-activated(int);
    // The row's double-click editor opener (D3a W-4, #1201): the
    // task-card parity — double-click mounts the habit variant of the
    // shared editor (the adapter resolves the one-shot subject; the
    // kiosk gate is the landed dispatch-time refusal). Single click
    // keeps selecting only (A1's fixed grammar — one selection truth).
    // slint: habits-edit-asked
    callback edit-asked(int);
    // The done slot's log dispatch (US-1/S2): the card's done control
    // routes `habit.log` — clicking complete logs the habit.
    // slint: habits-log-clicked
    callback log-clicked(int);
    // The row's "−1" recovery affordance (UX R-2 D-3, #786): the
    // mis-click class recovers through the audited AdjustHabitLog
    // valve — the row's current window, count n−1. No quota floor,
    // never quota-enforced (D-P14 symmetrically); count 0 dispatches
    // nothing (NoTarget). Same editing-enabled gating as the +.
    callback undo-log-clicked(int);
    // The make-up +1 (issue #506): Rust resolves the exact
    // `(window, count)` from the same row source and dispatches
    // AdjustHabitLog — what you click is what increments.
    callback repair-clicked(int);
    // The inline quota edit's opener (W-5, #961): the row's progress
    // phrase is clickable (desktop; kiosk renders the affordance
    // disabled per R-3) — clicking mounts the quota popover over the
    // row (app-window-level AnchoredOverlayHost mount; the anchor
    // rides HabitQuotaFacts). The key twin is `HabitQuotaEdit` over
    // the focused row (click ≡ key).
    // slint: habits-quota-edit-asked
    callback quota-edit-asked(int);
    // The right-click context request (H2 D4): pointer coords in
    // window coordinates — the same seam the task cards speak.
    // slint: habits-context-requested
    callback context-requested(int, float, float);
    // The typed planned skip (HF1, W-1): the strip/menu affordance
    // routes `habit.skip` over the row (the streak survives the gap).
    // slint: habits-skip-asked
    callback skip-asked(int);
    // The row's play control (journey plan 2026-11-24 W-1, #1305):
    // routes `habit.track-toggle` over the row — the adapter resolves
    // the one-shot subject and the smart toggle picks the half.
    // slint: habits-track-asked
    callback track-asked(int);
    // The pause editor's opener (HF1, W-3): routes `habit.pause` —
    // the adapter resolves the one-shot subject and flips `pause-open`.
    // slint: habits-pause-asked
    callback pause-asked(int);
    // The pause editor's commit seam (HF1, W-3): the typed date is the
    // trust boundary (strict %Y-%m-%d in the adapter; the
    // recur-pause seam's convention). The destructive-role dismissal
    // law: cancel writes nothing.
    // slint: habits-pause-until-picked
    callback pause-until-picked(string);
    // slint: habits-pause-cancelled
    callback pause-cancelled();
    // The resume affordance (HF1, W-3): routes the None clear leg.
    // slint: habits-resume-asked
    callback resume-asked(int);
    // The pause editor's mount flag (adapter-owned, the create-open
    // precedent) and the resume affordance's mount fact (a standing
    // pause on any row mounts it; a paused row's resume is the
    // no-op-safe clear).
    in property <bool> pause-open: false;
    in property <bool> pause-mountable: false;
    // The pointer drag's gap-drop grammar (chunk 8 D5, US-4/AC-1 —
    // the #918 board pattern over the flat list): each card carries a
    // full-size child DropArea that resolves the gap edge from the
    // pointer geometry inside the delegate (indexes only cross to
    // Rust; the r2 D-E invariant). The aim-gap highlight is
    // section-local presentation state — the board delegate's
    // hairline reused, no new hint family; kiosk never arms (the
    // editing verb's gate, HAB-14).
    // slint: habits-drop-asked
    callback drop-asked(int, int);
    in-out property <int> aim-gap: -1;

    // The create flow (round-7 D-7.2): the header affordance asks,
    // the adapter arms (`create-open` — adapter-owned, pushed), the
    // inline form mounts below the header while armed AND editing is
    // visible (the convert strip's gate: a kiosk flip mid-flow
    // unmounts the form, the adapter keeps the flag, the form
    // remounts if editing returns). The commit seam returns `false`
    // on an absorbed miss — the field text is kept (the timers form's
    // convention); `true` clears the fields (dispatched).
    callback create-asked();
    callback create-confirmed(string, string, int) -> bool;
    callback create-cancelled();
    // The quota field's per-keystroke validity (the timers
    // `when-edited` twin): the adapter parses through the mint and
    // pushes the flavour.
    callback create-quota-edited(string);
    in property <bool> create-open: false;
    in property <FieldValidity> quota-validity: FieldValidity.neutral;
    in property <string> quota-error-hint;
    // The target picker's selection: UI-held until the commit seam
    // mints it (the timers insistence-index precedent — it is not
    // business data until the seam converts it). Index order
    // `[PerDay, PerWeek, PerMonth]`.
    in-out property <int> target-index: 0;

    // The deleted-habits restore section (#1290 enumeration + #1245
    // bulk restore; the undo-family journey plan US-2's amendment —
    // the roster enumerates in the labels-overlay section shape, one
    // row per tombstoned habit, each arming the same armed-confirm
    // grammar, plus one restore-all row behind its own confirm). Ids
    // stay adapter-side — the index resolves against the published
    // roster's row order; kiosk pushes empty rows (the affordances
    // render absent — the CLI carries the kiosk restore path, D-4).
    // slint: habit-restore-requested / habit-restore-cancelled /
    // habit-restore-all-requested / habit-restore-all-cancelled
    // (adapter: habit_restore_requested / habit_restore_cancelled /
    // habit_restore_all_requested / habit_restore_all_cancelled)
    in property <[string]> deleted-rows;
    in property <bool> has-deleted: false;
    in property <int> restore-armed-index: -1;
    in property <bool> restore-all-armed: false;
    callback habit-restore-requested(int);
    callback habit-restore-cancelled();
    callback habit-restore-all-requested();
    callback habit-restore-all-cancelled();

    background: transparent;
    accessible-role: AccessibleRole.region;
    accessible-label: "Habits";

    min-height: section-layout.preferred-height;
    max-height: section-layout.preferred-height;

    section-layout := VerticalLayout {
        vertical-stretch: 0;
        spacing: Theme.space-1;

        SectionHeader {
            title: "Habits";
            count: root.habits.length;
            // The create affordance (round-7 D-7.2): editing-gated
            // exactly like the row actions (D-T16 — kiosk renders
            // rows, never actions). The label ≡ hover tip ≡ walk name.
            IconButton {
                icon: IconKind.plus;
                tone: Tone.success;
                label: "Add habit…";
                enabled: root.editing-enabled;
                clicked => { root.create-asked(); }
            }
        }

        // The inline create form (round-7 D-7.2): title + the target
        // grammar. Commit fires on the title field's Return (the
        // create-row precedent); an absorbed miss keeps the text (the
        // rule-add seam's return convention). Empty quota text
        // commits as the default 1 — the placeholder states it.
        if (root.editing-enabled && root.create-open): VerticalLayout {
            spacing: Theme.space-1;
            HorizontalLayout {
                spacing: Theme.space-2;
                title-field := TextField {
                    horizontal-stretch: 1;
                    placeholder: "Habit title";
                    label: "Habit title";
                    autofocus: false;
                    accepted(text) => {
                        if (root.create-confirmed(text, quota-field.text, root.target-index)) {
                            self.text = "";
                            quota-field.text = "";
                            // The picker re-seats on its default — a
                            // stale pick must not shape the next
                            // create (the fields' own reset
                            // convention).
                            root.target-index = 0;
                        }
                    }
                }
                quota-field := TextField {
                    horizontal-stretch: 1;
                    placeholder: "1";
                    label: "Quota (completions per period)";
                    validity: root.quota-validity;
                    autofocus: false;
                    edited(text) => { root.create-quota-edited(text); }
                    accepted(text) => {
                        if (root.create-confirmed(title-field.text, text, root.target-index)) {
                            self.text = "";
                            title-field.text = "";
                            root.target-index = 0;
                        }
                    }
                }
                SegmentedControl {
                    options: ["Per day", "Per week", "Per month"];
                    selected-index: root.target-index;
                    group-label: "Target";
                    picked(index) => { root.target-index = index; }
                }
                IconButton {
                    icon: IconKind.check;
                    tone: Tone.success;
                    label: "Create habit";
                    clicked => {
                        if (root.create-confirmed(title-field.text, quota-field.text, root.target-index)) {
                            title-field.text = "";
                            quota-field.text = "";
                            root.target-index = 0;
                        }
                    }
                }
                IconButton {
                    icon: IconKind.remove;
                    tone: Tone.neutral;
                    label: "Cancel create";
                    clicked => {
                        title-field.text = "";
                        quota-field.text = "";
                        root.target-index = 0;
                        root.create-cancelled();
                    }
                }
            }
            if (root.quota-validity == FieldValidity.invalid && quota-field.text != ""): StatusNotice {
                text: root.quota-error-hint;
            }
        }

        // The pause editor (HF1, W-3): the section-level inline editor
        // (the create form's mount posture over the recur-pause
        // editor's field grammar) — one-shot subject resolved by the
        // opener, the commit seam parses strictly, cancel writes
        // nothing. Desktop-only (the editing verb's gate; kiosk is
        // structurally inert at the arm).
        if (root.editing-enabled && root.pause-open): VerticalLayout {
            spacing: Theme.space-1;
            // The rect publish (D3a W-7, #1208): the window-level
            // light-dismiss strips read this editor's realized
            // geometry from HabitPauseFacts — outside pointers
            // dismiss, the editor's own fields keep their clicks.
            AnchorMirror {
                source-x: pause-editor.absolute-position.x;
                source-y: pause-editor.absolute-position.y;
                source-width: pause-editor.width;
                source-height: pause-editor.height;
                published(x, y, w, h) => {
                    HabitPauseFacts.anchor-x = x;
                    HabitPauseFacts.anchor-y = y;
                    HabitPauseFacts.anchor-width = w;
                    HabitPauseFacts.anchor-height = h;
                }
            }
            pause-editor := HorizontalLayout {
                spacing: Theme.space-2;
                pause-field := TippedField {
                    horizontal-stretch: 1;
                    placeholder: "YYYY-MM-DD";
                    label: "Pause through date";
                    help: "The inclusive pause-through date; covered windows are neither counted nor missed.";
                    accepted(text) => { root.pause-until-picked(text); }
                }
                IconButton {
                    icon: IconKind.check;
                    tone: Tone.success;
                    label: "Pause through the typed date";
                    clicked => root.pause-until-picked(pause-field.text);
                }
                IconButton {
                    icon: IconKind.remove;
                    tone: Tone.neutral;
                    label: "Cancel pause";
                    clicked => root.pause-cancelled();
                }
            }
        }

        // One habit = one self-contained card (D3a W-3, #1199): the
        // detached action strip is gone — the row's actions ride the
        // card's trailing slot (the mount block above) and the
        // keyboard verbs keep their chords (US-3). The row keeps the
        // task row's entry height (the card's own min-height governs).
        for row[row-index] in root.habits: VerticalLayout {
            spacing: Theme.space-1;

            // The card's drag shell (chunk 8 D5): the board's DragArea
            // + child DropArea pattern — the arm fires on `dragging`
            // (not accept, so the card's own gestures stay), the gap
            // edge resolves from the pointer half inside the delegate,
            // and the release reports the aimed gap to the adapter
            // (which mints the floor-midpoint order and dispatches
            // `MoveHabit`). Kiosk never arms (HAB-14).
            drag-zone := DragArea {
                width: 100%;
                height: habit-card.preferred-height;
                allow-move: root.editing-enabled;
                data: DragState.payload;
                drag-finished(_) => {
                    root.aim-gap = -1;
                }
                habit-card := TaskCard {
                    model: row.card;
                    // #1315: the projected hint-keys ride the row model
                    // (the board cards' window-property grammar is the
                    // task surface's; the habit rows carry theirs in
                    // the card model).
                    hint-keys: row.hint-keys;
                    // W-1 (#1305): the play control is LIVE — the dead
                    // affordance's repair is the issue's own ask (D-7).
                    // Kiosk greys it (the editing verb's gate), never
                    // hides it (D-P13).
                    track-enabled: root.editing-enabled;
                    // slint: habits-track-asked
                    track-toggled => {
                        root.track-asked(row-index);
                    }
                    // The done slot labels the habit's own verb
                    // (#1286): it routes the +1 log, never the task
                    // done flip — the a11y pair names the log both
                    // ways (surplus is first-class; the slot never
                    // disables, W-2).
                    done-label: "Log habit +1";
                    done-undone-label: "Log habit +1";
                    activated => {
                        root.edit-asked(row-index);
                    }
                    clicked => {
                        root.row-activated(row-index);
                    }
                    // The done slot IS the +1 log control (H2 D2): the
                    // card's done control routes the habit log — surplus
                    // logs are first-class, so the met bit fills the
                    // slot's visual without ever disabling it (W-2).
                    done-toggled => {
                        root.log-clicked(row-index);
                    }
                    context-requested(x, y) => {
                        root.context-requested(row-index, x, y);
                    }
                    // The trailing action slot (D3a W-1/W-3, #1199):
                    // the row's actions ride the card line — the
                    // detached strip is gone, the redundant Log habit
                    // button with it (the done slot is the +1). The
                    // quota-edit affordance keeps its phrase anchor
                    // (the popover's AnchorMirror publishes from here),
                    // the −1 and the make-up valve are the typed
                    // undo side's mounts. Enablement is the editing
                    // verb's gate (kiosk greys, never hides — D-P13).
                    // The fixed slot line (the entry-height pin,
                    // #1018): the controls ride one Theme-token line
                    // so the card resolves to the task row's ladder
                    // step — the slot never grows the card.
                    slot := HorizontalLayout {
                        spacing: Theme.space-1;
                        height: Theme.space-6;
                        phrase-button := TextButton {
                            label: row.progress-phrase;
                            enabled: root.editing-enabled;
                            clicked => {
                                root.quota-edit-asked(row-index);
                            }
                            AnchorMirror {
                                source-x: phrase-button.absolute-position.x;
                                source-y: phrase-button.absolute-position.y;
                                source-width: phrase-button.width;
                                source-height: phrase-button.height;
                                published(x, y, w, h) => {
                                    HabitQuotaFacts.anchor-x = x;
                                    HabitQuotaFacts.anchor-y = y;
                                    HabitQuotaFacts.anchor-width = w;
                                    HabitQuotaFacts.anchor-height = h;
                                }
                            }
                        }
                        IconButton {
                            icon: IconKind.remove;
                            tone: Tone.neutral;
                            label: "Take one habit log back";
                            enabled: root.editing-enabled;
                            clicked => root.undo-log-clicked(row-index);
                        }
                        if (row.repair): IconButton {
                        icon: IconKind.plus;
                        tone: Tone.success;
                        // The make-up valve (issue #506, plan D-7): the
                        // click dispatches the exact (window, count) the
                        // row source resolved — the previous window's
                        // increment, no re-derivation. The caption splits
                        // on the typed undo side (T-23, #806): the
                        // undoable side reads as the adjustment it is;
                        // the creating side names the consequence BEFORE
                        // the stroke (the recognized-positive bar — the
                        // feedback is never only after the fact).
                        label: row.repair-undoable
                            ? "Add make-up +1 to yesterday (adjusts the window's count; undoable)"
                            : "Add make-up +1 to yesterday (creates the window's first log row; cannot be undone)";
                            enabled: root.editing-enabled;
                            clicked => root.repair-clicked(row-index);
                        }
                    }
                }
                // The insertion indicator (the board delegate's
                // hairline, reused): a paint-only Rectangle at the
                // aimed gap's leading edge — the TouchAreas beneath
                // keep every click.
                if (root.aim-gap == row-index): Rectangle {
                    width: 100%;
                    height: Theme.rule-width;
                    y: 0;
                    background: Semantic.sync-active;
                    border-radius: Theme.radius-small;
                }
                gap-zone := DropArea {
                    width: 100%;
                    height: 100%;
                    can-drop(event) => {
                        root.aim-gap = event.position.y < habit-card.height / 2
                            ? row-index : row-index + 1;
                        root.editing-enabled ? DragAction.move : DragAction.none
                    }
                    dropped(event) => {
                        root.drop-asked(row-index,
                            event.position.y < habit-card.height / 2
                                ? row-index : row-index + 1);
                        root.aim-gap = -1;
                        return event.proposed-action;
                    }
                }
            }
        }
        // The after-last insertion marker (the board's append twin):
        // the last card's drop zone aims gap `length` — the hairline
        // paints below the final card, slint-local like the rest.
        if (root.aim-gap >= 0 && root.aim-gap >= root.habits.length): Rectangle {
            width: 100%;
            height: Theme.rule-width;
            background: Semantic.sync-active;
            border-radius: Theme.radius-small;
        }

        // The deleted-habits restore section (#1290/#1245): mounted
        // only when the roster is non-empty (no dead chrome); the
        // armed strip names the subject and the consequence (the
        // D-2 grammar — the labels-overlay section's exact shape).
        if (root.has-deleted): VerticalLayout {
            spacing: Theme.space-1;
            RoleText {
                role: Typography.caption;
                text-color: Theme.text-secondary;
                text: "Deleted habits";
            }
            if (root.restore-armed-index >= 0): Rectangle {
                height: Theme.space-5 + Theme.space-2;
                border-radius: Theme.radius-small;
                background: Theme.surface-hover;
                border-width: Theme.focus-ring-width;
                border-color: Semantic.focus-ring;
                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-1;
                    spacing: Theme.space-2;
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "Restores “" + root.deleted-rows[root.restore-armed-index] + "” — it comes back verbatim and its log is untouched.";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    IconButton {
                        icon: IconKind.check;
                        tone: Tone.success;
                        label: "Confirm restore";
                        description: "Restores the armed habit.";
                        clicked => {
                            TooltipState.unhover();
                            root.habit-restore-requested(root.restore-armed-index);
                        }
                    }
                    IconButton {
                        icon: IconKind.remove;
                        tone: Tone.neutral;
                        label: "Cancel restore";
                        description: "Disarms the restore without dispatching.";
                        clicked => {
                            TooltipState.unhover();
                            root.habit-restore-cancelled();
                        }
                    }
                }
            }
            if (root.restore-all-armed): Rectangle {
                height: Theme.space-5 + Theme.space-2;
                border-radius: Theme.radius-small;
                background: Theme.surface-hover;
                border-width: Theme.focus-ring-width;
                border-color: Semantic.focus-ring;
                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-1;
                    spacing: Theme.space-2;
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "Restores all " + root.deleted-rows.length + " deleted habits — each comes back verbatim.";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    IconButton {
                        icon: IconKind.check;
                        tone: Tone.success;
                        label: "Confirm restore all";
                        description: "Restores every deleted habit.";
                        clicked => {
                            TooltipState.unhover();
                            root.habit-restore-all-requested();
                        }
                    }
                    IconButton {
                        icon: IconKind.remove;
                        tone: Tone.neutral;
                        label: "Cancel restore all";
                        description: "Disarms the bulk restore without dispatching.";
                        clicked => {
                            TooltipState.unhover();
                            root.habit-restore-all-cancelled();
                        }
                    }
                }
            }
            for row[index] in root.deleted-rows: Rectangle {
                height: Theme.space-5;
                border-radius: Theme.radius-small;
                background: deleted-touch.has-hover ? Theme.surface-hover : Theme.surface;
                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-1;
                    spacing: Theme.space-2;
                    RoleText {
                        role: Typography.caption;
                        text: row;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if (root.restore-armed-index != index): IconButton {
                        icon: IconKind.history;
                        tone: Tone.neutral;
                        label: "Restore habit " + row;
                        description: "Arms the restore: the habit comes back verbatim.";
                        clicked => {
                            TooltipState.unhover();
                            root.habit-restore-requested(index);
                        }
                    }
                }
                deleted-touch := TouchArea {}
            }
            // The bulk row (#1245, N2's answer): last in the section,
            // its own armed confirm — the same ceremony grammar, never
            // a click-through.
            if (root.restore-armed-index < 0 && !root.restore-all-armed): TextButton {
                label: "Restore all deleted habits";
                clicked => {
                    TooltipState.unhover();
                    root.habit-restore-all-requested();
                }
            }
        }
    }
}

// The inline quota editor's popover panel (W-5, #961): the stepper
// over the count and the period-kind phrase locked to the current
// kind (the inline edit is a one-number edit — kind change goes
// through the full editor, UX plan §2 habit.quota_edit). Mounts at
// the app-window level on the AnchoredOverlayHost over the row's
// progress phrase; commit routes `UpdateHabit` (existing command).
// The typed invalid-draft state: count 0 renders the invalid tone and
// blocks the commit — no route fires (US-4/AC-3).
export component HabitQuotaEditor inherits VerticalLayout {
    in property <int> count;
    in property <bool> valid: true;
    in property <string> kind-phrase;
    // The stepper rungs (+1/−1): the adapter holds the draft and its
    // typed validity; the floor is 0 (the invalid draft renders).
    callback stepped(int);
    callback committed();
    spacing: Theme.space-2;
    padding: Theme.space-2;

    HorizontalLayout {
        spacing: Theme.space-2;
        IconButton {
            icon: IconKind.remove;
            tone: Tone.neutral;
            label: "One quota step fewer";
            clicked => { root.stepped(-1); }
        }
        RoleText {
            vertical-stretch: 0;
            role: Typography.body;
            text: "\{root.count}";
            text-halign: center;
            text-color: root.valid ? Theme.text-primary : Semantic.danger;
        }
        IconButton {
            icon: IconKind.plus;
            tone: Tone.success;
            label: "One quota step more";
            clicked => { root.stepped(1); }
        }
        TextButton {
            label: root.kind-phrase;
            enabled: false;
            click-through: true;
        }
    }
    if (!root.valid): StatusNotice {
        text: "A quota of 0 cannot be saved — step back up to at least 1.";
    }
    HorizontalLayout {
        spacing: Theme.space-2;
        TextButton {
            label: "Save quota";
            emphasis: TextButtonEmphasis.cta;
            enabled: root.valid;
            clicked => { root.committed(); }
        }
    }
}
