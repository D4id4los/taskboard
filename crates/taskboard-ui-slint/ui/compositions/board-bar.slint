// SPDX-License-Identifier: AGPL-3.0-only
// The board-bar composition (L2, design §3.8): one segment per live
// board, the selected board highlighted — the compact stack switcher's
// segment pattern one level up (tab role, selected state, TouchArea
// click). Layout only; colours/tokens all from Theme (R1: no new
// primitive, no view-local restyle); clicks are the action layer's
// business (§5.1 — the callback routes through the adapter seam).

import { Theme, Semantic, Typography, RoleText } from "../theme.slint";
import { TooltipState } from "../widgets/tooltip.slint";

// One board-bar segment (a display model, not a bag of strings). The
// segment set is the live boards — an archived board is unreachable
// as a selection (the view-state normalization repairs it), so the
// model carries no archived field.
export struct BoardSegmentModel {
    title: string,
}

// The board bar's model (D2/D22): the live segments plus the selected
// index (a board index into the same pass's id tables).
export struct BoardBarModel {
    segments: [BoardSegmentModel],
    selected: int,
}

export component BoardBar inherits Rectangle {
    in property <BoardBarModel> bar;
    // The `board.select` binding as display strings (round-1 D21b; a
    // keymap projection — empty today, the mechanism is what ships).
    in property <[string]> segment-hint;
    callback segment-activated(int);
    // The segment right-click (r2 D21): select the board, then open
    // the board context menu at the pointer (the card precedent).
    callback segment-context(int, float, float);

    // Round-1 D20b: the bar is exactly one control tall — the
    // uncapped layout share that caused the tall whitespace is gone.
    height: Theme.space-6 + 2 * Theme.space-1;

    // The tab strip's baseline rule (r2 D36): one hairline of
    // `border` colour under the whole strip. Declared first, so the
    // tabs declared after paint over it — the active tab covers the
    // rule (it visibly "breaks" and merges into the board
    // background below, F-7's background-coloured gap).
    baseline := Rectangle {
        y: parent.height - self.height;
        width: 100%;
        height: Theme.hairline-width;
        background: Theme.border;
    }

    // A zero-segment model (a never-booted install) renders no row.
    if (root.bar.segments.length > 0): HorizontalLayout {
        spacing: Theme.space-1;
        accessible-role: AccessibleRole.tab-list;
        accessible-label: "Boards";
        for segment[segment-index] in root.bar.segments: tab := FocusScope {
            // A real tab stop (D15); the keyboard path for switching
            // is the action layer's board.next/previous.
            focus-on-tab-navigation: true;
            accessible-role: AccessibleRole.tab;
            accessible-label: segment.title;
            // Round-1 D20b: many boards share the row — a segment
            // caps at 160·scale and elides.
            max-width: 160px * Theme.base-scale;
            height: 100%;
            // The tab paint (r2 D36): the active tab is merged with
            // the content — full-height `background` paint with
            // rounded top corners only, no border (it covers the
            // rule and flows across the bar-to-content gap into the
            // board background); the inactive tab is a bordered
            // marker whose paint box ends on the rule (the uniform
            // Rectangle border is handled by geometry — the box is
            // one hairline short, the sides run down to the rule).
            // Rectangle borders are uniform, so there is no
            // open-bottom variant to omit.
            Rectangle {
                width: 100%;
                height: segment-index == root.bar.selected
                    ? parent.height
                    : parent.height - Theme.hairline-width;
                border-top-left-radius: Theme.radius-medium;
                border-top-right-radius: Theme.radius-medium;
                background: segment-index == root.bar.selected
                    ? Theme.background
                    : segment-hover.has-hover ? Theme.surface-hover
                    : transparent;
                // Keyboard focus swaps the frame to the ring in both
                // states (D-15) — the active tab's paint is otherwise
                // invisible against the content, so the ring is what
                // keeps keyboard focus visible (the a11y point).
                border-width: tab.has-focus ? Theme.focus-ring-width
                    : segment-index == root.bar.selected ? 0
                    : Theme.hairline-width;
                border-color: tab.has-focus ? Semantic.focus-ring
                    : Theme.border;
                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-2;
                    RoleText {
                        role: segment-index == root.bar.selected
                            ? Typography.body-emphasized
                            : Typography.body;
                        text-color: segment-index == root.bar.selected
                            ? Theme.text-primary
                            : Theme.text-secondary;
                        text: segment.title;
                        vertical-alignment: center;
                        // Round-1 D20b: many boards share the row.
                        overflow: elide;
                    }
                }
            }
            segment-hover := TouchArea {
                // The hover cue's owner (usability D2): the segment's
                // rest background reads this while hovered. The D21b
                // segment tooltip: title + what clicking does + the
                // board.select hint.
                changed has-hover => {
                    if (self.has-hover) {
                        TooltipState.hover(segment.title,
                            "Switches to this board.",
                            root.segment-hint,
                            self.absolute-position.x, self.absolute-position.y,
                            self.width, self.height);
                    } else {
                        TooltipState.unhover();
                    }
                }
                clicked => root.segment-activated(segment-index);
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down
                            && event.button == PointerEventButton.right) {
                        root.segment-context(segment-index,
                            self.absolute-position.x / 1px + self.mouse-x / 1px,
                            self.absolute-position.y / 1px + self.mouse-y / 1px);
                    }
                }
            }
        }
    }
}
