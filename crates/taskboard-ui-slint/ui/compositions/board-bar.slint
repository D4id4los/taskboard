// SPDX-License-Identifier: AGPL-3.0-only
// The board-bar composition (L2, design §3.8): one segment per live
// board, the selected board highlighted — the compact stack switcher's
// segment pattern one level up (tab role, selected state, TouchArea
// click). Layout only; colours/tokens all from Theme (R1: no new
// primitive, no view-local restyle); clicks are the action layer's
// business (§5.1 — the callback routes through the adapter seam).

import { Theme, Semantic, Typography, RoleText } from "../theme.slint";
import { TooltipState } from "../widgets/tooltip.slint";
import { Dropdown, DropdownConsumer, DropdownRow, DropdownIndicator, DropdownTone } from "../widgets/dropdown.slint";

// The walk's observation seam (r4 D40): the selector's open state and
// highlight, mirrored by the mounted dropdown's changed hooks (the
// journeys/probe's fact pattern).
export global BoardBarFacts {
    in-out property <bool> open: false;
    in-out property <int> highlight: 0;
    // The color-picker strip's anchor (UX R-4 D-1, #791): the bar's
    // realized window-space geometry, mirrored for the window-level
    // strip panel (the DropdownFacts mirror idiom).
    in-out property <length> anchor-x: 0;
    in-out property <length> anchor-y: 0;
    in-out property <length> anchor-width: 0;
    in-out property <length> anchor-height: 0;
    // The target-free BoardSelect flow (UX R-4 D-4, #794): the
    // adapter arms the switcher flyout — `switcher-request` makes
    // the switcher field visible in strip mode too (the bar swaps
    // to the field while picking); the open trigger rides the
    // `open-requested` callback chain (invoked, not observed — the
    // changed-hook timing is unreliable across a mount). The bar
    // clears the request when the flyout closes (the close loop's
    // tail), so the strip returns.
    in-out property <bool> switcher-request: false;
}

// One board-bar segment (a display model, not a bag of strings). The
// segment set is the live boards — an archived board is unreachable
// as a selection (the view-state normalization repairs it), so the
// model carries no archived field.
export struct BoardSegmentModel {
    title: string,
    // The board color's swatch echo (UX R-4 D-1, #791): derived
    // model-side through the shared `swatch_hex` gate — a six-hex
    // body renders the typed color, a lenient value renders
    // transparent (the dot collapses; the GUI never re-derives).
    color: color,
}

// The board bar's model (D2/D22): the live segments plus the selected
// index (a board index into the same pass's id tables).
export struct BoardBarModel {
    segments: [BoardSegmentModel],
    selected: int,
    // The shared dropdown's rows (r4 D40): one per segment (title,
    // no connection indicator — connection status is the connector
    // surfaces' business), pushed over the same pass.
    rows: [DropdownRow],
    // The archived-boards roster's rows (UX R-1 D-1, #785): one
    // title-only row per archived board, canonical order; empty when
    // nothing is archived — the trailing indicator mounts exactly
    // when this is non-empty (no dead affordance). Archived boards
    // stay excluded from `segments`/`rows` (the exclusion stands for
    // normal navigation — the roster is a separate affordance).
    archived-rows: [DropdownRow],
    // The platform gate (UX R-1 D-1 + the R-D2 grammar): desktop arms
    // the verb; kiosk renders the indicator a disabled affordance —
    // visible, grey, non-interactive (no new kiosk capability).
    archived-enabled: bool,
    // The roster's recognition cue (UX-R8 D-9, US-7, #834): true
    // exactly when the archived set is non-empty — the glyph rides
    // the same state so the kiosk-disabled affordance renders the
    // same cue grey (the flag exists so the cue is model-carried,
    // never slint-side derived).
    archived-cue: bool,
}

export component BoardBar inherits Rectangle {
    in property <BoardBarModel> bar;
    // The segment budget (r4 D40, the threshold verdict): past this
    // the strip degrades into an elided sea with no reachability
    // guarantee, and the shared dropdown takes the switcher role.
    // Markup-local (Q22 freezes the config surface); `always` is a
    // one-line change if review prefers it.
    in property <int> dropdown-at: 8;
    out property <bool> dropdown-mode: root.bar.segments.length > root.dropdown-at;
    // The `board.select` binding as display strings (round-1 D21b; a
    // keymap projection — empty today, the mechanism is what ships).
    in property <[string]> segment-hint;
    callback segment-activated(int);
    // The segment right-click (r2 D21): select the board, then open
    // the board context menu at the pointer (the card precedent).
    callback segment-context(int, float, float);
    // The archived-boards roster's row activation (UX R-1 D-1, #785):
    // the adapter seam resolves the index against the same pass's
    // archived-boards table, dispatches the unarchive, and re-selects
    // the restored board. Keyboard parity rides the shared dropdown's
    // own walk — no new ActionId (the chunk-plan D-1 non-goal).
    callback archived-activated(int);

    // The anchor's one-way mirror (the Dropdown widget's idiom):
    // window-space by definition; the derived-property wraps keep it
    // live across host scrolls.
    property <length> anchor-abs-x: root.absolute-position.x;
    property <length> anchor-abs-y: root.absolute-position.y;
    changed anchor-abs-x => {
        BoardBarFacts.anchor-x = self.anchor-abs-x;
        BoardBarFacts.anchor-width = root.width;
        BoardBarFacts.anchor-height = root.height;
    }
    changed anchor-abs-y => {
        BoardBarFacts.anchor-y = self.anchor-abs-y;
        BoardBarFacts.anchor-width = root.width;
        BoardBarFacts.anchor-height = root.height;
    }

    // The roster's mount rule (D-1's visibility law): exactly when the
    // archived set is non-empty.
    out property <bool> roster-mounted: root.bar.archived-rows.length > 0;
    // The indicator's fixed width — the switcher's reserved-zone
    // computation reads this property (a conditional element's id is
    // not accessible across mounts).
    property <length> roster-width: Theme.space-6 * 2;

    // Round-1 D20b: the bar is exactly one control tall — the
    // uncapped layout share that caused the tall whitespace is gone.
    height: Theme.space-6 + 2 * Theme.space-1;

    // The tab strip's baseline rule (r2 D36): one hairline of
    // `border` colour under the whole strip. Declared first, so the
    // tabs declared after paint over it — the active tab covers the
    // rule (it visibly "breaks" and merges into the board
    // background below, F-7's background-coloured gap).
    baseline := Rectangle {
        y: parent.height - self.height;
        width: 100%;
        height: Theme.hairline-width;
        background: Theme.border;
    }

    // D40: past the budget the dropdown replaces the strip (the same
    // one-control height rule, round-1 D20b — the bar's own height
    // stands). `row-context` stays unwired: the board context menu is
    // strip-only (the flyout must not host it here — the
    // overlay-over-flyout dismissal ordering is unprobed); in
    // dropdown mode the menu stays reachable through the action menu.
    // The close loop's tail (the adapter's request protocol): the
    // flyout's close (Escape, the underlay, the row activation)
    // clears the request, returning the strip in strip mode. A
    // no-op in dropdown mode (the field is permanent there).
    property <bool> facts-open-mirror: BoardBarFacts.open;
    changed facts-open-mirror => {
        if (!self.facts-open-mirror) {
            BoardBarFacts.switcher-request = false;
        }
    }

    // The switcher dropdown (always mounted, UX R-4 D-4: the
    // target-free BoardSelect flow's trigger is a property write, so
    // the instance must exist to receive it — the conditional mount
    // would race the init evaluation). Visible in dropdown mode
    // permanently; in strip mode only while the flyout is requested
    // (the bar swaps to the field while picking).
    // The flyout open trigger (UX R-4 D-4, #794): the request flag's
    // false→true edge invokes the dropdown's open arms (the changed
    // delivery rides the event loop; the adapter sets the flag and
    // the walk opens). Re-arming re-fires: the close loop clears the
    // flag first, so the next set is a fresh edge.
    property <bool> request-mirror: BoardBarFacts.switcher-request;
    changed request-mirror => {
        if (self.request-mirror) {
            bar-dd.open-requested();
        }
    }

    bar-dd := Dropdown {
        visible: root.dropdown-mode || BoardBarFacts.switcher-request;
        x: Theme.space-1;
        // The trailing roster's reserved zone (D-1): the switcher
        // yields the indicator's width so the two dropdowns never
        // overlap in the bar's one-control row.
        width: parent.width - 2 * Theme.space-1
            - (root.roster-mounted ? root.roster-width + Theme.space-1 : 0);
        y: Theme.space-1;
        height: parent.height - 2 * Theme.space-1;
        rows: root.bar.rows;
        selected-index: root.bar.selected;
        // The class-facts consumer kind (round-5 D6, de-sited round-9
        // chunk 15): the switcher's flyout renders window-level from
        // the ONE generic mount, keyed on `board-switcher`.
        consumer: DropdownConsumer.board-switcher;
        field-text: root.bar.segments.length > 0
            ? root.bar.segments[root.bar.selected].title
            : "";
        field-label: "Boards";
        field-description: "Switches the viewed board.";
        row-activated(i) => {
            root.segment-activated(i);
        }
        row-hovered(i, x, y, w, h) => {
            TooltipState.hover(
                root.bar.rows[i].label,
                "Switches to this board.",
                root.segment-hint,
                x, y, w, h);
        }
        row-unhovered() => {
            TooltipState.unhover();
        }
        changed open => {
            BoardBarFacts.open = self.open;
        }
        changed highlight => {
            BoardBarFacts.highlight = self.highlight;
        }
    }

    // The archived-boards roster (UX R-1 D-1, #785): a trailing
    // indicator that opens the shared dropdown of archived boards —
    // title-only rows, the compact switcher's row pattern (the
    // keyboard walk is the widget's own). Mounted exactly while the
    // archived set is non-empty; activating a row routes the
    // unarchive seam. Declared last so it paints over the strip's
    // right end in strip mode (the segments' 160px cap leaves the
    // trailing zone free at any realistic count; the zone is
    // reserved outright in dropdown mode).
    if (root.roster-mounted): roster-dd := Dropdown {
        x: parent.width - self.width - Theme.space-1;
        y: Theme.space-1;
        height: parent.height - 2 * Theme.space-1;
        // The count IS the indicator (the honest signal): the closed
        // field shows how many boards sit archived. A fixed two-cell
        // width — the count is one or two digits, the chevron rides
        // the field's own layout.
        width: root.roster-width;
        field-enabled: root.bar.archived-enabled;
        rows: root.bar.archived-rows;
        // No selected row — the roster is an action list, not a
        // selection (the unarchive does not switch away from the
        // viewed board until the restored board re-selects).
        selected-index: -1;
        consumer: DropdownConsumer.board-archived;
        field-text: "\{root.bar.archived-rows.length}";
        field-glyph: root.bar.archived-cue;
        field-label: "Archived boards";
        field-description: "Opens the archived boards: activating a row restores the board to the bar.";
        row-activated(i) => {
            root.archived-activated(i);
        }
        row-hovered(i, x, y, w, h) => {
            TooltipState.hover(
                root.bar.archived-rows[i].label,
                "Restores this archived board to the bar.",
                [],
                x, y, w, h);
        }
        row-unhovered() => {
            TooltipState.unhover();
        }
    }

    // A zero-segment model (a never-booted install) renders no row;
    // under the budget the reviewed strip stays.
    if (!root.dropdown-mode && root.bar.segments.length > 0
            && !BoardBarFacts.switcher-request): HorizontalLayout {
        spacing: Theme.space-1;
        accessible-role: AccessibleRole.tab-list;
        accessible-label: "Boards";
        for segment[segment-index] in root.bar.segments: tab := FocusScope {
            // A real tab stop (D15); the keyboard path for switching
            // is the action layer's board.next/previous.
            focus-on-tab-navigation: true;
            accessible-role: AccessibleRole.tab;
            accessible-label: segment.title;
            // Round-1 D20b: many boards share the row — a segment
            // caps at 160·scale and elides.
            max-width: 160px * Theme.base-scale;
            height: 100%;
            // The tab paint (r2 D36): the active tab is merged with
            // the content — full-height `background` paint with
            // rounded top corners only, no border (it covers the
            // rule and flows across the bar-to-content gap into the
            // board background); the inactive tab is a bordered
            // marker whose paint box ends on the rule (the uniform
            // Rectangle border is handled by geometry — the box is
            // one hairline short, the sides run down to the rule).
            // Rectangle borders are uniform, so there is no
            // open-bottom variant to omit.
            Rectangle {
                width: 100%;
                height: segment-index == root.bar.selected
                    ? parent.height
                    : parent.height - Theme.hairline-width;
                border-top-left-radius: Theme.radius-medium;
                border-top-right-radius: Theme.radius-medium;
                background: segment-index == root.bar.selected
                    ? Theme.background
                    : segment-hover.has-hover ? Theme.surface-hover
                    : transparent;
                // Keyboard focus swaps the frame to the ring in both
                // states (D-15) — the active tab's paint is otherwise
                // invisible against the content, so the ring is what
                // keeps keyboard focus visible (the a11y point).
                border-width: tab.has-focus ? Theme.focus-ring-width
                    : segment-index == root.bar.selected ? 0
                    : Theme.hairline-width;
                border-color: tab.has-focus ? Semantic.focus-ring
                    : Theme.border;
                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-2;
                    spacing: Theme.space-1;
                    // The board color's dot (UX R-4 D-1, #791): the
                    // swatch echo rides the strip segments only (the
                    // dropdown mode's echo stays the field text — the
                    // recorded scoping). A transparent (lenient)
                    // color renders as an invisible slot of the same
                    // width — the row keeps its rhythm.
                    Rectangle {
                        width: Theme.space-2;
                        height: self.width;
                        y: (parent.height - self.height) / 2;
                        border-radius: self.width / 2;
                        background: segment.color;
                    }
                    RoleText {
                        role: segment-index == root.bar.selected
                            ? Typography.body-emphasized
                            : Typography.body;
                        text-color: segment-index == root.bar.selected
                            ? Theme.text-primary
                            : Theme.text-secondary;
                        text: segment.title;
                        vertical-alignment: center;
                        // Round-1 D20b: many boards share the row.
                        overflow: elide;
                    }
                }
            }
            segment-hover := TouchArea {
                // The hover cue's owner (usability D2): the segment's
                // rest background reads this while hovered. The D21b
                // segment tooltip: title + what clicking does + the
                // board.select hint.
                changed has-hover => {
                    if (self.has-hover) {
                        TooltipState.hover(segment.title,
                            "Switches to this board.",
                            root.segment-hint,
                            self.absolute-position.x, self.absolute-position.y,
                            self.width, self.height);
                    } else {
                        TooltipState.unhover();
                    }
                }
                clicked => root.segment-activated(segment-index);
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down
                            && event.button == PointerEventButton.right) {
                        root.segment-context(segment-index,
                            self.absolute-position.x / 1px + self.mouse-x / 1px,
                            self.absolute-position.y / 1px + self.mouse-y / 1px);
                    }
                }
            }
        }
    }
}
