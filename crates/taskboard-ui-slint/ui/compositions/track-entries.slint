// SPDX-License-Identifier: AGPL-3.0-only
// The time-entries overlay panel (r4 chunk 10, D35/D-TS1/D-TS3): the
// anchored modal over the task view's summary row — the Work-only
// total at the top (the summary row's `tracked_total` verbatim), the
// entries ListView in newest-first display order, and the add
// affordance in the footer (it joins with the form surface's
// commit). Rendering is local-zone echo (the chunk-7 rule); the row
// carries display parts only — the entry ids resolve Rust-side
// through the `IdTables` index seam, never viewport offsets. The
// running row's elapsed accrues through the adapter's per-second
// seam (D-TS9 — no driver change; the panel is a seconds surface
// while the subject holds an open entry).
//
// Escape / outside click ride the action layer's dismissal (the
// window-level layer + the `TrackEntries` context's rows); the panel
// is one FocusScope root with the declared walk order (blanket rule
// b). Every dispatch is a callback (§5.1).

import { Theme, Typography, Semantic, RoleText, Tone } from "../theme.slint";
import { IconButton } from "../widgets/icon-button.slint";
import { ListView } from "../widgets/listview.slint";
import { TooltipState } from "../widgets/tooltip.slint";
import { StatusDot } from "../widgets/status-dot.slint";
import { TextField, FieldValidity } from "../widgets/text-field.slint";
import { TimeField, TimeSlotRow } from "../widgets/time-field.slint";
import { DatePicker, DueDayModel } from "./date-picker.slint";
import { KbdHint } from "../widgets/kbd-hint.slint";
import { IconKind } from "../widgets/icon.slint";
export { TimeSlotRow, FieldValidity }

// One entries row: display parts only (D2 — ids stay in the
// adapter's tables). `running` drives the status-dot mark; the end
// cell names the running state via the pushed copy; `end-other-day`
// is the midnight-crossing mark's bit (the adapter's `+1d` suffix
// rides the pushed end text).
export struct TrackEntryRowModel {
    date: string,
    start: string,
    end: string,
    spent: string,
    running: bool,
}

export component TrackEntriesPanel inherits Rectangle {
    in property <[TrackEntryRowModel]> rows;
    // The header total — the summary row's pushed phrase verbatim
    // (reconciliation by construction: reuse, not a parallel
    // reduction).
    in property <string> total;
    // The add affordance's visibility (r4 D-TS8's model-side gate:
    // the kiosk refuses the form surface with the overlay itself).
    in property <bool> add-visible: true;
    // The one-shot focus grab (the TimerSetter's nonce idiom — a
    // mount-time init grab alone is dropped).
    in property <int> focus-nonce: 0;
    changed focus-nonce => { panel-scope.focus(); }

    // The form surface's pushed halves (r4 D-TS4): the add (`None`
    // seed) / edit (`Some`) form replaces the list in-place — the
    // date field over its embedded month grid (chunk 7's DatePicker
    // composition with `show-time: false`), the two TimeFields
    // (D26's lenient grammar), and the commit on the end field's
    // Return (F24). The validity halves are the tri-state mirrors
    // the due editor pushes (the parse lives in the pure layer).
    in property <bool> form-open: false;
    in property <string> form-date-text: "";
    in property <FieldValidity> form-date-validity: FieldValidity.neutral;
    in property <string> form-date-hint;
    in property <bool> form-grid-open: false;
    in property <[[DueDayModel]]> form-grid;
    in property <bool> form-grid-focus: false;
    in property <string> form-start-text: "--:--";
    in property <FieldValidity> form-start-validity: FieldValidity.neutral;
    in property <string> form-start-hint;
    in property <[TimeSlotRow]> form-start-slots;
    in property <int> form-start-nearest-row: 0;
    in property <string> form-end-text: "--:--";
    in property <FieldValidity> form-end-validity: FieldValidity.neutral;
    in property <string> form-end-hint;
    in property <[TimeSlotRow]> form-end-slots;
    in property <int> form-end-nearest-row: 0;

    // The form's intents (§5.1): no inline side effects — the parse,
    // the seed-on-step, the mask assembly, and the commit gate all
    // live in the adapter/pure layer.
    callback date-edited(string);
    callback date-grid-toggled();
    callback date-grid-key(int);
    callback date-day-clicked(int);
    callback start-edited(string);
    callback start-stepped(int);
    callback start-picked(int);
    callback end-edited(string);
    callback end-stepped(int);
    callback end-picked(int);
    // The commit funnel (F24's Enter-commits rule): `true` = the
    // flow steps back to the list (the absorbed-miss convention
    // keeps the form open with the invalid flavour on `false`).
    callback commit-requested() -> bool;
    // The commit's accepted half: the adapter stepped the flow back;
    // the surface swap rides the push.
    callback form-committed();

    // The intents (§5.1): no inline side effects.
    callback row-activated(int);
    callback add-requested();
    // The armed delete (D-TS5): the first activate arms (the tone
    // flips danger, the copy names the confirm), the second
    // dispatches. The armed row's index is the window's pushed
    // mirror (the adapter holds the armed id; the index seam
    // resolves it — a refresh that drops the row renders unarmed).
    callback delete-clicked(int);
    in property <int> armed-index: -1;

    background: Theme.surface-raised;
    border-radius: Theme.radius-small;
    border-width: Theme.focus-ring-width;
    border-color: Theme.border;
    accessible-role: AccessibleRole.region;
    accessible-label: "Time entries";

    min-height: form-open ? form-layout-height : list-layout-height;
    // Content-sized per surface (the timers section's pinned-ends
    // discipline); the two conditional layouts' preferred heights
    // are mirrored here through the derived-property idiom — the
    // direct read would cycle (`preferred-height` ↔ `layoutinfo`).
    // One-space inits (the lint's token rule): the first layout pass
    // overwrites them via the `changed` mirrors below.
    property <length> list-layout-height: Theme.space-1;
    property <length> form-layout-height: Theme.space-1;
    min-width: 360px * Theme.base-scale;

    // The walk order (blanket rule b): rows → (the footer's add, when
    // visible). Enter on a row activates (edit); the row's tip names
    // the span.
    panel-scope := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-tab-navigation: true;
        init => { self.focus(); }
        VerticalLayout {
            // The form surface (r4 D-TS4): replaces the list
            // in-place; the ladder steps back. The embedded grid
            // mounts INSIDE the panel (no second window-level mount,
            // no `DatePickerFacts` contest — the due editor cannot be
            // open while this modal overlay holds the chain).
            if (root.form-open): Rectangle {
                form-scope := FocusScope {
                    width: 100%;
                    height: 100%;
                    focus-on-tab-navigation: true;
                    init => { self.focus(); }
                    VerticalLayout {
                        changed preferred-height => { root.form-layout-height = self.preferred-height; }
                        padding: Theme.space-3;
                        spacing: Theme.space-2;
                        // The date row: the typed field over the
                        // grid toggle; the hint is the syntax copy.
                        HorizontalLayout {
                            spacing: Theme.space-1;
                            TextField {
                                horizontal-stretch: 1;
                                placeholder: "YYYY-MM-DD";
                                label: "Date";
                                description: "The entry's local date; the grid picks it too.";
                                initial-text: root.form-date-text;
                                validity: root.form-date-validity;
                                autofocus: false;
                                edited(text) => { root.date-edited(text); }
                            }
                            IconButton {
                                icon: IconKind.calendar;
                                label: "Calendar";
                                description: "Opens the month grid for the entry's date.";
                                clicked => { root.date-grid-toggled(); }
                            }
                        }
                        if (root.form-date-validity == FieldValidity.invalid): RoleText {
                            role: Typography.caption;
                            text-color: Semantic.danger;
                            text: root.form-date-hint;
                        }
                        if (root.form-grid-open): DatePicker {
                            show-time: false;
                            caption: "";
                            grid: root.form-grid;
                            focus-on-mount: root.form-grid-focus;
                            picker-key(k) => { root.date-grid-key(k); }
                            day-clicked(c) => { root.date-day-clicked(c); }
                        }
                        // The span: the two TimeFields over the one
                        // lenient grammar (D26); the end field's
                        // Return commits (F24).
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            TimeField {
                                horizontal-stretch: 1;
                                time-text: root.form-start-text;
                                validity: root.form-start-validity;
                                error-hint: root.form-start-hint;
                                label: "Start";
                                description: "The span's start; type HH:MM, step, or pick.";
                                slot-rows: root.form-start-slots;
                                nearest-row: root.form-start-nearest-row;
                                edited(text) => { root.start-edited(text); }
                                stepped(n) => { root.start-stepped(n); }
                                picked(m) => { root.start-picked(m); }
                            }
                            TimeField {
                                horizontal-stretch: 1;
                                time-text: root.form-end-text;
                                validity: root.form-end-validity;
                                error-hint: root.form-end-hint;
                                label: "End";
                                description: "The span's end; empty keeps the entry running.";
                                slot-rows: root.form-end-slots;
                                nearest-row: root.form-end-nearest-row;
                                edited(text) => { root.end-edited(text); }
                                stepped(n) => { root.end-stepped(n); }
                                picked(m) => { root.end-picked(m); }
                                accepted(text) => {
                                    if (root.commit-requested()) {
                                        // The commit steps the
                                        // surface back to the list
                                        // (the ladder's forward
                                        // direction is the commit's).
                                        root.form-committed();
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // The list surface (D-TS3): hidden while the form holds.
            if (!root.form-open): VerticalLayout {
            panel-layout := VerticalLayout {
                changed preferred-height => { root.list-layout-height = self.preferred-height; }
                padding: Theme.space-3;
                spacing: Theme.space-2;
                // The header total: the summary row's vocabulary, at
                // seconds precision (F16). The tip carries the same
                // description the summary row's total does.
                HorizontalLayout {
                    spacing: Theme.space-3;
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "Tracked";
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        accessible-role: AccessibleRole.text;
                        accessible-label: "Tracked time total";
                        RoleText {
                            role: Typography.mono;
                            text: root.total;
                        }
                    }
                }
                // The rows (D-TS3): newest-first pushed order; a
                // midnight-crossing end carries the pushed `+1d`
                // mark; the running row renders the status dot.
                ListView {
                    height: min(root.rows.length * Theme.space-6, Theme.space-6 * 8);
                    for row[row-index] in root.rows: Rectangle {
                        height: Theme.space-6;
                        row-hit := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.row-activated(row-index); }
                            changed has-hover => {
                                if (self.has-hover) {
                                    TooltipState.hover(
                                        row.date + " " + row.start + " – " + row.end,
                                        "Edits the time entry.",
                                        [],
                                        self.absolute-position.x,
                                        self.absolute-position.y,
                                        self.width,
                                        self.height,
                                    );
                                } else {
                                    TooltipState.unhover();
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            padding-left: Theme.space-2;
                            padding-right: Theme.space-2;
                            if (row.running): StatusDot {
                                y: (parent.height - self.height) / 2;
                            }
                            RoleText {
                                role: Typography.mono;
                                text: row.date;
                                vertical-alignment: center;
                            }
                            RoleText {
                                role: Typography.mono;
                                text: row.start;
                                vertical-alignment: center;
                            }
                            RoleText {
                                role: Typography.mono;
                                text: row.running ? "–" : row.end;
                                text-color: row.running ? Semantic.success : Theme.text-primary;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            RoleText {
                                role: Typography.mono;
                                text: row.spent;
                                text-color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                            // The delete affordance (D-TS5): the
                            // journal classifies `DeleteTimeEntry`
                            // NotUndoable, so the affordance carries
                            // its own confirmation — arm on the
                            // first activate, dispatch on the
                            // second. No timer-based disarm: nothing
                            // ticks (the fence).
                            IconButton {
                                icon: IconKind.trash;
                                tone: row-index == root.armed-index ? Tone.danger : Tone.neutral;
                                label: row-index == root.armed-index
                                    ? "Confirm delete"
                                    : "Delete time entry";
                                description: row-index == root.armed-index
                                    ? "Deletes the entry. This cannot be undone — activate again to confirm."
                                    : "Arms the delete for this entry; activate again to confirm.";
                                clicked => { root.delete-clicked(row-index); }
                            }
                        }
                    }
                }
                // The footer add affordance (D-TS4): routes the
                // add-requested seam (click ≡ key, §7.1).
                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: start;
                    add-touch := Rectangle {
                        height: Theme.space-6;
                        min-width: Theme.space-6 * 4;
                        border-radius: Theme.radius-small;
                        border-width: add-focus.has-focus ? Theme.focus-ring-width : 0;
                        border-color: Semantic.focus-ring;
                        background: add-hit.has-hover ? Theme.surface-hover : Theme.surface-raised;
                        add-focus := FocusScope {
                            width: 100%;
                            height: 100%;
                            focus-on-tab-navigation: true;
                            accessible-role: AccessibleRole.button;
                            accessible-label: "Add time entry";
                            accessible-description: "Opens the entry form to log a block of work.";
                            accessible-action-default => { root.add-requested(); }
                            key-pressed(event) => {
                                if (event.text == Key.Return || event.text == " ") {
                                    root.add-requested();
                                    accept
                                } else {
                                    reject
                                }
                            }
                        }
                        add-hit := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                TooltipState.unhover();
                                root.add-requested();
                            }
                            changed has-hover => {
                                if (self.has-hover) {
                                    TooltipState.hover(
                                        "Add time entry",
                                        "Opens the entry form to log a block of work.",
                                        [],
                                        self.absolute-position.x,
                                        self.absolute-position.y,
                                        self.width,
                                        self.height,
                                    );
                                } else {
                                    TooltipState.unhover();
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: Theme.space-3;
                            padding-right: Theme.space-3;
                            alignment: center;
                            RoleText {
                                role: Typography.body;
                                text-color: add-hit.has-hover ? Theme.text-primary : Theme.text-secondary;
                                text: "Add entry";
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            }
        }
    }
}
