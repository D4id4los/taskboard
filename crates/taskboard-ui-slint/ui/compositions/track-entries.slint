// SPDX-License-Identifier: AGPL-3.0-only
// The time-entries overlay panel (r4 chunk 10, D35/D-TS1/D-TS3): the
// anchored modal over the task view's summary row — the Work-only
// total at the top (the summary row's `tracked_total` verbatim), the
// entry rows in newest-first display order (a plain column), and the add
// affordance in the footer (it joins with the form surface's
// commit). Rendering is local-zone echo (the chunk-7 rule); the row
// carries display parts only — the entry ids resolve Rust-side
// through the `IdTables` index seam, never viewport offsets. The
// running row's elapsed accrues through the adapter's per-second
// seam (D-TS9 — no driver change; the panel is a seconds surface
// while the subject holds an open entry).
//
// Escape / outside click ride the action layer's dismissal (the
// window-level layer + the `TrackEntries` context's rows); the panel
// is one FocusScope root with the declared walk order (blanket rule
// b). Every dispatch is a callback (§5.1).

import { Theme, Typography, Semantic, RoleText, Tone } from "../theme.slint";
import { IconButton } from "../widgets/icon-button.slint";
import { TooltipState } from "../widgets/tooltip.slint";
import { StatusDot } from "../widgets/status-dot.slint";
import { PressableRow } from "../widgets/pressable-row.slint";
import { TextField, FieldValidity } from "../widgets/text-field.slint";
import { MaskWalkFacts } from "../mask-walk-facts.slint";
import { TimeField, TimeSlotRow } from "../widgets/time-field.slint";
import { DueDayModel } from "./date-picker.slint";
import { KbdHint } from "../widgets/kbd-hint.slint";
import { IconKind } from "../widgets/icon.slint";
import { TrackPanelFacts, TrackPanelWalkFacts } from "../track-panel-facts.slint";
import { AnchorMirror } from "../widgets/anchored-overlay.slint";
export { TimeSlotRow, FieldValidity }

// One entries row: display parts only (D2 — ids stay in the
// adapter's tables). `running` drives the status-dot mark; the end
// cell names the running state via the pushed copy; `end-other-day`
// is the midnight-crossing mark's bit (the adapter's `+1d` suffix
// rides the pushed end text).
export struct TrackEntryRowModel {
    date: string,
    start: string,
    end: string,
    spent: string,
    running: bool,
}

export component TrackEntriesPanel inherits Rectangle {
    in property <[TrackEntryRowModel]> rows;
    // The header total — the summary row's pushed phrase verbatim
    // (reconciliation by construction: reuse, not a parallel
    // reduction).
    in property <string> total;

    // The form surface's pushed halves (r4 D-TS4): the add (`None`
    // seed) / edit (`Some`) form replaces the list in-place — the
    // date field over its embedded month grid (chunk 7's DatePicker
    // composition with `show-time: false`), the two TimeFields
    // (D26's lenient grammar), and the commit on the end field's
    // Return (F24). The validity halves are the tri-state mirrors
    // the due editor pushes (the parse lives in the pure layer).
    in property <bool> form-open: false;
    in property <string> form-date-text: "";
    in property <FieldValidity> form-date-validity: FieldValidity.neutral;
    in property <string> form-date-hint;
    in property <bool> form-grid-open: false;
    in property <[[DueDayModel]]> form-grid;
    in property <bool> form-grid-focus: false;
    in property <string> form-start-text: "--:--";
    in property <FieldValidity> form-start-validity: FieldValidity.neutral;
    in property <string> form-start-hint;
    in property <[TimeSlotRow]> form-start-slots;
    in property <int> form-start-nearest-row: 0;
    in property <string> form-end-text: "--:--";
    in property <FieldValidity> form-end-validity: FieldValidity.neutral;
    in property <string> form-end-hint;
    in property <[TimeSlotRow]> form-end-slots;
    in property <int> form-end-nearest-row: 0;

    // The form's intents (§5.1): no inline side effects — the parse,
    // the seed-on-step, the mask assembly, and the commit gate all
    // live in the adapter/pure layer.
    callback date-edited(string);
    callback date-grid-toggled();
    callback date-grid-key(int);
    callback date-day-clicked(int);
    // The quick-times chevrons' notification halves (round-5 F8's
    // track surface): the seams disarm each field's digit filter.
    callback start-quick-toggled();
    callback end-quick-toggled();
    callback start-edited(string);
    callback start-stepped(int);
    callback start-picked(int);
    callback end-edited(string);
    callback end-stepped(int);
    callback end-picked(int);
    // The commit funnel (F24's Enter-commits rule): `true` = the
    // flow steps back to the list (the absorbed-miss convention
    // keeps the form open with the invalid flavour on `false`).
    callback commit-requested() -> bool;

    // The intents (§5.1): no inline side effects.
    callback row-activated(int);
    callback add-requested();
    // The armed delete (D-TS5): the first activate arms (the tone
    // flips danger, the copy names the confirm), the second
    // dispatches. The armed row's index is the window's pushed
    // mirror (the adapter holds the armed id; the index seam
    // resolves it — a refresh that drops the row renders unarmed).
    callback delete-clicked(int);
    in property <int> armed-index: -1;
    // The deleted-entries restore section (the undo-family journey
    // plan W-9, D-5 — zero-input): the journal's restorable deletes,
    // each row arming the shared armed-confirm grammar; Confirm
    // dispatches `RestoreTimeEntryFromJournal { from }` — the payload
    // carries the journal id only, the engine reads the pre-image.
    // Kiosk renders the section absent (D-4: the adapter pushes empty
    // rows there; the CLI carries the kiosk restore path).
    // slint: entry-restore-requested / entry-restore-cancelled
    // (adapter: entry_restore_requested / entry_restore_cancelled)
    in property <[string]> deleted-entry-rows;
    in property <bool> has-deleted-entries: false;
    in property <int> restore-armed-index: -1;
    callback entry-restore-requested(int);
    callback entry-restore-cancelled();

    background: Theme.surface-raised;
    border-radius: Theme.radius-small;
    border-width: Theme.focus-ring-width;
    border-color: Theme.border;
    accessible-role: AccessibleRole.region;
    accessible-label: "Time entries";
    // The focus hand-off (the walk probe's P5): a fresh conditional
    // instantiation's init grab does not take (slint 1.17 — the
    // subtree's init runs before the window attaches), so the walk
    // root grabs on the panel's own post-mount height transition —
    // the content mirror's first landing, and every surface swap's
    // height step. The re-grab also covers the form↔list swap, whose
    // nested scope inherits the same rule.
    changed height => { panel-scope.focus(); }

    // Content-sized per surface (the date-picker's
    // `height: panel.preferred-height` shape — the default
    // absolute-context height would stretch the panel over the whole
    // window); the two conditional layouts' preferred heights are
    // mirrored here through the derived-property idiom — the direct
    // read would cycle (`preferred-height` ↔ `layoutinfo`). One-space
    // inits (the lint's token rule): the first layout pass
    // overwrites them via the `changed` mirrors below.
    height: form-open ? form-layout-height : list-layout-height;
    property <length> list-layout-height: Theme.space-1;
    property <length> form-layout-height: Theme.space-1;
    min-width: Theme.menu-max-width;

    // The walk order (blanket rule b, #1259's proven inventory): the
    // entry rows in pushed order (stop i = row i) → the footer's add
    // affordance (stop `rows.length`). The extent is the mount
    // host's `walk-stops` push; the stops consume their own
    // `focus-index` landings, and each stop re-publishes the cursor
    // when it gains focus (the adapter's next step reads it).
    panel-scope := FocusScope {
    // The walk clamp's host half (US-2/W-2, D-W2): the mask holds
    // this scope; the consumption edge rides the `mask-focus` seam's
    // nonce. The stops grab their own indices; the root takes only
    // the unaddressed landing (no stop mounted at the index — the
    // form surface keeps the degenerate clamp), so the walk never
    // yanks focus out of a mounted stop or a form field.
    init => { MaskWalkFacts.cursor = 0; }
    property <int> watch-mask-nonce: MaskWalkFacts.nonce;
    changed watch-mask-nonce => {
        if (MaskWalkFacts.armed
                && (MaskWalkFacts.focus-index < 0
                    || MaskWalkFacts.focus-index >= MaskWalkFacts.extent)) {
            panel-scope.focus();
            MaskWalkFacts.cursor = 0;
        }
    }

        width: 100%;
        height: 100%;
        focus-on-tab-navigation: true;
        // The derived-property wrap is the walk probe's recorded
        // idiom (P2): `changed` delivers on the wrapper, not on the
        // built-in has-focus binding directly. The height grab is a
        // post-mount transition, so the gain fires here.
        property <bool> scope-focused: self.has-focus;
        changed scope-focused => {
            TrackPanelWalkFacts.panel-root-focused = self.scope-focused;
            if (!self.scope-focused) {
                TrackPanelWalkFacts.focused-row-stop = -1;
            }
        }
        VerticalLayout {
            // The form surface (r4 D-TS4): replaces the list
            // in-place; the ladder steps back. The date grid is the
            // window-level overlay the date row anchors (the overlay
            // migration, M4 — the due picker's mount grammar; the
            // track panel is itself a window overlay, so the grid's
            // host stacks above it).
            if (root.form-open): Rectangle {
                form-scope := FocusScope {
                    width: 100%;
                    height: 100%;
                    focus-on-tab-navigation: true;
                    init => { self.focus(); }
                    VerticalLayout {
                        changed preferred-height => { root.form-layout-height = self.preferred-height; }
                        padding: Theme.space-3;
                        spacing: Theme.space-2;
                        // The date row: the typed field over the
                        // grid toggle; the hint is the syntax copy.
                        // The row is the grid overlay's anchor (the
                        // overlay migration, M4): the toggle's click
                        // pushes the realized geometry (the timers
                        // idiom), the `changed` mirrors are the
                        // keep-alives.
                        date-row := HorizontalLayout {
                            spacing: Theme.space-1;
                            // The grid anchor's keep-alives (the
                            // overlay migration, M4; the #954
                            // AnchorMirror idiom written once): a host
                            // scroll keeps the window-space mirror
                            // live.
                            AnchorMirror {
                                source-x: date-row.absolute-position.x;
                                source-y: date-row.absolute-position.y;
                                source-width: date-row.width;
                                source-height: date-row.height;
                                published(x, y, w, h) => {
                                    TrackPanelFacts.form-grid-anchor-x = x;
                                    TrackPanelFacts.form-grid-anchor-y = y;
                                    TrackPanelFacts.form-grid-anchor-width = w;
                                    TrackPanelFacts.form-grid-anchor-height = h;
                                }
                            }
                            TextField {
                                horizontal-stretch: 1;
                                placeholder: "YYYY-MM-DD";
                                label: "Date";
                                description: "The entry's local date; the grid picks it too.";
                                initial-text: root.form-date-text;
                                validity: root.form-date-validity;
                                autofocus: false;
                                edited(text) => { root.date-edited(text); }
                            }
                            IconButton {
                                icon: IconKind.calendar;
                                label: "Calendar";
                                description: "Opens the month grid for the entry's date.";
                                clicked => {
                                    TrackPanelFacts.form-grid-anchor-x = parent.absolute-position.x;
                                    TrackPanelFacts.form-grid-anchor-y = parent.absolute-position.y;
                                    TrackPanelFacts.form-grid-anchor-width = parent.width;
                                    TrackPanelFacts.form-grid-anchor-height = parent.height;
                                    root.date-grid-toggled();
                                }
                            }
                        }
                        if (root.form-date-validity == FieldValidity.invalid): RoleText {
                            role: Typography.caption;
                            text-color: Semantic.danger;
                            text: root.form-date-hint;
                        }
                        // The span: the two TimeFields over the one
                        // lenient grammar (D26); the end field's
                        // Return commits (F24).
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            TimeField {
                                horizontal-stretch: 1;
                                flyout-site: 2;
                                time-text: root.form-start-text;
                                validity: root.form-start-validity;
                                error-hint: root.form-start-hint;
                                label: "Start";
                                description: "The span's start; type HH:MM, step, or pick.";
                                slot-rows: root.form-start-slots;
                                nearest-row: root.form-start-nearest-row;
                                edited(text) => { root.start-edited(text); }
                                stepped(n) => { root.start-stepped(n); }
                                picked(m) => { root.start-picked(m); }
                                quick-toggled() => { root.start-quick-toggled(); }
                            }
                            TimeField {
                                horizontal-stretch: 1;
                                flyout-site: 3;
                                time-text: root.form-end-text;
                                validity: root.form-end-validity;
                                error-hint: root.form-end-hint;
                                label: "End";
                                description: "The span's end; empty keeps the entry running.";
                                slot-rows: root.form-end-slots;
                                nearest-row: root.form-end-nearest-row;
                                edited(text) => { root.end-edited(text); }
                                stepped(n) => { root.end-stepped(n); }
                                picked(m) => { root.end-picked(m); }
                                quick-toggled() => { root.end-quick-toggled(); }
                                accepted(text) => {
                                    // The commit steps the surface
                                    // back to the list on `true`
                                    // (the push carries the swap).
                                    root.commit-requested();
                                }
                            }
                        }
                    }
                }
            }
            // The list surface (D-TS3): hidden while the form holds.
            if (!root.form-open): VerticalLayout {
            panel-layout := VerticalLayout {
                // The init seed covers the no-transition case (#665):
                // an empty list's preferred height is final on its
                // first evaluation, so `changed` alone never lands.
                init => { root.list-layout-height = self.preferred-height; }
                changed preferred-height => { root.list-layout-height = self.preferred-height; }
                padding: Theme.space-3;
                spacing: Theme.space-2;
                // The header total: the summary row's vocabulary, at
                // seconds precision (F16). The tip carries the same
                // description the summary row's total does.
                HorizontalLayout {
                    spacing: Theme.space-3;
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "Tracked";
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        accessible-role: AccessibleRole.text;
                        accessible-label: "Tracked time total";
                        RoleText {
                            role: Typography.mono;
                            text: root.total;
                        }
                    }
                }
                    // The rows (D-TS3): newest-first pushed order; a
                    // midnight-crossing end carries the pushed `+1d`
                    // mark; the running row renders the status dot and
                    // the pushed running copy in the end cell. Each
                    // row a walk stop with Return activation (blanket
                    // rule b; the tracked-today row idiom). The rows
                    // are a plain column (the tracked-today section's
                    // precedent — no #373 viewport machinery: its
                    // deferred layout defers the panel's own height
                    // transition, and with it the focus hand-off); a
                    // very long history grows the panel to the window
                    // clamp (the Tier-4 note).
                    // The centralized pressable-row grammar (#1350):
                    // the a11y triple, the guarded Return/Space, the
                    // focus ring and the tooltip arm ride the widget;
                    // the P2 wrap's walk-facts push observes the
                    // widget's focus mirror.
                    for row[row-index] in root.rows: row-entry := PressableRow {
                            height: Theme.space-6;
                            label: row.date + " " + row.start;
                            description: "Edits the time entry.";
                            tooltip-text: "Edits the time entry.";
                            tooltip-title: row.date + " " + row.start + " – " + row.end;
                            hover-tint: false;
                            // The stop's own consumption half (#1259):
                            // the mask landing at this row's index
                            // grabs the row; the P2 wrap (see the
                            // panel root) re-publishes the cursor so
                            // the adapter's next step reads it.
                            property <int> watch-mask-nonce: MaskWalkFacts.nonce;
                            changed watch-mask-nonce => {
                                if (MaskWalkFacts.armed
                                        && MaskWalkFacts.focus-index == row-index) {
                                    row-entry.grab-walk-stop();
                                }
                            }
                            // The P2 wrap (see the panel root).
                            changed focused => {
                                if (self.focused) {
                                    TrackPanelWalkFacts.focused-row-stop =
                                        200 + row-index;
                                    MaskWalkFacts.cursor = row-index;
                                }
                            }
                            activated => { root.row-activated(row-index); }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                padding-left: Theme.space-2;
                                padding-right: Theme.space-2;
                                if (row.running): StatusDot {
                                    y: (parent.height - self.height) / 2;
                                }
                                RoleText {
                                    role: Typography.mono;
                                    text: row.date;
                                    vertical-alignment: center;
                                }
                                RoleText {
                                    role: Typography.mono;
                                    text: row.start;
                                    vertical-alignment: center;
                                }
                                RoleText {
                                    role: Typography.mono;
                                    text: row.end;
                                    text-color: row.running ? Semantic.success : Theme.text-primary;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                                RoleText {
                                    role: Typography.mono;
                                    text: row.spent;
                                    text-color: Theme.text-secondary;
                                    vertical-alignment: center;
                                }
                                // The delete affordance (D-TS5): the
                                // journal classifies `DeleteTimeEntry`
                                // NotUndoable, so the affordance carries
                                // its own confirmation — arm on the
                                // first activate, dispatch on the
                                // second. No timer-based disarm: nothing
                                // ticks (the fence).
                                IconButton {
                                    icon: IconKind.trash;
                                    tone: row-index == root.armed-index ? Tone.danger : Tone.neutral;
                                    label: row-index == root.armed-index
                                        ? "Confirm delete"
                                        : "Delete time entry";
                                    description: row-index == root.armed-index
                                        ? "Deletes the entry. This cannot be undone — activate again to confirm."
                                        : "Arms the delete for this entry; activate again to confirm.";
                                    clicked => { root.delete-clicked(row-index); }
                                }
                            }
                        }
                // The footer add affordance (D-TS4): the centralized
                // pressable-row grammar (#1350) over the surface-raised
                // band (the walk-facts push observes the focus mirror;
                // the hover text lift reads the widget's mirror).
                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: start;
                    add-touch := PressableRow {
                        height: Theme.space-6;
                        min-width: Theme.space-6 * 4;
                        rest-background: Theme.surface-raised;
                        label: "Add time entry";
                        description: "Opens the entry form to log a block of work.";
                        tooltip-text: "Opens the entry form to log a block of work.";
                        // The stop's consumption half (#1259): the
                        // mask landing at `rows.length` grabs the
                        // affordance; the P2 wrap's stop-300 push
                        // re-publishes the cursor with it.
                        property <int> watch-mask-nonce: MaskWalkFacts.nonce;
                        changed watch-mask-nonce => {
                            if (MaskWalkFacts.armed
                                    && MaskWalkFacts.focus-index == root.rows.length) {
                                add-touch.grab-walk-stop();
                            }
                        }
                        // The walk-facts push (the P2 wrap's stop 300).
                        changed focused => {
                            if (self.focused) {
                                TrackPanelWalkFacts.focused-row-stop = 300;
                                MaskWalkFacts.cursor = root.rows.length;
                            }
                        }
                        activated => {
                            root.add-requested();
                        }
                        HorizontalLayout {
                            width: 100%;
                            height: 100%;
                            padding-left: Theme.space-3;
                            padding-right: Theme.space-3;
                            alignment: center;
                            RoleText {
                                role: Typography.body;
                                text-color: add-touch.hovered ? Theme.text-primary : Theme.text-secondary;
                                text: "Add entry";
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                // The deleted-entries restore section (W-9): mounted
                // only when the roster's entry section is non-empty
                // (no dead chrome); the armed strip names the subject
                // (the row's engine-derived label — US-5/S2) and the
                // zero-input consequence (nothing is re-typed, D-5).
                if (root.has-deleted-entries): VerticalLayout {
                    spacing: Theme.space-1;
                    padding-left: Theme.space-2;
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "Deleted entries";
                    }
                    if (root.restore-armed-index >= 0): Rectangle {
                        height: Theme.space-5 + Theme.space-2;
                        border-radius: Theme.radius-small;
                        background: Theme.surface-hover;
                        border-width: Theme.focus-ring-width;
                        border-color: Semantic.focus-ring;
                        HorizontalLayout {
                            padding-left: Theme.space-2;
                            padding-right: Theme.space-1;
                            spacing: Theme.space-2;
                            RoleText {
                                role: Typography.caption;
                                text-color: Theme.text-secondary;
                                text: "Restores “" + root.deleted-entry-rows[root.restore-armed-index] + "” — verbatim from the journal, nothing re-typed.";
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                            IconButton {
                                icon: IconKind.check;
                                tone: Tone.success;
                                label: "Confirm restore";
                                description: "Restores the armed entry from the journal.";
                                clicked => {
                                    TooltipState.unhover();
                                    root.entry-restore-requested(root.restore-armed-index);
                                }
                            }
                            IconButton {
                                icon: IconKind.remove;
                                tone: Tone.neutral;
                                label: "Cancel restore";
                                description: "Disarms the restore without dispatching.";
                                clicked => {
                                    TooltipState.unhover();
                                    root.entry-restore-cancelled();
                                }
                            }
                        }
                    }
                    for row[index] in root.deleted-entry-rows: Rectangle {
                        height: Theme.space-5;
                        border-radius: Theme.radius-small;
                        background: deleted-touch.has-hover ? Theme.surface-hover : Theme.surface;
                        HorizontalLayout {
                            padding-left: Theme.space-2;
                            padding-right: Theme.space-1;
                            spacing: Theme.space-2;
                            RoleText {
                                role: Typography.caption;
                                text: row;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            if (root.restore-armed-index != index): IconButton {
                                icon: IconKind.history;
                                tone: Tone.neutral;
                                label: "Restore entry";
                                description: "Arms the restore: the entry comes back verbatim from the journal.";
                                clicked => {
                                    TooltipState.unhover();
                                    root.entry-restore-requested(index);
                                }
                            }
                        }
                        deleted-touch := TouchArea {}
                    }
                }
            }
            }
        }
    }
}
