// SPDX-License-Identifier: AGPL-3.0-only
// The status-bar composition (L2, D11/D12): the bottom chrome — sync
// badge, the Q15 startup-warning indicator, the move-flow hint, and
// above them the persistent overdue-banner slot. Layout only; the
// tone mapping happens in the primitives, the actions in the caller.

import { Theme, Typography, Semantic, RoleText, Tone, SyncPhaseUi } from "../theme.slint";
import { Badge } from "../widgets/badge.slint";
import { StatusDot } from "../widgets/status-dot.slint";
import { ListRow } from "../widgets/list-row.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
import { KbdHint } from "../widgets/kbd-hint.slint";

// The sync badge model (D11): the phase enum plus the pending depth;
// the recency caption rides along as display text.
export struct SyncBadgeModel {
    phase: SyncPhaseUi,
    pending: int,
    recency: string,
    // The selected board's sidecar warning (empty = healthy — the
    // ruled silence); the caption text is presentation-side.
    sidecar-warning: string,
}

// One overdue-banner row (D12): the task truth plus its due phrase.
// The snooze/mute targets are Rust-side (D2) — the row carries only
// its index.
export struct BannerRowModel {
    title: string,
    due-phrase: string,
}

// The move-flow hint (D11): the current preset's task.move binding
// plus the flow state.
export struct FlowHintModel {
    keys: [string],
    visible: bool,
    // The move flow's `"<board> › <stack>"` target hint (chunk 10
    // D6); empty for every other flow.
    text: string,
}

export component StatusBar inherits Rectangle {
    in property <SyncBadgeModel> sync;
    in property <int> startup-findings;
    // The banner rows, already capped model-side (D12's flood guard
    // is presentation's layout decision, applied where the model is
    // built); `banner-overflow` is the "and N more" count.
    in property <[BannerRowModel]> banner;
    in property <int> banner-overflow;
    in property <FlowHintModel> flow-hint;
    // The timers chip (DR-3/3, D-I6): visible while any live alarm
    // exists (kiosk forces the flag false model-side), naming the
    // nearest fire; clicking focuses the today view's timers section.
    in property <bool> timers-chip-visible;
    in property <string> timers-chip;
    // The resurrect notice (#130): a passive, non-clickable line —
    // default invisible so existing compositions are unchanged.
    in property <bool> notice-visible;
    in property <string> notice-text;
    // The tracking chip (DR-5/4, D-T16): visible while an open entry
    // exists (kiosk INCLUDED — the appliance shows what is being
    // worked on); the stop affordance alone is gated off on kiosk
    // model-side (the action empties, the display stays).
    in property <bool> tracking-chip-visible;
    in property <string> tracking-chip;
    in property <bool> tracking-chip-action-visible;
    // The OS-delivery health chip (round-3 chunk 7, D31): passive,
    // non-clickable (no affordance — the fix is environmental; the
    // in-app rows are the fallback). Warning-toned like the startup
    // findings, in the chips' row.
    in property <bool> delivery-chip-visible;
    in property <string> delivery-chip;
    callback tracking-stop-clicked();
    callback snooze-clicked(int);
    callback mute-clicked(int);
    callback row-activated(int);
    callback timers-chip-clicked();

    background: Theme.surface;

    pure function sync-tone() -> Tone {
        root.sync.phase == SyncPhaseUi.idle ? Tone.neutral
        : root.sync.phase == SyncPhaseUi.syncing ? Tone.sync-active
        : root.sync.phase == SyncPhaseUi.offline ? Tone.offline
        : Tone.danger
    }

    pure function sync-label() -> string {
        root.sync.phase == SyncPhaseUi.idle ? "Idle"
        : root.sync.phase == SyncPhaseUi.syncing ? "Syncing"
        : root.sync.phase == SyncPhaseUi.offline ? "Offline"
        : "Failed"
    }

    VerticalLayout {
        // The overdue-banner slot (D12): board truth, mute-blind,
        // capped rows plus an "and N more" badge.
        if (root.banner.length > 0): Rectangle {
            background: Theme.background;
            accessible-role: AccessibleRole.region;
            accessible-label: "Overdue tasks";

            VerticalLayout {
                padding-left: Theme.space-4;
                padding-right: Theme.space-4;
                padding-top: Theme.space-1;
                padding-bottom: Theme.space-1;
                spacing: Theme.space-1;

                for row[row-index] in root.banner: HorizontalLayout {
                    spacing: Theme.space-2;

                    row-scope := FocusScope {
                        horizontal-stretch: 1;
                        // The D16 address: one list-item per overdue
                        // task; a real tab stop whose focus IS the
                        // activation (D12: keyboard focus into a
                        // banner row sets the snooze/mute target —
                        // the same seam a click hits).
                        focus-on-tab-navigation: true;
                        accessible-role: AccessibleRole.list-item;
                        accessible-label: row.title;
                        changed has-focus => {
                            if (self.has-focus) {
                                root.row-activated(row-index);
                            }
                        }

                        row-box := Rectangle {
                            width: 100%;
                            height: 100%;
                            border-width: row-scope.has-focus ? Theme.focus-ring-width : 0;
                            border-color: Semantic.focus-ring;
                            border-radius: Theme.radius-small;
                            background: touch.has-hover ? Theme.surface-hover : transparent;

                            list := ListRow {
                                text: row.title;
                                meta: row.due-phrase;
                                tone: Tone.overdue;
                            }
                            // Click activation: the same seam as tab
                            // focus, plus the focus hand-off (D15).
                            touch := TouchArea {
                                clicked => {
                                    row-scope.focus();
                                    root.row-activated(row-index);
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        IconButton {
                            icon: IconKind.snooze;
                            tone: Tone.overdue;
                            label: "Snooze reminder";
                            clicked => root.snooze-clicked(row-index);
                        }
                    }
                    VerticalLayout {
                        IconButton {
                            icon: IconKind.mute;
                            tone: Tone.overdue;
                            label: "Mute reminders";
                            clicked => root.mute-clicked(row-index);
                        }
                    }
                }

                if (root.banner-overflow > 0): HorizontalLayout {
                    Badge {
                        text: "\{root.banner-overflow} more overdue";
                        tone: Tone.overdue;
                    }
                }
            }
        }

        HorizontalLayout {
            padding-left: Theme.space-4;
            padding-right: Theme.space-4;
            padding-top: Theme.space-1;
            padding-bottom: Theme.space-1;
            spacing: Theme.space-3;

            // The sync indicator: informational, not focusable (D11).
            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: start;
                StatusDot {
                    tone: root.sync-tone();
                    label: "Sync status";
                }
                RoleText {
                    role: Typography.caption;
                    text-color: Theme.text-secondary;
                    text: root.sync-label();
                    vertical-alignment: center;
                    accessible-role: AccessibleRole.text;
                    accessible-value: root.sync-label();
                }
                if (root.sync.pending > 0): Badge {
                    text: "\{root.sync.pending} pending";
                    tone: Tone.info;
                }
                if (root.sync.recency != ""): RoleText {
                    role: Typography.caption;
                    text-color: Theme.text-secondary;
                    text: root.sync.recency;
                    vertical-alignment: center;
                }
                // The sidecar warning (D-S2's loud fence): warning-toned
                // caption + badge next to the sync indicator, exactly the
                // startup-findings shape.
                if (root.sync.sidecar-warning != ""): RoleText {
                    role: Typography.caption;
                    text-color: Semantic.warning;
                    text: root.sync.sidecar-warning;
                    vertical-alignment: center;
                }
                if (root.sync.sidecar-warning != ""): Badge {
                    text: "!";
                    tone: Tone.warning;
                }
            }

            // The Q15 startup-warning indicator: warning-toned count,
            // non-interactive (the settings deep-link is POST-1.0).
            if (root.startup-findings > 0): HorizontalLayout {
                spacing: Theme.space-2;
                RoleText {
                    role: Typography.caption;
                    text-color: Semantic.warning;
                    text: "Keyboard configuration warnings";
                    vertical-alignment: center;
                }
                Badge {
                    text: "\{root.startup-findings}";
                    tone: Tone.warning;
                }
            }

            // The timers chip (DR-3/3, D-I6): the nearest fire ("Tea ·
            // 2m"), a click target for the today view's timers section
            // (which routes the existing ViewToday action). Desktop
            // only — the flag is forced false model-side on kiosk.
            if (root.timers-chip-visible): TouchArea {
                clicked => {
                    root.timers-chip-clicked();
                }
                min-width: timers-chip-badge.preferred-width + 2 * Theme.space-1;
                accessible-role: AccessibleRole.button;
                accessible-label: "Nearest timer";
                timers-chip-badge := Badge {
                    x: Theme.space-1;
                    text: root.timers-chip;
                    tone: Tone.info;
                }
            }

            // The tracking chip (DR-5/4, D-T16): the title snapshot +
            // minute-bucketed elapsed ("Task · 12m"), re-derived on
            // the wall-minute repaint. No click target — the one
            // moving number is display; its affordance is the Stop
            // button beside it (kiosk-gated model-side).
            // The stop affordance is a TouchArea, deliberately NOT an
            // IconButton: a focused FocusScope consumes every unhandled
            // key (its default), and a chrome button one pointer-click
            // away would dead-end the §5.1 single key path — the
            // banner's snooze/mute carry that same latent hazard (a
            // focused chrome IconButton swallows the settings Escape;
            // observed on the base tree with a mounted banner). The
            // timers-chip TouchArea pattern keeps the a11y button role
            // and the pointer affordance without the key sink;
            // recorded as the D-T16 letter deviation.
            if (root.tracking-chip-visible): tracking-chip-badge := Badge {
                text: root.tracking-chip;
                tone: Tone.info;
            }
            // The delivery chip (chunk 7, D31): warning-toned
            // caption + badge, the sidecar-warning shape. No click
            // target — the record lives in the log and the in-app
            // notification rows.
            if (root.delivery-chip-visible): HorizontalLayout {
                spacing: Theme.space-2;
                RoleText {
                    role: Typography.caption;
                    text-color: Semantic.warning;
                    text: root.delivery-chip;
                    vertical-alignment: center;
                }
                Badge {
                    text: "!";
                    tone: Tone.warning;
                }
            }

            if (root.tracking-chip-visible && root.tracking-chip-action-visible): stop-touch := TouchArea {
                min-width: Theme.space-6;
                min-height: Theme.space-6;
                accessible-role: AccessibleRole.button;
                accessible-label: "Stop tracking";
                accessible-action-default => {
                    root.tracking-stop-clicked();
                }
                clicked => {
                    root.tracking-stop-clicked();
                }
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: Theme.space-3;
                    height: Theme.space-3;
                    border-radius: Theme.radius-small;
                    background: stop-touch.has-hover || stop-touch.pressed
                        ? Theme.surface-hover
                        : transparent;
                    // The stop square (geometric, D19 — no icon font):
                    // the IconKind.stop glyph's shape.
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: Theme.space-2 + Theme.focus-ring-width;
                        height: Theme.space-2 + Theme.focus-ring-width;
                        background: Theme.text-primary;
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // The move-flow hint (D11): the preset's task.move binding
            // plus the flow state, only while moving.
            if (root.flow-hint.visible): HorizontalLayout {
                spacing: Theme.space-2;
                KbdHint {
                    keys: root.flow-hint.keys;
                }
                RoleText {
                    role: Typography.caption;
                    text-color: Theme.text-secondary;
                    // The move flow names the target (`board › stack`,
                    // chunk 10 D6); other flows keep the generic line.
                    text: root.flow-hint.text != ""
                        ? root.flow-hint.text
                        : "choose target · same key cancels · Return confirms";
                    vertical-alignment: center;
                }
            }
        }

        // The resurrect notice (#130): passive text, no click affordance
        // — the kiosk constraint is "never block", and a line never does.
        if (root.notice-visible && root.notice-text != ""): HorizontalLayout {
            spacing: Theme.space-2;
            RoleText {
                role: Typography.caption;
                text-color: Theme.text-secondary;
                text: root.notice-text;
                overflow: elide;
            }
        }
    }
}
