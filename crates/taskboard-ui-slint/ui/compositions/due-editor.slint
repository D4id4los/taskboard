// SPDX-License-Identifier: AGPL-3.0-only
// The due-date editor composition (r2 D25): the typed field with its
// live echo plus the inline expanding calendar panel — both
// interaction paths funnel into the window's one `task-due-committed`
// seam. The picker's cursor/month state lives in the adapter (R-d);
// this composition only renders pushed rows and reports intents. The
// calendar is fully keyboard-operable: the panel's FocusScope takes
// focus on open and maps the raw strokes onto the same callbacks the
// day cells' clicks use (click ≡ key, §7.1). Escape is *not* handled
// here — the action layer's insert-mode discard ends the whole editor
// (the clean close), so the picker never shadows the view Escape
// (R-c).

import { Theme, Typography, RoleText, Semantic } from "../theme.slint";
import { FieldValidity } from "../widgets/text-field.slint";
import { TippedField } from "../widgets/tipped-field.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";

// The date editor's field half (round-3 D10): the typed field with
// its live echo plus the calendar toggle. The picker itself is the
// window-level `DatePicker` overlay anchored to the field row below
// (the main-menu pattern) — the anchor geometry rides the out
// properties as live bindings, not snapshots.
export component DueEditor inherits VerticalLayout {
    in property <string> initial-text;
    in property <string> echo;
    // The shared editor's field identity (round-3 D8): due and
    // scheduled mount the same composition — only the field's label
    // and placeholder differ.
    in property <string> field-label: "Due date entry";
    in property <string> entry-placeholder: "YYYY-MM-DD or +2d";
    // The field's help sentence (r3-3.1): single-sourced through the
    // `TippedField` pair into the tip and the field's a11y
    // description — markup-literal at the instantiations, never
    // pushed state.
    in property <string> field-help: "";
    // The x-clear affordance (round-3 D11): both date fields enable
    // it; the staged clear rides `edited("")`.
    in property <bool> clear-affordance: false;
    // The tri-state validity flavour (r4 D27): the border driver; the
    // echo row doubles as the error line (empty echo + invalid renders
    // the syntax hint in the danger tone — one row, no layout growth).
    in property <FieldValidity> validity: FieldValidity.neutral;
    in property <string> syntax-hint;
    // The focus-loss seam (r4 D24): forwarded to the settle funnel.
    callback focus-lost();
    // The one-shot field-focus hand-over (r4 D25): the flag change
    // (not just the mount init) moves focus into the field — the
    // focus-on-mount mechanism-A idiom run in reverse.
    in property <bool> field-focus-on-mount: false;
    changed field-focus-on-mount => {
        if (root.field-focus-on-mount) {
            due-field.grab-focus();
        }
    }
    // The push re-seed (r4 D25's live sync; R-c's probe shape): the
    // adapter's buffer mirror wins whenever it differs from the
    // field's own text. While the user types, the adapter echoes the
    // typed text back verbatim, so the push is a no-op; a
    // Picker-source move (a cursor key, a stepper, a quick pick)
    // rewrites the visible text.
    changed initial-text => {
        if (due-field.text != root.initial-text) {
            due-field.text = root.initial-text;
        }
    }
    callback edited(string);
    callback accepted(string);
    callback picker-toggled();


    // The stretch default's alignment: the wrapper's stretch 1 takes
    // the leftover (its field stretches inside the pair row); the
    // calendar button is max-width-pinned at the square (an
    // `alignment: start` row would size every cell to its
    // preferred width and defeat the stretch).
    HorizontalLayout {
        spacing: Theme.space-2;
        due-field := TippedField {
            placeholder: root.entry-placeholder;
            label: root.field-label;
            help: root.field-help;
            initial-text: root.initial-text;
            clear-affordance: root.clear-affordance;
            validity: root.validity;
            horizontal-stretch: 1;
            accepted(text) => { root.accepted(text); }
            edited(text) => { root.edited(text); }
            focus-lost() => { root.focus-lost(); }
        }
        IconButton {
            icon: IconKind.calendar;
            label: "Calendar";
            description: "Toggles the calendar picker.";
            clicked => root.picker-toggled();
        }
    }

    if (root.echo != ""): RoleText {
        role: Typography.caption;
        text-color: Theme.text-secondary;
        text: root.echo;
    }
    if (root.echo == "" && root.validity == FieldValidity.invalid): RoleText {
        role: Typography.caption;
        text-color: Semantic.danger;
        text: root.syntax-hint;
    }
}
