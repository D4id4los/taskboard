// SPDX-License-Identifier: AGPL-3.0-only
// The labels overlay panel (UX remediation chunk 3, D-2, #789): the
// task-detail's modal over the subject task — the board's live
// labels as roster rows (swatch + title + the subject's assignment
// toggle; create/edit/delete join in their own rungs). Rendering
// reads the pushed model only; the row ids resolve Rust-side through
// the `IdTables::label_ids` index seam, never viewport offsets. The
// Escape ladder / outside click ride the action layer's dismissal
// (the `Labels` context's rows); the panel is one FocusScope root
// (blanket rule b). Every dispatch is a callback (§5.1).

import { Theme, Typography, RoleText, Tone, Semantic } from "../theme.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
import { TooltipState } from "../widgets/tooltip.slint";
import { TextField, FieldValidity } from "../widgets/text-field.slint";
import { ColourPicker } from "./colour-picker.slint";
import { TextButton } from "../widgets/text-button.slint";
import { MaskWalkFacts } from "../mask-walk-facts.slint";

// One roster row: display parts plus the subject's assignment state
// (D-2 — ids stay in the adapter's tables; the toggle routes the
// pair by the row's pushed state, the engine's idempotence owns the
// rest — the CLI's own contract, no GUI-side guard).
export struct LabelRowModel {
    title: string,
    color: color,
    assigned: bool,
}

export component LabelsPanel inherits Rectangle {
    in property <[LabelRowModel]> rows;
    // The form surface's pushed halves (UX R-3 D-2): the create
    // (`form-open` over the roster) / edit form — the seeded title
    // (the field reads it on mount), the fixed swatch palette, and
    // the armed swatch's index. The buffer stays user-owned while
    // the form lives; the push never re-seeds a typed title (the
    // due-editor's rule).
    in property <bool> form-open: false;
    in property <string> form-title: "";
    // The colour field's pushed halves (tag-color UX plan D-5, #839):
    // the user's draft (the field reads it on mount and on a swatch
    // click — never push-ward while typing, the title's
    // mount-only-read rule), the draft's typed validity (the invalid
    // echo), and the preview echo (transparent when invalid — the
    // `swatch_hex` hygiene, never re-derived).
    in property <string> form-colour: "";
    in property <bool> colour-valid: true;
    in property <color> colour-preview;
    in property <[color]> swatches;
    in property <int> swatch-selected: -1;
    // The picker's pushed projection (journey plan `…-schedule-colour-
    // ux-plan.md` D-3/D-4, US-28): the last-valid draft's HSV reading
    // plus the pure hue colour the SV square's base fill needs — the
    // draft string is the single truth, these are its projection; an
    // invalid intermediate never reaches them (the push is gated on
    // the mint adapter-side).
    in property <float> picker-hue: 0;
    in property <float> picker-sat: 0;
    in property <float> picker-val: 0;
    in property <color> picker-hue-colour: transparent;
    // The armed delete's pushed mirror (the track-entries armed-index
    // rule): the armed roster row, or -1.
    in property <int> armed-index: -1;
    // The assignment-toggles' shown half (tag-color plan D-3, US-2):
    // the detail mount shows the per-row toggles; the roster-only
    // board mount renders none (R-2's letter made visible — the
    // row-set composition is the ruling, not a greying).
    in property <bool> shows-assignment: true;

    // The intents (§5.1): no inline side effects — the id
    // resolution and the pair dispatch live in the adapter.
    callback row-toggled(int);
    callback dismiss-requested();
    // The form's intents (D-2): the row verbs are pointer-grade —
    // the add/edit arms the form, the swatch click arms its color,
    // and the commit funnel returns `false` for the typed inert
    // (an empty title keeps the form open — the entries commit's
    // absorbed-miss convention).
    callback add-requested();
    callback edit-requested(int);
    callback title-edited(string);
    // slint: colour-edited — the free-form colour draft (tag-color
    // plan D-5; the `title-edited` twin, the SC-W-N2 naming — the
    // field's edits flow adapter-ward, never push-ward).
    callback colour-edited(string);
    // The picker's gestures (US-28/S1, S4): every drag / nudge
    // re-emits the projection; the adapter rewrites the draft — no
    // command, the overlay's commit is the funnel.
    // slint: hue-picked / sat-val-picked (adapter:
    // labels_overlay_hue_picked / labels_overlay_sat_val_picked)
    callback hue-picked(float);
    callback sat-val-picked(float, float);
    callback swatch-clicked(int);
    callback form-commit-requested() -> bool;
    callback form-cancelled();
    // The armed delete (D-2): the first activate arms (the strip
    // mounts), Confirm dispatches, Cancel/Escape disarms — the r2
    // grammar on the roster rows.
    callback delete-clicked(int);
    callback delete-cancelled();
    // The deleted-labels restore section (the undo-family journey
    // plan W-2, D-2): the tombstoned roster's rows, each arming the
    // same armed-confirm grammar (restore is state-changing; the
    // strip names what comes back). Ids stay adapter-side — the index
    // resolves against the published roster's row order.
    // slint: label-restore-requested / label-restore-cancelled
    // (adapter: label_restore_requested / label_restore_cancelled)
    in property <[string]> deleted-rows;
    in property <bool> has-deleted: false;
    in property <int> restore-armed-index: -1;
    // The bulk row (#1245, N2's answer): one restore-all row behind
    // its own armed confirm — the same ceremony grammar, never a
    // click-through; dispatches one `RestoreLabel` per roster row.
    // slint: label-restore-all-requested / label-restore-all-cancelled
    // (adapter: label_restore_all_requested / label_restore_all_cancelled)
    in property <bool> restore-all-armed: false;
    callback label-restore-all-requested();
    callback label-restore-all-cancelled();
    callback label-restore-requested(int);
    callback label-restore-cancelled();

    background: Theme.surface-raised;
    border-radius: Theme.radius-small;
    border-width: Theme.focus-ring-width;
    border-color: Theme.border;
    accessible-role: AccessibleRole.region;
    accessible-label: "Labels";
    // The focus hand-off (the walk probe's P5 shape): a fresh
    // conditional instantiation's init grab does not take, so the
    // root grabs on the panel's own post-mount height transition.
    changed height => { panel-scope.focus(); }

    // The walk clamp's host half (US-2/W-2, D-W2): the panel is the
    // mask — its ordered control list is the walk's extent. Order:
    // the panel scope, the form field + commit/discard pair (form
    // open) or the add button (form closed), then close. The
    // conditional mounts consume their own indices from inside their
    // scopes; the root consumes the ever-mounted set and publishes
    // the extent/cursor the walk arithmetic reads.
    property <int> watch-extent: root.form-open ? 6 : 3;
    init => {
        MaskWalkFacts.extent = self.watch-extent;
        MaskWalkFacts.cursor = 0;
    }
    changed watch-extent => {
        MaskWalkFacts.extent = self.watch-extent;
    }
    property <bool> watch-close-focused: close-btn.focused;
    changed watch-close-focused => {
        if (root.watch-close-focused) {
            MaskWalkFacts.cursor = self.watch-extent - 1;
        }
    }
    property <bool> watch-panel-focused: panel-scope.has-focus;
    changed watch-panel-focused => {
        if (root.watch-panel-focused) { MaskWalkFacts.cursor = 0; }
    }
    function grab-mask-control(index: int) {
        if (index == 0) {
            panel-scope.focus();
        } else {
            close-btn.grab();
        }
    }
    // The consumption edge: the adapter's clamped stop arrives
    // through the `mask-focus` seam (the nonce-edge discipline).
    property <int> watch-mask-nonce: MaskWalkFacts.nonce;
    changed watch-mask-nonce => {
        if (MaskWalkFacts.armed) {
            root.grab-mask-control(MaskWalkFacts.focus-index);
        }
    }

    panel-scope := FocusScope {
        focus-on-tab-navigation: true;
        width: 100%;

        VerticalLayout {
            padding: Theme.space-2;
            spacing: Theme.space-2;

            // The header: the section's title plus the dismissal
            // affordance (the pointer twin of the Escape rung).
            header := HorizontalLayout {
                spacing: Theme.space-2;
                RoleText {
                    role: Typography.caption;
                    text-color: Theme.text-secondary;
                    text: "Labels";
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if (!root.form-open): new-btn := IconButton {
                    icon: IconKind.plus;
                    tone: Tone.neutral;
                    label: "New label";
                    description: "Opens the create form: a title and a swatch.";
                    // The walk clamp's add-stop consumption (US-2/W-2):
                    // the mount owns its index (1 while the form is
                    // closed) and its cursor push.
                    property <int> watch-mask-nonce: MaskWalkFacts.nonce;
                    changed watch-mask-nonce => {
                        if (MaskWalkFacts.armed && MaskWalkFacts.focus-index == 1 && !root.form-open) {
                            new-btn.grab();
                            MaskWalkFacts.cursor = 1;
                        }
                    }
                    changed focused => {
                        if (self.focused) { MaskWalkFacts.cursor = 1; }
                    }
                    clicked => {
                        TooltipState.unhover();
                        root.add-requested();
                    }
                }
                close-btn := IconButton {
                    icon: IconKind.remove;
                    tone: Tone.neutral;
                    label: "Close labels";
                    description: "Closes the labels overlay.";
                    clicked => {
                        TooltipState.unhover();
                        root.dismiss-requested();
                    }
                }
            }

            // The form surface (UX R-3 D-2/D-5): the create / edit
            // draft replaces the roster in-place — a title field and
            // the fixed swatch row (the selection pre-marked), the
            // commit on the field's Return or the check button.
            if (root.form-open): VerticalLayout {
                spacing: Theme.space-2;
                // The form's mask indices (US-2/W-2): the title field,
                // the colour field, then the commit/discard pair —
                // consumed inside the mount (the conditional's ids are
                // scope-local).
                property <int> watch-mask-nonce: MaskWalkFacts.nonce;
                changed watch-mask-nonce => {
                    if (MaskWalkFacts.armed) {
                        if (MaskWalkFacts.focus-index == 1) { title-field.grab-focus(); }
                        else if (MaskWalkFacts.focus-index == 2) { colour-field.grab-focus(); }
                        else if (MaskWalkFacts.focus-index == 3) { commit-btn.grab(); }
                        else if (MaskWalkFacts.focus-index == 4) { discard-btn.grab(); }
                    }
                }
                title-field := TextField {
                    placeholder: "Label title";
                    label: "Label title";
                    description: "The label's name as it renders on chips.";
                    commit-affordance: true;
                    initial-text: root.form-title;
                    accepted(text) => {
                        root.title-edited(text);
                        root.form-commit-requested();
                    }
                    edited(text) => root.title-edited(text);
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    colour-field := TextField {
                        // The free-form colour draft (tag-color plan
                        // D-5): mount-only read of `form-colour` — the
                        // push never re-seeds a field the user is
                        // typing in; a swatch click re-seeds the exact
                        // value below (AC-4's letter).
                        placeholder: "Colour (six hex digits)";
                        label: "Label colour";
                        description: "Six hex digits, e.g. 31cc7c — or pick a swatch.";
                        commit-affordance: true;
                        initial-text: root.form-colour;
                        // The typed invalid echo (US-1/AC-2): the
                        // field's border carries the draft's validity
                        // — no hint text, the typed fact only.
                        validity: root.colour-valid
                            ? FieldValidity.valid
                            : FieldValidity.invalid;
                        accepted(text) => {
                            root.colour-edited(text);
                            root.form-commit-requested();
                        }
                        edited(text) => root.colour-edited(text);
                        // The swatch re-seed (D-5): the swatch arm's
                        // forced refresh lands here — the field's text
                        // takes the swatch's exact value (AC-4).
                        property <int> watch-swatch-selected: root.swatch-selected;
                        changed watch-swatch-selected => {
                            self.text = root.form-colour;
                        }
                    }
                    // The draft's preview echo (D-5): transparent when
                    // the draft is invalid (the `swatch_hex` hygiene).
                    Rectangle {
                        width: Theme.space-4;
                        height: Theme.space-4;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.radius-small;
                        background: root.colour-preview;
                        border-width: Theme.hairline-width;
                        border-color: Theme.border;
                    }
                }
                // The picker's mount (US-28): beside the colour
                // field's section, live only while the form is open.
                ColourPicker {
                    visible: root.form-open;
                    hue: root.picker-hue;
                    sat: root.picker-sat;
                    val: root.picker-val;
                    hue-colour: root.picker-hue-colour;
                    hue-picked(h) => root.hue-picked(h);
                    sat-val-picked(s, v) => root.sat-val-picked(s, v);
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    for swatch[index] in root.swatches: Rectangle {
                        width: Theme.space-4;
                        height: Theme.space-4;
                        border-radius: Theme.radius-small;
                        background: swatch;
                        border-width: root.swatch-selected == index
                            ? Theme.focus-ring-width : 0;
                        border-color: Semantic.focus-ring;
                        swatch-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => root.swatch-clicked(index);
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    commit-btn := IconButton {
                        icon: IconKind.check;
                        tone: Tone.success;
                        label: "Save label";
                        description: "Commits the label form.";
                        clicked => {
                            TooltipState.unhover();
                            root.form-commit-requested();
                        }
                    }
                    discard-btn := IconButton {
                        icon: IconKind.remove;
                        tone: Tone.neutral;
                        label: "Discard label form";
                        description: "Discards the draft without committing.";
                        clicked => {
                            TooltipState.unhover();
                            root.form-cancelled();
                        }
                    }
                }
            }

            // The armed strip (D-2): the consequence names the
            // detachment before anything dispatches (the r2 grammar's
            // board-view shape) — the armed row's sibling, keyed by
            // the pushed mirror.
            if (!root.form-open && root.armed-index >= 0): Rectangle {
                height: Theme.space-5 + Theme.space-2;
                border-radius: Theme.radius-small;
                background: Theme.surface-hover;
                border-width: Theme.focus-ring-width;
                border-color: Semantic.danger;
                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-1;
                    spacing: Theme.space-2;
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "Deletes the label from the board — it detaches from every task that wears it.";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    IconButton {
                        icon: IconKind.check;
                        tone: Tone.danger;
                        label: "Confirm delete";
                        description: "Deletes the armed label from the board.";
                        clicked => {
                            TooltipState.unhover();
                            root.delete-clicked(root.armed-index);
                        }
                    }
                    IconButton {
                        icon: IconKind.remove;
                        tone: Tone.neutral;
                        label: "Cancel delete";
                        description: "Disarms the delete without dispatching.";
                        clicked => {
                            TooltipState.unhover();
                            root.delete-cancelled();
                        }
                    }
                }
            }
            // The deleted-labels restore section (W-2): mounted only
            // when the roster is non-empty (no dead chrome); the armed
            // strip names the subject (the roster row in hand — US-1/S2)
            // and the consequence (the D-2 grammar; the
            // desktop-qualified rows render absent on kiosk — the
            // adapter pushes empty rows there, D-4).
            if (!root.form-open && root.has-deleted): VerticalLayout {
                spacing: Theme.space-1;
                RoleText {
                    role: Typography.caption;
                    text-color: Theme.text-secondary;
                    text: "Deleted labels";
                }
                if (root.restore-armed-index >= 0): Rectangle {
                    height: Theme.space-5 + Theme.space-2;
                    border-radius: Theme.radius-small;
                    background: Theme.surface-hover;
                    border-width: Theme.focus-ring-width;
                    border-color: Semantic.focus-ring;
                    HorizontalLayout {
                        padding-left: Theme.space-2;
                        padding-right: Theme.space-1;
                        spacing: Theme.space-2;
                        RoleText {
                            role: Typography.caption;
                            text-color: Theme.text-secondary;
                            text: "Restores “" + root.deleted-rows[root.restore-armed-index] + "” — it comes back verbatim and can be assigned again.";
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        IconButton {
                            icon: IconKind.check;
                            tone: Tone.success;
                            label: "Confirm restore";
                            description: "Restores the armed label.";
                            clicked => {
                                TooltipState.unhover();
                                root.label-restore-requested(root.restore-armed-index);
                            }
                        }
                        IconButton {
                            icon: IconKind.remove;
                            tone: Tone.neutral;
                            label: "Cancel restore";
                            description: "Disarms the restore without dispatching.";
                            clicked => {
                                TooltipState.unhover();
                                root.label-restore-cancelled();
                            }
                        }
                    }
                }
                for row[index] in root.deleted-rows: Rectangle {
                    height: Theme.space-5;
                    border-radius: Theme.radius-small;
                    background: deleted-touch.has-hover ? Theme.surface-hover : Theme.surface;
                    HorizontalLayout {
                        padding-left: Theme.space-2;
                        padding-right: Theme.space-1;
                        spacing: Theme.space-2;
                        RoleText {
                            role: Typography.caption;
                            text: row;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if (root.restore-armed-index != index): IconButton {
                            icon: IconKind.history;
                            tone: Tone.neutral;
                            label: "Restore label " + row;
                            description: "Arms the restore: the label comes back verbatim.";
                            clicked => {
                                TooltipState.unhover();
                                root.label-restore-requested(index);
                            }
                        }
                    }
                    deleted-touch := TouchArea {}
                }
            }
            // The bulk restore's armed strip (#1245): the consequence
            // names the whole roster; Confirm dispatches one
            // `RestoreLabel` per row (each rides the journal — the
            // per-label undo steps stay honest).
            if (!root.form-open && root.restore-all-armed): Rectangle {
                height: Theme.space-5 + Theme.space-2;
                border-radius: Theme.radius-small;
                background: Theme.surface-hover;
                border-width: Theme.focus-ring-width;
                border-color: Semantic.focus-ring;
                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-1;
                    spacing: Theme.space-2;
                    RoleText {
                        role: Typography.caption;
                        text-color: Theme.text-secondary;
                        text: "Restores all " + root.deleted-rows.length + " deleted labels — each comes back verbatim.";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    IconButton {
                        icon: IconKind.check;
                        tone: Tone.success;
                        label: "Confirm restore all";
                        description: "Restores every deleted label.";
                        clicked => {
                            TooltipState.unhover();
                            root.label-restore-all-requested();
                        }
                    }
                    IconButton {
                        icon: IconKind.remove;
                        tone: Tone.neutral;
                        label: "Cancel restore all";
                        description: "Disarms the bulk restore without dispatching.";
                        clicked => {
                            TooltipState.unhover();
                            root.label-restore-all-cancelled();
                        }
                    }
                }
            }
            // The bulk row itself: last in the section; it hides
            // while a per-row or bulk ceremony is armed (one strip at
            // a time — the D-2 grammar's focus law).
            if (!root.form-open && root.restore-armed-index < 0 && !root.restore-all-armed): TextButton {
                label: "Restore all deleted labels";
                clicked => {
                    TooltipState.unhover();
                    root.label-restore-all-requested();
                }
            }
            if (!root.form-open): list := VerticalLayout {
                spacing: Theme.space-1;
                for row[index] in root.rows: Rectangle {
                    height: Theme.space-5;
                    border-radius: Theme.radius-small;
                    background: row-touch.has-hover ? Theme.surface-hover : Theme.surface;
                    HorizontalLayout {
                        padding-left: Theme.space-2;
                        padding-right: Theme.space-1;
                        spacing: Theme.space-2;
                        Rectangle {
                            width: Theme.space-3;
                            height: Theme.space-3;
                            y: (parent.height - self.height) / 2;
                            border-radius: Theme.radius-small;
                            background: row.color;
                            border-width: Theme.hairline-width;
                            border-color: Theme.border;
                        }
                        RoleText {
                            role: Typography.caption;
                            text: row.title;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        // The edit affordance (D-2): arms the inline
                        // form seeded from the row (the pointer-grade
                        // row verb — no ActionId, the plan D-2's
                        // grammar).
                        if (!root.form-open): IconButton {
                            icon: IconKind.pencil;
                            tone: Tone.neutral;
                            label: "Edit label " + row.title;
                            description: "Opens the edit form seeded from this label.";
                            clicked => {
                                TooltipState.unhover();
                                root.edit-requested(index);
                            }
                        }
                        // The delete affordance (D-2): arms the row's
                        // strip (the pointer-grade row verb; the
                        // second activation confirms — the armed
                        // strip's Confirm is its pointer twin).
                        if (root.armed-index != index): IconButton {
                            icon: IconKind.trash;
                            tone: Tone.neutral;
                            label: "Delete label " + row.title;
                            description: "Arms the delete: the label detaches from every task that wears it.";
                            clicked => {
                                TooltipState.unhover();
                                root.delete-clicked(index);
                            }
                        }
                        // The assignment toggle (D-2): the chip ×'s
                        // twin — the row's pushed state names the
                        // verb pair's arm; the click routes it. The
                        // roster-only mount renders none (D-3).
                        if (root.shows-assignment): IconButton {
                            icon: row.assigned ? IconKind.remove : IconKind.plus;
                            tone: row.assigned ? Tone.neutral : Tone.info;
                            label: row.assigned
                                ? "Remove label " + row.title + " from the task"
                                : "Add label " + row.title + " to the task";
                            description: row.assigned
                                ? "Detaches this label from the task."
                                : "Attaches this label to the task.";
                            clicked => {
                                TooltipState.unhover();
                                root.row-toggled(index);
                            }
                        }
                    }
                    row-touch := TouchArea {}
                }
            }
        }
    }
}
