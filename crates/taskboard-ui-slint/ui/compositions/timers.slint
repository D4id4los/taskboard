// SPDX-License-Identifier: AGPL-3.0-only
// The timers section (DR-3/3, D-I6): the today view's active (unfired)
// alarms — one row per live countdown plus the inline creation form —
// and the compact awaiting-count pointer to the notification surface
// (the awaiting rows themselves live there; one source of truth).
// Desktop-only: the mount gate sits model-side (`timers-visible` is
// false on kiosk and the section never renders). Layout only; the
// commands live in the adapter.

import { Theme, Typography, RoleText, Tone, Semantic } from "../theme.slint";
import { Badge } from "../widgets/badge.slint";
import { SegmentedControl } from "../widgets/segmented-control.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
import { FieldValidity } from "../widgets/text-field.slint";
import { TextField } from "../widgets/text-field.slint";
import { TimerSetterFacts } from "../menu-facts.slint";
import { StatusNotice } from "../widgets/status-notice.slint";
import { ConfirmStrip } from "../widgets/confirm-strip.slint";
import { SectionHeader } from "../widgets/section-header.slint";
import { AnchorMirror } from "../widgets/anchored-overlay.slint";

// One active timer row: the label snapshot, the two-part countdown
// (r4 D32: d/h/m/s remaining), the `@`-prefixed local fire instant,
// and the projected alarm-rung bit (the badge renders on the alarm
// rung only — `normal` is the silent default, D-I9's ladder). Derived
// per refresh — no UI-held ticking state. The cancel target is
// Rust-side (the IdTables index convention); the row carries only
// its index.
export struct TimerRowModel {
    label: string,
    countdown: string,
    fire-time: string,
    alarm-rung: bool,
}

// One break-rule roster row (T-14, #797): the label, the canonical
// threshold phrase (the mint's text form), the insistence rung bit
// (the `TimerRowModel.alarm-rung` convention), the roaming board's
// name, the armed-strip flag (the board columns'
// `delete-armed` convention — this row is the one armed subject), and
// the selected-row cursor's emphasis (US-9, W-10, #1066's roster
// half — the rule-list's `selected` convention).
// Derived per refresh — the remove target is Rust-side (the IdTables
// index convention); the row carries only its index.
export struct BreakRuleRowModel {
    label: string,
    threshold: string,
    alarm-rung: bool,
    board: string,
    armed: bool,
    selected: bool,
}

export component TimersSection inherits Rectangle {
    in property <[TimerRowModel]> timers;
    // The absence hint (UX R-1 D-2, remediated 2026-11-15, #790 — the
    // T-7 grammar's "hint where the surface is fenced" arm): true on
    // kiosk — the R3.5.3 fence stands (no alarm window mounts, the
    // model stays empty, zero new commands), but the section's
    // display host renders a muted caption signalling that alarms
    // live on the interactive desktop surface, instead of a silent
    // absence. Desktop controls (the setter, the creation form) stay
    // gated off under the hint.
    in property <bool> absence-hint: false;
    // -- The break-rule subsection (T-14, #797): the roster, the
    //    staged remove, and the create form. The subsection rides the
    //    section's gates (never mounts under the kiosk absence hint).
    in property <[BreakRuleRowModel]> break-rules;
    // The create form's open flag (the popover-open precedent): the
    // "Add break rule" affordance flips it, a commit or the header
    // toggle closes it. Pure presentation; the adapter owns the state.
    in property <bool> break-create-open: false;
    callback break-create-toggled();
    // The form's commit seam (the rule-add convention): `false` keeps
    // the field text (an absorbed parse miss), `true` clears both and
    // closes the form. The bool is the insistence rung's alarm bit
    // (the timer form's convention).
    callback break-create-accepted(string, string, bool) -> bool;
    // The threshold field's per-keystroke validity (the `when-edited`
    // convention): the adapter parses with the mint's text grammar
    // and pushes the flavour.
    callback break-threshold-edited(string);
    in property <FieldValidity> break-threshold-validity: FieldValidity.neutral;
    in property <string> break-threshold-error-hint;
    // The staged remove (the armed-confirm grammar, UX R-2): the row's
    // remove affordance arms (arming dispatches nothing), the strip's
    // Confirm routes the verb, Cancel disarms.
    callback break_remove_clicked(int);
    callback break_remove_confirmed(int);
    callback break_remove_cancelled();
    // The awaiting (fired ∧ ¬dismissed) alarms count — a non-
    // interactive pointer badge to the notification surface (D-P15).
    in property <int> timers-awaiting;
    callback cancel-clicked(int);
    // The form's commit seam (the rule-add convention): `false` keeps
    // the field text (an absorbed parse miss), `true` clears both.
    // The third parameter is the insistence rung's structural bit
    // (r4 D-T7): the two-rung enum's alarm flag from the picker.
    callback create-accepted(string, string, bool) -> bool;
    // The `when` field's per-keystroke validity (r4 D27): the
    // adapter parses with the timer grammar and pushes the flavour.
    callback when-edited(string);
    in property <FieldValidity> when-validity: FieldValidity.neutral;
    in property <string> when-error-hint;
    // The insistence picker's state (r4 D-T7): the caller owns the
    // selection; `Normal` is the default rung (the ladder's silent
    // base). Index order `[Normal, Alarm]`.
    in-out property <int> insistence-index: 0;
    // The mouse setter's open request (r4 D33): the header button's
    // click (the popover mounts app-window-level — never inside the
    // scroll page).
    callback setter-opened();
    // The popover's anchor (the DatePickerFacts twin): the header
    // button's realized window-space geometry, mirrored through the
    // AnchorMirror (the #954 idiom written once — the init + changed
    // edges are its lore; values are stale while unmounted —
    // harmless, the popover's own condition gates the read).
    AnchorMirror {
        source-x: setter-button.absolute-position.x;
        source-y: setter-button.absolute-position.y;
        source-width: setter-button.width;
        source-height: setter-button.height;
        published(x, y, w, h) => {
            TimerSetterFacts.anchor-x = x;
            TimerSetterFacts.anchor-y = y;
            TimerSetterFacts.anchor-width = w;
            TimerSetterFacts.anchor-height = h;
        }
    }

    background: transparent;
    accessible-role: AccessibleRole.region;
    accessible-label: "Timers";

    // Content-sized, pinned both ends: the today page's sections
    // never stretch (D7's `vertical-stretch: 0` discipline), and a
    // Rectangle default-max would otherwise absorb the page's
    // leftover space into the form fields.
    min-height: section-layout.preferred-height;
    max-height: section-layout.preferred-height;

    section-layout := VerticalLayout {
        vertical-stretch: 0;
        spacing: Theme.space-1;

        // The header row (D-P3): always renders on the desktop today
        // view — the creation affordance needs a permanent home; only
        // the rows collapse.
        SectionHeader {
            title: "Timers";
            count: root.timers.length;
            status-badge-text: root.timers-awaiting > 0 && !root.absence-hint
                ? "\{root.timers-awaiting} awaiting" : "";
            status-badge-tone: Tone.info;
            setter-button := IconButton {
                icon: IconKind.timer;
                tone: Tone.info;
                label: "Set a timer";
                description: "Opens the mouse setter: quick presets, a label, a custom time of day.";
                // The kiosk hint's twin gate: the setter greys (the
                // disabled affordance) — the surface itself is fenced,
                // the caption says where alarms live.
                enabled: !root.absence-hint;
                clicked => {
                    // The anchor's open-time mirror (round-9 W1): the
                    // derived-alias `changed` idiom above is the
                    // #954 race — the popover's host reads the facts
                    // at click time, so the button pushes its
                    // realized geometry here, deterministically.
                    TimerSetterFacts.anchor-x = self.absolute-position.x;
                    TimerSetterFacts.anchor-y = self.absolute-position.y;
                    TimerSetterFacts.anchor-width = self.width;
                    TimerSetterFacts.anchor-height = self.height;
                    root.setter-opened();
                }
            }
            // The break-rule create affordance (T-14, #797): the
            // section header is the permanent affordance home (the
            // D-P3 letter) — the roster subsection below collapses to
            // zero rows while no rules exist or the form is open, so
            // the empty family costs no viewport row (the
            // virtualisation suite's realized-window geometry stays
            // put; stage-2 note on D-1).
            IconButton {
                icon: root.break-create-open ? IconKind.remove : IconKind.plus;
                tone: Tone.info;
                label: root.break-create-open ? "Close the break-rule form" : "Add break rule";
                enabled: !root.absence-hint;
                clicked => { root.break-create-toggled(); }
            }
        }
        // The fence's honest absence signal (UX R-1 D-2, #790): a
        // static muted caption — display state only, no command.
        if (root.absence-hint): StatusNotice {
            tone: Tone.neutral;
            wrap: true;
            text: "Alarms ring on the interactive desktop surface — timers and break rules here stay display-only.";
        }

        for row[row-index] in root.timers: HorizontalLayout {
            spacing: Theme.space-2;

            // The two-line row anatomy (r4 D32, the rule-list twin):
            // label + alarm-rung badge + mono countdown on the primary
            // line, the `@` fire instant as the detail line. ListRow is
            // single-slot and retired from this composition.
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.space-1;
                HorizontalLayout {
                    spacing: Theme.space-2;
                    RoleText {
                        role: Typography.body;
                        text: row.label;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if (row.alarm-rung): Badge {
                        text: "alarm";
                        tone: Tone.warning;
                    }
                    RoleText {
                        role: Typography.mono;
                        text: row.countdown;
                        text-color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }
                RoleText {
                    role: Typography.caption;
                    text-color: Theme.text-secondary;
                    text: row.fire-time;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                IconButton {
                    icon: IconKind.remove;
                    tone: Tone.info;
                    label: "Cancel timer";
                    clicked => root.cancel-clicked(row-index);
                }
            }
        }

        // The break-rule subsection (T-14, #797): a break rule is a
        // duration-trigger timer (the `timers` recipe), so it mounts
        // with its family. Desktop-only, and content-gated: with no
        // rules and no open form the subsection collapses entirely —
        // the create affordance lives in the header above (the
        // empty-state header would cost a permanent viewport row on
        // the today page; the stage-2 note on D-1). The kiosk absence
        // hint gates the whole block.
        if (!root.absence-hint && (root.break-rules.length > 0 || root.break-create-open)): VerticalLayout {
            spacing: Theme.space-1;
            HorizontalLayout {
                spacing: Theme.space-2;
                RoleText {
                    role: Typography.caption;
                    text: "Break rules";
                    vertical-alignment: center;
                }
                RoleText {
                    role: Typography.caption;
                    text-color: Theme.text-secondary;
                    text: root.break-rules.length;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            for rule-row[rule-index] in root.break-rules: Rectangle {
                // The selected-row cursor's emphasis (US-9, W-10): the
                // focus-ring border, the rule-list row's convention.
                border-width: rule-row.selected ? Theme.focus-ring-width : 0;
                VerticalLayout {
                spacing: Theme.space-1;
                HorizontalLayout {
                    spacing: Theme.space-2;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Theme.space-1;
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            RoleText {
                                role: Typography.body;
                                text: rule-row.label;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if (rule-row.alarm-rung): Badge {
                                text: "alarm";
                                tone: Tone.warning;
                            }
                            RoleText {
                                role: Typography.mono;
                                text: rule-row.threshold;
                                text-color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                        RoleText {
                            role: Typography.caption;
                            text-color: Theme.text-secondary;
                            text: rule-row.board;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        IconButton {
                            icon: IconKind.remove;
                            tone: rule-row.armed ? Tone.danger : Tone.info;
                            label: "Remove break rule";
                            clicked => root.break_remove_clicked(rule-index);
                        }
                    }
                }
                // The armed-confirm strip (UX R-2's grammar, T-14):
                // mounts inline at the armed subject, names the
                // consequence (the removal cascade-prunes the rule's
                // deliveries, dismissals, and snooze links and is not
                // undoable), Confirm/Cancel. Nothing dispatches until
                // Confirm.
                if (rule-row.armed): ConfirmStrip {
                    message: "Deletes this rule and its recorded firings; this cannot be undone.";
                    confirm-label: "Confirm remove rule";
                    cancel-label: "Cancel remove rule";
                    confirmed => root.break_remove_confirmed(rule-index);
                    cancelled => root.break_remove_cancelled();
                }
                }
            }

            // The create form (the timer form's convention): label +
            // threshold (`30s|5m|1h30m|2d`, the mint's grammar) + the
            // insistence rung. Commit fires on the threshold field's
            // Return; an absorbed miss keeps the text.
            if (root.break-create-open): VerticalLayout {
                spacing: Theme.space-1;
                HorizontalLayout {
                    spacing: Theme.space-2;
                    break-label-field := TextField {
                        horizontal-stretch: 1;
                        placeholder: "Break rule label";
                        label: "Break rule label";
                        autofocus: false;
                    }
                    break-threshold-field := TextField {
                        horizontal-stretch: 1;
                        placeholder: "after 90m · 1h30m · 2d";
                        label: "Work threshold (e.g. 90m or 1h30m)";
                        validity: root.break-threshold-validity;
                        autofocus: false;
                        accepted(text) => {
                            if (root.break-create-accepted(break-label-field.text, text, root.insistence-index == 1)) {
                                break-label-field.text = "";
                                break-threshold-field.text = "";
                                // The rung re-seats on its silent
                                // default (the timer form's reset).
                                root.insistence-index = 0;
                            }
                        }
                        edited(text) => { root.break-threshold-edited(text); }
                    }
                    // The insistence picker rides the timer form's
                    // own selection (`insistence-index` above): one
                    // picker, two families — the commit seams read
                    // the same rung.
                }
                if (root.break-threshold-validity == FieldValidity.invalid && break-threshold-field.text != ""): RoleText {
                    role: Typography.caption;
                    text-color: Semantic.danger;
                    text: root.break-threshold-error-hint;
                }
            }
        }

        // The inline creation form (D-I7): label + the `in`/`at`
        // timing grammar. Commit fires on the timing field's Return;
        // an absorbed miss keeps the text (the rule-add seam's return
        // convention). Desktop-only: the whole form block is gated off
        // under the kiosk hint (the setter's greyed twin — the fenced
        // surface offers no creation).
        if (!root.absence-hint): VerticalLayout {
            spacing: Theme.space-1;
            HorizontalLayout {
            spacing: Theme.space-2;
            label-field := TextField {
                horizontal-stretch: 1;
                placeholder: "Timer label";
                label: "Timer label";
                autofocus: false;
            }
            when-field := TextField {
                horizontal-stretch: 1;
                placeholder: "in 10m · at 09:30";
                label: "Timer timing (in 10m or at 09:30)";
                validity: root.when-validity;
                autofocus: false;
                accepted(text) => {
                    if (root.create-accepted(label-field.text, text, root.insistence-index == 1)) {
                        label-field.text = "";
                        when-field.text = "";
                        // The rung re-seats on its silent default — a
                        // stale Alarm pick would silently escalate the
                        // next timer (the fields' own reset convention).
                        root.insistence-index = 0;
                    }
                }
                edited(text) => { root.when-edited(text); }
            }
            // The insistence picker (r4 D-T7, the D-P1 drop-in spot):
            // keyboard parity with the popover's picker — the rung
            // rides the same commit seam's third parameter.
            SegmentedControl {
                options: ["Normal", "Alarm"];
                selected-index: root.insistence-index;
                group-label: "Insistence";
                picked(index) => { root.insistence-index = index; }
            }
            }
            if (root.when-validity == FieldValidity.invalid && when-field.text != ""): RoleText {
                role: Typography.caption;
                text-color: Semantic.danger;
                text: root.when-error-hint;
            }
        }
    }
}
