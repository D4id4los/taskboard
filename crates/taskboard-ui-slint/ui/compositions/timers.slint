// SPDX-License-Identifier: AGPL-3.0-only
// The timers section (DR-3/3, D-I6): the today view's active (unfired)
// alarms — one row per live countdown plus the inline creation form —
// and the compact awaiting-count pointer to the notification surface
// (the awaiting rows themselves live there; one source of truth).
// Desktop-only: the mount gate sits model-side (`timers-visible` is
// false on kiosk and the section never renders). Layout only; the
// commands live in the adapter.

import { Theme, Typography, RoleText, Tone, Semantic } from "../theme.slint";
import { Badge } from "../widgets/badge.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
import { FieldValidity } from "../widgets/text-field.slint";
import { TextField } from "../widgets/text-field.slint";

// One active timer row: the label snapshot, the two-part countdown
// (r4 D32: d/h/m/s remaining), the `@`-prefixed local fire instant,
// and the projected alarm-rung bit (the badge renders on the alarm
// rung only — `normal` is the silent default, D-I9's ladder). Derived
// per refresh — no UI-held ticking state. The cancel target is
// Rust-side (the IdTables index convention); the row carries only
// its index.
export struct TimerRowModel {
    label: string,
    countdown: string,
    fire-time: string,
    alarm-rung: bool,
}

export component TimersSection inherits Rectangle {
    in property <[TimerRowModel]> timers;
    // The awaiting (fired ∧ ¬dismissed) alarms count — a non-
    // interactive pointer badge to the notification surface (D-P15).
    in property <int> timers-awaiting;
    callback cancel-clicked(int);
    // The form's commit seam (the rule-add convention): `false` keeps
    // the field text (an absorbed parse miss), `true` clears both.
    callback create-accepted(string, string) -> bool;
    // The `when` field's per-keystroke validity (r4 D27): the
    // adapter parses with the timer grammar and pushes the flavour.
    callback when-edited(string);
    in property <FieldValidity> when-validity: FieldValidity.neutral;
    in property <string> when-error-hint;

    background: transparent;
    accessible-role: AccessibleRole.region;
    accessible-label: "Timers";

    // Content-sized, pinned both ends: the today page's sections
    // never stretch (D7's `vertical-stretch: 0` discipline), and a
    // Rectangle default-max would otherwise absorb the page's
    // leftover space into the form fields.
    min-height: section-layout.preferred-height;
    max-height: section-layout.preferred-height;

    section-layout := VerticalLayout {
        vertical-stretch: 0;
        spacing: Theme.space-1;

        // The header row (D-P3): always renders on the desktop today
        // view — the creation affordance needs a permanent home; only
        // the rows collapse.
        HorizontalLayout {
            spacing: Theme.space-2;
            RoleText {
                role: Typography.caption;
                text: "Timers";
                vertical-alignment: center;
            }
            RoleText {
                role: Typography.caption;
                text-color: Theme.text-secondary;
                text: root.timers.length;
                vertical-alignment: center;
            }
            if (root.timers-awaiting > 0): Badge {
                text: "\{root.timers-awaiting} awaiting";
                tone: Tone.info;
            }
        }

        for row[row-index] in root.timers: HorizontalLayout {
            spacing: Theme.space-2;

            // The two-line row anatomy (r4 D32, the rule-list twin):
            // label + alarm-rung badge + mono countdown on the primary
            // line, the `@` fire instant as the detail line. ListRow is
            // single-slot and retired from this composition.
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.space-1;
                HorizontalLayout {
                    spacing: Theme.space-2;
                    RoleText {
                        role: Typography.body;
                        text: row.label;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if (row.alarm-rung): Badge {
                        text: "alarm";
                        tone: Tone.warning;
                    }
                    RoleText {
                        role: Typography.mono;
                        text: row.countdown;
                        text-color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }
                RoleText {
                    role: Typography.caption;
                    text-color: Theme.text-secondary;
                    text: row.fire-time;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                IconButton {
                    icon: IconKind.remove;
                    tone: Tone.info;
                    label: "Cancel timer";
                    clicked => root.cancel-clicked(row-index);
                }
            }
        }

        // The inline creation form (D-I7): label + the `in`/`at`
        // timing grammar. Commit fires on the timing field's Return;
        // an absorbed miss keeps the text (the rule-add seam's return
        // convention).
        HorizontalLayout {
            spacing: Theme.space-2;
            label-field := TextField {
                horizontal-stretch: 1;
                placeholder: "Timer label";
                label: "Timer label";
                autofocus: false;
            }
            when-field := TextField {
                horizontal-stretch: 1;
                placeholder: "in 10m · at 09:30";
                label: "Timer timing (in 10m or at 09:30)";
                validity: root.when-validity;
                autofocus: false;
                accepted(text) => {
                    if (root.create-accepted(label-field.text, text)) {
                        label-field.text = "";
                        when-field.text = "";
                    }
                }
                edited(text) => { root.when-edited(text); }
            }
        }
        if (root.when-validity == FieldValidity.invalid && when-field.text != ""): RoleText {
            role: Typography.caption;
            text-color: Semantic.danger;
            text: root.when-error-hint;
        }
    }
}
