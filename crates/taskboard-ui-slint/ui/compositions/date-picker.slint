// SPDX-License-Identifier: AGPL-3.0-only
// The calendar date-picker composition (round-3 D10, ex-due-editor):
// the month header, the time-stepper row, the weekday row, and the
// day grid — mounted as a window-level overlay anchored to the open
// editor's field (the main-menu pattern), never inline. The picker's
// cursor/month/time state lives in the adapter (R-d); this
// composition only renders pushed rows and reports intents. The
// calendar is fully keyboard-operable: the FocusScope maps the raw
// strokes onto the same callbacks the day cells' clicks use (click ≡
// key, §7.1). Escape is *not* handled here — the action layer's
// insert-mode discard ends the whole editor (the clean close), so
// the picker never shadows the view Escape (R-c).

import { Theme, Typography, Semantic, RoleText, DueKind } from "../theme.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
import { TimeField, TimeSlotRow } from "../widgets/time-field.slint";
import { FieldValidity } from "../widgets/text-field.slint";
export { TimeSlotRow, FieldValidity }

// One day cell: the day number plus its markers; blanks render
// nothing (the weekday offset and the 7-padding tail).
export struct DueDayModel {
    label: string,
    blank: bool,
    cursor: bool,
    today: bool,
    kind: DueKind,
}

export component DatePicker inherits Rectangle {
    in property <string> caption;
    // The additive surface flag (r4 chunk 10, D-TS4): `false` hides
    // the TimeField row — the entries form embeds the grid date-only
    // (its times ride the two dedicated TimeFields). The default
    // leaves the due editor byte-identical (R2's regression
    // tripwire).
    in property <bool> show-time: true;
    in property <string> time-text;
    in property <[[DueDayModel]]> grid;
    // The one-shot grid-focus flag (round-3 D10): `true` on the
    // Down-in-field stroke — the grid takes focus and the arrows
    // drive; `false` on the default-open, where the text field keeps
    // focus (typing-first) and this panel is visible, click-armed,
    // and idle.
    in property <bool> focus-on-mount: false;
    // The mounted-grid focus hand-over (round-3 D10): the one-shot
    // flag doubles as the Down-in-field seam while the panel is
    // already open — the property change (not just the mount init)
    // moves focus into the grid.
    changed focus-on-mount => {
        if (root.focus-on-mount) {
            grid-scope.focus();
        }
    }
    // The picker's intents: the int code space is the CLICK seams'
    // vocabulary (day cells, month/time IconButtons) — the keyboard
    // drives the grid through the registry's `picker.*` actions
    // (round-3 D25): the grid FocusScope holds focus, the
    // `DatePicker` context arms, and the preset's keys resolve. No
    // `Key.*` literals live in this file any more.
    callback picker-key(int);
    // The grid focus seam (round-3 D25): arms/disarms the
    // `DatePicker` keymap context exactly with the grid's focus.
    callback grid-focus-changed(bool);
    // The flattened cell index (row * 7 + col) — resolved against the
    // adapter's picker state (D2: no dates cross the seam).
    callback day-clicked(int);
    // The time combobox's seams (r4 D26): the typed filter/entry, the
    // quick-list pick (minutes-of-day), and the commit funnel. The
    // steppers ride the widget's `stepped` onto the picker-key codes
    // (9/10) — click ≡ the keyboard's TimeBack/TimeForward.
    callback time-edited(string);
    callback time-picked(int);
    callback time-accepted(string);
    // The quick-times chevron's notification half (round-5 F8): the
    // consumer's seam sets the steal latch and disarms the digit
    // filter. The date-only track-form mount (show-time: false)
    // cannot fire it — the mount-inventory exemption covers it.
    callback quick-toggled();

    // The combobox's pushed half (r4 D26): the validity flavour, the
    // filtered quick-list rows, and the scroll-to-nearest index. The
    // error hint is the copy constant (r4 D27).
    in property <FieldValidity> time-validity: FieldValidity.neutral;
    in property <string> time-error-hint;
    in property <[TimeSlotRow]> time-slots;
    in property <int> time-nearest-row: 0;

    background: Theme.surface-raised;
    // Content-sized (the overlay anchors us freely; the default
    // absolute-context height would stretch the grid rows).
    height: panel.preferred-height;
    border-radius: Theme.radius-medium;
    border-width: Theme.focus-ring-width;
    border-color: Semantic.focus-ring;
    drop-shadow-blur: Theme.space-2;
    drop-shadow-color: Theme.surface-hover;

    pure function cell-color(kind: DueKind) -> color {
        kind == DueKind.overdue ? Semantic.overdue
        : kind == DueKind.soon ? Semantic.warning
        : kind == DueKind.done ? Semantic.success
        : Theme.text-primary
    }

    grid-scope := FocusScope {
        focus-on-tab-navigation: true;
        accessible-role: AccessibleRole.button;
        accessible-label: "Calendar grid";
        init => {
            if (root.focus-on-mount) {
                self.focus();
            }
        }
        // The focus seam (round-3 D25): the derived property +
        // `changed` is the proven mechanism-A idiom (the focus_seam
        // probe's FocusScope leg).
        property <bool> grid-has-focus: self.has-focus;
        changed grid-has-focus => {
            root.grid-focus-changed(self.grid-has-focus);
        }

        panel := VerticalLayout {
            padding: Theme.space-2;
            spacing: Theme.space-1;

            // The header: prev/next month flanking the caption.
            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: start;
                IconButton {
                    icon: IconKind.chevron-left;
                    label: "Previous month";
                    clicked => root.picker-key(4);
                }
                RoleText {
                    role: Typography.body;
                    text: root.caption;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    icon: IconKind.chevron-right;
                    label: "Next month";
                    clicked => root.picker-key(5);
                }
            }

            // The time combobox (r4 D26): the typable HH:MM field
            // with embedded ± steppers and the quarter-hour quick
            // list — it replaces the old stepper row wholesale (no
            // orphaned steppers survive). `--:--` is the date-only
            // value echo (r4 D23's display rule); the adapter owns
            // the parse, the seed-on-step, and the filter.
            if (root.show-time): TimeField {
                flyout-site: 0;
                time-text: root.time-text;
                validity: root.time-validity;
                error-hint: root.time-error-hint;
                label: "Time";
                description: "The time of day; type HH:MM, use the steppers, or pick from the quick list.";
                slot-rows: root.time-slots;
                nearest-row: root.time-nearest-row;
                stepped(n) => { root.picker-key(n < 0 ? 9 : 10); }
                edited(text) => { root.time-edited(text); }
                picked(minutes) => { root.time-picked(minutes); }
                accepted(text) => { root.time-accepted(text); }
                quick-toggled() => { root.quick-toggled(); }
            }

            // The weekday initials row (Monday-first, the grid's
            // column order).
            HorizontalLayout {
                spacing: Theme.space-1 / 2;
                for weekday in ["M", "T", "W", "T", "F", "S", "S"]: RoleText {
                    role: Typography.caption;
                    text-color: Theme.text-secondary;
                    text: weekday;
                    horizontal-alignment: center;
                    horizontal-stretch: 1;
                }
            }

            // The day grid: cursor ring = success (the selected
            // language), today ring = focus-ring, text tinted by the
            // date's DueKind (r2 D25).
            for row[row-index] in root.grid: HorizontalLayout {
                spacing: Theme.space-1 / 2;
                vertical-stretch: 0;
                for cell[cell-index] in row: day-cell := Rectangle {
                    border-radius: Theme.radius-small;
                    border-width: cell.cursor || cell.today ? Theme.focus-ring-width : 0;
                    border-color: cell.cursor ? Semantic.success : Semantic.focus-ring;
                    background: cell.cursor ? Theme.surface-hover : transparent;
                    min-height: Theme.space-5;
                    horizontal-stretch: 1;
                    touch := TouchArea {
                        enabled: !cell.blank;
                        clicked => { root.day-clicked(row-index * 7 + cell-index); }
                    }
                    RoleText {
                        role: Typography.mono;
                        text: cell.blank ? "" : cell.label;
                        text-color: root.cell-color(cell.kind);
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
