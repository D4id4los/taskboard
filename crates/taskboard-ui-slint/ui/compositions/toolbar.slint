// SPDX-License-Identifier: AGPL-3.0-only
// The toolbar composition (L2, D22): the top chrome row — the board
// title and the generated-menu icon-button. Layout only (Rule E); the
// menu click routes the `app.menu` action via the caller (§7.1: every
// click affordance has an action equivalent).

import { Theme, Typography, RoleText, Tone } from "../theme.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
import { KbdHint } from "../widgets/kbd-hint.slint";
import { Badge } from "../widgets/badge.slint";

export component Toolbar inherits Rectangle {
    in property <string> title;
    // The `app.menu` binding as display strings (a keymap projection,
    // never hand-written — D19).
    in property <[string]> menu-hint;
    // The global inbox's open count (chunk 10 D9): desktop only —
    // the adapter pushes 0 on kiosk and the compact breakpoint hides
    // the chip; renders at zero too (triage-done is a visible state).
    in property <int> inbox-count;
    // The breakpoint read (the chip's desktop-only visibility; the
    // compact path drops its chrome).
    in property <bool> compact;
    callback menu-clicked();
    callback inbox-clicked();

    background: Theme.surface;
    height: Theme.space-8;

    // The hamburger button's window rect (round-1 D4): the menu
    // panel's anchor — the same window-coordinate space the tooltip
    // trigger reads (`absolute-position`).
    out property <length> menu-anchor-x: menu-button.absolute-position.x;
    out property <length> menu-anchor-y: menu-button.absolute-position.y;
    out property <length> menu-anchor-width: menu-button.width;
    out property <length> menu-anchor-height: menu-button.height;

    HorizontalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        padding-top: Theme.space-2;
        padding-bottom: Theme.space-2;
        spacing: Theme.space-3;

        title-text := RoleText {
            role: Typography.title;
            text: root.title;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if (root.compact == false): inbox-chip := TouchArea {
            // Every click has an action equivalent (§7.1): the chip
            // routes `view.inbox`.
            clicked => root.inbox-clicked();
            accessible-role: AccessibleRole.button;
            accessible-label: "Go to inbox";
            badge := Badge {
                text: root.inbox-count;
                tone: root.inbox-count > 0 ? Tone.warning : Tone.neutral;
            }
        }

        VerticalLayout {
            KbdHint {
                keys: root.menu-hint;
            }
        }

        menu-button := IconButton {
            icon: IconKind.menu;
            label: "Command menu";
            clicked => root.menu-clicked();
        }
    }
}
