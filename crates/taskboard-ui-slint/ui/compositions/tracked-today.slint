// SPDX-License-Identifier: AGPL-3.0-only
// The today view's "Tracked" day-summary section (#490, r4 chunk 10
// D-TS7): per-task tracked-today totals over the day window plus the
// day total — deliberately NOT a fifth `TodaySectionModel` (the row
// shape differs: title + total, no card; the timers/habits
// separate-composition precedent). Work-only sums (`work_in_window` —
// the aggregator deviation recorded in the plan §5: `track status`
// and the summary row already define tracked work-only). Plain text
// rows don't justify the #373 viewport machinery — the section is
// content-sized, the walk rides the tab traversal. Empty collapses
// (the view's `if rows.length > 0`).
//
// What you see is what's summed: on kiosk the rows filter to the
// viewed board and the day total sums the filtered set (the push's
// contract; the composition renders what it is pushed).

import { Theme, Typography, Semantic, RoleText } from "../theme.slint";
import { TooltipState } from "../widgets/tooltip.slint";

export struct TrackedTodayRowModel {
    title: string,
    total: string,
}

export component TrackedTodaySection inherits Rectangle {
    in property <[TrackedTodayRowModel]> rows;
    // The day total over the pushed (filtered) rows — the summary
    // row's phrase vocabulary verbatim.
    in property <string> day-total;
    callback row-activated(int);

    background: transparent;
    accessible-role: AccessibleRole.region;
    accessible-label: "Tracked today";

    min-height: section-layout.preferred-height;
    max-height: section-layout.preferred-height;

    section-layout := VerticalLayout {
        vertical-stretch: 0;
        spacing: Theme.space-1;

        // The header row: the caption + the day total (the tip names
        // the window and the work-only rule structurally — the
        // description rides the hover machinery).
        HorizontalLayout {
            spacing: Theme.space-2;
            RoleText {
                role: Typography.caption;
                text: "Tracked";
                vertical-alignment: center;
            }
            total-touch := TouchArea {
                changed has-hover => {
                    if (self.has-hover) {
                        TooltipState.hover(
                            root.day-total,
                            "Total tracked work today across the tasks below.",
                            [],
                            self.absolute-position.x,
                            self.absolute-position.y,
                            self.width,
                            self.height,
                        );
                    } else {
                        TooltipState.unhover();
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                accessible-role: AccessibleRole.text;
                accessible-label: "Tracked today total";
                RoleText {
                    role: Typography.mono;
                    text: root.day-total;
                    vertical-alignment: center;
                }
            }
        }

        // The rows: title + total, activation opens the task (the
        // today-row-activated precedent). Each row a tab stop with
        // Return activation (blanket rule b) and a hover tip.
        for row[row-index] in root.rows: Rectangle {
            height: Theme.space-6;
            border-radius: Theme.radius-small;
            background: row-touch.has-hover ? Theme.surface-hover : transparent;
            border-width: row-focus.has-focus ? Theme.focus-ring-width : 0;
            border-color: Semantic.focus-ring;
            row-focus := FocusScope {
                width: 100%;
                height: 100%;
                focus-on-tab-navigation: true;
                accessible-role: AccessibleRole.button;
                accessible-label: row.title;
                accessible-description: "Opens the task.";
                accessible-action-default => { root.row-activated(row-index); }
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == " ") {
                        root.row-activated(row-index);
                        accept
                    } else {
                        reject
                    }
                }
            }
            row-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    TooltipState.unhover();
                    root.row-activated(row-index);
                }
                changed has-hover => {
                    if (self.has-hover) {
                        TooltipState.hover(
                            row.title,
                            "Tracked today on this task; activate to open it.",
                            [],
                            self.absolute-position.x,
                            self.absolute-position.y,
                            self.width,
                            self.height,
                        );
                    } else {
                        TooltipState.unhover();
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.space-2;
                padding-left: Theme.space-2;
                padding-right: Theme.space-2;
                RoleText {
                    role: Typography.body;
                    text: row.title;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                RoleText {
                    role: Typography.mono;
                    text: row.total;
                    text-color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
        }
    }
}
