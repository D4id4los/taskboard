// SPDX-License-Identifier: AGPL-3.0-only
// The jump-to search palette (L2 composition, #348): one query field
// over a capped result list plus the overflow caption. Presentation
// only — no matching, no ranking, no cap arithmetic (Rule E; the dumb
// client): the rows arrive ranked and capped from the Rust model, the
// highlight is `index == selected-index`, and every interaction rides
// a callback the adapter resolves.

import { Theme, Typography, RoleText, Semantic, Tone } from "../theme.slint";
import { TextField } from "../widgets/text-field.slint";
import { ListRow } from "../widgets/list-row.slint";
import { MaskWalkFacts } from "../mask-walk-facts.slint";

export struct PaletteRowModel {
    // The hit's title.
    text: string,
    // The kind + context line, assembled Rust-side.
    meta: string,
    // The selection ring (`index == selected-index`).
    emphasis: bool,
    // The habit row's History affordance bit (W-10, #1218): the row
    // activates into the history dialog (the read-role mount).
    history: bool,
    // The tombstoned-habit bit (#1218): the row names the retained-log
    // posture; no live-row state is forged.
    tombstone: bool,
}

export component SearchPalette inherits Rectangle {
    in property <[PaletteRowModel]> rows;
    in property <int> selected-index;
    // Hits beyond the visible cap (the caption's count; hidden at 0).
    in property <int> overflow;
    callback query-edited(string);
    // The focus-loss settle (round-3 L1).
    callback text-flow-focus-lost();
    callback row-activated(int);

    // Content-driven height (round-3 D24): the panel is its rows,
    // never a pane — the app-window clamp keeps it above the status
    // bar; the fixed input row cannot absorb the surplus.
    height: content.preferred-height;

    background: Theme.surface-raised;
    border-radius: Theme.radius-medium;
    border-width: Theme.focus-ring-width;
    border-color: Semantic.focus-ring;
    drop-shadow-blur: Theme.shadow-blur;
    // The walk mask is the ModalDialogHost's (the overlay migration,
    // M7 — the containment is structural, the extent rides the live
    // row count + the query field). The consumption edge stays the
    // palette's: the nonce's landing grabs the query field.
    property <int> watch-mask-nonce: MaskWalkFacts.nonce;
    changed watch-mask-nonce => {
        if (MaskWalkFacts.armed) {
            query-field.grab-focus();
        }
    }

    content := VerticalLayout {
        padding: Theme.space-2;
        spacing: Theme.space-1;

        // The input row is fixed at the field's natural single-line
        // height (round-3 D24): the surplus never distributes into
        // the field — the query row cannot grow with the palette.
        query-field := TextField {
            height: self.natural-height;
            vertical-stretch: 0;
            placeholder: "Search…";
            label: "Search";
            edited(text) => root.query-edited(text);
            focus-lost() => root.text-flow-focus-lost();
        }

        for row[index] in root.rows: palette-row := ListRow {
            vertical-stretch: 0;
            text: row.text;
            meta: row.meta;
            emphasis: index == root.selected-index;
            // The habit rows read as the secondary posture (the
            // History affordance rides the meta line's typed bits; a
            // tombstoned row reads offline-secondary — display only,
            // judged at the walkthrough, never text-asserted).
            tone: row.tombstone ? Tone.offline : (row.history ? Tone.info : Tone.neutral);
            row-touch := TouchArea {
                clicked => root.row-activated(index);
            }
        }

        // The caption gates are `if` mounts, not `visible: false`
        // (the gating law, docs/coding_guidelines.org §5): a hidden
        // caption kept its slot band at the palette's foot. The
        // palette is a transient overlay — position stability across
        // its own states has no consumer.
        if (root.overflow > 0): overflow-caption := RoleText {
            vertical-stretch: 0;
            role: Typography.caption;
            text-color: Theme.text-secondary;
            text: "+" + root.overflow + " more";
        }
        // The empty state's cross-reference (cross-surface friction
        // plan D-5, #772): the zero-hit/empty-query palette names its
        // CLI twin — one ranking engine, two fronts. Judged at the
        // walkthrough; never asserted by tests.
        if (root.rows.length == 0): empty-state-caption := RoleText {
            vertical-stretch: 0;
            role: Typography.caption;
            text-color: Theme.text-secondary;
            text: "The same ranking drives the CLI: taskboard find (or: search)";
        }
    }
}
