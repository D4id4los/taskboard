// SPDX-License-Identifier: AGPL-3.0-only
// The board-layout composition (L2, D8/D17): the responsive kanban.
// Regular/expansive render one column per stack with horizontal
// scroll; compact degenerates to a stack switcher plus the selected
// stack's single column with collapsed tertiary decorations. The
// panel demotion follows D17's declaration table (task columns
// primary, headers secondary, per-card decorations tertiary).
// Layout only — the display models are the inputs (Rule B/E); keys
// are the action layer's business (§5.1).

import { Theme, Typography, Semantic, RoleText, Tone } from "../theme.slint";
import { TooltipState } from "../widgets/tooltip.slint";
import { Responsive, Breakpoint } from "../responsive.slint";
import { TaskCard, TaskCardModel } from "../widgets/task-card.slint";
import { EmptyState } from "../widgets/empty-state.slint";
import { TextField } from "../widgets/text-field.slint";
import { Badge } from "../widgets/badge.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
import { PlusGlyph } from "../widgets/plus-glyph.slint";
import { BoardBar, BoardBarModel } from "board-bar.slint";
import { DragState } from "../drag-state.slint";
import { FocusScrollHint } from "../focus-scroll.slint";
import { ListView } from "../widgets/listview.slint";

// One labelled call-to-action button (r3 D5): no generic Button
// primitive exists in the widget set, and the empty-board page needs
// two labelled CTAs. One control row tall, `radius-small`,
// `surface-hover` on hover; the label is a RoleText body. Explicitly
// `export`: a file-local component *used by* an exported component
// triggers the implicit-export deprecation. A third use promotes it
// to `ui/widgets/` (the rule-E note).
export component CtaButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: Theme.space-6;
    border-radius: Theme.radius-small;
    background: cta-hit.has-hover ? Theme.surface-hover : Theme.surface-raised;
    min-width: Theme.space-6 * 4;
    // The a11y address: the label is both the paint and the tree's
    // name (the click-by-label seam is the same default action).
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-action-default => root.clicked();
    cta-hit := TouchArea {
        clicked => root.clicked();
    }
    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        alignment: center;
        RoleText {
            role: Typography.body;
            text: root.label;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// One kanban column (rule B: a display model, not a bag of strings).
export struct StackColumnModel {
    title: string,
    tasks: [TaskCardModel],
    // The inline create row of this column (D8), open or closed.
    create-open: bool,
    // The stack-rename field of this column (r2 D21), open or closed;
    // the seeded buffer (the mount-only initial-text rule).
    rename-open: bool,
    initial-title: string,
    // The user-set rendered column width (round-1 D16); ≤ 0 = auto —
    // the conditional layout clamps below never engage and the column
    // keeps the untouched distribution (the goldens' auto-layout
    // guarantee). Rust-authoritative: pushed by the models, never
    // owned by a slint binding during a drag.
    width-px: length,
}

export component BoardLayout inherits Rectangle {
    in property <[StackColumnModel]> stacks;
    // The compact switcher's selected stack (a stack index).
    in property <int> selected-stack;
    // The move flow's highlighted target stack (−1 = no flow).
    in property <int> move-target;
    callback task-activated(int, int);
    callback task-clicked(int, int);
    // The right-click context request (round-1 D13).
    callback task-context(int, int, float, float);
    callback header-activated(int);
    callback switcher-activated(int);
    // The stack-header right-click (r2 D21): select the column, then
    // open the stack context menu at the pointer — the card pattern
    // (right-click selects like left-click).
    callback header-context(int, float, float);
    // The stack card's bare-surface right-click (r3 D4): the empty
    // stack's whole body, a populated stack's space below the last
    // card — routed to the same stack context menu as the header.
    callback body-context(int, float, float);
    // The done checkbox's toggle (r3 D6): (column, task) — the
    // adapter resolves the id tables and flips the model bit.
    callback task-done-toggled(int, int);
    // The stack-rename field of one column (r2 D21).
    callback rename-committed(int, string);
    callback rename-edited(int, string);
    callback create-committed(int, string);
    callback create-edited(int, string);
    // The per-column Add Task ghost (r2 D8): select the column's
    // stack, then route task.create — the keyboard's exact action.
    callback add-task-activated(int);
    // The board bar (design §3.8): the live-board strip above the
    // kanban, regular/expansive only — compact hides the strip
    // (keyboard switching still works).
    in property <BoardBarModel> board-bar;
    // The board.select binding hint for the segment tooltips (D21b).
    in property <[string]> board-segment-hint;
    // The task.edit binding hint for the card tooltips (D8).
    in property <[string]> task-card-hint;
    // The stack.wider binding hint for the header tooltips (D18).
    in property <[string]> stack-header-hint;
    // The stack.create binding hint for the add-column tooltip (r2 D6).
    in property <[string]> stack-create-hint;
    // The task.create binding hint for the add-task ghost tooltips
    // (r3 D3).
    in property <[string]> task-create-hint;
    // The drag seams (round-1 D17): press captures the pre-drag base
    // width, drag reports the absolute delta since press (idempotent
    // against dropped events), release persists. Button-agnostic — a
    // dedicated handle cannot conflict with card clicks.
    callback stack-width-press(int, float);
    callback stack-width-drag(int, float);
    callback stack-width-release(int);
    // The pointer drag-to-move seams (r2 chunk-8, D-E/D-F): a card's
    // DragArea reports the arm (column, row); a column DropArea
    // reports the hovered column and the drop. Index-only, the D2
    // convention — the adapter resolves the id tables.
    callback board-card-drag-armed(int, int);
    callback board-drag-hovered(int);
    callback board-card-dropped(int);
    // The bool is the negotiated outcome (`drag-finished`): true = a
    // completed drop (the dropped seam already confirmed), false = a
    // cancelled drag.
    callback board-card-drag-finished(int, int, bool);
    // Any flow holds (the D9 XOR belt): the DragAreas refuse to arm
    // while a flow is open — the view-state refusal is the suspenders.
    in property <bool> flow-open: false;
    callback board-bar-activated(int);
    // The board-bar segment right-click (r2 D21), threaded through.
    callback segment-context(int, float, float);
    // The stack-create flow (usability D7): the on-board button and
    // the field's mirror/commit seams; open is board-level.
    in property <bool> stack-create-open;
    callback new-stack-activated();
    // The empty-board preset CTA (r3 D5): create the default kanban
    // stacks in one click — direct command dispatch, no text flow.
    callback board-default-preset-clicked();
    callback stack-create-committed(string);
    callback stack-create-edited(string);
    // The focus-loss settle (round-3 L1): every text flow's field
    // forwards to the window's one settle seam.
    callback text-flow-focus-lost();

    // The dead-zone catch-all (r2 chunk-8, D-D): the whole board
    // surface beneath every column (declared first = lowest z, the
    // later-sibling-is-hit-tested-first order). It rejects every drop
    // — a release over it is the native no-accepted-target cancel —
    // but still reports the pointer, so the ghost tracks across the
    // column gaps and the board bar.
    DropArea {
        width: 100%;
        height: 100%;
        can-drop(event) => {
            DragState.pointer-x = self.absolute-position.x + event.position.x;
            DragState.pointer-y = self.absolute-position.y + event.position.y;
            DragAction.none
        }
    }

    // The rendering fact for tests and reviews (§6 test 2): compact
    // mode is active — switcher visible, single column, collapsed
    // decorations.
    out property <bool> compact-active: Responsive.current-breakpoint == Breakpoint.compact;

    // The stack index the switcher renders for (compact): the −1
    // "no selection" push (r2 D4) clamps to stack 0 — compact's
    // mount-time pixels are exactly the old 0-fallback's.
    pure function effective-selected() -> int {
        Math.max(root.selected-stack, 0)
    }

    // The stack index the switcher renders for (compact).
    pure function selected-column() -> StackColumnModel {
        root.stacks[root.effective-selected()]
    }

    // The empty board (r3 D5): the bar renders here too — it is
    // board-keyed, so a fresh empty board still shows its one tab
    // (F11's tabs-less view fixed at the root) — then the centered
    // labelled CTAs and the stack-create field. Compact keeps the
    // existing rule (the strip hides, the centered block renders).
    if (root.stacks.length == 0): VerticalLayout {
        alignment: center;
        spacing: Theme.space-3;
        // Conditional elements get no default fill geometry (the
        // populated leg's recorded deviation) — the bar spans.
        BoardBar {
            width: 100%;
            bar: root.board-bar;
            segment-hint: root.board-segment-hint;
            segment-activated(index) => root.board-bar-activated(index);
            segment-context(i, x, y) => root.segment-context(i, x, y);
        }
        EmptyState {
            text: "No stacks yet";
            hint: "Create the first stack with the button below";
        }
        CtaButton {
            label: "New stack";
            clicked => root.new-stack-activated();
        }
        CtaButton {
            label: "Create Default Kanban Setup";
            clicked => root.board-default-preset-clicked();
        }
        // The stack-create flow's field on the empty board (round-3
        // R5/F10): `begin_create_stack` arms the flow regardless of
        // stack count, so the affordance renders in every leg. Same
        // bindings as the populated legs' fields.
        if (root.stack-create-open): TextField {
            placeholder: "New stack name";
            label: "New stack name";
            commit-affordance: true;
            accepted(text) => root.stack-create-committed(text);
            edited(text) => root.stack-create-edited(text);
            focus-lost() => root.text-flow-focus-lost();
        }
    }

    if (root.stacks.length > 0 && !root.compact-active): VerticalLayout {
        // The leg must receive the window width: conditional (`if`)
        // elements get no default fill geometry (the compiler's
        // default-geometry pass skips repeated elements), so without
        // this the columns row collapses to min-content and D1's
        // stretch distribution has no surplus to distribute (r2
        // board-surface plan, recorded deviation D1-b).
        width: 100%;
        // Rhythm (r2 D35): the cards hang one space-2 below the bar's
        // baseline instead of flush against it (space-1 was the bare
        // board's default).
        spacing: Theme.space-2;

        // The board bar (design §3.8): one segment per live board,
        // selected state highlighted; clicks route through the action
        // layer (the window's dispatch seam).
        BoardBar {
            bar: root.board-bar;
            segment-hint: root.board-segment-hint;
            segment-activated(index) => root.board-bar-activated(index);
            segment-context(i, x, y) => root.segment-context(i, x, y);
        }

        // The columns row (r2 D35): the board-background strip is
        // painted by this padding — left/right/bottom frame the card
        // row; top stays 0, the bar's baseline defines the top edge.
        HorizontalLayout {
            spacing: Theme.space-3;
            padding-left: Theme.space-3;
            padding-right: Theme.space-3;
            padding-bottom: Theme.space-3;
            for column[column-index] in root.stacks: drop-zone := DropArea {
                // The column's drop target (r2 chunk-8, D-E): wraps the
                // whole stack card — a generous, column-granular target
                // matching the keyboard flow's ring. The native DragMove
                // hit-testing designates this element; no column
                // geometry crosses to Rust. The filter forwards every
                // non-drag event to the card beneath, so clicks, hovers
                // and the resize handle are untouched (D-H).
                can-drop(event) => {
                    DragState.pointer-x = self.absolute-position.x + event.position.x;
                    DragState.pointer-y = self.absolute-position.y + event.position.y;
                    root.board-drag-hovered(column-index);
                    DragAction.move
                }
                dropped(event) => {
                    root.board-card-dropped(column-index);
                    return event.proposed-action;
                }
                // The layout constraints live on the DropArea (the
                // row's child); the card fills it (D1's floor, the
                // solver perturbation caution — unchanged semantics).
                min-width: column.width-px > 0 * Theme.space-1
                    ? column.width-px
                    : 0 * Theme.space-1;
                horizontal-stretch: 1;
                max-width: root.width;
                card := Rectangle {
                    width: 100%;
                    height: 100%;
                    // The bare-surface context seam (r3 D4): declared
                    // FIRST = lowest z, so the header, the viewport's
                    // cards, the fields and the ghost are hit-tested
                    // before it — only the bare surface (an empty
                    // stack's body, the space below the last card)
                    // falls through. Right-down only; left-clicks on
                    // bare surface stay no-ops (today's behaviour).
                    body-hit := TouchArea {
                        width: 100%;
                        height: 100%;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down
                                    && event.button == PointerEventButton.right) {
                                root.body-context(column-index,
                                    self.absolute-position.x / 1px + self.mouse-x / 1px,
                                    self.absolute-position.y / 1px + self.mouse-y / 1px);
                            }
                        }
                    }
                    // The stack card (r2 D35): each column wraps in a
                    // `surface` container — the existing ladder re-anchored
                    // (background < surface card < surface-raised task
                    // card), the segmented control's track/thumb language.
                    // D35's literal `surface-raised` card token is boxed by
                    // the hover-distinctness guard (no valid raised-again
                    // step exists under the current hover token; the plan
                    // §2.1 records the deviation).
                    background: Theme.surface;
                    border-radius: Theme.radius-medium;
                    // The D16 address stays on the body (the card is an
                    // unnamed paint wrapper; the accessible tree shape is
                    // unchanged for the driver and ATs).
                    // The inner padding (space-2) lives on the layout —
                    // plain Rectangle ignores `padding` (the r2 D35
                    // comment documented an inset that silently never
                    // applied; the sweep's one behavioural fix). Deliberately
                    // smaller than the outer strip (space-3) — content
                    // groups tighter than the group.
                    column-body := VerticalLayout {
                        padding: Theme.space-2;
                        spacing: Theme.space-1;
                        // The D16 address: the column is a list labelled by
                        // its stack title.
                        accessible-role: AccessibleRole.list;
                        accessible-label: column.title;
                        // Column header: display + activation (D13 — stack
                        // management is CLI-only in v0.1.0); a labelled button
                        // (D16), click = select the column's stack.
                        header := Rectangle {
                            accessible-role: AccessibleRole.button;
                            accessible-label: column.title;
                            // The AT/keyboard activation lands on the same
                            // selection seam the TouchArea's click hits (the
                            // add-col FocusScope pattern; the plan's T-10
                            // click-by-label address).
                            accessible-action-default => root.header-activated(column-index);
                            // One locked control row (r2 D3, the D20b board-bar
                            // constant inline — no new theme token; the token
                            // ladder is chunk 7's): the height no longer depends
                            // on column content, so a 0-task stack's title
                            // renders at every other stack's height.
                            min-height: Theme.space-6 + 2 * Theme.space-1;
                            max-height: Theme.space-6 + 2 * Theme.space-1;
                            // A shrunken column's content stays inside its bounds.
                            clip: true;
                            header-hit := TouchArea {
                                clicked => root.header-activated(column-index);
                                // The r2 D21 stack-header right-click: the
                                // task-card pattern — right-down reports the
                                // window-coordinate pointer for the context
                                // menu anchor (the adapter selects first).
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down
                                            && event.button == PointerEventButton.right) {
                                        root.header-context(column-index,
                                            self.absolute-position.x / 1px + self.mouse-x / 1px,
                                            self.absolute-position.y / 1px + self.mouse-y / 1px);
                                    }
                                }
                                // The D8/D11/D18 header tooltip: the stack title
                                // plus the stack.wider binding hint (a keymap
                                // projection pushed per refresh).
                                changed has-hover => {
                                    if (self.has-hover) {
                                        TooltipState.hover(column.title, "",
                                            root.stack-header-hint,
                                            self.absolute-position.x, self.absolute-position.y,
                                            self.width, self.height);
                                    } else {
                                        TooltipState.unhover();
                                    }
                                }
                            }
                            // The column resize handle (round-1 D17): the builtin
                            // tableview's exact pattern — a 10 px-wide TouchArea
                            // with the ew-resize cursor at the column's right
                            // edge (the inter-column gap visually belongs to
                            // it). Full header height.
                            resize-handle := TouchArea {
                                x: parent.width - self.width;
                                width: Theme.resize-handle-width;
                                height: 100%;
                                mouse-cursor: ew-resize;
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down) {
                                        root.stack-width-press(column-index,
                                            column-body.width / 1px);
                                    }
                                    if (event.kind == PointerEventKind.up) {
                                        root.stack-width-release(column-index);
                                    }
                                }
                                moved => {
                                    if (self.pressed) {
                                        root.stack-width-drag(column-index,
                                            (self.mouse-x - self.pressed-x) / 1px);
                                    }
                                }
                            }
                            // The selected stack paints in regular mode (r2
                            // D4): raised fill + focus ring (the compact
                            // switcher's selected language). Move-target keeps
                            // its distinct arm (raised, no ring) and wins when
                            // both apply — the ring returns when the move flow
                            // ends. clip keeps the ring inside the radius.
                            background: header-hit.has-hover ? Theme.surface-hover
                                : column-index == root.move-target ? Theme.surface-raised
                                : column-index == root.selected-stack ? Theme.surface-raised
                                : transparent;
                            border-width: column-index == root.selected-stack
                                ? Theme.focus-ring-width : 0;
                            border-color: Semantic.focus-ring;
                            border-radius: Theme.radius-small;
                            HorizontalLayout {
                                padding-left: Theme.space-2;
                                padding-right: Theme.space-2;
                                // The r2 D21 rename field swaps in for the
                                // title row while the flow is open — inside the
                                // locked-height control row (r2 D3 preserved).
                                if (column.rename-open): TextField {
                                    placeholder: "Stack name";
                                    label: "Stack name";
                                    initial-text: column.initial-title;
                                    // The task-title editor's convention: the
                                    // seeded title starts selected (D14).
                                    selected-on-focus: true;
                                    horizontal-stretch: 1;
                                    accepted(text) => root.rename-committed(column-index, text);
                                    edited(text) => root.rename-edited(column-index, text);
                                    focus-lost() => root.text-flow-focus-lost();
                                }
                                if (!column.rename-open): RoleText {
                                    role: Typography.heading;
                                    text: column.title;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    // The D19 mechanical half (round-1 §5): a
                                    // long stack title may not force the
                                    // layout min above the window floors. The
                                    // conditional engagement resolved as
                                    // recorded debt: elide stays unconditional
                                    // (chunk 1's window-floor requirement), the
                                    // auto-layout guarantee rides only on the
                                    // width-px binding above (plan §9.1).
                                    overflow: elide;
                                }
                                Badge {
                                    text: "\{column.tasks.length}";
                                    tone: column-index == root.move-target ? Tone.sync-active : Tone.neutral;
                                }
                            }
                        }

                        VerticalLayout {
                            // The task area absorbs the column's surplus height
                            // (r2 D3): with the header locked, every leftover
                            // pixel flows here (F-A6's equal-split fix). The
                            // task viewport (the ListView below) absorbs the
                            // surplus — see the note on `lv` for the recorded
                            // deviation from the stage-1 plan's D-4.
                            vertical-stretch: 1;
                            spacing: Theme.space-1;
                            // The tasks loop: each card is wrapped in a
                            // DragArea (r2 chunk-8 D-A) — the pointer drag's
                            // source. Below the slop the filter forwards
                            // everything to the card (click/double-click/
                            // context untouched, D-H); past the 8-px slop the
                            // runtime owns the drag and the arm seam fires.
                            // The explicit height carries the card's
                            // preferred: a DragArea reports no intrinsic
                            // size, and the `alignment: start` list never
                            // stretches.
                            // The column's task viewport (#373): the unchanged
                            // delegate loop inside the in-house ListView —
                            // viewport-scale instantiation at any N. The seams
                            // keep the global model indices. The viewport
                            // absorbs the task area's surplus: a recorded
                            // deviation from the stage-1 plan's D-4, whose
                            // `min-height: 0` content-sized premise does not
                            // hold (slint's Flickable reports no
                            // content-derived layout info — items.rs
                            // layout_info is the default, preferred 0 — so a
                            // start-aligned viewport would collapse to zero
                            // height, and no stable sibling-height arithmetic
                            // exists to cap a content-sized one). Consequence:
                            // the ghost and the create field sit at the
                            // column's bottom edge instead of hugging the last
                            // card on fitting-content columns — a diagnosed
                            // golden drift, see the regen commit.
                            lv := ListView {
                                min-height: 0;
                                // The card drag-to-move owns the pointer
                                // gesture inside the viewport (r2 chunk-8):
                                // the Flickable's drag-pan would consume it.
                                // Wheel and keyboard scrolling are untouched.
                                mouse-drag-pan-enabled: false;
                                request-row: FocusScrollHint.target-a == column-index
                                    ? FocusScrollHint.target-b
                                    : -1;
                                request-nonce: FocusScrollHint.target-a == column-index
                                    ? FocusScrollHint.nonce
                                    : 0;
                                total-rows: column.tasks.length;
                                for task[task-index] in column.tasks: drag-zone := DragArea {
                                    width: 100%;
                                    height: drag-card.preferred-height;
                                    allow-move: !root.flow-open;
                                    data: DragState.payload;
                                    changed dragging => {
                                        if (self.dragging) {
                                            // The ghost's size capture (r3 D1):
                                            // the card is fully laid out at the
                                            // arm, so its geometry rides along —
                                            // no column/card geometry crosses to
                                            // Rust (the r2 D-E invariant).
                                            DragState.ghost-width = drag-card.width;
                                            DragState.ghost-height = drag-card.height;
                                            root.board-card-drag-armed(column-index, task-index);
                                        }
                                    }
                                    drag-finished(action) => {
                                        root.board-card-drag-finished(column-index, task-index,
                                            action != DragAction.none);
                                    }
                                    drag-card := TaskCard {
                                        width: 100%;
                                        height: 100%;
                                        model: task;
                                        hint-keys: root.task-card-hint;
                                        activated => root.task-activated(column-index, task-index);
                                        clicked => root.task-clicked(column-index, task-index);
                                        context-requested(x, y) => root.task-context(column-index, task-index, x, y);
                                        done-toggled => root.task-done-toggled(column-index, task-index);
                                    }
                                }
                            }

                            // The inline create row (D8): single-line field,
                            // auto-focused, insert mode. Below the viewport,
                            // never stretched into the surplus.
                            if (column.create-open): TextField {
                                vertical-stretch: 0;
                                placeholder: "New task title";
                                label: "New task title";
                                commit-affordance: true;
                                accepted(text) => root.create-committed(column-index, text);
                                edited(text) => root.create-edited(column-index, text);
                                focus-lost() => root.text-flow-focus-lost();
                            }

                            // The per-column Add Task ghost (r2 D8): the
                            // add-column's visual language at one control row;
                            // empty stacks show it instead of blank space.
                            // Below the viewport (see the note on `lv`), never
                            // stretched into the surplus.
                            add-task := Rectangle {
                                vertical-stretch: 0;
                                min-height: Theme.space-6 + 2 * Theme.space-1;
                                max-height: Theme.space-6 + 2 * Theme.space-1;
                                border-radius: Theme.radius-small;
                                background: add-task-hit.has-hover ? Theme.surface-hover : transparent;
                                add-task-hit := TouchArea {
                                    clicked => root.add-task-activated(column-index);
                                    // The ghost tooltip (r3 D3): the standard
                                    // enter-arms/leave-dismiss wiring; the label
                                    // is the accessible tree's own, the
                                    // description is a presentation literal.
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            TooltipState.hover("Add task",
                                                "Creates a task in this stack.",
                                                root.task-create-hint,
                                                self.absolute-position.x, self.absolute-position.y,
                                                self.width, self.height);
                                        } else {
                                            TooltipState.unhover();
                                        }
                                    }
                                }
                                add-task-focus := FocusScope {
                                    width: 100%;
                                    height: 100%;
                                    focus-on-tab-navigation: true;
                                    accessible-role: AccessibleRole.button;
                                    accessible-label: "Add task";
                                    accessible-action-default => root.add-task-activated(column-index);
                                }
                                PlusGlyph {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    glyph-color: add-task-hit.has-hover ? Theme.text-primary : Theme.text-secondary;
                                }
                            }
                        }
                    }
                }
            }

            // The trailing add-column affordance (round-1 D22): the
            // New-stack button's regular/expansive home — a slim
            // full-height column after the last stack, the click
            // equivalent of stack.create (§7.1).
            Rectangle {
                width: Theme.space-6 + Theme.space-2;
                border-radius: Theme.radius-small;
                background: add-col-hit.has-hover ? Theme.surface-hover : transparent;
                add-col-hit := TouchArea {
                    clicked => root.new-stack-activated();
                    // The generalized tooltip trigger (r2 D6): the
                    // standard enter-arms/leave-dismiss wiring, the
                    // same property the a11y layer reads as the label.
                    changed has-hover => {
                        if (self.has-hover) {
                            TooltipState.hover("New stack",
                                "Adds a new stack to this board.",
                                root.stack-create-hint,
                                self.absolute-position.x, self.absolute-position.y,
                                self.width, self.height);
                        } else {
                            TooltipState.unhover();
                        }
                    }
                }
                add-col-focus := FocusScope {
                    width: 100%;
                    height: 100%;
                    focus-on-tab-navigation: true;
                    accessible-role: AccessibleRole.button;
                    accessible-label: "New stack";
                    accessible-action-default => root.new-stack-activated();
                }
                // The square plus (r2 D5): the glyph is locked to
                // space-6 on both axes and centred — the affordance
                // stays a full-height hit target.
                icon-box := PlusGlyph {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    glyph-color: add-col-hit.has-hover ? Theme.text-primary : Theme.text-secondary;
                }
            }
        }

        // The stack-create flow's field (usability D7): board-level,
        // at the end of the columns row, auto-focused on mount.
        if (root.stack-create-open): TextField {
            placeholder: "New stack name";
            label: "New stack name";
            commit-affordance: true;
            accepted(text) => root.stack-create-committed(text);
            edited(text) => root.stack-create-edited(text);
            focus-lost() => root.text-flow-focus-lost();
        }
    }

    if (root.stacks.length > 0 && root.compact-active): VerticalLayout {
        spacing: Theme.space-1;

        // The stack switcher: the first focusable element of the
        // compact board (D8/D15); a segmented row of stack titles.
        switcher := HorizontalLayout {
            spacing: Theme.space-1;
            accessible-role: AccessibleRole.tab-list;
            accessible-label: "Stacks";
            for column[column-index] in root.stacks: segment := FocusScope {
                // A real tab stop (D15); the keyboard path for switching
                // is the action layer's selection-follows-focus (D8).
                focus-on-tab-navigation: true;
                accessible-role: AccessibleRole.tab;
                accessible-label: column.title;
                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: Theme.radius-small;
                    background: segment-hover.has-hover ? Theme.surface-hover
                        : column-index == root.effective-selected() ? Theme.surface-raised
                        : column-index == root.move-target ? Theme.surface
                        : transparent;
                    border-width: segment.has-focus || column-index == root.move-target
                        ? Theme.focus-ring-width : 0;
                    border-color: Semantic.focus-ring;
                    HorizontalLayout {
                        padding-left: Theme.space-2;
                        padding-right: Theme.space-2;
                        RoleText {
                            role: column-index == root.effective-selected()
                                ? Typography.body-emphasized
                                : Typography.body;
                            text-color: column-index == root.effective-selected()
                                ? Theme.text-primary
                                : Theme.text-secondary;
                            text: column.title;
                            vertical-alignment: center;
                        }
                    }
                }
                // The hover cue's owner (usability D2). The r2 D21
                // right-click shares the regular header's context seam
                // (same object class — the switcher reuses the
                // effective-selected addressing through the same
                // column index).
                segment-hover := TouchArea {
                    clicked => root.switcher-activated(column-index);
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down
                                && event.button == PointerEventButton.right) {
                            root.header-context(column-index,
                                self.absolute-position.x / 1px + self.mouse-x / 1px,
                                self.absolute-position.y / 1px + self.mouse-y / 1px);
                        }
                    }
                }
            }
            // The compact New-stack affordance (r2 D7): inline at the
            // switcher row's end — no own row at the smallest
            // viewport; reachable, click-equivalent.
            IconButton {
                icon: IconKind.plus;
                label: "New stack";
                clicked => root.new-stack-activated();
            }
        }

        // The stack-create flow's field (usability D7), compact leg.
        if (root.stack-create-open): TextField {
            placeholder: "New stack name";
            label: "New stack name";
            commit-affordance: true;
            accepted(text) => root.stack-create-committed(text);
            edited(text) => root.stack-create-edited(text);
            focus-lost() => root.text-flow-focus-lost();
        }

        // The selected stack's single column, tertiary decorations
        // collapsed via `compact: true` (D8).
        for column[column-index] in [root.selected-column()]: VerticalLayout {
            spacing: Theme.space-1;
            // The D16 address: same list role as a regular column.
            accessible-role: AccessibleRole.list;
            accessible-label: column.title;
            // The r2 D21 rename field (compact leg): no header exists
            // here, so the field mounts atop the selected column.
            if (column.rename-open): TextField {
                placeholder: "Stack name";
                label: "Stack name";
                initial-text: column.initial-title;
                selected-on-focus: true;
                accepted(text) => root.rename-committed(root.effective-selected(), text);
                edited(text) => root.rename-edited(root.effective-selected(), text);
                focus-lost() => root.text-flow-focus-lost();
            }
            // The selected stack's task viewport (#373's D-4b): the
            // unchanged bare-card loop inside the in-house ListView,
            // addressed through `effective-selected()` exactly as
            // before; `compact-task` names the delegate for the
            // engagement probe. The viewport absorbs the leg's
            // surplus height (see the note on the regular leg's `lv`).
            task-viewport := ListView {
                min-height: 0;
                // The card drag-to-move owns the pointer gesture inside
                // the viewport (see the regular leg's `lv`).
                mouse-drag-pan-enabled: false;
                request-row: FocusScrollHint.target-a == column-index
                    ? FocusScrollHint.target-b
                    : -1;
                request-nonce: FocusScrollHint.target-a == column-index
                    ? FocusScrollHint.nonce
                    : 0;
                total-rows: column.tasks.length;
                for task[task-index] in column.tasks: compact-task := TaskCard {
                    model: task;
                    compact: true;
                    hint-keys: root.task-card-hint;
                    activated => root.task-activated(root.effective-selected(), task-index);
                    clicked => root.task-clicked(root.effective-selected(), task-index);
                    context-requested(x, y) => root.task-context(root.effective-selected(), task-index, x, y);
                    done-toggled => root.task-done-toggled(root.effective-selected(), task-index);
                }
            }

                if (column.create-open): TextField {
                    placeholder: "New task title";
                    label: "New task title";
                    commit-affordance: true;
                    accepted(text) => root.create-committed(root.effective-selected(), text);
                    edited(text) => root.create-edited(root.effective-selected(), text);
                    focus-lost() => root.text-flow-focus-lost();
                }

                // The compact leg's ghost (r2 D8): addresses the
                // effective-selected stack.
                add-task-compact := Rectangle {
                    min-height: Theme.space-6 + 2 * Theme.space-1;
                    max-height: Theme.space-6 + 2 * Theme.space-1;
                    border-radius: Theme.radius-small;
                    background: add-task-hit-compact.has-hover ? Theme.surface-hover : transparent;
                    add-task-hit-compact := TouchArea {
                        clicked => root.add-task-activated(root.effective-selected());
                        // The ghost tooltip (r3 D3), compact leg — the
                        // regular ghost's wiring verbatim.
                        changed has-hover => {
                            if (self.has-hover) {
                                TooltipState.hover("Add task",
                                    "Creates a task in this stack.",
                                    root.task-create-hint,
                                    self.absolute-position.x, self.absolute-position.y,
                                    self.width, self.height);
                            } else {
                                TooltipState.unhover();
                            }
                        }
                    }
                    add-task-focus-compact := FocusScope {
                        width: 100%;
                        height: 100%;
                        focus-on-tab-navigation: true;
                        accessible-role: AccessibleRole.button;
                        accessible-label: "Add task";
                        accessible-action-default => root.add-task-activated(root.effective-selected());
                    }
                    PlusGlyph {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        glyph-color: add-task-hit-compact.has-hover ? Theme.text-primary : Theme.text-secondary;
                    }
                }
        }
    }
}
