// SPDX-License-Identifier: AGPL-3.0-only
// The board-layout composition (L2, D8/D17): the responsive kanban.
// Regular/expansive render one column per stack with horizontal
// scroll; compact degenerates to a stack switcher plus the selected
// stack's single column with collapsed tertiary decorations. The
// panel demotion follows D17's declaration table (task columns
// primary, headers secondary, per-card decorations tertiary).
// Layout only — the display models are the inputs (Rule B/E); keys
// are the action layer's business (§5.1).

import { Theme, Typography, Semantic, RoleText, Tone } from "../theme.slint";
import { Responsive, Breakpoint } from "../responsive.slint";
import { TaskCard, TaskCardModel } from "../widgets/task-card.slint";
import { EmptyState } from "../widgets/empty-state.slint";
import { TextField } from "../widgets/text-field.slint";
import { Badge } from "../widgets/badge.slint";
import { IconButton, IconKind } from "../widgets/icon-button.slint";
import { BoardBar, BoardBarModel } from "board-bar.slint";

// One kanban column (rule B: a display model, not a bag of strings).
export struct StackColumnModel {
    title: string,
    tasks: [TaskCardModel],
    // The inline create row of this column (D8), open or closed.
    create-open: bool,
}

export component BoardLayout inherits Rectangle {
    in property <[StackColumnModel]> stacks;
    // The compact switcher's selected stack (a stack index).
    in property <int> selected-stack;
    // The move flow's highlighted target stack (−1 = no flow).
    in property <int> move-target;
    callback task-activated(int, int);
    callback task-clicked(int, int);
    // The right-click context request (round-1 D13).
    callback task-context(int, int, float, float);
    callback header-activated(int);
    callback switcher-activated(int);
    callback create-committed(int, string);
    callback create-edited(int, string);
    // The board bar (design §3.8): the live-board strip above the
    // kanban, regular/expansive only — compact hides the strip
    // (keyboard switching still works).
    in property <BoardBarModel> board-bar;
    // The board.select binding hint for the segment tooltips (D21b).
    in property <[string]> board-segment-hint;
    // The task.edit binding hint for the card tooltips (D8).
    in property <[string]> task-card-hint;
    callback board-bar-activated(int);
    // The stack-create flow (usability D7): the on-board button and
    // the field's mirror/commit seams; open is board-level.
    in property <bool> stack-create-open;
    callback new-stack-activated();
    callback stack-create-committed(string);
    callback stack-create-edited(string);

    // The rendering fact for tests and reviews (§6 test 2): compact
    // mode is active — switcher visible, single column, collapsed
    // decorations.
    out property <bool> compact-active: Responsive.current-breakpoint == Breakpoint.compact;

    // The stack index the switcher renders for (compact).
    pure function selected-column() -> StackColumnModel {
        root.stacks[root.selected-stack]
    }

    // The empty board (usability D7): the same New-stack button the
    // populated board bar carries — EmptyState stays a pure text
    // primitive (Rule E), the composition owns the affordance.
    if (root.stacks.length == 0): VerticalLayout {
        alignment: center;
        spacing: Theme.space-3;
        EmptyState {
            text: "No stacks yet";
            hint: "Create the first stack with the button below";
        }
        IconButton {
            icon: IconKind.plus;
            label: "New stack";
            clicked => root.new-stack-activated();
        }
    }

    if (root.stacks.length > 0 && !root.compact-active): VerticalLayout {
        spacing: Theme.space-1;

        // The board bar (design §3.8): one segment per live board,
        // selected state highlighted; clicks route through the action
        // layer (the window's dispatch seam).
        BoardBar {
            bar: root.board-bar;
            segment-hint: root.board-segment-hint;
            segment-activated(index) => root.board-bar-activated(index);
        }

        HorizontalLayout {
            spacing: Theme.space-3;
            for column[column-index] in root.stacks: VerticalLayout {
                spacing: Theme.space-1;
                // The D16 address: the column is a list labelled by its
                // stack title.
                accessible-role: AccessibleRole.list;
                accessible-label: column.title;
                // Column header: display + activation (D13 — stack
                // management is CLI-only in v0.1.0); a labelled button
                // (D16), click = select the column's stack.
                header := Rectangle {
                    accessible-role: AccessibleRole.button;
                    accessible-label: column.title;
                    header-hit := TouchArea {
                        clicked => root.header-activated(column-index);
                    }
                    background: header-hit.has-hover ? Theme.surface-hover
                        : column-index == root.move-target ? Theme.surface-raised
                        : transparent;
                    border-radius: Theme.radius-small;
                    HorizontalLayout {
                        padding-left: Theme.space-2;
                        padding-right: Theme.space-2;
                        RoleText {
                            role: Typography.heading;
                            text: column.title;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Badge {
                            text: "\{column.tasks.length}";
                            tone: column-index == root.move-target ? Tone.sync-active : Tone.neutral;
                        }
                    }
                }

                VerticalLayout {
                    alignment: start;
                    spacing: Theme.space-1;
                    for task[task-index] in column.tasks: TaskCard {
                        model: task;
                        hint-keys: root.task-card-hint;
                        activated => root.task-activated(column-index, task-index);
                        clicked => root.task-clicked(column-index, task-index);
                        context-requested(x, y) => root.task-context(column-index, task-index, x, y);
                    }

                    // The inline create row (D8): single-line field,
                    // auto-focused, insert mode.
                    if (column.create-open): TextField {
                        placeholder: "New task title";
                        label: "New task title";
                        accepted(text) => root.create-committed(column-index, text);
                        edited(text) => root.create-edited(column-index, text);
                    }
                }
            }

            // The trailing add-column affordance (round-1 D22): the
            // New-stack button's regular/expansive home — a slim
            // full-height column after the last stack, the click
            // equivalent of stack.create (§7.1).
            Rectangle {
                width: Theme.space-6 + Theme.space-2;
                border-radius: Theme.radius-small;
                background: add-col-hit.has-hover ? Theme.surface-hover : transparent;
                add-col-hit := TouchArea {
                    clicked => root.new-stack-activated();
                }
                add-col-focus := FocusScope {
                    width: 100%;
                    height: 100%;
                    focus-on-tab-navigation: true;
                    accessible-role: AccessibleRole.button;
                    accessible-label: "New stack";
                    accessible-action-default => root.new-stack-activated();
                }
                icon-box := Rectangle {
                    // A plus: the two bars crossing centred (the
                    // icon-button plus glyph, composed inline).
                    x: Theme.space-2;
                    y: Theme.space-2;
                    width: parent.width - 2 * Theme.space-2;
                    height: parent.height - 2 * Theme.space-2;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 100%;
                        height: Theme.focus-ring-width;
                        background: add-col-hit.has-hover ? Theme.text-primary : Theme.text-secondary;
                    }
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        height: 100%;
                        width: Theme.focus-ring-width;
                        background: add-col-hit.has-hover ? Theme.text-primary : Theme.text-secondary;
                    }
                }
            }
        }

        // The stack-create flow's field (usability D7): board-level,
        // at the end of the columns row, auto-focused on mount.
        if (root.stack-create-open): TextField {
            placeholder: "New stack name";
            label: "New stack name";
            accepted(text) => root.stack-create-committed(text);
            edited(text) => root.stack-create-edited(text);
        }
    }

    if (root.stacks.length > 0 && root.compact-active): VerticalLayout {
        spacing: Theme.space-1;

        // The stack switcher: the first focusable element of the
        // compact board (D8/D15); a segmented row of stack titles.
        switcher := HorizontalLayout {
            spacing: Theme.space-1;
            accessible-role: AccessibleRole.tab-list;
            accessible-label: "Stacks";
            for column[column-index] in root.stacks: segment := FocusScope {
                // A real tab stop (D15); the keyboard path for switching
                // is the action layer's selection-follows-focus (D8).
                focus-on-tab-navigation: true;
                accessible-role: AccessibleRole.tab;
                accessible-label: column.title;
                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: Theme.radius-small;
                    background: segment-hover.has-hover ? Theme.surface-hover
                        : column-index == root.selected-stack ? Theme.surface-raised
                        : column-index == root.move-target ? Theme.surface
                        : transparent;
                    border-width: segment.has-focus || column-index == root.move-target
                        ? Theme.focus-ring-width : 0;
                    border-color: Semantic.focus-ring;
                    HorizontalLayout {
                        padding-left: Theme.space-2;
                        padding-right: Theme.space-2;
                        RoleText {
                            role: column-index == root.selected-stack
                                ? Typography.body-emphasized
                                : Typography.body;
                            text-color: column-index == root.selected-stack
                                ? Theme.text-primary
                                : Theme.text-secondary;
                            text: column.title;
                            vertical-alignment: center;
                        }
                    }
                }
                // The hover cue's owner (usability D2).
                segment-hover := TouchArea {
                    clicked => root.switcher-activated(column-index);
                }
            }
        }

        // The stack-create flow's field (usability D7), compact leg.
        if (root.stack-create-open): TextField {
            placeholder: "New stack name";
            label: "New stack name";
            accepted(text) => root.stack-create-committed(text);
            edited(text) => root.stack-create-edited(text);
        }

        // The compact New-stack affordance (round-1 D22): a trailing
        // small button after the switcher segments — reachable,
        // click-equivalent.
        IconButton {
            icon: IconKind.plus;
            label: "New stack";
            clicked => root.new-stack-activated();
        }

        // The selected stack's single column, tertiary decorations
        // collapsed via `compact: true` (D8).
        for column[column-index] in [root.selected-column()]: VerticalLayout {
            spacing: Theme.space-1;
            // The D16 address: same list role as a regular column.
            accessible-role: AccessibleRole.list;
            accessible-label: column.title;
            VerticalLayout {
                alignment: start;
                spacing: Theme.space-1;
                for task[task-index] in column.tasks: TaskCard {
                    model: task;
                    compact: true;
                    hint-keys: root.task-card-hint;
                    activated => root.task-activated(root.selected-stack, task-index);
                    clicked => root.task-clicked(root.selected-stack, task-index);
                    context-requested(x, y) => root.task-context(root.selected-stack, task-index, x, y);
                }

                if (column.create-open): TextField {
                    placeholder: "New task title";
                    label: "New task title";
                    accepted(text) => root.create-committed(root.selected-stack, text);
                    edited(text) => root.create-edited(root.selected-stack, text);
                }
            }
        }
    }
}
