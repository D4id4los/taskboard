// SPDX-License-Identifier: AGPL-3.0-only
// The pressable-row primitive (#1350): the row-activation family's
// one copy — the FocusScope+TouchArea pairing, the base-widget
// Return/Space grammar with the Ctrl/Alt modifier guards (the
// deliberate recorded input delta: Ctrl+Return no longer activates at
// the migrated sites), the focus ring, the hover tint, the tooltip
// arm and the a11y button triple. Pointer parity rides the
// GhostOpener's F8 dodge: the TouchArea is declared AFTER the scope,
// so it hit-tests first and the first physical click invokes.
//
// Per-mount deltas are knobs, not re-inventions: the armed cursor
// tint (the K4 walk grammar) rides `tint` on the wrapper's
// background; the tooltip arms on non-empty `tooltip-text` with the
// a11y label as its title; sites that render no hover tint pass
// `hover-tint: false` and read `hovered` for their own cue.
// `ListRow` stays render-only per Rule E; `MenuRow` covers the
// action-menu rows.

import { Theme, Semantic } from "../theme.slint";
import { TooltipState } from "tooltip.slint";

export component PressableRow inherits Rectangle {
    // The a11y label AND the tooltip's title (one source).
    in property <string> label;
    in property <string> description: "";
    // The armed cursor tint (the walk cursor's armed styling is the
    // wrapper's background); empty keeps the hover tint grammar.
    in property <color> tint: transparent;
    // The at-rest background (the add-entry band's surface-raised
    // rest state); hover still lifts to the surface-hover tint.
    in property <color> rest-background: transparent;
    in property <bool> hover-tint: true;
    // The hover tooltip's description sentence; empty arms nothing.
    in property <string> tooltip-text: "";
    // The tooltip's title; empty uses the a11y label (the entry rows'
    // richer `date start – end` title is the exception).
    in property <string> tooltip-title: "";
    in property <bool> pointer-cursor: true;
    // The focus read (the walk-facts pushes observe this at mounts).
    out property <bool> focused: scope.has-focus;
    out property <bool> hovered: touch.has-hover;
    callback activated();

    // The walk inventory's grab seam (#1259): a mask-clamped host's
    // stop consumer focuses the row's scope through this named
    // function — the mask `focus-index` landing addresses the stop
    // itself, never the host's root. Named for the stop role; only
    // the walk's clamped landings call it.
    public function grab-walk-stop() {
        scope.focus();
    }

    border-radius: Theme.radius-small;
    background: root.hover-tint && touch.has-hover ? Theme.surface-hover
        : root.rest-background != transparent ? root.rest-background
        : root.tint != transparent ? root.tint
        : transparent;
    border-width: scope.has-focus ? Theme.focus-ring-width : 0;
    border-color: Semantic.focus-ring;

    scope := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-tab-navigation: true;
        accessible-role: AccessibleRole.button;
        accessible-label: root.label;
        accessible-description: root.description;
        accessible-action-default => { root.activated(); }
        // The raw-key half with the modifier guards: bare Return/Space
        // activate; Ctrl/Alt-chorded keys pass through (the deliberate
        // recorded input delta at the formerly unguarded sites).
        key-pressed(event) => {
            if ((event.text == Key.Return || event.text == " ")
                && !event.modifiers.control
                && !event.modifiers.alt) {
                root.activated();
                accept
            } else {
                reject
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: root.pointer-cursor
            ? MouseCursor.pointer
            : MouseCursor.default;
        clicked => {
            TooltipState.unhover();
            root.activated();
        }
        changed has-hover => {
            if (root.tooltip-text != "") {
                if (self.has-hover) {
                    TooltipState.hover(
                        root.tooltip-title == "" ? root.label : root.tooltip-title,
                        root.tooltip-text,
                        [],
                        self.absolute-position.x,
                        self.absolute-position.y,
                        self.width,
                        self.height,
                    );
                } else {
                    TooltipState.unhover();
                }
            }
        }
    }
    content := Rectangle {
        width: 100%;
        height: 100%;
        @children
    }
}
