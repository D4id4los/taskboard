// SPDX-License-Identifier: AGPL-3.0-only
// The menu-panel shell (round-9 W6, O-6 / #954): the chrome of the
// menu family's window-level panels — raised surface, focus-ring
// border, drop shadow, clip, and the row-count height cap
// (min(row-count·space-6, space-6·6)). The flyouts mount it (D-4);
// the action menu is deliberately NOT a shell consumer — its
// fill-to-floor height law and its own radius stay at the
// composition (D-3's split: the shell owns chrome, the composition
// owns its placement/height contracts).
//
// NO keyboard ladder, NO dismissal, NO facts mirroring live here:
// those stay at their contract owners (the dropdown field's scope,
// the quick-list's panel FocusScope, the mounts' observation seams
// — D-1's letter).

import { Theme, Semantic } from "../theme.slint";

export component MenuShell inherits Rectangle {
    // The pushed row count — the height cap's only input.
    in property <int> row-count: 0;
    // The cap (the flyouts pass true — their six-row scroll cap). No
    // false consumer exists today (the action menu is not a shell
    // mount, D-3); the knob names the contract boundary the plan's
    // D-1 recorded.
    in property <bool> cap-rows: true;
    // The flyouts' radius-small vs the recorded sketch's
    // radius-medium: the corner radius rides the consumer (D-12's
    // byte-identity bar — both flyouts ship radius-small today).
    in property <length> corner-radius: Theme.radius-medium;

    height: root.cap-rows
        ? min(root.row-count * Theme.space-6, Theme.space-6 * 6)
        : self.preferred-height;
    background: Theme.surface-raised;
    border-width: Theme.focus-ring-width;
    border-color: Semantic.focus-ring;
    border-radius: root.corner-radius;
    drop-shadow-blur: Theme.space-2;
    drop-shadow-color: Theme.surface-hover;
    clip: true;

    @children
}
