// SPDX-License-Identifier: AGPL-3.0-only
// The badge primitive (L1, §4.4): a small tinted count/label chip.
// Styles flow from tokens only (Rule A); the Tone→Semantic mapping
// lives here as conditionals (D18).

import { Theme, Typography, Semantic, RoleText, Tone } from "../theme.slint";

export component Badge inherits Rectangle {
    in property <string> text;
    in property <Tone> tone: Tone.neutral;
    // The labelled-state override (UX-R8 D-7, US-5): the move-aim
    // state's accessible label — empty = the default count label
    // (the text). The Badge stays a dumb primitive: the derivation
    // lives in the models pass.
    in property <string> accessible-label-override: "";

    border-radius: Theme.radius-small;
    // The neutral chip rides the ladder's content step (r2 D35): on
    // the `surface` column card and toolbar it must read as a chip,
    // not dissolve into the parent. Translucent semantic tones below
    // are unaffected.
    // The chip fill: the neutral/info chip rides the surface-raised
    // chip step (r2 D35 — on the `surface` column card and toolbar it
    // must read as a chip, not dissolve); the semantic tones use the
    // ladder's translucent `tone-fill` derivation (F-3, #952).
    background: root.tone == Tone.neutral || root.tone == Tone.info
        ? Theme.surface-raised
        : Semantic.tone-fill(root.tone);

    accessible-role: AccessibleRole.text;
    accessible-label: root.accessible-label-override == ""
        ? root.text : root.accessible-label-override;

    HorizontalLayout {
        padding-left: Theme.space-1;
        padding-right: Theme.space-1;
        RoleText {
            role: Typography.badge;
            // Chip-ink rule (#1458, chunk plan 2026-11-28 D3): text over
            // the tone's own 0.2-alpha `tone-fill` must hold ≥ 4.5:1 in
            // both palettes — `text-primary` is the one ink that clears
            // it over every fill; the tone stays legible through the
            // fill, never through the text colour.
            text-color: Theme.text-primary;
            text: root.text;
            vertical-alignment: center;
        }
    }
}
