// SPDX-License-Identifier: AGPL-3.0-only
// The segmented-control primitive (L1, r2 D26): one grouped container
// of N equal segments, exactly one selected — the keymap picker's
// replacement (the inverted-`enabled` hack dies with it). The
// selection is a single int index owned by the caller: the widget
// renders `selected-index` and emits `picked`; the caller decides
// what the index means (this is what makes the reply-sourced echo
// possible at all — r2 D27). No internal selection state, no
// none/empty state — the settings mount seeds a valid index.
//
// Index-order contract (r2 D26): `[Standard, Emacs, Vi]` — the same
// order the adapter's request seam maps back to presets. Documented
// at the use site; segment labels are markup-owned strings.
//
// Keyboard operability (round-5 F19): every segment is a tab stop
// with the always-rendered focus ring and the IconButton raw-key
// half — bare Return/Space pick the focused segment. Pointer, raw
// keys, and the AT default action all funnel into `picked`.

import { Theme, Semantic, Typography, RoleText } from "../theme.slint";

export component SegmentedControl inherits Rectangle {
    in property <[string]> options;
    in property <int> selected-index: 0;
    // Per-segment enablement (r2 D32): defaults to all-true, so every
    // existing consumer is untouched. A disabled segment renders its
    // label dimmed and swallows the pick — the SettingsButton
    // `enabled` gate precedent.
    in property <[bool]> segment-enabled;
    // The a11y name of the group (the RadioGroup's label).
    in property <string> group-label;
    callback picked(int);

    // A segment is enabled unless the list names it disabled; an
    // empty list (the default) enables everything.
    function enabled-at(index: int) -> bool {
        root.segment-enabled.length <= index || root.segment-enabled[index]
    }

    // The grouped look (r2 D26): one bordered container.
    border-radius: Theme.radius-small;
    border-width: Theme.focus-ring-width;
    border-color: Theme.border;
    background: Theme.surface;
    accessible-role: AccessibleRole.radio-group;
    accessible-label: root.group-label;

    min-height: options-layout.preferred-height;

    options-layout := HorizontalLayout {
        for option[index] in root.options: Rectangle {
            horizontal-stretch: 1;
            // Selected → raised + primary; unselected hover → the
            // established hover language (action-menu rows).
            background: root.selected-index == index ? Theme.surface-raised
                : (root.enabled-at(index) && seg-touch.has-hover) ? Theme.surface-hover
                : transparent;
            border-radius: Theme.radius-small;
            border-width: seg-focus.has-focus ? Theme.focus-ring-width : 0;
            border-color: Semantic.focus-ring;
            min-height: seg-label.preferred-height + 2 * Theme.space-2;

            HorizontalLayout {
                padding: Theme.space-2;
                seg-label := RoleText {
                    role: Typography.body;
                    text: option;
                    text-color: root.selected-index == index ? Theme.text-primary
                        : root.enabled-at(index) ? Theme.text-secondary : Theme.border;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // The a11y half (the icon-button overlay pattern): a real
            // tab stop carrying the RadioButton role; AT activation
            // lands on the same `picked` the click hits.
            seg-focus := FocusScope {
                width: 100%;
                height: 100%;
                focus-on-tab-navigation: true;
                accessible-role: AccessibleRole.radio-button;
                accessible-label: option;
                accessible-checked: root.selected-index == index;
                accessible-enabled: root.enabled-at(index);
                accessible-action-default => {
                    if (root.enabled-at(index)) {
                        root.picked(index);
                    }
                }
                // A disabled segment still absorbs the stroke (r2 D32:
                // the pick is swallowed, not passed on).
                key-pressed(event) => {
                    if ((event.text == Key.Return || event.text == " ")
                            && !event.modifiers.control && !event.modifiers.alt
                            && !event.modifiers.shift && !event.modifiers.meta) {
                        if (root.enabled-at(index)) {
                            root.picked(index);
                        }
                        accept
                    } else {
                        reject
                    }
                }
            }
            // A click picks without taking focus: the timers form's
            // click-a-rung-then-Return-to-submit flow keeps Return in
            // the field (the TextField "click never moves focus"
            // precedent).
            seg-touch := TouchArea {
                clicked => {
                    if (root.enabled-at(index)) {
                        root.picked(index);
                    }
                }
            }
        }
    }
}
