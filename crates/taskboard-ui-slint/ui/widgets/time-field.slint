// SPDX-License-Identifier: AGPL-3.0-only
// The time combobox (r4 D26, §2 decision 3): the typable HH:MM field
// with embedded ± steppers and a quick-list flyout of quarter-hour
// slots. Surface-neutral by contract — no due-specific bits; the
// timer setter (chunk 9) and the tracking editor (chunk 10) mount the
// same widget. The widget dispatches every intent through callbacks
// (no inline side effects): the lenient parse, the wrap math, the
// slot/filter generation, the nearest-slot seek, and the None-vs-
// seeded decision all live in the adapter/pure layer — the widget
// renders what it is pushed and reports what the user did.
//
// The quick list is NOT tab-reached: it is an open-state list
// navigated by its own Up/Down (§5.4) — opening it hands focus to its
// FocusScope; Escape and Tab close it (widget-internal Escape, the
// action layer never sees it). An outside click onto another tab stop
// moves focus and closes the flyout with it (the FocusScope's
// focus-loss seam); a TouchArea click never moves focus (the recorded
// Slint negative), so a click on another panel TouchArea is absorbed
// by that surface's own grammar instead.

// The flyout renders window-level (round-5 D6): the widget mirrors
// its open state and the anchor's realized window-space geometry into
// `TimeFieldFacts`; the app window mounts the `QuickListFlyout` panel
// and the dismissal underlay from those facts. This replaces the old
// in-widget displaced underlay (the F9 coordinate-space defect).
import { Theme, Typography, RoleText, Semantic } from "../theme.slint";
import { TextField, FieldValidity } from "text-field.slint";
import { IconButton, IconKind } from "icon-button.slint";

// The time-field class's mount-truth facts (round-5 D6): one global
// for the widget class, `site` discriminating the mounted instances
// (0 = due picker, 1 = timer setter, 2 = track-form start, 3 =
// track-form end — the track form mounts two simultaneously). The
// widget mirrors its own `open` and the anchor's realized geometry;
// the ladder's highlight/seek stay panel-local (the ladder moved into
// `QuickListFlyout`); the highlight is mirrored out read-only.
export global TimeFieldFacts {
    in-out property <bool> open: false;
    in-out property <int> site: -1;
    in-out property <length> anchor-x;
    in-out property <length> anchor-y;
    in-out property <length> anchor-width;
    in-out property <length> anchor-height;
    // The realized panel geometry (the `MenuPanelFacts.flyout-*`
    // precedent) — the flip/clamp journeys' observation seam.
    in-out property <length> panel-x;
    in-out property <length> panel-y;
    // The open flyout's highlighted row, mirrored by the panel (the
    // `DropdownFacts.highlight` observation seam; never read back).
    in-out property <int> highlight: 0;
}

// One quick-list row: the slot's canonical rendering plus its
// minutes-of-day (the seam carries numbers, not dates — D2's rule at
// widget scale).
export struct TimeSlotRow {
    label: string,
    minutes: int,
}

export component TimeField inherits Rectangle {
    // The pushed value mirror: the adapter's canonical rendering —
    // `--:--` while no time exists (r4 D23's display rule), the
    // stepped/picked value otherwise. The field's own text buffer is
    // widget-local; the push re-seeds it when the picker state moved
    // (a stepper, a quick pick, a phase-entry sync) and never while
    // the user types (r4 R-c's probe shape).
    in property <string> time-text: "--:--";
    in property <FieldValidity> validity: FieldValidity.neutral;
    // The error line (r4 D27): a conditional caption below the row
    // rendering the caller's copy constant — invalid text only.
    in property <string> error-hint;
    in property <string> label: "Time";
    in property <string> placeholder: "HH:MM";
    in property <string> description;
    // The filtered quick-list rows, pushed by the adapter on open and
    // per keystroke (the filter's pure predicate lives beside the
    // parser); `nearest-row` is the open-time scroll-to-nearest index
    // into that list (00:00 when unset — the adapter's decision).
    in property <[TimeSlotRow]> slot-rows;
    in property <int> nearest-row: 0;
    // The mount-site discriminator (round-5 D6): which instance's
    // state the class facts global carries.
    in property <int> flyout-site: -1;
    in-out property <bool> open: false;

    // The window-mirror loop (round-5 D6): widget → window (open) via
    // the derived-property wrap, window → widget (close) via the
    // site-guarded fact read. Both directions are site-guarded; the
    // loop converges (a close write re-enters as an already-false
    // no-op, and a closed sibling's guard never fires).
    property <bool> open-mirrored: root.open;
    changed open-mirrored => {
        TimeFieldFacts.site = root.flyout-site;
        TimeFieldFacts.open = self.open-mirrored;
        // The anchor geometry rides the open flip too: at click time
        // the absolute position is realized, and the testing backend
        // does not deliver `changed` for the pre-attach layout pass
        // (the unreliable-mirroring record). The `anchor-abs-*` hooks
        // below keep the mirror live across host scrolls.
        TimeFieldFacts.anchor-x = flyout-anchor.absolute-position.x;
        TimeFieldFacts.anchor-y = flyout-anchor.absolute-position.y;
        TimeFieldFacts.anchor-width = flyout-anchor.width;
        TimeFieldFacts.anchor-height = flyout-anchor.height;
    }
    property <bool> fact-open: TimeFieldFacts.open && TimeFieldFacts.site == root.flyout-site;
    changed fact-open => {
        if (!self.fact-open && root.open) {
            root.open = false;
        }
    }
    // The anchor geometry, mirrored one-way: window-space by
    // definition (the F9 fix — a host scroll keeps the mirror live
    // because `absolute-position` tracks it).
    property <length> anchor-abs-x: flyout-anchor.absolute-position.x;
    property <length> anchor-abs-y: flyout-anchor.absolute-position.y;
    changed anchor-abs-x => {
        TimeFieldFacts.anchor-x = self.anchor-abs-x;
        TimeFieldFacts.anchor-width = flyout-anchor.width;
        TimeFieldFacts.anchor-height = flyout-anchor.height;
    }
    changed anchor-abs-y => {
        TimeFieldFacts.anchor-y = self.anchor-abs-y;
        TimeFieldFacts.anchor-width = flyout-anchor.width;
        TimeFieldFacts.anchor-height = flyout-anchor.height;
    }

    // The intents (§5.1: no inline side effects).
    callback edited(string);
    callback accepted(string);
    // The steppers: `n` is −1 or +1; the adapter applies the
    // seed-on-step semantics (r4 D23) — the widget never holds the
    // None/seed decision (§5.3).
    callback stepped(int);
    // A quick-list pick: minutes-of-day.
    callback picked(int);
    // The chevron's notification half (round-5 F8): the toggle stays
    // widget-local (D-3.3); the callback lets the consumer's seam set
    // the steal latch and disarm the digit filter for this open.
    callback quick-toggled();

    height: field.natural-height;
    border-radius: Theme.radius-small;

    if (root.validity == FieldValidity.invalid && field.text != "" && field.text != "--:--"): RoleText {
        role: Typography.caption;
        text-color: Semantic.danger;
        y: field.natural-height;
        text: root.error-hint;
    }

    // The push re-seed: the adapter's mirror wins whenever it differs
    // from the field's buffer. While the user types, the adapter
    // echoes the typed text back verbatim (single writer, r4 R-c's
    // probe shape), so the push is a no-op; a picker-source move (a
    // stepper, a quick pick, a phase-entry sync) rewrites it.
    changed time-text => {
        if (field.text != root.time-text) {
            field.text = root.time-text;
        }
    }

    // The row: typable field, − / + steppers, the dropdown toggle —
    // each a tab stop, each carrying a hover tip (blanket rule).
    HorizontalLayout {
        spacing: Theme.space-1;
        field := TextField {
            placeholder: root.placeholder;
            label: root.label;
            description: root.description;
            validity: root.validity;
            autofocus: false;
            horizontal-stretch: 1;
            edited(text) => { root.edited(text); }
            accepted(text) => { root.accepted(text); }
        }
        IconButton {
            icon: IconKind.minus;
            label: "Step time back";
            description: "Steps the time 15 minutes back, wrapping over midnight.";
            clicked => { root.stepped(-1); }
        }
        IconButton {
            icon: IconKind.plus;
            label: "Step time forward";
            description: "Steps the time 15 minutes forward, wrapping over midnight.";
            clicked => { root.stepped(1); }
        }
        IconButton {
            icon: IconKind.chevron-down;
            label: "Quick times";
            description: "Opens the quarter-hour quick list.";
            clicked => {
                root.open = !root.open;
                if (root.open) {
                    root.quick-toggled();
                }
            }
        }
    }

    // Named after the declaration order; the window-level flyout
    // (round-5 D6) anchors on this rect's realized geometry.
    property <length> row-height: field.natural-height;
    flyout-anchor := Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.row-height;
    }
}
