// SPDX-License-Identifier: AGPL-3.0-only
// The icon-button primitive (L1, §4.4): a small square button
// carrying a geometric icon (D19 — no icon font; shapes composed from
// primitives, coloured Tone→Semantic). A FocusScope overlay makes it
// a real tab stop (D15); its keyboard "activation" is the routed
// action's own binding (§7.1's equivalence — the action layer owns
// keys).

import { Theme, Semantic, Tone } from "../theme.slint";
import { TooltipState } from "tooltip.slint";

// The closed icon vocabulary (D19): grows only with a theme decision
// — `plus` joined for the usability pass's New-stack buttons.
export enum IconKind {
    menu,
    snooze,
    mute,
    warn,
    plus,
    // The back affordance (round-1 D12): a left chevron.
    chevron-left,
    // The remove affordance (chunk 6, D12): an x.
    remove,
    // The month-next affordance (r2 D25): a right chevron.
    chevron-right,
    // The picker-toggle affordance (r2 D25): a calendar.
    calendar,
}

export component IconButton inherits Rectangle {
    in property <IconKind> icon: IconKind.menu;
    in property <Tone> tone: Tone.neutral;
    // The a11y label — the registry label of the routed action (D16).
    in property <string> label;
    // The generalized tooltip trigger's parts (round-1 D8): empty
    // defaults keep every existing call site unchanged.
    in property <string> description;
    in property <[string]> hint-keys;
    callback clicked();

    background: touch.pressed || touch.has-hover ? Theme.surface-hover
        : transparent;
    border-radius: Theme.radius-small;
    border-width: focus-surface.has-focus ? Theme.focus-ring-width : 0;
    border-color: Semantic.focus-ring;
    // The canonical square (usability D4): min AND max — without the
    // cap the button is growable in a HorizontalLayout and absorbs the
    // title's leftover space (the stretching hamburger bug).
    min-width: Theme.space-6;
    max-width: Theme.space-6;
    min-height: Theme.space-6;

    // The focus half: a FocusScope overlay makes the button a real
    // tab stop (D15) with the always-rendered ring (§7.1).
    focus-surface := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-tab-navigation: true;
        accessible-role: AccessibleRole.button;
        accessible-label: root.label;
        // The AT/keyboard activation lands on the same callback the
        // TouchArea's click hits (§7.1's equivalence, D15).
        accessible-action-default => { root.clicked(); }
    }

    icon-box := VerticalLayout {
        padding: Theme.space-2;

        pure function icon-color() -> color {
            // The neutral icon lifts to text-primary while hovered —
            // the background alone carries the cue for the semantic
            // tones (usability D2).
            root.tone == Tone.neutral
                ? (touch.has-hover ? Theme.text-primary : Theme.text-secondary)
            : root.tone == Tone.info ? Theme.text-primary
            : root.tone == Tone.success ? Semantic.success
            : root.tone == Tone.warning ? Semantic.warning
            : root.tone == Tone.danger ? Semantic.danger
            : root.tone == Tone.overdue ? Semantic.overdue
            : root.tone == Tone.sync-active ? Semantic.sync-active
            : Semantic.offline
        }

        if (root.icon == IconKind.menu): VerticalLayout {
            spacing: Theme.space-1 / 2;
            Rectangle { vertical-stretch: 1; min-height: Theme.space-1 / 2; background: icon-box.icon-color(); }
            Rectangle { vertical-stretch: 1; min-height: Theme.space-1 / 2; background: icon-box.icon-color(); }
            Rectangle { vertical-stretch: 1; min-height: Theme.space-1 / 2; background: icon-box.icon-color(); }
        }

        if (root.icon == IconKind.snooze): VerticalLayout {
            // A clock: ring + hands, centered.
            clock-ring := Rectangle {
                vertical-stretch: 1;
                min-height: Theme.space-4;
                border-radius: self.height / 2;
                border-width: Theme.focus-ring-width;
                border-color: icon-box.icon-color();
                Rectangle {
                    x: clock-ring.width / 2 - Theme.space-1 / 2;
                    y: Theme.space-1;
                    width: Theme.space-1 / 2;
                    height: Theme.space-2;
                    background: icon-box.icon-color();
                }
                Rectangle {
                    x: clock-ring.width / 2 - Theme.space-1 / 2;
                    y: clock-ring.height / 2 - Theme.space-1 / 2;
                    width: Theme.space-2;
                    height: Theme.space-1 / 2;
                    background: icon-box.icon-color();
                }
            }
        }

        if (root.icon == IconKind.mute): VerticalLayout {
            // A bell silhouette: dome + base.
            spacing: Theme.space-1 / 2;
            Rectangle {
                vertical-stretch: 7;
                min-height: Theme.space-1;
                border-radius: self.height / 2;
                background: icon-box.icon-color();
            }
            Rectangle {
                vertical-stretch: 1;
                min-height: Theme.space-1 / 2;
                background: icon-box.icon-color();
            }
        }

        if (root.icon == IconKind.warn): VerticalLayout {
            // The warning glyph: an exclamation mark.
            spacing: Theme.space-1 / 2;
            Rectangle { vertical-stretch: 4; min-height: Theme.space-2; background: icon-box.icon-color(); }
            Rectangle { vertical-stretch: 1; min-height: Theme.space-1 / 2; background: icon-box.icon-color(); }
        }

        if (root.icon == IconKind.chevron-left): VerticalLayout {
            // A left chevron: one polyline stroke (geometric, D19).
            Rectangle {
                vertical-stretch: 1;
                min-height: Theme.space-4;
                Path {
                    // space-3: the 12-px design grid square the
                    // chevron polyline is drawn in.
                    width: Theme.space-3;
                    height: Theme.space-3;
                    commands: "M 8 1 L 2 6 L 8 11";
                    stroke: icon-box.icon-color();
                    stroke-width: Theme.focus-ring-width;
                    fill: transparent;
                    viewbox-width: 12;
                    viewbox-height: 12;
                }
            }
        }

        if (root.icon == IconKind.remove): VerticalLayout {
            // An x: two crossing diagonal strokes (geometric, D19).
            Rectangle {
                vertical-stretch: 1;
                min-height: Theme.space-4;
                Path {
                    width: Theme.space-3;
                    height: Theme.space-3;
                    commands: "M 2 2 L 10 10 M 10 2 L 2 10";
                    stroke: icon-box.icon-color();
                    stroke-width: Theme.focus-ring-width;
                    fill: transparent;
                    viewbox-width: 12;
                    viewbox-height: 12;
                }
            }
        }

        if (root.icon == IconKind.chevron-right): VerticalLayout {
            // The month-next chevron: the left chevron mirrored
            // (geometric, D19).
            Rectangle {
                vertical-stretch: 1;
                min-height: Theme.space-4;
                Path {
                    width: Theme.space-3;
                    height: Theme.space-3;
                    commands: "M 4 1 L 10 6 L 4 11";
                    stroke: icon-box.icon-color();
                    stroke-width: Theme.focus-ring-width;
                    fill: transparent;
                    viewbox-width: 12;
                    viewbox-height: 12;
                }
            }
        }

        if (root.icon == IconKind.calendar): VerticalLayout {
            // A calendar: closed page box, two binding tabs, a header
            // rule (geometric, D19).
            Rectangle {
                vertical-stretch: 1;
                min-height: Theme.space-4;
                Path {
                    width: Theme.space-3;
                    height: Theme.space-3;
                    commands: "M 1 3 L 11 3 L 11 11 L 1 11 Z M 3 1 L 3 4 M 9 1 L 9 4 M 1 6 L 11 6";
                    stroke: icon-box.icon-color();
                    stroke-width: Theme.focus-ring-width;
                    fill: transparent;
                    viewbox-width: 12;
                    viewbox-height: 12;
                }
            }
        }

        if (root.icon == IconKind.plus): Rectangle {
            // A plus: one horizontal and one vertical bar crossing
            // centred (geometric, D19 — no icon font).
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 100%;
                height: Theme.focus-ring-width;
                background: icon-box.icon-color();
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                height: 100%;
                width: Theme.focus-ring-width;
                background: icon-box.icon-color();
            }
        }
    }

    touch := TouchArea {
        // The tooltip trigger (usability D3): enter arms the delay,
        // leave and click dismiss — the label is the same property
        // the a11y layer reads, so the tooltip never says anything
        // the accessible tree doesn't.
        changed has-hover => {
            if (self.has-hover) {
                TooltipState.hover(root.label, root.description, root.hint-keys, self.absolute-position.x, self.absolute-position.y, self.width, self.height);
            } else {
                TooltipState.unhover();
            }
        }
        clicked => {
            TooltipState.unhover();
            focus-surface.focus();
            root.clicked();
        }
    }
}
