// SPDX-License-Identifier: AGPL-3.0-only
// The icon-button primitive (L1, §4.4): a small square button
// carrying an icon (D19 as amended by round-4 §2 decision 1,
// 2026-11-01: vendored monochrome Lucide SVGs tinted via
// `Image.colorize`; the no-icon-font clause stands; the `IconKind`
// vocabulary gate remains the single closed set). A FocusScope
// overlay makes it a real tab stop (D15); its keyboard "activation"
// is the routed action's own binding (§7.1's equivalence — the
// action layer owns keys).

import { Theme, Semantic, Tone } from "../theme.slint";
import { TooltipState } from "tooltip.slint";
import { Icon, IconKind } from "icon.slint";

// The vocabulary's home moved with the renderer (r4 D10); this
// re-export keeps every call-site import unchanged.
export { IconKind }

export component IconButton inherits Rectangle {
    in property <IconKind> icon: IconKind.menu;
    in property <Tone> tone: Tone.neutral;
    // The a11y label — the registry label of the routed action (D16).
    in property <string> label;
    // The generalized tooltip trigger's parts (round-1 D8): empty
    // defaults keep every existing call site unchanged.
    in property <string> description;
    in property <[string]> hint-keys;
    callback clicked();

    background: touch.pressed || touch.has-hover ? Theme.surface-hover
        : transparent;
    border-radius: Theme.radius-small;
    border-width: focus-surface.has-focus ? Theme.focus-ring-width : 0;
    border-color: Semantic.focus-ring;
    // The canonical square (usability D4): min AND max — without the
    // cap the button is growable in a HorizontalLayout and absorbs the
    // title's leftover space (the stretching hamburger bug).
    min-width: Theme.space-6;
    max-width: Theme.space-6;
    min-height: Theme.space-6;

    // The focus half: a FocusScope overlay makes the button a real
    // tab stop (D15) with the always-rendered ring (§7.1).
    focus-surface := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-tab-navigation: true;
        accessible-role: AccessibleRole.button;
        accessible-label: root.label;
        // The AT/keyboard activation lands on the same callback the
        // TouchArea's click hits (§7.1's equivalence, D15).
        accessible-action-default => { root.clicked(); }
        // The raw-key half (round-3 D12/F28): Return/Enter/Space
        // activate — every IconButton is fully keyboard-operable,
        // widget-level (the routed action's binding stays the
        // semantic path; this is the direct-key half).
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                accept
            } else {
                reject
            }
        }
    }

    icon-box := VerticalLayout {
        padding: Theme.space-2;

        pure function icon-color() -> color {
            // The neutral icon lifts to text-primary while hovered —
            // the background alone carries the cue for the semantic
            // tones (usability D2).
            root.tone == Tone.neutral
                ? (touch.has-hover ? Theme.text-primary : Theme.text-secondary)
            : root.tone == Tone.info ? Theme.text-primary
            : root.tone == Tone.success ? Semantic.success
            : root.tone == Tone.warning ? Semantic.warning
            : root.tone == Tone.danger ? Semantic.danger
            : root.tone == Tone.overdue ? Semantic.overdue
            : root.tone == Tone.sync-active ? Semantic.sync-active
            : Semantic.offline
        }

        Icon {
            kind: root.icon;
            colorize: icon-color();
        }
    }

    touch := TouchArea {
        // The tooltip trigger (usability D3): enter arms the delay,
        // leave and click dismiss — the label is the same property
        // the a11y layer reads, so the tooltip never says anything
        // the accessible tree doesn't.
        changed has-hover => {
            if (self.has-hover) {
                TooltipState.hover(root.label, root.description, root.hint-keys, self.absolute-position.x, self.absolute-position.y, self.width, self.height);
            } else {
                TooltipState.unhover();
            }
        }
        clicked => {
            TooltipState.unhover();
            focus-surface.focus();
            root.clicked();
        }
    }
}
