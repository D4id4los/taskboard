// SPDX-License-Identifier: AGPL-3.0-only
// The task-card primitive (L1, §4.4): one task as a card. Rule B:
// domain-meaningful display model in; Rule D: the decoration slots
// are properties from day one (v0.1.0 passes `[]` everywhere — the
// fence against component forks). Cards are NOT slint tab stops —
// their keyboard navigation is the action layer's (D15); the
// selection ring uses the focus tokens while never holding focus.

import { Theme, Typography, Semantic, RoleText, Tone, DueKind } from "../theme.slint";
import { TooltipState } from "tooltip.slint";
import { Icon, IconKind } from "icon.slint";

// The rule-D decoration vocabulary (D21): future surfaces (W1
// importance/urgency, habits, reminders) ride this slot.
export enum DecorationKind {
    importance,
    urgency,
    habit,
    reminder,
    // The running-timer badge (DR-5/4, D-TU3): the card whose task
    // holds the open entry — static label, the chip owns the elapsed.
    tracking,
    // The recurring-series badge (DR-6/4, D-S7): the open head's next
    // occurrence, derived per frame from the published state.
    recur,
    // The tracker badge (issue #492): the never-done kind's
    // kiosk-visible name — the model carries the decision.
    tracker,
}

// The card play/pause control's shown-half input (UX-R8 chunk-5 D-6,
// US-4): the model carries the tracking fact; the button renders play
// when `none`, stop when `running-here`, and hides entirely on a
// tracker card (the can-done hide posture).
export enum TrackCardState {
    none,
    running-here,
}

export struct TaskDecoration {
    kind: DecorationKind,
    label: string,
    tone: Tone,
}

// The display model (D22, rule B): titles, due phrase, due class,
// flags — no colours, no strings-as-bags.
export struct TaskCardModel {
    title: string,
    due-phrase: string,
    // The scheduled-start and effort phrases (empty = absent, the
    // due-phrase pattern); the semantic words live presentation-side.
    scheduled-phrase: string,
    effort-phrase: string,
    due-kind: DueKind,
    done: bool,
    // The done affordance's visibility flag (issue #492): a tracker
    // card hides it entirely — hide, don't grey; default `true`, so
    // every non-tracker path is unchanged.
    can-done: bool,
    emphasis: bool,
    // The pointer drag's source dim (r2 chunk-8 D-D): set by the
    // models pass on the card being dragged; the ghost copy carries
    // `false`. Model-driven, so it survives refreshes.
    dragging-source: bool,
    // The board selection's render fact (UX-R8 D-4): the card is a
    // selection member, and whether it is the range anchor (the ring
    // uses the focus tokens without holding focus — the header note).
    // Derivation lives in the models pass; no slint-side logic.
    selected: bool,
    anchor: bool,
    // The tracking control's shown half (UX-R8 chunk-5 D-6): derived
    // in the models pass over the open entry's subject — no local
    // state anywhere.
    track-state: TrackCardState,
    decorations: [TaskDecoration],
}

export component TaskCard inherits Rectangle {
    in property <TaskCardModel> model;
    in property <bool> compact: false;
    // The title's resolved and intrinsic widths (round-6 R6-4): the
    // regression probe reads them instead of re-measuring text; the
    // automation lane shares the seam.
    out property <length> title-width: title-text.width;
    // The done checkbox's hover flag (UX-R8 chunk-5 D-8, US-6): the
    // house hover treatment's input — a model fact the probes read,
    // never styling text. N-15's hover half.
    out property <bool> done-hover: done-hit.has-hover;
    out property <length> title-preferred-width: title-text.preferred-width;
    callback activated();
    callback clicked();
    // The modifier-click grammar (UX-R8 D-5, US-4/S1): shift/ctrl
    // releases emit the modifier pair (shift, control) instead of
    // the plain click — exactly one of the two callbacks fires per
    // release (the branch in the pointer-event handler is
    // exhaustive). The keymap is untouched: Slint's PointerEvent
    // carries the modifiers.
    // slint: clicked-modifiers
    callback clicked-modifiers(bool, bool);
    // The done checkbox's toggle (r3 D6): state-less — the wiring
    // chain supplies the address; the adapter flips the model's bit.
    callback done-toggled();
    // slint: track-toggled — the card play/pause control (UX-R8 D-6,
    // US-4): state-less like done-toggled; the adapter routes the
    // existing tracking ids from the model's shown half.
    callback track-toggled();
    // The right-click context request (round-1 D13): pointer coords
    // in window coordinates (the card's absolute position + the local
    // mouse position).
    callback context-requested(float, float);
    // The task.edit binding hint (round-1 D8; a keymap projection).
    in property <[string]> hint-keys;

    // Hover stays distinct from the emphasis ring (focus ≠ hover,
    // both may coexist — usability D2). At rest the card paints the
    // content step of the ladder (r2 D35): on a `surface` column card
    // it is one step up, on the bare compact/today boards it is the
    // segmented-control's thumb step off the background.
    background: touch.has-hover ? Theme.surface-hover
        : root.model.done ? Theme.background
        : Theme.surface-raised;
    border-radius: Theme.radius-medium;
    // The selection ring (UX-R8 D-4): the focus tokens without
    // holding focus — members ring at the focus width, the anchor
    // doubles it (the anchor is the range origin, visibly distinct).
    border-width: root.model.anchor ? Theme.focus-ring-width * 2
        : root.model.selected || root.model.emphasis ? Theme.focus-ring-width : 0;
    border-color: Semantic.focus-ring;
    // The drag-source dim (r2 D-D): the literal is Tier-4-tunable, no
    // token (the plan §3.3 records why).
    opacity: root.model.dragging-source ? 0.35 : 1.0;

    accessible-role: AccessibleRole.list-item;
    // The D16 address: task title (+ due phrase).
    accessible-label: root.model.due-phrase == "" ? root.model.title
        : "\{root.model.title} (\{root.model.due-phrase})";

    touch := TouchArea {
        // The D8 card tooltip (round 1): the full title as the label,
        // the task.edit hint from the keymap projection.
        changed has-hover => {
            if (self.has-hover) {
                TooltipState.hover(root.model.title, "", root.hint-keys,
                    self.absolute-position.x, self.absolute-position.y,
                    self.width, self.height);
            } else {
                TooltipState.unhover();
            }
        }
        double-clicked => root.activated();
        // P3: pointer-event fires on right presses; the design's
        // `button == right` seam (its identity is a real-backend
        // property — the Tier-4 probe checks it). UX-R8 D-5: the
        // left-button release emits from here — the modifier pair
        // when shift/ctrl held, the plain click otherwise (exactly
        // one callback per release).
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up
                    && event.button == PointerEventButton.left) {
                if (event.modifiers.shift || event.modifiers.control) {
                    root.clicked-modifiers(event.modifiers.shift, event.modifiers.control);
                } else {
                    root.clicked();
                }
            }
            if (event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.right) {
                root.context-requested(self.absolute-position.x / 1px + self.mouse-x / 1px,
                                       self.absolute-position.y / 1px + self.mouse-y / 1px);
            }
        }
    }

    pure function due-color() -> color {
        root.model.due-kind == DueKind.overdue ? Semantic.overdue
        : root.model.due-kind == DueKind.soon ? Semantic.warning
        : root.model.due-kind == DueKind.done ? Semantic.success
        : Theme.text-secondary
    }

    HorizontalLayout {
        spacing: Theme.space-1;

        // The done checkbox (r3 D6): a state-less box that renders
        // `model.done` only — no local checked state exists anywhere,
        // so it cannot desync from the model (the refresh push is the
        // single writer). Untouched on the ghost: the runtime
        // suppresses hover/press over the drag ghost.
        done-box := Rectangle {
            visible: root.model.can-done;
            width: Theme.space-4;
            height: Theme.space-4;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-small;
            border-width: Theme.focus-ring-width;
            border-color: root.model.done ? Semantic.success : Theme.text-secondary;
            // The house hover treatment (the r1 R-1 posture — the
            // Theme's existing hover token, no new primitive).
            background: done-hit.has-hover && !root.model.done ? Theme.surface-hover : transparent;
            accessible-role: AccessibleRole.checkbox;
            // The done/undone verb pair (a presentation literal; the
            // role + label pair is what the a11y tree announces).
            accessible-label: root.model.done ? "Mark task not done" : "Mark task done";
            // The AT/keyboard activation lands on the same seam the
            // TouchArea's click hits (the FocusScope-pattern address).
            accessible-action-default => root.done-toggled();
            done-hit := TouchArea {
                clicked => root.done-toggled();
            }
            if (root.model.done): Path {
                width: Theme.space-4 - 2 * Theme.space-1;
                height: Theme.space-4 - 2 * Theme.space-1;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                commands: "M 2 6 L 5 9 L 10 3";
                stroke: Semantic.success;
                stroke-width: Theme.focus-ring-width;
                fill: transparent;
                viewbox-width: 12;
                viewbox-height: 12;
            }
        }

        // The card's play/pause tracking control (UX-R8 chunk-5 D-6,
        // US-4; pointer-grade per R-3 — no card-scoped key AND no tab
        // stop: a per-card FocusScope with focus-on-tab-navigation
        // would promote tracking onto every card's Tab space (the r4
        // D-7 prominence reasoning; the done-box's no-tab-stop
        // posture — the a11y role carries the AT/keyboard activation
        // through the addressing chains' own walk)). Beside the
        // decoration region; hidden entirely on a tracker card (the
        // can-done hide posture).
        if (root.model.can-done): track-control := Rectangle {
            width: Theme.space-6;
            height: Theme.space-6;
            track-hit := TouchArea {
                clicked => { root.track-toggled(); }
            }
            background: track-hit.has-hover ? Theme.surface-hover : transparent;
            border-radius: Theme.radius-small;
            track-focus := FocusScope {
                width: 100%;
                height: 100%;
                focus-on-tab-navigation: false;
                accessible-role: AccessibleRole.button;
                // The card-own labels (distinct from the quick bar's
                // registry-label buttons — the a11y address must be
                // unambiguous between the popup's bar and the cards'
                // controls; the wording is walkthrough-graded).
                accessible-label: root.model.track-state == TrackCardState.running-here
                    ? "Stop tracking task" : "Track task";
                // slint: track-toggled
                accessible-action-default => { root.track-toggled(); }
            }
            Icon {
                width: Theme.icon-size;
                height: Theme.icon-size;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                kind: root.model.track-state == TrackCardState.running-here
                    ? IconKind.stop : IconKind.play;
                colorize: track-hit.has-hover ? Theme.text-primary : Theme.text-secondary;
            }
        }

        VerticalLayout {
            // The text column claims the card's surplus (r4 D1):
            // without the stretch an elided title's one-glyph layout
            // minimum absorbs every squeeze and the chips starve the
            // title to a bare "…".
            horizontal-stretch: 1;
            padding-left: Theme.space-2;
            padding-right: Theme.space-2;
            padding-top: Theme.space-1;
            padding-bottom: Theme.space-1;
            spacing: Theme.space-1;

            title-text := RoleText {
                role: root.model.done ? Typography.caption : Typography.body;
                text-color: root.model.done ? Theme.text-secondary : Theme.text-primary;
                text: root.model.title;
                overflow: elide;
                // The elide floor (r4 D1): defeats the ellipsis-glyph
                // minimum squeeze — the title elides only at the
                // card's right edge.
                min-width: Theme.card-title-min-width;
            }

            // Secondary decoration: the due chip stays at every breakpoint
            // (D8 — compact collapses only tertiary decorations).
            if (root.model.due-kind != DueKind.none): HorizontalLayout {
                RoleText {
                    role: Typography.mono;
                    text-color: root.due-color();
                    text: root.model.due-phrase;
                }
            }

            // The scheduled-start and effort chips (secondary class, like
            // the due chip): mono rows at every breakpoint, each present
            // only when its field is set. Pure empty-string tests — no
            // slint-side semantics.
            if (root.model.scheduled-phrase != ""): HorizontalLayout {
                RoleText {
                    role: Typography.mono;
                    text-color: Theme.text-secondary;
                    text: root.model.scheduled-phrase;
                }
            }
            if (root.model.effort-phrase != ""): HorizontalLayout {
                RoleText {
                    role: Typography.mono;
                    text-color: Theme.text-secondary;
                    text: root.model.effort-phrase;
                }
            }

            // Tertiary decorations (rule-D slot): all v0.1.0 kinds are
            // tertiary (D21) — compact collapses them; call sites pass []
            // today. The row rides a plain Rectangle (round-6 R6-4): an
            // empty stretch-aligned layout reports max = min = 0
            // (box_layout_info's empty early return), and this row's
            // constraint merge into the text column collapsed the
            // column's max-width to it — the elided title could never
            // grow past the widest chip, at any card width. A plain
            // Rectangle carries no content-derived layout info
            // (min = preferred = 0, max = unbounded), so the merge
            // stays unbounded; the height rides the inner layout's.
            if (!root.compact): deco-row := Rectangle {
                // The explicit cap (round-6 R6-4): the single-layout
                // lowering would otherwise inherit the inner layout's
                // constraint per axis — and an EMPTY stretch-aligned
                // layout reports max = min = 0, collapsing the text
                // column's max-width to it (the elided title could
                // never grow past the widest chip at any card width).
                // The explicit max replaces the inherited one.
                max-width: Theme.layout-severing-max-width;
                height: deco-layout.preferred-height;
                deco-layout := HorizontalLayout {
                    spacing: Theme.space-1;
                    for decoration in root.model.decorations: Rectangle {
                        border-radius: Theme.radius-small;
                        background: decoration.tone == Tone.success ? Semantic.success.with-alpha(0.2)
                            : decoration.tone == Tone.warning ? Semantic.warning.with-alpha(0.2)
                            : decoration.tone == Tone.danger ? Semantic.danger.with-alpha(0.2)
                            : decoration.tone == Tone.overdue ? Semantic.overdue.with-alpha(0.2)
                            : Theme.surface-raised;
                        HorizontalLayout {
                            padding-left: Theme.space-1;
                            padding-right: Theme.space-1;
                            RoleText {
                                role: Typography.badge;
                                text-color: Theme.text-secondary;
                                text: decoration.label;
                            }
                        }
                    }
                }
            }
        }
    }
}
