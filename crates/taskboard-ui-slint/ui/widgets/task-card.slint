// SPDX-License-Identifier: AGPL-3.0-only
// The task-card primitive (L1, §4.4): one task as a card. Rule B:
// domain-meaningful display model in; Rule D: the decoration slots
// are properties from day one (v0.1.0 passes `[]` everywhere — the
// fence against component forks). Cards are NOT slint tab stops —
// their keyboard navigation is the action layer's (D15); the
// selection ring uses the focus tokens while never holding focus.

import { Theme, Typography, Semantic, RoleText, Tone, DueKind } from "../theme.slint";
import { TooltipState } from "tooltip.slint";

// The rule-D decoration vocabulary (D21): future surfaces (W1
// importance/urgency, habits, reminders) ride this slot.
export enum DecorationKind {
    importance,
    urgency,
    habit,
    reminder,
}

export struct TaskDecoration {
    kind: DecorationKind,
    label: string,
    tone: Tone,
}

// The display model (D22, rule B): titles, due phrase, due class,
// flags — no colours, no strings-as-bags.
export struct TaskCardModel {
    title: string,
    due-phrase: string,
    // The scheduled-start and effort phrases (empty = absent, the
    // due-phrase pattern); the semantic words live presentation-side.
    scheduled-phrase: string,
    effort-phrase: string,
    due-kind: DueKind,
    done: bool,
    emphasis: bool,
    // The pointer drag's source dim (r2 chunk-8 D-D): set by the
    // models pass on the card being dragged; the ghost copy carries
    // `false`. Model-driven, so it survives refreshes.
    dragging-source: bool,
    decorations: [TaskDecoration],
}

export component TaskCard inherits Rectangle {
    in property <TaskCardModel> model;
    in property <bool> compact: false;
    callback activated();
    callback clicked();
    // The done checkbox's toggle (r3 D6): state-less — the wiring
    // chain supplies the address; the adapter flips the model's bit.
    callback done-toggled();
    // The right-click context request (round-1 D13): pointer coords
    // in window coordinates (the card's absolute position + the local
    // mouse position).
    callback context-requested(float, float);
    // The task.edit binding hint (round-1 D8; a keymap projection).
    in property <[string]> hint-keys;

    // Hover stays distinct from the emphasis ring (focus ≠ hover,
    // both may coexist — usability D2). At rest the card paints the
    // content step of the ladder (r2 D35): on a `surface` column card
    // it is one step up, on the bare compact/today boards it is the
    // segmented-control's thumb step off the background.
    background: touch.has-hover ? Theme.surface-hover
        : root.model.done ? Theme.background
        : Theme.surface-raised;
    border-radius: Theme.radius-medium;
    border-width: root.model.emphasis ? Theme.focus-ring-width : 0;
    border-color: Semantic.focus-ring;
    // The drag-source dim (r2 D-D): the literal is Tier-4-tunable, no
    // token (the plan §3.3 records why).
    opacity: root.model.dragging-source ? 0.35 : 1.0;

    accessible-role: AccessibleRole.list-item;
    // The D16 address: task title (+ due phrase).
    accessible-label: root.model.due-phrase == "" ? root.model.title
        : "\{root.model.title} (\{root.model.due-phrase})";

    touch := TouchArea {
        // The D8 card tooltip (round 1): the full title as the label,
        // the task.edit hint from the keymap projection.
        changed has-hover => {
            if (self.has-hover) {
                TooltipState.hover(root.model.title, "", root.hint-keys,
                    self.absolute-position.x, self.absolute-position.y,
                    self.width, self.height);
            } else {
                TooltipState.unhover();
            }
        }
        double-clicked => root.activated();
        clicked => root.clicked();
        // P3: pointer-event fires on right presses; the design's
        // `button == right` seam (its identity is a real-backend
        // property — the Tier-4 probe checks it).
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.right) {
                root.context-requested(self.absolute-position.x / 1px + self.mouse-x / 1px,
                                       self.absolute-position.y / 1px + self.mouse-y / 1px);
            }
        }
    }

    pure function due-color() -> color {
        root.model.due-kind == DueKind.overdue ? Semantic.overdue
        : root.model.due-kind == DueKind.soon ? Semantic.warning
        : root.model.due-kind == DueKind.done ? Semantic.success
        : Theme.text-secondary
    }

    HorizontalLayout {
        spacing: Theme.space-1;

        // The done checkbox (r3 D6): a state-less box that renders
        // `model.done` only — no local checked state exists anywhere,
        // so it cannot desync from the model (the refresh push is the
        // single writer). Untouched on the ghost: the runtime
        // suppresses hover/press over the drag ghost.
        done-box := Rectangle {
            width: Theme.space-4;
            height: Theme.space-4;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-small;
            border-width: Theme.focus-ring-width;
            border-color: root.model.done ? Semantic.success : Theme.text-secondary;
            accessible-role: AccessibleRole.checkbox;
            // The done/undone verb pair (a presentation literal; the
            // role + label pair is what the a11y tree announces).
            accessible-label: root.model.done ? "Mark task not done" : "Mark task done";
            // The AT/keyboard activation lands on the same seam the
            // TouchArea's click hits (the FocusScope-pattern address).
            accessible-action-default => root.done-toggled();
            done-hit := TouchArea {
                clicked => root.done-toggled();
            }
            if (root.model.done): Path {
                width: Theme.space-4 - 2 * Theme.space-1;
                height: Theme.space-4 - 2 * Theme.space-1;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                commands: "M 2 6 L 5 9 L 10 3";
                stroke: Semantic.success;
                stroke-width: Theme.focus-ring-width;
                fill: transparent;
                viewbox-width: 12;
                viewbox-height: 12;
            }
        }

        VerticalLayout {
            padding-left: Theme.space-2;
            padding-right: Theme.space-2;
            padding-top: Theme.space-1;
            padding-bottom: Theme.space-1;
            spacing: Theme.space-1;

            RoleText {
                role: root.model.done ? Typography.caption : Typography.body;
                text-color: root.model.done ? Theme.text-secondary : Theme.text-primary;
                text: root.model.title;
                overflow: elide;
            }

            // Secondary decoration: the due chip stays at every breakpoint
            // (D8 — compact collapses only tertiary decorations).
            if (root.model.due-kind != DueKind.none): HorizontalLayout {
                RoleText {
                    role: Typography.mono;
                    text-color: root.due-color();
                    text: root.model.due-phrase;
                }
            }

            // The scheduled-start and effort chips (secondary class, like
            // the due chip): mono rows at every breakpoint, each present
            // only when its field is set. Pure empty-string tests — no
            // slint-side semantics.
            if (root.model.scheduled-phrase != ""): HorizontalLayout {
                RoleText {
                    role: Typography.mono;
                    text-color: Theme.text-secondary;
                    text: root.model.scheduled-phrase;
                }
            }
            if (root.model.effort-phrase != ""): HorizontalLayout {
                RoleText {
                    role: Typography.mono;
                    text-color: Theme.text-secondary;
                    text: root.model.effort-phrase;
                }
            }

            // Tertiary decorations (rule-D slot): all v0.1.0 kinds are
            // tertiary (D21) — compact collapses them; call sites pass []
            // today.
            if (!root.compact): HorizontalLayout {
                spacing: Theme.space-1;
                for decoration in root.model.decorations: Rectangle {
                    border-radius: Theme.radius-small;
                    background: decoration.tone == Tone.success ? Semantic.success.with-alpha(0.2)
                        : decoration.tone == Tone.warning ? Semantic.warning.with-alpha(0.2)
                        : decoration.tone == Tone.danger ? Semantic.danger.with-alpha(0.2)
                        : decoration.tone == Tone.overdue ? Semantic.overdue.with-alpha(0.2)
                        : Theme.surface-raised;
                    HorizontalLayout {
                        padding-left: Theme.space-1;
                        padding-right: Theme.space-1;
                        RoleText {
                            role: Typography.badge;
                            text-color: Theme.text-secondary;
                            text: decoration.label;
                        }
                    }
                }
            }
        }
    }
}
