// SPDX-License-Identifier: AGPL-3.0-only
// The tooltip mechanism (usability pass D3, generalized by round-1
// D8/D9/D10): the TooltipState global lives here so primitives
// (icon-button) and the window host import the same file — no
// app-window cycle. The delay is the AppWindow's Timer (600 ms); the
// trigger carries label, description and shortcut keys, so a tooltip
// never carries information unavailable elsewhere (label + a11y
// description + the keymap's binding). Keyboard and touch reach every
// action through the keymap — the tooltip is redundant eye-candy by
// construction, never the only carrier. Placement is computed in Rust
// (`src/tooltip.rs`); the panel mounts while content exists (so it
// can measure itself) but stays opacity-0 until the placement
// hand-off (`placed`) — no first-frame flicker at the origin.

import { Theme, Typography, RoleText } from "../theme.slint";
import { KbdHint } from "kbd-hint.slint";

export global TooltipState {
    in-out property <string> text;
    // The description part (round-1 D7): empty renders nothing.
    in-out property <string> description;
    // The shortcut part (round-1 D11): shown only when non-empty.
    in-out property <[string]> keys;
    // pending: hovered and inside the delay window; visible: the
    // delay fired. placed: the Rust placement landed (the hand-off).
    in-out property <bool> pending: false;
    in-out property <bool> visible: false;
    in-out property <bool> placed: false;
    in-out property <length> anchor-x;
    in-out property <length> anchor-y;
    in-out property <length> anchor-width;
    in-out property <length> anchor-height;
    // The placed top-left (Rust-written, D10).
    in-out property <length> tip-x;
    in-out property <length> tip-y;
    // The panel's realized size, mirrored for the tests' geometry
    // oracle (r2 D14) — written next to the size hand-off.
    in-out property <length> tip-width;
    in-out property <length> tip-height;

    // Installed by the window crate at mount: the delay timer (the
    // arm/dismiss must restart per *invocation* — property-change
    // callbacks collapse within one event turn, a repeated hover
    // would not restart a markup Timer) and the size hand-off.
    callback delay-requested();
    callback dismiss-requested();
    callback size-observed(length, length);

    // A control without a label never shows a tooltip; empty
    // description / keys simply render no part.
    public function hover(label: string, description: string,
                          keys: [string], x: length, y: length, w: length, h: length) {
        if (label == "") {
            return;
        }
        self.text = label;
        self.description = description;
        self.keys = keys;
        self.anchor-x = x;
        self.anchor-y = y;
        self.anchor-width = w;
        self.anchor-height = h;
        self.visible = false;
        self.placed = false;
        self.pending = true;
        self.delay-requested();
    }

    public function unhover() {
        self.pending = false;
        self.visible = false;
        self.placed = false;
        self.dismiss-requested();
    }
}

// The display-only panel: no TouchArea (clicks pass through), no
// focusability — it can never steal the keyboard. Mounted while
// content exists so the size hand-off can measure it; opacity gates
// the actual show until `visible && placed`.
export component TooltipPanel inherits Rectangle {
    in property <length> window-width;
    opacity: TooltipState.visible && TooltipState.placed ? 1 : 0;
    x: TooltipState.tip-x;
    y: TooltipState.tip-y;
    // Round-1 D9/D10, widened by r2 D14, description term added by
    // r3 D17: content-hugging width under the caps — 60% of the
    // window and an absolute 420·scale, whichever is smaller. The
    // natural term is the widest of the caption's own unwrapped
    // preferred width (wrap does not change it, probe P5 — the
    // wrap-probe comment stays the authority), the description's
    // (r3 D17: a long help sentence drives the panel to the cap and
    // wraps inside it — a wrapped RoleText's preferred width IS the
    // unwrapped natural width, the same P5 fact) and the hint row's
    // keycap-row preferred width (F28). Binding the panel to the
    // layout's preferred width would cycle through the children's
    // explicit width bindings.
    width: min(max(caption.preferred-width,
                   description-natural(),
                   hint-natural())
                   + 2 * Theme.space-2,
               min(root.window-width * 0.6, 420px * Theme.base-scale));
    // A hint-less tip is not widened by an empty model: the keys-less
    // term is zero. The hint row stays mounted (invisible when
    // keys-less) so its intrinsic preferred width is referenceable
    // here — a conditional element cannot be referenced from outside
    // its branch.
    pure function hint-natural() -> length {
        TooltipState.keys.length == 0 ? 0px : hint-row.preferred-width;
    }
    // The description term (r3 D17): the part is always mounted (the
    // hint-row fact — a conditional element cannot be referenced
    // outside its branch) and hidden when description-less, so its
    // intrinsic preferred width is referenceable here.
    pure function description-natural() -> length {
        TooltipState.description == "" ? 0px : description-text.preferred-width;
    }
    height: layout.preferred-height;
    background: Theme.surface-raised;
    border-width: Theme.focus-ring-width;
    border-color: Theme.border;
    border-radius: Theme.radius-small;

    changed width => { self.mirror-size(); }
    changed height => { self.mirror-size(); }
    init => { self.mirror-size(); }

    // The size hand-off plus the tests' mirrors (r2 D14).
    public function mirror-size() {
        TooltipState.tip-width = self.width;
        TooltipState.tip-height = self.height;
        TooltipState.size-observed(self.width, self.height);
    }

    layout := VerticalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        padding-top: Theme.space-1;
        padding-bottom: Theme.space-1;
        spacing: Theme.space-1;

        // The explicit width binding is what makes the wrapped
        // preferred-height honest (probe P5): a free implicit child
        // measures at its natural width.
        caption := RoleText {
            role: Typography.caption;
            text-color: Theme.text-primary;
            text: TooltipState.text;
            wrap: word-wrap;
            width: root.width - 2 * Theme.space-2;
        }
        description-text := RoleText {
            role: Typography.caption;
            text-color: Theme.text-secondary;
            text: TooltipState.description;
            wrap: word-wrap;
            width: root.width - 2 * Theme.space-2;
            visible: TooltipState.description != "";
        }
        // Always mounted so its preferred width can be mirrored (the
        // conditional element cannot be referenced from outside its
        // branch, and an init-time read sees no caps yet); hidden when
        // keys-less — layouts skip invisible children, so this renders
        // exactly as the old conditional did.
        hint-row := KbdHint {
            keys: TooltipState.keys;
            visible: TooltipState.keys.length > 0;
        }
    }
}
