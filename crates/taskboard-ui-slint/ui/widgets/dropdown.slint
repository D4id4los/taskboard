// SPDX-License-Identifier: AGPL-3.0-only
// The shared dropdown widget (r4 D39): a closed field + chevron and an
// anchored list flyout — the time-field's flyout grammar applied to a
// selection list. Surface-neutral by contract: the widget renders what
// it is pushed (`rows`, `field-text`) and reports what the user did;
// every intent leaves through callbacks (no inline side effects). Both
// the settings connections selector and the board bar (past its
// segment budget, D40) mount it.
//
// Keyboard ladder (widget-internal, preset-independent — the action
// layer never sees these strokes): Return/Space on the closed field
// opens; Up/Down AND Ctrl+N/Ctrl+P move the highlight (clamped at the
// ends, the time-field convention); Return on the flyout selects and
// closes; Escape closes only; Tab closes and rejects so the walk
// continues. Opening re-anchors the highlight onto the selected row
// (or 0 when none) and grabs focus into the flyout; closing hands
// focus back to the field.
//
// Tooltip policy is the consumer's: the widget reports
// `row-hovered(index, x, y, w, h)` / `row-unhovered()` — it knows
// nothing about `TooltipState`.
//
// The flyout renders window-level (round-5 D6): the widget mirrors its
// open state, anchor geometry, and ladder state into `DropdownFacts`;
// the app window mounts the `DropdownFlyout` panel and the dismissal
// underlay from those facts. This overrides the r4 D39 "no window
// overlay" decision that lived at the old in-widget flyout — the
// coordinate-space defect (F9: panel-local geometry under a displaced
// underlay) and the settings `Flickable` clip (F14) are subsumed by
// the date-picker overlay grammar.

import { Theme, Typography, RoleText, Semantic } from "../theme.slint";

import { Icon, IconKind } from "icon.slint";

export enum DropdownIndicator {
    none,
    link,
    link-off,
}

// The tone vocabulary mirrors the RowDot colour language (success /
// accent / warning / danger / neutral) so the dropdown reads like the
// dots it replaces.
export enum DropdownTone {
    neutral,
    success,
    accent,
    warning,
    danger,
}

export struct DropdownRow {
    label: string,
    indicator: DropdownIndicator,
    tone: DropdownTone,
    selected: bool,
    busy: bool,
}

// The dropdown class's mount-truth facts (round-5 D6): one global for
// the widget class, `site` discriminating the mounted instances (0 =
// settings board picker, 1 = board-bar switcher). The widget mirrors
// its own `open`, the anchor's realized window-space geometry, and the
// ladder's highlight/seek into it; the window mounts the flyout panel
// and the dismissal underlay from it. The per-site observation globals
// (`SettingsBoardFacts`/`BoardBarFacts`) stay the journeys' seams —
// both are written from the same widget property.
export global DropdownFacts {
    in-out property <bool> open: false;
    in-out property <int> site: -1;
    in-out property <length> anchor-x;
    in-out property <length> anchor-y;
    in-out property <length> anchor-width;
    in-out property <length> anchor-height;
    // The realized panel geometry (the `MenuPanelFacts.flyout-*`
    // precedent) — the flip/clamp journeys' observation seam.
    in-out property <length> panel-x;
    in-out property <length> panel-y;
    // The ladder's state, read by the window-level panel (the ladder
    // stays in the field's scope; the rows render window-side).
    in-out property <int> highlight: 0;
    in-out property <int> seek-nonce: 0;

    // The row-render mappings' canonical home (round-5 D6: the
    // rendering moved window-side into `DropdownFlyout`, the one
    // source stays here). The indicator→glyph mapping: the widget's
    // own three-arm total (`none` → nothing — the markup guards the
    // slot; the terminal else is the loud warn fallback, the
    // icon.slint convention).
    public pure function indicator-kind(indicator: DropdownIndicator) -> IconKind {
        return indicator == DropdownIndicator.link ? IconKind.link
            : indicator == DropdownIndicator.link-off ? IconKind.link-off
            : IconKind.warn;
    }

    // The tone→colour mapping (RowDot's exact language).
    public pure function tone-color(tone: DropdownTone) -> color {
        return tone == DropdownTone.success ? Semantic.success
            : tone == DropdownTone.accent ? Semantic.focus-ring
            : tone == DropdownTone.warning ? Semantic.warning
            : tone == DropdownTone.danger ? Semantic.danger
            : Theme.text-secondary;
    }
}

// The ladder's typed move counter — the journeys' observation seam
// (the changed-hook-free fact: a global counter survives the
// backend's unreliable `changed` mirroring).
export global DropdownLadder {
    in-out property <int> moves: 0;
}

export component Dropdown inherits Rectangle {
    // The pushed rows and the closed field's rendering (the selected
    // row's label, or the caller's empty-state placeholder).
    in property <[DropdownRow]> rows: [];
    in property <string> field-text: "";
    // The field's a11y label + description (the blanket rule's hover
    // tip copy — consumer-owned constants).
    in property <string> field-label: "";
    in property <string> field-description: "";
    // The selection's mid-ceremony marker (r2 D34): renders the busy
    // pulse in the field's dot slot.
    in property <bool> field-busy: false;
    // The empty-rows caption (round-5 F14's visible-state half):
    // consumer-owned copy, rendered under the disabled field when the
    // row list is empty; empty string = no caption (the board bar's
    // never-empty dropdown mode renders byte-identical).
    in property <string> empty-hint: "";
    // The mount-site discriminator (round-5 D6): which instance's
    // state the class facts global carries (0 = settings board
    // picker, 1 = board-bar switcher).
    in property <int> flyout-site: -1;

    // The intents (no inline side effects).
    callback row-activated(int);
    // Optional: only the board bar wires it (the segment-context
    // precedent); coordinates are pointer-space ints like the
    // card/segment context seams.
    callback row-context(int, int, int);
    callback row-hovered(int, length, length, length, length);
    callback row-unhovered();

    // Widget-local open state (the time-field pattern).
    in-out property <bool> open: false;
    // The keyboard highlight inside `rows`; re-anchored from the
    // selected row on open.
    in-out property <int> highlight: 0;
    // The seek nonce: every highlight move seeks the list (the
    // ListView's focus-into-view seam), the open-time anchor included.
    property <int> seek-nonce: 0;

    // The probe/journey observation seams (typed, structural). The
    // conditional flyout's element ids are not reachable from here,
    // so the geometry seam mirrors the flyout's own expression and
    // the seek seam mirrors the ListView's `request-row` input.
    out property <int> seek-row: root.highlight;
    out property <int> seek-nonce-out: root.seek-nonce;
    out property <length> flyout-height: min(root.rows.length * Theme.space-6, Theme.space-6 * 6);
    // The focus hand-over facts: the flyout's grab empties the field,
    // closing hands the walk back (the field re-focuses).
    out property <bool> field-focused: field-scope.has-focus;
    out property <bool> flyout-focused;

    // The window-mirror loop (round-5 D6): widget → window (open) via
    // the derived-property wrap (the `SettingsBoardFacts` mirroring
    // idiom, moved inside the widget so every mount site gets it), and
    // window → widget (close) via the site-guarded fact read — a
    // window-side close lands as `close()`, which refocuses the field
    // before the panel unmounts (the recorded walk contract). Both
    // directions are site-guarded; the loop converges (a close write
    // re-enters as an already-false no-op).
    property <bool> open-mirrored: root.open;
    changed open-mirrored => {
        DropdownFacts.site = root.flyout-site;
        DropdownFacts.open = self.open-mirrored;
        // The anchor geometry rides the open flip too: at click time
        // the absolute position is realized, and the testing backend
        // does not deliver `changed` for the pre-attach layout pass
        // (the unreliable-mirroring record). The `anchor-abs-*` hooks
        // below keep the mirror live across host scrolls.
        DropdownFacts.anchor-x = flyout-anchor.absolute-position.x;
        DropdownFacts.anchor-y = flyout-anchor.absolute-position.y;
        DropdownFacts.anchor-width = flyout-anchor.width;
        DropdownFacts.anchor-height = flyout-anchor.height;
    }
    property <bool> fact-open: DropdownFacts.open && DropdownFacts.site == root.flyout-site;
    changed fact-open => {
        if (!self.fact-open && root.open) {
            root.close();
        }
    }
    // The anchor geometry, mirrored one-way: window-space by
    // definition (the F9 fix — the settings `Flickable` scroll keeps
    // the mirror live because `absolute-position` tracks it).
    property <length> anchor-abs-x: flyout-anchor.absolute-position.x;
    property <length> anchor-abs-y: flyout-anchor.absolute-position.y;
    changed anchor-abs-x => {
        DropdownFacts.anchor-x = self.anchor-abs-x;
        DropdownFacts.anchor-width = flyout-anchor.width;
        DropdownFacts.anchor-height = flyout-anchor.height;
    }
    changed anchor-abs-y => {
        DropdownFacts.anchor-y = self.anchor-abs-y;
        DropdownFacts.anchor-width = flyout-anchor.width;
        DropdownFacts.anchor-height = flyout-anchor.height;
    }
    // The ladder's state, mirrored for the window-level panel's
    // `ListView` (both writers bumped together, so either changed
    // hook re-writes both facts).
    property <int> highlight-mirrored: root.highlight;
    property <int> seek-mirrored: root.seek-nonce;
    changed highlight-mirrored => {
        DropdownFacts.highlight = root.highlight;
        DropdownFacts.seek-nonce = root.seek-nonce;
    }
    changed seek-mirrored => {
        DropdownFacts.highlight = root.highlight;
        DropdownFacts.seek-nonce = root.seek-nonce;
    }

    // The indicator→glyph and tone→colour mappings live on the
    // `DropdownFacts` global (the window-level flyout's source);
    // these delegates keep the component API (the probe's seam).
    public pure function indicator-kind(indicator: DropdownIndicator) -> IconKind {
        return DropdownFacts.indicator-kind(indicator);
    }

    // The tone→colour mapping (RowDot's exact language).
    public pure function tone-color(tone: DropdownTone) -> color {
        return DropdownFacts.tone-color(tone);
    }

    height: field-scope.preferred-height + 2 * Theme.space-1;
    border-radius: Theme.radius-small;

    // The closed field: one walk stop, one click target, a11y button
    // (the pinned 1.18 role set exposes no combobox role).
    field-scope := FocusScope {
        width: 100%;
        height: field-row.preferred-height + 2 * Theme.space-1;
        focus-on-tab-navigation: true;
        // The empty-rows state (F14): the walk legitimately skips a
        // disabled control — the picker names its emptiness instead
        // of sitting as a dead stop.
        enabled: root.rows.length > 0;
        accessible-role: AccessibleRole.button;
        accessible-label: root.field-label;
        accessible-description: root.field-description;
        // The default a11y action opens (the driver's click seam —
        // the icon-button precedent).
        accessible-action-default => {
            if (root.rows.length > 0) {
                root.open = true;
                root.anchor-highlight();
            }
        }
        // The ladder's field arm (the icon-button raw-key half, r3
        // D12, plus the modal ladder): the single key path DECLINES
        // the ladder keys while the flyout is open (the adapter reads
        // the facts global — the capture tunneling would otherwise
        // consume the arrows as bound actions first), so they arrive
        // here; the action layer never sees them.
        key-pressed(event) => {
            if (root.open && root.rows.length > 0) {
                if (event.text == Key.UpArrow) {
                    root.move-highlight(-1);
                    accept
                } else if (event.text == Key.DownArrow) {
                    root.move-highlight(1);
                    accept
                } else if (event.text == "n" && event.modifiers.control) {
                    root.move-highlight(1);
                    accept
                } else if (event.text == "p" && event.modifiers.control) {
                    root.move-highlight(-1);
                    accept
                } else if (event.text == Key.Return) {
                    root.row-activated(root.highlight);
                    root.open = false;
                    accept
                } else if (event.text == Key.Escape) {
                    root.open = false;
                    accept
                } else if (event.text == Key.Tab) {
                    // Close BEFORE the traversal runs: the flyout is
                    // not the focus owner (the field is), so the
                    // unmount is safe, and the walk continues from the
                    // field onto the next stop.
                    root.open = false;
                    reject
                } else {
                    reject
                }
            } else if (!root.open
                    && (event.text == Key.Return || event.text == " ")
                    && root.rows.length > 0) {
                root.open = true;
                root.anchor-highlight();
                accept
            } else {
                reject
            }
        }
        // The walk-away seam: the traversal moving the focus off the
        // field (Tab while open) closes the flyout on its way out —
        // the same grammar the flyout's own seam carried, moved to the
        // scope that actually holds the walk.
        changed has-focus => {
            if (!self.has-focus && root.open) {
                root.open = false;
            }
        }
        field-row := HorizontalLayout {
            padding-left: Theme.space-2;
            padding-right: Theme.space-1;
            spacing: Theme.space-1;
            // The busy pulse rides in the dot slot; otherwise the
            // slot collapses (a plain Rectangle holder — a layout
            // would own the cross-axis and forbid the dot's y).
            Rectangle {
                width: root.field-busy ? Theme.space-2 : 0;
                if root.field-busy: busy-dot := Rectangle {
                    width: Theme.space-2;
                    height: self.width;
                    y: (parent.height - self.height) / 2;
                    border-radius: self.width / 2;
                    background: Semantic.sync-active;
                    states [
                        pulse when true: {
                            opacity: 0.45;
                            in { animate opacity { duration: 600ms; iteration-count: -1; } }
                        }
                    ]
                }
            }
            field-text := RoleText {
                role: Typography.body;
                text: root.field-text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Icon {
                kind: IconKind.chevron-down;
            }
        }
        // The whole field is one click target — and a click focuses
        // it (real click-to-focus: the walk then lives in the field,
        // so the ladder works after a click-open without depending on
        // the flyout's grab).
        field-touch := TouchArea {
            // The empty-rows state (F14): a disabled, non-interactive
            // click target — the open gates above become unreachable
            // by construction, and the caption below names the state.
            enabled: root.rows.length > 0;
            clicked => {
                field-scope.focus();
                root.open = !root.open;
                if (root.open) {
                    root.anchor-highlight();
                }
            }
        }
    }
    // The field's focus ring.
    border-width: field-scope.has-focus && !root.open ? Theme.focus-ring-width : 0;
    border-color: Semantic.focus-ring;
    background: Theme.surface-raised;

    // The flyout is window-level now (round-5 D6 — the override note
    // lives at the global and at the app-window overlay group); the
    // widget renders only the field and mirrors its state into
    // `DropdownFacts`. The empty-rows caption (F14) is the
    // TimeField error-hint's shape (overflowing the field height by
    // design); the walk legitimately skips the disabled field.
    if (root.rows.length == 0 && root.empty-hint != ""): empty-hint-line := RoleText {
        role: Typography.caption;
        text-color: Theme.text-secondary;
        y: field-scope.height + Theme.space-1;
        text: root.empty-hint;
    }

    // The geometry anchor: the closed field's box (the flyout anchors
    // below it, named after the declaration order — the time-field
    // pattern).
    property <length> row-height: field-scope.height;
    flyout-anchor := Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.row-height;
    }

    // The current selection's index (the open-time anchor's input;
    // derived by the consumer's push pass — the struct's `selected`
    // flag is the per-row render fact, this is the anchor fact).
    in property <int> selected-index: 0;

    // The open-time anchor (the push's selected index) + the seek
    // bump; called by every open site (a root `changed open` hook
    // breaks the testing backend's element traversal — the recorded
    // negative).
    public function anchor-highlight() {
        root.highlight = Math.clamp(
            root.selected-index,
            0,
            Math.max(root.rows.length - 1, 0),
        );
        root.seek-nonce += 1;
    }

    // One clamped highlight move (the arrows and C-n/C-p share this
    // arm — one code path, two key spellings).
    public function move-highlight(direction: int) {
        DropdownLadder.moves += 1;
        root.highlight = Math.clamp(
            root.highlight + direction,
            0,
            Math.max(root.rows.length - 1, 0),
        );
        root.seek-nonce += 1;
    }

    // Close and hand focus back to the field (the walk's home stop).
    // The grab lands BEFORE the conditional unmounts: focusing during
    // teardown loses the grab, and a destroyed focus owner aborts the
    // post-reject Tab traversal (the walk would stop dead).
    public function close() {
        field-scope.focus();
        root.open = false;
    }
}
