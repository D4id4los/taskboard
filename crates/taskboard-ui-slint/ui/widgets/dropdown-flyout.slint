// SPDX-License-Identifier: AGPL-3.0-only
// The dropdown flyout's window-level panel (round-5 D6): the row
// rendering moved verbatim out of the in-widget displaced underlay
// (the F9/F14 fix — the settings `Flickable` can no longer clip it).
// Mounted by the app window from `DropdownFacts`; the panel rides
// the `AnchoredOverlayHost`, which owns the placement. The ladder
// stays in the field's scope (the widget's), so this panel is
// deliberately NOT a FocusScope — the walk must never be able to
// land here (the recorded negative: a traversal target inside the
// flyout would be unmounted by the close, taking the walk's focus
// down with it). Row intents report back through callbacks — the
// widget's surface-neutral contract.
//
// Round-9 W6 (#954): the panel chrome is the MenuShell's and the
// rows are MenuRows (D-4) — the chrome lines and the row anatomy
// lines are the primitives' now; the ListView (the virtualisation
// seam), the seek seams, and the select-close write stay.

import { Theme, Typography } from "../theme.slint";
import { DropdownRow, DropdownFacts } from "dropdown.slint";
import { ListView } from "listview.slint";
import { MenuShell } from "menu-shell.slint";
import { MenuRow } from "menu-row.slint";

export component DropdownFlyout inherits MenuShell {
    // The pushed rows (the mount binds the same model the widget's
    // field renders — one source, the adapter's push).
    in property <[DropdownRow]> rows;
    // The row intents (the widget's own callbacks, re-exposed at the
    // panel the rows now live in).
    callback row-activated(int);
    callback row-context(int, int, int);
    callback row-hovered(int, length, length, length, length);
    callback row-unhovered();

    row-count: root.rows.length;
    corner-radius: Theme.radius-small;

    // A plain a11y list container — the ladder's keys arrive at the
    // field (the widget's scope), the window's capture decline hands
    // them there; this panel never holds focus.
    flyout-scope := Rectangle {
        width: 100%;
        height: 100%;
        accessible-role: AccessibleRole.list;

        list := ListView {
            request-row: DropdownFacts.highlight;
            request-nonce: DropdownFacts.seek-nonce;
            total-rows: root.rows.length;
            width: 100%;
            height: 100%;

            for row[row-index] in root.rows: flyout-row := MenuRow {
                // One space-6 pitch (the consumer's pin).
                height: Theme.space-6;
                label: row.label;
                // The selected row's law (round-9 chunk 15 D-5, the
                // class-wide rendering law): selected ⇒ emphasized
                // text + the check glyph — the model's `selected` is
                // the only input.
                text-role: row.selected
                    ? Typography.body-emphasized : Typography.body;
                selected: row.selected;
                busy: row.busy;
                // The indicator/busy dot slot: busy wins (the r2 D34
                // ceremony), otherwise the indicator glyph colourized
                // by tone (`none` collapses the slot). The shipped
                // inset keeps the collapsed slot's spacing
                // contribution.
                leading-glyph: DropdownFacts.indicator-kind(row.indicator);
                leading-tone: row.tone;
                spacing: Theme.space-1;
                leading-gap: true;
                // The hover-union background (F29's feedback): the
                // ladder's highlight arm + the row's own hover arm.
                highlighted: row-index == DropdownFacts.highlight
                    || self.hover-now;
                // The a11y posture: a list-item in the plain list
                // container (the rows never hold focus).
                accessible-role: AccessibleRole.list-item;
                invoked => {
                    root.row-activated(row-index);
                    // The window-side close (round-5 D6): the fact
                    // write lands as the widget's close — the field
                    // refocuses before the panel unmounts (the
                    // recorded walk contract). The select-close
                    // marker (round-9 chunk 15 D-6): this close
                    // SELECTS first, so the widget's external-close
                    // hook skips the dismissal routing.
                    DropdownFacts.select-close = true;
                    DropdownFacts.open = false;
                }
                hovered(x, y, w, h) => {
                    root.row-hovered(row-index, x, y, w, h);
                }
                unhovered() => {
                    root.row-unhovered();
                }
                context(x, y) => {
                    root.row-context(row-index, x, y);
                }
            }
        }
    }
}
