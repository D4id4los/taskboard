// SPDX-License-Identifier: AGPL-3.0-only
// The text-field primitive (L1, §4.4): the single-line text input —
// the §5.1 exception class, contained in this one primitive. Text is
// received natively (the insert-mode chain binds nothing printable);
// Return fires `accepted`, and cancellation rides the action layer
// (mode.normal → discard_edit), not a key handler here.
//
// Layout citizenship (r2 D22): the input is absolutely positioned
// with an explicit width term, so its text-derived preferred width
// never flows into the ancestor layouts — the field's preferred
// width is the Theme.space-15 floor, never the buffer (the probe
// pin `the_text_field_keeps_its_layout_cell_while_text_grows`
// records the mechanism against the pinned Slint).

import { Theme, Typography, RoleText, Semantic } from "../theme.slint";

export component TextField inherits Rectangle {
    in property <string> placeholder;
    // The a11y label (D16).
    in property <string> label;
    // The a11y description (r2 D31): the annotated field's help fact —
    // one line, call-site-neutral; empty renders no description.
    in property <string> description;
    in property <string> initial-text;
    in property <bool> selected-on-focus: false;
    // The settings form's write-only secret field (round-1 D26b): echo
    // off. The a11y label stays the field's address, never the value.
    in property <bool> secret: false;
    in-out property <string> text <=> input.text;
    // The checkmark commit affordance (r2 D23): when enabled, a
    // trailing check square renders while the field holds focus and a
    // non-empty buffer; clicking it fires the same `accepted` seam as
    // Return — click ≡ key by construction. Reserves no space.
    in property <bool> commit-affordance: false;
    callback edited(string);
    callback accepted(string);
    // The focus-loss seam (round-3 L1, plan §7 — the probe-recorded
    // mechanism A idiom, the compiler-widgets lineedit-base shape): a
    // component-level property derived from the inner TextInput's
    // has-focus, `changed` firing exactly once per focus loss — on
    // pointer-click-away and on programmatic steals. A TouchArea
    // click never moves focus (the recorded negative), so the L2
    // seam-settle carries those paths.
    callback focus-lost();
    property <bool> input-has-focus: input.has-focus;
    changed input-has-focus => {
        if (!input-has-focus) {
            root.focus-lost();
        }
    }

    background: Theme.surface-raised;
    border-radius: Theme.radius-small;
    border-width: input.has-focus ? Theme.focus-ring-width : 0;
    border-color: Semantic.focus-ring;
    min-height: placeholder-text.preferred-height + 2 * Theme.space-2;
    // The content-free preferred width (r2 D22): the token floor, so
    // a growing buffer cannot stretch the field or its ancestors.
    min-width: Theme.space-15;

    accessible-role: AccessibleRole.text-input;
    accessible-label: root.label;
    accessible-description: root.description;
    // The buffer exposed to ATs (r2 D24's emptiness oracle reads the
    // same seam); the secret field echoes nothing.
    accessible-value: root.secret ? "" : root.text;

    // The mount-time focus grab (the create-flow fields all want
    // it); the timers form (DR-3/3) opts out — a permanently
    // instantiated field must never steal the window's initial focus
    // from the today view's key chain.
    in property <bool> autofocus: true;
    init => {
        input.text = root.initial-text;
        if (root.autofocus) {
            input.focus();
        }
        if (root.selected-on-focus) {
            input.select-all();
        }
    }

    placeholder-text := RoleText {
        role: Typography.body;
        text-color: Theme.text-secondary;
        text: root.placeholder;
        visible: input.text == "";
        x: Theme.space-2;
        y: (parent.height - self.preferred-height) / 2;
    }

    input := TextInput {
        // Explicit geometry (r2 D22): the width term is the cell, not
        // the text — the preferred-width propagation of the former
        // inner HorizontalLayout is what let buffers stretch every
        // ancestor layout.
        x: Theme.space-2;
        width: parent.width - 2 * Theme.space-2;
        height: parent.height;
        // The font is TextInput's platform default: the token lint
        // (rightly) forbids font attributes outside the theme, and
        // the theme cannot reach into a primitive's input. The
        // colour still flows from tokens.
        color: Theme.text-primary;
        input-type: root.secret ? InputType.password : InputType.text;
        vertical-alignment: center;
        edited() => root.edited(input.text);
        accepted() => root.accepted(input.text);
    }

    // The commit affordance (r2 D23): overlays the trailing padding —
    // no space is reserved (the field's width term is content-free
    // per D22). Same square language as IconButton, but deliberately
    // not an IconButton: the visibility rule requires the input's
    // focus, and a tab-stop child would unmount the moment it took
    // focus — a trap. TouchArea-only (click and AT activation, no
    // tab stop); a11y label "Commit" with the field's label as
    // description.
    if (root.commit-affordance && input.has-focus && input.text != ""): commit-button := Rectangle {
        x: parent.width - self.width - Theme.space-1;
        y: (parent.height - self.height) / 2;
        width: Theme.space-6;
        height: Theme.space-6;
        border-radius: Theme.radius-small;
        background: commit-touch.has-hover ? Theme.surface-hover : transparent;
        accessible-role: AccessibleRole.button;
        accessible-label: "Commit";
        accessible-description: root.label;
        // The AT/keyboard activation lands on the same seam the
        // TouchArea's click hits (§7.1's equivalence).
        accessible-action-default => { root.accepted(input.text); }
        commit-touch := TouchArea {
            clicked => {
                // The Return seam, verbatim: click ≡ key.
                root.accepted(input.text);
            }
        }
        Path {
            width: Theme.space-3;
            height: Theme.space-3;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            commands: "M 2 6 L 5 9 L 10 3";
            stroke: commit-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
            stroke-width: Theme.focus-ring-width;
            fill: transparent;
            viewbox-width: 12;
            viewbox-height: 12;
        }
    }
}
