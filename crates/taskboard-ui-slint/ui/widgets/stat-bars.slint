// SPDX-License-Identifier: AGPL-3.0-only
// The stat-bars strip (#623 slice A, D-S4): a hand-rolled, minimal
// horizontal bar chart — R-3's ruling (no chart crate). One equal-
// stretch bar per day, two stacked segments (`base` at the bottom,
// `stack` above it) whose heights are pushed fractions; a day with
// nothing renders a baseline hairline tick so the bar count always
// equals the window's day count (D-9 tier 2: the shape collapses,
// never the structure).
//
// Composition-only geometry (VF-8): every height is `fraction × strip
// height` — the push pass normalizes the values presentation-side;
// the widget computes nothing but geometry. The strip shows *shape*:
// fractions hide absolute magnitude — the magnitudes live in the
// consuming section's stat cells. No labels, ticks, tooltips, or
// value overlays (v1; the R-3 honest-minimal-chart posture).
//
// The vocabulary is neutral strip vocabulary on purpose (slice B's
// D-B6): the tracking sections map Work → `base` / Respite → `stack`,
// the reflection sections Mood → `base` / Energy → `stack`. The
// segment colours are `in` properties defaulting to theme tokens, so
// each consumer re-instances the widget rather than forking it.

import { Theme, Semantic } from "../theme.slint";

export struct StatBarModel {
    // The lower segment's fraction (0.0..=1.0).
    base: float,
    // The upper segment's fraction (stacked above `base`).
    stack: float,
}

export component StatBars inherits Rectangle {
    in property <[StatBarModel]> bars;
    in property <color> base-color: Semantic.success;
    in property <color> stack-color: Semantic.warning;
    // The strip's fixed plot height (the consumer's layout decides the
    // placement; the height is a theme-scaled token expression).
    in property <length> plot-height: 48px * Theme.base-scale;

    // The explicit cap (#725, the TaskCard remedy): with `bars` empty
    // the strip layout is the row's only cell, so the box-layout empty
    // early return reports `max = min = 2·padding`, and the single-cell
    // lowering hands that to this root — every consuming column's
    // merge adopts the floor as its own max-width, and any main-axis
    // distribution starves the section to it (the reflection section
    // froze at its caption's width, at every row width). Stating the
    // max severs the merge; the D-9 skeleton promise (values collapse,
    // the section never does) holds at every placement.
    max-width: Theme.layout-severing-max-width;
    height: root.plot-height + 2 * Theme.space-1;
    background: Theme.surface;
    border-radius: Theme.radius-small;
    clip: true;

    HorizontalLayout {
        padding: Theme.space-1;
        spacing: Theme.space-1;
        for bar in root.bars: Rectangle {
            horizontal-stretch: 1;
            clip: true;
            border-radius: Theme.radius-small;
            background: Theme.background;
            VerticalLayout {
                alignment: end;
                // `stack` over `base`: the segment pair stacks from the
                // strip's baseline.
                Rectangle {
                    height: bar.stack * root.plot-height;
                    background: root.stack-color;
                }
                Rectangle {
                    height: bar.base * root.plot-height;
                    background: root.base-color;
                }
                // The empty day's baseline tick — a day with nothing
                // reads as "nothing", never as a missing bar.
                Rectangle {
                    height: bar.base + bar.stack == 0
                            ? Theme.hairline-width
                            : 0;
                    background: Theme.border;
                }
            }
        }
    }
}
