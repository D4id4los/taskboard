// SPDX-License-Identifier: AGPL-3.0-only
// The in-house virtualised list (the #373 design round, route 2).
// The element NAME and the five length properties are the slint
// compiler's nominal ListView contract (object_tree.rs:2891-2905):
// rename any of them and the `for` below silently renders eager —
// tests/virtualisation.rs's engagement probe fails on purpose.
export component ListView inherits Flickable {
    in-out property <length> visible-height: self.height;
    in-out property <length> visible-width: self.width;
    // The focus-into-view seam (design round §3a): the consumer
    // binds request-row/-nonce/-total-rows; a nonce change seeks.
    in property <int> request-row: -1;
    in property <int> request-nonce: 0;
    in property <int> total-rows: 0;
    changed request-nonce => {
        if (self.request-row >= 0) {
            self.scroll-row-into-view(self.request-row);
        }
    }
    // The scroll actions' paging seam (round-3 D26): the consumer
    // binds page-request/-nonce filtered on its family+index pair
    // (the request-row pattern); a nonce change pages by
    // visible-height minus one row of context (the same runtime
    // average scroll-row-into-view inverts), clamped to the content.
    in property <int> page-request: 0;
    in property <int> page-nonce: -1;
    changed page-nonce => {
        if (self.page-request != 0) {
            self.page(self.page-request);
        }
    }
    // Top-anchors the row using the runtime's own cached average
    // (content-height/total-rows) — the exact divisor the runtime's
    // 1.5-screen random seek inverts (repeater.rs update_visible_
    // instances), so the seek lands the row live at the window top.
    // Guard: no-op while the first layout is pending (avg == 0) and
    // when the estimated range already holds the row.
    public function page(page: int) {
        let avg-est = self.total-rows > 0
            ? self.content-height / self.total-rows
            : 0px;
        let delta = self.visible-height - avg-est;
        if (delta <= 0px) {
            return;
        }
        self.content-y = Math.clamp(
            self.content-y - page * delta,
            -self.content-height,
            0px,
        );
    }

    public function scroll-row-into-view(row: int) {
        if (row < 0 || self.total-rows <= 0) {
            return;
        }
        let avg-est = self.content-height / self.total-rows;
        if (avg-est <= 0px) {
            return;
        }
        let top = row * avg-est;
        if (top < -self.content-y
                || top + avg-est > -self.content-y + self.visible-height) {
            self.content-y = -top;
        }
    }
    // The row-anchored compensation seam (#592): opt-in per call site
    // (defaults off — the content-anchored contract every other
    // consumer is pinned on). The consumer binds the anchor facts
    // (its section's first changed row, the signed row delta, the
    // changed row's extent — 0px = never observed live, the runtime
    // average is the fallback) and drives the nonce edge per commit;
    // a compensation is a synthetic scroll by `-delta × extent`,
    // clamped to the content, guarded to changes strictly above the
    // estimated window head (`floor(-content-y / avg)` minus a
    // one-average-row guard band — ambiguity never compensates).
    // Measured (stage-2): the write survives the runtime's own
    // per-pass content-y rewrite and settles without oscillation.
    in property <bool> row-anchored: false;
    in property <int> anchor-first-change: -1;
    in property <int> anchor-row-delta: 0;
    in property <length> anchor-extent: 0px;
    in property <int> anchor-nonce: -1;
    changed anchor-nonce => {
        if (self.row-anchored
                && self.anchor-first-change >= 0
                && self.anchor-row-delta != 0) {
            let avg-est = self.total-rows > 0
                ? self.content-height / self.total-rows
                : 0px;
            let extent = self.anchor-extent > 0px
                ? self.anchor-extent
                : avg-est;
            if (avg-est > 0px && extent > 0px) {
                let head = Math.floor(-self.content-y / avg-est);
                if (self.anchor-first-change < head - 1) {
                    self.content-y = Math.max(
                        -self.content-height,
                        Math.min(0px, self.content-y - self.anchor-row-delta * extent),
                    );
                }
            }
        }
    }
}
