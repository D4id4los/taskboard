// SPDX-License-Identifier: AGPL-3.0-only
// The theme module: the *only* place colours, font attributes, and
// base-dimension arithmetic live (design §3.1). Everything is defined
// against `base-scale`, the root multiplier pushed from `[ui] scale` at
// window construction. The 14 `in-out` colour literals below are the
// DARK palette's pre-push boot defaults (#1437 D2): the authoritative
// palette data lives in Rust (`src/palette.rs`, `Palette::DARK`
// verbatim + `Palette::LIGHT`), pushed at window construction and
// live on switch — the mirror-parity test
// (`src/token_tests.rs::the_slint_defaults_mirror_the_dark_palette`)
// pins these literals ≡ `Palette::DARK` field-by-field. The derived
// `Semantic` entries stay `out`: references, not data.
//
// Naming (§3.3): function names (`text-secondary`, `surface-raised`),
// never hue names; two layers only — palette (Theme) → semantic
// (Semantic). Views reference semantic/role tokens only.

// A text role (§3.2): size/weight/family triple, sizes × base-scale.
export struct TextRole {
    size: length,
    weight: int,
    family: string,
}

export global Theme {
    // §6.1: the root dimension multiplier (`[ui] scale`, 0.5–3.0).
    // Applied by the window shell at construction (the generated
    // `Theme` global trait's setter); every dimension below is
    // `base-px * base-scale`.
    in-out property <float> base-scale: 1.0;

    // ---- Palette (raw values; the semantic layer maps state onto
    //      them, views never name them) --------------------------------
    // Contrast-checked pair list lives in the Rust token tests
    // (src/token_tests.rs §9.1); tuning palette values re-runs it.
    // The surface ladder (r2 D35) — each step may paint only over the
    // steps below it: `background` = the window shell / board strip,
    // `surface` = containers (column cards, toolbar, tracks, chips),
    // `surface-raised` = content on a container (task cards, fields,
    // panels, selected paints). There is no raised-again step: any new
    // paint above `surface-raised` must stay distinct from
    // `surface-hover`'s guard below, which boxes the arithmetic (the
    // r2 visual-identity plan §2.1).
    in-out property <color> background: #14161c;
    in-out property <color> surface: #1d2028;
    in-out property <color> surface-raised: #262a35;
    // The hover surface (usability pass D1): always lighter than every
    // parent it can be painted over — the hover step is at least the
    // surface→surface-raised step against both parents (locked by the
    // token tests' distinctness guard).
    in-out property <color> surface-hover: #303545;
    in-out property <color> text-primary: #e8eaf0;
    in-out property <color> text-secondary: #a6abbd;
    in-out property <color> border: #646c85;
    in-out property <color> focus-ring: #7aa2f7;
    // The colour picker's const colour DATA (schedule-colour-ux
    // journey plan D-4, #1440): the hue strip's six pure ramp stops,
    // the SV square's white→saturation / black→value overlay pair and
    // the thumb ring. These are the projected colour space's own
    // constants (the projection grammar's axes), not semantic state —
    // the theme file is their home by the §3.4 token law.
    out property <color> picker-hue-red: #ff0000;
    out property <color> picker-hue-yellow: #ffff00;
    out property <color> picker-hue-green: #00ff00;
    out property <color> picker-hue-cyan: #00ffff;
    out property <color> picker-hue-blue: #0000ff;
    out property <color> picker-hue-magenta: #ff00ff;
    out property <color> picker-sv-white: #ffffff;
    out property <color> picker-sv-black: #000000;

    // ---- Spacing scale (4/8/12/16/24/32/48/64 px × base-scale) ------
    out property <length> space-1: 4px * base-scale;
    out property <length> space-2: 8px * base-scale;
    out property <length> space-3: 12px * base-scale;
    out property <length> space-4: 16px * base-scale;
    out property <length> space-5: 24px * base-scale;
    out property <length> space-6: 32px * base-scale;
    out property <length> space-7: 48px * base-scale;
    out property <length> space-8: 64px * base-scale;
    // The text-field's layout-cell floor (r2 D22): a field's preferred
    // width comes from this token, never from its text content — the
    // settings-row / metadata-cell minimum.
    out property <length> space-15: 96px * base-scale;

    // The task-card title's elide floor (r4 D1): ≈12 characters of
    // Typography.body — Inter's average lowercase advance at 14 px is
    // ≈0.5 em ≈ 7 px, 12 × 7 = 84. A readability floor for the elide,
    // not a measurement; role-independent (a done card's caption role
    // gets the same layout floor).
    out property <length> card-title-min-width: 84px * base-scale;

    // The layout-constraint severing cap (round-6 R6-4): an explicit
    // max-width that replaces an inherited constraint instead of merely
    // flooring it — a conditionally-empty stretch-aligned layout
    // reports max = min = 0 (i-slint-core box_layout_info's empty early
    // return), and a single-layout-child wrapper inherits that max
    // unless one is stated. Effectively unbounded: at base-scale 3 the
    // cap is still ~22x a full-HD row. Not a spacing step — a layout
    // meta-constant, the icon-size precedent.
    out property <length> layout-severing-max-width: 99999px;

    // The today view's two-column arm's width floor (#1436, journey
    // plan 2026-11-25 D-2): at/above this logical-px viewport width
    // the Today page reflows into the two-column grid (task sections
    // left, habits + day review right). Deliberately unscaled (the
    // breakpoint vocabulary's law — src/responsive.rs: scale and
    // responsiveness compose instead of fighting) and deliberately
    // EQUAL to the board layout's expansive breakpoint
    // (`EXPANSIVE_MIN_WIDTH`, src/responsive.rs) — one shared value,
    // not a second number to keep in sync; the pairing is pinned by
    // `responsive.rs::the_today_two_column_token_shares_the_
    // expansive_threshold`. The width test alone decides the arm on
    // every mount — no kiosk branch (the 2026-11-25 operator
    // amendment, issue #1436).
    out property <length> layout-today-two-column-min-width: 1440px;

    // The column resize handle's hit-target width (round-1 D17; the
    // builtin tableview's 10 px pattern, one theme home).
    out property <length> resize-handle-width: 10px * base-scale;

    // The icon glyph's edge (r4 D10): the square every vendored SVG
    // renders in — Lucide's 24-grid at the icon-button's inner glyph
    // footprint (the drawn Path blocks' space-3 edge). A named token,
    // not space-3 reuse: the edge is a glyph-metric rather than a
    // spacing step, and every icon consumer (button, status bar,
    // later chunks) shares it.
    out property <length> icon-size: 12px * base-scale;

    // ---- Radii & focus ------------------------------------------------
    out property <length> radius-small: 4px * base-scale;
    out property <length> radius-medium: 8px * base-scale;
    out property <length> focus-ring-width: 2px * base-scale;

    // The dialog panel's elevation shadow (#1004): the capture
    // composition's pre-migration chrome blur, promoted to a token so
    // the tuning lives here (the scrim token's tuning law — an
    // operator-owned visual). The colour lifts the surface-hover step
    // (the flyouts' existing shadow pairing).
    out property <length> shadow-blur: 12px * base-scale;
    out property <color> shadow-color: surface-hover;

    // The one-logical-pixel hairline (r2 D36): baseline rules and
    // hairline borders (the board tab strip). A spacing-class
    // dimension, so the theme is its only legal home; no colour rides
    // it (the token tests' colour set is untouched).
    out property <length> hairline-width: 1px * base-scale;

    // The two-logical-pixel rule (the separators/bars drawn at double
    // the hairline weight — board column rules, habit list dividers).
    // #1361: five raw `2px * base-scale` sites shared this recipe; the
    // hairline token is deliberately NOT adopted there (halving the
    // rule would be a visual change), so the value gets its own name.
    out property <length> rule-width: 2px * base-scale;


    // ---- Window default dimensions (a spacing-class dimension, so it
    //      lives here — keeps the token lint's rule 3 total) -----------
    out property <length> window-default-width: 1024px * base-scale;
    out property <length> window-default-height: 640px * base-scale;

    // The modal scrim (J2 R-3, D-W1-5): translucent dark drawn under
    // every ModalDialogHost panel — visible, non-interactive (the
    // host's dismissal TouchArea carries interaction, the paint is
    // passive). Anchored overlays get no scrim (the light-dismiss
    // family). First cut from the surface ladder's darkest base at
    // ~50% alpha; visual tuning is operator-owned (stage-3
    // walkthrough). The 8-digit form stays invisible to the contrast
    // extractor (token_tests) — a translucent wash is not a text
    // carrier.
    in-out property <color> scrim: #0b0d1280;

    // ---- Overlay sizing floors/caps (J2 R-6, D-W1-5; sourced from
    //      the widget inventory report §4's Qt/web defaults) ----------
    // Caps are bounds, never targets: a dialog's width law is
    // `min(viewport - 2·space-2, min(dialog-max-width,
    // max(preferred-width, dialog-min-width)))`.
    out property <length> dialog-min-width: 280px * base-scale;
    out property <length> dialog-max-width: 560px * base-scale;
    out property <length> menu-min-width: 200px * base-scale;
    out property <length> menu-max-width: 360px * base-scale;

    // The overlay panel-width families (#1361 §5.3): the raw
    // `panel-preferred-width` values clustered by value+role — ≥2
    // sites per value became a named token. The 560 family adopts the
    // existing dialog-max-width, the 360 family the existing
    // menu-max-width (the hosts' own width laws); genuine one-offs
    // stay raw and are recorded in the sweep commit.
    out property <length> panel-width: 420px * base-scale;
    out property <length> panel-width-narrow: 300px * base-scale;
    out property <length> panel-width-slim: 280px * base-scale;
    // The journal editor's field-width family (review-view's ledger
    // editor cells): the two ≥2 value clusters.
    out property <length> journal-field-width: 160px * base-scale;
    out property <length> journal-field-narrow: 140px * base-scale;
}

// The closed text-role table (§3.2): adding a role is a theme-level
// decision (table + ADR-0015 amendment note) — the lint makes per-view
// invention impossible. Sizes ride `base-scale`; families reference the
// bundled fonts (Inter statics + JetBrains Mono, OFL-1.1). Slint font
// weight is numeric (400 regular / 600 semibold / 700 bold); the static
// font instances are registered at startup under these family names.
export global Typography {
    out property <string> family-sans: "Inter";
    out property <string> family-mono: "JetBrains Mono";

    out property <TextRole> display: { size: 30px * Theme.base-scale, weight: 700, family: family-sans };
    out property <TextRole> title: { size: 20px * Theme.base-scale, weight: 700, family: family-sans };
    out property <TextRole> heading: { size: 16px * Theme.base-scale, weight: 600, family: family-sans };
    out property <TextRole> body: { size: 14px * Theme.base-scale, weight: 400, family: family-sans };
    out property <TextRole> body-emphasized: { size: 14px * Theme.base-scale, weight: 600, family: family-sans };
    out property <TextRole> caption: { size: 12px * Theme.base-scale, weight: 400, family: family-sans };
    out property <TextRole> badge: { size: 11px * Theme.base-scale, weight: 600, family: family-sans };
    out property <TextRole> mono: { size: 12.5px * Theme.base-scale, weight: 400, family: family-mono };
}

// The D18 tone vocabulary: the theme-level closed state-colour
// vocabulary (rule A's property surface). Primitives map `Tone` onto
// `Semantic` internally via conditionals — views never name colours.
// Adding a tone is a theme decision.
export enum Tone {
    neutral,
    info,
    success,
    warning,
    danger,
    overdue,
    sync-active,
    offline,
}

// State colours mapped onto palette entries (§3.1): nothing outside the
// theme names palette colours. `offline` maps to text-secondary.
export global Semantic {
    in-out property <color> success: #6fd98b;
    in-out property <color> warning: #e8c268;
    in-out property <color> danger: #e8756f;
    in-out property <color> overdue: #ff9e64;
    in-out property <color> sync-active: #7aa2f7;
    out property <color> offline: Theme.text-secondary;
    in-out property <color> focus-ring: Theme.focus-ring;

    // The F-3 tone-ladder functions (#952, round-9 W5): the canonical
    // Tone→colour mapping in exactly one copy — every primitive's
    // ladder chain delegates here; no new conditional chain may
    // re-state the mapping (the anti-ad-hoc law, ux-surface-census
    // small-widget family). `tone-color` is the canonical content
    // mapping (neutral→text-secondary, info→text-primary, the
    // semantic tones verbatim); `tone-fill` is the translucent chip
    // fill derived from it (the 0.2 alpha the Badge family paints).
    // Per-consumer overrides that are interaction or site state
    // (IconButton's hover lift, ListRow's row-text neutral step,
    // Badge's surface-raised neutral/info chip fill) stay site-side —
    // the function owns the ladder, not the site's local deviations.
    public pure function tone-color(tone: Tone) -> color {
        return tone == Tone.neutral ? Theme.text-secondary
            : tone == Tone.info ? Theme.text-primary
            : tone == Tone.success ? success
            : tone == Tone.warning ? warning
            : tone == Tone.danger ? danger
            : tone == Tone.overdue ? overdue
            : tone == Tone.sync-active ? sync-active
            : offline;
    }
    public pure function tone-fill(tone: Tone) -> color {
        return tone-color(tone).with-alpha(0.2);
    }
}

// The due classification as the markup vocabulary (models maps the
// presentation enum 1:1); tones are derived in markup conditionals.
export enum DueKind {
    none,
    done,
    later,
    soon,
    overdue,
}

// The sync phase as the badge vocabulary.
export enum SyncPhaseUi {
    idle,
    syncing,
    offline,
    failed,
}

// The role-consuming text primitive (§3.2's consumption side): the
// only component allowed to bind font attributes, because it lives in
// the theme module. Widgets/compositions compose this instead of
// naming fonts — the lint's rule 2 stays total.
export component RoleText inherits Text {
    in property <TextRole> role: Typography.body;
    in property <color> text-color: Theme.text-primary;
    in property <TextHorizontalAlignment> text-halign: left;
    font-size: role.size;
    font-weight: role.weight;
    font-family: role.family;
    color: text-color;
    horizontal-alignment: text-halign;
}
