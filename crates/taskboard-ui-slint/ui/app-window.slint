// Re-export the globals so the generated Rust module exposes them
// (mount/adapter read/write them through the generated accessors).
export { Theme, Typography, Semantic, Responsive, TooltipState, MenuPanelFacts, StatusPanelFacts, StatusPanelData, StatusPanelPosture, SettingsScrollFacts, SettingsBoardFacts, DragState, FocusScrollHint, FocusFacts, MaskWalkFacts, ScrollPageHint, EditingFacts, EditorScope, TaskViewWalkFacts, TrackPanelFacts, TrackPanelWalkFacts, DropdownConsumer, DropdownFacts, DropdownLadder, TimeFieldFacts, TodayAnchorFacts, TimerSetterFacts, HabitPauseFacts, HabitQuotaFacts, TodayViewport, TodayClipFacts, TodayLayoutFacts, TryRefocus }
export { ReviewWalkModel, DialogButtonModel, DialogButtonRole }
export { BoardBarModel, BoardSegmentModel, BoardBarFacts }
export { SettingsBoardCopy }

export enum KeyFeedback {
    none,
    prefix-pending,
    prefix-abort,
}

// The one view tree's conditional-mount selector (D7; the Rust side
// owns the ViewId cycle and mirrors it here).
export enum View {
    today,
    board,
    stack-detail,
    task-detail,
    // The review/statistics surface (#214): desktop-only by routing —
    // the kiosk rotation maps Board/Today only.
    review,
    settings,
    // The plan-next-day surface (#622): desktop-only by routing
    // (the kiosk rotation maps Board/Today only).
    plan-next-day,
    // The status panel (OP3 W-1): the read-only diagnostics surface,
    // reachable from the action menu on desktop and kiosk alike (D-5).
    status,
}

// The keymap layer's window-facing state (D18), pushed one-way from
// the shell.
export global KeyboardState {
    // The vi insert mode (D10: ordinary shell state).
    in-out property <bool> vi-insert: false;
    in-out property <bool> menu-open: false;
    in-out property <int> menu-selected-index: 0;
    // The two-tier menu (round-1 D6): the root page's cursor, the
    // open group as the parent row's root-page index (−1 = root), and
    // the active group's page. `menu-entries` keeps the root page.
    in-out property <int> menu-root-selected-index: 0;
    in-out property <int> menu-active-group: -1;
    in-out property <[MenuEntryModel]> menu-submenu-entries: [];
    in-out property <[MenuEntryModel]> menu-entries: [];
    // The task context menu's quick bar (UX-R8 chunk-5 D-2): empty
    // for every other menu consumer (an empty model renders nothing).
    in-out property <[QuickBarEntryModel]> menu-quick-bar: [];
    // The context menu's pointer anchor (round-1 D13): the card menu
    // opens at the pointer; the hamburger anchor is the default.
    in-out property <bool> menu-pointer-anchored: false;
    in-out property <length> menu-pointer-x: 0;
    in-out property <length> menu-pointer-y: 0;
    // The §5.7 status signal: prefix-pending / prefix-abort feedback.
    in-out property <KeyFeedback> last-feedback: KeyFeedback.none;
    // The picker grid's focus mirror (round-3 D25): the adapter
    // pushes the shell fact; the harness chain reads it.
    in-out property <bool> date-picker-grid: false;
    // The undo branch picker (UF2, #353): the mount bit and the two
    // row models (the adapter pushes; the composition renders).
    in-out property <bool> undo-picker-open: false;
    in-out property <[UndoPickerRowModel]> undo-picker-branch-rows: [];
    in-out property <[UndoPickerRowModel]> undo-picker-target-rows: [];
    // The keyboard cursor (#1227): the picker-scoped selection index
    // (the shell's cursor machinery, keyed by the mount flag).
    in-out property <int> undo-picker-cursor: 0;
}

// The Q15 startup-warning state (rendered by the status bar).
export global UiStatus {
    in-out property <int> startup-keymap-findings: 0;
}

export component AppWindow inherits Window {
    // The board color strip (UX R-4 D-1, #791): the mount flag, the
    // shared palette, and the current color's ring index — all
    // pushed per pass (the models push's halves).
    in-out property <bool> board-color-strip-open: false;
    in-out property <[color]> board-color-swatches: [];
    in-out property <int> board-color-strip-selected: -1;

    background: Theme.background;
    title: "taskboard";
    preferred-width: Theme.window-default-width;
    preferred-height: Theme.window-default-height;
    // Round-1 D15: scale-aware minimum floors — the compact layout
    // stays usable at 480·scale wide, 400·scale tall. No `width:` or
    // `height:` binding may appear anywhere on the Window (the
    // review invariant; winit rejects resizes below the floors).
    min-width: 480px * Theme.base-scale;
    min-height: 400px * Theme.base-scale;
    // The severing cap (#1378, D-1378): the Window's own layout merge
    // is the last merge point the `ui/views/` census boundary cannot
    // see — a bounded-max row reaching this root's merge would clamp
    // the OS window's max size once mounted (the #778/#1197/#1251
    // class). Witnessed by `app_window_max_probe_tests`.
    max-width: Theme.layout-severing-max-width;

    // ---- The one-way model push surface (D2: models in, indices
    //      back — no ids cross the seam). ---------------------------
    in-out property <TodayModel> today-model;
    // The plan-next-day surface (#622): the two-pane ritual's model —
    // boxes first, then the pool; the placement form's mirrors are
    // adapter-held (D9 rule 1).
    in-out property <PlanModel> plan-model;
    // The placement form's text mirrors (#622): adapter-held, the
    // pass never writes them (D9 rule 4).
    in-out property <string> plan-time-text;
    in-out property <string> plan-effort-text;
    callback plan-box-activated(int);
    callback plan-pool-activated(int);
    callback plan-box-earlier(int);
    callback plan-box-later(int);
    callback plan-box-remove(int);
    callback plan-time-edited(string);
    callback plan-effort-edited(string);
    callback plan-place-commit();
    callback plan-place-cancel();
    in-out property <string> toolbar-title;
    in-out property <int> toolbar-inbox-count: 0;
    // The view switcher's pushed index (round-3 D22; contract
    // [Board, Today] — see toolbar.slint).
    in-out property <int> switcher-index: 0;
    in-out property <[string]> toolbar-menu-hint;
    // The nav.focus-board binding (round-1 D12; a keymap projection).
    in-out property <[string]> nav-back-hint;
    // The board.select / task.edit hints (round-1 D21b/D8; keymap
    // projections pushed per refresh).
    in-out property <[string]> board-segment-hint;
    in-out property <[string]> task-card-hint;
    // The stack.wider binding hint for the header tooltips (D18).
    in-out property <[string]> stack-header-hint;
    // The stack.create binding hint for the add-column tooltip (r2 D6).
    in-out property <[string]> stack-create-hint;
    // The task.create binding hint for the add-task ghost tooltips
    // (r3 D3).
    in-out property <[string]> task-create-hint;
    // The task view's done/tracking header hints (r4 D16b/D16c;
    // keymap projections pushed per refresh).
    in-out property <[string]> task-done-hint;
    in-out property <[string]> task-track-hint;
    // The closed title's activation binding (r4 D21; pushed per
    // refresh — never hand-written).
    in-out property <[string]> task-title-edit-hint;
    // The entries opener's + effort row's projections (J3 US-4,
    // round 9 chunk 11; pushed per refresh).
    in-out property <[string]> task-entries-hint;
    in-out property <[string]> task-effort-hint;
    in-out property <View> current-view: View.board;
    // The review surface (#214): the whole model arrives from the
    // push pass; the kiosk gate empties it model-side.
    in-out property <ReviewModel> review-model;
    // The journal ledger's editor + staged delete (T-15, #798): the
    // review view's facts, forwarded to the seams.
    in-out property <bool> reflection-editor-open: false;
    in-out property <string> reflection-editor-text-echo: "";
    in-out property <string> reflection-editor-mood-echo: "";
    in-out property <string> reflection-editor-energy-echo: "";
    in-out property <FieldValidity> reflection-editor-mood-validity: FieldValidity.neutral;
    in-out property <FieldValidity> reflection-editor-energy-validity: FieldValidity.neutral;
    in-out property <[ReflectionFlagChip]> reflection-editor-flags-model;
    in-out property <bool> reflection-remove-armed: false;
    pure callback reflection-row-activated(int);
    pure callback reflection-editor-text-edited(string);
    pure callback reflection-editor-mood-edited(string);
    pure callback reflection-editor-energy-edited(string);
    pure callback reflection-editor-flag-toggled(int);
    pure callback reflection-editor-committed();
    pure callback reflection-editor-cancelled();
    pure callback reflection-remove-clicked(int);
    pure callback reflection-remove-confirmed(int);
    pure callback reflection-remove-cancelled();
    // The settings seams (round-1 chunk 3, D6.6/D7/D9).
    // slint: status-panel-refresh — the Refresh control's re-query
    // (OP3 W-1, US-1/S4): keyboard-reachable, never a timer.
    callback status-panel-refresh();
    // slint: status-fields-folded — the settled reply's fold (OP3
    // W-2): the adapter invokes it Rust-side; the body writes the
    // typed data and clears the busy posture.
    callback status-fields-folded(StatusPanelData);
    status-fields-folded(d) => {
        StatusPanelFacts.data = d;
        StatusPanelFacts.busy = false;
        StatusPanelFacts.failure = false;
    }
    // slint: status-failure-shown — the dropped reply's typed failure
    // posture (OP3 W-3, US-1/S3): never a blank panel; Refresh stays
    // available.
    callback status-failure-shown();
    status-failure-shown() => {
        StatusPanelFacts.failure = true;
        StatusPanelFacts.busy = false;
    }
    // -- The status panel's remediation lane (the D2 command plan
    //    W-1..W-4/W-6): the rows' arm seams, the armed strip's pair,
    //    and the outcome fold. Underscore names (the seam census's
    //    manifest spelling); the adapter installs each. --
    // slint: status_holder_kill — the Kill holder row's arm moment.
    pure callback status_holder_kill();
    // slint: status_lock_force_unlock — the Force unlock row's arm
    // moment.
    pure callback status_lock_force_unlock();
    // slint: status_daemon_restart — the Restart daemon row's arm
    // moment.
    pure callback status_daemon_restart();
    // slint: status_remediation_armed — the armed strip's decision
    // pair: `decision` 0 = Confirm (the armed verb's exact dispatch),
    // 1 = Cancel (nothing dispatched).
    pure callback status_remediation_armed(int);
    // slint: status_remediation_outcome_shown — the W-6 display fold:
    // the reply drain invokes it when the typed outcome settles; the
    // handler folds the stashed outcome into the panel's facts (the
    // export-outcome-shown twin).
    callback status_remediation_outcome_shown();
    status_remediation_outcome_shown() => {
        StatusPanelFacts.remediation-busy = false;
    }
    callback settings-back-clicked();
    callback settings-field-edited(int, string);
    callback settings-save-clicked(string, string, string);
    callback settings-remove-clicked(int);
    // The armed strips' pair (UX R-2 D-4, #787): Confirm routes the
    // armed subject's exact request (the armed ItemAddr types the
    // verb), Cancel disarms — the seam comments carry the contract.
    callback settings-remove-confirmed(int);
    callback settings-remove-cancelled();
    callback settings-files-action-confirmed(int);
    callback settings-files-action-cancelled();
    callback settings-refresh-clicked(int);
    callback settings-remote-bind-picked(int, int);
    callback settings-publish-picked(int, int);
    // The Files roster's per-row action seam (round-7 D-7.3, W-3).
    callback settings-files-board-action-clicked(int);
    // slint: settings-files-board-restore-clicked (US-6, D-7)
    callback settings-files-board-restore-clicked(int);
    callback settings-create-clicked(int);
    callback settings-disconnect-clicked(int);
    callback settings-files-picked(int, int);
    callback settings-preset-picked(int);
    callback settings-theme-picked(int);
    callback settings-view-mounted();
    callback settings-scale-committed(string);
    callback settings-scale-focus-lost();
    // The settings editor's general seams (the GUI settings editor).
    callback settings-general-committed(int, string);
    // The Files row's poll cadence commit seam (#1083, W-6): the
    // plan row's own callback address, window-level.
    callback files-poll-secs-committed(int, string);
    callback settings-general-focus-lost(int);
    callback settings-reminders-picked(int);
    callback settings-sink-picked(int);
    // The [focus] section's pick seams (the focus settings editor,
    // #625).
    callback settings-focus-enabled-picked(int);
    callback settings-focus-chain-picked(int);
    callback settings-focus-notify-picked(int);
    in-out property <BoardModel> board-model;
    in-out property <BoardBarModel> board-bar-model;
    in-out property <StackDetailModel> stack-model;
    in-out property <TaskDetailModel> task-model;
    // The habit editor's pushed half (H4 D5): the sibling model the
    // variant's rows read (the mount discriminator gates the view).
    in-out property <HabitDetailModel> habit-model;
    in-out property <SyncBadgeModel> sync-model;
    in-out property <[BannerRowModel]> banner-model;
    in-out property <int> banner-overflow;
    // The in-app notification surface (R3 chunk C): desktop-only —
    // the kiosk's model-side gate (R3.5.3) keeps these empty.
    in-out property <[NotificationRowModel]> notification-model;
    // The notification walk's pushed selection (US-6/W-6, D-N1):
    // the adapter writes the clamped cursor; the surface renders the
    // highlight (the walk's row look).
    in-out property <int> notification-selected: -1;
    in-out property <int> notification-overflow;
    // The timers surface (DR-3/3, D-I6): the today view's section +
    // the status-bar chip. Desktop-only — the kiosk gate empties the
    // model and forces the visibility flags false model-side.
    in-out property <bool> timers-visible: false;
    // The kiosk absence hint (UX R-1 D-2, #790): the timers section's
    // muted-caption display flag (display state only, never a command).
    in-out property <bool> timers-absence-hint: false;
    in-out property <[TimerRowModel]> timers-model;
    // The break-rule subsection (T-14, #797): the roster rows, the
    // create form's state, and the staged remove's seams — the
    // timers surface's declarations, forwarded to the today view.
    in-out property <[BreakRuleRowModel]> break-rules-model;
    in-out property <bool> break-create-open: false;
    in-out property <FieldValidity> break-threshold-validity: FieldValidity.neutral;
    in-out property <string> break-threshold-error-hint: "";
    pure callback timers-break-create-toggled();
    pure callback timers-break-create-accepted(string, string, bool) -> bool;
    pure callback timers-break-threshold-edited(string);
    pure callback timers_break_remove_clicked(int);
    pure callback timers_break_remove_confirmed(int);
    pure callback timers_break_remove_cancelled();
    // The habits section (DR-6/6): the active board's tracker rows —
    // rendering is not kiosk-gated, the affordances are.
    in-out property <[HabitCardModel]> habits-model;
    in-out property <bool> habits-editing-enabled: false;
    // The create flow (round-7 D-7.2): the affordance's mount gate
    // (desktop + active board, model-side) and the armed form's
    // adapter-owned flag + quota validity — no transient UI state.
    in-out property <bool> habits-create-mountable: false;
    in-out property <bool> habits-create-open: false;
    // The pause editor's mount flag (HF1, W-3): adapter-owned, pushed
    // per pass (the create-open twin).
    in-out property <bool> habits-pause-open: false;
    in-out property <bool> habits-pause-mountable: false;
    // The deleted-habits restore section (#1290/#1245): the roster
    // rows, armed mirrors, and seams — pushed per pass, verbatim.
    in-out property <[string]> habits-deleted-rows;
    in-out property <bool> habits-has-deleted: false;
    in-out property <int> habits-restore-armed-index: -1;
    in-out property <bool> habits-restore-all-armed: false;
    in-out property <FieldValidity> habits-quota-validity: FieldValidity.neutral;
    in-out property <string> habits-quota-error-hint: "";
    in-out property <int> timers-awaiting: 0;
    in-out property <bool> timers-chip-visible: false;
    in-out property <string> timers-chip;
    // The resurrect notice (#130): a transient, passive status line —
    // default invisible (no prompt; kiosk/daemon never block).
    in-out property <bool> notice-visible: false;
    in-out property <string> notice-text;
    // The tracking chip (DR-5/4, D-T16): display visible on kiosk
    // too; the stop affordance's flag is the model-side gate.
    in-out property <bool> tracking-chip-visible: false;
    in-out property <string> tracking-chip;
    in-out property <bool> tracking-chip-action-visible: false;
    // The OS-delivery health chip (round-3 chunk 7, D31): visible
    // while the last delivery attempt failed (a later success clears
    // it model-side — a state of the world, never a timer).
    in-out property <bool> delivery-chip-visible: false;
    in-out property <string> delivery-chip;
    // The files-sync chip (DR-8 chunk 4, D-FH5): fed at mount/drain
    // beside the delivery chip; default hidden (no actor at boot).
    in-out property <bool> files-sync-visible: false;
    in-out property <string> files-sync-text;
    in-out property <FilesSyncChipState> files-sync-state;
    // slint: files-sync-tone / files-sync-flagged (US-1 D-1, #782)
    in-out property <FilesSyncChipTone> files-sync-tone;
    in-out property <bool> files-sync-flagged;
    // The degraded-boot badge (the small-gated journeys plan W-7,
    // R-5): display-only, persistent — set by the adapter's
    // signal-lane pass, never cleared in-session, no dismiss.
    in-out property <bool> journal-degraded-visible: false;
    // The jump-to search palette (#348): the model rows arrive ranked,
    // anchor-filtered, and capped from the Rust pass.
    in-out property <bool> palette-open: false;
    // The quick-capture overlay (chunk 10 D8).
    in-out property <bool> capture-open: false;
    // The habit history dialog's mount bit + pushed model (HF3 W-8,
    // US-7/S1): read role, desktop-only (R-3 — the kiosk never arms
    // the mount); pure projection, zero commands.
    in-out property <bool> habit-history-open: false;
    in-out property <HabitHistoryModel> habit-history;
    // The recur editor's window-level mount bit + pushed model
    // (round-7 D-7.1): the adapter owns both; the overlay mounts
    // exactly while Flow::EditRecur holds.
    in-out property <bool> recur-editor-open: false;
    // The refused-commit mirror (#1221): set by the commit funnel's
    // re-check rejection (the commit button and the outside-click
    // accept share the seam), cleared on any draft edit and on close.
    in-out property <bool> recur-draft-invalid: false;
    in-out property <RecurEditorModel> recur-editor-model;
    // The export dialog's window-level mount bit + pushed model (the
    // J2 export plan W-1..W-5). The mount bit is adapter-minted (the
    // ActionId::ExportDialogOpen route and the Settings row's seam);
    // a kiosk hand-over never mints it (R-2).
    in-out property <bool> export-dialog-mounted: false;
    in-out property <ExportDialogModel> export-model;
    // The dialog's seams (W-3/W-4/W-5): the pickers'/fields' mirrors,
    // the Run dispatch, and the close (Escape's ladder lands here —
    // nothing dispatches, the pending reply drops).
    // slint: export-dialog-open / export-dialog-close — the W-1 mount
    // pair: the open callback is the window-level entry-point front
    // (the adapter routes the same action the menu item and the
    // Settings row drive); the close is the dismissal seam.
    pure callback export-dialog-open();
    pure callback export-spec-picked(int, int);
    pure callback export-field-edited(int, string);
    pure callback export-open-after-toggled();
    // slint: export-run — the W-4 Run dispatch seam.
    pure callback export-run();
    // -- The preview/clipboard lane (the D2 preview plan W-1..W-4):
    //    underscore names (the seam census's manifest spelling). --
    // slint: export_preview — the Preview dispatch (D-4: never
    // ExportRun; the per-affordance busy flag is its own).
    pure callback export_preview();
    // slint: export_clipboard_copy — the Copy dispatch (D-3: the
    // payload regenerates app-side).
    pure callback export_clipboard_copy();
    // slint: export_preview_shown — the settled preview/copy reply's
    // display fold: the drain invokes it outside the adapter borrow
    // (the re-entrancy law).
    pure callback export_preview_shown();
    // slint: export_preview_gated — the D-5 family-gating fold: the
    // pane and its outcome clear when the family pick leaves the
    // csv/json leg (the gating is a fold flag, never hidden lanes).
    pure callback export_preview_gated();
    pure callback export-dialog-close();
    // slint: export-outcome-shown — the W-5 display fold: the reply
    // drain invokes it when the typed outcome settles; the handler
    // folds the settled outcome into the dialog's model.
    pure callback export-outcome-shown();
    // The Settings view's Export row (W-2): the same mount arm the
    // action routes.
    pure callback export-settings-open();
    // The dialog's outcome notification: the model's outcome fold
    // crossing into the rendered fact re-arms the observation seam;
    // the preview pane's gating fold (the D-5 family swap) re-arms
    // its own seam the same way.
    changed export-model => {
        if (root.export-model.outcome-kind != 0) {
            root.export-outcome-shown();
        }
        if (!root.export-model.preview-enabled) {
            root.export_preview_gated();
        }
        if (root.export-model.preview-settled) {
            root.export_preview_shown();
        }
    }
    in-out property <string> capture-initial-text;
    in-out property <int> palette-selected-index: 0;
    in-out property <[PaletteRowModel]> palette-model: [];
    in-out property <int> palette-overflow: 0;
    // The review walk overlay (DR-7 chunk 3, #638): the whole model
    // arrives from the Rust pass (the dumb client); the kiosk gate
    // empties it model-side.
    in-out property <ReviewWalkModel> walk-model;
    // The prompts' one-shot answer seeds (the mount-transition push).
    in-out property <[string]> walk-answer-seeds: [];
    // The prompts' rating drafts (#1431): the seeds and validity
    // flavours mirror the adapter-side drafts (the T-15 grammar).
    in-out property <string> walk-mood-seed: "";
    in-out property <string> walk-energy-seed: "";
    in-out property <FieldValidity> walk-mood-validity: FieldValidity.neutral;
    in-out property <FieldValidity> walk-energy-validity: FieldValidity.neutral;
    pure callback walk-rating-edited(int, string);
    // The walk's seams: scrim, the row verbs (cursor row only), the
    // armed picker and date field, the prompt mirrors, and the commit
    // exits.
    // The abort ladder's seams (J4 D-6): the host's outside click
    // arms (Entry closes silently); the confirm's two buttons.
    callback walk-abort-arm-requested();
    callback walk-abort-accept-clicked();
    callback walk-abort-dismiss-clicked();
    // The dialog button row (D-5): the pushed intent code dispatches
    // the walk verb the pass mapped it to.
    callback walk-button-invoked(int);
    // The embedded planner choice (J4 US-3/S1).
    callback walk-plan-clicked();
    callback walk-file-clicked();
    callback walk-keep-clicked();
    callback walk-file-prev-clicked();
    callback walk-file-next-clicked();
    callback walk_candidate_activated(int);
    callback walk-file-commit-clicked();
    callback walk-tomorrow-clicked();
    callback walk-pick-clicked();
    callback walk-leave-clicked();
    callback walk-date-edited(string);
    callback walk-date-commit-clicked();
    callback walk-answer-edited(int, string);
    callback walk-record-clicked();
    callback walk-finish-clicked();
    // The today view's surfacing card (DR-7 D-J10): at most one, the
    // whole copy arrives pushed (the phrase fns' output); kiosk never
    // receives it (the model-side gate).
    in-out property <bool> review-card-visible: false;
    in-out property <string> review-card-title;
    in-out property <string> review-card-body;
    in-out property <string> review-card-action;
    callback review-card-clicked();
    // The concentration overlay (#496): the derived frame values and
    // the switcher arrive from the Rust pass (the dumb client); the
    // callbacks route the landed tracking verbs and the capture
    // commit.
    in-out property <bool> focus-overlay-open: false;
    in-out property <string> focus-phase-text;
    in-out property <string> focus-remaining-text;
    in-out property <string> focus-task-title;
    in-out property <[FocusRowModel]> focus-switcher-model: [];
    in-out property <int> focus-switcher-selected: 0;
    in-out property <string> focus-note-initial-text;
    in-out property <FlowHintModel> flow-hint-model;
    // The board create/rename fields' window-level slot (r2 D21):
    // one mount site covers every breakpoint, the empty-board leg,
    // and the vi-from-settings exposure. `board-flow-initial` is the
    // seeded buffer (the mount-only initial-text rule).
    in-out property <bool> board-create-open: false;
    // The pointer drag-to-move's open flag (r2 chunk-8 D-D): mounts
    // the ghost; pushed by the models pass while the drag flow holds
    // (refresh-survival by construction).
    in-out property <bool> board-drag-open: false;
    // Any flow holds on the board (the drag arm's XOR belt); pushed
    // by the models pass.
    in-out property <bool> board-flow-open: false;
    in-out property <bool> board-rename-open: false;
    in-out property <string> board-flow-initial;
    // The armed board-delete strip's fact (UX R-2 D-2, #784): the
    // view state's `Flow::ConfirmDelete` arms the board — the strip
    // mounts in the board-bar region; pushed by the models pass.
    in-out property <bool> board-delete-armed: false;
    // The armed board-ceremony letter's fact (OP1, W-2/W-4/W-7): the
    // letter's mode gates the ceremony strip's mount (archive caption
    // / reset counts / reconcile preview / pending — the typed fold).
    in-out property <CeremonyLetterModel> ceremony-letter;
    // The letter's confirm/cancel pair (one pair, three ceremonies —
    // the armed subject is surface-wide; the adapter routes per flow).
    pure callback board-ceremony-confirmed();
    pure callback board-ceremony-cancelled();

    // The rendering fact for tests and reviews (§6 test 2): compact
    // mode is active (board degeneration, D8/D17).
    out property <bool> compact-active: Responsive.current-breakpoint == Breakpoint.compact;
    // The window dims in logical px (round-1 D10): the Rust placement
    // reads them.
    out property <float> window-w: root.width / 1px;
    out property <float> window-h: root.height / 1px;
    // The window height as a length (the #373 today section bound's
    // base; a token-lint-clean length source for markup consumers).
    out property <length> window-height: root.height;
    // The today page's viewport-height push (#1310/#1304, the
    // TodayViewport global's writer): init covers the first frame,
    // the watch covers resizes. An assignment, never a binding — the
    // binding-coupled cap closes the section clip's layout-info
    // loop (see the global's comment in today-view.slint).
    property <length> watch-today-viewport: root.height;
    changed watch-today-viewport => {
        TodayViewport.height = root.height;
    }
    // The today layout arm's width push (#1436, the TodayViewport
    // height precedent): the arm's measurement input assigned, never
    // bound — the declarative width→arm spelling at the view root is
    // a layout-info binding loop (see the global's comment in
    // today-view.slint). Init covers the first frame, the watch
    // covers resizes.
    property <length> watch-today-width: root.width;
    changed watch-today-width => {
        TodayLayoutFacts.viewport-width = root.width;
    }
    // The rendering fact the menu sizing (usability D6) and the
    // tooltip flip (D3) are proved against: the status bar's top edge
    // in window coordinates (the inner layouts sit at the origin).
    out property <length> status-top: status.y;

    // The single key path (§5.1): capture-phase tunneling hits this
