                reflection-remove-cancelled() => root.reflection-remove-cancelled();
            }
            if (root.current-view == View.task-detail): TaskView {
                task: root.task-model;
                habit: root.habit-model;
                nav-back-hint: root.nav-back-hint;
                task-done-hint: root.task-done-hint;
                task-title-edit-hint: root.task-title-edit-hint;
                task-track-hint: root.task-track-hint;
                task-entries-hint: root.task-entries-hint;
                task-effort-hint: root.task-effort-hint;
                title-committed(t) => root.task-title-committed(t);
                title-edited(t) => root.task-title-edited(t);
                title-edit-opened() => root.task-title-edit-activated();
                text-flow-focus-lost() => root.text-flow-focus-lost();
                back-clicked() => root.task-back-clicked();
                habit-title-edited(t) => root.habit-title-edited(t);
                habit-description-edited(t) => root.habit-description-edited(t);
                habit-quota-kind-picked(i) => root.habit-quota-kind-picked(i);
                habit-quota-count-edited(t) => root.habit-quota-count-edited(t);
                habit-time-edited(t) => root.habit-time-edited(t);
                habit-time-cleared() => root.habit-time-cleared();
                habit-weekday-picked(i) => root.habit-weekday-picked(i);
                habit-month-day-edited(t) => root.habit-month-day-edited(t);
                habit_schedule_day_toggled(i, c) => root.habit_schedule_day_toggled(i, c);
                habit_reminder_base_picked(i) => root.habit_reminder_base_picked(i);
                habit_reminder_offset_edited(t) => root.habit_reminder_offset_edited(t);
                habit_reminder_time_edited(t) => root.habit_reminder_time_edited(t);
                habit_reminder_snooze_edited(t) => root.habit_reminder_snooze_edited(t);
                habit_reminder_clear_clicked() => root.habit_reminder_clear_clicked();
                habit_save_clicked() => root.habit_save_clicked();
                habit-editor-cancelled() => root.habit-editor-cancelled();
                habit-history-clicked() => root.habit-editor-history-clicked();
                rule-remove-clicked(i) => root.task-rule-remove-clicked(i);
                rule-row-clicked(i) => root.task-rule-row-clicked(i);
                rules-clearable: root.rules-clearable;
                rules-clear-count: root.rules-clear-count;
                rule-clear-armed: root.rule-clear-armed;
                rules-clear-asked() => root.rules-clear-asked();
                rules-clear-cancelled() => root.rules-clear-cancelled();
                rule-add-preset-clicked(i) => root.rule-add-preset-clicked(i);
                rule-add-custom-accepted(t) => root.rule-add-custom-accepted(t);
                due-edit-opened() => root.task-due-edit-opened();
                scheduled-edit-opened() => root.task-scheduled-edit-opened();
                description-edit-opened() => root.task-description-edit-opened();
                description-edited(t) => root.task-description-edited(t);
                description-committed(t) => root.task-description-committed(t);
                date-edited(t) => root.task-date-edited(t);
                date-accepted(t) => root.task-date-accepted(t);
                date-picker-toggled() => root.task-date-picker-toggled();
                date-editor-focus-lost() => root.date-editor-focus-lost();
                rule-offset-edited(t) => root.rule-offset-edited(t);
                rule-unmute-clicked() => root.task-rule-unmute-clicked();
                rule-jump-to-due-clicked() => root.task-rule-jump-to-due-clicked();
                // The recur row (issue #506).
                series-edit-asked() => root.series-edit-asked();
                recur-pause-asked() => root.task-recur-pause-asked();
                recur-pause-accepted(t) => root.task-recur-pause-accepted(t);
                recur-pause-cancelled() => root.task-recur-pause-cancelled();
                recur-resume-clicked() => root.task-recur-resume-clicked();
                recur-convert-asked() => root.task-recur-convert-asked();
                recur-convert-confirmed() => root.task-recur-convert-confirmed();
                recur-convert-cancelled() => root.task-recur-convert-cancelled();
                task-track-start-clicked() => root.task-track-start-clicked();
                task-track-stop-clicked() => root.task-track-stop-clicked();
                task-track-entries-clicked() => root.task-track-entries-clicked();
                task-done-toggled() => root.task-done-toggled();
                task-track-toggled() => root.task-track-toggled();
                // The priority pickers (UX R-3 D-1, #788) and the
                // labels section's seams (D-2, #789).
                importance-edit-asked() => root.task-importance-edit-asked();
                urgency-edit-asked() => root.task-urgency-edit-asked();
                priority-slot-clicked(i) => root.priority-slot-clicked(i);
                priority-dismiss-requested() => root.priority-dismiss-requested();
                chip-unassign-clicked(i) => root.chip-unassign-clicked(i);
                labels-manage-asked() => root.labels-manage-asked();
                effort-edited(t) => root.task-effort-edited(t);
                effort-committed() => root.task-effort-committed();
                effort-focus-lost() => root.task-effort-focus-lost();
            }

            // The board create/rename fields (r2 D21): the
            // window-level slot below the views — visible while the
            // flow is open at every breakpoint; Return commits,
            // Escape routes mode.normal (the discard arm).
            if (root.board-create-open): TextField {
                placeholder: "New board name";
                label: "New board name";
                commit-affordance: true;
                accepted(text) => root.board-create-field-committed(text);
                edited(text) => root.board-create-field-edited(text);
                focus-lost() => root.text-flow-focus-lost();
            }
            if (root.board-rename-open): TextField {
                placeholder: "Board name";
                label: "Board name";
                initial-text: root.board-flow-initial;
                selected-on-focus: true;
                accepted(text) => root.board-rename-field-committed(text);
                edited(text) => root.board-rename-field-edited(text);
                focus-lost() => root.text-flow-focus-lost();
            }

            // The notification surface sits above the status bar, on
            // every view — it is the universal dismissal surface
            // (design D-10), while the overdue banner stays board
            // truth below it. Mounted only while rows exist: no
            // silent chrome in an empty state.
            if (root.notification-model.length > 0): NotificationSurface {
                notifications: root.notification-model;
                selected-index: root.notification-selected;
                notification-overflow: root.notification-overflow;
                dismiss-clicked(i) => root.notification-dismiss-clicked(i);
                done-clicked(i) => root.notification-done-clicked(i);
                snooze-span-picked(row, span) => root.notification-snooze-span-picked(row, span);
                mute-clicked(i) => root.notification-mute-clicked(i);
                cancel-clicked(i) => root.notification-cancel-clicked(i);
                track-start-clicked(i) => root.notification-track-start-clicked(i);
                row-open-requested(i) => root.notification-row-open-requested(i);
            }

            status := StatusBar {
                sync: root.sync-model;
                startup-findings: UiStatus.startup-keymap-findings;
                banner: root.banner-model;
                banner-overflow: root.banner-overflow;
                flow-hint: root.flow-hint-model;
                timers-chip-visible: root.timers-chip-visible;
                timers-chip: root.timers-chip;
                notice-visible: root.notice-visible;
                notice-text: root.notice-text;
                tracking-chip-visible: root.tracking-chip-visible;
                tracking-chip: root.tracking-chip;
                tracking-chip-action-visible: root.tracking-chip-action-visible;
                delivery-chip-visible: root.delivery-chip-visible;
                delivery-chip: root.delivery-chip;
                files-sync-visible: root.files-sync-visible;
                files-sync-text: root.files-sync-text;
                files-sync-state: root.files-sync-state;
                files-sync-tone: root.files-sync-tone;
                files-sync-flagged: root.files-sync-flagged;
                journal-degraded-visible: root.journal-degraded-visible;
                snooze-clicked(i) => root.banner-snooze-clicked(i);
                mute-clicked(i) => root.banner_mute_clicked(i);
                row-activated(i) => root.banner-row-activated(i);
                row-open-requested(i) => root.banner-row-open-requested(i);
                timers-chip-clicked() => root.timers-chip-clicked();
                tracking-stop-clicked() => root.tracking-chip-stop-clicked();
            }
        }

            // M1 (overlay migration): the due/scheduled editor as a
            // true overlay on the AnchoredOverlayHost base — the
            // in-flow DueEditor swap is dead, so opening shifts no
            // sibling (the R-7 law). The anchor rides the
            // `DatePickerFacts` global (the click-time push + the
            // keep-alive mirrors in the view). The D-3 edit-kind law:
            // an outside click resolves to save — the same settle
            // funnel the field's focus loss rides.
            if (root.current-view == View.task-detail
                    && (root.task-model.due-open || root.task-model.scheduled-open)):
            editor-overlay := AnchoredOverlayHost {
                open: true;
                anchor-x: DatePickerFacts.anchor-x;
                anchor-y: DatePickerFacts.anchor-y;
                anchor-width: DatePickerFacts.anchor-width;
                anchor-height: DatePickerFacts.anchor-height;
                viewport-width: root.width;
                viewport-floor: status.y;
                panel-preferred-width: Theme.panel-width;
                walk-stops: 1;
                dismissed => root.date-editor-focus-lost();
                // The picker-anchor keep-alive (#1206, the #954 idiom
                // on the host's `panel-*` out seams): while the editor
                // overlay is mounted — exactly when the picker can
                // open — its realized panel rect publishes as the M2
                // mount's anchor, so the picker never covers the
                // editor panel (G-2 does the guarantee). The window
                // fills the host, so the panel rect is window-space.
                AnchorMirror {
                    source-x: editor-overlay.panel-x;
                    source-y: editor-overlay.panel-y;
                    source-width: editor-overlay.panel-width;
                    source-height: editor-overlay.panel-height;
                    published(x, y, w, h) => {
                        DatePickerFacts.picker-anchor-x = x;
                        DatePickerFacts.picker-anchor-y = y;
                        DatePickerFacts.picker-anchor-width = w;
                        DatePickerFacts.picker-anchor-height = h;
                    }
                }
                DueEditor {
                    field-label: root.task-model.due-open ? "Due date entry" : "Start date entry";
                    field-help: root.task-model.due-open
                        ? "The task's deadline. Type a date, a relative offset like +2d, or use the calendar button."
                        : "When work on the task starts. Same typed grammar as the due date.";
                    entry-placeholder: "YYYY-MM-DD or +2d";
                    initial-text: root.task-model.due-open
                        ? root.task-model.due-text
                        : root.task-model.scheduled-text;
                    echo: root.task-model.due-open
                        ? root.task-model.due-echo
                        : root.task-model.scheduled-echo;
                    field-focus-on-mount: root.task-model.date-field-focus;
                    validity: root.task-model.date-validity;
                    syntax-hint: root.task-model.date-syntax-hint;
                    clear-affordance: true;
                    edited(text) => root.task-date-edited(text);
                    accepted(text) => root.task-date-accepted(text);
                    picker-toggled() => root.task-date-picker-toggled();
                    focus-lost() => root.date-editor-focus-lost();
                }
            }
            // M2 (overlay migration): the date-picker overlay on the
            // host — the hand clamp/flip expressions and the
            // dismissal underlay are the host's now. An outside click
            // dismisses the picker only — the editor and its buffer
            // stay armed (the r4 D24 rule keeps its seam). Mounted
            // AFTER the editor overlay, so the picker's underlay
            // receives exactly the clicks neither editor field nor
            // picker panel absorb.
            if (root.current-view == View.task-detail
                    && root.task-model.date-picker-open): AnchoredOverlayHost {
                open: true;
                // The re-anchored picker (#1206): the editor panel's
                // realized rect, not the closed cell — see the M1
                // mirror above.
                anchor-x: DatePickerFacts.picker-anchor-x;
                anchor-y: DatePickerFacts.picker-anchor-y;
                anchor-width: DatePickerFacts.picker-anchor-width;
                anchor-height: DatePickerFacts.picker-anchor-height;
                viewport-width: root.width;
                viewport-floor: status.y;
                panel-preferred-width: Theme.panel-width-slim;
                walk-stops: 1;
                dismissed => root.date-picker-dismiss-requested();
                DatePicker {
                    caption: root.task-model.date-caption;
                    time-text: root.task-model.date-time-text;
                    grid: root.task-model.date-grid;
                    focus-on-mount: root.task-model.date-grid-focus;
                    picker-key(k) => root.task-date-picker-key(k);
                    grid-focus-changed(f) => root.date-picker-grid-focus-changed(f);
                    day-clicked(c) => root.task-date-day-clicked(c);
                    time-validity: root.task-model.date-time-validity;
                    time-error-hint: root.task-model.time-syntax-hint;
                    time-slots: root.task-model.date-time-slots;
                    time-nearest-row: root.task-model.date-time-nearest-row;
                    time-edited(t) => root.task-date-time-edited(t);
                    time-picked(m) => root.task-date-time-picked(m);
                    time-accepted(t) => root.task-date-time-accepted(t);
                    quick-toggled() => root.task-date-quick-toggled();
                    time-field-armed() => root.task-date-time-field-armed();
                }
            }

        // The timers setter popover (r4 D33) on the AnchoredOverlayHost
        // base (round-9 W1, D-W1-3's proof mount): the hand-written
        // clamp/flip expressions and the dismissal layer are the
        // host's now — the site mirrors the anchor facts and wires its
        // seams. Behavior-preserving (the identical below/flip/clamp
        // laws, deduplicated).
        // The habit quota popover (W-5, #961) on the AnchoredOverlayHost
        // base: the timer-setter's exact mount shape — the anchor facts
        // ride the HabitQuotaFacts global (the clicked row's phrase
        // button publishes them through the AnchorMirror), the dismissal
        // (Escape/outside) is the host's, the commit routes through the
        // adapter's trust-boundary seam. Kiosk never mounts: the
        // affordance renders disabled there (R-3) and the opener effect
        // is structurally inert.
        // The habit pause editor's outside-click dismissal (D3a W-7,
        // #1208): the menu-backdrop pattern over a live rect — four
        // light-dismiss strips band the published editor geometry
        // (HabitPauseFacts), so the strips receive exactly the pointer
        // downs the editor's own fields do not absorb. The mount
        // condition is the window's `habits-pause-open` (the layer can
        // never linger); each strip routes the existing
        // habits-pause-cancelled seam — cancel writes nothing (the
        // destructive-role dismissal law).
        if (root.habits-pause-open): TouchArea {
            // above the editor band
            x: 0; y: 0;
            width: root.width;
            height: max(0, HabitPauseFacts.anchor-y);
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.left) {
                    root.habits-pause-cancelled();
                }
            }
        }
        if (root.habits-pause-open): TouchArea {
            // below the editor band
            x: 0;
            y: HabitPauseFacts.anchor-y + HabitPauseFacts.anchor-height;
            width: root.width;
            height: max(0, root.height - self.y);
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.left) {
                    root.habits-pause-cancelled();
                }
            }
        }
        if (root.habits-pause-open): TouchArea {
            // left of the editor, within its band
            x: 0;
            y: HabitPauseFacts.anchor-y;
            width: max(0, HabitPauseFacts.anchor-x);
            height: HabitPauseFacts.anchor-height;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.left) {
                    root.habits-pause-cancelled();
                }
            }
        }
        if (root.habits-pause-open): TouchArea {
            // right of the editor, within its band
            x: HabitPauseFacts.anchor-x + HabitPauseFacts.anchor-width;
            y: HabitPauseFacts.anchor-y;
            width: max(0, root.width - self.x);
            height: HabitPauseFacts.anchor-height;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.left) {
                    root.habits-pause-cancelled();
                }
            }
        }
        if (root.habits-quota-open): AnchoredOverlayHost {
            open: true;
            anchor-x: HabitQuotaFacts.anchor-x;
            anchor-y: HabitQuotaFacts.anchor-y;
            anchor-width: HabitQuotaFacts.anchor-width;
            anchor-height: HabitQuotaFacts.anchor-height;
            viewport-width: root.width;
            viewport-floor: status.y;
            panel-preferred-width: Theme.panel-width-narrow;
            walk-stops: 1;
            dismissed => root.habits-quota-dismissed();
            HabitQuotaEditor {
                count: root.habits-quota-count;
                valid: root.habits-quota-valid;
                kind-phrase: root.habits-quota-kind-phrase;
                stepped(d) => root.habits-quota-stepped(d);
                committed() => root.habits-quota-committed();
            }
        }
        if (root.timer-setter-open): AnchoredOverlayHost {
            open: true;
            anchor-x: TimerSetterFacts.anchor-x;
            anchor-y: TimerSetterFacts.anchor-y;
            anchor-width: TimerSetterFacts.anchor-width;
            anchor-height: TimerSetterFacts.anchor-height;
            viewport-width: root.width;
            viewport-floor: status.y;
            panel-preferred-width: Theme.panel-width-narrow;
            walk-stops: 1;
            dismissed => root.timer-setter-dismiss-requested();
            TimerSetter {
                time-text: root.timer-setter-time-text;
            time-validity: root.timer-setter-time-validity;
            time-hint: root.timer-setter-time-hint;
            time-slots: root.timer-setter-time-slots;
            time-nearest-row: root.timer-setter-time-nearest-row;
            fire-time: root.timer-setter-fire-time;
            commit-enabled: root.timer-setter-commit-enabled;
            focus-nonce: root.timer-setter-focus-nonce;
            day-index: root.timer-setter-day-index;
            insist-index: root.timer-setter-insist-index;
            // slint: timer-setter-preset-picked — the local echo half
            // rides the two-way mirror (the panel's in-out owns the
            // write; the root property only exposes it structurally).
            preset-index <=> root.timer-setter-preset-index;
            preset-picked(index) => root.timer-setter-preset-picked(index);
            quick-toggled() => root.timer-setter-quick-toggled();
            time-edited(t) => root.timer-setter-time-edited(t);
            time-stepped(n) => root.timer-setter-time-stepped(n);
            time-picked(m) => root.timer-setter-time-picked(m);
            day-picked(d) => root.timer-setter-day-picked(d);
            insist-picked(i) => root.timer-setter-insist-picked(i);
                commit-requested(label) => root.timer-setter-commit-requested(label);
                close-requested() => root.timer-setter-dismiss-requested();
            }
        }
    // The overlay's window-level mount (D-TS1): the date-picker's
    // exact pattern — the dismissal layer first (a full-window
    // TouchArea, no visual; the later sibling is hit-tested first),
    // the anchored panel after, both gated on one mount condition
    // (the model's flag over the task-detail view, so the layer can
    // never linger). The panel sits below the anchor button when it
    // fits (above the status bar), else above, clamped into the
    // window — the date-picker's exact `y` expression shape.
    // D-9a (round-9 W6, #954): the last large-panel hand mount joins
    // the overlay-migration family — the hand backdrop and the hand
    // clamp/flip expressions are the host's now (the G-4 probe's law
    // tests assert the host's placed rect equals the retired
    // expressions for arbitrary anchors). The panel's width law
    // (min(viewport - 2·space-2, max(panel preferred, 360·scale)))
    // is the host's law 4 verbatim with the 360·scale preferred
    // floor; the dismissal layer is the host's (routing verbatim:
    // outside click and the right-button down half).
    if (root.current-view == View.task-detail
            && root.task-model.track-entries-open): track-entries-host := AnchoredOverlayHost {
        open: true;
        anchor-x: TrackPanelFacts.anchor-x;
        anchor-y: TrackPanelFacts.anchor-y;
        // No anchor-width fact: the placement law reads the anchor's
        // x/y/height only (the roster singleton carries three arms).
        anchor-width: 0;
        anchor-height: TrackPanelFacts.anchor-height;
        viewport-width: root.width;
        viewport-floor: status.y;
        panel-preferred-width: Theme.menu-max-width;
        walk-stops: 1;
        dismissed => root.track-entries-dismiss-requested();
        TrackEntriesPanel {
        rows: root.task-model.track-entries;
        total: root.task-model.track-entries-total;
        // The form surface's pushed halves (r4 D-TS4) — the
        // adapter-owned mirrors (the TimeField contract: the push
        // re-seeds, the widget never holds state).
        form-open: root.track-form-open;
        form-date-text: root.track-form-date-text;
        form-date-validity: root.track-form-date-validity;
        form-date-hint: root.track-form-date-hint;
        form-grid-open: root.track-form-grid-open;
        form-grid: root.track-form-grid;
        form-grid-focus: root.track-form-grid-focus;
        form-start-text: root.track-form-start-text;
        form-start-validity: root.track-form-start-validity;
        form-start-hint: root.track-form-start-hint;
        form-start-slots: root.track-form-start-slots;
        form-start-nearest-row: root.track-form-start-nearest-row;
        form-end-text: root.track-form-end-text;
        form-end-validity: root.track-form-end-validity;
        form-end-hint: root.track-form-end-hint;
        form-end-slots: root.track-form-end-slots;
        form-end-nearest-row: root.track-form-end-nearest-row;
        row-activated(index) => root.track-entry-row-activated(index);
        delete-clicked(index) => root.track-entry-delete-clicked(index);
        armed-index: root.track-armed-index;
        has-deleted-entries: root.track-has-deleted;
        deleted-entry-rows: root.track-deleted-rows;
        restore-armed-index: root.track-restore-armed-index;
        entry-restore-requested(index) => root.entry-restore-requested(index);
        entry-restore-cancelled() => root.entry-restore-cancelled();
        add-requested() => root.track-form-add-requested();
        date-edited(t) => root.track-form-date-edited(t);
        date-grid-toggled() => root.track-form-grid-toggled();
        date-grid-key(k) => root.track-form-grid-key(k);
        date-day-clicked(c) => root.track-form-day-clicked(c);
        start-quick-toggled() => root.track-form-start-quick-toggled();
        end-quick-toggled() => root.track-form-end-quick-toggled();
        start-edited(t) => root.track-form-start-edited(t);
        start-stepped(n) => root.track-form-start-stepped(n);
        start-picked(m) => root.track-form-start-picked(m);
        end-edited(t) => root.track-form-end-edited(t);
        end-stepped(n) => root.track-form-end-stepped(n);
        end-picked(m) => root.track-form-end-picked(m);
        commit-requested() => root.track-form-commit-requested();
        }
    }

        // M4 (overlay migration): the track form's date grid as a
        // window-level overlay on the host — the panel-embedded grid
        // mount is dead (it grew the form's layout on open, the
        // track-entries sibling of the M1 shift law). The anchor is
        // the form's date row (the click-time push + keep-alives in
        // the composition); a light-dismiss outside click drops the
        // grid only — the form and its mirrors stay. Mounted AFTER
        // the track-entries panel, so the grid's underlay receives
        // exactly the clicks the grid panel does not absorb.
        if (root.current-view == View.task-detail
                && root.task-model.track-entries-open
                && root.track-form-grid-open): track-grid-host := AnchoredOverlayHost {
            open: true;
            anchor-x: TrackPanelFacts.form-grid-anchor-x;
            anchor-y: TrackPanelFacts.form-grid-anchor-y;
            anchor-width: TrackPanelFacts.form-grid-anchor-width;
            anchor-height: TrackPanelFacts.form-grid-anchor-height;
            viewport-width: root.width;
            viewport-floor: status.y;
            panel-preferred-width: Theme.panel-width-slim;
            walk-stops: 1;
            dismissed => root.track-form-grid-dismiss-requested();
            DatePicker {
                show-time: false;
                caption: "";
                grid: root.track-form-grid;
                focus-on-mount: root.track-form-grid-focus;
                picker-key(k) => root.track-form-grid-key(k);
                day-clicked(c) => root.track-form-day-clicked(c);
                // Date-only mount (show-time: false): the TimeField
                // never mounts, so the intra-picker click arm is
                // structurally dead here — the forward is the
                // mount-inventory's totality law, never a live path.
                time-field-armed() => { }
            }
        }

            // The labels overlay's window-level mount (UX R-3 D-2,
            // #789): the track-entries overlay's pattern — the
            // dismissal layer first, the anchored panel after, both
            // gated on one mount condition (the model's flag over
            // the task-detail view, so the layer can never linger).
            // The panel rides centered (the labels overlay owns no
            // anchor button; the modal reads over the whole detail
            // surface).
            // M6 (overlay migration): the labels overlay on the
            // ModalDialogHost base — the hand backdrops/centering are
            // the host's now, both mounts share the one host wiring.
            // The D-3 flip-by-inner-state law: the add/edit form open
            // makes the dialog `edit` (an outside click routes the
            // form-commit seam, validity-gated adapter-side); form
            // closed makes it `confirm` (an outside click dismisses).
            if (root.current-view == View.task-detail
                    && root.task-model.labels-open): ModalDialogHost {
                open: true;
                title: "Labels";
                kind: root.label-overlay-form-open
                    ? DialogKind.edit : DialogKind.confirm;
                body-preferred-width: Theme.menu-max-width;
                // The panel's own walk extent (3 roster stops; the add
                // form's open flip re-arms 6 through the panel's
                // changed watch) — the mount-time value matches the
                // panel's own arm so the ordering never shows 1.
                walk-stops: 3;
                viewport-floor: status.y;
                accepted => root.labels-overlay-form-commit-requested();
                dismissed => root.labels-overlay-dismiss-requested();
                LabelsPanel {
                rows: root.label-overlay-rows;
                form-open: root.label-overlay-form-open;
                form-title: root.label-overlay-form-title;
                form-colour: root.label-overlay-form-colour;
                colour-valid: root.label-overlay-colour-valid;
                colour-preview: root.label-overlay-colour-preview;
                swatches: root.label-overlay-swatches;
                swatch-selected: root.label-overlay-swatch-selected;
                picker-hue: root.label-overlay-picker-hue;
                picker-sat: root.label-overlay-picker-sat;
                picker-val: root.label-overlay-picker-val;
                picker-hue-colour: root.label-overlay-picker-hue-colour;
                armed-index: root.label-overlay-armed-index;
                shows-assignment: root.label-overlay-shows-assignment;
                row-toggled(index) => root.labels-overlay-row-toggled(index);
                dismiss-requested() => root.labels-overlay-dismiss-requested();
                add-requested() => root.labels-overlay-add-requested();
                edit-requested(index) => root.labels-overlay-edit-requested(index);
                title-edited(t) => root.labels-overlay-title-edited(t);
                colour-edited(c) => root.labels-overlay-colour-edited(c);
                swatch-clicked(i) => root.labels-overlay-swatch-clicked(i);
                hue-picked(h) => root.labels-overlay-hue-picked(h);
                sat-val-picked(s, v) => root.labels-overlay-sat-val-picked(s, v);
                form-commit-requested() => root.labels-overlay-form-commit-requested();
                form-cancelled() => root.labels-overlay-form-cancelled();
                delete-clicked(index) => root.labels-overlay-delete-clicked(index);
                delete-cancelled() => root.labels-overlay-delete-cancelled();
                has-deleted: root.label-overlay-has-deleted;
                deleted-rows: root.label-overlay-deleted-rows;
                restore-armed-index: root.label-overlay-restore-armed-index;
                restore-all-armed: root.label-overlay-restore-all-armed;
                label-restore-requested(index) => root.label-restore-requested(index);
                label-restore-cancelled() => root.label-restore-cancelled();
                label-restore-all-requested() => root.label-restore-all-requested();
                label-restore-all-cancelled() => root.label-restore-all-cancelled();
                }
            }
            // The roster-only board mount (tag-color plan D-4, US-2):
            // the window-level overlay grammar's sibling conditional —
            // the same LabelsPanel, the same pushed halves, the same
            // callback set; no assignment toggles (D-3's
            // shows-assignment flag). The board-bar segment (the
            // menu's invoker) is the focus-restore container anchor
            // (the standing focus contract).
            if (root.current-view == View.board
                    && root.label-overlay-open): ModalDialogHost {
                open: true;
                title: "Labels";
                kind: root.label-overlay-form-open
                    ? DialogKind.edit : DialogKind.confirm;
                body-preferred-width: Theme.menu-max-width;
                // The panel's own walk extent (3 roster stops; the add
                // form's open flip re-arms 6 through the panel's
                // changed watch) — the mount-time value matches the
                // panel's own arm so the ordering never shows 1.
                walk-stops: 3;
                viewport-floor: status.y;
                accepted => root.labels-overlay-form-commit-requested();
                dismissed => root.labels-overlay-dismiss-requested();
                LabelsPanel {
                rows: root.label-overlay-rows;
                form-open: root.label-overlay-form-open;
                form-title: root.label-overlay-form-title;
                form-colour: root.label-overlay-form-colour;
                colour-valid: root.label-overlay-colour-valid;
                colour-preview: root.label-overlay-colour-preview;
                swatches: root.label-overlay-swatches;
                swatch-selected: root.label-overlay-swatch-selected;
                picker-hue: root.label-overlay-picker-hue;
                picker-sat: root.label-overlay-picker-sat;
                picker-val: root.label-overlay-picker-val;
                picker-hue-colour: root.label-overlay-picker-hue-colour;
                armed-index: root.label-overlay-armed-index;
                shows-assignment: root.label-overlay-shows-assignment;
                row-toggled(index) => root.labels-overlay-row-toggled(index);
                dismiss-requested() => root.labels-overlay-dismiss-requested();
                add-requested() => root.labels-overlay-add-requested();
                edit-requested(index) => root.labels-overlay-edit-requested(index);
                title-edited(t) => root.labels-overlay-title-edited(t);
                colour-edited(c) => root.labels-overlay-colour-edited(c);
                swatch-clicked(i) => root.labels-overlay-swatch-clicked(i);
                hue-picked(h) => root.labels-overlay-hue-picked(h);
                sat-val-picked(s, v) => root.labels-overlay-sat-val-picked(s, v);
                form-commit-requested() => root.labels-overlay-form-commit-requested();
                form-cancelled() => root.labels-overlay-form-cancelled();
                delete-clicked(index) => root.labels-overlay-delete-clicked(index);
                delete-cancelled() => root.labels-overlay-delete-cancelled();
                has-deleted: root.label-overlay-has-deleted;
                deleted-rows: root.label-overlay-deleted-rows;
                restore-armed-index: root.label-overlay-restore-armed-index;
                restore-all-armed: root.label-overlay-restore-all-armed;
                label-restore-requested(index) => root.label-restore-requested(index);
                label-restore-cancelled() => root.label-restore-cancelled();
                label-restore-all-requested() => root.label-restore-all-requested();
                label-restore-all-cancelled() => root.label-restore-all-cancelled();
                }
            }


    // The dropdown/quick-list flyouts mount window-level (round-5 D6,
    // 2026-11-05): this **overrides the r4 D39 "no window overlay"
    // decision** that lived at the old in-widget flyout — the
    // coordinate-space defect (F9: panel-local geometry under a
    // displaced underlay) and the settings `Flickable` clip (F14) are
    // subsumed by the date-picker overlay grammar (facts-global
    // geometry, window-level mount, dismissal underlay). Sibling
    // order per class: the dismissal underlay first, the panels
    // after — the later sibling is hit-tested first (probe P1), so
    // the panels absorb their own clicks and the underlay receives
    // exactly the outside clicks. The groups sit above the
    // date-picker/timer-setter/track-entries overlays (a click
    // anywhere dismisses only the flyout first — the standard
    // stacked-overlay behavior) and below the menu group (the menu is
    // a modal takeover no flyout can be open under). The panel
    // geometry is the date-picker mount's exact expression shape:
    // below the anchor when it fits between the anchor and the status
    // bar, else flipped above, both clamped into the window margins.
    // The ONE generic dropdown flyout mount (round-9 chunk 15, D-1's
    // de-sited grammar via the recorded D-fallback): the class facts
    // global carries the open instance's consumer kind, its pushed
    // rows, and the anchor geometry; this mount rides chunk 3's
    // `AnchoredOverlayHost` (the last hand clamp/flip family dies —
    // chunk 17's #954 absorption map loses this family), and
    // dispatches the flyout's intents on the consumer kind. New
    // dropdown consumers add one `DropdownConsumer` arm and zero
    // app-window mount edits.
    if (DropdownFacts.open): dropdown-host := AnchoredOverlayHost {
        open: true;
        anchor-x: DropdownFacts.anchor-x;
        anchor-y: DropdownFacts.anchor-y;
        anchor-width: DropdownFacts.anchor-width;
        anchor-height: DropdownFacts.anchor-height;
        viewport-width: root.width;
        viewport-floor: status.y;
        // The R-6 menu-width law (#978): the flyout is at least the
        // readable-row floor, clamped to the viewport band, and
        // otherwise as wide as its closed field (the panel's explicit
        // width below pins the layout child; the host's floor keeps
        // the minimum).
        panel-preferred-width: OverlayMenuWidth.menu-width(DropdownFacts.anchor-width, root.width);
        walk-stops: 1;
        // The dismissal layer's routing (D-6): the priority consumers
        // own their close (the adapter's origin restore); the legacy
        // sites close through the fact write alone.
        dismissed => {
            if (DropdownFacts.consumer == DropdownConsumer.task-importance
                    || DropdownFacts.consumer == DropdownConsumer.task-urgency) {
                // The priority consumers own their close (the adapter's
                // origin restore; D-6).
                root.priority-dismiss-requested();
            } else {
                // The legacy sites close through the fact write — the
                // retired backdrop's exact grammar (the widget's
                // external-close hook lands as the field-refocusing
                // close).
                DropdownFacts.open = false;
            }
        }
        changed panel-x => { DropdownFacts.panel-x = self.panel-x; }
        changed panel-y => { DropdownFacts.panel-y = self.panel-y; }
        init => {
            // The mount-time seed (a `changed` hook alone misses the
            // initial placement — the flyout's old `init` idiom,
            // moved to the mount with the host).
            DropdownFacts.panel-x = self.panel-x;
            DropdownFacts.panel-y = self.panel-y;
        }
        DropdownFlyout {
            rows: DropdownFacts.rows;
            width: OverlayMenuWidth.menu-width(DropdownFacts.anchor-width, root.width);
            row-activated(index) => {
                if (DropdownFacts.consumer == DropdownConsumer.settings-remote) {
                    root.settings-remote-bind-picked(SettingsBoardFacts.active-item, index);
                } else if (DropdownFacts.consumer == DropdownConsumer.settings-publish) {
                    root.settings-publish-picked(SettingsBoardFacts.active-item, index);
                } else if (DropdownFacts.consumer == DropdownConsumer.board-switcher) {
                    root.board-bar-segment-activated(index);
                } else if (DropdownFacts.consumer == DropdownConsumer.board-archived) {
                    root.board-bar-archived-activated(index);
                } else {
                    // The task detail's pickers (D-9): the slot index
                    // routes verbatim; the adapter resolves the field
                    // from `priority_open`.
                    root.priority-slot-clicked(index);
                }
            }
            row-hovered(index, x, y, w, h) => {
                if (DropdownFacts.consumer == DropdownConsumer.settings-remote) {
                    TooltipState.hover(
                        SettingsModel.board-options[index].label,
                        SettingsBoardCopy.row-description,
                        [],
                        x, y, w, h);
                } else if (DropdownFacts.consumer == DropdownConsumer.settings-publish) {
                    TooltipState.hover(
                        SettingsModel.board-options[index].label,
                        SettingsPublishCopy.row-description,
                        [],
                        x, y, w, h);
                } else if (DropdownFacts.consumer == DropdownConsumer.board-switcher) {
                    TooltipState.hover(
                        root.board-bar-model.rows[index].label,
                        "Switches to this board.",
                        root.board-segment-hint,
                        x, y, w, h);
                } else if (DropdownFacts.consumer == DropdownConsumer.board-archived) {
                    TooltipState.hover(
                        root.board-bar-model.archived-rows[index].label,
                        "Restores this archived board to the bar.",
                        [],
                        x, y, w, h);
                }
            }
            row-unhovered() => {
                TooltipState.unhover();
            }
        }
    }
    // The board color strip (UX R-4 D-1, #791): the dismissal
    // underlay first, the swatch panel after — the dropdown group's
    // sibling rule (the later sibling absorbs its own clicks, the
    // underlay receives exactly the outside clicks). The panel hangs
    // below the bar's mirrored anchor, clamped into the window.
    // D-9b (round-9 W6, #954): the color strip joins the family — the
    // hand backdrop and the clamp expressions are the host's now (the
    // G-4 probe's law tests). The strip pins below (no flip leg — the
    // old expression's law) with the window bottom as the floor, and
    // its explicit size rides the host's width/height law.
    if (root.board-color-strip-open): board-color-host := AnchoredOverlayHost {
        open: true;
        anchor-x: BoardBarFacts.anchor-x;
        anchor-y: BoardBarFacts.anchor-y;
        anchor-width: BoardBarFacts.anchor-width;
        anchor-height: BoardBarFacts.anchor-height;
        viewport-width: root.width;
        viewport-floor: root.height;
        placement: OverlayPlacement.below;
        panel-preferred-width: 6 * Theme.space-4 + 5 * Theme.space-2 + 2 * Theme.space-2;
        walk-stops: 1;
        dismissed => root.board-color-strip-dismissed();
        Rectangle {
            height: Theme.space-4 + 2 * Theme.space-2;
            background: Theme.surface-raised;
            border-radius: Theme.radius-small;
            border-width: Theme.focus-ring-width;
            border-color: Semantic.focus-ring;
            // Waiver (#1416): the tight 8px blur is deliberate here —
            // this is the 24px-tall inline board-colour strip, not a
            // floating overlay; the tokenized `Theme.shadow-blur` (12px
            // × base-scale) would wash a micro element into its
            // background. The floating flyouts (menu-shell,
            // date-picker, search-palette, recur-editor, focus-overlay,
            // modal-dialog-host) carry the token.
            drop-shadow-blur: Theme.space-2;
            drop-shadow-color: Theme.surface-hover;
        HorizontalLayout {
            padding: Theme.space-2;
            spacing: Theme.space-2;
            for swatch[index] in root.board-color-swatches: Rectangle {
                width: Theme.space-4;
                height: self.width;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-small;
                background: swatch;
                border-width: root.board-color-strip-selected == index
                    ? Theme.focus-ring-width : 0;
                border-color: Semantic.focus-ring;
                TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => root.board-color-picked(index);
                }
            }
        }
        }
    }
    // M3 (overlay migration): the time-field quick-list flyout's ONE
    // host mount — the four site twins' hand clamp/flip expressions
    // and the site backdrop are the host's now. `site` discriminates
    // the panel contents (rows + seams per surface); the geometry
    // rides the class facts global (the widget's click-time push +
    // keep-alives). The realized panel rect mirrors into the facts
    // here — the panel's own mirror would read the host-local zero
    // (the mount site owns the window-space observation seam).
    flyout-host := AnchoredOverlayHost {
        open: TimeFieldFacts.open;
        anchor-x: TimeFieldFacts.anchor-x;
        anchor-y: TimeFieldFacts.anchor-y;
        anchor-width: TimeFieldFacts.anchor-width;
        anchor-height: TimeFieldFacts.anchor-height;
        viewport-width: root.width;
        viewport-floor: status.y;
        panel-preferred-width: OverlayMenuWidth.menu-width(TimeFieldFacts.anchor-width, root.width);
        walk-stops: 1;
        dismissed => {
            TimeFieldFacts.open = false;
        }
        changed panel-y => { TimeFieldFacts.panel-y = self.panel-y; }
        changed panel-x => { TimeFieldFacts.panel-x = self.panel-x; }
        if (TimeFieldFacts.site == 0): QuickListFlyout {
            rows: root.task-model.date-time-slots;
            nearest-row: root.task-model.date-time-nearest-row;
            focus-nonce: root.date-quick-nonce;
            picked(m) => root.task-date-time-picked(m);
            typed(t) => root.task-date-quick-typed(t);
        }
        if (TimeFieldFacts.site == 1): QuickListFlyout {
            rows: root.timer-setter-time-slots;
            nearest-row: root.timer-setter-time-nearest-row;
            focus-nonce: root.timer-setter-quick-nonce;
            picked(m) => root.timer-setter-time-picked(m);
            typed(t) => root.timer-setter-quick-typed(t);
        }
        if (TimeFieldFacts.site == 2): QuickListFlyout {
            rows: root.track-form-start-slots;
            nearest-row: root.track-form-start-nearest-row;
            focus-nonce: root.track-form-quick-nonce;
            picked(m) => root.track-form-start-picked(m);
            typed(t) => root.track-form-start-quick-typed(t);
        }
        if (TimeFieldFacts.site == 3): QuickListFlyout {
            rows: root.track-form-end-slots;
            nearest-row: root.track-form-end-nearest-row;
            focus-nonce: root.track-form-quick-nonce;
            picked(m) => root.track-form-end-picked(m);
            typed(t) => root.track-form-end-quick-typed(t);
        }
    }

        // The D2 outside-click dismissal layer (round 1): a full-window
        // TouchArea declared AFTER the chrome and BEFORE the menu
        // panel — the later sibling is hit-tested first, so the layer
        // receives exactly the clicks the panel does not absorb (probe
        // P1). No visual. A stolen hamburger click lands here too and
        // converges on the same full close.
        if (KeyboardState.menu-open): menu-backdrop := TouchArea {
            width: 100%;
            height: 100%;
            init => TooltipState.unhover();
            clicked => root.menu-dismiss-requested();
            // The right-click dismissal (r4 D2): the card's
            // pointer-event idiom, closing on the down half.
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.right) {
                    root.menu-dismiss-requested();
                }
            }
        }

        // The generated menu host (§5.9): keyed to the shell's menu
        // state, no key handlers of its own. Mounting dismisses any
        // pending tooltip (the menu is the modal context now).
        if (KeyboardState.menu-open): ActionMenu {
            init => TooltipState.unhover();
            // Round-1 D4: right-aligned under the hamburger, bounded on
            // all four edges. The width expression is the probe-settled
            // shape (P2/P2b): floor 320·scale, cap 560·scale over the
            // natural preferred width, narrow fallback = window minus
            // margins — one expression, since `width` and `min-width`
            // cannot coexist. The x/y clamps keep the panel inside the
            // window (status bar included) at any size.
            width: min(root.width - 2 * Theme.space-2,
                       max(320px * Theme.base-scale,
                           min(self.preferred-width, Theme.dialog-max-width)));
            // The anchor rect: the hamburger, or the context menu's
            // pointer point (round-1 D13) — same clamp formula.
            x: max(Theme.space-2,
                   min((KeyboardState.menu-pointer-anchored
                            ? KeyboardState.menu-pointer-x - self.width / 2
                            : toolbar.menu-anchor-x + toolbar.menu-anchor-width - self.width),
                       root.width - self.width - Theme.space-2));
            y: max(Theme.space-2,
                   min((KeyboardState.menu-pointer-anchored
                            ? KeyboardState.menu-pointer-y + Theme.space-1
                            : toolbar.menu-anchor-y + toolbar.menu-anchor-height + Theme.space-1),
                       status.y - self.height - Theme.space-1));
            // Usability D6: fill only the space between the anchor and
            // the status bar; the Flickable inside scrolls the overflow.
            // The cap reads the anchor, not the final y — no cycle.
            available-height: max(0px,
                status.y - (KeyboardState.menu-pointer-anchored
                            ? KeyboardState.menu-pointer-y
                            : toolbar.menu-anchor-y + toolbar.menu-anchor-height)
                    - Theme.space-1 - 2 * Theme.space-2);
            entries: KeyboardState.menu-entries;
            submenu-entries: KeyboardState.menu-submenu-entries;
            quick-bar: KeyboardState.menu-quick-bar;
            selected-index: KeyboardState.menu-selected-index;
            root-selected-index: KeyboardState.menu-root-selected-index;
            active-group: KeyboardState.menu-active-group;
            compact: Responsive.current-breakpoint == Breakpoint.compact;
            invoke-entry(index) => root.menu-entry-invoked(index);
            invoke-submenu-entry(index) => root.menu-submenu-entry-invoked(index);
            // slint: menu-quick-bar-invoked (the Rust seam on_menu_quick_bar_invoked)
            invoke-quick-bar(index) => root.menu-quick-bar-invoked(index);
            level-back() => root.menu-level-back();
        }

        // The fly-out (round-1 D6, regular/expansive): the active
        // group's page mounted at the root panel's LEFT edge — the
        // stage-2 recorded deviation from the plan's "right edge":
        // the panel is right-aligned under the hamburger, so the
        // right side never has room and the clamp would always
        // collapse the fly-out onto the panel. Compact replaces the
        // root panel's page instead (inside the panel above).
        if (KeyboardState.menu-open && KeyboardState.menu-active-group >= 0
                && Responsive.current-breakpoint != Breakpoint.compact): ActionMenu {
            width: min(root.width - 2 * Theme.space-2,
                       max(320px * Theme.base-scale,
                           min(self.preferred-width, Theme.dialog-max-width)));
            x: max(Theme.space-2,
                   min(MenuPanelFacts.x - Theme.space-1 - self.width,
                       root.width - self.width - Theme.space-2));
            y: max(Theme.space-2,
                   min(MenuPanelFacts.y,
                       status.y - self.height - Theme.space-1));
            available-height: max(0px,
                status.y - MenuPanelFacts.y - 2 * Theme.space-2);
            entries: KeyboardState.menu-submenu-entries;
            selected-index: KeyboardState.menu-selected-index;
            is-flyout: true;
            invoke-entry(index) => root.menu-submenu-entry-invoked(index);
            // The fly-out never carries a quick bar (its model is the
            // empty default) — the inventory's forwarding invariant
            // still holds (the callback lands on the same Rust seam).
            invoke-quick-bar(index) => root.menu-quick-bar-invoked(index);
        }

        // The undo branch picker (UF2, #353): the backdrop's outside
        // click dismisses with nothing dispatched (AC-4); the panel
        // rides the same anchor law as the menu (bounded on all four
        // edges, below the toolbar, above the status bar).
        if (KeyboardState.undo-picker-open): undo-picker-backdrop := TouchArea {
            width: 100%;
            height: 100%;
            clicked => root.undo_picker_dismissed();
        }
        if (KeyboardState.undo-picker-open): UndoBranchPicker {
            x: max(Theme.space-2,
                   min((root.width - self.width) / 2,
                       root.width - self.width - Theme.space-2));
            y: max(Theme.space-2,
                   min(Theme.space-6,
                       status.y - self.height - Theme.space-1));
            branch-rows: KeyboardState.undo-picker-branch-rows;
            target-rows: KeyboardState.undo-picker-target-rows;
            cursor: KeyboardState.undo-picker-cursor;
            // slint: undo_branches_open (the Rust seam on_undo_branches_open)
            undo_branches_open() => root.undo_branches_open();
            undo_line_undo() => root.undo_line_undo();
            undo_line_redo() => root.undo_line_redo();
            undo_target_picked(id) => root.undo_target_picked(id);
            undo_branch_picked(id) => root.undo_branch_picked(id);
            undo_picker_dismissed() => root.undo_picker_dismissed();
        }

        // The tooltip host (usability D3, round-1 D9/D10): mounted
        // while content exists so the size hand-off can measure it;
        // opacity-0 until the Rust placement lands (`placed`), then
        // shown at the computed top-left.
        if (TooltipState.pending || TooltipState.visible): TooltipPanel {
            window-width: root.width;
        }

        // M7 (overlay migration): the search palette on the
        // ModalDialogHost base (J2 R-5's focus-trapped modal) — the
        // hand backdrop/centering are the host's; the walk-mask
        // arming is the host's too (the containment is structural:
        // the mask extent rides the live row count + the query
        // field).
        // The capture overlay on the ModalDialogHost base (round-9 W1,
        // D-W1-1's proof mount): the host carries the scrim, the
        // dismissal layer, the centering, and the walk arming — the
        // site wires only its existing intents. #976 (SB1, R-4
        // edit-kind flip, US-1): capture is an edit-kind dialog — an
        // outside click routes the accept seam (`capture_accepted`);
        // the empty-buffer close is `commit_capture`'s own arm, so an
        // empty draft closes without committing. The W1 proof-mount's
        // discard-and-close outside click retires here (the W2
        // migration debt). Escape stays the explicit discard
        // (`capture_dismiss_requested` via the action layer).
        if (root.capture-open): ModalDialogHost {
            open: true;
            title: "Capture";
            kind: DialogKind.edit;
            body-preferred-width: Theme.dialog-max-width;
            walk-stops: 1;
            viewport-floor: status.y;
            dismissed => root.capture_dismiss_requested();
            // US-1/AC-1: the outside click commits AND closes — the
            // accept seam (commit_capture) commits-and-continues by
            // Return's grammar, so the scrim's accept resolution
            // chains the existing dismissal seam after it (the buffer
            // is already cleared; the empty draft never reaches the
            // commit). No second accept seam is coined; Escape's
            // explicit discard is untouched.
            accepted => {
                root.capture_accepted();
                root.capture_dismiss_requested();
            }
            CaptureOverlay {
                initial-text: root.capture-initial-text;
                capture-edited(text) => root.capture-text-edited(text);
                capture_accepted() => root.capture_accepted();
                text-flow-focus-lost() => root.text-flow-focus-lost();
            }
        }
        // M5 (overlay migration): the recurrence editor on the
        // ModalDialogHost base — the hand scrim/centering/size
        // expressions are the host's now. The D-3 edit-kind law
        // (R-4's deliberate behavior change, called out in the PR):
        // an outside click routes the COMMIT seam — a valid draft
        // saves (the modern autosave expectation), an invalid one
        // re-checks and dispatches nothing (the editor stays open,
        // the validity echo shows). The census row for the recur
        // editor carries the supersession note.
        if (root.recur-editor-open): ModalDialogHost {
            open: true;
            title: "Repeat";
            kind: DialogKind.edit;
            body-preferred-width: Theme.dialog-max-width;
            walk-stops: 1;
            viewport-floor: status.y;
            accepted => root.recur_commit_clicked();
            RecurEditor {
            model: root.recur-editor-model;
            commit-refused: root.recur-draft-invalid;
            pattern-kind-picked(i) => root.recur-pattern-picked(i);
            every-days-edited(t) => root.recur-every-days-edited(t);
            weekly-interval-edited(t) => root.recur-weekly-interval-edited(t);
            weekday-toggled(i) => root.recur-weekday-toggled(i);
            monthly-mode-picked(i) => root.recur-monthly-mode-picked(i);
            monthly-day-edited(t) => root.recur-monthly-day-edited(t);
            monthly-nth-edited(t) => root.recur-monthly-nth-edited(t);
            monthly-weekday-picked(i) => root.recur-monthly-weekday-picked(i);
            bound-kind-picked(i) => root.recur-bound-picked(i);
            until-edited(t) => root.recur-until-edited(t);
            count-edited(t) => root.recur-count-edited(t);
            commit-clicked() => root.recur_commit_clicked();
            cancel-clicked() => root.recur-editor-cancel-clicked();
            detach-arm-clicked() => root.recur-detach-arm-clicked();
            detach-confirm-clicked() => root.recur-detach-confirm-clicked();
            detach-cancel-clicked() => root.recur-detach-cancel-clicked();
            }
        }
        // The export dialog (the J2 export plan W-1): on the
        // ModalDialogHost base, confirm-kind — an outside click
        // dismisses with nothing dispatched (US-1/AC-2); the Run
        // button rides the host's button model (the busy gate).
        if (root.export-dialog-mounted): ModalDialogHost {
            open: true;
            title: "Export";
            kind: DialogKind.confirm;
            body-preferred-width: Theme.dialog-max-width;
            walk-stops: 1;
            viewport-floor: status.y;
            buttons: [
                { label: "Close", role: DialogButtonRole.dismiss, enabled: true, autofocus: false },
                { label: "Run", role: DialogButtonRole.accept, enabled: root.export-model.run-enabled, autofocus: false },
            ];
            button-invoked(index) => {
                if (index == 0) {
                    root.export-dialog-close();
                } else {
                    root.export-run();
                }
            }
            dismissed => root.export-dialog-close();
            // No `accepted` arm (#1191, the palette dialog's #1026
            // precedent): the ModalDialogHost kind law fires `accepted`
            // only for the `edit` kind — never on this confirm-kind
            // dialog; the arm was unreachable wiring.
            ExportDialog {
                model: root.export-model;
                spec-picked(control, index) => root.export-spec-picked(control, index);
                field-edited(field, text) => root.export-field-edited(field, text);
                open-after-toggled() => root.export-open-after-toggled();
                run-clicked() => root.export-run();
                export-preview-requested() => root.export_preview();
                export-copy-requested() => root.export_clipboard_copy();
                close-clicked() => root.export-dialog-close();
            }
        }
        if (root.palette-open): ModalDialogHost {
            open: true;
            title: "Search";
            kind: DialogKind.confirm;
            body-preferred-width: Theme.dialog-max-width;
            walk-stops: 1 + root.palette-model.length;
            viewport-floor: status.y;
            dismissed => root.palette-dismiss-requested();
            // No `accepted` wiring (#1026): confirm-kind with an empty
            // button model can never fire it (R-4 routes confirm
            // outside-clicks to `dismissed`; the edit-kind arm never
            // sees this mount) — the palette has no accept seam.
            palette-panel := SearchPalette {
            rows: root.palette-model;
            selected-index: root.palette-selected-index;
            overflow: root.palette-overflow;
            query-edited(text) => root.palette-query-edited(text);
            row-activated(index) => root.palette-row-activated(index);
            text-flow-focus-lost() => root.text-flow-focus-lost();
            }
        }
        // The habit history dialog (HF3 W-8, US-7): the read role's
        // posture — kind `confirm` routes the outside click to the
        // close (zero state change, US-7/S4); the button model is
        // empty (the dialog is a projection — the only intents are
        // the pager's two flips, US-7/S3, and the host's own
        // dismissal). Desktop-only: the kiosk never arms the mount
        // bit (R-3), so this `if` never holds on the appliance.
        if (root.habit-history-open): ModalDialogHost {
            open: true;
            title: "Habit history";
            kind: DialogKind.confirm;
            body-preferred-width: Theme.dialog-max-width;
            walk-stops: 1 + 2;
            viewport-floor: status.y;
            dismissed => root.habit_history_close_requested();
            HabitHistoryView {
                model: root.habit-history;
                history-month-flipped(delta) => root.habit_history_month_flipped(delta);
            }
        }
        // The pointer drag's ghost (r2 chunk-8, D-D): the dragged
        // card's snapshot at half opacity, centred under the cursor
        // (DragState.pointer-x/y, fed by the board DropAreas' can-drop
        // reports). Mounted as the last sibling: mid-drag the runtime
        // suppresses hover/press over it, so it shadows no drop
        // target; no other overlay can be open while a drag is.
        // The concentration overlay (#496): full-surface scrim + panel
        // (the capture-overlay precedent; the later sibling wins the
        // hit test, so an outside click lands on the scrim and closes
        // — the session keeps running; the overlay is presentation).
        // The review walk on the J2 modal base (J4 D-5, US-4): the
        // host owns the scrim, the absorbing panel root (inside clicks
        // never close — the ad-hoc scrim dies), the content-bounded
        // height, and the walk-mask arming; kind `confirm` routes the
        // outside click to the abort law (R-2), never a silent
        // step-back. The dialog button row carries the stage's
        // Next/Prev/Finish + the completion exit (the pass derives the
        // model and the parallel intent codes).
        if (root.walk-model.open): ModalDialogHost {
            open: true;
            title: root.walk-model.header;
            kind: DialogKind.confirm;
            body-preferred-width: Theme.dialog-max-width;
            // The declared extent (#1053): the body's own stop (the
            // D-W1-4 declared body stop; the walk's row list is the
            // body's content and the cursor row's controls are masked
            // by the walk), every row, and the D-5 button row — the
            // host mounts the buttons as `TextButton` tab stops, so an
            // extent without them under-declares and the adapter's
            // cursor can walk past the last real stop.
            walk-stops: 1 + root.walk-model.rows.length
                + root.walk-model.buttons.length;
            viewport-floor: status.y;
            // The stage's button row (D-5): the pass derives the
            // model + parallel intent codes; without this binding the
            // journey's visible Next/Prev/Finish/Done controls vanish.
            buttons: root.walk-model.buttons;
            // The autofocus flag is authoritative (#996): the same
            // Rust pass derives the index from the buttons vec — the
            // site binds it, never a hand-declared literal.
            initial-focus-index: root.walk-model.initial-focus-index;
            // Confirm kind: outside click is the only host-emitted
            // dismissal (the R-4 law) — and it is the abort law's arm.
            dismissed => root.walk-abort-arm-requested();
            button-invoked(code) => root.walk-button-invoked(
                root.walk-model.button-codes[code]);
            ReviewWalkOverlay {
                model: root.walk-model;
                answer-seeds: root.walk-answer-seeds;
                mood-seed: root.walk-mood-seed;
                energy-seed: root.walk-energy-seed;
                mood-validity: root.walk-mood-validity;
                energy-validity: root.walk-energy-validity;
                plan: root.plan-model;
                plan-time-text: root.plan-time-text;
                plan-effort-text: root.plan-effort-text;
                plan-box-activated(i) => root.plan-box-activated(i);
                plan-pool-activated(i) => root.plan-pool-activated(i);
                plan-box-earlier(i) => root.plan-box-earlier(i);
                plan-box-later(i) => root.plan-box-later(i);
                plan-box-remove(i) => root.plan-box-remove(i);
                plan-time-edited(t) => root.plan-time-edited(t);
                plan-effort-edited(t) => root.plan-effort-edited(t);
                plan-place-commit() => root.plan-place-commit();
                plan-place-cancel() => root.plan-place-cancel();
                file-clicked() => root.walk-file-clicked();
                keep-clicked() => root.walk-keep-clicked();
                file-prev-clicked() => root.walk-file-prev-clicked();
                file-next-clicked() => root.walk-file-next-clicked();
                candidate_activated(index) => root.walk_candidate_activated(index);
                file-commit-clicked() => root.walk-file-commit-clicked();
                tomorrow-clicked() => root.walk-tomorrow-clicked();
                pick-clicked() => root.walk-pick-clicked();
                leave-clicked() => root.walk-leave-clicked();
                plan-clicked() => root.walk-plan-clicked();
                date-edited(text) => root.walk-date-edited(text);
                date-commit-clicked() => root.walk-date-commit-clicked();
                answer-edited(index, text) => root.walk-answer-edited(index, text);
                walk-rating-edited(kind, text) => root.walk-rating-edited(kind, text);
                record-clicked() => root.walk-record-clicked();
                finish-clicked() => root.walk-finish-clicked();
            }
        }
        // The abort confirm (J4 D-6): a nested confirm-kind host above
        // the walk dialog (the later sibling wins the hit test).
        // Accept closes the walk — decisions already made are applied
        // commands and survive; dismiss keeps the walk verbatim. The
        // tally is NOT presented here: the summary belongs to a
        // completed session only.
        if (root.walk-model.open && root.walk-model.abort-confirm): ModalDialogHost {
            open: true;
            title: "End this review?";
            kind: DialogKind.confirm;
            body-preferred-width: 420px * Theme.base-scale;
            walk-stops: 2;
            viewport-floor: status.y;
            // Confirm kind: outside click dismisses ("Keep
            // reviewing") — the one host-emitted resolution.
            dismissed => root.walk-abort-dismiss-clicked();
            button-invoked(i) => {
                if (i == 0) {
                    root.walk-abort-dismiss-clicked();
                } else {
                    root.walk-abort-accept-clicked();
                }
            }
            // The literal-array mount (#996): Slint functions have no
            // model reduce, so a literal site cannot derive an index —
            // this site leaves `initial-focus-index` at the default -1
            // (unchanged behavior); the `autofocus` flags stay
            // declarative metadata here.
            buttons: [
                { label: "Keep reviewing", role: DialogButtonRole.dismiss, enabled: true, autofocus: true },
                { label: "End review", role: DialogButtonRole.accept, enabled: true, autofocus: false },
            ];
            VerticalLayout {
                RoleText {
                    role: Typography.body;
                    text: "Steps already taken stay as they are. Half-typed text is dropped.";
                    wrap: word-wrap;
                }
            }
        }
        if (root.focus-overlay-open): focus-overlay-backdrop := TouchArea {
            width: 100%;
            height: 100%;
            clicked => root.focus-overlay-close-requested();
        }
        if (root.focus-overlay-open): FocusOverlay {
            width: min(root.width - 2 * Theme.space-2, Theme.dialog-max-width);
            x: (root.width - self.width) / 2;
            y: max(Theme.space-4,
                   min((root.height - status.height - self.height) / 2,
                       status.y - self.height - Theme.space-2));
            phase-text: root.focus-phase-text;
            remaining-text: root.focus-remaining-text;
            task-title: root.focus-task-title;
            rows: root.focus-switcher-model;
            selected-index: root.focus-switcher-selected;
            note-initial-text: root.focus-note-initial-text;
            note-edited(text) => root.focus-note-edited(text);
            note-accepted() => root.focus-note-accepted();
            switcher-activated(index) => root.focus-switcher-invoked(index);
            stop-clicked() => root.focus-stop-clicked();
        }
        if (root.board-drag-open): Rectangle {
            width: 100%;
            height: 100%;
            TaskCard {
                model: DragState.ghost-model;
                // Card-sized (r3 D1): the size captured at drag-arm —
                // the default fill would mount a window-sized ghost.
                width: DragState.ghost-width;
                height: DragState.ghost-height;
                x: DragState.pointer-x - self.width / 2;
                y: DragState.pointer-y - self.height / 2;
                opacity: 0.5;
            }
        }
    }

    // The Rust-installed interception seam (D18): converts the event
    // to a Stroke, feeds the resolver, and answers accept (the
    // resolver consumed the stroke) or reject (delivery continues).
    pure callback intercept-key(string, KeyboardModifiers) -> bool;
    // The `menu.invoke` projection: the adapter closes the menu and
    // re-dispatches the selected entry through the same router.
    pure callback menu-entry-invoked(int);
    // The D2 dismissal layer: an outside click is a dismissal, not a
    // level-up — the adapter routes the full close.
    pure callback menu-dismiss-requested();
    // The undo branch picker's seams (UF2, #353): W-1's mount ack, the
    // plain reflex rows, the W-2/W-3 row seams, and the AC-4
    // outside-click dismissal.
    pure callback undo_branches_open();
    pure callback undo_line_undo();
    pure callback undo_line_redo();
    pure callback undo_target_picked(string);
    pure callback undo_branch_picked(string);
    pure callback undo_picker_dismissed();
    // The search palette's seams (#348): per-keystroke ranking, the
    // outside-click close, and row activation.
    pure callback palette-query-edited(string);
    pure callback palette-dismiss-requested();
    pure callback palette-row-activated(int);
    // The two-tier seams (round-1 D6): the fly-out/replace page's
    // rows and the compact back row.
    pure callback menu-submenu-entry-invoked(int);
    pure callback menu-level-back();
    // The quick actions bar's invocation (UX-R8 chunk-5 D-2, US-1):
    // the adapter resolves the index against the open-time vec.
    pure callback menu-quick-bar-invoked(int);

    // The D15 focus hand-off (journey finding): an edit flow's field
    // holds slint focus while mounted and unmounts when the flow ends;
    // the active view scope takes focus back so the keyboard never
    // dead-ends. Driven by the adapter when a flow ends.
    public function refocus-view() {
        key-root.focus();
    }

    // The focus-origin restore calls (the focus-restoration plan
    // US-1/W-1, D-F1): after an overlay site closes, the adapter
    // resolves the recorded origin and invokes the anchor family's
    // function, which publishes the FocusFacts tuple. Row anchors are
    // *logical* (the walk's emphasis look — rows carry no slint focus
    // stop); the detail cells consume the fact physically (their
    // ActivationStop grabs slint focus).
    // slint: focus-task-row
    public function focus-task-row(target-a: int, target-b: int) {
        FocusFacts.anchor-kind = 1;
        FocusFacts.target-a = target-a;
        FocusFacts.target-b = target-b;
        FocusFacts.nonce += 1;
    }
    // slint: focus-stack-header
    public function focus-stack-header(column: int) {
        FocusFacts.anchor-kind = 2;
        FocusFacts.target-a = column;
        FocusFacts.target-b = -1;
        FocusFacts.nonce += 1;
    }
    // slint: focus-board-cell
    public function focus-board-cell(segment: int) {
        FocusFacts.anchor-kind = 3;
        FocusFacts.target-a = segment;
        FocusFacts.target-b = -1;
        FocusFacts.nonce += 1;
    }
    // slint: focus-detail-cell
    public function focus-detail-cell(cell: int) {
        FocusFacts.anchor-kind = cell;
        FocusFacts.target-a = -1;
        FocusFacts.target-b = -1;
        FocusFacts.nonce += 1;
    }

    // The effort field's keyboard opener (J3 US-4, round 9 chunk 11;
    // the seam split, #1100): the per-origin push seam for
    // BeginEffortEdit — the same FocusFacts tuple as
    // focus-detail-cell(6) (the fact contract is per-anchor, the seam
    // is per-origin), so kinds 4/5 journeys and the M9 commit law are
    // untouched.
    // slint: focus-effort-opener
    public function focus-effort-opener() {
        FocusFacts.anchor-kind = 6;
        FocusFacts.target-a = -1;
        FocusFacts.target-b = -1;
        FocusFacts.nonce += 1;
    }

    // The control walk's clamped stop (US-2/W-2, D-W2): under a
    // masked site the walk's cursor steps within the host's extent;
    // this seam publishes the stop — the mounted host consumes it and
    // focuses its control at that index. Nothing synthetic enters the
    // traversal, so nothing under the mask is reachable.
    // slint: mask-focus
    public function mask-focus(index: int) {
        MaskWalkFacts.focus-index = index;
        MaskWalkFacts.nonce += 1;
    }

    // The Responsive width push (D17): every width change lands in
    // Rust's breakpoint mapping, which sets the `Responsive` global.
    pure callback window-width-changed(float);
    changed width => { root.window-width-changed(root.width / 1px); }

    // The view dispatch seams (D22): every user-visible verb arrives
    // here and routes through the action layer / view-state machine
    // in the adapter. Indices only — the adapter resolves them
    // against the id tables it built when pushing the models (D2).
    pure callback toolbar-menu-clicked();
    pure callback toolbar-inbox-clicked();
    // The view switcher's clicks (round-3 D22): each routes the same
    // registry action the keyboard uses (§7.1: click ≡ key).
    pure callback toolbar-switcher-board-clicked();
    pure callback toolbar-switcher-today-clicked();
    pure callback board-bar-segment-activated(int);
    // The archived-boards roster's row activation (UX R-1 D-1, #785):
    // the unarchive seam — SetBoardArchived { archived: false } + the
    // models refresh, then the restored board re-selects (the
    // view-state one-shot consumed at reconcile).
    pure callback board-bar-archived-activated(int);
    pure callback board-task-activated(int, int);
    pure callback board-task-clicked(int, int);
    // The right-click context menu seams (round-1 D13).
    pure callback board-task-context-requested(int, int, float, float);
    // The column resize drag seams (round-1 D17).
    pure callback board-stack-width-press(int);
    pure callback board-stack-width-drag(int, float);
    pure callback board-stack-width-release(int);
    pure callback stack-task-context-requested(int, float, float);
    // The today view's row seams (chunk 10 D7): (section, row) — the
    // adapter resolves the flat index against `today_tasks`.
    // The habit history dialog's seams (HF3 W-8): the pager flip
    // (US-7/S3) and the close (US-7/S4 — W1 read-role dismissal,
    // zero state change).
    pure callback habit_history_month_flipped(int);
    pure callback habit_history_close_requested();
    // The capture overlay's seams (chunk 10 D8).
    pure callback capture_dismiss_requested();
    pure callback capture-text-edited(string);
    pure callback capture_accepted();
    // The concentration overlay's seams (#496): scrim close, note
    // commit (the capture commit funnel), the switcher's start, and
    // the session stop.
    pure callback focus-overlay-close-requested();
    pure callback focus-note-edited(string);
    pure callback focus-note-accepted();
    pure callback focus-switcher-invoked(int);
    pure callback focus-stop-clicked();
    pure callback today-row-activated(int, int);
    pure callback today-row-extent(string, length);
    pure callback today-row-clicked(int, int);
    pure callback today-row-context-requested(int, int, float, float);
    // The done checkbox's toggles on the today rows and the
    // stack-detail rows (r3 D6): the same raw-send as the board
    // cards, resolved against the today/stack tables.
    pure callback today-row-done-toggled(int, int);
    pure callback stack-task-done-toggled(int);
    pure callback board-header-activated(int);
    pure callback board-switcher-activated(int);
    // The r2 D21 right-click seams: the stack header (and the
    // compact switcher's segments) and the board-bar segment.
    pure callback board-header-context-requested(int, float, float);
    // The stack card's bare-surface right-click (r3 D4): the header
    // seam's body twin — one shared adapter body.
    pure callback board-body-context-requested(int, float, float);
    // The bare body's left-click select (r4 D3): the header seam's
    // body twin — one shared adapter body.
    pure callback board-body-activated(int);
    // The done checkbox's toggle (r3 D6): (column, task) — the
    // adapter resolves the id tables and raw-sends the toggled
    // SetTaskDone (the notification Done button's precedent: the
    // registry's complete/reopen act on the focused task; the
    // checkbox addresses an arbitrary card).
    pure callback board-task-done-toggled(int, int);
    // The card play/pause control's seams (UX-R8 chunk-5 D-6, US-4):
    // each resolves the addressed card through the id tables and
    // routes the existing tracking ids (the shown half is the
    // adapter's state read — one source with the menu's bar).
    // The armed multi-delete strip's fact + pair (UX-R8 chunk-5 D-9,
    // #882): the count fact (−1 disarmed) and the #784 grammar's third
    // instance — Confirm routes the armed verb (the second stroke's
    // twin), Cancel disarms.
    in-out property <int> task-multi-delete-armed: -1;
    pure callback task-multi-delete-strip-confirmed();
    pure callback task-multi-delete-strip-cancelled();
    pure callback board-task-track-toggled(int, int);
    pure callback stack-task-track-toggled(int);
    pure callback today-row-track-toggled(int, int);
    pure callback task-track-toggled();
    pure callback board-segment-context-requested(int, float, float);
    // The board color strip (UX R-4 D-1, #791): a swatch click
    // commits the exact SetBoardColor and closes; a dismissal (the
    // underlay click, Escape's route) closes with nothing dispatched.
    pure callback board-color-picked(int);
    pure callback board-color-strip-dismissed();
    // The stack-rename field (r2 D21): per-column mirror/commit.
    pure callback board-stack-rename-committed(int, string);
    pure callback board-stack-rename-edited(int, string);
