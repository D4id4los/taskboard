        // size before real layout; `changed width` supersedes it.
        root.window-width-changed(root.width / 1px);
        // The today viewport push's first-frame leg (#1310/#1304).
        TodayViewport.height = root.height;
        // The today layout arm's width push's first-frame leg (#1436).
        TodayLayoutFacts.viewport-width = root.width;
    }
    key-root := FocusScope {
        capture-key-pressed(event) => {
