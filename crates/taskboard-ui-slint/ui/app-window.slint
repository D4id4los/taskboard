// SPDX-License-Identifier: AGPL-3.0-only
// The window shell (chunk 1, grown through chunks 2–3): the root
// FocusScope is the *only* key-event handler in the tree (§5.1) —
// capture-phase interception via the Rust-installed `intercept-key`
// callback (Q9: `KeyBinding` unused for rebindable actions). The
// chrome (toolbar / the conditionally-mounted view / status-bar) is
// the Q4 "one view tree": view switching is a property, not windows.
// All user-visible verbs route through the action layer — the
// callbacks below are the dispatch seams, no key handlers (§5.1).

import { Theme, Typography, Semantic } from "theme.slint";
import { Responsive, Breakpoint } from "responsive.slint";
import { ActionMenu, MenuEntryModel } from "compositions/action-menu.slint";
import { SearchPalette, PaletteRowModel } from "compositions/search-palette.slint";
import { CaptureOverlay } from "compositions/capture-overlay.slint";
import { ReviewWalkOverlay, ReviewWalkModel } from "views/review-walk-overlay.slint";
import { FocusOverlay, FocusRowModel } from "compositions/focus-overlay.slint";
import { Toolbar } from "compositions/toolbar.slint";
import { StatusBar, SyncBadgeModel, BannerRowModel, FlowHintModel, FilesSyncChipState } from "compositions/status-bar.slint";
import { NotificationSurface, NotificationRowModel } from "compositions/notification-surface.slint";
import { TimerRowModel } from "compositions/timers.slint";
import { TimerSetter } from "compositions/timer-setter.slint";
import { TrackEntriesPanel, TrackEntryRowModel } from "compositions/track-entries.slint";
import { TrackPanelFacts, TrackPanelWalkFacts } from "track-panel-facts.slint";
import { TimerSetterFacts } from "menu-facts.slint";
import { TimeSlotRow } from "widgets/time-field.slint";
import { HabitRowModel } from "compositions/habits.slint";
import { BoardView, BoardModel } from "views/board-view.slint";
import { BoardBarModel, BoardSegmentModel, BoardBarFacts } from "compositions/board-bar.slint";
import { StackView, StackDetailModel } from "views/stack-view.slint";
import { TodayView, TodayModel } from "views/today-view.slint";
import { PlanNextDayView, PlanModel } from "views/plan-next-day-view.slint";
import { TaskView, TaskDetailModel } from "views/task-view.slint";
import { ReviewView, ReviewModel } from "views/review-view.slint";
export { ReviewModel }
import { DueDayModel } from "compositions/date-picker.slint";
import { DatePicker } from "compositions/date-picker.slint";
export { DueDayModel }
import {
    SettingsView,
    SettingsModel,
    ConnectionRow,
    ConnectionItem,
    ConnectionItemKind,
    SettingsRowStatus,
    SettingsOutcome,
    SettingsBoardCopy,
    SettingsPublishCopy,
} from "views/settings-view.slint";
export { SettingsModel, ConnectionRow, ConnectionItem, ConnectionItemKind, SettingsRowStatus, SettingsOutcome }
import { TooltipState, TooltipPanel } from "widgets/tooltip.slint";
import { TaskCard } from "widgets/task-card.slint";
import { DragState } from "drag-state.slint";
import { FocusScrollHint } from "focus-scroll.slint";
import { TodayAnchorFacts } from "today-anchor.slint";
import { ScrollPageHint } from "scroll-page.slint";
import { TextField, FieldValidity } from "widgets/text-field.slint";
export { FieldValidity }
import { MenuPanelFacts, DatePickerFacts } from "menu-facts.slint";
import { SettingsScrollFacts, SettingsBoardFacts } from "settings-facts.slint";
import { DropdownLadder, DropdownFacts } from "widgets/dropdown.slint";
import { DropdownFlyout } from "widgets/dropdown-flyout.slint";
import { TimeFieldFacts } from "widgets/time-field.slint";
import { QuickListFlyout } from "widgets/quick-list-flyout.slint";
import { EditingFacts } from "editing-facts.slint";
import { EditorScope } from "editor-scope.slint";
import { TaskViewWalkFacts } from "walk-facts.slint";
import { AlarmWindow, AlarmRowModel } from "alarm-window.slint";
export { AlarmWindow, AlarmRowModel }

// Re-export the globals so the generated Rust module exposes them
// (mount/adapter read/write them through the generated accessors).
export { Theme, Typography, Semantic, Responsive, TooltipState, MenuPanelFacts, SettingsScrollFacts, SettingsBoardFacts, DragState, FocusScrollHint, ScrollPageHint, EditingFacts, EditorScope, TaskViewWalkFacts, TrackPanelFacts, TrackPanelWalkFacts, DropdownLadder, DropdownFacts, TimeFieldFacts, TodayAnchorFacts }
export { ReviewWalkModel }
export { BoardBarModel, BoardSegmentModel, BoardBarFacts }
export { SettingsBoardCopy }

export enum KeyFeedback {
    none,
    prefix-pending,
    prefix-abort,
}

// The one view tree's conditional-mount selector (D7; the Rust side
// owns the ViewId cycle and mirrors it here).
export enum View {
    today,
    board,
    stack-detail,
    task-detail,
    // The review/statistics surface (#214): desktop-only by routing —
    // the kiosk rotation maps Board/Today only.
    review,
    settings,
    // The plan-next-day surface (#622): desktop-only by routing
    // (the kiosk rotation maps Board/Today only).
    plan-next-day,
}

// The keymap layer's window-facing state (D18), pushed one-way from
// the shell.
export global KeyboardState {
    // The vi insert mode (D10: ordinary shell state).
    in-out property <bool> vi-insert: false;
    in-out property <bool> menu-open: false;
    in-out property <int> menu-selected-index: 0;
    // The two-tier menu (round-1 D6): the root page's cursor, the
    // open group as the parent row's root-page index (−1 = root), and
    // the active group's page. `menu-entries` keeps the root page.
    in-out property <int> menu-root-selected-index: 0;
    in-out property <int> menu-active-group: -1;
    in-out property <[MenuEntryModel]> menu-submenu-entries: [];
    in-out property <[MenuEntryModel]> menu-entries: [];
    // The context menu's pointer anchor (round-1 D13): the card menu
    // opens at the pointer; the hamburger anchor is the default.
    in-out property <bool> menu-pointer-anchored: false;
    in-out property <length> menu-pointer-x: 0;
    in-out property <length> menu-pointer-y: 0;
    // The §5.7 status signal: prefix-pending / prefix-abort feedback.
    in-out property <KeyFeedback> last-feedback: KeyFeedback.none;
    // The picker grid's focus mirror (round-3 D25): the adapter
    // pushes the shell fact; the harness chain reads it.
    in-out property <bool> date-picker-grid: false;
}

// The Q15 startup-warning state (rendered by the status bar).
export global UiStatus {
    in-out property <int> startup-keymap-findings: 0;
}

export component AppWindow inherits Window {
    background: Theme.background;
    title: "taskboard";
    preferred-width: Theme.window-default-width;
    preferred-height: Theme.window-default-height;
    // Round-1 D15: scale-aware minimum floors — the compact layout
    // stays usable at 480·scale wide, 400·scale tall. No `width:` or
    // `height:` binding may appear anywhere on the Window (the
    // review invariant; winit rejects resizes below the floors).
    min-width: 480px * Theme.base-scale;
    min-height: 400px * Theme.base-scale;

    // ---- The one-way model push surface (D2: models in, indices
    //      back — no ids cross the seam). ---------------------------
    in-out property <TodayModel> today-model;
    // The plan-next-day surface (#622): the two-pane ritual's model —
    // boxes first, then the pool; the placement form's mirrors are
    // adapter-held (D9 rule 1).
    in-out property <PlanModel> plan-model;
    // The placement form's text mirrors (#622): adapter-held, the
    // pass never writes them (D9 rule 4).
    in-out property <string> plan-time-text;
    in-out property <string> plan-effort-text;
    callback plan-box-activated(int);
    callback plan-pool-activated(int);
    callback plan-box-earlier(int);
    callback plan-box-later(int);
    callback plan-box-remove(int);
    callback plan-time-edited(string);
    callback plan-effort-edited(string);
    callback plan-place-commit();
    callback plan-place-cancel();
    in-out property <string> toolbar-title;
    in-out property <int> toolbar-inbox-count: 0;
    // The view switcher's pushed index (round-3 D22; contract
    // [Board, Today] — see toolbar.slint).
    in-out property <int> switcher-index: 0;
    in-out property <[string]> toolbar-menu-hint;
    // The nav.focus-board binding (round-1 D12; a keymap projection).
    in-out property <[string]> nav-back-hint;
    // The board.select / task.edit hints (round-1 D21b/D8; keymap
    // projections pushed per refresh).
    in-out property <[string]> board-segment-hint;
    in-out property <[string]> task-card-hint;
    // The stack.wider binding hint for the header tooltips (D18).
    in-out property <[string]> stack-header-hint;
    // The stack.create binding hint for the add-column tooltip (r2 D6).
    in-out property <[string]> stack-create-hint;
    // The task.create binding hint for the add-task ghost tooltips
    // (r3 D3).
    in-out property <[string]> task-create-hint;
    // The task view's done/tracking header hints (r4 D16b/D16c;
    // keymap projections pushed per refresh).
    in-out property <[string]> task-done-hint;
    in-out property <[string]> task-track-hint;
    // The closed title's activation binding (r4 D21; pushed per
    // refresh — never hand-written).
    in-out property <[string]> task-title-edit-hint;
    in-out property <View> current-view: View.board;
    // The review surface (#214): the whole model arrives from the
    // push pass; the kiosk gate empties it model-side.
    in-out property <ReviewModel> review-model;
    // The settings seams (round-1 chunk 3, D6.6/D7/D9).
    callback settings-back-clicked();
    callback settings-field-edited(int, string);
    callback settings-save-clicked(string, string, string);
    callback settings-remove-clicked(int);
    callback settings-refresh-clicked(int);
    callback settings-remote-bind-picked(int, int);
    callback settings-publish-picked(int, int);
    callback settings-create-clicked(int);
    callback settings-disconnect-clicked(int);
    callback settings-files-picked(int, int);
    callback settings-preset-picked(int);
    callback settings-view-mounted();
    callback settings-scale-committed(string);
    callback settings-scale-focus-lost();
    // The settings editor's general seams (the GUI settings editor).
    callback settings-general-committed(int, string);
    callback settings-general-focus-lost(int);
    callback settings-reminders-picked(int);
    callback settings-sink-picked(int);
    // The [focus] section's pick seams (the focus settings editor,
    // #625).
    callback settings-focus-enabled-picked(int);
    callback settings-focus-chain-picked(int);
    callback settings-focus-notify-picked(int);
    in-out property <BoardModel> board-model;
    in-out property <BoardBarModel> board-bar-model;
    in-out property <StackDetailModel> stack-model;
    in-out property <TaskDetailModel> task-model;
    in-out property <SyncBadgeModel> sync-model;
    in-out property <[BannerRowModel]> banner-model;
    in-out property <int> banner-overflow;
    // The in-app notification surface (R3 chunk C): desktop-only —
    // the kiosk's model-side gate (R3.5.3) keeps these empty.
    in-out property <[NotificationRowModel]> notification-model;
    in-out property <int> notification-overflow;
    // The timers surface (DR-3/3, D-I6): the today view's section +
    // the status-bar chip. Desktop-only — the kiosk gate empties the
    // model and forces the visibility flags false model-side.
    in-out property <bool> timers-visible: false;
    in-out property <[TimerRowModel]> timers-model;
    // The habits section (DR-6/6): the active board's tracker rows —
    // rendering is not kiosk-gated, the affordances are.
    in-out property <[HabitRowModel]> habits-model;
    in-out property <bool> habits-editing-visible: false;
    in-out property <int> timers-awaiting: 0;
    in-out property <bool> timers-chip-visible: false;
    in-out property <string> timers-chip;
    // The resurrect notice (#130): a transient, passive status line —
    // default invisible (no prompt; kiosk/daemon never block).
    in-out property <bool> notice-visible: false;
    in-out property <string> notice-text;
    // The tracking chip (DR-5/4, D-T16): display visible on kiosk
    // too; the stop affordance's flag is the model-side gate.
    in-out property <bool> tracking-chip-visible: false;
    in-out property <string> tracking-chip;
    in-out property <bool> tracking-chip-action-visible: false;
    // The OS-delivery health chip (round-3 chunk 7, D31): visible
    // while the last delivery attempt failed (a later success clears
    // it model-side — a state of the world, never a timer).
    in-out property <bool> delivery-chip-visible: false;
    in-out property <string> delivery-chip;
    // The files-sync chip (DR-8 chunk 4, D-FH5): fed at mount/drain
    // beside the delivery chip; default hidden (no actor at boot).
    in-out property <bool> files-sync-visible: false;
    in-out property <string> files-sync-text;
    in-out property <FilesSyncChipState> files-sync-state;
    // The jump-to search palette (#348): the model rows arrive ranked,
    // anchor-filtered, and capped from the Rust pass.
    in-out property <bool> palette-open: false;
    // The quick-capture overlay (chunk 10 D8).
    in-out property <bool> capture-open: false;
    in-out property <string> capture-initial-text;
    in-out property <int> palette-selected-index: 0;
    in-out property <[PaletteRowModel]> palette-model: [];
    in-out property <int> palette-overflow: 0;
    // The review walk overlay (DR-7 chunk 3, #638): the whole model
    // arrives from the Rust pass (the dumb client); the kiosk gate
    // empties it model-side.
    in-out property <ReviewWalkModel> walk-model;
    // The prompts' one-shot answer seeds (the mount-transition push).
    in-out property <[string]> walk-answer-seeds: [];
    // The walk's seams: scrim, the row verbs (cursor row only), the
    // armed picker and date field, the prompt mirrors, and the commit
    // exits.
    callback walk-scrim-clicked();
    callback walk-file-clicked();
    callback walk-keep-clicked();
    callback walk-file-prev-clicked();
    callback walk-file-next-clicked();
    callback walk-candidate-activated(int);
    callback walk-file-commit-clicked();
    callback walk-tomorrow-clicked();
    callback walk-pick-clicked();
    callback walk-leave-clicked();
    callback walk-date-edited(string);
    callback walk-date-commit-clicked();
    callback walk-answer-edited(int, string);
    callback walk-record-clicked();
    callback walk-finish-clicked();
    // The today view's surfacing card (DR-7 D-J10): at most one, the
    // whole copy arrives pushed (the phrase fns' output); kiosk never
    // receives it (the model-side gate).
    in-out property <bool> review-card-visible: false;
    in-out property <string> review-card-title;
    in-out property <string> review-card-body;
    in-out property <string> review-card-action;
    callback review-card-clicked();
    // The concentration overlay (#496): the derived frame values and
    // the switcher arrive from the Rust pass (the dumb client); the
    // callbacks route the landed tracking verbs and the capture
    // commit.
    in-out property <bool> focus-overlay-open: false;
    in-out property <string> focus-phase-text;
    in-out property <string> focus-remaining-text;
    in-out property <string> focus-task-title;
    in-out property <[FocusRowModel]> focus-switcher-model: [];
    in-out property <int> focus-switcher-selected: 0;
    in-out property <string> focus-note-initial-text;
    in-out property <FlowHintModel> flow-hint-model;
    // The board create/rename fields' window-level slot (r2 D21):
    // one mount site covers every breakpoint, the empty-board leg,
    // and the vi-from-settings exposure. `board-flow-initial` is the
    // seeded buffer (the mount-only initial-text rule).
    in-out property <bool> board-create-open: false;
    // The pointer drag-to-move's open flag (r2 chunk-8 D-D): mounts
    // the ghost; pushed by the models pass while the drag flow holds
    // (refresh-survival by construction).
    in-out property <bool> board-drag-open: false;
    // Any flow holds on the board (the drag arm's XOR belt); pushed
    // by the models pass.
    in-out property <bool> board-flow-open: false;
    in-out property <bool> board-rename-open: false;
    in-out property <string> board-flow-initial;

    // The rendering fact for tests and reviews (§6 test 2): compact
    // mode is active (board degeneration, D8/D17).
    out property <bool> compact-active: Responsive.current-breakpoint == Breakpoint.compact;
    // The window dims in logical px (round-1 D10): the Rust placement
    // reads them.
    out property <float> window-w: root.width / 1px;
    out property <float> window-h: root.height / 1px;
    // The window height as a length (the #373 today section bound's
    // base; a token-lint-clean length source for markup consumers).
    out property <length> window-height: root.height;
    // The rendering fact the menu sizing (usability D6) and the
    // tooltip flip (D3) are proved against: the status bar's top edge
    // in window coordinates (the inner layouts sit at the origin).
    out property <length> status-top: status.y;

    // The single key path (§5.1): capture-phase tunneling hits this
    // scope before any focused element; accepting consumes the event.
    forward-focus: key-root;
    init => {
        key-root.focus();
        // The initial Responsive push (D17): fires with the preferred
        // size before real layout; `changed width` supersedes it.
        root.window-width-changed(root.width / 1px);
    }
    key-root := FocusScope {
        capture-key-pressed(event) => {
            root.intercept-key(event.text, event.modifiers) ? accept : reject
        }

        // The chrome and the views live INSIDE the key scope: capture
        // tunneling only visits the focused item's ancestors (§5.1),
        // so the single key path must wrap the whole tree.
        VerticalLayout {
            toolbar := Toolbar {
                title: root.toolbar-title;
                menu-hint: root.toolbar-menu-hint;
                inbox-count: root.toolbar-inbox-count;
                compact: Responsive.current-breakpoint == Breakpoint.compact;
                switcher-index: root.switcher-index;
                menu-clicked => root.toolbar-menu-clicked();
                inbox-clicked => root.toolbar-inbox-clicked();
                switcher-board-clicked => root.toolbar-switcher-board-clicked();
                switcher-today-clicked => root.toolbar-switcher-today-clicked();
            }

            // The view-stack area (D20 [DEV]): conditional mounting of
            // the three views — the substance of `view-stack`
            // (navigation + focus hand-off) lives in the view-state
            // machine plus this keyed mount; no L2 file can host L3
            // children (rule C).
            if (root.current-view == View.board): BoardView {
                board: root.board-model;
                board-bar: root.board-bar-model;
                board-segment-hint: root.board-segment-hint;
                task-card-hint: root.task-card-hint;
                stack-header-hint: root.stack-header-hint;
                stack-create-hint: root.stack-create-hint;
                task-create-hint: root.task-create-hint;
                stack-width-press(c) => root.board-stack-width-press(c);
                stack-width-drag(c, d) => root.board-stack-width-drag(c, d);
                stack-width-release(c) => root.board-stack-width-release(c);
                board-bar-activated(i) => root.board-bar-segment-activated(i);
                segment-context(i, x, y) => root.board-segment-context-requested(i, x, y);
                task-activated(c, r) => root.board-task-activated(c, r);
                task-clicked(c, r) => root.board-task-clicked(c, r);
                task-context(c, r, x, y) => root.board-task-context-requested(c, r, x, y);
                header-activated(c) => root.board-header-activated(c);
                switcher-activated(c) => root.board-switcher-activated(c);
                header-context(c, x, y) => root.board-header-context-requested(c, x, y);
                body-context(c, x, y) => root.board-body-context-requested(c, x, y);
                body-activated(c) => root.board-body-activated(c);
                task-done-toggled(c, r) => root.board-task-done-toggled(c, r);
                rename-committed(c, t) => root.board-stack-rename-committed(c, t);
                rename-edited(c, t) => root.board-stack-rename-edited(c, t);
                text-flow-focus-lost() => root.text-flow-focus-lost();
                create-committed(c, t) => root.board-create-committed(c, t);
                create-edited(c, t) => root.board-create-edited(c, t);
                add-task-activated(c) => root.board-add-task-activated(c);
                flow-open: root.board-flow-open;
                card-drag-armed(c, r) => root.board-card-drag-armed(c, r);
                drag-hovered(c) => root.board-drag-hovered(c);
                card-dropped(c) => root.board-card-dropped(c);
                card-drag-finished(c, r, ok) => root.board-card-drag-finished(c, r, ok);
                new-stack-activated() => root.board-new-stack-clicked();
                board-default-preset-clicked() => root.board-default-preset-clicked();
                stack-create-committed(t) => root.board-stack-create-committed(t);
                stack-create-edited(t) => root.board-stack-create-edited(t);
            }
            if (root.current-view == View.today): TodayView {
                today: root.today-model;
                viewport-height: root.window-height;
                row-activated(s, r) => root.today-row-activated(s, r);
                row-extent(id, h) => root.today-row-extent(id, h);
                row-clicked(s, r) => root.today-row-clicked(s, r);
                row-context(s, r, x, y) => root.today-row-context-requested(s, r, x, y);
                row-done-toggled(s, r) => root.today-row-done-toggled(s, r);
                timers-visible: root.timers-visible;
                timers: root.timers-model;
                timers-awaiting: root.timers-awaiting;
                timers-cancel-clicked(r) => root.timers-cancel-clicked(r);
                timers-create-accepted(label, when, alarm) => {
                    root.timers-create-accepted(label, when, alarm)
                }
                timer-when-validity: root.timer-when-validity;
                timer-when-error-hint: root.timer-when-error-hint;
                timers-when-edited(t) => root.timers-when-edited(t);
                timers-setter-opened() => root.timers-setter-opened();
                habits: root.habits-model;
                habits-editing-visible: root.habits-editing-visible;
                habits-plus-clicked(r) => root.habits-plus-clicked(r);
                habits-reorder-asked(row, slot) => root.habits-reorder-asked(row, slot);
                habits-repair-clicked(r) => root.habits-repair-clicked(r);
                habits-convert-armed(r) => root.habits-convert-armed(r);
                habits-convert-confirmed(r) => root.habits-convert-confirmed(r);
                habits-convert-cancelled() => root.habits-convert-cancelled();
                habits-convert-armed-row: root.habits-convert-armed-row;
                tracked-activated(i) => root.today-tracked-activated(i);
                review-card-visible: root.review-card-visible;
                review-card-title: root.review-card-title;
                review-card-body: root.review-card-body;
                review-card-action: root.review-card-action;
                review-card-clicked() => root.review-card-clicked();
            }
            if (root.current-view == View.stack-detail): StackView {
                stack: root.stack-model;
                task-activated(i) => root.stack-task-activated(i);
                task-clicked(i) => root.stack-task-clicked(i);
                task-context(i, x, y) => root.stack-task-context-requested(i, x, y);
                task-done-toggled(i) => root.stack-task-done-toggled(i);
                create-committed(t) => root.stack-create-committed(t);
                create-edited(t) => root.stack-create-edited(t);
                text-flow-focus-lost() => root.text-flow-focus-lost();
            }
            if (root.current-view == View.settings): SettingsView {
                back-clicked() => root.settings-back-clicked();
                view-mounted() => root.settings-view-mounted();
                field-edited(f, t) => root.settings-field-edited(f, t);
                save-clicked(s, u, p) => root.settings-save-clicked(s, u, p);
                remove-clicked(i) => root.settings-remove-clicked(i);
                refresh-clicked(i) => root.settings-refresh-clicked(i);
                remote-bind-picked(i, o) => root.settings-remote-bind-picked(i, o);
                publish-picked(i, o) => root.settings-publish-picked(i, o);
                create-clicked(i) => root.settings-create-clicked(i);
                disconnect-clicked(i) => root.settings-disconnect-clicked(i);
                files-picked(i, o) => root.settings-files-picked(i, o);
                preset-picked(i) => root.settings-preset-picked(i);
                scale-committed(t) => root.settings-scale-committed(t);
                scale-focus-lost() => root.settings-scale-focus-lost();
                scale-pressed() => root.settings-scale-pressed();
                scale-released(v) => root.settings-scale-released(v);
                general-committed(f, t) => root.settings-general-committed(f, t);
                general-focus-lost(f) => root.settings-general-focus-lost(f);
                reminders-picked(i) => root.settings-reminders-picked(i);
                sink-picked(i) => root.settings-sink-picked(i);
                focus-enabled-picked(i) => root.settings-focus-enabled-picked(i);
                focus-chain-picked(i) => root.settings-focus-chain-picked(i);
                focus-notify-picked(i) => root.settings-focus-notify-picked(i);
            }
            if (root.current-view == View.plan-next-day): PlanNextDayView {
                plan: root.plan-model;
                time-text: root.plan-time-text;
                effort-text: root.plan-effort-text;
                box-activated(i) => root.plan-box-activated(i);
                pool-activated(i) => root.plan-pool-activated(i);
                box-earlier(i) => root.plan-box-earlier(i);
                box-later(i) => root.plan-box-later(i);
                box-remove(i) => root.plan-box-remove(i);
                time-edited(t) => root.plan-time-edited(t);
                effort-edited(t) => root.plan-effort-edited(t);
                place-commit() => root.plan-place-commit();
                place-cancel() => root.plan-place-cancel();
            }
            if (root.current-view == View.review): ReviewView {
                review: root.review-model;
                viewport-height: root.window-height;
            }
            if (root.current-view == View.task-detail): TaskView {
                task: root.task-model;
                nav-back-hint: root.nav-back-hint;
                task-done-hint: root.task-done-hint;
                task-title-edit-hint: root.task-title-edit-hint;
                task-track-hint: root.task-track-hint;
                title-committed(t) => root.task-title-committed(t);
                title-edited(t) => root.task-title-edited(t);
                title-edit-opened() => root.task-title-edit-activated();
                text-flow-focus-lost() => root.text-flow-focus-lost();
                back-clicked() => root.task-back-clicked();
                rule-remove-clicked(i) => root.task-rule-remove-clicked(i);
                rule-add-preset-clicked(i) => root.rule-add-preset-clicked(i);
                rule-add-custom-accepted(t) => root.rule-add-custom-accepted(t);
                due-edit-opened() => root.task-due-edit-opened();
                scheduled-edit-opened() => root.task-scheduled-edit-opened();
                description-edit-opened() => root.task-description-edit-opened();
                description-edited(t) => root.task-description-edited(t);
                description-committed(t) => root.task-description-committed(t);
                date-edited(t) => root.task-date-edited(t);
                date-accepted(t) => root.task-date-accepted(t);
                date-picker-toggled() => root.task-date-picker-toggled();
                date-editor-focus-lost() => root.date-editor-focus-lost();
                rule-offset-edited(t) => root.rule-offset-edited(t);
                rule-unmute-clicked() => root.task-rule-unmute-clicked();
                rule-jump-to-due-clicked() => root.task-rule-jump-to-due-clicked();
                // The recur row (issue #506).
                recur-pause-asked() => root.task-recur-pause-asked();
                recur-pause-accepted(t) => root.task-recur-pause-accepted(t);
                recur-pause-cancelled() => root.task-recur-pause-cancelled();
                recur-resume-clicked() => root.task-recur-resume-clicked();
                recur-convert-asked() => root.task-recur-convert-asked();
                recur-convert-confirmed() => root.task-recur-convert-confirmed();
                recur-convert-cancelled() => root.task-recur-convert-cancelled();
                task-track-start-clicked() => root.task-track-start-clicked();
                task-track-stop-clicked() => root.task-track-stop-clicked();
                task-track-entries-clicked() => root.task-track-entries-clicked();
                task-done-toggled() => root.task-done-toggled();
            }

            // The board create/rename fields (r2 D21): the
            // window-level slot below the views — visible while the
            // flow is open at every breakpoint; Return commits,
            // Escape routes mode.normal (the discard arm).
            if (root.board-create-open): TextField {
                placeholder: "New board name";
                label: "New board name";
                commit-affordance: true;
                accepted(text) => root.board-create-field-committed(text);
                edited(text) => root.board-create-field-edited(text);
                focus-lost() => root.text-flow-focus-lost();
            }
            if (root.board-rename-open): TextField {
                placeholder: "Board name";
                label: "Board name";
                initial-text: root.board-flow-initial;
                selected-on-focus: true;
                accepted(text) => root.board-rename-field-committed(text);
                edited(text) => root.board-rename-field-edited(text);
                focus-lost() => root.text-flow-focus-lost();
            }

            // The notification surface sits above the status bar, on
            // every view — it is the universal dismissal surface
            // (design D-10), while the overdue banner stays board
            // truth below it. Mounted only while rows exist: no
            // silent chrome in an empty state.
            if (root.notification-model.length > 0): NotificationSurface {
                notifications: root.notification-model;
                notification-overflow: root.notification-overflow;
                dismiss-clicked(i) => root.notification-dismiss-clicked(i);
                done-clicked(i) => root.notification-done-clicked(i);
                snooze-clicked(i) => root.notification-snooze-clicked(i);
                mute-clicked(i) => root.notification-mute-clicked(i);
                cancel-clicked(i) => root.notification-cancel-clicked(i);
                track-start-clicked(i) => root.notification-track-start-clicked(i);
                row-open-requested(i) => root.notification-row-open-requested(i);
            }

            status := StatusBar {
                sync: root.sync-model;
                startup-findings: UiStatus.startup-keymap-findings;
                banner: root.banner-model;
                banner-overflow: root.banner-overflow;
                flow-hint: root.flow-hint-model;
                timers-chip-visible: root.timers-chip-visible;
                timers-chip: root.timers-chip;
                notice-visible: root.notice-visible;
                notice-text: root.notice-text;
                tracking-chip-visible: root.tracking-chip-visible;
                tracking-chip: root.tracking-chip;
                tracking-chip-action-visible: root.tracking-chip-action-visible;
                delivery-chip-visible: root.delivery-chip-visible;
                delivery-chip: root.delivery-chip;
                files-sync-visible: root.files-sync-visible;
                files-sync-text: root.files-sync-text;
                files-sync-state: root.files-sync-state;
                snooze-clicked(i) => root.banner-snooze-clicked(i);
                mute-clicked(i) => root.banner-mute-clicked(i);
                row-activated(i) => root.banner-row-activated(i);
                row-open-requested(i) => root.banner-row-open-requested(i);
                timers-chip-clicked() => root.timers-chip-clicked();
                tracking-stop-clicked() => root.tracking-chip-stop-clicked();
            }
        }

            // The date-picker overlay (round-3 D10/R2): the
            // dismissal layer first (a full-window TouchArea, no
            // visual — the later sibling is hit-tested first, the
            // menu's probe-P1 shape), then the anchored panel. An
            // outside click dismisses the picker only — the editor
            // and its buffer stay armed. The mount condition is the
            // panel's own, so the layer can never linger. The panel
            // sits below the field when it fits, else above, both
            // clamped into the window (status bar included) — the
            // min-viewport fallback is the menu's narrow-window
            // shape.
            if (root.current-view == View.task-detail
                    && root.task-model.date-picker-open): date-picker-backdrop := TouchArea {
                width: 100%;
                height: 100%;
                clicked => root.date-picker-dismiss-requested();
                // The right-click dismissal (r4 D2): `clicked` never
                // fires for a right-button release, so the layer arms
                // on the down half — the card's pointer-event idiom.
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down
                            && event.button == PointerEventButton.right) {
                        root.date-picker-dismiss-requested();
                    }
                }
            }
            if (root.current-view == View.task-detail
                    && root.task-model.date-picker-open): DatePicker {
                width: min(root.width - 2 * Theme.space-2,
                           max(self.preferred-width, 280px * Theme.base-scale));
                x: max(Theme.space-2,
                       min(DatePickerFacts.anchor-x,
                           root.width - self.width - Theme.space-2));
                y: max(Theme.space-2,
                       min((DatePickerFacts.anchor-y + DatePickerFacts.anchor-height
                                + Theme.space-1 + self.height <= status.y
                            ? DatePickerFacts.anchor-y + DatePickerFacts.anchor-height
                                + Theme.space-1
                            : DatePickerFacts.anchor-y - self.height - Theme.space-1),
                           status.y - self.height - Theme.space-2));
                caption: root.task-model.date-caption;
                time-text: root.task-model.date-time-text;
                grid: root.task-model.date-grid;
                focus-on-mount: root.task-model.date-grid-focus;
                picker-key(k) => root.task-date-picker-key(k);
                grid-focus-changed(f) => root.date-picker-grid-focus-changed(f);
                day-clicked(c) => root.task-date-day-clicked(c);
                time-validity: root.task-model.date-time-validity;
                time-error-hint: root.task-model.time-syntax-hint;
                time-slots: root.task-model.date-time-slots;
                time-nearest-row: root.task-model.date-time-nearest-row;
                time-edited(t) => root.task-date-time-edited(t);
                time-picked(m) => root.task-date-time-picked(m);
                time-accepted(t) => root.task-date-time-accepted(t);
                quick-toggled() => root.task-date-quick-toggled();
            }

        // The timers setter popover (r4 D33): the date-picker overlay
        // twin — the dismissal layer first (a full-window TouchArea,
        // no visual; the later sibling is hit-tested first), then the
        // anchored panel. An outside click (or right-click down, the
        // r4 D2 idiom) dismisses — nothing is committed, drafts are
        // the adapter's setter-local state. The panel sits below the
        // header button when it fits, else above, both clamped into
        // the window (status bar included).
        if (root.timer-setter-open): timer-setter-backdrop := TouchArea {
            width: 100%;
            height: 100%;
            clicked => root.timer-setter-dismiss-requested();
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.right) {
                    root.timer-setter-dismiss-requested();
                }
            }
        }
        if (root.timer-setter-open): TimerSetter {
            width: min(root.width - 2 * Theme.space-2,
                       max(self.preferred-width, 300px * Theme.base-scale));
            x: max(Theme.space-2,
                   min(TimerSetterFacts.anchor-x,
                       root.width - self.width - Theme.space-2));
            y: max(Theme.space-2,
                   min((TimerSetterFacts.anchor-y + TimerSetterFacts.anchor-height
                            + Theme.space-1 + self.height <= status.y
                        ? TimerSetterFacts.anchor-y + TimerSetterFacts.anchor-height
                            + Theme.space-1
                        : TimerSetterFacts.anchor-y - self.height - Theme.space-1),
                       status.y - self.height - Theme.space-2));
            time-text: root.timer-setter-time-text;
            time-validity: root.timer-setter-time-validity;
            time-hint: root.timer-setter-time-hint;
            time-slots: root.timer-setter-time-slots;
            time-nearest-row: root.timer-setter-time-nearest-row;
            fire-time: root.timer-setter-fire-time;
            commit-enabled: root.timer-setter-commit-enabled;
            focus-nonce: root.timer-setter-focus-nonce;
            preset-picked(index) => root.timer-setter-preset-picked(index);
            quick-toggled() => root.timer-setter-quick-toggled();
            time-edited(t) => root.timer-setter-time-edited(t);
            time-stepped(n) => root.timer-setter-time-stepped(n);
            time-picked(m) => root.timer-setter-time-picked(m);
            day-picked(d) => root.timer-setter-day-picked(d);
            insist-picked(i) => root.timer-setter-insist-picked(i);
            commit-requested(label) => root.timer-setter-commit-requested(label);
            close-requested() => root.timer-setter-dismiss-requested();
        }
    // The overlay's window-level mount (D-TS1): the date-picker's
    // exact pattern — the dismissal layer first (a full-window
    // TouchArea, no visual; the later sibling is hit-tested first),
    // the anchored panel after, both gated on one mount condition
    // (the model's flag over the task-detail view, so the layer can
    // never linger). The panel sits below the anchor button when it
    // fits (above the status bar), else above, clamped into the
    // window — the date-picker's exact `y` expression shape.
    if (root.current-view == View.task-detail
            && root.task-model.track-entries-open): track-entries-backdrop := TouchArea {
        width: 100%;
        height: 100%;
        clicked => root.track-entries-dismiss-requested();
        // The right-click dismissal (r4 D2): the card's pointer-event
        // idiom, closing on the down half.
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.right) {
                root.track-entries-dismiss-requested();
            }
        }
    }
    if (root.current-view == View.task-detail
            && root.task-model.track-entries-open): TrackEntriesPanel {
        width: min(root.width - 2 * Theme.space-2,
                   max(self.preferred-width, 360px * Theme.base-scale));
        x: max(Theme.space-2,
               min(TrackPanelFacts.anchor-x,
                   root.width - self.width - Theme.space-2));
        y: max(Theme.space-2,
               min((TrackPanelFacts.anchor-y + TrackPanelFacts.anchor-height
                            + Theme.space-1 + self.height <= status.y
                        ? TrackPanelFacts.anchor-y + TrackPanelFacts.anchor-height
                            + Theme.space-1
                        : TrackPanelFacts.anchor-y - self.height - Theme.space-1),
                   status.y - self.height - Theme.space-2));
        rows: root.task-model.track-entries;
        total: root.task-model.track-entries-total;
        // The form surface's pushed halves (r4 D-TS4) — the
        // adapter-owned mirrors (the TimeField contract: the push
        // re-seeds, the widget never holds state).
        form-open: root.track-form-open;
        form-date-text: root.track-form-date-text;
        form-date-validity: root.track-form-date-validity;
        form-date-hint: root.track-form-date-hint;
        form-grid-open: root.track-form-grid-open;
        form-grid: root.track-form-grid;
        form-grid-focus: root.track-form-grid-focus;
        form-start-text: root.track-form-start-text;
        form-start-validity: root.track-form-start-validity;
        form-start-hint: root.track-form-start-hint;
        form-start-slots: root.track-form-start-slots;
        form-start-nearest-row: root.track-form-start-nearest-row;
        form-end-text: root.track-form-end-text;
        form-end-validity: root.track-form-end-validity;
        form-end-hint: root.track-form-end-hint;
        form-end-slots: root.track-form-end-slots;
        form-end-nearest-row: root.track-form-end-nearest-row;
        row-activated(index) => root.track-entry-row-activated(index);
        delete-clicked(index) => root.track-entry-delete-clicked(index);
        armed-index: root.track-armed-index;
        add-requested() => root.track-form-add-requested();
        date-edited(t) => root.track-form-date-edited(t);
        date-grid-toggled() => root.track-form-grid-toggled();
        date-grid-key(k) => root.track-form-grid-key(k);
        date-day-clicked(c) => root.track-form-day-clicked(c);
        start-quick-toggled() => root.track-form-start-quick-toggled();
        end-quick-toggled() => root.track-form-end-quick-toggled();
        start-edited(t) => root.track-form-start-edited(t);
        start-stepped(n) => root.track-form-start-stepped(n);
        start-picked(m) => root.track-form-start-picked(m);
        end-edited(t) => root.track-form-end-edited(t);
        end-stepped(n) => root.track-form-end-stepped(n);
        end-picked(m) => root.track-form-end-picked(m);
        commit-requested() => root.track-form-commit-requested();
    }

    // The dropdown/quick-list flyouts mount window-level (round-5 D6,
    // 2026-11-05): this **overrides the r4 D39 "no window overlay"
    // decision** that lived at the old in-widget flyout — the
    // coordinate-space defect (F9: panel-local geometry under a
    // displaced underlay) and the settings `Flickable` clip (F14) are
    // subsumed by the date-picker overlay grammar (facts-global
    // geometry, window-level mount, dismissal underlay). Sibling
    // order per class: the dismissal underlay first, the panels
    // after — the later sibling is hit-tested first (probe P1), so
    // the panels absorb their own clicks and the underlay receives
    // exactly the outside clicks. The groups sit above the
    // date-picker/timer-setter/track-entries overlays (a click
    // anywhere dismisses only the flyout first — the standard
    // stacked-overlay behavior) and below the menu group (the menu is
    // a modal takeover no flyout can be open under). The panel
    // geometry is the date-picker mount's exact expression shape:
    // below the anchor when it fits between the anchor and the status
    // bar, else flipped above, both clamped into the window margins.
    if (DropdownFacts.open): dropdown-backdrop := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            DropdownFacts.open = false;
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.right) {
                DropdownFacts.open = false;
            }
        }
    }
    if (DropdownFacts.open && DropdownFacts.site == 0): DropdownFlyout {
        rows: SettingsModel.board-options;
        x: max(Theme.space-2,
               min(DropdownFacts.anchor-x,
                   root.width - self.width - Theme.space-2));
        y: max(Theme.space-2,
               min((DropdownFacts.anchor-y + DropdownFacts.anchor-height
                        + Theme.space-1 + self.height <= status.y
                    ? DropdownFacts.anchor-y + DropdownFacts.anchor-height
                        + Theme.space-1
                    : DropdownFacts.anchor-y - self.height - Theme.space-1),
                   status.y - self.height - Theme.space-2));
        width: DropdownFacts.anchor-width;
        row-activated(i) => root.settings-remote-bind-picked(SettingsBoardFacts.active-item, i);
        row-hovered(i, x, y, w, h) => {
            TooltipState.hover(
                SettingsModel.board-options[i].label,
                SettingsBoardCopy.row-description,
                [],
                x, y, w, h);
        }
        row-unhovered() => {
            TooltipState.unhover();
        }
    }
    if (DropdownFacts.open && DropdownFacts.site == 2): DropdownFlyout {
        rows: SettingsModel.board-options;
        x: max(Theme.space-2,
               min(DropdownFacts.anchor-x,
                   root.width - self.width - Theme.space-2));
        y: max(Theme.space-2,
               min((DropdownFacts.anchor-y + DropdownFacts.anchor-height
                        + Theme.space-1 + self.height <= status.y
                    ? DropdownFacts.anchor-y + DropdownFacts.anchor-height
                        + Theme.space-1
                    : DropdownFacts.anchor-y - self.height - Theme.space-1),
                   status.y - self.height - Theme.space-2));
        width: DropdownFacts.anchor-width;
        row-activated(i) => root.settings-publish-picked(SettingsBoardFacts.active-item, i);
        row-hovered(i, x, y, w, h) => {
            TooltipState.hover(
                SettingsModel.board-options[i].label,
                SettingsPublishCopy.row-description,
                [],
                x, y, w, h);
        }
        row-unhovered() => {
            TooltipState.unhover();
        }
    }
    if (DropdownFacts.open && DropdownFacts.site == 1): DropdownFlyout {
        rows: root.board-bar-model.rows;
        x: max(Theme.space-2,
               min(DropdownFacts.anchor-x,
                   root.width - self.width - Theme.space-2));
        y: max(Theme.space-2,
               min((DropdownFacts.anchor-y + DropdownFacts.anchor-height
                        + Theme.space-1 + self.height <= status.y
                    ? DropdownFacts.anchor-y + DropdownFacts.anchor-height
                        + Theme.space-1
                    : DropdownFacts.anchor-y - self.height - Theme.space-1),
                   status.y - self.height - Theme.space-2));
        width: DropdownFacts.anchor-width;
        row-activated(i) => root.board-bar-segment-activated(i);
        row-hovered(i, x, y, w, h) => {
            TooltipState.hover(
                root.board-bar-model.rows[i].label,
                "Switches to this board.",
                root.board-segment-hint,
                x, y, w, h);
        }
        row-unhovered() => {
            TooltipState.unhover();
        }
    }
    if (TimeFieldFacts.open): time-field-backdrop := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            TimeFieldFacts.open = false;
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.right) {
                TimeFieldFacts.open = false;
            }
        }
    }
    if (TimeFieldFacts.open && TimeFieldFacts.site == 0): QuickListFlyout {
        x: max(Theme.space-2,
               min(TimeFieldFacts.anchor-x,
                   root.width - self.width - Theme.space-2));
        y: max(Theme.space-2,
               min((TimeFieldFacts.anchor-y + TimeFieldFacts.anchor-height
                        + Theme.space-1 + self.height <= status.y
                    ? TimeFieldFacts.anchor-y + TimeFieldFacts.anchor-height
                        + Theme.space-1
                    : TimeFieldFacts.anchor-y - self.height - Theme.space-1),
                   status.y - self.height - Theme.space-2));
        width: TimeFieldFacts.anchor-width;
        rows: root.task-model.date-time-slots;
        nearest-row: root.task-model.date-time-nearest-row;
        focus-nonce: root.date-quick-nonce;
        picked(m) => root.task-date-time-picked(m);
        typed(t) => root.task-date-quick-typed(t);
    }
    if (TimeFieldFacts.open && TimeFieldFacts.site == 1): QuickListFlyout {
        x: max(Theme.space-2,
               min(TimeFieldFacts.anchor-x,
                   root.width - self.width - Theme.space-2));
        y: max(Theme.space-2,
               min((TimeFieldFacts.anchor-y + TimeFieldFacts.anchor-height
                        + Theme.space-1 + self.height <= status.y
                    ? TimeFieldFacts.anchor-y + TimeFieldFacts.anchor-height
                        + Theme.space-1
                    : TimeFieldFacts.anchor-y - self.height - Theme.space-1),
                   status.y - self.height - Theme.space-2));
        width: TimeFieldFacts.anchor-width;
        rows: root.timer-setter-time-slots;
        nearest-row: root.timer-setter-time-nearest-row;
        focus-nonce: root.timer-setter-quick-nonce;
        picked(m) => root.timer-setter-time-picked(m);
        typed(t) => root.timer-setter-quick-typed(t);
    }
    if (TimeFieldFacts.open && TimeFieldFacts.site == 2): QuickListFlyout {
        x: max(Theme.space-2,
               min(TimeFieldFacts.anchor-x,
                   root.width - self.width - Theme.space-2));
        y: max(Theme.space-2,
               min((TimeFieldFacts.anchor-y + TimeFieldFacts.anchor-height
                        + Theme.space-1 + self.height <= status.y
                    ? TimeFieldFacts.anchor-y + TimeFieldFacts.anchor-height
                        + Theme.space-1
                    : TimeFieldFacts.anchor-y - self.height - Theme.space-1),
                   status.y - self.height - Theme.space-2));
        width: TimeFieldFacts.anchor-width;
        rows: root.track-form-start-slots;
        nearest-row: root.track-form-start-nearest-row;
        focus-nonce: root.track-form-quick-nonce;
        picked(m) => root.track-form-start-picked(m);
        typed(t) => root.track-form-start-quick-typed(t);
    }
    if (TimeFieldFacts.open && TimeFieldFacts.site == 3): QuickListFlyout {
        x: max(Theme.space-2,
               min(TimeFieldFacts.anchor-x,
                   root.width - self.width - Theme.space-2));
        y: max(Theme.space-2,
               min((TimeFieldFacts.anchor-y + TimeFieldFacts.anchor-height
                        + Theme.space-1 + self.height <= status.y
                    ? TimeFieldFacts.anchor-y + TimeFieldFacts.anchor-height
                        + Theme.space-1
                    : TimeFieldFacts.anchor-y - self.height - Theme.space-1),
                   status.y - self.height - Theme.space-2));
        width: TimeFieldFacts.anchor-width;
        rows: root.track-form-end-slots;
        nearest-row: root.track-form-end-nearest-row;
        focus-nonce: root.track-form-quick-nonce;
        picked(m) => root.track-form-end-picked(m);
        typed(t) => root.track-form-end-quick-typed(t);
    }

        // The D2 outside-click dismissal layer (round 1): a full-window
        // TouchArea declared AFTER the chrome and BEFORE the menu
        // panel — the later sibling is hit-tested first, so the layer
        // receives exactly the clicks the panel does not absorb (probe
        // P1). No visual. A stolen hamburger click lands here too and
        // converges on the same full close.
        if (KeyboardState.menu-open): menu-backdrop := TouchArea {
            width: 100%;
            height: 100%;
            init => TooltipState.unhover();
            clicked => root.menu-dismiss-requested();
            // The right-click dismissal (r4 D2): the card's
            // pointer-event idiom, closing on the down half.
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.right) {
                    root.menu-dismiss-requested();
                }
            }
        }

        // The generated menu host (§5.9): keyed to the shell's menu
        // state, no key handlers of its own. Mounting dismisses any
        // pending tooltip (the menu is the modal context now).
        if (KeyboardState.menu-open): ActionMenu {
            init => TooltipState.unhover();
            // Round-1 D4: right-aligned under the hamburger, bounded on
            // all four edges. The width expression is the probe-settled
            // shape (P2/P2b): floor 320·scale, cap 560·scale over the
            // natural preferred width, narrow fallback = window minus
            // margins — one expression, since `width` and `min-width`
            // cannot coexist. The x/y clamps keep the panel inside the
            // window (status bar included) at any size.
            width: min(root.width - 2 * Theme.space-2,
                       max(320px * Theme.base-scale,
                           min(self.preferred-width, 560px * Theme.base-scale)));
            // The anchor rect: the hamburger, or the context menu's
            // pointer point (round-1 D13) — same clamp formula.
            x: max(Theme.space-2,
                   min((KeyboardState.menu-pointer-anchored
                            ? KeyboardState.menu-pointer-x - self.width / 2
                            : toolbar.menu-anchor-x + toolbar.menu-anchor-width - self.width),
                       root.width - self.width - Theme.space-2));
            y: max(Theme.space-2,
                   min((KeyboardState.menu-pointer-anchored
                            ? KeyboardState.menu-pointer-y + Theme.space-1
                            : toolbar.menu-anchor-y + toolbar.menu-anchor-height + Theme.space-1),
                       status.y - self.height - Theme.space-1));
            // Usability D6: fill only the space between the anchor and
            // the status bar; the Flickable inside scrolls the overflow.
            // The cap reads the anchor, not the final y — no cycle.
            available-height: max(0px,
                status.y - (KeyboardState.menu-pointer-anchored
                            ? KeyboardState.menu-pointer-y
                            : toolbar.menu-anchor-y + toolbar.menu-anchor-height)
                    - Theme.space-1 - 2 * Theme.space-2);
            entries: KeyboardState.menu-entries;
            submenu-entries: KeyboardState.menu-submenu-entries;
            selected-index: KeyboardState.menu-selected-index;
            root-selected-index: KeyboardState.menu-root-selected-index;
            active-group: KeyboardState.menu-active-group;
            compact: Responsive.current-breakpoint == Breakpoint.compact;
            invoke-entry(index) => root.menu-entry-invoked(index);
            invoke-submenu-entry(index) => root.menu-submenu-entry-invoked(index);
            level-back() => root.menu-level-back();
        }

        // The fly-out (round-1 D6, regular/expansive): the active
        // group's page mounted at the root panel's LEFT edge — the
        // stage-2 recorded deviation from the plan's "right edge":
        // the panel is right-aligned under the hamburger, so the
        // right side never has room and the clamp would always
        // collapse the fly-out onto the panel. Compact replaces the
        // root panel's page instead (inside the panel above).
        if (KeyboardState.menu-open && KeyboardState.menu-active-group >= 0
                && Responsive.current-breakpoint != Breakpoint.compact): ActionMenu {
            width: min(root.width - 2 * Theme.space-2,
                       max(320px * Theme.base-scale,
                           min(self.preferred-width, 560px * Theme.base-scale)));
            x: max(Theme.space-2,
                   min(MenuPanelFacts.x - Theme.space-1 - self.width,
                       root.width - self.width - Theme.space-2));
            y: max(Theme.space-2,
                   min(MenuPanelFacts.y,
                       status.y - self.height - Theme.space-1));
            available-height: max(0px,
                status.y - MenuPanelFacts.y - 2 * Theme.space-2);
            entries: KeyboardState.menu-submenu-entries;
            selected-index: KeyboardState.menu-selected-index;
            is-flyout: true;
            invoke-entry(index) => root.menu-submenu-entry-invoked(index);
        }

        // The tooltip host (usability D3, round-1 D9/D10): mounted
        // while content exists so the size hand-off can measure it;
        // opacity-0 until the Rust placement lands (`placed`), then
        // shown at the computed top-left.
        if (TooltipState.pending || TooltipState.visible): TooltipPanel {
            window-width: root.width;
        }

        // The search palette (#348): the menu overlay pattern — a
        // full-window dismissal layer first (the later sibling is
        // hit-tested first, so the panel absorbs its own clicks),
        // then the centered panel. Width: the 560·scale cap the menu
        // panel uses, shrinking to the window (the palette's rows are
        // fixed-count, so unlike the menu there is no preferred-width
        // term); height by content, clamped above the status bar.
        if (root.palette-open): palette-backdrop := TouchArea {
            width: 100%;
            height: 100%;
            clicked => root.palette-dismiss-requested();
            // The right-click dismissal (r4 D2): the card's
            // pointer-event idiom, closing on the down half.
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.right) {
                    root.palette-dismiss-requested();
                }
            }
        }
        if (root.capture-open): capture-backdrop := TouchArea {
            // The modal scrim: an outside click discards-and-closes
            // (the palette-dismiss precedent routed to ModeNormal).
            width: 100%;
            height: 100%;
            clicked => root.capture-dismiss-requested();
            // The right-click dismissal (r4 D2): the card's
            // pointer-event idiom, closing on the down half.
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.right) {
                    root.capture-dismiss-requested();
                }
            }
        }
        if (root.capture-open): CaptureOverlay {
            width: min(root.width - 2 * Theme.space-2, 560px * Theme.base-scale);
            x: (root.width - self.width) / 2;
            y: max(Theme.space-4,
                   min((root.height - status.height - self.height) / 2,
                       status.y - self.height - Theme.space-2));
            initial-text: root.capture-initial-text;
            capture-edited(text) => root.capture-text-edited(text);
            capture-accepted() => root.capture-accepted();
            text-flow-focus-lost() => root.text-flow-focus-lost();
        }
        if (root.palette-open): palette-panel := SearchPalette {
            width: min(root.width - 2 * Theme.space-2, 560px * Theme.base-scale);
            x: (root.width - self.width) / 2;
            y: max(Theme.space-4,
                   min((root.height - status.height - self.height) / 2,
                       status.y - self.height - Theme.space-2));
            rows: root.palette-model;
            selected-index: root.palette-selected-index;
            overflow: root.palette-overflow;
            query-edited(text) => root.palette-query-edited(text);
            row-activated(index) => root.palette-row-activated(index);
            text-flow-focus-lost() => root.text-flow-focus-lost();
        }
        // The pointer drag's ghost (r2 chunk-8, D-D): the dragged
        // card's snapshot at half opacity, centred under the cursor
        // (DragState.pointer-x/y, fed by the board DropAreas' can-drop
        // reports). Mounted as the last sibling: mid-drag the runtime
        // suppresses hover/press over it, so it shadows no drop
        // target; no other overlay can be open while a drag is.
        // The concentration overlay (#496): full-surface scrim + panel
        // (the capture-overlay precedent; the later sibling wins the
        // hit test, so an outside click lands on the scrim and closes
        // — the session keeps running; the overlay is presentation).
        // The review walk's scrim (the focus overlay's precedent): an
        // outside click steps the walk back one level — never past a
        // command (the ladder shape).
        if (root.walk-model.open): TouchArea {
            width: 100%;
            height: 100%;
            clicked => root.walk-scrim-clicked();
        }
        if (root.walk-model.open): ReviewWalkOverlay {
            width: min(root.width - 2 * Theme.space-2, 560px * Theme.base-scale);
            x: (root.width - self.width) / 2;
            y: max(Theme.space-4,
                   min((root.height - status.height - self.height) / 2,
                       status.y - self.height - Theme.space-2));
            model: root.walk-model;
            answer-seeds: root.walk-answer-seeds;
            scrim-clicked() => root.walk-scrim-clicked();
            file-clicked() => root.walk-file-clicked();
            keep-clicked() => root.walk-keep-clicked();
            file-prev-clicked() => root.walk-file-prev-clicked();
            file-next-clicked() => root.walk-file-next-clicked();
            candidate-activated(index) => root.walk-candidate-activated(index);
            file-commit-clicked() => root.walk-file-commit-clicked();
            tomorrow-clicked() => root.walk-tomorrow-clicked();
            pick-clicked() => root.walk-pick-clicked();
            leave-clicked() => root.walk-leave-clicked();
            date-edited(text) => root.walk-date-edited(text);
            date-commit-clicked() => root.walk-date-commit-clicked();
            answer-edited(index, text) => root.walk-answer-edited(index, text);
            record-clicked() => root.walk-record-clicked();
            finish-clicked() => root.walk-finish-clicked();
        }
        if (root.focus-overlay-open): focus-overlay-backdrop := TouchArea {
            width: 100%;
            height: 100%;
            clicked => root.focus-overlay-close-requested();
        }
        if (root.focus-overlay-open): FocusOverlay {
            width: min(root.width - 2 * Theme.space-2, 560px * Theme.base-scale);
            x: (root.width - self.width) / 2;
            y: max(Theme.space-4,
                   min((root.height - status.height - self.height) / 2,
                       status.y - self.height - Theme.space-2));
            phase-text: root.focus-phase-text;
            remaining-text: root.focus-remaining-text;
            task-title: root.focus-task-title;
            rows: root.focus-switcher-model;
            selected-index: root.focus-switcher-selected;
            note-initial-text: root.focus-note-initial-text;
            note-edited(text) => root.focus-note-edited(text);
            note-accepted() => root.focus-note-accepted();
            switcher-activated(index) => root.focus-switcher-invoked(index);
            stop-clicked() => root.focus-stop-clicked();
        }
        if (root.board-drag-open): Rectangle {
            width: 100%;
            height: 100%;
            TaskCard {
                model: DragState.ghost-model;
                // Card-sized (r3 D1): the size captured at drag-arm —
                // the default fill would mount a window-sized ghost.
                width: DragState.ghost-width;
                height: DragState.ghost-height;
                x: DragState.pointer-x - self.width / 2;
                y: DragState.pointer-y - self.height / 2;
                opacity: 0.5;
            }
        }
    }

    // The Rust-installed interception seam (D18): converts the event
    // to a Stroke, feeds the resolver, and answers accept (the
    // resolver consumed the stroke) or reject (delivery continues).
    pure callback intercept-key(string, KeyboardModifiers) -> bool;
    // The `menu.invoke` projection: the adapter closes the menu and
    // re-dispatches the selected entry through the same router.
    pure callback menu-entry-invoked(int);
    // The D2 dismissal layer: an outside click is a dismissal, not a
    // level-up — the adapter routes the full close.
    pure callback menu-dismiss-requested();
    // The search palette's seams (#348): per-keystroke ranking, the
    // outside-click close, and row activation.
    pure callback palette-query-edited(string);
    pure callback palette-dismiss-requested();
    pure callback palette-row-activated(int);
    // The two-tier seams (round-1 D6): the fly-out/replace page's
    // rows and the compact back row.
    pure callback menu-submenu-entry-invoked(int);
    pure callback menu-level-back();

    // The D15 focus hand-off (journey finding): an edit flow's field
    // holds slint focus while mounted and unmounts when the flow ends;
    // the active view scope takes focus back so the keyboard never
    // dead-ends. Driven by the adapter when a flow ends.
    public function refocus-view() {
        key-root.focus();
    }

    // The Responsive width push (D17): every width change lands in
    // Rust's breakpoint mapping, which sets the `Responsive` global.
    pure callback window-width-changed(float);
    changed width => { root.window-width-changed(root.width / 1px); }

    // The view dispatch seams (D22): every user-visible verb arrives
    // here and routes through the action layer / view-state machine
    // in the adapter. Indices only — the adapter resolves them
    // against the id tables it built when pushing the models (D2).
    pure callback toolbar-menu-clicked();
    pure callback toolbar-inbox-clicked();
    // The view switcher's clicks (round-3 D22): each routes the same
    // registry action the keyboard uses (§7.1: click ≡ key).
    pure callback toolbar-switcher-board-clicked();
    pure callback toolbar-switcher-today-clicked();
    pure callback board-bar-segment-activated(int);
    pure callback board-task-activated(int, int);
    pure callback board-task-clicked(int, int);
    // The right-click context menu seams (round-1 D13).
    pure callback board-task-context-requested(int, int, float, float);
    // The column resize drag seams (round-1 D17).
    pure callback board-stack-width-press(int);
    pure callback board-stack-width-drag(int, float);
    pure callback board-stack-width-release(int);
    pure callback stack-task-context-requested(int, float, float);
    // The today view's row seams (chunk 10 D7): (section, row) — the
    // adapter resolves the flat index against `today_tasks`.
    // The capture overlay's seams (chunk 10 D8).
    pure callback capture-dismiss-requested();
    pure callback capture-text-edited(string);
    pure callback capture-accepted();
    // The concentration overlay's seams (#496): scrim close, note
    // commit (the capture commit funnel), the switcher's start, and
    // the session stop.
    pure callback focus-overlay-close-requested();
    pure callback focus-note-edited(string);
    pure callback focus-note-accepted();
    pure callback focus-switcher-invoked(int);
    pure callback focus-stop-clicked();
    pure callback today-row-activated(int, int);
    pure callback today-row-extent(string, length);
    pure callback today-row-clicked(int, int);
    pure callback today-row-context-requested(int, int, float, float);
    // The done checkbox's toggles on the today rows and the
    // stack-detail rows (r3 D6): the same raw-send as the board
    // cards, resolved against the today/stack tables.
    pure callback today-row-done-toggled(int, int);
    pure callback stack-task-done-toggled(int);
    pure callback board-header-activated(int);
    pure callback board-switcher-activated(int);
    // The r2 D21 right-click seams: the stack header (and the
    // compact switcher's segments) and the board-bar segment.
    pure callback board-header-context-requested(int, float, float);
    // The stack card's bare-surface right-click (r3 D4): the header
    // seam's body twin — one shared adapter body.
    pure callback board-body-context-requested(int, float, float);
    // The bare body's left-click select (r4 D3): the header seam's
    // body twin — one shared adapter body.
    pure callback board-body-activated(int);
    // The done checkbox's toggle (r3 D6): (column, task) — the
    // adapter resolves the id tables and raw-sends the toggled
    // SetTaskDone (the notification Done button's precedent: the
    // registry's complete/reopen act on the focused task; the
    // checkbox addresses an arbitrary card).
    pure callback board-task-done-toggled(int, int);
    pure callback board-segment-context-requested(int, float, float);
    // The stack-rename field (r2 D21): per-column mirror/commit.
    pure callback board-stack-rename-committed(int, string);
    pure callback board-stack-rename-edited(int, string);
    // The board create/rename fields (r2 D21): the window-level
    // slot's mirror/commit seams.
    pure callback board-create-field-committed(string);
    pure callback board-create-field-edited(string);
    pure callback board-rename-field-committed(string);
    pure callback board-rename-field-edited(string);
    pure callback board-create-committed(int, string);
    pure callback board-create-edited(int, string);
    // The per-column Add Task ghost (r2 D8): select + route
    // task.create — the keyboard's exact dispatch.
    pure callback board-add-task-activated(int);
    // The pointer drag-to-move seams (r2 chunk-8): the DragArea arm
    // (column, row), the DropArea hover/drop reports, and the
    // drag-finished outcome (true = completed drop).
    pure callback board-card-drag-armed(int, int);
    pure callback board-drag-hovered(int);
    pure callback board-card-dropped(int);
    pure callback board-card-drag-finished(int, int, bool);
    // The stack-create flow (usability D7): the on-board button
    // routes the same registry action as the `S` binding (§7.1).
    pure callback board-new-stack-clicked();
    // The empty-board preset CTA (r3 D5): direct command dispatch —
    // the adapter applies the preset's CreateStack commands.
    pure callback board-default-preset-clicked();
    pure callback board-stack-create-committed(string);
    pure callback board-stack-create-edited(string);
    pure callback stack-task-activated(int);
    pure callback stack-task-clicked(int);
    pure callback stack-create-committed(string);
    pure callback stack-create-edited(string);
    // The closed title's click (round-3 W-SM-d): routes the
    // `task.title-edit` action — click ≡ key (§7.1).
    pure callback task-title-edit-activated();
    // The focus-loss settle (round-3 L1, plan §7): every text flow's
    // field forwards here — the adapter settles per the flow-kind
    // rule (commit non-empty / discard empty / close the modal).
    pure callback text-flow-focus-lost();
    pure callback task-title-committed(string);
    pure callback task-title-edited(string);
    // The back button (round-1 D12): routes nav.focus-board — no new
    // view-state semantics.
    pure callback task-back-clicked();
    // The scale slider's gesture seams (r2 D29, r4 D38): press seeds
    // the revert point, release commits once (the drag itself is the
    // widget's own).
    pure callback settings-scale-pressed();
    pure callback settings-scale-released(float);
    // The rule-list seams (chunk 6, D12): index-resolved against the
    // id tables / parsed at the adapter, then routed one-shot.
    pure callback task-rule-remove-clicked(int);
    pure callback rule-add-preset-clicked(int);
    // The bool is the parse outcome (r2 D24): `false` absorbs (D12)
    // and the composition resets its buffer — no reject seam.
    pure callback rule-add-custom-accepted(string) -> bool;
    pure callback task-due-edit-opened();
    pure callback task-rule-unmute-clicked();
    pure callback task-rule-jump-to-due-clicked();
    pure callback task-scheduled-edit-opened();
    pure callback task-description-edit-opened();
    pure callback task-description-edited(string);
    pure callback task-description-committed(string);
    pure callback task-date-edited(string);
    pure callback task-date-accepted(string);
    pure callback task-date-picker-toggled();
    pure callback task-date-picker-key(int);
    // The picker grid's focus seam (round-3 D25): arms the
    // `DatePicker` keymap context exactly with the grid's focus.
    pure callback date-picker-grid-focus-changed(bool);
    pure callback task-date-day-clicked(int);
    // The time combobox's seams (r4 D26): the typed filter/entry, the
    // quick-list pick (minutes-of-day), the commit funnel.
    pure callback task-date-time-edited(string);
    pure callback task-date-time-picked(int);
    pure callback task-date-time-accepted(string);
    // The quick-times chevrons' seams (round-5 F8): the latch/disarm
    // half of the chevron toggle, per surface.
    pure callback task-date-quick-toggled();
    pure callback timer-setter-quick-toggled();
    pure callback track-form-start-quick-toggled();
    pure callback track-form-end-quick-toggled();
    // The quick list's append shim (round-5 D6): the flyout scope
    // forwards the typed key text; the adapter appends it to the
    // field's mirror and runs the same edited logic (the old in-widget
    // shim appended to the field buffer, which the adapter echoes
    // verbatim — the mirror is the same single writer).
    pure callback task-date-quick-typed(string);
    pure callback timer-setter-quick-typed(string);
    pure callback track-form-start-quick-typed(string);
    pure callback track-form-end-quick-typed(string);
    // The armed date editor's focus-loss settle (r4 D24).
    pure callback date-editor-focus-lost();
    // The per-keystroke validity probes (r4 D27).
    pure callback rule-offset-edited(string);
    pure callback timers-when-edited(string);
    in-out property <FieldValidity> timer-when-validity: FieldValidity.neutral;
    in-out property <string> timer-when-error-hint: "";
    // The timers header's mouse setter popover (r4 D33): window-level
    // overlay mount (never inside the scroll page — a window-sized
    // underlay inside the Flickable would scroll wrong; the
    // date-picker precedent). The open flag is pure presentation
    // state (the palette-open precedent — no model push); the pushed
    // halves arrive from the adapter's per-pass derive (one draft,
    // two views: the popover edits and the inline text form's
    // validity mirror share the same `timer_when_draft`).
    in-out property <bool> timer-setter-open: false;
    // The armed delete row's index (D-TS5): the adapter's mirror over
    // the id table (−1 = nothing armed).
    in-out property <int> track-armed-index: -1;
    // The form's pushed halves (r4 D-TS4): the adapter's mirrors, one
    // property per half (the timer-setter block's shape).
    in-out property <bool> track-form-open: false;
    in-out property <string> track-form-date-text: "";
    in-out property <FieldValidity> track-form-date-validity: FieldValidity.neutral;
    in-out property <string> track-form-date-hint: "";
    in-out property <bool> track-form-grid-open: false;
    in-out property <[[DueDayModel]]> track-form-grid;
    in-out property <bool> track-form-grid-focus: false;
    in-out property <string> track-form-start-text: "--:--";
    in-out property <FieldValidity> track-form-start-validity: FieldValidity.neutral;
    in-out property <string> track-form-start-hint: "";
    in-out property <[TimeSlotRow]> track-form-start-slots;
    in-out property <int> track-form-start-nearest-row: 0;
    in-out property <string> track-form-end-text: "--:--";
    in-out property <FieldValidity> track-form-end-validity: FieldValidity.neutral;
    in-out property <string> track-form-end-hint: "";
    in-out property <[TimeSlotRow]> track-form-end-slots;
    in-out property <int> track-form-end-nearest-row: 0;
    in-out property <int> timer-setter-focus-nonce: 0;
    // The quick-list panels' focus nonces (round-5 D-3.3): the
    // quick-toggled seams bump these after the flyout's facts-open
    // flip mounts the panel — a fresh conditional's init grab alone
    // does not reliably take (the P5 record). One shared nonce per
    // surface group: only one panel mounts per group at a time (the
    // site discriminator picks which). Window properties, not model
    // fields — a push pass would rebuild a model field over the bump.
    in-out property <int> date-quick-nonce: 0;
    in-out property <int> timer-setter-quick-nonce: 0;
    in-out property <int> track-form-quick-nonce: 0;
    in-out property <string> timer-setter-time-text: "--:--";
    in-out property <FieldValidity> timer-setter-time-validity: FieldValidity.neutral;
    in-out property <string> timer-setter-time-hint: "";
    in-out property <[TimeSlotRow]> timer-setter-time-slots;
    in-out property <int> timer-setter-time-nearest-row: 0;
    in-out property <string> timer-setter-fire-time: "";
    in-out property <bool> timer-setter-commit-enabled: false;
    // The dismissal layer's seam (round-3 D10): drops the picker
    // only — the editor and its flow stay armed.
    pure callback date-picker-dismiss-requested();
    pure callback banner-snooze-clicked(int);
    pure callback banner-mute-clicked(int);
    pure callback banner-row-activated(int);
    // D-6.1 (round 6): the rows' double-click open (banner + the
    // notification surface's task-anchored rows).
    pure callback banner-row-open-requested(int);
    // The notification surface's buttons (R3 chunk C, D-10): Dismiss /
    // Mark Done / Snooze / Mute — each dispatches one engine command
    // and nothing else (thin client). Start Task (DR-5/4, D-TU7)
    // rides the same one-command rule: the planner's implicit
    // same-batch dismissal means the UI sends StartTracking alone.
    pure callback notification-dismiss-clicked(int);
    pure callback notification-done-clicked(int);
    pure callback notification-snooze-clicked(int);
    pure callback notification-mute-clicked(int);
    pure callback notification-cancel-clicked(int);
    pure callback notification-track-start-clicked(int);
    pure callback notification-row-open-requested(int);
    // The tracking seams (DR-5/4, D-TU11): the chip's stop routes
    // TaskTrackStop; the detail view's two verbs route over the
    // focused task.
    pure callback tracking-chip-stop-clicked();
    pure callback task-track-start-clicked();
    pure callback task-track-stop-clicked();
    // The task view's done checkbox (r4 D16b): raw-sends the toggled
    // SetTaskDone over the view's subject (not the registry route —
    // the subject is not guaranteed focused).
    pure callback task-done-toggled();
    // The timers surface (DR-3/3, D-I8): create dispatches
    // TimerCreate from the parsed draft; cancel dispatches
    // TimerCancel from the row table; the chip click focuses today.
    pure callback timers-cancel-clicked(int);
    pure callback habits-plus-clicked(int);
    pure callback habits-reorder-asked(int, int);
    // The habits trio (issue #506): the make-up valve, and the
    // conversion flow's arm/confirm/cancel steps (one row armed at a
    // time via the armed-row property).
    pure callback habits-repair-clicked(int);
    pure callback habits-convert-armed(int);
    pure callback habits-convert-confirmed(int);
    pure callback habits-convert-cancelled();
    in-out property <int> habits-convert-armed-row: -1;
    // The task view's recur row (issue #506): pause open/editor +
    // resume + the conversion's arm/confirm/cancel.
    pure callback task-recur-pause-asked();
    pure callback task-recur-pause-accepted(string);
    pure callback task-recur-pause-cancelled();
    pure callback task-recur-resume-clicked();
    pure callback task-recur-convert-asked();
    pure callback task-recur-convert-confirmed();
    pure callback task-recur-convert-cancelled();
    // The Tracked section's activation (#490): opens the addressed
    // task (the today row's arm).
    pure callback today-tracked-activated(int);
    pure callback timers-create-accepted(string, string, bool) -> bool;
    pure callback timers-chip-clicked();
    // The mouse setter's seams (r4 D33): open/dismiss are window
    // property flips; the intents ride to the adapter's setter state;
    // the commit funnels through `timers-create-accepted` — the one
    // parser between any commit and the engine.
    pure callback timers-setter-opened();
    pure callback timer-setter-dismiss-requested();
    pure callback timer-setter-preset-picked(int);
    pure callback timer-setter-time-edited(string);
    pure callback timer-setter-time-stepped(int);
    pure callback timer-setter-time-picked(int);
    pure callback timer-setter-day-picked(int);
    pure callback timer-setter-insist-picked(int);
    pure callback timer-setter-commit-requested(string) -> bool;
    // The time-entries overlay's seams (r4 chunk 10): the summary-row
    // button routes the open action; the dismissal layer closes the
    // flow; a row activation opens the seeded edit form; the panel's
    // intents resolve against the adapter's id tables.
    pure callback task-track-entries-clicked();
    pure callback track-entries-dismiss-requested();
    pure callback track-entry-row-activated(int);
    pure callback track-entry-delete-clicked(int);
    pure callback track-form-add-requested();
    pure callback track-form-date-edited(string);
    pure callback track-form-grid-toggled();
    pure callback track-form-grid-key(int);
    pure callback track-form-day-clicked(int);
    pure callback track-form-start-edited(string);
    pure callback track-form-start-stepped(int);
    pure callback track-form-start-picked(int);
    pure callback track-form-end-edited(string);
    pure callback track-form-end-stepped(int);
    pure callback track-form-end-picked(int);
    pure callback track-form-commit-requested() -> bool;
}
